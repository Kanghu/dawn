{% comment %}
  Collection header: title, product count and a short description excerpt, then the
  sub-collection strip (snippets/alc-coll-subnav.liquid). #ProductCount is refreshed
  by facets.js after filtering, so keep that id. Styles: assets/alc-collection-header.css.
{% endcomment %}
{{ 'alc-collection-header.css' | asset_url | stylesheet_tag }}

<div class="alc-ch color-{{ section.settings.color_scheme }}{% if section.settings.show_collection_image and collection.image %} alc-ch--with-image{% endif %}">
  <div class="page-width alc-ch__inner">
    <div class="alc-ch__text">
      <div class="alc-ch__top">
        <h1 class="alc-ch__title">{{ collection.title | escape }}</h1>
        <div class="alc-ch__count" role="status">
          <span id="ProductCount">
            {%- if collection.results_count -%}
              {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
            {%- elsif collection.products_count == collection.all_products_count -%}
              {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
            {%- else -%}
              {{ 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
            {%- endif -%}
          </span>
          {%- render 'loading-spinner' -%}
        </div>
      </div>

      {%- comment -%}
        A two-line teaser of the description; the full text sits under the grid on page 1
        (#AlcCollAbout in main-collection-product-grid).
      {%- endcomment -%}
      {%- assign desc_text = collection.description | strip_html | strip -%}
      {%- if section.settings.show_collection_description and desc_text != blank and current_page == 1 -%}
        <p class="alc-ch__desc">
          <span>{{ desc_text | truncatewords: 40 }}</span>
          <a href="#AlcCollAbout" class="alc-ch__more">{% render 'alc-i18n', key: 'read_more' %}</a>
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="alc-ch__image">
        <img
          src="{{ collection.image | image_url: width: 750 }}"
          srcset="{{ collection.image | image_url: width: 400 }} 400w, {{ collection.image | image_url: width: 750 }} 750w, {{ collection.image | image_url: width: 1100 }} 1100w"
          sizes="(min-width: 990px) 420px, 100vw"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
          fetchpriority="high"
        >
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_collection_slider -%}
    <div class="page-width alc-ch__subnav">
      {%- render 'alc-coll-subnav', collection: collection -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
  {
    "name": "ALC - Coll Banner V2",
    "class": "section",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.main-collection-banner.settings.paragraph.content"
      },
      {
        "type": "checkbox",
        "id": "show_collection_description",
        "default": true,
        "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
      },
      {
        "type": "checkbox",
        "id": "show_collection_image",
        "default": false,
        "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
        "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Subcollection Slider Settings"
      },
      {
        "type": "paragraph",
        "content": "Configure the subcollection slider. Uses native Shopify slider (no Swiper.js). Subcollections are loaded from the collection's metafield: custom.slider_subcollections"
      },
      {
        "type": "checkbox",
        "id": "show_collection_slider",
        "default": false,
        "label": "Show Subcollection Slider"
      },
      {
        "type": "range",
        "id": "slider_columns_desktop",
        "min": 2,
        "max": 6,
        "step": 1,
        "default": 5,
        "label": "Number of columns on desktop",
        "info": "Number of subcollections visible at once on desktop screens"
      },
      {
        "type": "select",
        "id": "slider_columns_mobile",
        "options": [
          {
            "value": "1",
            "label": "1 column"
          },
          {
            "value": "2",
            "label": "2 columns"
          }
        ],
        "default": "2",
        "label": "Number of columns on mobile"
      },
      {
        "type": "checkbox",
        "id": "slider_enable_mobile",
        "default": true,
        "label": "Enable swipe on mobile",
        "info": "Allow horizontal scrolling/swiping on mobile devices"
      },
      {
        "type": "select",
        "id": "slider_image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "portrait",
            "label": "Portrait (4:5)"
          },
          {
            "value": "square",
            "label": "Square (1:1)"
          }
        ],
        "default": "square",
        "label": "Subcollection image ratio"
      }
    ]
  }
{% endschema %}
