{% schema %}
  {
    "name": "Featured Specs",
    "settings": [
      {
        "type": "url",
        "id": "video",
        "label": "Video URL",
        "info": "Paste the full video URL from your Files section"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "De ce Oglinzi LED Marcello?"
      },
      {
        "type": "color",
        "id": "checkmark_color",
        "label": "Checkmark Color",
        "default": "#4CAF50"
      }
    ],
    "blocks": [
      {
        "type": "feature",
        "name": "Feature Item",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Feature Text",
            "default": "Feature item"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Featured Specs",
        "blocks": [
          {
            "type": "feature"
          }
        ]
      }
    ]
  }
{% endschema %}

<a href="/collections/marcello-funghi" class="no-underline text-black">
  <div class="two-columns pb-6">
    <div class="column video-column mobile-m-auto">
      {% if section.settings.video != blank %}
        <video
          autoplay
          muted
          loop
          playsinline
          loading="lazy"
          preload="none">
          <source src="{{ section.settings.video }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      {% endif %}
    </div>
    <div class="column text-column">
      <h2>
        <b>{{ section.settings.heading }}</b>
      </h2>
      <br>
      <ul style="list-style-type: none; padding: 0;">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <li style="font-weight: bold; margin-bottom: 10px;">
              <span style="color: {{ section.settings.checkmark_color }};">✔</span>
              {{ block.settings.text }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      {% if section.settings.disclaimer != blank %}
        <p style="font-size: 12px; color: #555; margin-top: 20px; text-align: center;">
          <em>{{ section.settings.disclaimer }}</em>
        </p>
      {% endif %}
    </div>
  </div>
</a>
<style>
  /* Stilurile pentru desktop */
  .two-columns {
    display: flex;
    gap: 20px;
    /* Padding doar pe stânga și dreapta */
    max-width: 1200px;
    /* Lățimea maximă a secțiunii */
    margin: 0 auto;
    /* Centrare orizontală */
    background-color: #ffffff;
    /* O culoare deschisă de fundal (opțional) */
    border-radius: 10px;
    /* Colțuri rotunjite */
  }

  .video-column video {
    max-width: 32rem;
    height: auto;
    border-radius: 10px;
    /* Optional: rotunjire colțuri */
  }

  /* Stilurile pentru mobil */
  @media (max-width: 768px) {
    .two-columns {
      flex-direction: column;
      /* Coloanele una sub alta */
      gap: 0;
      /* Elimină spațiul dintre coloane */
      padding: 0;
      /* Elimină padding-ul general */
    }

    .video-column video {
      border-radius: 0;
      /* Elimină rotunjirea colțurilor la video */
    }

    .mobile-m-auto {
      margin: 0 auto;
    }

    .text-column {
      padding: 20px;
      /* Adaugă padding doar la text */
      text-align: center;
      /* Centrează textul pentru mobil */
      display: none;
      /* Ascunde textul pe mobile */
    }
  }
</style>