    </script><script>document.addEventListener('DOMContentLoaded', function () {
  setTimeout(function () {
    const priceElements = document.querySelectorAll('[data-product-type="price"]');

    priceElements.forEach(priceElement => {
      
      const container = priceElement.closest('.product-item, .product-card, .product-block') || priceElement.parentElement;
      const comparePriceElement = container.querySelector('[data-product-type="compare_at_price"]');

      if (!comparePriceElement) return;

     
      const getPriceValue = (element) => {
        const text = element.textContent.trim();
       
        const numberStr = text.replace(/[^\d.]/g, '');
        return parseFloat(numberStr) || 0;
      };

      const price = getPriceValue(priceElement);
      const comparePrice = getPriceValue(comparePriceElement);

      
      if (Math.abs(price - comparePrice) < 0.01) {
        comparePriceElement.style.display = 'none';
      } else {
        comparePriceElement.style.display = '';
      }
    });
  }, 300); 
});</script>
