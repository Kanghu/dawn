{% comment %}
  Author profile page (/pages/<author>).

  The complete author archive is the tag archive — /blogs/news/tagged/autor-<handle> —
  rendered by sections/alc-blog-grid.liquid in author mode, because a page template
  can never see more than 50 posts of a blog. This page stays as the author's profile:
  hero, biography, the most recent posts it can see, and a prominent link to the
  archive. Author boxes on articles link to the archive, not here.

  The page handle selects the `author` metaobject entry — `kanghu-shi` or
  `autor-kanghu-shi`. Articles are matched on `article.author`, so the entry's `name`
  must match the byline exactly.

  Labels are section settings because locales/en.default.json is at Shopify's
  3400-key ceiling.
{% endcomment %}

{{ 'alc-author.css' | asset_url | stylesheet_tag }}
{{ 'alc-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_page = 10

  assign author_handle = page.handle
  assign author = shop.metaobjects.author[author_handle]
  if author == blank
    assign stripped_handle = page.handle | remove_first: 'autor-'
    assign lookup = shop.metaobjects.author[stripped_handle]
    if lookup != blank
      assign author = lookup
      assign author_handle = stripped_handle
    endif
  endif

  assign author_name = author.name.value | default: page.title

  assign blog_keys = ''
  if settings.author_blog_1 != blank
    assign blog_keys = blog_keys | append: settings.author_blog_1 | append: ','
  endif
  if settings.author_blog_2 != blank
    assign blog_keys = blog_keys | append: settings.author_blog_2 | append: ','
  endif
  if settings.author_blog_3 != blank
    assign blog_keys = blog_keys | append: settings.author_blog_3 | append: ','
  endif
  if blog_keys == blank
    assign blog_keys = 'news,'
  endif
  assign blog_key_list = blog_keys | split: ','
  assign blog_keys_used = ''

  assign author_articles = '' | split: ''
  for blog_key in blog_key_list
    assign dedupe_token = '|' | append: blog_key | append: '|'
    unless blog_keys_used contains dedupe_token
      assign blog_keys_used = blog_keys_used | append: dedupe_token
      assign matched = blogs[blog_key].articles | where: 'author', author_name
      assign author_articles = author_articles | concat: matched
    endunless
  endfor
  assign author_articles = author_articles | sort: 'published_at' | reverse

  assign total_articles = author_articles.size
  assign total_pages = total_articles | divided_by: per_page
  assign remainder = total_articles | modulo: per_page
  if remainder > 0
    assign total_pages = total_pages | plus: 1
  endif
  if total_pages < 1
    assign total_pages = 1
  endif

  assign active_page = current_page | default: 1
  if active_page > total_pages
    assign active_page = total_pages
  endif
  if active_page < 1
    assign active_page = 1
  endif
  assign offset = active_page | minus: 1 | times: per_page
  assign page_articles = author_articles | slice: offset, per_page

  assign newest_year = author_articles.first.published_at | date: '%Y'
  assign oldest_year = author_articles.last.published_at | date: '%Y'

  assign archive_blog_handle = blog_key_list | first
  assign archive_url = blogs[archive_blog_handle].url | append: '/tagged/autor-' | append: author_handle

  assign fallback_bio = page.content
  if fallback_bio == blank
    assign fallback_bio = section.settings.default_bio
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if active_page == 1 -%}
  {%- render 'alc-author-hero',
    author: author,
    author_name: author_name,
    total_articles: total_articles,
    oldest_year: oldest_year,
    newest_year: newest_year,
    fallback_bio: fallback_bio,
    eyebrow: section.settings.eyebrow,
    years_label: section.settings.years_label,
    show_image: section.settings.show_image,
    show_socials: section.settings.show_socials,
    archive_url: archive_url,
    archive_label: section.settings.archive_label
  -%}
{%- else -%}
  <header class="alc-author-strip">
    <div class="alc-author-strip__inner page-width">
      {%- if section.settings.show_image -%}
        {%- if author.photo.value != blank -%}
          {{
            author.photo.value
            | image_url: width: 120
            | image_tag: loading: 'eager', width: 60, height: 60, class: 'alc-author-strip__avatar', alt: author_name
          }}
        {%- else -%}
          <span class="alc-author-strip__avatar alc-author-hero__avatar--placeholder">
            {{- 'icon-author-placeholder.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
      {%- endif -%}
      <div>
        <h1 class="alc-author-strip__name">
          <a href="{{ page.url }}">{{ author_name | escape }}</a>
        </h1>
        <p class="alc-author-strip__meta">
          {{ 'blogs.author.articles_heading' | t: count: total_articles }}
          <span aria-hidden="true">&middot;</span>
          {{ 'general.pagination.page' | t: number: active_page }}
        </p>
      </div>
    </div>
  </header>
{%- endif -%}

<div class="alc-author-page page-width section-{{ section.id }}-padding">
  {%- if request.design_mode and total_articles == 0 -%}
    <div class="alc-author-page__notice">
      {{ 'blogs.author.no_match_warning' | t: name: author_name }}
    </div>
  {%- endif -%}

  {%- if total_articles > 0 -%}
    <div class="alc-author-page__list-head">
      <h2 class="alc-author-page__list-heading">
        {{- 'blogs.author.posts_by' | t: name: author_name -}}
      </h2>
      {%- if total_pages > 1 -%}
        <p class="alc-author-page__list-count">
          {{ 'general.pagination.page' | t: number: active_page }} / {{ total_pages }}
        </p>
      {%- endif -%}
    </div>

    <div class="alc-blog__grid alc-blog__grid--3">
      {%- for article in page_articles -%}
        {%- render 'alc-article-card',
          article: article,
          show_image: section.settings.show_card_images,
          show_date: true,
          show_author: false,
          show_excerpt: true,
          read_more_label: section.settings.read_more_label,
          eager: forloop.first
        -%}
      {%- endfor -%}
    </div>

    {%- if total_pages > 1 -%}
      {%- render 'alc-author-pagination',
        current: active_page,
        total_pages: total_pages,
        base_url: page.url
      -%}
    {%- endif -%}

    {%- if section.settings.archive_label != blank -%}
      <p class="alc-author-page__archive-link">
        <a class="link animate-arrow" href="{{ archive_url }}">
          {{ section.settings.archive_label | escape }}
          <span class="icon-wrap">
            <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
          </span>
        </a>
      </p>
    {%- endif -%}
  {%- else -%}
    <p class="alc-author-page__empty">{{ 'blogs.author.no_articles' | t }}</p>
  {%- endif -%}
</div>

{%- if active_page == 1 -%}
  {%- liquid
    assign same_as = ''
    if author.website.value != blank
      assign same_as = same_as | append: author.website.value | append: '||'
    endif
    if author.linkedin.value != blank
      assign same_as = same_as | append: author.linkedin.value | append: '||'
    endif
    if author.facebook.value != blank
      assign same_as = same_as | append: author.facebook.value | append: '||'
    endif
    if author.instagram.value != blank
      assign same_as = same_as | append: author.instagram.value | append: '||'
    endif
    if author.youtube.value != blank
      assign same_as = same_as | append: author.youtube.value | append: '||'
    endif
    assign same_as_list = same_as | split: '||'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "url": {{ canonical_url | json }},
      "mainEntity": {
        "@type": "Person",
        "name": {{ author_name | json }},
        "url": {{ canonical_url | json }}
        {%- if author.job_title.value != blank -%}
          , "jobTitle": {{ author.job_title.value | json }}
        {%- endif -%}
        {%- if author.bio.value != blank -%}
          , "description": {{ author.bio.value | strip_html | strip | json }}
        {%- endif -%}
        {%- if author.photo.value != blank -%}
          , "image": {{ author.photo.value | image_url: width: 512 | prepend: 'https:' | json }}
        {%- endif -%}
        {%- if same_as_list.size > 0 -%}
          , "sameAs": {{ same_as_list | json }}
        {%- endif -%}
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.alc-author-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.alc-author-page.settings.setup_info.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.alc-author-page.settings.show_image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.alc-author-page.settings.eyebrow.label",
      "info": "t:sections.alc-author-page.settings.eyebrow.info",
      "default": "t:sections.alc-author-page.settings.eyebrow.default"
    },
    {
      "type": "richtext",
      "id": "default_bio",
      "label": "t:sections.alc-author-page.settings.default_bio.label",
      "info": "t:sections.alc-author-page.settings.default_bio.info",
      "default": "t:sections.alc-author-page.settings.default_bio.default"
    },
    {
      "type": "text",
      "id": "years_label",
      "label": "t:sections.alc-author-page.settings.years_label.label",
      "default": "t:sections.alc-author-page.settings.years_label.default"
    },
    {
      "type": "text",
      "id": "archive_label",
      "label": "t:sections.alc-author-page.settings.archive_label.label",
      "default": "t:sections.alc-author-page.settings.archive_label.default"
    },
    {
      "type": "checkbox",
      "id": "show_socials",
      "default": true,
      "label": "t:sections.alc-author-page.settings.show_socials.label"
    },
    {
      "type": "header",
      "content": "t:sections.alc-author-page.settings.list_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_card_images",
      "default": true,
      "label": "t:sections.alc-author-page.settings.show_card_images.label"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "t:sections.alc-blog-grid.settings.read_more_label.label",
      "default": "t:sections.alc-blog-grid.settings.read_more_label.default"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ]
}
{% endschema %}
