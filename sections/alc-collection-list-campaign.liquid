{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  # Check if section should be displayed for current locale
  assign show_section = true
  if section.settings.section_locale_codes != blank
    assign section_locale_codes = section.settings.section_locale_codes | split: ','
    assign show_section = false
    assign current_locale = request.locale.iso_code | downcase
    for code in section_locale_codes
      assign trimmed_code = code | strip | downcase
      if trimmed_code == current_locale
        assign show_section = true
        break
      endif
    endfor
  endif
-%}

{%- if show_section -%}

<div class="mobile-color-scheme-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin" style="display: flex; justify-content: space-between; align-items: center;">
        <h2 id="SectionHeading-{{ section.id }}" class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>

        <a
          href="{{ section.settings.see_all_url | default: routes.collections_url }}"
          class="button button--secondary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="white-space: nowrap;">
          {{- section.settings.see_all_button_text | default: 'See all products' -}}
        </a>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}">
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if section.settings.swipe_on_mobile %} slider slider--tablet grid--peek{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list">
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}
        {%- for block in section.blocks -%}
          {%- comment -%} Check if block should be displayed for current locale {%- endcomment -%}
          {%- assign show_block = true -%}
          {%- if block.settings.locale_codes != blank -%}
            {%- assign locale_codes = block.settings.locale_codes | split: ',' -%}
            {%- assign show_block = false -%}
            {%- assign current_locale = request.locale.iso_code | downcase -%}
            {%- for code in locale_codes -%}
              {%- assign trimmed_code = code | strip | downcase -%}
              {%- if trimmed_code == current_locale -%}
                {%- assign show_block = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if show_block -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if block.type == 'featured_collection' and block.settings.collection.featured_image == nil %} collection-list__item--no-media{% elsif block.type == 'custom_image' and block.settings.image == nil %} collection-list__item--no-media{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
              {% endif %}>

              {%- if block.type == 'featured_collection' -%}
                {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                {% render 'alc-card-collection-campaign'
                  , card_collection: block.settings.collection
                  , media_aspect_ratio: section.settings.image_ratio
                  , columns: columns
                  , placeholder_image: placeholder_image
                %}
              {%- elsif block.type == 'custom_image' -%}
              {%- liquid
                assign ratio = 1
                if block.settings.image and section.settings.image_ratio == 'portrait'
                  assign ratio = 0.8
                elsif block.settings.image and section.settings.image_ratio == 'adapt'
                  assign ratio = block.settings.image.aspect_ratio
                endif
                if ratio == 0 or ratio == null
                  assign ratio = 1
                endif
              -%}

              <div class="card-wrapper">
                {%- if block.settings.action_type == 'popup' -%}
                  <button
                    type="button"
                    class="full-unstyled-link"
                    style="border: none; background: none; padding: 0; cursor: pointer; width: 100%;"
                    data-open-modal="popup-data-{{ section.id }}-{{ forloop.index }}"
                    aria-label="{{ block.settings.alt_text | escape }}"
                  >
                {%- else -%}
                  <a
                    href="{{ block.settings.link_url | default: '#' }}"
                    class="full-unstyled-link"
                  >
                {%- endif -%}
                  <div
                    class="card card--media"
                    style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%; border: none;"
                  >
                    <div
                      class="card__inner ratio"
                      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%; border: none;"
                    >
                      {%- if block.settings.image -%}
                        <div class="card__media" style="border: none;">
                          <div class="media media--transparent media--hover-effect">
                            <img
                              srcset="
                                {%- if block.settings.image.width >= 165 -%}{{ block.settings.image | image_url: width: 165 }} 165w,{%- endif -%}
                                {%- if block.settings.image.width >= 330 -%}{{ block.settings.image | image_url: width: 330 }} 330w,{%- endif -%}
                                {%- if block.settings.image.width >= 535 -%}{{ block.settings.image | image_url: width: 535 }} 535w,{%- endif -%}
                                {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                                {%- if block.settings.image.width >= 1000 -%}{{ block.settings.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                                {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
                                {%- if block.settings.image.width >= 3000 -%}{{ block.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
                                {{ block.settings.image | image_url }} {{ block.settings.image.width }}w
                              "
                              src="{{ block.settings.image | image_url: width: 1500 }}"
                              sizes="
                                (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: columns }}px,
                                (min-width: 750px) {% if columns > 1 %}calc((100vw - 10rem) / 2){% else %}calc(100vw - 10rem){% endif %},
                                calc(100vw - 3rem)
                              "
                              alt="{{ block.settings.alt_text | escape }}"
                              height="{{ block.settings.image.height }}"
                              width="{{ block.settings.image.width }}"
                              loading="lazy"
                              class="motion-reduce"
                            >
                          </div>
                        </div>
                      {%- else -%}
                        <div class="card__media" style="border: none;">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- if block.settings.action_type == 'popup' -%}
                  </button>
                {%- else -%}
                  </a>
                {%- endif -%}
              </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </slider-component>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div
        class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
        data-cascade
        {% endif %}>
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}">
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Store popup messages as data attributes {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- comment -%} Check if block should be displayed for current locale {%- endcomment -%}
    {%- assign show_block = true -%}
    {%- if block.settings.locale_codes != blank -%}
      {%- assign locale_codes = block.settings.locale_codes | split: ',' -%}
      {%- assign show_block = false -%}
      {%- assign current_locale = request.locale.iso_code | downcase -%}
      {%- for code in locale_codes -%}
        {%- assign trimmed_code = code | strip | downcase -%}
        {%- if trimmed_code == current_locale -%}
          {%- assign show_block = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if show_block and block.type == 'custom_image' and block.settings.action_type == 'popup' and block.settings.popup_message != blank -%}
      <div id="popup-data-{{ section.id }}-{{ forloop.index }}" style="display: none;">
        {{ block.settings.popup_message }}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- comment -%} Load SweetAlert2 CDN {%- endcomment -%}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
  /* Desktop - transparent background, hide color scheme */
  @media screen and (min-width: 750px) {
    .mobile-color-scheme-{{ section.id }}.color-{{ section.settings.color_scheme }} {
      background: transparent !important;
      background-image: none !important;
    }
  }
</style>

<style>
  .campaign-popup {
    max-width: 1000px !important;
    border-radius: 12px !important;
  }

  .campaign-popup-title {
    font-size: 2.5rem !important;
    font-weight: 900 !important;
    color: #000 !important;
    letter-spacing: 0.05em !important;
    margin-bottom: 1.5rem !important;
  }

  .campaign-popup-content {
    font-size: 1.25rem !important;
    line-height: 1.6 !important;
  }

  .campaign-popup-content h1,
  .campaign-popup-content h2,
  .campaign-popup-content h3 {
    font-size: 2rem !important;
    font-weight: 700 !important;
    margin-bottom: 1rem !important;
  }

  .campaign-popup-content p {
    font-size: 1.25rem !important;
    margin-bottom: 1rem !important;
  }

  .campaign-popup-content strong,
  .campaign-popup-content b {
    font-weight: 700 !important;
    font-size: 1.35rem !important;
  }

  @media screen and (max-width: 750px) {
    .campaign-popup-content {
      font-size: 1.1rem !important;
    }

    .campaign-popup-content h1,
    .campaign-popup-content h2,
    .campaign-popup-content h3 {
      font-size: 1.5rem !important;
    }

    .campaign-popup-content p {
      font-size: 1.1rem !important;
    }

    .campaign-popup-content strong,
    .campaign-popup-content b {
      font-size: 1.2rem !important;
    }
  }
</style>

<script>
  (function() {
    // Handle popup opening via data-open-modal attribute
    function initPopupTriggers() {
      const popupTriggers = document.querySelectorAll('[data-open-modal]');

      popupTriggers.forEach(trigger => {
        // Remove existing listener if any
        trigger.removeEventListener('click', trigger._popupClickHandler);

        // Create and store the handler
        trigger._popupClickHandler = function(e) {
          e.preventDefault();
          const popupId = this.getAttribute('data-open-modal');
          const popupData = document.getElementById(popupId);

          if (popupData) {
            const htmlContent = popupData.innerHTML;

            Swal.fire({
              title: 'BLACK FRIDAY',
              html: htmlContent,
              showCloseButton: true,
              showConfirmButton: false,
              customClass: {
                popup: 'campaign-popup',
                title: 'campaign-popup-title',
                htmlContainer: 'rte campaign-popup-content'
              },
              width: '90%',
              padding: '3rem',
              backdrop: 'rgba(0,0,0,0.7)'
            });
          }
        };

        trigger.addEventListener('click', trigger._popupClickHandler);
      });
    }

    // Initialize on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPopupTriggers);
    } else {
      initPopupTriggers();
    }

    // Re-initialize when Shopify section is re-rendered
    document.addEventListener('shopify:section:load', initPopupTriggers);
  })();
</script>

{%- endif -%}

{% schema %}
  {
    "name": "ALC - Campaign List",
    "tag": "section",
    "class": "section section-collection-list",
    "max_blocks": 15,
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Section Visibility"
      },
      {
        "type": "text",
        "id": "section_locale_codes",
        "label": "Show section only on these locales (optional)",
        "info": "Enter comma-separated ISO codes (e.g., 'pl,hu' or 'ro,bg'). Leave blank to show on all locales. This hides the entire section when the locale doesn't match."
      },
      {
        "type": "header",
        "content": "Section Content"
      },
      {
        "type": "inline_richtext",
        "id": "title",
        "default": "t:sections.collection-list.settings.title.default",
        "label": "t:sections.collection-list.settings.title.label"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h0",
            "label": "t:sections.all.heading_size.options__3.label"
          },
          {
            "value": "hxl",
            "label": "t:sections.all.heading_size.options__4.label"
          },
          {
            "value": "hxxl",
            "label": "t:sections.all.heading_size.options__5.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
          },
          {
            "value": "portrait",
            "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
          },
          {
            "value": "square",
            "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
          }
        ],
        "default": "square",
        "label": "t:sections.collection-list.settings.image_ratio.label",
        "info": "t:sections.collection-list.settings.image_ratio.info"
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3,
        "label": "t:sections.collection-list.settings.columns_desktop.label"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "info": "t:sections.all.colors.has_cards_info",
        "default": "scheme-1"
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "default": false,
        "label": "t:sections.collection-list.settings.show_view_all.label"
      },
      {
        "type": "header",
        "content": "See All Button"
      },
      {
        "type": "text",
        "id": "see_all_button_text",
        "label": "Button Text",
        "default": "See all products"
      },
      {
        "type": "url",
        "id": "see_all_url",
        "label": "Button URL",
        "info": "Leave empty to link to all collections"
      },
      {
        "type": "header",
        "content": "t:sections.collection-list.settings.header_mobile.content"
      },
      {
        "type": "select",
        "id": "columns_mobile",
        "options": [
          {
            "value": "1",
            "label": "t:sections.collection-list.settings.columns_mobile.options__1.label"
          },
          {
            "value": "2",
            "label": "t:sections.collection-list.settings.columns_mobile.options__2.label"
          }
        ],
        "default": "1",
        "label": "t:sections.collection-list.settings.columns_mobile.label"
      },
      {
        "type": "checkbox",
        "id": "swipe_on_mobile",
        "default": false,
        "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "featured_collection",
        "name": "t:sections.collection-list.blocks.featured_collection.name",
        "settings": [
          {
            "type": "collection",
            "id": "collection",
            "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
          },
          {
            "type": "text",
            "id": "locale_codes",
            "label": "Locale Codes (optional)",
            "info": "Show only for these locales. Enter comma-separated ISO codes (e.g., 'en,ro,bg'). Leave blank to show for all locales."
          }
        ]
      },
      {
        "type": "custom_image",
        "name": "Custom Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "alt_text",
            "label": "Image Alt Text",
            "default": "Campaign image"
          },
          {
            "type": "select",
            "id": "action_type",
            "label": "Action Type",
            "options": [
              {
                "value": "url",
                "label": "Link to URL"
              },
              {
                "value": "popup",
                "label": "Show Pop-up Message"
              }
            ],
            "default": "url"
          },
          {
            "type": "url",
            "id": "link_url",
            "label": "Link URL",
            "info": "Used when Action Type is 'Link to URL'"
          },
          {
            "type": "richtext",
            "id": "popup_message",
            "label": "Pop-up Message",
            "info": "Used when Action Type is 'Show Pop-up Message'"
          },
          {
            "type": "text",
            "id": "locale_codes",
            "label": "Locale Codes (optional)",
            "info": "Show only for these locales. Enter comma-separated ISO codes (e.g., 'en,ro,bg'). Leave blank to show for all locales."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "ALC - Campaign List",
        "blocks": [
          {
            "type": "featured_collection"
          },
          {
            "type": "featured_collection"
          },
          {
            "type": "featured_collection"
          }
        ]
      }
    ]
  }
{% endschema %}