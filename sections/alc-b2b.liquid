    else
      assign w = "Program B2B · Dropshipping|Magazinul tău. Stocul nostru.|Vinzi produsele Alessandro Design în magazinul tău online, fără stoc și fără depozit. Când primești o comandă, noi o ambalăm și o livrăm direct clientului tău.|Cere oferta B2B|Calculează-ți marja|Magazinul tău|Comandă nouă|Plătită|Ambalată|Livrată|Adaugă în coș|produse gata de listat|zile lucrătoare de livrare|investiție în stoc|showroom și depozit|Cum funcționează|De la comandă la client, fără să atingi un colet.|Listezi produsele|Alegi din catalogul nostru și le publici în magazinul tău, cu prețurile tale.|Primești comanda|Clientul cumpără de la tine. Ne transmiți comanda, iar plata o faci conform raportului financiar agreat.|Noi ambalăm și expediem|Pregătim coletul din stocul nostru și îl trimitem direct clientului tău.|Clientul primește coletul|Livrare în 2–4 zile lucrătoare. Între timp, tu te ocupi deja de următoarea vânzare.|Comparație|Magazin clasic sau dropshipping cu noi?|Magazin clasic|Dropshipping cu Alessandro|Investiție în stoc|Mare|Zero|Depozit|Necesar|Nu ai nevoie|Risc de marfă nevândută|Ridicat|Zero|Ambalare și livrare|Le faci tu|Le facem noi|Timp pentru vânzări|Puțin|Tot|Putere de import|Fabrică proprie|Sisteme proprii|Echipă dedicată|Calculator|Cât poți câștiga?|Estimează-ți profitul lunar. Prețurile de achiziție le primești în oferta B2B.|Preț de achiziție|Prețul tău de vânzare|Comenzi pe lună|Marja pe produs|Profit brut pe lună|Estimare orientativă, fără costurile de marketing, transport și taxe.|Catalog|{n} produse, gata de listat.|Vezi catalogul|Întrebări frecvente|Tot ce trebuie să știi|Ce este dropshipping-ul?|Un model de afaceri în care vânzătorul nu ține produse în stoc. Când primește o comandă, cumpără produsul de la furnizor, iar furnizorul îl trimite direct clientului.|Cât de sigur este dropshipping-ul?|Este un model sigur atâta timp cât lucrezi cu un furnizor de încredere și îți gestionezi corect plățile și logistica.|Ce profit pot obține?|Depinde de nișă, de marja pe care o alegi și de volumul de vânzări. Contează mult alegerea produselor potrivite și campaniile de marketing bine optimizate.|De ce să ne alegi ca partener?|Avem experiență pe piață, putere de import, fabrică proprie și sisteme dezvoltate intern, pe care le adaptăm nevoilor tale. Iar echipa noastră e tânără, dedicată și motivată să îți crească afacerea.|Gata să vinzi fără stoc?|Spune-ne despre magazinul tău și îți trimitem condițiile programului B2B dropshipping.|Scrie-ne pe WhatsApp|Pagina de contact|Salut! Doresc să aflu mai multe despre programul B2B dropshipping.|.|5.000+ m²|acum"
  endcase
  assign t = w | split: '|'

  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif

  comment
    Live catalogue size, rounded down to the hundred: "3.300+".
  endcomment
  assign n = collections.all.products_count | divided_by: 100 | times: 100
  assign n_thousands = n | divided_by: 1000
  assign n_rest = n | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
  if n_thousands > 0
    assign product_count = n_thousands | append: t[75] | append: n_rest | append: '+'
  else
    assign product_count = n | append: '+'
  endif
  assign count_token = '{' | append: 'n' | append: '}'
  assign catalog_title = t[58] | replace: count_token, product_count

  assign wa_number = section.settings.whatsapp | remove: '+' | remove: ' '
  assign wa_msg = t[74] | url_encode | replace: '+', '%20'
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_msg
  assign p_contact = pages['contact']

  comment
    The product shown in the store mock: the one picked in the editor, otherwise the
    first available product with a photo in the strip's collection.
  endcomment
  assign strip = section.settings.strip_collection | default: collections['lustre-led']
  assign spot = section.settings.hero_product
  if spot == blank
    for p in strip.products
      if p.available and p.featured_image
        assign spot = p
        break
      endif
    endfor
  endif
-%}

<div class="alc-b2b">
  {%- comment -%} Hero {%- endcomment -%}
  <section class="alc-b2b__hero">
    <div class="page-width alc-b2b__hero-grid">
      <div class="alc-b2b__hero-copy">
        <p class="alc-b2b__pill"><span class="alc-b2b__pill-dot" aria-hidden="true"></span>{{ t[0] }}</p>
        <h1 class="alc-b2b__h1">{{ t[1] }}</h1>
        <p class="alc-b2b__lead">{{ t[2] }}</p>
        <div class="alc-b2b__actions">
          <a class="alc-b2b__btn alc-b2b__btn--wa" href="{{ wa_url }}" target="_blank" rel="noopener">
            {%- render 'alc-ds-icon', name: 'whatsapp' -%}
            {{- t[3] -}}
          </a>
          <a class="alc-b2b__btn alc-b2b__btn--ghost" href="#AlcB2bCalc">{{ t[4] }}</a>
        </div>
      </div>

      {%- if spot != blank -%}
        {%- comment -%} Decorative: it repeats what the copy says, so screen readers skip it. {%- endcomment -%}
        <div class="alc-b2b__scene" aria-hidden="true">
          <div class="alc-b2b__win">
            <div class="alc-b2b__win-bar">
              <span></span><span></span><span></span>
              <em>{{ t[5] }}</em>
            </div>
            <div class="alc-b2b__win-body">
              <div class="alc-b2b__win-media">
                {{
                  spot.featured_image
                  | image_url: width: 640
                  | image_tag: widths: '320, 480, 640', sizes: '(min-width: 990px) 300px, 60vw', loading: 'eager', alt: '', class: 'alc-b2b__win-img'
                }}
              </div>
              <div class="alc-b2b__win-info">
                <span class="alc-b2b__win-title">{{ spot.title | escape }}</span>
                <span class="alc-b2b__win-price">{{ spot.price | money }}</span>
                <span class="alc-b2b__win-btn">{{ t[10] }}</span>
              </div>
            </div>
          </div>

          <div class="alc-b2b__toast">
            <span class="alc-b2b__toast-icon">{%- render 'alc-header-icon', name: 'bag' -%}</span>
            <span class="alc-b2b__toast-text">
              <strong>{{ t[6] }}</strong>
              <span>{{ spot.price | money }} · {{ t[77] }}</span>
            </span>
          </div>

          <div class="alc-b2b__track">
            <div class="alc-b2b__track-line"><span class="alc-b2b__track-fill"></span></div>
            <ol class="alc-b2b__track-steps">
              <li class="alc-b2b__track-step alc-b2b__track-step--1"><i></i>{{ t[7] }}</li>
              <li class="alc-b2b__track-step alc-b2b__track-step--2"><i></i>{{ t[8] }}</li>
              <li class="alc-b2b__track-step alc-b2b__track-step--3"><i></i>{{ t[9] }}</li>
            </ol>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} Proof row {%- endcomment -%}
  <div class="page-width">
    <dl class="alc-b2b__proof">
      <div><dd>{{ product_count }}</dd><dt>{{ t[11] }}</dt></div>
      <div><dd>2–4</dd><dt>{{ t[12] }}</dt></div>
      <div><dd>0</dd><dt>{{ t[13] }}</dt></div>
      <div><dd>{{ t[76] }}</dd><dt>{{ t[14] }}</dt></div>
    </dl>
  </div>

  {%- comment -%} The flow as a delivery route {%- endcomment -%}
  <section class="page-width alc-b2b__block">
    <header class="alc-b2b__head">
      <p class="alc-b2b__eyebrow">{{ t[15] }}</p>
      <h2 class="alc-b2b__h2">{{ t[16] }}</h2>
    </header>
    <ol class="alc-b2b__route" role="list"{% if reveal != blank %} data-cascade{% endif %}>
      {%- for i in (1..4) -%}
        {%- liquid
          assign ti = i | minus: 1 | times: 2 | plus: 17
          assign di = ti | plus: 1
          case i
            when 1
              assign icon = 'list'
            when 2
              assign icon = 'card'
            when 3
              assign icon = 'box'
            else
              assign icon = 'truck'
          endcase
        -%}
        <li class="alc-b2b__stop{{ reveal }}" style="--animation-order: {{ i }};">
          <span class="alc-b2b__stop-node" aria-hidden="true">{%- render 'alc-ds-icon', name: icon -%}</span>
          <span class="alc-b2b__stop-num">0{{ i }}</span>
          <h3 class="alc-b2b__stop-title">{{ t[ti] }}</h3>
          <p class="alc-b2b__stop-text">{{ t[di] }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </section>

  {%- comment -%} Comparison {%- endcomment -%}
  <section class="alc-b2b__cmp-band">
    <div class="page-width">
      <header class="alc-b2b__head alc-b2b__head--center">
        <p class="alc-b2b__eyebrow">{{ t[25] }}</p>
        <h2 class="alc-b2b__h2">{{ t[26] }}</h2>
      </header>
      <div class="alc-b2b__cmp" role="table" aria-label="{{ t[26] | escape }}">
        <div class="alc-b2b__cmp-row alc-b2b__cmp-row--head" role="row">
          <span role="columnheader"></span>
          <span role="columnheader">{{ t[27] }}</span>
          <span role="columnheader" class="alc-b2b__cmp-us">{{ t[28] }}</span>
        </div>
        {%- for i in (1..5) -%}
          {%- liquid
            assign ri = i | minus: 1 | times: 3 | plus: 29
            assign ai = ri | plus: 1
            assign bi = ri | plus: 2
          -%}
          <div class="alc-b2b__cmp-row" role="row">
            <span role="rowheader" class="alc-b2b__cmp-crit">{{ t[ri] }}</span>
            <span role="cell" class="alc-b2b__cmp-them"><i aria-hidden="true">×</i>{{ t[ai] }}</span>
            <span role="cell" class="alc-b2b__cmp-us"><i aria-hidden="true">✓</i>{{ t[bi] }}</span>
          </div>
        {%- endfor -%}
      </div>
      <ul class="alc-b2b__chips" role="list">
        {%- for i in (44..47) -%}
          <li>{{ t[i] }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} Margin calculator {%- endcomment -%}
  <section class="page-width alc-b2b__block" id="AlcB2bCalc">
    <alc-b2b-calc
      class="alc-b2b__calc"
      data-currency="{{ cart.currency.iso_code }}"
      data-money="{{ 123400 | money_without_trailing_zeros | escape }}"
      data-lang="{{ request.locale.iso_code }}"
    >
      <div class="alc-b2b__calc-copy">
        <p class="alc-b2b__eyebrow">{{ t[48] }}</p>
        <h2 class="alc-b2b__h2">{{ t[49] }}</h2>
        <p class="alc-b2b__calc-lead">{{ t[50] }}</p>
        <div class="alc-b2b__fields">
          <label class="alc-b2b__field">
            <span class="alc-b2b__field-top"><span>{{ t[51] }}</span><output data-out="buy"></output></span>
            <input type="range" data-in="buy" data-base="150" data-max="1500">
          </label>
          <label class="alc-b2b__field">
            <span class="alc-b2b__field-top"><span>{{ t[52] }}</span><output data-out="sell"></output></span>
            <input type="range" data-in="sell" data-base="249" data-max="2500">
          </label>
          <label class="alc-b2b__field">
            <span class="alc-b2b__field-top"><span>{{ t[53] }}</span><output data-out="qty"></output></span>
            <input type="range" data-in="qty" min="1" max="200" step="1" value="20">
          </label>
        </div>
      </div>
      <div class="alc-b2b__calc-result" aria-live="polite">
        <div class="alc-b2b__res">
          <span class="alc-b2b__res-label">{{ t[54] }}</span>
          <span class="alc-b2b__res-value" data-out="margin">–</span>
        </div>
        <div class="alc-b2b__res alc-b2b__res--big">
          <span class="alc-b2b__res-label">{{ t[55] }}</span>
          <span class="alc-b2b__res-value" data-out="profit">–</span>
        </div>
        <p class="alc-b2b__res-note">{{ t[56] }}</p>
      </div>
    </alc-b2b-calc>
  </section>

  {%- comment -%} Moving strip of real products {%- endcomment -%}
  {%- if strip != blank -%}
    <section class="alc-b2b__block alc-b2b__strip-wrap">
      <header class="page-width alc-b2b__head alc-b2b__head--row">
        <div>
          <p class="alc-b2b__eyebrow">{{ t[57] }}</p>
          <h2 class="alc-b2b__h2">{{ catalog_title }}</h2>
        </div>
        <a class="alc-b2b__more" href="{{ routes.all_products_collection_url }}">
          {{- t[59] -}}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </header>
      <div class="alc-b2b__strip" aria-hidden="true">
        {%- for row in (1..2) -%}
          <div class="alc-b2b__strip-row alc-b2b__strip-row--{{ row }}">
            {%- comment -%} Each row is printed twice so the loop has no seam. {%- endcomment -%}
            {%- for copy in (1..2) -%}
              {%- assign shown = 0 -%}
              {%- for p in strip.products -%}
                {%- unless p.featured_image -%}{%- continue -%}{%- endunless -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- assign half = shown | modulo: 2 -%}
                {%- if row == 1 and half == 0 -%}{%- continue -%}{%- endif -%}
                {%- if row == 2 and half == 1 -%}{%- continue -%}{%- endif -%}
                {%- if shown > 16 -%}{%- break -%}{%- endif -%}
                <span class="alc-b2b__strip-item">
                  {{ p.featured_image | image_url: width: 300 | image_tag: widths: '200, 300', sizes: '150px', loading: 'lazy', alt: '' }}
                </span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} FAQ {%- endcomment -%}
  <section class="page-width alc-b2b__block">
    <div class="alc-b2b__faq-grid">
      <header class="alc-b2b__head">
        <p class="alc-b2b__eyebrow">{{ t[60] }}</p>
        <h2 class="alc-b2b__h2">{{ t[61] }}</h2>
      </header>
      <div class="alc-b2b__faq">
        {%- for i in (1..4) -%}
          {%- assign qi = i | minus: 1 | times: 2 | plus: 62 -%}
          {%- assign ai = qi | plus: 1 -%}
          <details class="alc-b2b__qa"{% if forloop.first %} open{% endif %}>
            <summary class="alc-b2b__q"><span>{{ t[qi] }}</span><i aria-hidden="true"></i></summary>
            <p class="alc-b2b__a">{{ t[ai] }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} Closing call to action {%- endcomment -%}
  <section class="page-width alc-b2b__block alc-b2b__block--last">
    <div class="alc-b2b__final">
      <h2 class="alc-b2b__final-title">{{ t[70] }}</h2>
      <p class="alc-b2b__final-text">{{ t[71] }}</p>
      <div class="alc-b2b__actions alc-b2b__actions--center">
        <a class="alc-b2b__btn alc-b2b__btn--wa" href="{{ wa_url }}" target="_blank" rel="noopener">
          {%- render 'alc-ds-icon', name: 'whatsapp' -%}
          {{- t[72] -}}
        </a>
        {%- if p_contact != blank -%}
          <a class="alc-b2b__btn alc-b2b__btn--ghost" href="{{ p_contact.url }}">{{ t[73] }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": {{ request.locale.iso_code | json }},
      "mainEntity": [
        {%- for i in (1..4) -%}
          {%- assign qi = i | minus: 1 | times: 2 | plus: 62 -%}
          {%- assign ai = qi | plus: 1 -%}
          { "@type": "Question", "name": {{ t[qi] | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ t[ai] | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% schema %}
{
  "name": "B2B dropshipping page",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "All texts have built-in translations for every storefront language." },
    { "type": "text", "id": "whatsapp", "label": "B2B WhatsApp number", "default": "40725665925", "info": "International format, digits only" },
    { "type": "product", "id": "hero_product", "label": "Product in the store mock", "info": "Empty: the first available product of the strip collection" },
    { "type": "collection", "id": "strip_collection", "label": "Products in the moving strip", "info": "Empty: Lustre LED" }
  ],
  "presets": [{ "name": "B2B dropshipping page" }]
}
{% endschema %}
