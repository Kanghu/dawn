<div class="alc-co{% if section.settings.part == 'closing' %} alc-co--closing{% endif %}">
  {%- unless section.settings.part == 'closing' -%}
  {%- comment -%} Hero {%- endcomment -%}
  <section class="alc-co__hero">
    <div class="alc-co__hero-media">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'alc-co__hero-img',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            fetchpriority: 'high',
            loading: 'eager',
            alt: ''
        }}
      {%- else -%}
        <img
          class="alc-co__hero-img"
          src="{{ 'alc-showroom-hall.jpg' | asset_img_url: '1600x' }}"
          srcset="{{ 'alc-showroom-hall.jpg' | asset_img_url: '800x' }} 800w, {{ 'alc-showroom-hall.jpg' | asset_img_url: '1200x' }} 1200w, {{ 'alc-showroom-hall.jpg' | asset_img_url: '1600x' }} 1600w, {{ 'alc-showroom-hall.jpg' | asset_img_url: '2200x' }} 2200w"
          sizes="100vw"
          width="2200"
          height="1238"
          alt=""
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
    <div class="page-width alc-co__hero-inner">
      <p class="alc-co__eyebrow alc-co__eyebrow--light">{{ t[0] }}</p>
      <h1 class="alc-co__hero-title">{{ t[1] }}</h1>
      <p class="alc-co__hero-lead">{{ t[2] }}</p>
      <div class="alc-co__actions">
        <a class="alc-co__btn alc-co__btn--light" href="{{ shop_url }}">
          {{- t[3] -}}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        {%- if p_showroom != blank -%}
          <a class="alc-co__btn alc-co__btn--glass" href="{{ p_showroom.url }}">{{ t[4] }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} Key figures {%- endcomment -%}
  <div class="page-width">
    <dl class="alc-co__stats">
      <div class="alc-co__stat">
        <dt>{{ t[5] }}</dt>
        <dd>{{ t[51] }}</dd>
      </div>
      <div class="alc-co__stat">
        <dt>{{ t[6] }}</dt>
        <dd>
          {{- t[52] -}}
          <span class="alc-co__stat-unit">/5</span>
          <svg class="alc-co__star" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/></svg>
        </dd>
      </div>
      <div class="alc-co__stat">
        <dt>{{ t[7] }}</dt>
        <dd>{{ t[53] }}</dd>
      </div>
      <div class="alc-co__stat">
        <dt>{{ t[8] }}</dt>
        <dd>{{ t[54] }}</dd>
      </div>
    </dl>
  </div>

  {%- comment -%} Values {%- endcomment -%}
  <section class="page-width alc-co__block">
    <header class="alc-co__head">
      <p class="alc-co__eyebrow">{{ t[9] }}</p>
      <h2 class="alc-co__title">{{ t[10] }}</h2>
    </header>
