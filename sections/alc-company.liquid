      </a>
    </header>
    <ul class="alc-co__cats" role="list">
      {%- for i in (1..4) -%}
        {%- assign ckey = 'collection_' | append: i -%}
        {%- assign c = section.settings[ckey] -%}
        {%- if c != blank -%}
          <li>
            <a class="alc-co__cat" href="{{ c.url }}">
              <span class="alc-co__cat-media">
                {%- assign cimg = c.image | default: c.products.first.featured_image -%}
                {%- if cimg != blank -%}
                  {{
                    cimg
                    | image_url: width: 700
                    | image_tag:
                      widths: '300, 450, 600, 700',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="alc-co__cat-name">{{ c.title | escape }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>

  {%- comment -%} Customer photos {%- endcomment -%}
  <section class="page-width alc-co__block">
    <header class="alc-co__head alc-co__head--row">
      <div>
        <p class="alc-co__eyebrow">{{ t[44] }}</p>
        <h2 class="alc-co__title">{{ t[45] }}</h2>
      </div>
      {%- if p_photos != blank -%}
        <a class="alc-co__more" href="{{ p_photos.url }}">
          {{- t[46] -}}
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </header>
    <ul class="alc-co__photos" role="list">
      {%- for i in (1..4) -%}
        {%- assign pkey = 'photo_' | append: i -%}
        {%- assign ph = section.settings[pkey] -%}
        {%- if ph != blank -%}
          <li class="alc-co__photo">
            {{
              ph
              | image_url: width: 700
              | image_tag:
                widths: '300, 450, 600, 700',
                sizes: '(min-width: 990px) 25vw, 50vw',
                loading: 'lazy',
                alt: ''
            }}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>

  {%- endunless -%}

  {%- comment -%} Closing call to action {%- endcomment -%}
  {%- unless section.settings.part == 'body' -%}
  <section class="page-width alc-co__block alc-co__block--last">
    <div class="alc-co__final">
      <h2 class="alc-co__final-title">{{ t[47] }}</h2>
      <p class="alc-co__final-text">{{ t[48] }}</p>
      <div class="alc-co__actions alc-co__actions--center">
        {%- if p_contact != blank -%}
          <a class="alc-co__btn alc-co__btn--light" href="{{ p_contact.url }}">{{ t[49] }}</a>
        {%- endif -%}
        <a class="alc-co__btn alc-co__btn--glass" href="{{ shop_url }}">{{ t[3] }}</a>
      </div>
    </div>
  </section>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Company page",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "All texts have built-in translations for every storefront language." },
    {
      "type": "select",
      "id": "part",
      "label": "Show",
      "options": [
        { "value": "full", "label": "Whole page" },
        { "value": "body", "label": "Everything except the closing call to action" },
        { "value": "closing", "label": "Only the closing call to action" }
      ],
      "default": "full",
      "info": "Split the page to place other sections (e.g. reviews) before the closing call to action"
    },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Empty: showroom photo from the theme" },
    { "type": "image_picker", "id": "showroom_image", "label": "Showroom image", "info": "Empty: showroom photo from the theme" },
    { "type": "url", "id": "shop_url", "label": "Shop link" },
    { "type": "header", "content": "Press" },
    { "type": "url", "id": "press_1_url", "label": "Pro TV article" },
    { "type": "url", "id": "press_2_url", "label": "HotNews article" },
    { "type": "url", "id": "press_3_url", "label": "Antena 3 article" },
    { "type": "header", "content": "Collections" },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" },
    { "type": "collection", "id": "collection_3", "label": "Collection 3" },
    { "type": "collection", "id": "collection_4", "label": "Collection 4" },
    { "type": "header", "content": "Customer photos" },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "photo_4", "label": "Photo 4" }
  ],
  "presets": [{ "name": "Company page" }]
}
{% endschema %}
