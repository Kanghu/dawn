          <p class="alc-co__eyebrow">{{ t[33] }}</p>
          <h2 class="alc-co__title">{{ t[34] }}</h2>
          <p class="alc-co__intro">{{ t[35] }}</p>
          <a class="alc-co__btn alc-co__btn--dark" href="{{ p_showroom.url }}">
