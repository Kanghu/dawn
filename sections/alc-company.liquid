    <header class="alc-co__head">
      <p class="alc-co__eyebrow">{{ t[36] }}</p>
      <h2 class="alc-co__title">{{ t[37] }}</h2>
    </header>
    <ul class="alc-co__press" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign outlet = 'Pro TV'
              assign headline = t[38]
              assign href = section.settings.press_1_url
            when 2
              assign outlet = 'HotNews'
              assign headline = t[39]
              assign href = section.settings.press_2_url
            else
              assign outlet = 'Antena 3'
              assign headline = t[40]
              assign href = section.settings.press_3_url
          endcase
        -%}
        {%- if href != blank -%}
          <li>
            <a class="alc-co__press-card" href="{{ href }}" target="_blank" rel="noopener">
              <span class="alc-co__press-outlet">{{ outlet }}</span>
              <span class="alc-co__press-headline">{{ headline }}</span>
              <span class="alc-co__press-link">
                {{- t[50] -}}
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>

  {%- comment -%} Collections {%- endcomment -%}
