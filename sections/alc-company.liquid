        </span>
        <h3 class="alc-co__value-title">{{ t[11] }}</h3>
        <p class="alc-co__value-text">{{ t[12] }}</p>
      </li>
      <li class="alc-co__value">
        <span class="alc-co__value-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
        </span>
        <h3 class="alc-co__value-title">{{ t[13] }}</h3>
        <p class="alc-co__value-text">{{ t[14] }}</p>
      </li>
      <li class="alc-co__value">
        <span class="alc-co__value-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </span>
