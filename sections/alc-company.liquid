          <h3 class="alc-co__step-title">{{ t[20] }}</h3>
          <p class="alc-co__step-text">{{ t[21] }}</p>
        </li>
        <li class="alc-co__step">
          <span class="alc-co__year">2021</span>
          <h3 class="alc-co__step-title">{{ t[22] }}</h3>
          <p class="alc-co__step-text">{{ t[23] }}</p>
        </li>
        <li class="alc-co__step">
          <span class="alc-co__year">2022</span>
          <h3 class="alc-co__step-title">{{ t[24] }}</h3>
          <p class="alc-co__step-text">{{ t[25] }}</p>
        </li>
        <li class="alc-co__step">
          <span class="alc-co__year">2023</span>
          <h3 class="alc-co__step-title">{{ t[26] }}</h3>
          <p class="alc-co__step-text">{{ t[27] }}</p>
        </li>
        <li class="alc-co__step">
          <span class="alc-co__year">2024</span>
          <h3 class="alc-co__step-title">{{ t[28] }}</h3>
          <p class="alc-co__step-text">{{ t[29] }}</p>
        </li>
        <li class="alc-co__step alc-co__step--now">
          <span class="alc-co__year">{{ t[30] }}</span>
          <h3 class="alc-co__step-title">{{ t[31] }}</h3>
          <p class="alc-co__step-text">{{ t[32] }}</p>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%} Showroom {%- endcomment -%}
  {%- if p_showroom != blank -%}
    <section class="page-width alc-co__block">
      <div class="alc-co__split">
        <div class="alc-co__split-media">
          {%- if section.settings.showroom_image != blank -%}
            {{
              section.settings.showroom_image
              | image_url: width: 1400
              | image_tag:
                class: 'alc-co__split-img',
                widths: '600, 900, 1200, 1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
