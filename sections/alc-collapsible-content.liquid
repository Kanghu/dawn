{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alc-collapsible-preview.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="alc-pdp-acc color-{{ section.settings.color_scheme }} gradient" style="font-family: var(--font-body-family);">
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.layout == 'section' %} page-width{% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}">
      <div class="page-width">
        <div
          class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="text-align: {{ section.settings.heading_alignment }};"
        >
          {%- if section.settings.caption != blank -%}
            <p class="caption-with-letter-spacing">
              {{ section.settings.caption | escape }}
            </p>
          {% endif %}
          {%- if section.settings.heading != blank -%}
            <h2 class="collapsible-content__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- else -%}
            <div class="visually-hidden alc-h2">{{ 'accessibility.collapsible_content_title' | t }}</div>
          {% endif %}
        </div>
        <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            </div>
          {% endif %}
          <div class="grid__item">
            {%- assign preview_block_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- comment -%} Track preview-eligible blocks for open state {%- endcomment -%}
              {%- if block.type == 'collapsible_row' or block.type == 'collapsible_metafields' -%}
                {%- assign preview_block_count = preview_block_count | plus: 1 -%}
                {%- assign should_open = false -%}
                {%- if preview_block_count <= 2 -%}
                  {%- assign should_open = true -%}
                {%- endif -%}
              {%- else -%}
                {%- assign should_open = false -%}
              {%- endif -%}

              {% if block.type == 'collapsible_row' %}
                <div
                  class="accordion{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <details
                    id="Details-{{ block.id }}-{{ section.id }}"
                    {% if should_open %}open{% endif %}
                  >
                    <summary id="Summary-{{ block.id }}-{{ section.id }}">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <h3 class="accordion__title inline-richtext h4">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}
                      </h3>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <alc-collapsible-preview>
                      <div
                        class="accordion__content-preview is-collapsed"
                        id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                        role="region"
                        aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                      >
                        <div class="accordion__content rte">
                          {%- comment -%} Rendered here first so row_liquid sees the product, then made responsive {%- endcomment -%}
                          {%- capture row_html -%}
                            {% if block.settings.row_liquid != blank %}
                              {{ block.settings.row_liquid }}
                            {% elsif block.settings.row_content != blank %}
                              {{ block.settings.row_content }}
                            {% endif %}
                            {{ block.settings.page.content }}
                          {%- endcapture -%}
                          {% render 'alc-rte-images', html: row_html %}
                        </div>
                        <div class="accordion__gradient-overlay" aria-hidden="true"></div>
                      </div>
                      <button
                        type="button"
                        class="accordion__see-more-btn"
                        aria-expanded="false"
                      >
                        <span class="see-more-label">{{ 'products.facets.show_more' | t }}</span>
                        <span class="see-less-label hidden">{{ 'products.facets.show_less' | t }}</span>
                      </button>
                    </alc-collapsible-preview>
                  </details>
                </div>
              {% elsif block.type == 'collapsible_metafields' %}
  <!-- New custom metafields block -->
  <div class="accordion" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section.id }}" {% if should_open %}open{% endif %}>
      <summary id="Summary-{{ block.id }}-{{ section.id }}">
        {% render 'icon-accordion', icon: block.settings.icon %}
        <h3 class="accordion__title inline-richtext h4">
          {{ block.settings.heading }}
        </h3>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <alc-collapsible-preview>
        <div
          class="accordion__content-preview is-collapsed"
          id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
          role="region"
          aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
        >
          <div class="accordion__content rte">
        {% if product.metafields.custom != blank %}
          <!-- Force grid layout despite utility-class conflict -->
          <div class="py-2 grid grid-cols-1 md:grid-cols-2 gap-4" style="display: grid;">
            {%- comment -%}
              A product sits in several collections that carry specification groups (incl. the catch-all
              'Toate produsele'). Use the one whose groups have the most filled specs for this product;
              ties keep the first, as before, so no product shows fewer rows than it did.
            {%- endcomment -%}
            {%- assign collection_with_specs = nil -%}
            {%- assign best_spec_rows = -1 -%}
            {%- for collection in product.collections -%}
              {%- if collection.metafields.custom.specification_groups != blank -%}
                {%- assign candidate_rows = 0 -%}
                {%- for candidate_group in collection.metafields.custom.specification_groups.value -%}
                  {%- assign candidate_group_obj = candidate_group | metaobject -%}
                  {%- for candidate_spec in candidate_group_obj.specifications.value -%}
                    {%- if candidate_spec contains '.' -%}
                      {%- assign candidate_parts = candidate_spec | split: '.' -%}
                      {%- assign candidate_mf = product.metafields[candidate_parts[0]][candidate_parts[1]] -%}
                    {%- else -%}
                      {%- capture candidate_key -%}{%- render 'alc-spec-key', product: product, spec: candidate_spec -%}{%- endcapture -%}
                      {%- assign candidate_mf = product.metafields.custom[candidate_key] -%}
                    {%- endif -%}
                    {%- if candidate_mf and candidate_mf.value != blank -%}
                      {%- assign candidate_rows = candidate_rows | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- if candidate_rows > best_spec_rows -%}
                  {%- assign best_spec_rows = candidate_rows -%}
                  {%- assign collection_with_specs = collection -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {% if collection_with_specs %}
              {% for spec_group in collection_with_specs.metafields.custom.specification_groups.value %}
                {% assign spec_group_metaobj = spec_group | metaobject %}

              <div class="mb-16 w-100 md:w-50">
                  {%- comment -%}
                    Group titles live in the locale files, keyed by the group handle: the specification_group
                    metaobject is not translatable, so no translation app can overwrite its key list.
                  {%- endcomment -%}
                  {%- assign group_t_key = 'products.metaobjects.specification_group_titles.' | append: spec_group_metaobj.system.handle | replace: '-', '_' -%}
                  {%- assign group_title = group_t_key | t -%}
                  {%- if group_title contains 'ranslation missing' -%}{%- assign group_title = spec_group_metaobj.name -%}{%- endif -%}
                  <div class="alc-h3 alc-spec__group">{{ group_title }}</div>
                  {%- assign counter = 0 -%}
                  {%- for spec in spec_group_metaobj.specifications.value -%}
                      {%- if spec contains '.' -%}
                        {%- assign spec_parts = spec | split: '.' -%}
                        {%- assign spec_namespace = spec_parts[0] -%}
                        {%- assign spec_key = spec_parts[1] -%}
                        {%- assign mf = product.metafields[spec_namespace][spec_key] -%}
                        {%- assign mf_key = spec -%}
                      {%- else -%}
                        {%- capture mf_key -%}{%- render 'alc-spec-key', product: product, spec: spec -%}{%- endcapture -%}
                        {%- assign mf = product.metafields.custom[mf_key] -%}
                      {%- endif -%}
                      {% if mf %}
                          {% assign is_even = counter | modulo: 2 %}

                          <div class="alc-spec__row justify-between px-3 py-3 text-2xl flex flex-row{% if is_even == 0 %} is-alt{% endif %}">
        <span class="spec-name w-2/3 font-normal">
          {%- comment -%} Translation lookup: use Shopify's definition name for native metafields, manual for custom {%- endcomment -%}
          {%- assign current_locale = request.locale.iso_code -%}
          {%- assign translated_spec = '' -%}
          {%- comment -%} Spec keys come with and without a trailing underscore (tip_bec_ / tip_bec); the per-language lists use the bare key. {%- endcomment -%}
          {%- assign spec_base = spec -%}
          {%- assign spec_last = spec | slice: -1 -%}
          {%- if spec_last == '_' -%}
            {%- assign spec_base_len = spec.size | minus: 1 -%}
            {%- assign spec_base = spec | slice: 0, spec_base_len -%}
          {%- endif -%}

          {%- if spec contains '.' -%}
            {%- if mf.definition.name != blank -%}
              {%- assign translated_spec = mf.definition.name -%}
            {%- else -%}
              {%- comment -%} Fallback: format the key portion nicely {%- endcomment -%}
              {%- assign translated_spec = spec_key | replace: '-', ' ' | capitalize -%}
            {%- endif -%}
            {%- comment -%} Shopify taxonomy metafields have no definition name in Liquid (the key fallback is English): local labels per market {%- endcomment -%}
            {%- assign tax_lookup = current_locale | append: ':' | append: spec_key | append: '=' -%}
            {%- assign tax_pairs = 'bg:bulb-cap-type=Тип цокъл|bg:color-pattern=Цвят|bg:light-temperature=Цветна температура|bg:shape=Форма|bg:material=Материал|bg:style=Стил|bg:mounting-type=Тип монтаж|pl:bulb-cap-type=Typ trzonka|pl:color-pattern=Kolor|pl:light-temperature=Temperatura barwowa|pl:shape=Kształt|pl:material=Materiał|pl:style=Styl|pl:mounting-type=Rodzaj montażu|hu:bulb-cap-type=Foglalat típusa|hu:color-pattern=Szín|hu:light-temperature=Színhőmérséklet|hu:shape=Forma|hu:material=Anyag|hu:style=Stílus|hu:mounting-type=Rögzítés típusa|cs:bulb-cap-type=Typ patice|cs:color-pattern=Barva|cs:light-temperature=Teplota světla|cs:shape=Tvar|cs:material=Materiál|cs:style=Styl|cs:mounting-type=Typ montáže|sk:bulb-cap-type=Typ pätice|sk:color-pattern=Farba|sk:light-temperature=Teplota svetla|sk:shape=Tvar|sk:material=Materiál|sk:style=Štýl|sk:mounting-type=Typ montáže|el:bulb-cap-type=Τύπος κάλυκα|el:color-pattern=Χρώμα|el:light-temperature=Θερμοκρασία φωτός|el:shape=Σχήμα|el:material=Υλικό|el:style=Στυλ|el:mounting-type=Τύπος τοποθέτησης|hr:bulb-cap-type=Vrsta grla|hr:color-pattern=Boja|hr:light-temperature=Temperatura svjetla|hr:shape=Oblik|hr:material=Materijal|hr:style=Stil|hr:mounting-type=Način montaže|ro:bulb-cap-type=Tip soclu|ro:color-pattern=Culoare|ro:light-temperature=Temperatura luminii|ro:shape=Formă|ro:material=Material|ro:style=Stil|ro:mounting-type=Tip montaj' | split: '|' -%}
            {%- for tax_pair in tax_pairs -%}
              {%- if tax_pair contains tax_lookup -%}{%- assign translated_spec = tax_pair | remove_first: tax_lookup -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Labels live in the locale files (products.metaobjects.specification_groups.<key>); `x_` keys fall back to the bare `x` label. {%- endcomment -%}
            {%- assign spec_label_key = 'products.metaobjects.specification_groups.' | append: spec -%}
            {%- assign translated_spec = spec_label_key | t -%}
            {%- if translated_spec contains 'ranslation missing' -%}
              {%- assign spec_label_key = 'products.metaobjects.specification_groups.' | append: spec_base -%}
              {%- assign translated_spec = spec_label_key | t -%}
            {%- endif -%}
            {%- if translated_spec contains 'ranslation missing' -%}
              {%- assign translated_spec = spec_base | replace: '_', ' ' | capitalize -%}
            {%- endif -%}
          {%- endif -%}
          {{ translated_spec | strip | remove_last: ':' }}
        </span>

                <span class="spec-value w-1/3 font-medium">
                  {%- liquid
                    comment
                      Unit of the canonical key; printed after numbers, so the labels carry no unit.
                    endcomment
                    assign spec_unit = ''
                    if spec == 'putere_w'
                      assign spec_unit = 'W'
                    elsif spec == 'autonomie_h'
                      assign spec_unit = 'h'
                    elsif spec == 'flux_de_lumina_lm_'
                      assign spec_unit = 'lm'
                    elsif spec contains '_cm'
                      assign spec_unit = 'cm'
                    endif
                  -%}
                  {% if mf.type == 'list.metaobject_reference' %}
                    {%- if spec contains '.' -%}
                      {%- comment -%} Shopify standard metaobject references - use label field {%- endcomment -%}
                      {%- for metaobj_ref in mf.value -%}
                        {%- assign metaobj = metaobj_ref | metaobject -%}
                        {{ metaobj.label | default: metaobj.system.display_name }}
                        {%- unless forloop.last -%}, {% endunless -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- comment -%}
                        Custom option metaobjects: `display` is the translated storefront label. The older list field
                        named after the type (tip_produs: lustra_led) is only a fallback for entries without one.
                      {%- endcomment -%}
                      {%- assign legacy_field = mf_key | remove_last: '_' -%}
                      {%- if mf_key == 'tip_produs_' -%}
                        {%- assign legacy_field = 'lustra_led' -%}
                      {%- endif -%}

                      {% assign parsed = mf.value | parse_json %}
                      {%- liquid
                        comment
                          Built as one string so no template whitespace lands before the commas.
                        endcomment
                        assign spec_list = ''
                        for entry in parsed
                          assign entry_label = entry.display | append: '' | strip
                          if entry_label == blank
                            assign entry_label = entry[legacy_field] | join: ', ' | replace: '[', '' | replace: ']', '' | replace: '"', '' | strip
                          endif
                          if entry_label == blank
                            continue
                          endif
                          if spec_list != blank
                            assign spec_list = spec_list | append: ', '
                          endif
                          assign spec_list = spec_list | append: entry_label
                        endfor
                        echo spec_list
                      -%}
                    {%- endif -%}
                  {% elsif mf.type == 'boolean' %}
                    {%- if mf.value == true -%}
                      {{ 'products.metaobjects.specification_values.yes' | t }}
                    {%- else -%}
                      {{ 'products.metaobjects.specification_values.no' | t }}
                    {%- endif -%}
                  {% elsif mf.type == 'number_decimal' or mf.type == 'number_integer' %}
                    {{ mf.value | round: 1 | append: '' | replace: '.0', '' }}{% if spec_unit != blank %} {{ spec_unit }}{% endif %}
                  {% else %}
                    {%- liquid
                      assign spec_text = mf.value | join: ', ' | replace: '[', '' | replace: ']', '' | replace: '"', '' | strip
                      comment
                        Number lists (flux_de_lumina_lm_) and bare numbers in a free-text twin get the unit too.
                      endcomment
                      assign spec_number = spec_text | plus: 0 | append: ''
                      assign show_unit = false
                      if spec_unit != blank
                        if mf.type contains 'number' or spec_number == spec_text
                          assign show_unit = true
                        endif
                      endif
                    -%}
                    {{ spec_text }}{% if show_unit %} {{ spec_unit }}{% endif %}
                  {% endif %}
                </span>
              </div>

                          {%- assign counter = counter | plus: 1 -%}
                      {% endif %}
                  {%- endfor -%}
              </div>
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}
          </div>
          <div class="accordion__gradient-overlay" aria-hidden="true"></div>
        </div>
        <button
          type="button"
          class="accordion__see-more-btn"
          aria-expanded="false"
        >
          <span class="see-more-label">{{ 'products.facets.show_more' | t }}</span>
          <span class="see-less-label hidden">{{ 'products.facets.show_less' | t }}</span>
        </button>
      </alc-collapsible-preview>
    </details>
  </div>
              {% elsif block.type == 'collapsible_qa' %}
                <!-- Questions and Answers block -->
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary id="Summary-{{ block.id }}-{{ section.id }}">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <span class="accordion__title inline-richtext h4">
                        {{ block.settings.heading }}
                      </span>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div
                      class="accordion__content rte"
                      id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                      role="region"
                      aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                    >
                      {% if product.metafields.custom.questions != blank %}
                        <div class="space-y-6">
                          {% for q in product.metafields.custom.questions.value %}
                            <div class="bg-gray-50 rounded-lg p-6 md:p-6 p-4 border border-gray-200 hover:border-gray-300 transition-colors duration-200">
                              <div class="question-header flex items-center gap-2 mb-3">
                                <svg
                                  class="w-6 h-6"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                  aria-hidden="true"
                                >
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <p class="font-medium text-lg">{{ q.question }}</p>
                              </div>

                              <div class="asker-info text-sm text-gray-600 mb-4">
                                {% if q.asker_name != blank %}
                                  <span>{% render 'alc-i18n', key: 'asked_by' %} {{ q.asker_name }}</span>
                                {% endif %}
                              </div>

                              <div class="bg-white rounded p-4 md:p-4 p-3 shadow-sm border border-gray-100">
                                <div class="answer-header flex items-center gap-2 mb-2">
                                  <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    aria-hidden="true"
                                  >
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                  </svg>
                                  <span class="font-medium">{% render 'alc-i18n', key: 'answer' %}:</span>
                                </div>

                                <div class="answer-content ml-7">
                                  <p>{{ q.answer }}</p>
                                  {% if q.responder_name != blank %}
                                    <p class="text-sm text-gray-600 mt-2">- {{ q.responder_name }}</p>
                                  {% endif %}
                                </div>
                              </div>
                            </div>
                          {% endfor %}
                        </div>

                      {% else %}

                        <p>{%- case request.locale.iso_code -%}{%- when 'ro' -%}Nu există încă întrebări pentru acest produs.{%- when 'bg' -%}Все още няма въпроси за този продукт.{%- when 'hu' -%}Ehhez a termékhez még nincsenek kérdések.{%- when 'pl' -%}Brak pytań dotyczących tego produktu.{%- when 'cs' -%}K tomuto produktu zatím nejsou žádné dotazy.{%- when 'sk' -%}K tomuto produktu zatiaľ nie sú žiadne otázky.{%- when 'el' -%}Δεν υπάρχουν ακόμη ερωτήσεις για αυτό το προϊόν.{%- when 'it' -%}Non ci sono ancora domande su questo prodotto.{%- when 'fr' -%}Aucune question pour ce produit pour le moment.{%- when 'hr' -%}Za ovaj proizvod još nema pitanja.{%- when 'de' -%}Zu diesem Produkt gibt es noch keine Fragen.{%- else -%}No questions about this product yet.{%- endcase -%}</p>
                      {% endif %}
                    </div>
                  </details>
                </div>
              {% else %}
                <div class="vitals-reviews-block">
                  {{ block | block_tag }}
                </div>
              {% endif %}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ALC Collapsible",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.collapsible_content.settings.caption.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.collapsible_content.settings.heading.label",
      "default": "t:sections.collapsible_content.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
