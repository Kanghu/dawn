{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alc-collapsible-preview.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient" style="font-family: var(--font-body-family);">
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.layout == 'section' %} page-width{% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}">
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}">
      <div class="page-width">
        <div
          class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          style="text-align: {{ section.settings.heading_alignment }};"
        >
          {%- if section.settings.caption != blank -%}
            <p class="caption-with-letter-spacing">
              {{ section.settings.caption | escape }}
            </p>
          {% endif %}
          {%- if section.settings.heading != blank -%}
            <h2 class="collapsible-content__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
          {%- else -%}
            <div class="visually-hidden alc-h2">{{ 'accessibility.collapsible_content_title' | t }}</div>
          {% endif %}
        </div>
        <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            </div>
          {% endif %}
          <div class="grid__item">
            {%- assign preview_block_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- comment -%} Track preview-eligible blocks for open state {%- endcomment -%}
              {%- if block.type == 'collapsible_row' or block.type == 'collapsible_metafields' -%}
                {%- assign preview_block_count = preview_block_count | plus: 1 -%}
                {%- assign should_open = false -%}
                {%- if preview_block_count <= 2 -%}
                  {%- assign should_open = true -%}
                {%- endif -%}
              {%- else -%}
                {%- assign should_open = false -%}
              {%- endif -%}

              {% if block.type == 'collapsible_row' %}
                <div
                  class="accordion{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <details
                    id="Details-{{ block.id }}-{{ section.id }}"
                    {% if should_open %}open{% endif %}
                  >
                    <summary id="Summary-{{ block.id }}-{{ section.id }}">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <h3 class="accordion__title inline-richtext h4">
                        {{ block.settings.heading | default: block.settings.page.title | escape }}{%- if product.title != blank %} {{ product.title | escape }}{% endif -%}
                      </h3>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <alc-collapsible-preview>
                      <div
                        class="accordion__content-preview is-collapsed"
                        id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                        role="region"
                        aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                      >
                        <div class="accordion__content rte">
                          {% if block.settings.row_liquid != blank %}
                            {{ block.settings.row_liquid }}
                          {% elsif block.settings.row_content != blank %}
                            {{ block.settings.row_content }}
                          {% endif %}
                          {{ block.settings.page.content }}
                        </div>
                        <div class="accordion__gradient-overlay" aria-hidden="true"></div>
                      </div>
                      <button
                        type="button"
                        class="accordion__see-more-btn"
                        aria-expanded="false"
                      >
                        <span class="see-more-label">{{ 'products.facets.show_more' | t }}</span>
                        <span class="see-less-label hidden">{{ 'products.facets.show_less' | t }}</span>
                      </button>
                    </alc-collapsible-preview>
                  </details>
                </div>
              {% elsif block.type == 'collapsible_metafields' %}
  <!-- New custom metafields block -->
  <div class="accordion" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section.id }}" {% if should_open %}open{% endif %}>
      <summary id="Summary-{{ block.id }}-{{ section.id }}">
        {% render 'icon-accordion', icon: block.settings.icon %}
        <h3 class="accordion__title inline-richtext h4">
          {{ block.settings.heading }}{%- if product.title != blank %} {{ product.title | escape }}{% endif -%}
        </h3>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <alc-collapsible-preview>
        <div
          class="accordion__content-preview is-collapsed"
          id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
          role="region"
          aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
        >
          <div class="accordion__content rte">
        {% if product.metafields.custom != blank %}
          <!-- Force grid layout despite utility-class conflict -->
          <div class="py-2 grid grid-cols-1 md:grid-cols-2 gap-4" style="display: grid;">
            {% assign collection_with_specs = nil %}
            {% for collection in product.collections %}
              {% if collection.metafields.custom.specification_groups != blank %}
                {% assign collection_with_specs = collection %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% if collection_with_specs %}
              {% for spec_group in collection_with_specs.metafields.custom.specification_groups.value %}
                {% assign spec_group_metaobj = spec_group | metaobject %}

              <div class="mb-16 w-100 md:w-50">
                  <div class="alc-h3 mt-4 font-semibold" style="color: #EF1188;">{{ spec_group_metaobj.name }}:</div>
                  {%- assign counter = 0 -%}
                  {%- for spec in spec_group_metaobj.specifications.value -%}
                      {%- if spec contains '.' -%}
                        {%- assign spec_parts = spec | split: '.' -%}
                        {%- assign spec_namespace = spec_parts[0] -%}
                        {%- assign spec_key = spec_parts[1] -%}
                        {%- assign mf = product.metafields[spec_namespace][spec_key] -%}
                      {%- else -%}
                        {%- assign mf = product.metafields.custom[spec] -%}
                      {%- endif -%}
                      <!-- DEBUG: spec={{ spec }} | namespace={{ spec_namespace }} | key={{ spec_key }} | mf={{ mf }} | mf.value={{ mf.value }} -->
                      {% if mf %}
                          {% assign is_even = counter | modulo: 2 %}

                          <div class="justify-between px-3 py-3 text-2xl flex flex-row transition-colors duration-200" {% if is_even == 0 %}style="background-color: rgba(3,186,214,0.3);"{% endif %}>
        <span class="spec-name w-2/3 font-normal">
          {%- comment -%} Translation lookup: use Shopify's definition name for native metafields, manual for custom {%- endcomment -%}
          {%- assign current_locale = request.locale.iso_code -%}
          {%- assign translated_spec = '' -%}

          {%- if spec contains '.' -%}
            {%- if mf.definition.name != blank -%}
              {%- assign translated_spec = mf.definition.name -%}
            {%- else -%}
              {%- comment -%} Fallback: format the key portion nicely {%- endcomment -%}
              {%- assign translated_spec = spec_key | replace: '-', ' ' | capitalize -%}
            {%- endif -%}
          {%- elsif current_locale == 'bg' -%}
            {%- case spec -%}
              {%- when 'tip_produs_' -%}{%- assign translated_spec = 'Тип продукт' -%}
              {%- when 'material_' -%}{%- assign translated_spec = 'Материал' -%}
              {%- when 'culoare' -%}{%- assign translated_spec = 'Цвят' -%}
              {%- when 'utilizare_' -%}{%- assign translated_spec = 'Употреба' -%}
              {%- when 'forma_' -%}{%- assign translated_spec = 'Форма' -%}
              {%- when 'nr_surse_iluminat_' -%}{%- assign translated_spec = 'Брой източници на светлина' -%}
              {%- when 'constructie_' -%}{%- assign translated_spec = 'Конструкция' -%}
              {%- when 'design_' -%}{%- assign translated_spec = 'Дизайн' -%}
              {%- when 'dimabil_' -%}{%- assign translated_spec = 'С димер' -%}
              {%- when 'tip_bec_' -%}{%- assign translated_spec = 'Тип крушка' -%}
              {%- when 'tip_soclu_' -%}{%- assign translated_spec = 'Тип цокъл' -%}
              {%- when 'recomandare_' -%}{%- assign translated_spec = 'Препоръка' -%}
              {%- when 'pozitionare_' -%}{%- assign translated_spec = 'Позициониране' -%}
              {%- when 'autonomie_' -%}{%- assign translated_spec = 'Автономия' -%}
              {%- when 'putere_w_' -%}{%- assign translated_spec = 'Мощност (W)' -%}
              {%- when 'tensiune_alimentare_' -%}{%- assign translated_spec = 'Захранващо напрежение' -%}
              {%- when 'tip_lumina_' -%}{%- assign translated_spec = 'Тип светлина' -%}
              {%- when 'kelvin_' -%}{%- assign translated_spec = 'Келвин' -%}
              {%- when 'flux_de_lumina_lm_' -%}{%- assign translated_spec = 'Светлинен поток (lm)' -%}
              {%- when 'clasa_de_protectie_' -%}{%- assign translated_spec = 'Клас на защита' -%}
              {%- when 'tip_intrerupator_' -%}{%- assign translated_spec = 'Тип превключвател' -%}
              {%- when 'tip_alimentare_' -%}{%- assign translated_spec = 'Тип захранване' -%}
              {%- when 'tip_comanda_' -%}{%- assign translated_spec = 'Тип управление' -%}
              {%- when 'numar_functii_' -%}{%- assign translated_spec = 'Брой функции' -%}
              {%- when 'nr_functii_' -%}{%- assign translated_spec = 'Брой функции' -%}
              {%- when 'continut_pachet_' -%}{%- assign translated_spec = 'Съдържание на пакета' -%}
              {%- when 'diametru_cartus_' -%}{%- assign translated_spec = 'Диаметър на патрона' -%}
              {%- when 'tip_rama_' -%}{%- assign translated_spec = 'Тип рамка' -%}
              {%- else -%}{%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
          {%- elsif current_locale == 'hu' -%}
            {%- case spec -%}
              {%- when 'tip_produs_' -%}{%- assign translated_spec = 'Termék típusa' -%}
              {%- when 'material_' -%}{%- assign translated_spec = 'Anyag' -%}
              {%- when 'culoare' -%}{%- assign translated_spec = 'Szín' -%}
              {%- when 'utilizare_' -%}{%- assign translated_spec = 'Használat' -%}
              {%- when 'forma_' -%}{%- assign translated_spec = 'Forma' -%}
              {%- when 'nr_surse_iluminat_' -%}{%- assign translated_spec = 'Fényforrások száma' -%}
              {%- when 'constructie_' -%}{%- assign translated_spec = 'Konstrukció' -%}
              {%- when 'design_' -%}{%- assign translated_spec = 'Dizájn' -%}
              {%- when 'dimabil_' -%}{%- assign translated_spec = 'Dimmerelhető' -%}
              {%- when 'tip_bec_' -%}{%- assign translated_spec = 'Izzó típusa' -%}
              {%- when 'tip_soclu_' -%}{%- assign translated_spec = 'Foglalat típusa' -%}
              {%- when 'recomandare_' -%}{%- assign translated_spec = 'Ajánlás' -%}
              {%- when 'pozitionare_' -%}{%- assign translated_spec = 'Elhelyezés' -%}
              {%- when 'autonomie_' -%}{%- assign translated_spec = 'Autonómia' -%}
              {%- when 'putere_w_' -%}{%- assign translated_spec = 'Teljesítmény (W)' -%}
              {%- when 'tensiune_alimentare_' -%}{%- assign translated_spec = 'Tápfeszültség' -%}
              {%- when 'tip_lumina_' -%}{%- assign translated_spec = 'Fény típusa' -%}
              {%- when 'kelvin_' -%}{%- assign translated_spec = 'Kelvin' -%}
              {%- when 'flux_de_lumina_lm_' -%}{%- assign translated_spec = 'Fényáram (lm)' -%}
              {%- when 'clasa_de_protectie_' -%}{%- assign translated_spec = 'Védelmi osztály' -%}
              {%- when 'tip_intrerupator_' -%}{%- assign translated_spec = 'Kapcsoló típusa' -%}
              {%- when 'tip_alimentare_' -%}{%- assign translated_spec = 'Táplálás típusa' -%}
              {%- when 'tip_comanda_' -%}{%- assign translated_spec = 'Vezérlés típusa' -%}
              {%- when 'numar_functii_' -%}{%- assign translated_spec = 'Funkciók száma' -%}
              {%- when 'nr_functii_' -%}{%- assign translated_spec = 'Funkciók száma' -%}
              {%- when 'continut_pachet_' -%}{%- assign translated_spec = 'Csomag tartalma' -%}
              {%- when 'diametru_cartus_' -%}{%- assign translated_spec = 'Patron átmérője' -%}
              {%- when 'tip_rama_' -%}{%- assign translated_spec = 'Keret típusa' -%}
              {%- else -%}{%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
          {%- elsif current_locale == 'pl' -%}
            {%- case spec -%}
              {%- when 'tip_produs_' -%}{%- assign translated_spec = 'Typ produktu' -%}
              {%- when 'material_' -%}{%- assign translated_spec = 'Materiał' -%}
              {%- when 'culoare' -%}{%- assign translated_spec = 'Kolor' -%}
              {%- when 'utilizare_' -%}{%- assign translated_spec = 'Wykorzystanie' -%}
              {%- when 'forma_' -%}{%- assign translated_spec = 'Kształt' -%}
              {%- when 'nr_surse_iluminat_' -%}{%- assign translated_spec = 'Liczba źródeł światła' -%}
              {%- when 'constructie_' -%}{%- assign translated_spec = 'Konstrukcja' -%}
              {%- when 'design_' -%}{%- assign translated_spec = 'Wzór' -%}
              {%- when 'dimabil_' -%}{%- assign translated_spec = 'Możliwość ściemniania' -%}
              {%- when 'tip_bec_' -%}{%- assign translated_spec = 'Typ żarówki' -%}
              {%- when 'tip_soclu_' -%}{%- assign translated_spec = 'Typ gwintu' -%}
              {%- when 'recomandare_' -%}{%- assign translated_spec = 'Zalecenie' -%}
              {%- when 'pozitionare_' -%}{%- assign translated_spec = 'Pozycjonowanie' -%}
              {%- when 'autonomie_' -%}{%- assign translated_spec = 'Autonomia' -%}
              {%- when 'putere_w_' -%}{%- assign translated_spec = 'Moc (W)' -%}
              {%- when 'tensiune_alimentare_' -%}{%- assign translated_spec = 'Napięcie zasilania' -%}
              {%- when 'tip_lumina_' -%}{%- assign translated_spec = 'Typ światła' -%}
              {%- when 'kelvin_' -%}{%- assign translated_spec = 'Kelvin' -%}
              {%- when 'flux_de_lumina_lm_' -%}{%- assign translated_spec = 'Strumień świetlny (lm)' -%}
              {%- when 'clasa_de_protectie_' -%}{%- assign translated_spec = 'Klasa ochrony' -%}
              {%- when 'tip_intrerupator_' -%}{%- assign translated_spec = 'Typ przełącznika' -%}
              {%- when 'tip_alimentare_' -%}{%- assign translated_spec = 'Typ zasilania' -%}
              {%- when 'tip_comanda_' -%}{%- assign translated_spec = 'Typ sterowania' -%}
              {%- when 'numar_functii_' -%}{%- assign translated_spec = 'Liczba funkcji' -%}
              {%- when 'nr_functii_' -%}{%- assign translated_spec = 'Liczba funkcji' -%}
              {%- when 'continut_pachet_' -%}{%- assign translated_spec = 'Zawartość pakietu' -%}
              {%- when 'diametru_cartus_' -%}{%- assign translated_spec = 'Średnica wkładu' -%}
              {%- when 'tip_rama_' -%}{%- assign translated_spec = 'Typ ramy' -%}
              {%- else -%}{%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
          {%- elsif current_locale == 'sk' -%}
            {%- case spec -%}
              {%- when 'tip_produs_' -%}{%- assign translated_spec = 'Typ produktu' -%}
              {%- when 'material_' -%}{%- assign translated_spec = 'Materiál' -%}
              {%- when 'culoare' -%}{%- assign translated_spec = 'Farba' -%}
              {%- when 'utilizare_' -%}{%- assign translated_spec = 'Použitie' -%}
              {%- when 'forma_' -%}{%- assign translated_spec = 'Tvar' -%}
              {%- when 'nr_surse_iluminat_' -%}{%- assign translated_spec = 'Počet svetelných zdrojov' -%}
              {%- when 'constructie_' -%}{%- assign translated_spec = 'Konštrukcia' -%}
              {%- when 'design_' -%}{%- assign translated_spec = 'Dizajn' -%}
              {%- when 'dimabil_' -%}{%- assign translated_spec = 'Stmievateľné' -%}
              {%- when 'tip_bec_' -%}{%- assign translated_spec = 'Typ žiarovky' -%}
              {%- when 'tip_soclu_' -%}{%- assign translated_spec = 'Typ pätice' -%}
              {%- when 'recomandare_' -%}{%- assign translated_spec = 'Odporúčanie' -%}
              {%- when 'pozitionare_' -%}{%- assign translated_spec = 'Umiestnenie' -%}
              {%- when 'autonomie_' -%}{%- assign translated_spec = 'Autonómia' -%}
              {%- when 'putere_w_' -%}{%- assign translated_spec = 'Výkon (W)' -%}
              {%- when 'tensiune_alimentare_' -%}{%- assign translated_spec = 'Napájacie napätie' -%}
              {%- when 'tip_lumina_' -%}{%- assign translated_spec = 'Typ svetla' -%}
              {%- when 'kelvin_' -%}{%- assign translated_spec = 'Kelvin' -%}
              {%- when 'flux_de_lumina_lm_' -%}{%- assign translated_spec = 'Svetelný tok (lm)' -%}
              {%- when 'clasa_de_protectie_' -%}{%- assign translated_spec = 'Trieda ochrany' -%}
              {%- when 'tip_intrerupator_' -%}{%- assign translated_spec = 'Typ spínača' -%}
              {%- when 'tip_alimentare_' -%}{%- assign translated_spec = 'Typ napájania' -%}
              {%- when 'tip_comanda_' -%}{%- assign translated_spec = 'Typ ovládania' -%}
              {%- when 'numar_functii_' -%}{%- assign translated_spec = 'Počet funkcií' -%}
              {%- when 'nr_functii_' -%}{%- assign translated_spec = 'Počet funkcií' -%}
              {%- when 'continut_pachet_' -%}{%- assign translated_spec = 'Obsah balenia' -%}
              {%- when 'diametru_cartus_' -%}{%- assign translated_spec = 'Priemer patrony' -%}
              {%- when 'tip_rama_' -%}{%- assign translated_spec = 'Typ rámu' -%}
              {%- else -%}{%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
          {%- elsif current_locale == 'hr' -%}
            {%- case spec -%}
              {%- when 'tip_produs_' -%}{%- assign translated_spec = 'Tip produkta' -%}
              {%- when 'material_' -%}{%- assign translated_spec = 'Materijal' -%}
              {%- when 'culoare' -%}{%- assign translated_spec = 'Boja' -%}
              {%- when 'utilizare_' -%}{%- assign translated_spec = 'Upotreba' -%}
              {%- when 'forma_' -%}{%- assign translated_spec = 'Oblik' -%}
              {%- when 'nr_surse_iluminat_' -%}{%- assign translated_spec = 'Broj izvora svjetlosti' -%}
              {%- when 'constructie_' -%}{%- assign translated_spec = 'Konstrukcija' -%}
              {%- when 'design_' -%}{%- assign translated_spec = 'Dizajn' -%}
              {%- when 'dimabil_' -%}{%- assign translated_spec = 'Zatamnjivo' -%}
              {%- when 'tip_bec_' -%}{%- assign translated_spec = 'Tip žarulje' -%}
              {%- when 'tip_soclu_' -%}{%- assign translated_spec = 'Tip grla' -%}
              {%- when 'recomandare_' -%}{%- assign translated_spec = 'Preporuka' -%}
              {%- when 'pozitionare_' -%}{%- assign translated_spec = 'Pozicioniranje' -%}
              {%- when 'autonomie_' -%}{%- assign translated_spec = 'Autonomija' -%}
              {%- when 'putere_w_' -%}{%- assign translated_spec = 'Snaga (W)' -%}
              {%- when 'tensiune_alimentare_' -%}{%- assign translated_spec = 'Napon napajanja' -%}
              {%- when 'tip_lumina_' -%}{%- assign translated_spec = 'Tip svjetlosti' -%}
              {%- when 'kelvin_' -%}{%- assign translated_spec = 'Kelvin' -%}
              {%- when 'flux_de_lumina_lm_' -%}{%- assign translated_spec = 'Svjetlosni tok (lm)' -%}
              {%- when 'clasa_de_protectie_' -%}{%- assign translated_spec = 'Klasa zaštite' -%}
              {%- when 'tip_intrerupator_' -%}{%- assign translated_spec = 'Tip prekidača' -%}
              {%- when 'tip_alimentare_' -%}{%- assign translated_spec = 'Tip napajanja' -%}
              {%- when 'tip_comanda_' -%}{%- assign translated_spec = 'Tip upravljanja' -%}
              {%- when 'numar_functii_' -%}{%- assign translated_spec = 'Broj funkcija' -%}
              {%- when 'nr_functii_' -%}{%- assign translated_spec = 'Broj funkcija' -%}
              {%- when 'continut_pachet_' -%}{%- assign translated_spec = 'Sadržaj paketa' -%}
              {%- when 'diametru_cartus_' -%}{%- assign translated_spec = 'Promjer uloška' -%}
              {%- when 'tip_rama_' -%}{%- assign translated_spec = 'Tip okvira' -%}
              {%- else -%}{%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endcase -%}
          {%- else -%}
            {%- comment -%} Fallback to Shopify translation system {%- endcomment -%}
            {%- assign spec_key = 'products.metaobjects.specification_groups.' | append: spec -%}
            {%- assign translated_spec = spec_key | t -%}
            {%- if translated_spec contains 'translation missing' -%}
              {%- assign translated_spec = spec | replace: '_', ' ' | capitalize -%}
            {%- endif -%}
          {%- endif -%}
          
          {{ translated_spec }}:
        </span>

                <span class="spec-value w-1/3 font-medium">
                  {% if mf.type == 'list.metaobject_reference' %}
                    {%- if spec contains '.' -%}
                      {%- comment -%} Shopify standard metaobject references - use label field {%- endcomment -%}
                      {%- for metaobj_ref in mf.value -%}
                        {%- assign metaobj = metaobj_ref | metaobject -%}
                        {{ metaobj.label | default: metaobj.system.display_name }}
                        {%- unless forloop.last -%}, {% endunless -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- comment -%} Custom metaobject references - use existing logic {%- endcomment -%}
                      {% assign spec_length = spec | size %}
                      {% assign key_length = spec_length | minus: 1 %}
                      {% assign key = spec | slice: 0, key_length %}

                      {%- if spec == 'tip_produs_' -%}
                        {% assign key = 'lustra_led' %}
                      {%- endif -%}

                      {% assign parsed = mf.value | parse_json %}
                      {%- for entry in parsed -%}
                        {{ entry[key]
                        | join: ', '
                        | replace: '[', ''
                        | replace: ']', ''
                        | replace: '"', ''
                        }}
                        {%- unless forloop.last -%}, {% endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {% else %}
                    {{ mf.value | join: ', ' | replace: '[', '' | replace: ']', '' | replace: '"', '' }}
                  {% endif %}
                </span>
              </div>

                          {%- assign counter = counter | plus: 1 -%}
                      {% endif %}
                  {%- endfor -%}
              </div>
              {% endfor %}
            {% else %}
              <p>No collection metafields available.</p>
            {% endif %}
          </div>
        {% else %}
          <p>No custom metafields available for this product.</p>
        {% endif %}
          </div>
          <div class="accordion__gradient-overlay" aria-hidden="true"></div>
        </div>
        <button
          type="button"
          class="accordion__see-more-btn"
          aria-expanded="false"
        >
          <span class="see-more-label">{{ 'products.facets.show_more' | t }}</span>
          <span class="see-less-label hidden">{{ 'products.facets.show_less' | t }}</span>
        </button>
      </alc-collapsible-preview>
    </details>
  </div>
              {% elsif block.type == 'collapsible_qa' %}
                <!-- Questions and Answers block -->
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary id="Summary-{{ block.id }}-{{ section.id }}">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <span class="accordion__title inline-richtext h4">
                        {{ block.settings.heading }}
                      </span>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div
                      class="accordion__content rte"
                      id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                      role="region"
                      aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                    >
                      {% if product.metafields.custom.questions != blank %}
                        <div class="space-y-6">
                          {% for q in product.metafields.custom.questions.value %}
                            <div class="bg-gray-50 rounded-lg p-6 md:p-6 p-4 border border-gray-200 hover:border-gray-300 transition-colors duration-200">
                              <div class="question-header flex items-center gap-2 mb-3">
                                <svg
                                  class="w-6 h-6"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                  style="color: #f01188;"
                                >
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <p class="font-medium text-lg">{{ q.question }}</p>
                              </div>

                              <div class="asker-info text-sm text-gray-600 mb-4">
                                {% if q.asker_name != blank %}
                                  <span>Asked by {{ q.asker_name }}</span>
                                {% endif %}
                              </div>

                              <div class="bg-white rounded p-4 md:p-4 p-3 shadow-sm border border-gray-100">
                                <div class="answer-header flex items-center gap-2 mb-2">
                                  <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    style="color: #03bad6;"
                                  >
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                  </svg>
                                  <span class="font-medium">Answer:</span>
                                </div>

                                <div class="answer-content ml-7">
                                  <p>{{ q.answer }}</p>
                                  {% if q.responder_name != blank %}
                                    <p class="text-sm text-gray-600 mt-2">- {{ q.responder_name }}</p>
                                  {% endif %}
                                </div>
                              </div>
                            </div>
                          {% endfor %}
                        </div>

                      {% else %}

                        <p>No questions available for this product.</p>
                      {% endif %}
                    </div>
                  </details>
                </div>
              {% else %}
                <div class="vitals-reviews-block">
                  {{ block | block_tag }}
                </div>
              {% endif %}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

