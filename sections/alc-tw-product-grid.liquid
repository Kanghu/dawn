{% comment %}
  Tailwind styled product collection grid for campaign landing pages.
  Maintains functionality of main-collection-product-grid while using Tailwind styling.
  - Uses page-width class for margins
  - Displays featured categories from metafield 'slider subcollections'
  - Groups products by subcollections
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<div class="bg-gray-50">
  <div>
    <main>
      <!-- Banner + Categories Section with unified design -->
      <div class="pt-8 pb-16 bg-white">
        <div class="page-width">
          <!-- Banner Image with max-width 1300px -->
          <div class="w-full flex justify-center mb-8">
            <img
              src="{{ collection.image | image_url: width: 1300 }}"
              alt="{{ collection.title | escape }}"
              class="w-full max-w-[1300px] h-auto object-cover rounded-lg shadow-md object-center">
          </div>

          <!-- Content area for campaign description -->
          <div class="max-w-4xl mx-auto mb-12 text-center">
            <div class="prose prose-lg mx-auto">
              {% if collection.description != blank %}
                {{ collection.description }}
              {% else %}
                <p class="text-gray-600">
                  {{ collection.metafields.custom.description }}
                </p>
              {% endif %}
            </div>
        </div>

          <!-- Featured Categories from metafield - larger text with more top spacing -->
          {% assign subcollections = collection.metafields.custom.slider_subcollections.value %}
          {% if subcollections != blank %}
            <div class="flex justify-center">
              <!-- Changed to 6 columns on desktop, kept 2 on mobile, ensured equal sizing -->
              <div class="grid gap-6 justify-center" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); max-width: 900px;">
                {%- for subcollection in subcollections -%}
                  <a href="#section-{{ subcollection.handle }}" class="group flex flex-col items-center">
                    <div class="aspect-square flex overflow-hidden rounded-lg bg-gray-100 relative shadow-md border-2 border-transparent transition-all duration-300 dynamic-hover-border">
                      {%- if subcollection.featured_image != blank -%}
                        <img
                          src="{{ subcollection.featured_image | image_url: width: 200 }}"
                          srcset="{{ subcollection.featured_image | image_url: width: 150 }} 150w,
                                  {{ subcollection.featured_image | image_url: width: 200 }} 300w"
                          sizes="(max-width:640px) 50vw, (max-width:1024px) 33vw, 16vw"
                          alt="{{ subcollection.title | escape }}"
                          class="aspect-square max-w-1/2 object-cover object-center group-hover:opacity-90 transition-opacity"
                          loading="lazy">
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'object-cover object-center group-hover:opacity-75' }}
                      {%- endif -%}
                      <h3 class="absolute bottom-4 left-0 right-0 text-white p-2 text-center text-2xl truncate" style="background: linear-gradient(90deg, {{ collection.metafields.custom.main_color }}E6 50%, #fff 100%);">
                        {{ subcollection.title }}
                      </h3>
                    </div>
                  </a>
                {%- endfor -%}
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      {% for subcollection in subcollections %}
        {% if subcollection.products_count > 0 %}

          {% assign shown = 0 %}
          {% assign section_index = forloop.index | modulo: 4 %}
          {% case section_index %}
            {% when 1 %}
              {% assign section_shade = "100" %}
            {% when 2 %}
              {% assign section_shade = "200" %}
            {% when 3 %}
              {% assign section_shade = "50" %}
            {% when 0 %}
              {% assign section_shade = "300" %}
          {% endcase %}

          <div class="my-12" id="section-{{ subcollection.handle }}">
            <div class="page-width pt-4 pb-8 bg-white border-l-4 border-[#06BBD6] rounded-lg shadow-sm" style="border-left-color: {{ collection.metafields.custom.border_color }};">

              <!-- Subcollection Title Block -->
              <div class="mx-[-1.5rem]" style="background: linear-gradient(90deg, {{ collection.metafields.custom.main_color }}4D 0%, #fff 100%);">
                <h2 class="text-4xl tracking-wider font-semibold text-gray-900 mb-6 mt-2 px-6 py-4">
                  {{ subcollection.title }}
                </h2>
              </div>

              <!-- Subcollection Description -->
              <div class="px-6 mb-8">
                {% if subcollection.description != blank %}
                  <div class="rte text-gray-700">{{ subcollection.description }}</div>
                {% else %}
                  <p class="text-gray-600">Descoperă o selecție de produse premium din categoria {{ subcollection.title }}. Calitate garantată și prețuri avantajoase.</p>
                {% endif %}
              </div>

              <!-- Product Grid -->
              <ul class="grid product-grid grid--2-col-tablet-down grid--5-col-desktop gap-x-6 px-4">
                {% assign skip_card_product_styles = false %}
                {% for product in collection.products %}
                  {% if product.collections contains subcollection %}
                    {% assign lazy_load = false %}
                    {% if shown > 2 %}
                      {% assign lazy_load = true %}
                    {% endif %}

                    <li class="grid__item">
                      {% render 'alc-card-product'
                        , card_product: product
                        , media_aspect_ratio: section.settings.image_ratio
                        , image_shape: section.settings.image_shape
                        , show_secondary_image: section.settings.show_secondary_image
                        , show_vendor: section.settings.show_vendor
                        , show_rating: false
                        , lazy_load: lazy_load
                        , skip_styles: skip_card_product_styles
                        , section_id: section.id
                        , quick_add: 'standard'
                        , button_color: '#03bad6'
                      %}
                    </li>
                    {% assign skip_card_product_styles = true %}
                  {% endif %}
                {% endfor %}
              </ul>

              <!-- "See All Products" Button -->
              <div class="flex justify-center">
                <a
                  href="{{ subcollection.url }}"
                  class="inline-flex items-center px-6 py-3 my-6 border border-transparent text-xl font-medium rounded-md shadow-sm text-white bg-[#06BBD6] hover:bg-[#059caf] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#06BBD6] no-underline"
                  style="background-color: {{ collection.metafields.custom.main_color }};">
                  <span>Vezi toate produsele</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 ml-2"
                    viewBox="0 0 20 20"
                    fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                      clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}


    </main>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add any JavaScript needed for the campaign landing page here
  });
</script>

<style>
  .dynamic-hover-border:hover {
    border-color: {{ collection.metafields.custom.border_color }};
  }
</style>

{% schema %}
  {
    "name": "t:sections.main-collection-product-grid.name",
    "class": "section",
    "settings": [
      {
        "type": "range",
        "id": "products_per_page",
        "min": 8,
        "max": 48,
        "step": 4,
        "default": 16,
        "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
          },
          {
            "value": "portrait",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
          },
          {
            "value": "square",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
          }
        ],
        "default": "adapt",
        "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
      },
      {
        "type": "select",
        "id": "image_shape",
        "options": [
          {
            "value": "default",
            "label": "t:sections.all.image_shape.options__1.label"
          },
          {
            "value": "arch",
            "label": "t:sections.all.image_shape.options__2.label"
          },
          {
            "value": "blob",
            "label": "t:sections.all.image_shape.options__3.label"
          },
          {
            "value": "chevron",
            "label": "t:sections.all.image_shape.options__4.label"
          },
          {
            "value": "diamond",
            "label": "t:sections.all.image_shape.options__5.label"
          },
          {
            "value": "hexagon",
            "label": "t:sections.all.image_shape.options__6.label"
          },
          {
            "value": "rounded",
            "label": "t:sections.all.image_shape.options__7.label"
          }
        ],
        "default": "default",
        "label": "t:sections.all.image_shape.label",
        "info": "t:sections.all.image_shape.info"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_rating.label"
      },
      {
        "type": "checkbox",
        "id": "quick_add",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.quick_add.label"
      }
    ]
  }
{% endschema %}