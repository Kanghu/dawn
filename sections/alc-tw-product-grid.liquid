{% comment %}
  Tailwind styled product collection grid for campaign landing pages.
  Maintains functionality of main-collection-product-grid while using Tailwind styling.
  - Uses page-width class for margins
  - Displays featured categories from metafield 'slider subcollections'
  - Groups products by subcollections
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<div class="bg-gray-50">
  <div>
    <main>
      <!-- Banner + Categories Section with unified design -->
      <div class="bg-gradient-to-b from-[#06BBD6]/50 via-[#06BBD6]/25 to-gray-50 pt-8 pb-16">
        <div class="page-width">
          <!-- Banner Image with max-width 1300px -->
          <div class="w-full flex justify-center mb-8">
            <img src="https://cdn.shopify.com/s/files/1/0782/5175/3739/files/banner_vanatoare_reduceri_wide.webp?v=1746203495" 
                alt="{{ collection.title | escape }}" 
                class="w-full max-w-[1300px] h-auto object-cover rounded-lg shadow-md">
          </div>
          
          <!-- Content area for campaign description -->
          <div class="max-w-4xl mx-auto mb-12 text-center">
            <div class="prose prose-lg mx-auto">
              {% if collection.description != blank %}
                {{ collection.description }}
              {% else %}
                <p class="text-gray-600">Descoperă cea mai bună selecție de produse pentru vânătoare la prețuri reduse. Oferte exclusive pentru echipamente și accesorii de înaltă calitate. Reduceri disponibile pentru o perioadă limitată.</p>
              {% endif %}
            </div>
          </div>
          
          <!-- Featured Categories from metafield - larger text with more top spacing -->
          {% assign subcollections = collection.metafields.custom.slider_subcollections.value %}
          {% if subcollections != blank %}
            <div>
              <!-- Changed to 6 columns on desktop, kept 2 on mobile, ensured equal sizing -->
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 justify-center">
                {%- for subcollection in subcollections -%}
                  <a href="#section-{{ subcollection.handle }}" class="group flex flex-col items-center">
                    <div class="aspect-square w-full overflow-hidden rounded-lg bg-gray-100 relative shadow-md border-2 border-transparent hover:border-[#06BBD6] transition-all duration-300">
                      {%- if subcollection.featured_image != blank -%}
                        <img 
                          src="{{ subcollection.featured_image | img_url: '200x200', crop: 'center' }}" 
                          alt="{{ subcollection.title | escape }}"
                          class="h-full w-full object-cover object-center group-hover:opacity-90 transition-opacity"
                          loading="lazy"
                          width="200"
                          height="200"
                        >
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'h-full w-full object-cover object-center group-hover:opacity-75' }}
                      {%- endif -%}
                      <h3 class="absolute bottom-4 left-0 right-0 bg-[#06BBD6]/80 text-white p-2 text-center text-2xl truncate">{{ subcollection.title }}</h3>
                    </div> 
                  </a>
                {%- endfor -%}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Products grouped by subcollections -->
      {% for subcollection in subcollections %}
        {% assign real_sub = collections[subcollection.handle] %}
        {% assign subcollection_products = '' | split: '' %}
        {% assign match_count = 0 %}
        {% for prod in collection.products %}
          {% if prod.collections contains real_sub %}
            {% assign match_count = match_count | plus: 1 %}
            {% assign prod_handle = prod.handle | split: '|' %}
            {% assign subcollection_products = subcollection_products | concat: prod_handle %}
          {% endif %}
        {% endfor %}


        {% if subcollection_products.size > 0 %}
          {% assign section_index = forloop.index | modulo: 4 %}
          {% case section_index %}
            {% when 1 %}
              {% assign section_shade = "100" %}
            {% when 2 %}
              {% assign section_shade = "200" %}
            {% when 3 %}
              {% assign section_shade = "50" %}
            {% when 0 %}
              {% assign section_shade = "300" %}
          {% endcase %}
          
          <div class="my-12" id="section-{{ subcollection.handle }}">
            <div class="page-width pt-4 pb-8 bg-white border-l-4 border-[#06BBD6] rounded-lg shadow-sm">
              <!-- Larger, more prominent heading with full-width background -->
              <div class="mx-[-1.5rem] bg-gradient-to-r from-[#06BBD6]/30 to-white">
                <h2 class="text-4xl tracking-wider font-semibold text-gray-900 mb-6 mt-2 px-6 py-4">
                  {{ subcollection.title }}
                </h2>
              </div>
              
              <!-- Content area below heading -->
              <div class="px-6 mb-8">
                {% if subcollection.description != blank %}
                  <div class="rte text-gray-700">{{ subcollection.description }}</div>
                {% else %}
                  <p class="text-gray-600">Descoperă o selecție de produse premium din categoria {{ subcollection.title }}. Calitate garantată și prețuri avantajoase.</p>
                {% endif %}
              </div>
              
              <!-- Using Dawn theme's product grid structure -->
               {{ subcollection_products | json }}
              <ul class="grid product-grid grid--2-col-tablet-down grid--5-col-desktop gap-x-6 px-4">
                {% assign skip_card_product_styles = false %}
                {%- for handle in subcollection_products limit: 8 -%}
                  {% assign product = all_products[handle] %}
                  {{ handle | json }}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li class="grid__item">
                    {% render 'alc-lp-product-card',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: false,
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles,
                      quick_add: section.settings.quick_add,
                      section_id: section.id
                    %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>

              <!-- Show More button with theme color -->
                <div class="flex justify-center">
                  <a href="{{ subcollection.url }}" class="inline-flex items-center px-6 py-3 my-6 border border-transparent text-xl font-medium rounded-md shadow-sm text-white bg-[#06BBD6] hover:bg-[#059caf] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#06BBD6] no-underline">
                    <span>Vezi toate produsele</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </main>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add any JavaScript needed for the campaign landing page here
  });
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevron",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "hexagon",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.all.image_shape.options__7.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "info": "t:sections.all.image_shape.info"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label"
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label"
    }
  ]
}
{% endschema %} 