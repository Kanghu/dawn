{% comment %}
  Tailwind styled product collection grid for campaign landing pages.
  Maintains functionality of main-collection-product-grid while using Tailwind styling.
  - Uses page-width class for margins
  - Displays featured categories from metafield 'slider subcollections'
  - Groups products by subcollections
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<div style="background-color: {{ section.settings.grid_bg_color | default: '#ffffff' }};">
  <div>
    <main>
      {% assign subcollections = collection.metafields.custom.slider_subcollections.value %}
      {%- comment -%} Collects the handles of every product rendered below, for the ItemList schema {%- endcomment -%}
      {% assign itemlist_handles = '' %}
      {% assign itemlist_names = '' %}

      {% for subcollection in subcollections %}
        {% if subcollection.products_count > 0 %}

          {% assign shown = 0 %}
          {% assign section_index = forloop.index | modulo: 4 %}
          {% case section_index %}
            {% when 1 %}
              {% assign section_shade = "100" %}
            {% when 2 %}
              {% assign section_shade = "200" %}
            {% when 3 %}
              {% assign section_shade = "50" %}
            {% when 0 %}
              {% assign section_shade = "300" %}
          {% endcase %}

          <div id="section-{{ subcollection.handle }}">
            <!-- Subcollection Title Block -->
            <div class="page-width-desktop-only">
              {%- liquid
                assign main_color = section.settings.header_button_color | default: collection.metafields.custom.main_color | default: '#06BBD6'
                assign bg_style = ''
                assign opacity_hex = ''

                case section.settings.header_bg_opacity
                  when 10
                    assign opacity_hex = '1A'
                  when 20
                    assign opacity_hex = '33'
                  when 30
                    assign opacity_hex = '4D'
                  when 40
                    assign opacity_hex = '66'
                  when 50
                    assign opacity_hex = '80'
                  when 60
                    assign opacity_hex = '99'
                  when 70
                    assign opacity_hex = 'B3'
                  when 80
                    assign opacity_hex = 'CC'
                  when 90
                    assign opacity_hex = 'E6'
                  when 100
                    assign opacity_hex = 'FF'
                endcase

                case section.settings.header_background_style
                  when 'solid'
                    assign bg_style = 'background-color: ' | append: main_color | append: opacity_hex | append: ';'
                  when 'gradient_subtle'
                    assign bg_style = 'background: linear-gradient(90deg, ' | append: main_color | append: opacity_hex | append: ' 0%, #fff 100%);'
                  when 'gradient_prominent'
                    assign opacity_hex_end = '66'
                    if section.settings.header_bg_opacity <= 40
                      assign opacity_hex_end = '33'
                    endif
                    assign bg_style = 'background: linear-gradient(90deg, ' | append: main_color | append: opacity_hex | append: ' 0%, ' | append: main_color | append: opacity_hex_end | append: ' 100%);'
                endcase
              -%}
              <div class="flex justify-between items-center px-6 py-6 border-b-4" style="{{ bg_style }} border-bottom-color: {{ main_color }};">
                <h2 class="text-4xl tracking-wider font-bold" style="color: {{ section.settings.header_text_color | default: '#1f2937' }};">
                  {{ subcollection.title }}
                </h2>
                <a
                  href="{{ subcollection.url }}"
                  class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-[#1B1D1C] hover:bg-[#059caf] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#06BBD6] no-underline whitespace-nowrap"
                  style="background-color: {{ main_color }};">
                  <span>{{ section.settings.see_all_button_text | default: 'Vezi toate produsele' }}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 ml-2"
                    viewBox="0 0 20 20"
                    fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                      clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Product Grid -->
            <div class="page-width pt-4 pb-8">
              <ul class="grid product-grid grid--2-col-tablet-down grid--5-col-desktop gap-x-6">
                {% assign skip_card_product_styles = false %}
                {% for product in collection.products %}
                  {% if product.collections contains subcollection %}
                    {%- comment -%} Check if we should skip out-of-stock products {%- endcomment -%}
                    {% assign should_show = true %}
                    {% if section.settings.hide_out_of_stock and product.available == false %}
                      {% assign should_show = false %}
                    {% endif %}

                    {% if should_show %}
                      {% assign lazy_load = false %}
                      {% if shown > 2 %}
                        {% assign lazy_load = true %}
                      {% endif %}

                      <li class="grid__item">
                        {% render 'alc-card-product'
                          , card_product: product
                          , media_aspect_ratio: section.settings.image_ratio
                          , image_shape: section.settings.image_shape
                          , show_secondary_image: section.settings.show_secondary_image
                          , show_vendor: section.settings.show_vendor
                          , show_rating: false
                          , lazy_load: lazy_load
                          , skip_styles: skip_card_product_styles
                          , section_id: section.id
                          , quick_add: 'standard'
                        %}
                      </li>
                      {% assign skip_card_product_styles = true %}
                      {% assign itemlist_handles = itemlist_handles | append: product.handle | append: ',' %}
                      {% assign itemlist_names = itemlist_names | append: product.title | append: '|||' %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </ul>

              <!-- "See All Products" Button -->
              <div class="flex justify-center">
                {%- liquid
                  assign main_color = section.settings.header_button_color | default: collection.metafields.custom.main_color | default: '#06BBD6'
                -%}
                <a
                  href="{{ subcollection.url }}"
                  class="inline-flex items-center px-6 py-3 my-6 border border-transparent text-xl font-medium rounded-md shadow-sm text-white bg-[#1B1D1C] hover:bg-[#059caf] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#06BBD6] no-underline"
                  style="background-color: {{ main_color }};">
                  <span>Vezi toate produsele</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 ml-2"
                    viewBox="0 0 20 20"
                    fill="currentColor">
                    <path
                      fill-rule="evenodd"
                      d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                      clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} ItemList (carousel) structured data for the products shown above {%- endcomment -%}
      {%- assign itemlist_handle_array = itemlist_handles | split: ',' -%}
      {%- assign itemlist_name_array = itemlist_names | split: '|||' -%}
      {% render 'alc-collection-itemlist-schema'
        , handles: itemlist_handle_array
        , names: itemlist_name_array
        , list_name: collection.title
      %}

    </main>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add any JavaScript needed for the campaign landing page here
  });
</script>

<style>
  .dynamic-hover-border:hover {
    border-color: {{ collection.metafields.custom.border_color }};
  }

  /* Apply page-width only on desktop */
  .page-width-desktop-only {
    width: 100%;
    padding: 0;
  }

  @media screen and (min-width: 990px) {
    .page-width-desktop-only {
      max-width: var(--page-width);
      margin: 0 auto;
    }
  }
</style>

{% schema %}
  {
    "name": "t:sections.main-collection-product-grid.name",
    "class": "section",
    "settings": [
      {
        "type": "range",
        "id": "products_per_page",
        "min": 8,
        "max": 48,
        "step": 4,
        "default": 16,
        "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
          },
          {
            "value": "portrait",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
          },
          {
            "value": "square",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
          }
        ],
        "default": "adapt",
        "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
      },
      {
        "type": "select",
        "id": "image_shape",
        "options": [
          {
            "value": "default",
            "label": "t:sections.all.image_shape.options__1.label"
          },
          {
            "value": "arch",
            "label": "t:sections.all.image_shape.options__2.label"
          },
          {
            "value": "blob",
            "label": "t:sections.all.image_shape.options__3.label"
          },
          {
            "value": "chevron",
            "label": "t:sections.all.image_shape.options__4.label"
          },
          {
            "value": "diamond",
            "label": "t:sections.all.image_shape.options__5.label"
          },
          {
            "value": "hexagon",
            "label": "t:sections.all.image_shape.options__6.label"
          },
          {
            "value": "rounded",
            "label": "t:sections.all.image_shape.options__7.label"
          }
        ],
        "default": "default",
        "label": "t:sections.all.image_shape.label",
        "info": "t:sections.all.image_shape.info"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.show_rating.label"
      },
      {
        "type": "checkbox",
        "id": "quick_add",
        "default": false,
        "label": "t:sections.main-collection-product-grid.settings.quick_add.label"
      },
      {
        "type": "checkbox",
        "id": "hide_out_of_stock",
        "default": false,
        "label": "Hide out of stock products",
        "info": "When enabled, products that are out of stock will not be displayed in the grid"
      },
      {
        "type": "header",
        "content": "Subcollection Header Styling"
      },
      {
        "type": "color",
        "id": "header_button_color",
        "label": "Header & Button Color",
        "default": "#06BBD6",
        "info": "Color used for header backgrounds, borders, and buttons. Falls back to collection metafield if not set."
      },
      {
        "type": "color",
        "id": "header_text_color",
        "label": "Header Text Color",
        "default": "#1f2937",
        "info": "Color used for subcollection title text"
      },
      {
        "type": "select",
        "id": "header_background_style",
        "label": "Header Background Style",
        "options": [
          {
            "value": "none",
            "label": "None (White)"
          },
          {
            "value": "solid",
            "label": "Solid Color"
          },
          {
            "value": "gradient_subtle",
            "label": "Subtle Gradient"
          },
          {
            "value": "gradient_prominent",
            "label": "Prominent Gradient"
          }
        ],
        "default": "none",
        "info": "Choose background style for subcollection headers"
      },
      {
        "type": "range",
        "id": "header_bg_opacity",
        "min": 10,
        "max": 100,
        "step": 10,
        "unit": "%",
        "label": "Background Color Opacity",
        "default": 30,
        "info": "Controls the intensity of the background color (only applies when style is not 'None')"
      },
      {
        "type": "header",
        "content": "Subcollection Buttons"
      },
      {
        "type": "text",
        "id": "see_all_button_text",
        "label": "See All Button Text",
        "default": "Vezi toate produsele",
        "info": "Text displayed on the button at the top right of each subcollection"
      },
      {
        "type": "header",
        "content": "Grid Styling"
      },
      {
        "type": "color",
        "id": "grid_bg_color",
        "label": "Grid Background Color",
        "default": "#ffffff",
        "info": "Background color for the entire product grid area"
      }
    ]
  }
{% endschema %}