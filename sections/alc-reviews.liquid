{% comment %}
  Homepage customer reviews: rating summary + a slider of hand-picked reviews.

  Reviews are blocks (author, text, rating, date, verified, product, locales), so they
  are curated in the theme editor. The block texts are real Vitals reviews copied
  verbatim; do not edit what customers wrote. Each block lists the storefront locales
  it is shown on (e.g. "ro" or "hu,en"). A market shows its own-language reviews first,
  then the ones tagged "en"; a block with no locales shows everywhere.

  Labels (eyebrow, heading, verified, link) have built-in translations for every
  storefront language; the section settings override them when filled in.

  Styles: assets/alc-reviews.css. The slider is CSS scroll-snap; the arrows are a few
  lines of inline JS.
{% endcomment %}
{{ 'alc-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign locale = request.locale.iso_code | downcase
  assign own = ''
  assign fallback = ''
  for block in section.blocks
    assign codes = block.settings.locales | downcase | remove: ' ' | split: ','
    if block.settings.locales == blank or codes contains locale
      assign own = own | append: block.id | append: ','
    elsif codes contains 'en'
      assign fallback = fallback | append: block.id | append: ','
    endif
  endfor
  assign shown_ids = own | append: fallback | split: ','

  assign rating_value = section.settings.rating_value | default: '4.9'
  assign rating_count = section.settings.rating_count

  comment
    Built-in labels per storefront language (en.default.json is at Shopify's key
    limit, so no new locale keys). A filled-in setting wins, and Translate & Adapt
    can translate it; leave the settings empty to use these.
  endcomment
  assign lang = locale | slice: 0, 2
  case lang
    when 'en'
      assign d_eyebrow = 'Real reviews'
      assign d_heading = 'What our customers say'
      assign d_verified = 'Verified buyer'
      assign d_link = 'See all reviews'
    when 'hu'
      assign d_eyebrow = 'Valódi vélemények'
      assign d_heading = 'Mit mondanak vásárlóink'
      assign d_verified = 'Ellenőrzött vásárló'
      assign d_link = 'Összes vélemény'
    when 'pl'
      assign d_eyebrow = 'Prawdziwe opinie'
      assign d_heading = 'Co mówią nasi klienci'
      assign d_verified = 'Zweryfikowany zakup'
      assign d_link = 'Zobacz wszystkie opinie'
    when 'el'
      assign d_eyebrow = 'Πραγματικές κριτικές'
      assign d_heading = 'Τι λένε οι πελάτες μας'
      assign d_verified = 'Επαληθευμένος πελάτης'
      assign d_link = 'Δείτε όλες τις κριτικές'
    when 'bg'
      assign d_eyebrow = 'Истински отзиви'
      assign d_heading = 'Какво казват нашите клиенти'
      assign d_verified = 'Потвърден клиент'
      assign d_link = 'Вижте всички отзиви'
    when 'it'
      assign d_eyebrow = 'Recensioni reali'
      assign d_heading = 'Cosa dicono i nostri clienti'
      assign d_verified = 'Acquisto verificato'
      assign d_link = 'Vedi tutte le recensioni'
    when 'fr'
      assign d_eyebrow = 'Avis réels'
      assign d_heading = 'Ce que disent nos clients'
      assign d_verified = 'Achat vérifié'
      assign d_link = 'Voir tous les avis'
    when 'cs'
      assign d_eyebrow = 'Skutečné recenze'
      assign d_heading = 'Co říkají naši zákazníci'
      assign d_verified = 'Ověřený zákazník'
      assign d_link = 'Zobrazit všechny recenze'
    when 'sk'
      assign d_eyebrow = 'Skutočné recenzie'
      assign d_heading = 'Čo hovoria naši zákazníci'
      assign d_verified = 'Overený zákazník'
      assign d_link = 'Zobraziť všetky recenzie'
    when 'hr'
      assign d_eyebrow = 'Stvarne recenzije'
      assign d_heading = 'Što kažu naši kupci'
      assign d_verified = 'Provjereni kupac'
      assign d_link = 'Pogledajte sve recenzije'
    when 'de'
      assign d_eyebrow = 'Echte Bewertungen'
      assign d_heading = 'Was unsere Kunden sagen'
      assign d_verified = 'Verifizierter Kauf'
      assign d_link = 'Alle Bewertungen ansehen'
    else
      assign d_eyebrow = 'Recenzii reale'
      assign d_heading = 'Ce spun clienții noștri'
      assign d_verified = 'Client verificat'
      assign d_link = 'Vezi toate recenziile'
  endcase
  assign rv_eyebrow = section.settings.eyebrow | default: d_eyebrow
  assign rv_heading = section.settings.heading | default: d_heading
  assign rv_verified = section.settings.verified_label | default: d_verified
  assign rv_link = section.settings.link_label | default: d_link
-%}

<div class="alc-rv section-{{ section.id }}-padding" style="--alc-rv-pt: {{ section.settings.padding_top }}px; --alc-rv-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="alc-rv__head">
      <div class="alc-rv__intro">
        <p class="alc-rv__eyebrow">{{ rv_eyebrow }}</p>
        <h2 class="alc-rv__heading">{{ rv_heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="alc-rv__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="alc-rv__summary" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: 5 }}">
        <span class="alc-rv__score">{{ rating_value }}</span>
        <span class="alc-rv__summary-body">
          <span class="alc-rv__stars alc-rv__stars--lg" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
            {%- endfor -%}
          </span>
          {%- if rating_count > 0 -%}
            <span class="alc-rv__count">{{ rating_count }} {{ 'accessibility.total_reviews' | t }}</span>
          {%- endif -%}
        </span>
      </div>
    </div>

    {%- if shown_ids.size > 0 -%}
      <div class="alc-rv__slider" data-alc-rv>
        <ul class="alc-rv__track" role="list" data-alc-rv-track>
          {%- for id in shown_ids -%}
            {%- for block in section.blocks -%}
              {%- if block.id != id -%}{%- continue -%}{%- endif -%}
              {%- assign rv_product = block.settings.product -%}
              <li class="alc-rv__card" {{ block.shopify_attributes }}>
                <div class="alc-rv__card-top">
                  <span class="alc-rv__stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
                    {%- for i in (1..5) -%}
                      <svg class="{% if i > block.settings.rating %}is-off{% endif %}" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
                    {%- endfor -%}
                  </span>
                  {%- if block.settings.verified -%}
                    <span class="alc-rv__verified">
                      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>
                      {{- rv_verified -}}
                    </span>
                  {%- endif -%}
                </div>

                <blockquote class="alc-rv__text">
                  <p>{{ block.settings.text | escape | newline_to_br }}</p>
                </blockquote>

                <div class="alc-rv__meta">
                  <span class="alc-rv__author">{{ block.settings.author | escape }}</span>
                  {%- if block.settings.date != blank -%}
                    <span class="alc-rv__date">{{ block.settings.date | date: '%d.%m.%Y' }}</span>
                  {%- endif -%}
                </div>

                {%- if rv_product != blank -%}
                  <a href="{{ rv_product.url }}" class="alc-rv__product">
                    <span class="alc-rv__product-media">
                      {%- if rv_product.featured_image -%}
                        <img
                          src="{{ rv_product.featured_image | image_url: width: 120 }}"
                          width="48"
                          height="48"
                          alt=""
                          loading="lazy"
                          decoding="async"
                        >
                      {%- endif -%}
                    </span>
                    <span class="alc-rv__product-title">{{ rv_product.title | escape }}</span>
                    <svg class="alc-rv__product-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>

        <div class="alc-rv__foot">
          <div class="alc-rv__nav">
            <button type="button" class="alc-rv__arrow" data-alc-rv-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
            </button>
            <button type="button" class="alc-rv__arrow" data-alc-rv-next aria-label="{{ 'general.slider.next_slide' | t }}">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
            </button>
          </div>
          {%- if section.settings.link_url != blank -%}
            <a href="{{ section.settings.link_url }}" class="alc-view-all alc-rv__all">
              <span>{{ rv_link }}</span>
              <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    document.querySelectorAll('[data-alc-rv]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const track = root.querySelector('[data-alc-rv-track]');
      const prev = root.querySelector('[data-alc-rv-prev]');
      const next = root.querySelector('[data-alc-rv-next]');
      const step = () => {
        const card = track.querySelector('.alc-rv__card');
        return card ? card.getBoundingClientRect().width + 16 : track.clientWidth;
      };
      const sync = () => {
        prev.disabled = track.scrollLeft < 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', sync, { passive: true });
      sync();
    });
  })();
</script>

{% schema %}
{
  "name": "ALC Reviews",
  "tag": "section",
  "class": "section alc-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Empty = built-in text in the visitor's language."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = built-in text in the visitor's language."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Average rating",
      "info": "Shown as the big score, e.g. 4.9. Update it when the Vitals average changes.",
      "default": "4.9"
    },
    {
      "type": "number",
      "id": "rating_count",
      "label": "Number of reviews",
      "default": 250
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified buyer label",
      "info": "Empty = built-in text in the visitor's language."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Empty = built-in text in the visitor's language."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author (as shown)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "info": "Copy the customer's words verbatim."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "YYYY-MM-DD"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "locales",
          "label": "Show on languages",
          "info": "Storefront language codes, comma separated (ro, hu, pl, el, en, ...). Empty = all languages."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ALC Reviews"
    }
  ]
}
{% endschema %}
