{% schema %}
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "text",
        "id": "separator_symbol",
        "label": "Separator Symbol",
        "default": ">"
      }
    ],
    "presets": [
      {
        "name": "Breadcrumbs",
        "category": "Navigation"
      }
    ]
  }
{% endschema %}

<style>
  .breadcrumbs__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    font-size: 0.9em;
    color: rgba(var(--color-foreground), 0.75);
  }

  .breadcrumbs__item:not(:last-child):after {
    content: '{{ settings.separator_symbol | default: "›" | escape }}';
    display: inline-block;
    margin: 0 0.5em;
    color: rgba(var(--color-foreground), 0.4);
    font-size: 1.2em;
  }

  .breadcrumbs__link {
    color: rgba(var(--color-foreground), 0.75);
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 0.2em 0;
    position: relative;
  }

  .breadcrumbs__link:hover {
    color: rgba(var(--color-foreground), 1);
  }

  /* Underline animation on hover */
  .breadcrumbs__link:after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1px;
    bottom: 0;
    left: 0;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .breadcrumbs__link:hover:after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .breadcrumbs__link[aria-current='page'] {
    color: rgba(var(--color-foreground), 1);
    font-weight: 500;
  }

  .breadcrumbs__link[aria-current='page']:after {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .breadcrumbs {
      margin: 0.25em 0;
    }

    .breadcrumbs__item {
      font-size: 0.85em;
    }
  }
</style>

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  <nav
    class="breadcrumbs mt-2"
    role="navigation"
    aria-label="breadcrumbs">
    <div class="page-width">
      <ol class="breadcrumbs__list">
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="/">Home</a>
        </li>
        {%- case t -%}
          {%- when 'page' -%}
            <li class="breadcrumbs__item">
              <a
                class="breadcrumbs__link"
                href="{{ page.url }}"
                aria-current="page">{{ page.title }}</a>
            </li>
          {%- when 'product' -%}
            {%- assign collections_size = product.collections | size -%}
            {%- if collections_size > 1 -%}
              {%- assign index = collections_size | minus: 2 -%}
              {%- assign product_collection = product.collections[index] -%}
            {%- else -%}
              {%- assign product_collection = product.collections | last -%}
            {%- endif -%}
            {%- assign current_collection = product_collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}

            {%- # Build collection hierarchy array -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}

            {%- # Output collection hierarchy in reverse order -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}

              <li class="breadcrumbs__item">
                <a
                  class="breadcrumbs__link"
                  href="{{ col.url }}"
                  aria-current="page">{{ col.title }}</a>
              </li>
            {%- endfor -%}
            <li class="breadcrumbs__item">
              {{ product.title }}
            </li>
          {%- when 'collection' and collection.handle -%}
            {%- assign current_collection = collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}

            {%- # Build collection hierarchy array -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}

            {%- # Output collection hierarchy in reverse order -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}

              <li class="breadcrumbs__item">
                {%- if forloop.last and current_tags == blank -%}
                  {{ col.title }}
                {%- else -%}
                  <a
                    class="breadcrumbs__link"
                    href="{{ col.url }}"
                    aria-current="page">{{ col.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- # Handle tags if present -%}
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
                <a
                  class="no-underline text-black"
                  href="{{ tag_url }}"
                  aria-current="page">
                  {{- current_tags | join: ' + ' -}}
                </a> 
              </li>
            {%- endif -%}
          {%- when 'blog' -%}
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                {{ blog.title | link_to: blog.url }}
              </li>
              <li class="breadcrumbs__item">
                {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                <a
                  class="breadcrumbs__link"
                  href="{{ tag_url }}"
                  aria-current="page">
                  {{- current_tags | join: ' + ' -}}
                </a>
              </li>
            {%- else -%}
              <li class="breadcrumbs__item">
                <a
                  class="breadcrumbs__link"
                  href="{{ blog.url }}"
                  aria-current="page">{{ blog.title }}</a>
              </li>
            {%- endif -%}
          {%- when 'article' -%}
            <li class="breadcrumbs__item">
              {{ blog.title | link_to: blog.url }}
            </li>
            <li class="breadcrumbs__item">
              <a
                class="breadcrumbs__link"
                href="{{ article.url }}"
                aria-current="page">{{ article.title }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a
                class="breadcrumbs__link"
                href="{{ request.path }}"
                aria-current="page">{{ page_title }}</a>
            </li>
        {%- endcase -%}
      </ol>
    </div>
  </nav>
{%- endunless -%}