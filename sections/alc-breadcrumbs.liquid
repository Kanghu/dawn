{% schema %}
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "text",
        "id": "separator_symbol",
        "label": "Separator Symbol",
        "default": "/"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background Color",
        "default": "#FFFFFF"
      }
    ],
    "presets": [
      {
        "name": "Breadcrumbs",
        "category": "Navigation"
      }
    ]
  }
{% endschema %}

<style>
  .breadcrumbs {
    max-width: 100%;
    overflow-x: hidden;
  }
  @media screen and (min-width: 750px) {
    .breadcrumbs {
      margin-top: 1rem;
    }
  }
  .breadcrumbs__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
    white-space: nowrap;
    flex-wrap: nowrap;
    overflow: hidden;
  }
  .breadcrumbs__item {
    display: flex;
    align-items: center;
    font-size: 0.9em;
    color: rgba(var(--color-foreground), 0.75);
    flex-shrink: 0;
    min-width: 0;
  }
  .breadcrumbs__item:not(:last-child)::after {
    content: '{{ settings.separator_symbol | default: "›" | escape }}';
    display: inline-block;
    margin: 0 0.33em;
    color: rgba(var(--color-foreground), 0.4);
    font-size: 1em;
  }
  .breadcrumbs__item.shrink {
    min-width: 0;
    flex-shrink: 1;
    flex-grow: 0;
  }
  .breadcrumbs__link {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    color: inherit;
    display: inline-block;
    transition: color 0.2s;
    max-width: 100%;
  }
  .breadcrumbs__link:hover {
    color: rgba(var(--color-foreground), 1);
  }
  .breadcrumbs__link[aria-current="page"] {
    font-weight: 600;
    color: rgba(var(--color-foreground), 1);
  }
  @media (max-width: 749px) {
    .breadcrumbs__list {
      font-size: 0.85em;
    }
    .breadcrumbs__item.shrink {
      max-width: none;
    }
  }
</style>

{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  {%- comment -%} Generate JSON-LD structured data for breadcrumbs {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
                            {
          "@type": "ListItem",
          "position": 1,
          "name": "{{ shop.name | escape }}",
          "item": "{{ shop.secure_url }}"
        }
        {%- case template | split: '.' | first -%}
        {%- when 'product' -%}
          {%- assign main_collection = product.metafields.custom.main_collection.value -%}
          {%- if main_collection != blank -%}
            {%- assign product_collection = main_collection -%}
          {%- else -%}
            {%- assign product_collection = product.collections | last -%}
            {%- endif -%}
            {%- assign current_collection = product_collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
                {%- endif -%}
                {%- assign current_collection = parent_collection -%}
                {%- endfor -%}
                {%- assign position = 2 -%}
                {%- for hdl in collection_hierarchy reversed -%}
                  {%- assign col = collections[hdl] -%},
                  {
                    "@type": "ListItem",
                    "position": {{ position }},
                    "name": "{{ col.title | escape }}",
                    "item": "{{ shop.secure_url }}{{ col.url }}"
                  }
                  {%- assign position = position | plus: 1 -%}
                  {%- endfor -%},
                  {
                    "@type": "ListItem",
                    "position": {{ position }},
                    "name": "{{ product.selected_or_first_available_variant.sku | default: product.variants.first.sku | escape }}",
                    "item": "{{ shop.secure_url }}{{ product.url }}"
                  }

                {%- when 'collection' and collection.handle -%}
                  {%- assign current_collection = collection -%}
                  {%- assign collection_hierarchy = '' | split: ',' -%}
                  {%- for i in (1..100) -%}
                    {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
                    {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
                    {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
                    {%- if parent_collection == blank -%}
                      {%- break -%}
                      {%- endif -%}
                      {%- assign current_collection = parent_collection -%}
                      {%- endfor -%}
                      {%- assign position = 2 -%}
                      {%- for hdl in collection_hierarchy reversed -%}
                        {%- assign col = collections[hdl] -%}
                        {%- if forloop.last and current_tags == blank -%},
                          {
                            "@type": "ListItem",
                            "position": {{ position }},
                            "name": "{{ col.title | escape }}",
                            "item": "{{ shop.secure_url }}{{ col.url }}"
                          }
                        {%- else -%},
                          {
                            "@type": "ListItem",
                            "position": {{ position }},
                            "name": "{{ col.title | escape }}",
                            "item": "{{ shop.secure_url }}{{ col.url }}"
                          }
                          {%- endif -%}
                          {%- assign position = position | plus: 1 -%}
                          {%- endfor -%}
                          {%- if current_tags -%},
                            {
                              "@type": "ListItem",
                              "position": {{ position }},
                              "name": "{{ current_tags | join: ' + ' | escape }}",
                              "item": "{{ shop.secure_url }}{{ collection.url }}/{{ current_tags | join: '+' }}"
                            }
                            {%- endif -%}

                          {%- when 'page' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": "{{ page.title | escape }}",
                              "item": "{{ shop.secure_url }}{{ page.url }}"
                            }

                          {%- when 'article' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": "{{ blog.title | escape }}",
                              "item": "{{ shop.secure_url }}{{ blog.url }}"
                            },
                            {
                              "@type": "ListItem",
                              "position": 3,
                              "name": "{{ article.title | escape }}",
                              "item": "{{ shop.secure_url }}{{ article.url }}"
                            }

                          {%- when 'blog' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": "{{ blog.title | escape }}",
                              "item": "{{ shop.secure_url }}{{ blog.url }}"
                            }

                          {%- else -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": "{{ page_title | escape }}",
                              "item": "{{ shop.secure_url }}{{ request.path }}"
                            }
                            {%- endcase -%}
                          ]
                        }
  </script>

  <nav
    class="breadcrumbs"
    style="background-color: {{ section.settings.background }}"
    aria-label="breadcrumbs">
    <div class="page-width">
      <ol class="breadcrumbs__list">
        {%- case template | split: '.' | first -%}
          {%- when 'product' -%}
            {%- assign main_collection = product.metafields.custom.main_collection.value -%}
            {%- if main_collection != blank -%}
              {%- assign product_collection = main_collection -%}
            {%- else -%}
              {%- assign product_collection = product.collections | last -%}
            {%- endif -%}
            {%- assign current_collection = product_collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}
              <li class="breadcrumbs__item shrink">
                <a class="breadcrumbs__link" href="{{ col.url }}">{{ col.title }}</a>
              </li>
            {%- endfor -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">
                {{ product.selected_or_first_available_variant.sku | default: product.variants.first.sku }}
              </span>
            </li>

          {%- when 'collection' and collection.handle -%}
            {%- assign current_collection = collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}
              <li class="breadcrumbs__item{% if forloop.last and current_tags == blank %} shrink{% endif %}">
                {%- if forloop.last and current_tags == blank -%}
                  <span class="breadcrumbs__link" aria-current="page">{{ col.title }}</span>
                {%- else -%}
                  <a class="breadcrumbs__link" href="{{ col.url }}">{{ col.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__link" aria-current="page">{{ current_tags | join: ' + ' }}</span>
              </li>
            {%- endif -%}

          {%- when 'page' -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ page.title }}</span>
            </li>

          {%- when 'article' -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}">{{ blog.title }}</a>
            </li>
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ article.title }}</span>
            </li>

          {%- when 'blog' -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ blog.title }}</span>
            </li>

          {%- else -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ page_title }}</span>
            </li>
        {%- endcase -%}
      </ol>
    </div>
  </nav>
{%- endunless -%}