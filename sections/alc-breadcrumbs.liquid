{% schema %}
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "text",
        "id": "separator_symbol",
        "label": "Separator Symbol",
        "default": "/"
      },
      {
        "type": "color",
        "id": "background",
        "label": "Background Color",
        "default": "#FFFFFF"
      }
    ],
    "presets": [
      {
        "name": "Breadcrumbs",
        "category": "Navigation"
      }
    ]
  }
{% endschema %}

<style>
  .breadcrumbs {
    max-width: 100%;
    overflow-x: hidden;
  }
  @media screen and (min-width: 750px) {
    .breadcrumbs {
      margin-top: 1rem;
    }
  }
  .breadcrumbs__list {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
    white-space: nowrap;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .breadcrumbs__list::-webkit-scrollbar {
    display: none;
  }
  .breadcrumbs__item {
    display: flex;
    align-items: center;
    font-size: 0.95em;
    color: rgba(var(--color-foreground), 0.75);
    flex-shrink: 0;
    min-width: 0;
  }
  .breadcrumbs__item:not(:last-child)::after {
    content: '{{ settings.separator_symbol | default: "›" | escape }}';
    display: inline-block;
    margin: 0 0.55em;
    color: rgba(var(--color-foreground), 0.28);
    font-size: 1em;
  }
  .breadcrumbs__item.shrink {
    min-width: 0;
    flex-shrink: 0;
    flex-grow: 0;
  }
  .breadcrumbs__link {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    color: inherit;
    display: inline-block;
    transition: color 0.2s;
    max-width: 100%;
  }
  /* Plain text links: muted, darker and underlined on hover. */
  a.breadcrumbs__link {
    padding: 0.35em 0.15em;
    color: rgba(var(--color-foreground), 0.62);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  a.breadcrumbs__link:hover {
    color: rgba(var(--color-foreground), 1);
    text-decoration-color: rgba(var(--color-foreground), 0.35);
  }
  a.breadcrumbs__link--home {
    padding-left: 0;
    padding-right: 0.15em;
  }
  .breadcrumbs__home-icon {
    display: inline-block;
    width: 1.15em;
    height: 1.15em;
    vertical-align: middle;
    margin-top: -0.2em;
  }
  a.breadcrumbs__link:focus-visible {
    outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
    outline-offset: 0.2rem;
  }
  .breadcrumbs__link[aria-current="page"] {
    font-weight: 600;
    color: rgba(var(--color-foreground), 1);
    max-width: 24ch;
    padding: 0.35em 0.2em;
  }
  @media screen and (min-width: 750px) {
    .breadcrumbs__link[aria-current="page"] {
      max-width: 40ch;
    }
  }
  @media (max-width: 749px) {
    .breadcrumbs__list {
      font-size: 0.9em;
    }
    .breadcrumbs__item.shrink {
      max-width: none;
    }
  }

  /* Trail on the left, product code on the right. */
  .breadcrumbs__row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .breadcrumbs__row > .breadcrumbs__list {
    flex: 1 1 auto;
    min-width: 0;
  }
  .breadcrumbs__sku {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 5px;
    margin: 0;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 0.85em;
    white-space: nowrap;
  }
  .breadcrumbs__sku-value {
    color: rgba(var(--color-foreground), 1);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  @media (max-width: 749px) {
    .breadcrumbs__row {
      gap: 10px;
    }
    /* The product name is the H1 right below; on phones the room goes to the code. */
    .breadcrumbs__item--product {
      display: none;
    }
    .breadcrumbs__item:has(+ .breadcrumbs__item--product)::after {
      content: none;
    }
    .breadcrumbs__row > .breadcrumbs__list.is-scrolled {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 22px);
      mask-image: linear-gradient(to right, transparent, #000 22px);
    }
    .breadcrumbs__sku {
      align-items: center;
      font-size: 0.8em;
    }
    /* Phones: home + nearest category (trimmed) + code with a barcode icon. */
    .breadcrumbs__row:has(.breadcrumbs__item--product) .breadcrumbs__list {
      overflow: hidden;
    }
    .breadcrumbs__row:has(.breadcrumbs__item--product) .breadcrumbs__item:not(:first-child):not(:has(+ .breadcrumbs__item--product)) {
      display: none;
    }
    .breadcrumbs__item:has(+ .breadcrumbs__item--product) {
      flex-shrink: 1;
      min-width: 0;
    }
    .breadcrumbs__item:has(+ .breadcrumbs__item--product) .breadcrumbs__link {
      max-width: 100%;
    }
    .breadcrumbs__sku-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (min-width: 750px) {
    .breadcrumbs__sku-icon {
      display: none;
    }
  }
</style>

{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  {%- comment -%} Generate JSON-LD structured data for breadcrumbs {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ shop.name | json }},
          "item": "{{ shop.secure_url }}{{ routes.root_url }}"
        }
        {%- case template.name -%}
        {%- when 'product' -%}
          {%- assign main_collection = product.metafields.custom.main_collection.value -%}
          {%- if main_collection != blank -%}
            {%- assign product_collection = main_collection -%}
          {%- else -%}
            {%- assign product_collection = product.collections | last -%}
            {%- endif -%}
            {%- assign current_collection = product_collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
                {%- endif -%}
                {%- assign current_collection = parent_collection -%}
                {%- endfor -%}
                {%- assign position = 2 -%}
                {%- for hdl in collection_hierarchy reversed -%}
                  {%- assign col = collections[hdl] -%},
                  {
                    "@type": "ListItem",
                    "position": {{ position }},
                    "name": {{ col.title | json }},
                    "item": "{{ shop.secure_url }}{{ col.url }}"
                  }
                  {%- assign position = position | plus: 1 -%}
                  {%- endfor -%},
                  {
                    "@type": "ListItem",
                    "position": {{ position }},
                    "name": {{ product.title | json }},
                    "item": "{{ shop.secure_url }}{{ product.url }}"
                  }

                {%- when 'collection' -%}
                  {%- assign current_collection = collection -%}
                  {%- assign collection_hierarchy = '' | split: ',' -%}
                  {%- for i in (1..100) -%}
                    {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
                    {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
                    {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
                    {%- if parent_collection == blank -%}
                      {%- break -%}
                      {%- endif -%}
                      {%- assign current_collection = parent_collection -%}
                      {%- endfor -%}
                      {%- assign position = 2 -%}
                      {%- for hdl in collection_hierarchy reversed -%}
                        {%- assign col = collections[hdl] -%}
                        {%- if forloop.last and current_tags == blank -%},
                          {
                            "@type": "ListItem",
                            "position": {{ position }},
                            "name": {{ col.title | json }},
                            "item": "{{ shop.secure_url }}{{ col.url }}"
                          }
                        {%- else -%},
                          {
                            "@type": "ListItem",
                            "position": {{ position }},
                            "name": {{ col.title | json }},
                            "item": "{{ shop.secure_url }}{{ col.url }}"
                          }
                          {%- endif -%}
                          {%- assign position = position | plus: 1 -%}
                          {%- endfor -%}
                          {%- if current_tags -%},
                            {
                              "@type": "ListItem",
                              "position": {{ position }},
                              "name": {{ current_tags | join: ' + ' | json }},
                              "item": "{{ shop.secure_url }}{{ collection.url }}/{{ current_tags | join: '+' }}"
                            }
                            {%- endif -%}

                          {%- when 'page' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": {{ page.title | json }},
                              "item": "{{ shop.secure_url }}{{ page.url }}"
                            }

                          {%- when 'article' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": {{ blog.title | json }},
                              "item": "{{ shop.secure_url }}{{ blog.url }}"
                            },
                            {
                              "@type": "ListItem",
                              "position": 3,
                              "name": {{ article.title | json }},
                              "item": "{{ shop.secure_url }}{{ article.url }}"
                            }

                          {%- when 'blog' -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": {{ blog.title | json }},
                              "item": "{{ shop.secure_url }}{{ blog.url }}"
                            }

                          {%- else -%},
                            {
                              "@type": "ListItem",
                              "position": 2,
                              "name": {{ page_title | json }},
                              "item": "{{ shop.secure_url }}{{ request.path }}"
                            }
                            {%- endcase -%}
                          ]
                        }
  </script>

  <nav
    class="breadcrumbs"
    style="background-color: {{ section.settings.background }}"
    aria-label="breadcrumbs">
    <div class="page-width breadcrumbs__row">
      <ol class="breadcrumbs__list" data-breadcrumbs-list>
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link breadcrumbs__link--home" href="{{ routes.root_url }}">
            <svg
              class="breadcrumbs__home-icon"
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 10.5 12 3l9 7.5"/>
              <path d="M5.5 9v11a1 1 0 0 0 1 1H10v-6h4v6h3.5a1 1 0 0 0 1-1V9"/>
            </svg>
            <span class="visually-hidden">{{ shop.name }}</span>
          </a>
        </li>
        {%- case template.name -%}
          {%- when 'product' -%}
            {%- assign main_collection = product.metafields.custom.main_collection.value -%}
            {%- if main_collection != blank -%}
              {%- assign product_collection = main_collection -%}
            {%- else -%}
              {%- assign product_collection = product.collections | last -%}
            {%- endif -%}
            {%- assign current_collection = product_collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}
              <li class="breadcrumbs__item shrink">
                <a class="breadcrumbs__link" href="{{ col.url }}">{{ col.title }}</a>
              </li>
            {%- endfor -%}
            {%- assign product_sku = product.selected_or_first_available_variant.sku | default: product.variants.first.sku -%}
            <li class="breadcrumbs__item shrink breadcrumbs__item--product">
              <span class="breadcrumbs__link" aria-current="page">{{ product.title }}</span>
            </li>

          {%- when 'collection' -%}
            {%- assign current_collection = collection -%}
            {%- assign collection_hierarchy = '' | split: ',' -%}
            {%- for i in (1..100) -%}
              {%- assign handle_array = current_collection | map: 'handle' | first | split: ',' -%}
              {%- assign collection_hierarchy = collection_hierarchy | concat: handle_array -%}
              {%- assign parent_collection = current_collection.metafields.custom.parent_collection.value -%}
              {%- if parent_collection == blank -%}
                {%- break -%}
              {%- endif -%}
              {%- assign current_collection = parent_collection -%}
            {%- endfor -%}
            {%- for hdl in collection_hierarchy reversed -%}
              {%- assign col = collections[hdl] -%}
              <li class="breadcrumbs__item{% if forloop.last and current_tags == blank %} shrink{% endif %}">
                {%- if forloop.last and current_tags == blank -%}
                  <span class="breadcrumbs__link" aria-current="page">{{ col.title }}</span>
                {%- else -%}
                  <a class="breadcrumbs__link" href="{{ col.url }}">{{ col.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if current_tags -%}
              <li class="breadcrumbs__item">
                <span class="breadcrumbs__link" aria-current="page">{{ current_tags | join: ' + ' }}</span>
              </li>
            {%- endif -%}

          {%- when 'page' -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ page.title }}</span>
            </li>

          {%- when 'article' -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}">{{ blog.title }}</a>
            </li>
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ article.title }}</span>
            </li>

          {%- when 'blog' -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ blog.title }}</span>
            </li>

          {%- else -%}
            <li class="breadcrumbs__item">
              <span class="breadcrumbs__link" aria-current="page">{{ page_title }}</span>
            </li>
        {%- endcase -%}
      </ol>
      {%- comment -%}
        Product code at the end of the row, always visible (it is no longer repeated in the
        buy box). On phones the trail scrolls to its end so the nearest category shows.
      {%- endcomment -%}
      {%- if template.name == 'product' and product_sku != blank -%}
        <p class="breadcrumbs__sku">
          <svg class="breadcrumbs__sku-icon" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6v12M7.5 6v12M11 6v12M14 6v12M17.5 6v12M20 6v12"/></svg>
          <span class="breadcrumbs__sku-label">{% render 'alc-i18n', key: 'sku' %}:</span>
          <span class="breadcrumbs__sku-value">{{ product_sku }}</span>
        </p>
      {%- endif -%}
    </div>
  </nav>
  <script>
    (() => {
      const list = document.currentScript.previousElementSibling.querySelector('[data-breadcrumbs-list]');
      if (!list) return;
      const sync = () => list.classList.toggle('is-scrolled', list.scrollLeft > 4);
      list.scrollLeft = list.scrollWidth;
      sync();
      list.addEventListener('scroll', sync, { passive: true });
    })();
  </script>
{%- endunless -%}