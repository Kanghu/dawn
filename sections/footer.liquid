{% comment %}
  TailwindCSS version of your footer.
  - Replaces Bootstrap-like classes (`row`, `col-lg-3`, etc.) with Tailwind utilities.
  - Removes most inline styles in favor of Tailwind classes.
  - Keep or adjust any custom classes (e.g., `.widget`) if you still need them for your store's additional logic.
{% endcomment %}

<footer
  class="bg-black text-white text-sm font-roboto"
  data-section-id="{{ section.id }}"
  data-section-type="footer">
  <!-- Outer container for consistent max-width -->
  <div class="max-w-screen-xl mx-auto px-4 py-4">

    <!-- Footer middle -->
    <div class="footer-middle py-10 border-b border-gray-700">
      <!-- "Row" equivalent -->
      <div class="flex flex-wrap -mx-2">

        <!-- Company Info & Logo -->
        <div class="w-full lg:w-3/12 max-sm:hidden px-2 mb-6 footer-logo">
          <div class="mb-4 flex content-center">
            <a href="{{ shop.url }}" class="logo-footer inline-block">
              <img
                src="{{ 'logo-footer.webp' | file_url }}"
                alt="logo-footer"
                class="max-h-16 object-contain" />
            </a>
          </div>
          <div class="text-base text-als-gray">
            <div>
              &copy; 2020-{{ "now" | date: "%Y" }} S.C. ATLANTIC LOGISTIC CONCEPT S.R.L.
            </div>
            <div>CUI 43286659 Reg Com J2020005258233</div>
          </div>
        </div>
        <!-- End Company Info & Logo -->

        <!-- Footer Navigation / Right 9 columns -->
        <div class="w-full lg:w-9/12 px-2">
          <div class="flex flex-wrap -mx-2 footer-widgets">

            <!-- Section 1 (Despre noi) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget">
                <h4 class="widget-title text-white mb-2 text-xl font-light uppercase">
                  {{ 'sections.footer.about' | t }}
                </h4>
                <ul class="space-y-1 px-0 text-lg">
                  {% for link in linklists.footer-about.links %}
                    <li class="my-3">
                      <a href="{{ link.url }}" class="hover:text-gray-400 no-underline text-als-gray">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            <!-- Section 2 (Utile) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget">
                <h4 class="widget-title text-white mb-2 text-xl font-light uppercase">
                  {{ 'sections.footer.useful' | t }}
                </h4>
                <ul class="space-y-1 px-0 text-lg">
                  <li class="my-3">
                    <a href="{{ 'sections.footer.utile_links.help_center.url' | t }}" class="hover:text-gray-400 no-underline text-als-gray">
                      {{ 'sections.footer.utile_links.help_center.title' | t }}
                    </a>
                  </li>
                  <li class="my-3">
                    <a href="{{ 'sections.footer.utile_links.return_warranty.url' | t }}" class="hover:text-gray-400 no-underline text-als-gray">
                      {{ 'sections.footer.utile_links.return_warranty.title' | t }}
                    </a>
                  </li>
                  <li class="my-3">
                    <a href="{{ 'sections.footer.utile_links.order_status.url' | t }}" class="hover:text-gray-400 no-underline text-als-gray">
                      {{ 'sections.footer.utile_links.order_status.title' | t }}
                    </a>
                  </li>
                  <li class="my-3">
                    <a href="{{ 'sections.footer.utile_links.public_procurement.url' | t }}" class="hover:text-gray-400 no-underline text-als-gray">
                      {{ 'sections.footer.utile_links.public_procurement.title' | t }}
                    </a>
                  </li>
                  <li class="my-3">
                    <a href="{{ 'sections.footer.utile_links.return_form.url' | t }}" class="hover:text-gray-400 no-underline text-als-gray">
                      {{ 'sections.footer.utile_links.return_form.title' | t }}
                    </a>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Section 3 (Business) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget widget-info">
                <h4 class="widget-title text-white mb-2 text-xl font-light uppercase">
                  {{ 'sections.footer.business' | t }}
                </h4>
                <ul class="space-y-1 px-0 text-lg">
                  {% for link in linklists.footer-business.links %}
                    <li class="my-3">
                      <a href="{{ link.url }}" class="hover:text-gray-400 no-underline text-als-gray">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            <!-- Section 4 (Termeni) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget widget-info">
                <h4 class="widget-title text-white mb-2 text-xl font-light uppercase">
                  {{ 'sections.footer.terms' | t }}
                </h4>
                <ul class="space-y-1 px-0 text-lg">
                  {% for link in linklists.footer-termeni.links %}
                    <li class="my-3">
                      <a href="{{ link.url }}" class="hover:text-gray-400 no-underline text-als-gray">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            <!-- Section 5 (Contact) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget widget-info">
                <h4 class="widget-title text-white my-2 text-xl font-light uppercase">
                  {{ 'sections.footer.contact' | t }}
                </h4>
                <ul class="text-lg text-white px-0">
                  <li class="flex items-center my-2">
                    <!-- phone icon -->
                    <svg
                      width="24px"
                      height="24px"
                      viewBox="0 0 24 24"
                      class="mx-2"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                      <g
                        id="SVGRepo_tracerCarrier"
                        stroke-linecap="round"
                        stroke-linejoin="round"></g>
                      <g id="SVGRepo_iconCarrier">
                        <path
                          d="M3.51089 2L7.15002 2.13169C7.91653 2.15942 8.59676 2.64346 8.89053 3.3702L9.96656 6.03213C10.217 6.65159 10.1496 7.35837 9.78693 7.91634L8.40831 10.0375C9.22454 11.2096 11.4447 13.9558 13.7955 15.5633L15.5484 14.4845C15.9939 14.2103 16.5273 14.1289 17.0314 14.2581L20.5161 15.1517C21.4429 15.3894 22.0674 16.2782 21.9942 17.2552L21.7705 20.2385C21.6919 21.2854 20.8351 22.1069 19.818 21.9887C6.39245 20.4276 -1.48056 1.99997 3.51089 2Z"
                          stroke="#999999"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </g>
                    </svg>
                    <a href="tel:{% if request.locale.iso_code == 'ro' %}0215557252{% else %}0740638072{% endif %}" class="hover:text-gray-400 no-underline text-white">
                      {% if request.locale.iso_code == 'ro' %}
                        021.555.7252 (RO)
                      {% else %}
                        +40 723 029 676 (EN)
                      {% endif %}
                    </a>
                  </li>
                  <li class="flex items-center my-2">
                    <!-- whatsapp icon -->
                    <svg
                      width="24px"
                      height="24px"
                      viewBox="0 0 24 24"
                      class="mx-2"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                      <g
                        id="SVGRepo_tracerCarrier"
                        stroke-linecap="round"
                        stroke-linejoin="round"></g>
                      <g id="SVGRepo_iconCarrier">
                        <path d="M17.6 6.31999C16.8669 5.58141 15.9943 4.99596 15.033 4.59767C14.0716 4.19938 13.0406 3.99622 12 3.99999C10.6089 4.00135 9.24248 4.36819 8.03771 5.06377C6.83294 5.75935 5.83208 6.75926 5.13534 7.96335C4.4386 9.16745 4.07046 10.5335 4.06776 11.9246C4.06507 13.3158 4.42793 14.6832 5.12 15.89L4 20L8.2 18.9C9.35975 19.5452 10.6629 19.8891 11.99 19.9C14.0997 19.9001 16.124 19.0668 17.6222 17.5816C19.1205 16.0965 19.9715 14.0796 19.99 11.97C19.983 10.9173 19.7682 9.87634 19.3581 8.9068C18.948 7.93725 18.3505 7.05819 17.6 6.31999ZM12 18.53C10.8177 18.5308 9.65701 18.213 8.64 17.61L8.4 17.46L5.91 18.12L6.57 15.69L6.41 15.44C5.55925 14.0667 5.24174 12.429 5.51762 10.8372C5.7935 9.24545 6.64361 7.81015 7.9069 6.80322C9.1702 5.79628 10.7589 5.28765 12.3721 5.37368C13.9853 5.4597 15.511 6.13441 16.66 7.26999C17.916 8.49818 18.635 10.1735 18.66 11.93C18.6442 13.6859 17.9355 15.3645 16.6882 16.6006C15.441 17.8366 13.756 18.5301 12 18.53ZM15.61 13.59C15.41 13.49 14.44 13.01 14.26 12.95C14.08 12.89 13.94 12.85 13.81 13.05C13.6144 13.3181 13.404 13.5751 13.18 13.82C13.07 13.96 12.95 13.97 12.75 13.82C11.6097 13.3694 10.6597 12.5394 10.06 11.47C9.85 11.12 10.26 11.14 10.64 10.39C10.6681 10.3359 10.6827 10.2759 10.6827 10.215C10.6827 10.1541 10.6681 10.0941 10.64 10.04C10.64 9.93999 10.19 8.95999 10.03 8.56999C9.87 8.17999 9.71 8.23999 9.58 8.22999H9.19C9.08895 8.23154 8.9894 8.25465 8.898 8.29776C8.8066 8.34087 8.72546 8.403 8.66 8.47999C8.43562 8.69817 8.26061 8.96191 8.14676 9.25343C8.03291 9.54495 7.98287 9.85749 8 10.17C8.0627 10.9181 8.34443 11.6311 8.81 12.22C9.6622 13.4958 10.8301 14.5293 12.2 15.22C12.9185 15.6394 13.7535 15.8148 14.58 15.72C14.8552 15.6654 15.1159 15.5535 15.345 15.3915C15.5742 15.2296 15.7667 15.0212 15.91 14.78C16.0428 14.4856 16.0846 14.1583 16.03 13.84C15.94 13.74 15.81 13.69 15.61 13.59Z" fill="#999999"></path>
                      </g>
                    </svg>
                    <a
                      href="https://api.whatsapp.com/send?phone=40730478880&amp;text=Salut!"
                      target="_blank"
                      class="hover:text-gray-400 no-underline text-white">
                      0730.478.880
                    </a>
                  </li>
                  <li class="flex items-center my-2">
                    <!-- email icon -->
                    <svg
                      width="24px"
                      height="24px"
                      viewBox="0 0 24 24"
                      class="mx-2"
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                      <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                      <g
                        id="SVGRepo_tracerCarrier"
                        stroke-linecap="round"
                        stroke-linejoin="round"></g>
                      <g id="SVGRepo_iconCarrier">
                        <path
                          d="M3.29289 5.29289C3.47386 5.11193 3.72386 5 4 5H20C20.2761 5 20.5261 5.11193 20.7071 5.29289M3.29289 5.29289C3.11193 5.47386 3 5.72386 3 6V18C3 18.5523 3.44772 19 4 19H20C20.5523 19 21 18.5523 21 18V6C21 5.72386 20.8881 5.47386 20.7071 5.29289M3.29289 5.29289L10.5858 12.5857C11.3668 13.3668 12.6332 13.3668 13.4142 12.5857L20.7071 5.29289"
                          stroke="#999999"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"></path>
                      </g>
                    </svg>
                    <a href="mailto:contact@alessandrodesign.ro" class="hover:text-gray-400 no-underline text-white ">
                      contact@ 
                      alessandrodesign.ro
                    </a>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Section 6 (Program) -->
            <div class="w-1/2 sm:w-1/3 md:w-1/4 lg:w-2/12 px-2 mb-6">
              <div class="widget widget-info text-base mx-2">
                <ul class="space-y-1 text-lg px-0">
                  <li class="flex items-center space-x-1 my-2">
                    <span>
                      {{ 'sections.footer.contact_info.cc_schedule' | t }}
                    </span>
                  </li>
                  <li class="flex items-center space-x-1 my-2">
                    <span>
                      {{ 'sections.footer.contact_info.showroom_schedule_1' | t }}
                    </span>
                  </li>
                  <li class="flex items-center space-x-1 my-2"></li>
                </ul>
              </div>
            </div>

            <!-- Mobile-Only Company Info (if needed) -->
            <div class="w-full block lg:hidden text-center mt-4">
              <p class="text-base text-gray-300">
                &copy; 2020-{{ "now" | date: "%Y" }} S.C. ATLANTIC LOGISTIC CONCEPT S.R.L.
                <br/>
                CUI 43286659 Reg Com J23/5258/04.11.2020
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- End footer-middle -->

    <!-- Footer bottom -->
    <div class="footer-bottom flex flex-wrap items-center justify-center py-4 relative">
      <div class="footer-center w-full lg:w-3/4 mb-4 lg:mb-0 flex flex-col lg:flex-row items-center lg:justify-between space-y-4 lg:space-y-0">
        <div class="netopia-payments flex justify-center">
          <img
            title="Stripe Payments"
            src="{{ 'np-svg.svg' | file_url }}"
            alt="Stripe payment"
            class="w-25 cursor-pointer h-auto" />
        </div>

        <!-- ANPC icons -->
        <div class="flex items-center justify-center space-x-4">
          <a
            href="https://anpc.ro/ce-este-sal/"
            rel="nofollow"
            target="_blank">
            <img
              src="{{ 'anpc-sal.webp' | file_url }}"
              alt="anpc"
              class="max-h-14" />
          </a>
          <a
            href="https://ec.europa.eu/consumers/odr/main/index.cfm?event=main.home2.show&amp;lng=RO"
            rel="nofollow"
            target="_blank">
            <img
              src="{{ 'anpc-sol.webp' | file_url }}"
              alt="anpc"
              class="max-h-14" />
          </a>
 
        </div>
        <!--Pepita badge-->
<div id="pepita-partner-badge" data-pssid="15916" class="flex items-center space-x-2">
  <a id="pepita-partner-badge-seller-link" href="https://pepita.hu/forgalmazo/atlantic-logistic-concept-srl-d15916" target="_blank">
    <img src="https://pepita.hu/partner-badge-image/15916" alt="Pepita Super Seller" id="pepita-super-seller">
  </a>
  <a id="pepita-partner-badge-site-link" href="https://pepita.hu" target="_blank">
    <img src="https://pepita.hu/partner-badge-pepita-logo/15916" alt="Pepita.hu" id="pepita-logo">
    <span>marketplace partner</span>
  </a>
  <script>
    // Încarcă badge-ul oficial
    (function(w, d, s) {
      var scriptElement = d.getElementsByTagName(s)[0];
      var script = d.createElement(s);
      script.async = true;
      script.src = "https://pepita.hu/js/partner-badge.js";
      scriptElement.parentNode.insertBefore(script, scriptElement);
    })(window, document, 'script');

    // Forțează max-h-14 după ce script-ul încarcă imaginile
    window.addEventListener('load', function() {
      const sellerImg = document.getElementById('pepita-super-seller');
      const logoImg = document.getElementById('pepita-logo');
      if(sellerImg) sellerImg.style.maxHeight = '3.5rem';
      if(logoImg) logoImg.style.maxHeight = '3.5rem';
    });
  </script>
</div>
<!-- /Pepita badge-->
      </div>

      <!-- Copyright + Developer -->
      <div class="w-full mt-4 text-center text-base text-gray-400">
        Developed with ♡ by
        <a
          href="https://atlanticlogisticconcept.ro"
          title="ALC"
          class="hover:underline">
          ALC
        </a>
        <br />
        Logistics powered by
        <a href="https://livraria.ro">Livraria</a>
      </div>

      <!-- Social links (absolute or manually positioned) -->
      <div class="social-links flex space-x-4 mt-4 lg:mt-0 lg:absolute right-4">
        <a
          href="https://www.facebook.com/alessandrodesign.ro"
          target="_blank"
          class="social-link social-facebook fab fa-facebook-f hover:text-gray-400"></a>
        <a
          href="https://www.instagram.com/alessandrodesign.ro/"
          target="_blank"
          class="social-link social-instagram fab fa-instagram hover:text-gray-400"></a>
        <a
          href="https://www.youtube.com/channel/UCIhyazE1pBVcDZZlf-_JeSg"
          target="_blank"
          class="social-link social-youtube fab fa-youtube hover:text-gray-400"></a>
      </div>
    </div>
  <!-- End Footer Bottom -->
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Footer logo"
      }
    ],
    "blocks": [],
    "default": {}
  }
{% endschema %}