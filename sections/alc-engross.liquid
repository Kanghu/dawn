      assign w = "Comenzi en‑gros · B2B|Lumină la scară de proiect.|Echipăm hoteluri, restaurante, birouri și locuințe la cheie direct de la producător. Prețuri pe volum, stoc propriu și un consultant care îți face oferta pe lista ta de produse.|Cere o ofertă|Vorbește cu un consultant|Ofertă en‑gros|Client|Hotel, 48 de camere|Preț listă|Preț en‑gros|Total|la cerere|Preț pe volum|buc.|produse în catalog|m² showroom și depozit|anul fabricii proprii|țări deservite|5.000+|Pentru cine|Pentru cei care cumpără cu zecile, nu cu bucata.|Hoteluri și pensiuni|Camere, holuri și restaurante, echipate la același standard.|Restaurante și cafenele|Lumina care face atmosfera, de la bar la terasă.|Birouri și spații comerciale|Iluminat eficient pentru open space, magazine și showroomuri.|Dezvoltatori imobiliari|Apartamente la cheie, cu același standard în fiecare unitate.|Arhitecți și designeri|Produsele din proiectele tale, la prețuri de proiect.|Revânzători și instalatori|Stoc pentru magazinul sau lucrările tale, la prețuri en‑gros.|De ce direct de la noi|Fără intermediari între fabrică și proiectul tău.|Prețuri pe volum|Cu cât lista e mai mare, cu atât prețul pe bucată scade. Primești oferta pe produsele tale, nu o listă de prețuri generică.|Direct de la producător|Fabrică proprie din 2023 și putere de import. Zero intermediari, adaos redus la minimum.|Stoc propriu|Peste 5.000 m² de showroom și depozit în Afumați, lângă București.|Vezi înainte să comanzi|Vino în showroom și vezi produsele aprinse, la scară reală, înainte de comanda mare.|Un consultant dedicat|Un singur om de contact, de la lista de produse până la livrare.|Cum funcționează|De la listă la livrare, în patru pași.|Trimiți lista|Produse, cantități și termen. O poți face în formularul de mai jos.|Primești oferta|Un consultant îți trimite prețurile pe volum pentru lista ta.|Confirmi comanda|Stabilim împreună plata, facturarea și programul de livrare.|Livrăm|Comanda pleacă din depozitul nostru, cu număr de urmărire.|Cerere de ofertă|Spune-ne de ce ai nevoie.|Durează două minute. Un consultant revine cu oferta.|Proiect|Produse|Volum|Contact|Ce fel de proiect ai?|Altceva|Ce produse te interesează?|Poți alege mai multe.|Lustre|Lustre LED|Candelabre de cristal|Aplice|Spoturi|Oglinzi LED|Obiecte sanitare|Mobilier de baie|Cam câte bucăți?|Când ai nevoie de ele?|Cât mai repede|În luna următoare|În 1–3 luni|Doar mă informez|Lista de produse (opțional)|Coduri de produs, linkuri sau o descriere: de exemplu, 40 de aplice pentru holuri, 12 lustre pentru restaurant.|Firma|CUI (opțional)|Nume|Email|Telefon|Înapoi|Continuă|Trimite cererea|Cererea a ajuns la noi.|Un consultant te contactează cu oferta cât de curând.|Verifică adresa de email și încearcă din nou.|Folosim datele tale doar pentru oferta en‑gros.|Câmp obligatoriu|Pasul|Salut! Aș dori o ofertă pentru o comandă en-gros.|.|Preferi să vorbim?|Scrie-ne pe WhatsApp|Data"
  endcase
  assign t = w | split: '|'

  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif

  comment
    Live catalogue size, rounded down to the hundred: "3.300+".
  endcomment
  assign n = collections.all.products_count | divided_by: 100 | times: 100
  assign n_thousands = n | divided_by: 1000
  assign n_rest = n | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
  if n_thousands > 0
    assign product_count = n_thousands | append: t[97] | append: n_rest | append: '+'
  else
    assign product_count = n | append: '+'
  endif

  assign wa_number = section.settings.whatsapp | remove: '+' | remove: ' '
  assign wa_msg = t[96] | url_encode | replace: '+', '%20'
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_msg

  comment
    Quote lines for a 48-room hotel: two wall lights, one chandelier and one mirror per
    room. Each line is the product picked in the editor, or, if it is empty or sold out,
    the first available product with a photo in its collection.
  endcomment
  assign quote_handles = 'aplice,lustre-led,oglinzi-led' | split: ','
  assign quote_qty = '96,48,48' | split: ','

  comment
    Values stored in the email the team receives stay in Romanian, whatever the
    storefront language, so every request reads the same.
  endcomment
  assign segments_ro = 'Hotel sau pensiune|Restaurant sau cafenea|Birouri sau spatiu comercial|Dezvoltator imobiliar|Arhitect sau designer|Revanzator sau instalator|Altceva' | split: '|'
  assign segment_icons = 'bed,cup,office,crane,compass,store,other' | split: ','
  assign cats_ro = 'Lustre|Lustre LED|Candelabre de cristal|Aplice|Spoturi|Oglinzi LED|Obiecte sanitare|Mobilier de baie' | split: '|'
  assign cat_handles = 'lustre-cu-bec,lustre-led,candelabre-cristal,aplice,spoturi,oglinzi-led,baie,mobilier-baie' | split: ','
  assign volumes = '< 20|20 – 100|100 – 500|500 +' | split: '|'
  assign times_ro = 'Cat mai repede|In luna urmatoare|In 1-3 luni|Doar ma informez' | split: '|'

  assign start_step = 1
-%}

<div class="alc-eg">
  {%- comment -%} Hero {%- endcomment -%}
  <section class="alc-eg__hero">
    <div class="page-width alc-eg__hero-grid">
      <div class="alc-eg__hero-copy">
        <p class="alc-eg__kicker"><span aria-hidden="true"></span>{{ t[0] }}</p>
        <h1 class="alc-eg__h1">{{ t[1] }}</h1>
        <p class="alc-eg__lead">{{ t[2] }}</p>
        <div class="alc-eg__actions">
          <a class="alc-eg__btn alc-eg__btn--primary" href="#AlcEgQuote">
            {{- t[3] -}}
            {%- render 'alc-eg-icon', name: 'arrow' -%}
          </a>
          <a class="alc-eg__btn alc-eg__btn--ghost" href="{{ wa_url }}" target="_blank" rel="noopener">
            {%- render 'alc-ds-icon', name: 'whatsapp' -%}
            {{- t[4] -}}
          </a>
        </div>
      </div>

      {%- comment -%} Decorative: it repeats what the copy says, so screen readers skip it. {%- endcomment -%}
      <div class="alc-eg__doc-wrap" aria-hidden="true">
        <div class="alc-eg__doc alc-eg__doc--back"></div>
        <div class="alc-eg__doc">
          <div class="alc-eg__doc-head">
            <div>
              <p class="alc-eg__mono alc-eg__doc-no">AD-EG-{{ 'now' | date: '%y%m' }}-048</p>
              <p class="alc-eg__doc-title">{{ t[5] }}</p>
            </div>
            <span class="alc-eg__doc-badge">{{ t[12] }}</span>
          </div>
          <dl class="alc-eg__doc-meta">
            <div>
              <dt class="alc-eg__mono">{{ t[6] }}</dt>
              <dd>{{ t[7] }}</dd>
            </div>
            <div>
              <dt class="alc-eg__mono">{{ t[100] }}</dt>
              <dd>{{ 'now' | date: '%d.%m.%Y' }}</dd>
            </div>
          </dl>
          <div class="alc-eg__doc-cols alc-eg__mono">
            <span></span>
            <span>{{ t[8] }}</span>
            <span>{{ t[9] }}</span>
          </div>
          <ol class="alc-eg__lines">
            {%- for h in quote_handles -%}
              {%- liquid
                assign key = 'quote_' | append: forloop.index
                assign line = section.settings[key]
                if line == blank or line.available == false or line.featured_image == blank
                  assign line = blank
                  for p in collections[h].products
                    if p.available and p.featured_image
                      assign line = p
                      break
                    endif
                  endfor
                endif
                assign qty = quote_qty[forloop.index0]
              -%}
              {%- if line != blank -%}
                <li class="alc-eg__line" style="--i: {{ forloop.index }};">
                  <span class="alc-eg__line-img">
                    {{-
                      line.featured_image
                      | image_url: width: 120
                      | image_tag: widths: '60, 120', sizes: '52px', loading: 'eager', alt: ''
                    -}}
                  </span>
                  <span class="alc-eg__line-name">
                    <span>{{ line.title | escape }}</span>
                    <small class="alc-eg__mono">× {{ qty }} {{ t[13] }}</small>
                  </span>
                  <span class="alc-eg__line-list alc-eg__mono">{{ line.price | money_without_trailing_zeros }}</span>
                  <span class="alc-eg__line-wh">
                    <span class="alc-eg__blur"></span>
                    {%- render 'alc-eg-icon', name: 'lock' -%}
                  </span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
          <div class="alc-eg__doc-total">
            <span class="alc-eg__mono">{{ t[10] }}</span>
            <strong>{{ t[11] }}</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} Proof row {%- endcomment -%}
  <div class="page-width">
    <dl class="alc-eg__proof">
      <div>
        <dd>{{ product_count }}</dd>
        <dt class="alc-eg__mono">{{ t[14] }}</dt>
      </div>
      <div>
        <dd>{{ t[18] }}</dd>
        <dt class="alc-eg__mono">{{ t[15] }}</dt>
      </div>
      <div>
        <dd>2023</dd>
        <dt class="alc-eg__mono">{{ t[16] }}</dt>
      </div>
      <div>
        <dd>10</dd>
        <dt class="alc-eg__mono">{{ t[17] }}</dt>
      </div>
    </dl>
  </div>

  {%- comment -%} Who it is for {%- endcomment -%}
  <section class="page-width alc-eg__block">
    <header class="alc-eg__head">
      <p class="alc-eg__eyebrow alc-eg__mono">01 — {{ t[19] }}</p>
      <h2 class="alc-eg__h2">{{ t[20] }}</h2>
    </header>
    <ul class="alc-eg__segments" role="list"{% if reveal != blank %} data-cascade{% endif %}>
      {%- for i in (1..6) -%}
        {%- assign ti = i | times: 2 | plus: 19 -%}
        {%- assign di = ti | plus: 1 -%}
        <li class="alc-eg__segment{{ reveal }}" style="--animation-order: {{ i }};">
          <span class="alc-eg__segment-top">
            <span class="alc-eg__segment-icon">{%- render 'alc-eg-icon', name: segment_icons[forloop.index0] -%}</span>
            <span class="alc-eg__mono">0{{ i }}</span>
          </span>
          <h3 class="alc-eg__segment-title">{{ t[ti] }}</h3>
          <p class="alc-eg__segment-text">{{ t[di] }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </section>

  {%- comment -%} Why buy direct {%- endcomment -%}
  <section class="page-width alc-eg__block">
    <div class="alc-eg__why">
      <div class="alc-eg__why-side">
        <header class="alc-eg__head">
          <p class="alc-eg__eyebrow alc-eg__mono">02 — {{ t[33] }}</p>
          <h2 class="alc-eg__h2">{{ t[34] }}</h2>
        </header>
        <figure class="alc-eg__why-media">
          {%- assign why_img = section.settings.image -%}
          {%- if why_img != blank -%}
            {{
              why_img
              | image_url: width: 1200
              | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 990px) 560px, 100vw', loading: 'lazy', alt: ''
            }}
          {%- else -%}
            <img
              src="{{ 'alc-showroom-hall.jpg' | asset_img_url: '1200x' }}"
              srcset="{{ 'alc-showroom-hall.jpg' | asset_img_url: '600x' }} 600w, {{ 'alc-showroom-hall.jpg' | asset_img_url: '1200x' }} 1200w"
              sizes="(min-width: 990px) 560px, 100vw"
              width="1200"
              height="675"
              alt=""
              loading="lazy"
            >
          {%- endif -%}
          <figcaption class="alc-eg__mono">
            <span>{{ t[18] }} m²</span>
            <span>Afumați · RO</span>
          </figcaption>
        </figure>
      </div>
      <ul class="alc-eg__features" role="list">
        {%- assign feature_icons = 'tag,factory,warehouse,eye,user' | split: ',' -%}
        {%- for i in (1..5) -%}
          {%- assign ti = i | times: 2 | plus: 33 -%}
          {%- assign di = ti | plus: 1 -%}
          <li class="alc-eg__feature{{ reveal }}" style="--animation-order: {{ i }};">
            <span class="alc-eg__feature-icon">{%- render 'alc-eg-icon', name: feature_icons[forloop.index0] -%}</span>
            <div>
              <h3 class="alc-eg__feature-title">{{ t[ti] }}</h3>
              <p class="alc-eg__feature-text">{{ t[di] }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} The four steps {%- endcomment -%}
  <section class="page-width alc-eg__block">
    <header class="alc-eg__head">
      <p class="alc-eg__eyebrow alc-eg__mono">03 — {{ t[45] }}</p>
      <h2 class="alc-eg__h2">{{ t[46] }}</h2>
    </header>
    <ol class="alc-eg__process" role="list"{% if reveal != blank %} data-cascade{% endif %}>
      {%- assign process_icons = 'list,doc,confirm,truck' | split: ',' -%}
      {%- for i in (1..4) -%}
        {%- assign ti = i | minus: 1 | times: 2 | plus: 47 -%}
        {%- assign di = ti | plus: 1 -%}
        <li class="alc-eg__pstep{{ reveal }}" style="--animation-order: {{ i }};">
          <span class="alc-eg__pstep-node">{%- render 'alc-eg-icon', name: process_icons[forloop.index0] -%}</span>
          <span class="alc-eg__mono alc-eg__pstep-num">{{ t[95] }} 0{{ i }}</span>
          <h3 class="alc-eg__pstep-title">{{ t[ti] }}</h3>
          <p class="alc-eg__pstep-text">{{ t[di] }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </section>

  {%- comment -%} Quote request {%- endcomment -%}
  <section class="alc-eg__quote" id="AlcEgQuote">
    <div class="page-width">
      <header class="alc-eg__head alc-eg__head--light">
        <p class="alc-eg__eyebrow alc-eg__mono">04 — {{ t[55] }}</p>
        <h2 class="alc-eg__h2">{{ t[56] }}</h2>
        <p class="alc-eg__head-sub">{{ t[57] }}</p>
      </header>

      <div class="alc-eg__wizard-card{{ reveal }}">
        {%- form 'contact', id: 'AlcEgQuoteForm', class: 'alc-eg__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="alc-eg__success" tabindex="-1" autofocus>
              <span class="alc-eg__success-icon">{%- render 'alc-eg-icon', name: 'check' -%}</span>
              <h3 class="alc-eg__success-title">{{ t[90] }}</h3>
              <p class="alc-eg__success-text">{{ t[91] }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              {%- assign start_step = 4 -%}
            {%- endif -%}
            <alc-eg-quote class="alc-eg__wizard" data-start="{{ start_step }}">
              <ol class="alc-eg__rail" role="list">
                {%- for i in (1..4) -%}
                  {%- assign si = i | plus: 57 -%}
                  <li>
                    <button type="button" class="alc-eg__rail-step" data-go="{{ i }}"{% if i == start_step %} aria-current="step"{% endif %}>
                      <span class="alc-eg__rail-num alc-eg__mono">0{{ i }}</span>
                      <span class="alc-eg__rail-label">{{ t[si] }}</span>
                    </button>
                  </li>
                {%- endfor -%}
              </ol>
              <div class="alc-eg__progress" aria-hidden="true"><span></span></div>

              <input type="hidden" name="contact[Formular]" value="Comanda en-gros">
              <input type="hidden" name="contact[Piata]" value="{{ request.host | remove_first: 'www.' }} ({{ request.locale.iso_code }})">

              {%- comment -%} Step 1: project type {%- endcomment -%}
              <fieldset class="alc-eg__step" data-step="1">
                <legend class="alc-eg__step-q" tabindex="-1">{{ t[62] }}</legend>
                <div class="alc-eg__tiles">
                  {%- for s in segments_ro -%}
                    {%- liquid
                      if forloop.last
                        assign label = t[63]
                      else
                        assign li = forloop.index | times: 2 | plus: 19
                        assign label = t[li]
                      endif
                    -%}
                    <label class="alc-eg__tile">
                      <input type="radio" name="contact[Tip proiect]" value="{{ s }}">
                      <span class="alc-eg__tile-box">
                        <span class="alc-eg__tile-icon">{%- render 'alc-eg-icon', name: segment_icons[forloop.index0] -%}</span>
                        <span class="alc-eg__tile-label">{{ label }}</span>
                        <span class="alc-eg__tile-check">{%- render 'alc-eg-icon', name: 'check' -%}</span>
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>

              {%- comment -%} Step 2: products {%- endcomment -%}
              <fieldset class="alc-eg__step" data-step="2">
                <legend class="alc-eg__step-q" tabindex="-1">{{ t[64] }} <span>{{ t[65] }}</span></legend>
                <div class="alc-eg__cats">
                  {%- for c in cats_ro -%}
                    {%- liquid
                      assign ci = forloop.index | plus: 65
                      assign cat_img = blank
                      for p in collections[cat_handles[forloop.index0]].products
                        if p.available and p.featured_image
                          assign cat_img = p.featured_image
                          break
                        endif
                      endfor
                    -%}
                    <label class="alc-eg__cat">
                      <input type="checkbox" name="contact[Produse: {{ c }}]" value="Da">
                      <span class="alc-eg__cat-box">
                        <span class="alc-eg__cat-img">
                          {%- if cat_img != blank -%}
                            {{-
                              cat_img
                              | image_url: width: 300
                              | image_tag: widths: '150, 300', sizes: '(min-width: 990px) 150px, 40vw', loading: 'lazy', alt: ''
                            -}}
                          {%- endif -%}
                        </span>
                        <span class="alc-eg__cat-label">{{ t[ci] }}</span>
                        <span class="alc-eg__tile-check">{%- render 'alc-eg-icon', name: 'check' -%}</span>
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>

              {%- comment -%} Step 3: volume, timing, list {%- endcomment -%}
              <fieldset class="alc-eg__step" data-step="3">
                <legend class="alc-eg__step-q" tabindex="-1">{{ t[74] }}</legend>
                <div class="alc-eg__chips">
                  {%- for v in volumes -%}
                    <label class="alc-eg__chip">
                      <input type="radio" name="contact[Volum]" value="{{ v }}">
                      <span class="alc-eg__mono">{{ v }} {{ t[13] }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                <p class="alc-eg__sub-q" id="AlcEgTime">{{ t[75] }}</p>
                <div class="alc-eg__chips" role="radiogroup" aria-labelledby="AlcEgTime">
                  {%- for tm in times_ro -%}
                    {%- assign tmi = forloop.index | plus: 75 -%}
                    <label class="alc-eg__chip">
                      <input type="radio" name="contact[Termen]" value="{{ tm }}">
                      <span>{{ t[tmi] }}</span>
                    </label>
                  {%- endfor -%}
                </div>
                <div class="alc-eg__field">
                  <label class="alc-eg__label" for="AlcEgQuoteForm-body">{{ t[80] }}</label>
                  <textarea
                    class="alc-eg__input alc-eg__textarea"
                    id="AlcEgQuoteForm-body"
                    name="contact[body]"
                    rows="4"
                    placeholder="{{ t[81] | escape }}"
                  >
                    {{- form.body -}}
                  </textarea>
                </div>
              </fieldset>

              {%- comment -%} Step 4: contact {%- endcomment -%}
              <fieldset class="alc-eg__step" data-step="4">
                <legend class="alc-eg__step-q" tabindex="-1">{{ t[61] }}</legend>
                {%- if form.errors -%}
                  <p class="alc-eg__alert" role="alert">{{ t[92] }}</p>
                {%- endif -%}
                <div class="alc-eg__grid">
                  <div class="alc-eg__field">
                    <label class="alc-eg__label" for="AlcEgQuoteForm-company">{{ t[82] }}</label>
                    <input class="alc-eg__input" type="text" id="AlcEgQuoteForm-company" name="contact[Firma]" autocomplete="organization">
                  </div>
                  <div class="alc-eg__field">
                    <label class="alc-eg__label" for="AlcEgQuoteForm-cui">{{ t[83] }}</label>
                    <input class="alc-eg__input" type="text" id="AlcEgQuoteForm-cui" name="contact[CUI]" autocomplete="off" autocapitalize="characters">
                  </div>
                  <div class="alc-eg__field">
                    <label class="alc-eg__label" for="AlcEgQuoteForm-name">{{ t[84] }}</label>
                    <input
                      class="alc-eg__input"
                      type="text"
                      id="AlcEgQuoteForm-name"
                      name="contact[name]"
                      autocomplete="name"
                      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    >
                  </div>
                  <div class="alc-eg__field">
                    <label class="alc-eg__label" for="AlcEgQuoteForm-phone">{{ t[86] }}</label>
                    <input
                      class="alc-eg__input"
                      type="tel"
                      id="AlcEgQuoteForm-phone"
                      name="contact[phone]"
                      autocomplete="tel"
                      inputmode="tel"
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer.phone %}{{ customer.phone }}{% endif %}"
                    >
                  </div>
                  <div class="alc-eg__field alc-eg__field--wide">
                    <label class="alc-eg__label" for="AlcEgQuoteForm-email">
                      {{- t[85] }} <span aria-hidden="true">*</span></label
                    >
                    <input
                      class="alc-eg__input"
                      type="email"
                      id="AlcEgQuoteForm-email"
                      name="contact[email]"
                      autocomplete="email"
                      spellcheck="false"
                      autocapitalize="off"
                      required
                      aria-required="true"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      {% if form.errors contains 'email' %}
                        aria-invalid="true"
                      {% endif %}
                    >
                  </div>
                </div>
                <p class="alc-eg__note"><span aria-hidden="true">*</span> {{ t[94] }} · {{ t[93] }}</p>
              </fieldset>

              <div class="alc-eg__nav">
                <button type="button" class="alc-eg__btn alc-eg__btn--ghost alc-eg__nav-back" data-back hidden>
                  {%- render 'alc-eg-icon', name: 'back' -%}
                  {{- t[87] -}}
                </button>
                <span class="alc-eg__nav-count alc-eg__mono" aria-live="polite"><span data-count>{{ start_step }}</span> / 4</span>
                <button type="button" class="alc-eg__btn alc-eg__btn--primary" data-next hidden>
                  {{- t[88] -}}
                  {%- render 'alc-eg-icon', name: 'arrow' -%}
                </button>
                <button type="submit" class="alc-eg__btn alc-eg__btn--primary" data-submit>
                  {{- t[89] -}}
                  {%- render 'alc-eg-icon', name: 'arrow' -%}
                </button>
              </div>
            </alc-eg-quote>
          {%- endif -%}
        {%- endform -%}
      </div>

      <p class="alc-eg__alt">
        {{ t[98] }}
        <a href="{{ wa_url }}" target="_blank" rel="noopener">
          {%- render 'alc-ds-icon', name: 'whatsapp' -%}
          {{- t[99] -}}
        </a>
      </p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "ALC wholesale orders",
  "tag": "section",
  "class": "section alc-eg-section",
  "settings": [
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number (international, digits only)", "default": "40725665925" },
    { "type": "image_picker", "id": "image", "label": "Image next to the benefits", "info": "Empty: showroom hall" },
    { "type": "header", "content": "Quote in the hero" },
    { "type": "product", "id": "quote_1", "label": "Line 1 (96 pcs)", "info": "Empty or sold out: first wall light available" },
    { "type": "product", "id": "quote_2", "label": "Line 2 (48 pcs)", "info": "Empty or sold out: first LED chandelier available" },
    { "type": "product", "id": "quote_3", "label": "Line 3 (48 pcs)", "info": "Empty or sold out: first LED mirror available" }
  ],
  "presets": [{ "name": "ALC wholesale orders" }]
}
{% endschema %}
