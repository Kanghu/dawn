    <script>
  (function() {
    let viewTracked = false;
    const trackView = function() {
      if (!viewTracked) {
        viewTracked = true;
        const img = new Image();
        img.src = 'https://help.alessandrodesign.ro/hc/alessandro-design/articles/1746014259-13-showroom-alessandro.png';
      }
    };

    const addTrackingListeners = function() {
      const events = ['mouseenter', 'touchstart', 'focus'];
      events.forEach(event => {
        document.body.addEventListener(event, function() {
          setTimeout(trackView, 5000);
        }, { once: true });
      });
    };
    addTrackingListeners();
  })();
</script>
