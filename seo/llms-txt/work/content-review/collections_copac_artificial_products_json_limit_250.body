ertilizare sau lumină solară.\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eÎși păstrează culoarea și forma pe termen lung.\u003cbr\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSoluție decorativă elegantă pentru orice tip de amenajare.\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eConținut pachet\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e1 × Palmier artificial, 170 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e1 × Ghiveci din plastic\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cstrong\u003eNotă:\u003c\/strong\u003e Pentru un aspect cât mai natural, frunzele pot fi modelate și aranjate după despachetare.\u003c\/p\u003e","published_at":"2026-07-08T16:03:39+03:00","created_at":"2026-07-08T15:36:11+03:00","updated_at":"2026-09-14T13:12:33+03:00","vendor":"Alessandro Design","product_type":"Plante Artificiale Interioare","tags":["active","All Stock","Plante artificiale","Plante Artificiale Interioare"],"variants":[{"id":53228353224971,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-PL1D-TS170","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"559.99","grams":0,"compare_at_price":"559.99","position":1,"product_id":10998603841803,"created_at":"2026-07-08T15:36:11+03:00","updated_at":"2026-09-14T13:12:33+03:00"}],"images":[{"id":69716910145803,"created_at":"2026-07-08T15:46:38+03:00","position":1,"updated_at":"2026-07-08T15:48:10+03:00","product_id":10998603841803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iul.2026_15_41_55.png?v=1783514890","width":1024,"height":1024},{"id":69716910276875,"created_at":"2026-07-08T15:46:41+03:00","position":2,"updated_at":"2026-07-08T16:00:00+03:00","product_id":10998603841803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iul.2026_15_41_55_