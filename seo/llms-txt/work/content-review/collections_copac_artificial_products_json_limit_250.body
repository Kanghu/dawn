amily:roboto,sans-serif; font-size:16px\"\u003e\u003cstrong\u003ePachetul de livrare nu include ghiveciul, de asemenea planta este livrata dezasamblată.\u003c\/strong\u003e\u003c\/span\u003e","published_at":"2025-02-25T01:01:48+02:00","created_at":"2025-02-25T01:01:47+02:00","updated_at":"2026-09-14T13:12:33+03:00","vendor":"Alessandro Design","product_type":"","tags":["active","Casă \u0026 Grădină","Delistat Alessandro","Plante artificiale","Plante Artificiale Interioare"],"variants":[{"id":52359907836171,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-SH1A-DRST-PA05\/90","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"104.00","grams":0,"compare_at_price":"104.00","position":1,"product_id":9759917834507,"created_at":"2025-09-12T13:11:17+03:00","updated_at":"2026-09-14T13:12:33+03:00"}],"images":[{"id":51839679365387,"created_at":"2025-02-25T01:01:49+02:00","position":1,"updated_at":"2025-02-25T01:01:51+02:00","product_id":9759917834507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/planta-artificiala-palmier-fara-ghiveci-90cm-verde-1684746511.webp?v=1740438111","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":11027069042955,"title":"Tablou Decorativ Banii Nu Cresc in Copaci, 60 x 80 cm, Aliaj de Aluminiu si MDF","handle":"tablou-sticla-banii-nu-cresc-in-copaci-60-x-80-cm-aliaj-de-aluminiu-si-mdf","body_html":"\u003cdiv\u003e\u003cdiv class=\"mx-auto flex flex-col pointer-events-auto max-w-threadContentWidth gap-4 md:gap-8\"\u003e\u003cdiv class=\"flex flex-col\"\u003e\u003cdiv class=\"flex flex-col gap-4\"\u003e\u003cdiv\u003e\u003cdiv class=\"flow-root\"\u003e\u003cdiv class=\"flex flex-col flex-1 min-w-0 gap-5\"\u003e\u003cdiv class=\"flex flex-col flex-1 min-w-0\"\u003e\u003cdiv class=\"flex flex-col flex-1 min-w-0 gap-4\"\u003e\u003cdiv class=\"flex flex-col flex-1 min-w-0 gap-4\"\u003e\u003cdiv\u003e\u003cdiv class=\"w-full\"\u003e\u003cdiv class=\"w-full flex flex-col\"\u003e\u003cdiv class=\"break-words min-w-0 flex-1\"\u003e\u003cdiv\u003e\u003cdiv class=\"prose dark:prose-invert inline leading-relaxed break-words min-w-0 [word-break:break-word] [\u0026amp;_\u0026gt;*:first-child]:mt-0 [\u0026amp;_\u0026gt;*:last-child]:mb-0\"\u003e\n\u003cp class=\"my-2 [\u0026amp;+p]:mt-4 [\u0026amp;_strong:has(+br)]:inline-block [\u0026amp;_strong:has(+br)]:align-top\"\u003eTabloul decorativ „Banii Nu Cresc în Copaci” este o piesă decorativă cu un design îndrăzneț, creată pentru interioare moderne și pline de personalitate. Compoziția inspirată de bani, trabucuri și stilul de viață urban este completată de mesajul „Money Doesn’t Grow on Trees”, oferind tabloului un caracter distinct și un impact vizual puternic.\u003c\/p\u003e\n\u003cp class=\"my-2 [\u0026amp;+p]:mt-4 [\u0026amp;_strong:has(+br)]:inline-block [\u0026amp;_strong:has(+br)]:align-top\"\u003eCu dimensiunile de 60 x 80 cm, acest tablou devine ușor un punct de atracție pe perete și se potrivește în living, birou, bar, zonă de relaxare, cafenea sau spații comerciale. Contrastul dintre fundalul închis și detaliile în tonuri calde creează un aspect elegant, potrivit pentru amenajări contemporane, industriale sau masculine.\u003c\/p\u003e\n\u003cp class=\"my-2 [\u0026amp;+p]:mt-4 [\u0026amp;_strong:has(+br)]:inline-block [\u0026amp;_strong:has(+br)]:align-top\"\u003eRealizat din aliaj de aluminiu și MDF, tabloul are un finisaj rafinat și o structură stabilă. Este o alegere inspirată pentru cei care doresc un decor original, cu o notă modernă și nonconformistă.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2026-08-26T15:56:56+03:00","created_