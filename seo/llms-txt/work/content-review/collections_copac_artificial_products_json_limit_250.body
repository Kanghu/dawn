ină solară.\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eÎși păstrează culoarea și forma pe termen lung.\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIdeal pentru living, dormitor, birou, recepție, hotel, restaurant sau showroom.\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSoluție decorativă elegantă pentru orice tip de amenajare.\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eConținut pachet\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e1 × Smochin artificial, 160 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e1 × Ghiveci din plastic\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cstrong\u003eNotă:\u003c\/strong\u003e Pentru un aspect cât mai natural, frunzele pot fi modelate și aranjate după despachetare.\u003c\/p\u003e","published_at":"2026-07-08T15:11:10+03:00","created_at":"2026-07-08T14:56:54+03:00","updated_at":"2026-09-14T13:12:33+03:00","vendor":"Alessandro Design","product_type":"Plante Artificiale Interioare","tags":["active","All Stock","Plante artificiale","Plante Artificiale Interioare"],"variants":[{"id":53228176245003,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-PL1D-QYR160","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"489.99","grams":0,"compare_at_price":"489.99","position":1,"product_id":10998549610763,"created_at":"2026-07-08T14:56:54+03:00","updated_at":"2026-09-14T13:12:33+03:00"}],"images":[{"id":69715609092363,"created_at":"2026-07-08T15:04:54+03:00","position":1,"updated_at":"2026-07-08T15:55:18+03:00","product_id":10998549610763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Decora_iune_Smochin_Plastic_3_brate_160_cm_Verde1.png?v=1783515318","width":1024,"height":1024},{"id":69715610075403,"created_at":"2026-07-08T15:05:04+03:00","position":2,"updated_at":"2026-07-08T15:55:30+03:00","product_id":10998549