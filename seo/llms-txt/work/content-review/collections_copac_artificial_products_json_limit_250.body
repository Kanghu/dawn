ung.\u003cbr\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSoluție decorativă elegantă pentru orice tip de amenajare.\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eConținut pachet\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e1 × Palmier artificial, 115 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e1 × Ghiveci din plastic\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cstrong\u003eNotă:\u003c\/strong\u003e Pentru un aspect cât mai natural, frunzele pot fi modelate și aranjate după despachetare.\u003c\/p\u003e","published_at":"2026-07-08T16:59:34+03:00","created_at":"2026-07-08T16:36:07+03:00","updated_at":"2026-09-14T13:12:33+03:00","vendor":"Alessandro Design","product_type":"Plante Artificiale Interioare","tags":["active","All Stock","Plante artificiale","Plante Artificiale Interioare"],"variants":[{"id":53228771737867,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-PL1D-TS36115","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"489.99","grams":0,"compare_at_price":"489.99","position":1,"product_id":10998798352651,"created_at":"2026-07-08T16:36:08+03:00","updated_at":"2026-09-14T13:12:33+03:00"}],"images":[{"id":69717585953035,"created_at":"2026-07-08T16:39:20+03:00","position":1,"updated_at":"2026-07-08T16:40:43+03:00","product_id":10998798352651,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iul.2026_16_39_06.png?v=1783518043","width":1024,"height":1024},{"id":69717593686283,"created_at":"2026-07-08T16:40:52+03:00","position":2,"updated_at":"2026-07-08T16:42:41+03:00","product_id":10998798352651,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iul.2026_16_39_06_381793ac-d97c-4193-bf68-dc9062116661.png?v=1783518161","width":1024,"height":1024},{"id":69717594669323,"created_at":"2026-07-08T1