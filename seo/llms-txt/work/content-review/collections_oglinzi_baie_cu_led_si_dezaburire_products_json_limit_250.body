.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_cee388dd-c9f0-4e3b-96ac-b71beef69cde.png?v=1754638442","width":1800,"height":1800},{"id":58856387051787,"created_at":"2025-08-08T10:25:24+03:00","position":7,"updated_at":"2025-08-08T10:34:02+03:00","product_id":9779343819019,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a6_56ec9dbc-9ba6-41bd-b79e-136569bc2806.png?v=1754638442","width":1800,"height":1800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779344113931,"title":"Oglinda LED Touch NIVERA Sistem Dezaburire, Ceas si Temperatura 60x80 cm Lupa Cosmetica","handle":"oglinda-led-touch-nivera-sistem-dezaburire-ceas-si-temperatura-60x80-cm-lupa-cosmetica","body_html":"\u003cp\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cstrong\u003eOglinda LED Touch NIVERA, 60 × 80 cm\u003c\/strong\u003e, îmbină un design dreptunghiular elegant cu funcții practice pentru rutina zilnică de îngrijire. Conturul luminos LED evidențiază liniile oglinzii și adaugă un accent modern băii tale.\u003cbr\u003e\u003cstrong\u003eControlul tactil\u003c\/strong\u003e permite pornirea și oprirea iluminării printr-o simplă atingere, iar \u003cstrong\u003esistemul de dezaburire integrat\u003c\/strong\u003e ajută la menținerea unei suprafețe clare după duș. Astfel, oglinda oferă confort în utilizare, inclusiv în condiții de umiditate ridicată.\u003cbr\u003eEchipată cu \u003cstrong\u003eceas și afișaj de temperatură\u003c\/strong\u003e, NIVERA îți permite să consulți rapid informațiile utile în timp ce te pregătești. \u003cstrong\u003eLupa cosmetică integrată\u003c\/strong\u003e oferă o imagine mărită pentru detalii, fiind practică pentru machiaj, pensat sau alte activități de îngrijire personală.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-3tipuri-lumina-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-ceas-termometru-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-01T00:16:08+03:00","created_at":"2025-03-06T18:42:17+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman S","tags":["active","Lupa Cosmetica","Oglinzi draft count"],"variants":[{"id":52414282531083,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-S85\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"369.99","grams":0,"compare_at_price":"479.99","position":1,"product_id":9779344113931,"created_at":"2025-09-26T08:40:35+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":59747025682699,"created_at":"2025-09-01T00:03:16+03:00","position":1,"updated_at":"2025-09-01T00:06:20+03:00","product_id":9779344113931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_794732a1-8d83-4ce9-bf2b-22539ecd5ce2.png?v=1756674380","width":2000,"height":2000},{"id":59747024109835,"created_at":"2025-09-01T00:03:15+03:00","position":2,"updated_at":"2025-09-01T00:06:20+03:00","product_id":9779344113931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_274bef9e-6d83-476f-b1db-c3486e1f1264.png?v=1756674380","width":2000,"height":2000},{"id":59747024797963,"created_at":"2025-09-01T00:03:16+03:00","position":3,"updated_at":"2025-09-01T00:06:20+03:00","product_id":9779344113931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_24de19b5-b57e-4c04-a4d1-c2eca8c3614a.png?v=1