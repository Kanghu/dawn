003e\u003cstrong data-start=\"0\" data-end=\"112\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"114\" data-end=\"355\"\u003eOglindă LED modernă cu \u003cem data-start=\"137\" data-end=\"152\"\u003econtrol touch\u003c\/em\u003e și iluminare reglabilă în trei temperaturi – caldă (3000K), neutră (4000K) și rece (6000K). Dimensiuni \u003cstrong data-start=\"256\" data-end=\"268\"\u003e50x80 cm\u003c\/strong\u003e și ramă premium \u003cstrong data-start=\"285\" data-end=\"302\"\u003eauriu Brushed\u003c\/strong\u003e pentru un aspect elegant în orice baie contemporană.\u003c\/p\u003e\u003cp data-start=\"114\" data-end=\"355\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"357\" data-end=\"382\"\u003eFuncționalitate avansată:\u003c\/p\u003e\u003cul data-start=\"383\" data-end=\"610\"\u003e\n\u003cli data-start=\"383\" data-end=\"412\"\u003e\u003cp data-start=\"385\" data-end=\"412\"\u003e\u003cstrong data-start=\"385\" data-end=\"412\"\u003eControl tactil intuitiv\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"413\" data-end=\"491\"\u003e\u003cp data-start=\"415\" data-end=\"491\"\u003e\u003cstrong data-start=\"415\" data-end=\"439\"\u003eSistem de dezaburire\u003c\/strong\u003e integrat pentru oglindă clară atunci când ai nevoie\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"492\" data-end=\"532\"\u003e\u003cp data-start=\"494\" data-end=\"532\"\u003e\u003cstrong data-start=\"494\" data-end=\"532\"\u003eCeas digital și afișaj temperatură\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"533\" data-end=\"610\"\u003e\u003cp data-start=\"535\" data-end=\"610\"\u003e\u003cstrong data-start=\"535\" data-end=\"563\"\u003eIluminare LED triplu ton\u003c\/strong\u003e pentru adaptare la stilul și nevoile spațiului\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-3tipuri-lumina-oglinda.jpg?v=1744028987\"\u003e\u003c\/p\u003e\u003cp data-start=\"612\" data-end=\"774\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eDesign rafinat, funcții practice și iluminare personalizabilă.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-ceas-termometru-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-12-17T06:44:41+02:00","created_at":"2025-03-06T18:42:29+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman S","tags":["active","oglinda led","Oglinzi draft count"],"variants":[{"id":52428436439307,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-S25\/50X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"439.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":9779344441611,"created_at":"2025-09-30T13:57:16+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69695861948683,"created_at":"2026-07-04T17:44:15+03:00","position":1,"updated_at":"2026-07-04T17:44:18+03:00","product_id":9779344441611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_a95cfdc7-896f-47cb-8fcc-ae3590b7b723.webp?v=1783176258","width":800,"height":800},{"id":63496582005003,"created_at":"2025-12-16T15:20:01+02:00","position":2,"updated_at":"2026-01-08T11:16:39+02:00","product_id":9779344441611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_98a4a035-7188-4e5c-bf3c-32a1082e12de.png?v=1767863799","width":2400,"height":2400},{"id":63496581775627,"