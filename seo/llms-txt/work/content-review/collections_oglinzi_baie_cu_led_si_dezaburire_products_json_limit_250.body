lt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:256\"\u003eOglinda LED rotundă Touch VIVO este o piesă de iluminat modernă și elegantă, cu un diametru de 50 cm.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:256\"\u003eControlul 'Touch' indică faptul că pornirea\/oprirea luminii și posibil alte funcții (cum ar fi intensitatea luminii, dacă este dimabilă) se realizează prin atingerea unei zone specifice pe oglindă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:141\"\u003eAceastă oglindă ar fi potrivită pentru baie, dormitor sau orice alt spațiu unde dorești o oglindă cu iluminare integrată și un aspect modern.\u003c\/p\u003e","published_at":"2025-09-22T17:48:22+03:00","created_at":"2025-09-18T09:33:39+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","BF2025","ETA 15.Oct"],"variants":[{"id":52429938360587,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E17S\/50X50","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10726995329291,"created_at":"2025-09-30T17:56:55+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":59826088411403,"created_at":"2025-09-03T10:28:46+03:00","position":1,"updated_at":"2025-09-18T09:34:02+03:00","product_id":10726995329291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_f54faae2-aa41-4aa3-943a-8b3b26619c12.png?v=1758177242","width":2400,"height":2400},{"id":59826088378635,"created_at":"2025-09-03T10:28:46+03:00","position":2,"updated_at":"2025-09-22T15:41:11+03:00","product_id":10726995329291,"variant_