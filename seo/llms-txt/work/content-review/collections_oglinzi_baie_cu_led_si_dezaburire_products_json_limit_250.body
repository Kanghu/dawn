ues":["Default Title"]}]},{"id":9760545440011,"title":"Oglinda LED Rentagulara, 60x80cm, Touch Vivido , Sistem Dezaburire,Dimabila","handle":"oglinda-led-rentagulara-60x80cm-touch-vivido-sistem-dezaburiredimabila","body_html":"\u003cp data-start=\"197\" data-end=\"497\" class=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003eRedefinește rutina zilnică cu oglinda LED Vivido – un mix perfect între tehnologie modernă și design rafinat. Cu dimensiuni de 60x80 cm, această oglindă se remarcă prin iluminarea LED puternică și \u003cstrong data-start=\"394\" data-end=\"419\"\u003efuncția de dezaburire\u003c\/strong\u003e, care menține suprafața mereu clară, chiar și după cele mai fierbinți dușuri.\u003c\/p\u003e\u003cp data-start=\"499\" data-end=\"796\" class=\"\"\u003eSistemul \u003cstrong data-start=\"508\" data-end=\"517\"\u003eTouch\u003c\/strong\u003e îți permite să controlezi totul simplu, printr-o atingere discretă: de la pornirea luminii la reglarea intensității pentru a crea exact atmosfera dorită. Cu un format vertical și un aspect elegant, Vivido este alegerea ideală pentru băile moderne, unde fiecare detaliu contează.\u003c\/p\u003e\u003cp data-start=\"798\" data-end=\"823\" class=\"\"\u003e\u003cstrong data-start=\"798\" data-end=\"823\"\u003eCaracteristici cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-start=\"824\" data-end=\"1059\"\u003e\n\u003cli data-start=\"824\" data-end=\"858\" class=\"\"\u003e\u003cp data-start=\"826\" data-end=\"858\" class=\"\"\u003eDimensiuni: 60 x 80 cm (L x H)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"859\" data-end=\"898\" class=\"\"\u003e\u003cp data-start=\"861\" data-end=\"898\" class=\"\"\u003eIluminare LED uniformă și eficientă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"899\" data-end=\"934\" class=\"\"\u003e\u003cp data-start=\"901\" data-end=\"934\" class=\"\"\u003eFuncție de dezaburire integrată\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"935\" data-end=\"964\" class=\"\"\u003e\u003cp data-start=\"937\" data-end=\"964\" class=\"\"\u003eComandă prin senzor Touch\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"965\" data-end=\"1010\" class=\"\"\u003e\u003cp data-start=\"967\" data-end=\"1010\" class=\"\"\u003eDesign modern, potrivit pentru orice baie\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1011\" data-end=\"1059\" class=\"\"\u003e\u003cp data-start=\"1013\" data-end=\"1059\" class=\"\"\u003eInclude oglinda și accesoriile pentru montaj.\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-02-25T02:44:38+02:00","created_at":"2025-02-25T02:44:37+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52423803666699,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E27S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9760545440011,"created_at":"2025-09-29T11:16:26+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55593172402443,"created_at":"2025-05-20T11:24:06+03:00","position":1,"updated_at":"2026-07-14T11:23:31+03:00","product_id":9760545440011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rentagulara_60x80cm_Touch_Vivido_Sistem_Dezaburire_Dimabila_1.png?v=1784017411","width":1500,"height":1500},{"id":55593172304139,"created_at":"2025-05-20T11:24:06+03:00","position":2,"updated_at":"2026-07-14T11:23:41+03:00","product_id":9760545440011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\