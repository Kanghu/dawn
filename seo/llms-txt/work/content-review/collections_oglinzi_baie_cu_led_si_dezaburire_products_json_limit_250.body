757071766","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760298107147,"title":"Oglinda LED Rotunda, 70cm, VIVO Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-70cm-vivo-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:256\"\u003eOglinda LED rotundă Touch VIVO este o piesă de iluminat modernă și elegantă, cu un diametru de 70 cm.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:256\"\u003eControlul 'Touch' indică faptul că pornirea\/oprirea luminii și posibil alte funcții (cum ar fi intensitatea luminii, dacă este dimabilă) se realizează prin atingerea unei zone specifice pe oglindă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:141\"\u003eAceastă oglindă ar fi potrivită pentru baie, dormitor sau orice alt spațiu unde dorești o oglindă cu iluminare integrată și un aspect modern.\u003c\/p\u003e","published_at":"2025-02-25T02:12:22+02:00","created_at":"2025-02-25T02:12:22+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","BF2025"],"variants":[{"id":52411963638027,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E17S\/70X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.97","grams":0,"compare_at_price":"439.99","position":1,"product_id":9760298107147,"created_at":"2025-09-25T15:29:29+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":59826088476939,"created_at":"2025-09-03T10:28:47+03:00","position":1,"updated_at":"2025-09-22T15:41:11+03:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_75dd6595-4a74-4ddc-b729-e1daec50d48a.png?v=1758544871","width":2664,"height":2664},{"id":59826088378635,"created_at":"2025-09-03T10:28:46+03:00","position":2,"updated_at":"2025-09-22T15:41:11+03:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_b6751cb9-7d9b-42ec-913d-3f92af2ed991.png?v=1758544871","width":2400,"height":2400},{"id":59826088444171,"created_at":"2025-09-03T10:28:46+03:00","position":3,"updated_at":"2025-09-22T15:41:11+03:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_42e6ffa1-c208-4a5f-9aec-cfe4cb894078.png?v=1758544871","width":3000,"height":3000},{"id":59826088411403,"created_at":"2025-09-03T10:28:46+03:00","position":4,"updated_at":"2025-09-18T09:34:02+03:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_f54faae2-aa41-4aa3-943a-8b3b26619c12.png?v=1758177242","width":2400,"height":2400},{"id":59826088345867,"created_at":"2025-09-03T10:28:46+03:00","position":5,"updated_at":"2025-09-03T10:29:39+03:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_e7420b0c-7e54-4d47-a884-09736f250206.png?v=1756884579","width":2400,"height":2400},{"id":63977655042315,"created_at":"2025-12-30T16:51:55+02:00","position":6,"updated_at":"2025-12-30T16:51:59+02:00","product_id":9760298107147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E17S_70X70_EPREL.png?v=1767106319","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760300957963,"title":"Oglinda LED Touch ASTRIX, 70cm, 6000K, Dimabila, Sistem Dezaburire","handle":"oglinda-led-touch-astrix-70cm-dimabil-sistem-dezaburire","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/BUTON.png?v=1752151714\" style=\"height: auto; margin-bottom: 10px; width: auto;\"\u003e \u003cimg alt=\"\"\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eOglinda LED Touch Astrix din Colectia Korman Technik este o alegere excelentă pentru cei care caută să adauge un element modern și funcțional în baia lor. Cu forma sa rotundă și un diametru de 70 cm, această oglindă elegantă se distinge prin designul său geometric distinct, adăugând un plus de stil și sofisticare în orice baie.\u003cbr\u003e\u003cbr\u003eEchipată cu tehnologie LED touch, Oglinda Astrix permite controlul facil al iluminării cu o simplă atingere, oferind o experiență de utilizare confortabilă și eficientă. Această caracteristică face din oglindă o opțiune ideală pentru activități precum machiajul, bărbieritul sau orice alte rutine de îngrijire personală, necesitând o iluminare adecvată. Designul geometric al Oglinzii Astrix aduce un aspect contemporan și arhitectural, transformându-o într-un punct focal deosebit în decorul băii. Fie că este amplasată deasupra chiuvetei sau ca o piesă decorativă independentă, această oglindă adaugă o notă de eleganță modernă și un efect vizual impresionant.\u003cbr\u003e\u003cbr\u003eDimensiunile generoase ale oglinzii asigură o vizibilitate excelentă și o distribuție uniformă a luminii, făcându-o perfectă pentru băile de orice dimensiune. Ușor de montat și întreținut, Oglinda Astrix este o adăugare valoroasă și durabilă în baia dvs.\u003cbr\u003e\u003cbr\u003eAlegeți Oglinda LED Touch Astrix pentru a îmbunătăți estetica și funcționalitatea băii dvs., beneficiind de un design modern, tehnologie avansată și o iluminare de calitate superioară. Este soluția ideală pentru cei care doresc să adauge un strop de eleganță contemporană și eficiență în spațiul lor personal.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T02:12:43+02:00","created_at":"2025-02-25T02:12:42+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52409719324939,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E41S\/70X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.97","grams":0,"compare_at_price":"439.99","position":1,"product_id":9760300957963,"created_at":"2025-09-24T21:23:17+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659442675979,"created_at":"2026-07-03T15:59:54+03:00","position":1,"updated_at":"2026-07-03T15:59:57+03:00","product_id":9760300957963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_d9f6fe60-14c1-47fd-95a3-4043d110cb7b.webp?v=1783083597","width":800,"height":800},{"id":59869402890507,"created_at":"2025-09-04T23:31:45+03:00","position":2,"updated_at":"2025-10-22T23:31:11+03:00","product_id":9760300957963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_32003f0d-3126-43e5-b513-d07e628a71da.png?v=1761165071","width":1500,"height":1500},{"id":51846821675275,"created_at":"2025-02-25T02:12:45+02:00","position":3,"updated_at":"2025-09-22T16:47:14+03:00","product_id":9760300957963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-astrix-70x70-cm-colectia-korman-technik-1716194363.webp?v=1758548834","width":900,"height":900},{"id":59869395714315,"created_at":"2025-09-04T23:30:42+03:00","position":4,"updated_at":"2025-10-22T23:31:11+03:00","product_id":9760300957963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_b47e3d49-a606-47b8