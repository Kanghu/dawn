4020308\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"231\" data-end=\"534\" class=\"\"\u003eInsideus Touch este oglinda ideală pentru spații moderne în care funcționalitatea se îmbină cu un design discret și elegant. Cu dimensiuni compacte de 45x60cm, iluminare LED dimabilă și sistem de dezaburire integrat, această oglindă oferă confort și vizibilitate excelente, indiferent de momentul zilei.\u003c\/p\u003e\u003cp data-start=\"536\" data-end=\"995\" class=\"\"\u003e✔ \u003cstrong data-start=\"538\" data-end=\"560\"\u003eDimensiuni 45x60cm\u003c\/strong\u003e – format eficient, potrivit pentru băi de orice dimensiune.\u003cbr data-start=\"620\" data-end=\"623\"\u003e✔ \u003cstrong data-start=\"625\" data-end=\"651\"\u003eIluminare LED dimabilă\u003c\/strong\u003e – reglezi lumina exact cum ai nevoie, fie pentru machiaj, fie pentru relaxare.\u003cbr data-start=\"730\" data-end=\"733\"\u003e✔ \u003cstrong data-start=\"735\" data-end=\"768\"\u003eSistem de dezaburire integrat\u003c\/strong\u003e – oglinda rămâne clară chiar și în cele mai umede condiții.\u003cbr data-start=\"828\" data-end=\"831\"\u003e✔ \u003cstrong data-start=\"833\" data-end=\"859\"\u003eControl tactil (Touch)\u003c\/strong\u003e – activare ușoară, printr-o simplă atingere.\u003c\/p\u003e","published_at":"2025-08-30T12:32:09+03:00","created_at":"2025-08-29T10:28:45+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","BF2025","Ciresar 25"],"variants":[{"id":52411466514699,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E09S\/45X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":10686369693963,"created_at":"2025-09-25T12:33:36+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":56792957976843,"created_at":"2025-06-26T17:51:46+03:00","position":1,"updated_at":"2026-07-08T10:07:36+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_2.png?v=1783494456","width":2000,"height":2000},{"id":56792939888907,"created_at":"2025-06-26T17:50:56+03:00","position":2,"updated_at":"2026-07-08T10:07:46+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_3.png?v=1783494466","width":2000,"height":2000},{"id":56792940019979,"created_at":"2025-06-26T17:50:56+03:00","position":3,"updated_at":"2026-07-08T10:07:56+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_4.png?v=1783494476","width":2500,"height":2500},{"id":56792939757835,"created_at":"2025-06-26T17:50:56+03:00","position":4,"updated_at":"2026-07-08T10:07:22+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_1.png?v=1783494442","width":2000,"height":2000},{"id":69755580121355,"created_at":"2026-07-13T16:39:14+03:00","position":5,"updated_at":"2026-07-13T16:39:51+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_45x60cm_RADIANTE_Touch_Sistem_Dezaburire_Dimabila_5.png?v=1783949991","width":1254,"height":1254},{"id":69755538800907,"created_at":"2026-07-13T16:30:28+03:00","position":6,"updated_at":"2026-07-13T16:40:01+03:00","product_id":10686369693963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_45x60cm_RADIANTE_Touch_Sistem_Dezaburire_Dimabila_6.png?v=1783950001","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10691566174475,"title":"Oglinda LED Rotunda, 80cm, Glanz Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-80cm-glanz-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003eOglinda LED Touch Glanz din Colectia Korman Technik este o alegere excelentă pentru cei care doresc să adauge un strop de eleganță și rafinament în decorul lor interior. Cu un diametru generos de 70 cm, această oglindă rotundă impresionează prin rama sa aurie și designul simplu, dar sofisticat, fiind perfectă pentru orice baie, hol sau dressing care necesită un plus de stil.\u003cbr\u003e\u003cbr\u003eDotată cu un sistem de dezaburire avansat, Oglinda Glanz asigură o claritate perfectă chiar și în cele mai umede condiții, eliminând inconvenientul aburului acumulat după dușuri sau băi fierbinți. Această caracteristică face oglinda extrem de practică și indispensabilă în rutina zilnică de îngrijire personală. Designul său elegant și simplu, îmbogățit cu o ramă aurie, adaugă o notă de lux și sofisticare, transformând oglinda într-o piesă centrală atrăgătoare în orice spațiu. Lumina rece LED oferită de oglindă furnizează o iluminare clară și răcoroasă, ideală pentru activități de îngrijire sau ca element decorativ.\u003cbr\u003e\u003cbr\u003eAlegerea Oglinzii LED Touch Glanz din Colectia Korman Technik reprezintă o investiție într-un mix de estetică contemporană, tehnologie de ultimă oră și funcționalitate superioară. Este soluția perfectă pentru cei care doresc să combine designul modern cu funcționalități tehnologice avansate, creând un spațiu elegant și eficient în locuința lor.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-09-02T16:56:42+03:00","created_at":"2025-09-01T17:37:27+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52428703760651,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E04S\/80X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"539.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10691566174475,"created_at":"2025-09-30T15:06:24+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":51851065360651,"created_at":"2025-02-25T02:45:10+02:00","position":1,"updated_at":"2026-07-14T10:49:33+03:00","product_id":10691566174475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_50cm_Glanz_Touch_Sistem_Dezaburire_Dimabila_5.webp?v=1784015373","width":1024,"height":1024},{"id":51851064049931,"created_at":"2025-02-25T02:45:10+02:00","position":2,"updated_at":"2026-07-14T10:48:52+03:00","product_id":10691566174475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_50cm_Glanz_Touch_Sistem_Dezaburire_Dimabila_2.webp?v=1784015332","width":1024,"height":1024},{"id":51851064869131,"created_at":"2025-02-25T02:45:10+02:00","position":3,"updated_at":"2026-07-14T10:49:15+03:00","product_id":10691566174475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_50cm_Gl