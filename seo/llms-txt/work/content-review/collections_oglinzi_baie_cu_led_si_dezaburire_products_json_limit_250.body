ate functiile sunt controlate printr-o interfata tactila simpla.\u003cmeta charset=\"utf-8\"\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli data-sourcepos=\"11:1-11:73\"\u003e\n\u003cstrong\u003eForma Inedita:\u003c\/strong\u003e Design in forma de nor, pentru un aspect distinctiv.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:65\"\u003e\n\u003cstrong\u003eIluminare LED:\u003c\/strong\u003e Lumina integrata pentru vizibilitate optima.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-13:57\"\u003e\n\u003cstrong\u003eSistem Anti-Condens:\u003c\/strong\u003e Sistem de dezaburire eficient.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:61\"\u003e\n\u003cstrong\u003eReglare Lumina:\u003c\/strong\u003e Functie dimabila pentru confort vizual.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:62\"\u003e\n\u003cstrong\u003eControl Intuitiv:\u003c\/strong\u003e Interfata touch pentru operare facila.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-04-07T12:26:29+03:00","created_at":"2025-04-07T11:17:33+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","Ciresar 25"],"variants":[{"id":52375355883787,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E55S\/60X40","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"379.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10120476918027,"created_at":"2025-09-16T15:02:01+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":52974360330507,"created_at":"2025-04-07T14:20:26+03:00","position":1,"updated_at":"2025-04-07T14:20:38+03:00","product_id":10120476918027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_3f9b1d11-b5b9-4a84-a74a-973225369b27.png?v=1744024838","width":2000,"height":2000},{"id":52973587759371,"created_at":"2025-04-07T14:02:21+03:00","position":2,"updated_at":"2025-04-07T14:20:38+03:00","product_id":10120476918027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_510ef2d5-57bd-4227-96e4-bc98430776fa.png?v=1744024838","width":2000,"height":2000},{"id":52973588447499,"created_at":"2025-04-07T14:02:21+03:00","position":3,"updated_at":"2025-04-07T14:20:38+03:00","product_id":10120476918027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_37a92085-2617-4cfd-bda4-af84d019ac1e.png?v=1744024838","width":2000,"height":2000},{"id":52973588119819,"created_at":"2025-04-07T14:02:21+03:00","position":4,"updated_at":"2025-04-07T14:20:38+03:00","product_id":10120476918027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_846f7ee2-60b4-49bf-9be9-cbd3eb6ab62d.png?v=1744024838","width":2000,"height":2000},{"id":69725239607563,"created_at":"2026-07-10T10:20:18+03:00","position":5,"updated_at":"2026-07-10T10:20:20+03:00","product_id":10120476918027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2747282_big_color.png?v=1783668020","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10550644539659,"title":"Oglinda LED Rectangulara, 50x70cm, EDGE Touch, Sistem Dezaburire, Rama Neagra","handle":"oglinda-led-rectangulara-50x70cm-edge-touch-sistem-dezaburire-rama-neagra","body_html":"\u003cdiv\u003e\n\u003cimg style=\"height: auto; width: auto;\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg.webp?v=1744020565\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"5:1-5:232\"\u003eTaglio Touch. Cu dimensiunile sale de 50x70 cm și o ramă neagră distinctivă, adaugă un accent contemporan și o iluminare eficientă oricărei băi.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:39\"\u003e\u003cstrong\u003eDesign Minimalist și Impact Vizual:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:219\"\u003eForma rectangulară clasică, încadrată de o ramă neagră, conferă oglinzii un aspect modern și versatil, integrându-se armonios în diverse stiluri de decor. Dimensiunile sale o fac ideală pentru băi de dimensiuni variate.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:42\"\u003e\u003cstrong\u003eTehnologie Inteligentă pentru Confort:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-15:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:189\"\u003e\n\u003cstrong\u003eSistem Anti-Aburire Integrat:\u003c\/strong\u003e Beneficiază de o vizibilitate perfectă chiar și după dușuri fierbinți, datorită sistemului de dezaburire care elimină condensul de pe suprafața oglinzii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eControl Tactil Intuitiv (Touch):\u003c\/strong\u003e Activează și dezactivează iluminarea LED cu o simplă atingere a senzorului tactil, oferind o operare facilă și modernă..\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"16:1-16:40\"\u003e.\u003c\/p\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-06-30T17:15:16+03:00","created_at":"2025-06-30T17:15:16+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52414353146123,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E03S\/50X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":10550644539659,"created_at":"2025-09-26T09:39:59+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55946575511819,"creat