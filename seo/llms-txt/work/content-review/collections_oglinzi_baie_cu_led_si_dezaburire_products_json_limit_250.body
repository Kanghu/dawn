/3739\/files\/a3_53f4c41f-ac7e-4efd-8f8a-4689f142ec07_3.png?v=1767863693","width":3000,"height":3000},{"id":60427487543563,"created_at":"2025-09-18T11:01:50+03:00","position":8,"updated_at":"2026-01-08T11:14:53+02:00","product_id":10852606804235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4.2_99364904-b3e1-4695-bcf4-4f3e0ba62dde.png?v=1767863693","width":3000,"height":3000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10121310011659,"title":"Oglinda LED Rotunda, 70cm, Orbis Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-70cm-orbis-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e \u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp class=\"\" data-end=\"477\" data-start=\"231\"\u003eCu un diametru de 70 cm, oglinda LED Orbis combină funcționalitatea modernă cu un aspect rafinat. Dotată cu iluminare LED dimabilă și sistem de dezaburire, oferă confort și vizibilitate impecabilă în orice moment, chiar și după un duș fierbinte.\u003c\/p\u003e\n\u003cp class=\"\" data-end=\"773\" data-start=\"479\"\u003eControlul se face simplu și intuitiv printr-un \u003cstrong data-end=\"542\" data-start=\"526\"\u003esenzor Touch\u003c\/strong\u003e, care permite ajustarea intensității luminii în funcție de preferințe. Forma rotundă și finisajul curat transformă această oglindă într-un element central al băii, adaptabil atât în spații contemporane, cât și în cele minimaliste.\u003c\/p\u003e\n\u003cp class=\"\" data-end=\"803\" data-start=\"775\"\u003e\u003cstrong data-end=\"803\" data-start=\"775\"\u003eSpecificații principale:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-end=\"1002\" data-start=\"804\"\u003e\n\u003cli class=\"\" data-end=\"823\" data-start=\"804\"\u003e\u003cp class=\"\" data-end=\"823\" data-start=\"806\"\u003eDiametru: 70 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"862\" data-start=\"824\"\u003e\u003cp class=\"\" data-end=\"862\" data-start=\"826\"\u003eIluminare LED reglabilă (dimabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"888\" data-start=\"863\"\u003e\u003cp class=\"\" data-end=\"888\" data-start=\"865\"\u003eFuncție de dezaburire\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"912\" data-start=\"889\"\u003e\u003cp class=\"\" data-end=\"912\" data-start=\"891\"\u003eActivare prin Touch\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"933\" data-start=\"913\"\u003e\u003cp class=\"\" data-end=\"933\" data-start=\"915\"\u003eMaterial: sticlă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"982\" data-start=\"934\"\u003e\u003cp class=\"\" data-end=\"982\" data-start=\"936\"\u003eInclude oglinda și accesoriile pentru montaj\u003c\/p\u003e\u003c\/li\u003e\n\u003cli class=\"\" data-end=\"1002\" data-start=\"983\"\u003e\u003cp class=\"\" data-end=\"1002\" data-start=\"985\"\u003eUtilizare: baie\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003e \u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-04-08T11:37:34+03:00","created_at":"2025-04-07T20:01:00+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52411348943115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E31S\/70X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":10121310011659,"created_at":"2025-09-25T11:43:36+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":63508549370123,"created_at":"2025-12-16T22:04:36+02:00","position":1,"updated_at":"2025-12-16T22:14:00+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_16_2025_10_04_15_PM.png?v=1765916040","width":1024,"height":1024},{"id":55278750400779,"created_at":"2025-05-09T13:05:26+03:00","position":2,"updated_at":"2025-12-16T22:16:11+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_eefad8d4-2f64-42e1-9d57-95795e01ba6f.png?v=1765916171","width":2000,"height":2000},{"id":55278750531851,"created_at":"2025-05-09T13:05:26+03:00","position":3,"updated_at":"2025-12-16T22:16:11+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_e82d39d3-9f11-48b2-93c0-935a5f404d18.png?v=1765916171","width":2000,"height":2000},{"id":55278750499083,"created_at":"2025-05-09T13:05:26+03:00","position":4,"updated_at":"2025-12-16T22:16:11+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_eacf34af-773d-4a1c-845a-42234b939bbe.png?v=1765916171","width":2000,"height":2000},{"id":55278750433547,"created_at":"2025-05-09T13:05:26+03:00","position":5,"updated_at":"2025-12-16T22:16:11+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_27b3002e-e958-4ab7-ad13-81156f9dfb68.png?v=1765916171","width":2000,"height":2000},{"id":64131161587979,"created_at":"2026-01-05T15:44:36+02:00","position":6,"updated_at":"2026-01-05T15:44:39+02:00","product_id":10121310011659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E31S_70X70_EPREL.png?v=1767620679","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10138360873227,"title":"Oglinda LED Rotunda, 70cm, Noxia Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-70cm-noxia-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"217\" data-end=\"598\" class=\"\"\u003eCu un design circular curat și echilibrat, oglinda LED Noxia adaugă profunzime și stil oricărui spațiu. Diametrul de 70cm o face perfectă atât pentru băi elegante, cât și pentru colțuri de beauty cu personalitate. Iluminarea LED dimabilă permite reglarea intensității luminii în funcție de momentul zilei, iar activarea prin control tactil asigură o experiență fluidă și intuitivă.\u003c\/p\u003e\u003cp data-start=\"600\" data-end=\"732\" class=\"\"\u003eSistemul de dezaburire integrat păstrează suprafața mereu clară, indiferent de umiditate – ideal pentru utilizare imediată după duș.\u003c\/p\u003e","published_at":"2025-04-29T14:58:05+03:00","created_at":"2025-04-16T15:42:51+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52428330107147,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E12S\/70X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10138360873227,"created_at":"2025-09-30T13:36:17+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":60810375987467,"created_at":"2025-09-30T13:31:31+03:00","position":1,"updated_at":"2025-09-30T13:32:34+03:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_82970c9d-0f89-4c8b-86be-a154e306b144.png?v=1759228354","width":2000,"height":2000},{"id":60810375823627,"created_at":"2025-09-30T13:31:30+03:00","position":2,"updated_at":"2025-09-30T13:32:34+03:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_b3ea86b9-43ae-46d8-aab6-cc9effba975a.png?v=1759228354","width":2250,"height":2250},{"id":60810376085771,"created_at":"2025-09-30T13:31:31+03:00","position":3,"updated_at":"2025-09-30T13:32:34+03:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_9216e516-b12e-457c-9d17-98e504a6f6f6.png?v=1759228354","width":2250,"height":2250},{"id":60810375856395,"created_at":"2025-09-30T13:31:31+03:00","position":4,"updated_at":"2025-09-30T13:32:34+03:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_8e492756-fba2-4f7f-919e-e8c7e71a619e.png?v=1759228354","width":2000,"height":2000},{"id":60810376118539,"created_at":"2025-09-30T13:31:32+03:00","position":5,"updated_at":"2025-09-30T13:32:34+03:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_43a6d1f2-0d3d-46e3-a91b-ace0532e2de7.png?v=1759228354","width":2250,"height":2250},{"id":64309298495755,"created_at":"2026-01-12T13:00:23+02:00","position":6,"updated_at":"2026-01-12T13:00:33+02:00","product_id":10138360873227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E12S_70X70_EPREL.png?v=1768215633","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10730413687051,"title":"Oglinda LED Rectangulara, 60x80cm, KOVEN Touch, Lumina Rece, Sistem Dezaburire,Dimabila","handle":"oglinda-led-rectangulara-60x80cm-koven-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"a29d4ed611250880\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c130506317-43 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c130506317-43\"\u003e\u003cdiv class=\"response-container-content ng-tns-c130506317-43\"\u003e\u003cdiv class=\"response-content ng-tns-c130506317-43\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_a29d4ed611250880\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:365\"\u003eOglinda LED Rectangulară Koven Touch, cu dimensiunile de 60x80 cm, îmbină eleganța unui design simplu cu funcționalități moderne pentru a-ți îmbunătăți rutina zilnică. Forma sa dreptunghiulară, cu proporții echilibrate, se potrivește armonios în diverse stiluri de amenajare interioară, fiind ideală pentru baie, dar putând fi integrată cu succes și în alte spații.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:308\"\u003eUn aspect esențial al acestei oglinzi este \u003cstrong\u003esistemul de dezaburire integrat\u003c\/strong\u003e. Această caracteristică elimină problema condensului care se formează pe suprafața oglinzii în timpul sau după utilizarea apei calde, asigurând o imagine clară și neobstrucționată. Nu vei mai pierde timp ștergând oglinda aburită!\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:251\"\u003e\u003cstrong\u003eIluminarea LED\u003c\/strong\u003e integrată oferă o lumină clară și uniformă, perfectă pentru activități precum machiajul, bărbieritul sau îngrijirea personală. Tehnologia LED este, de asemenea, eficientă din punct de vedere energetic și are o durată de viață lungă.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:233\"\u003eDenumirea 'Touch' sugerează prezența unui \u003cstrong\u003esenzor tactil\u003c\/strong\u003e pentru a controla iluminarea. Acest lucru înseamnă că poți porni sau opri lumina cu o simplă atingere a suprafeței oglinzii, adăugând un plus de confort și un aspect modern.\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:254\"\u003eÎn concluzie, Oglinda LED Rectangulară Koven Touch este o alegere excelentă dacă dorești o oglindă practică, cu funcții moderne esențiale precum sistemul de dezaburire și iluminarea LED controlată tactil, toate integrate într-un design simplu și elegant.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv class=\"container hidden ng-star-inserted\"\u003e\u003cbr\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-10-22T22:03:59+03:00","created_at":"2025-09-22T15:42:51+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","iulie_26","Summer_start"],"variants":[{"id":52429937180939,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E37S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10730413687051,"created_at":"2025-09-30T17:56:48+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55281733468427,"created_at":"2025-05-09T14:57:36+03:00","position":1,"updated_at":"2025-11-12T00:33:24+02:00","product_id":10730413687051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_71c4e260-24ee-4ae7-9219-2027cd07cc81.png?v=1762900404","width":2000,"height":2000},{"id":55281733501195,"created_at":"2025-05-09T14:57:36+03:00","position":2,"updated_at":"2025-11-12T00:33:24+02:00","product_id":10730413687051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_b380d353-83c6-4373-8e14-3d1cce73d1b7.png?v=1762900404","width":2000,"height":2000},{"id":55281840816395,"created_at":"2025-05-09T15:06:03+03:00","position":3,"updated_at":"2025-11-12T00:33:24+02:00","product_id":10730413687051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_6a4d5233-4637-4e0d-9a61-54a788f8a41c.png?v=1762900404","width":1214,"height":1214},{"id":55281733435659,"created_at":"2025-05-09T14:57:36+03:00","position":4,"updated_at":"2025-11-12T00:33:24+02:00","product_id":10730413687051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_6bb91098-2e88-48d0-9773-d1b74ed4c0e9.png?v=1762900404","width":2000,"height":2000},{"id":55281864802571,"created_at":"2025-05-09T15:07:56+03:00","position":5,"updated_at":"2025-09-22T15:43:16+03:00","product_id":10730413687051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_1d23df71-2817-4e0d-8ee7-305cc4d49bbe.png?v=1758544996","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760576307467,"title":"Oglinda LED Ovala, 60x80cm, Velara Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-ovala-60x80cm-velara-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e25 000 de ore\u003c\/strong\u003e de functionare! Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003cp\u003eIn ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2025-02-25T02:53:25+02:00","created_at":"2025-02-25T02:53:24+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52428747899147,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E06S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"479.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":9760576307467,"created_at":"2025-09-30T15:27:32+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55769274089739,"created_at":"2025-05-26T15:28:21+03:00","position":1,"updated_at":"2026-07-08T11:26:52+03:00","product_id":9760576307467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Ovala_60x80cm_Velara_Touch_Sistem_Dezaburire_Dimabila_1.webp?v=1783499212","width":1080,"height":1080},{"id":55768683315467,"created_at":"2025-05-26T14:48:26+03:00","position":2,"updated_at":"2026-07-08T11:27:01+03:00","product_id":9760576307467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Ovala_60x80cm_Velara_Touch_Sistem_Dezaburire_Dimabila_2.webp?v=1783499221","width":1080,"height":1080},{"id":55770461765899,"created_at":"2025-05-26T15:46:59+03:00","position":3,"updated_at":"2026-07-08T11:27:09+03:00","product_id":9760576307467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Ovala_60x80cm_Velara_Touch_Sistem_Dezaburire_Dimabila_3.webp?v=1783499229","width":1080,"height":1080},{"id":69714438947083,"created_at":"2026-07-08T11:26:26+03:00","position":4,"updated_at":"2026-07-08T11:27:17+03:00","product_id":9760576307467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Ovala_60x80cm_Velara_Touch_Sistem_Dezaburire_Dimabila_4.png?v=1783499237","width":1254,"height":1254},{"id":69714431181067,"created_at":"2026-07-08T11:24:48+03:00","position":5,"updated_at":"2026-07-08T11:27:25+03:00","product_id":9760576307467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_O