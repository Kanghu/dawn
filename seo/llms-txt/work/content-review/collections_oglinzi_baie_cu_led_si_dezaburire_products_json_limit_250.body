4017965","width":1254,"height":1254},{"id":64441997820171,"created_at":"2026-01-16T14:20:31+02:00","position":7,"updated_at":"2026-07-14T11:32:54+03:00","product_id":10553052889355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_50x70cm_ECLISSA_Touch_Sistem_Dezaburire_Dimabila_7.png?v=1784017974","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":11001869664523,"title":"Oglinda LED Rectangulara, 50x70cm, CANTO Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rectangulara-50x70cm-canto-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp class=\"\" data-end=\"558\" data-start=\"217\"\u003eOglinda LED Magia Canto Touch combină tehnologia avansată cu un design elegant, oferindu-ți o reflecție clară și perfect iluminată. Cu dimensiunile de 50x70cm și opțiunea de iluminare dimabilă, aceasta este ideală pentru baie, dormitor sau dressing. Sistemul de dezaburire asigură o vizibilitate impecabilă chiar și în condiții de umiditate.\u003c\/p\u003e\u003cp class=\"\" data-end=\"1126\" data-start=\"560\"\u003e✔ \u003cstrong data-end=\"584\" data-start=\"562\"\u003eDimensiune 50x70cm\u003c\/strong\u003e – o oglindă de dimensiuni medii, potrivită pentru orice încăpere.\u003cbr data-end=\"653\" data-start=\"650\"\u003e✔ \u003cstrong data-end=\"688\" data-start=\"655\"\u003eSistem de dezaburire integrat\u003c\/strong\u003e – menține oglinda clară și funcțională chiar și după un duș cald.\u003cbr data-end=\"757\" data-start=\"754\"\u003e✔ \u003cstrong data-end=\"785\" data-start=\"759\"\u003eIluminare LED dimabilă\u003c\/strong\u003e – reglezi intensitatea luminii pentru confortul dorit, fie pentru un machiaj precis, fie pentru o atmosferă relaxantă.\u003cbr data-end=\"1002\" data-start=\"999\"\u003e✔ \u003cstrong data-end=\"1034\" data-start=\"1004\"\u003eDesign rectangular elegant\u003c\/strong\u003e – se potrivește perfect în orice decor contemporan, adăugând un plus de stil și rafinament.\u003c\/p\u003e","published_at":"2026-07-15T13:51:34+03:00","created_at":"2026-07-13T17:47:24+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":53239590912267,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E39S\/50X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"379.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":11001869664523,"created_at":"2026-07-13T17:47:24+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69756098347275,"created_at":"2026-07-13T17:55:27+03:00","position":1,"updated_at":"2026-07-13T17:59:38+03:00","product_id":11001869664523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_50x70cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_1.png?v=1783954778","width":1254,"height":1254},{"id":69758213390603,"created_at":"2026-07-14T09:21:31+03:00","position":2,"updated_at":"2026-07-14T09:22:21+03:00","product_id":11001869664523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_50x70cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_4.png?v=1784010141","width":1254,"height":1254},{"id":69758195335435,"created_at":"2026-07-14T09:14:11+03:00","position":3,"updated_at":"2026-07-14T09:15:48+03:00","product_id":11001869664523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara