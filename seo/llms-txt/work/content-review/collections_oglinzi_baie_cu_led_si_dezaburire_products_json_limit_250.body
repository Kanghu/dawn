507147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_3af5c4cd-fd84-4a60-bd5c-ee2fe82882b7.png?v=1757438667","width":2000,"height":2000},{"id":60145492492555,"created_at":"2025-09-09T20:17:23+03:00","position":7,"updated_at":"2025-09-09T20:24:27+03:00","product_id":9779344507147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_cc6542cb-02d4-426f-b2ba-7250843b9e5c.png?v=1757438667","width":2000,"height":2000},{"id":64309672280331,"created_at":"2026-01-12T14:12:18+02:00","position":8,"updated_at":"2026-01-12T14:12:21+02:00","product_id":9779344507147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/S06_50X80_EPREL.png?v=1768219941","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10852588814603,"title":"Oglinda LED Rectangulara, 45x60cm, ECLISSA Touch, Sistem Dezaburire, Dimabila, Lumina Rece 6000K","handle":"oglinda-led-rectangulara-45x60cm-eclissa-touch-sistem-dezaburire-dimabila","body_html":"\u003cp data-sourcepos=\"5:1-5:300\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003eAdaugă un plus de stil și funcționalitate băii tale cu oglinda LED Rectangulară Touch Ulrich. Cu dimensiunile sale generoase de 45x60 cm, această oglindă îmbină un design modern cu tehnologia tactilă intuitivă și un sistem eficient de dezaburire, oferind o experiență superioară în rutina ta zilnică.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:300\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:31\"\u003e\u003cstrong\u003eDesign Rectangular Rafinat:\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:241\"\u003eForma rectangulară clasică a oglinzii Ulrich se integrează armonios în diverse stiluri de baie, oferind o suprafață reflectantă amplă și un aspect curat și modern. Dimensiunile de 60x80 cm sunt ideale pentru a oferi o vizibilitate excelentă.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:42\"\u003e\u003cstrong\u003eTehnologie Inteligentă pentru Confort:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-15:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:178\"\u003e\n\u003cstrong\u003eControl Tactil (Touch):\u003c\/strong\u003e Gestionează cu ușurință iluminarea LED printr-o simplă atingere a senzorului tactil integrat, oferind o interacțiune modernă, elegantă și intuitivă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eSistem Anti-Aburire Eficient:\u003c\/strong\u003e Bucură-te de o imagine clară și neobstrucționată chiar și după cele mai aburinde dușuri, datorită sistemului de dezaburire integrat, care menține suprafața oglinzii perfect vizibilă.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2026-01-18T12:00:21+02:00","created_at":"2026-01-08T10:46:40+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","Back2school","oglinda led"],"variants":[{"id":52810500735243,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E38S\/45X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":10852588814603,"created_at":"2026-01-08T10:46:40+02:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":64346480574731,"created_at":"2026-01-13T15:30:51+02:00","position":1,"updated_at":"2026-01-13T15:31:16+02:00","product_id":10852588814603,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_61e39648-e5bc-4236-b009-69ceae7bae37.png?v=1768311076","width":2000,"height":2000},{"