b2-b886-783fbc1be1f3.png?v=1761058562","width":1920,"height":1920},{"id":60610655912203,"created_at":"2025-09-23T22:40:57+03:00","position":4,"updated_at":"2025-10-21T17:56:02+03:00","product_id":9758206525707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_8cbc5239-726d-4519-a62a-885e620116a4.png?v=1761058562","width":1920,"height":1920},{"id":60610674065675,"created_at":"2025-09-23T22:45:23+03:00","position":5,"updated_at":"2025-10-21T17:56:02+03:00","product_id":9758206525707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_30e3106b-577f-4b2c-99fc-f1ba47daef65.png?v=1761058562","width":1920,"height":1920},{"id":60610707095819,"created_at":"2025-09-23T22:54:00+03:00","position":6,"updated_at":"2025-10-21T17:56:02+03:00","product_id":9758206525707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_0a8bba34-7ea4-4443-9656-f696d7cb7b5c.png?v=1761058562","width":1920,"height":1920}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779344343307,"title":"Oglinda LED Touch Helmut Sistem Dezaburire, Ceas si Temperatura 50x90 cm Rama Negru Brushed Marcello Funghi","handle":"oglinda-led-touch-helmut-sistem-dezaburire-ceas-si-temperatura-50x90-cm-rama-negru-brushed-marcello-funghi","body_html":"\u003cp class=\"isSelectedEnd\"\u003e\u003cspan\u003eCompletează amenajarea băii cu oglinda LED Touch Helmut 50x90 cm, un model elegant care îmbină designul modern cu funcționalitatea inteligentă. Rama cu finisaj \u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003eNegru Brushed\u003c\/span\u003e\u003c\/strong\u003e\u003cspan\u003e oferă un aspect sofisticat și contemporan, fiind ușor de integrat în băile amenajate în stil modern, industrial sau minimalist.\u003c\/span\u003e\u003c\/p\u003e\u003cp class=\"isSelectedEnd\"\u003e\u003cspan\u003eIluminarea LED asigură o lumină uniformă și plăcută, ideală pentru machiaj, bărbierit sau rutina zilnică de îngrijire. Panoul de comandă \u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003eTouch\u003c\/span\u003e\u003c\/strong\u003e\u003cspan\u003e permite controlul facil al funcțiilor, iar sistemul de \u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003edezaburire\u003c\/span\u003e\u003c\/strong\u003e\u003cspan\u003e menține oglinda perfect clară chiar și după un duș fierbinte.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003ePentru un plus de confort, oglinda este echipată cu afișaj digital care indică \u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003eora\u003c\/span\u003e\u003c\/strong\u003e\u003cspan\u003e și \u003c\/span\u003e\u003cstrong\u003e\u003cspan\u003etemperatura ambientală\u003c\/span\u003e\u003c\/strong\u003e\u003cspan\u003e, oferind informațiile necesare dintr-o singură privire.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eOglinda LED Touch Helmut Marcello Funghi este alegerea ideală pentru cei care își doresc un produs elegant, practic și durabil. Combinația dintre iluminarea performantă, funcțiile inteligente și designul premium transformă fiecare utilizare într-o experiență confortabilă și plăcută.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-10-28T12:11:57+02:00","created_at":"2025-03-06T18:42:24+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman S","tags":["active","Oglinzi draft count"],"variants":[{"id":52429825212683,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-S15\/50X90","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9779344343307,"created_at":"2025-09-30T17:26:45+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69696455999755,"created_at":"2026-07-04T18:17:52+03:00","position":1,"updated_at":"2026-07-04T18:17:55+03:00","product_id":9779344343307,"vari