:"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Touch_River_52W_Sistem_Dezaburire_80X120cm_Forma_de_Picatura_2.png?v=1784284731","width":2000,"height":2000},{"id":60396839665931,"created_at":"2025-09-17T14:46:12+03:00","position":3,"updated_at":"2026-07-17T13:39:06+03:00","product_id":9779341623563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Touch_River_52W_Sistem_Dezaburire_80X120cm_Forma_de_Picatura_3.png?v=1784284746","width":2000,"height":2000},{"id":60396869943563,"created_at":"2025-09-17T14:50:14+03:00","position":4,"updated_at":"2026-07-17T13:39:19+03:00","product_id":9779341623563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Touch_River_52W_Sistem_Dezaburire_80X120cm_Forma_de_Picatura_4.png?v=1784284759","width":2000,"height":2000},{"id":69775770321163,"created_at":"2026-07-17T13:37:32+03:00","position":5,"updated_at":"2026-07-17T13:39:30+03:00","product_id":9779341623563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Touch_River_52W_Sistem_Dezaburire_80X120cm_Forma_de_Picatura_5.png?v=1784284770","width":1254,"height":1254},{"id":69765445583115,"created_at":"2026-07-15T17:23:42+03:00","position":6,"updated_at":"2026-07-17T13:39:38+03:00","product_id":9779341623563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Touch_River_52W_Sistem_Dezaburire_80X120cm_Forma_de_Picatura_6.png?v=1784284778","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10793046245643,"title":"Oglinda LED Touch Dante, functie Dezaburire, 60x80cm, Lumina Rece","handle":"oglinda-led-touch-dante-functie-dezaburire-60x80cm-lumina-rece","body_html":"\u003cp\u003eTransformă baia într-un spațiu modern și confortabil cu oglinda LED Touch Dante, prevăzută cu funcție de dezaburire și iluminare rece. Cu dimensiunea de 60x80 cm, acest model îmbină perfect designul minimalist cu tehnologia practică, oferind o experiență premium în utilizarea zilnică.\u003c\/p\u003e\u003cp\u003eIluminarea LED cu lumină rece asigură o claritate excelentă, ideală pentru machiaj, bărbierit sau rutina de îngrijire personală. Sistemul touch integrat permite controlul rapid și intuitiv al iluminării, printr-o simplă atingere.\u003c\/p\u003e\u003cp\u003eFuncția de dezaburire menține suprafața oglinzii perfect clară chiar și după dușurile fierbinți, eliminând condensul și oferind vizibilitate optimă în orice moment. Designul elegant și finisajele moderne fac din această oglindă alegerea ideală pentru băile contemporane.\u003c\/p\u003e\u003ch3\u003eCaracteristici principale:\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eDimensiune: 60x80 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIluminare LED cu lumină rece\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSistem touch pentru control facil\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eFuncție dezaburire integrată\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDesign modern și minimalist\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eConsum redus de energie\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eMontaj simplu și rapid\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003ePotrivită pentru băi moderne și elegante\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eBeneficii:\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eVizibilitate clară fără abur\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIluminare uniformă și eficientă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eConfort sporit în utilizarea zilnică\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eAspect premium și elegant\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eRezistență la umiditate și durabilitate ridicată\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-10-30T18:32:35+02:00","created_at":"2025-10-30T18:31:33+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","BF2025","BLACKSEASON","outlet"],"variants":[{"id":52540995240203,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-D1OC-RS1S-062S","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10793046245643,"created_at":"2025-10-30T18:31:33+02:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":56792957976843,"created_at":"2025-06-26T17:51:46+03:00","position":1,"updated_at":"2026-07-08T10:07:36+03:00","product_id":10793046245643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_2.png?v=1783494456","width":2000,"height":2000},{"id":56792939888907,"created_at":"2025-06-26T17:50:56+03:00","position":2,"updated_at":"2026-07-08T10:07:46+03:00","product_id":10793046245643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_3.png?v=1783494466","width":2000,"height":2000},{"id":56792940019979,"created_at":"2025-06-26T17:50:56+03:00","position":3,"updated_at":"2026-07-08T10:07:56+03:00","product_id":10793046245643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_4.png?v=1783494476","width":2500,"height":2500},{"id":56792939757835,"created_at":"2025-06-26T17:50:56+03:00","position":4,"updated_at":"2026-07-08T10:07:22+03:00","product_id":10793046245643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_1.png?v=1783494442","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10121253224715,"title":"Oglinda LED Rotunda, 60cm, Corona Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-60cm-corona-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003c\/p\u003e\u003cp class=\"\" data-end=\"458\" data-start=\"189\"\u003eAceastă oglindă rotundă cu diametrul de 60 cm aduce un plus de funcționalitate și stil în orice baie. Echipată cu două funcții esențiale – iluminare LED și sistem de dezaburire – este ideală pentru utilizarea zilnică, indiferent de condițiile de umiditate din încăpere.\u003c\/p\u003e\u003cp class=\"\" data-end=\"716\" data-start=\"460\"\u003eIluminarea neutră (4000K) oferă o lumină echilibrată, perfectă pentru activități precum machiajul sau bărbieritul. Sistemul LED integrat, cu bandă discretă și eficientă energetic, este activat printr-un întrerupător tip touch, intuitiv și ușor de utilizat.\u003c\/p\u003e\u003cp class=\"\" data-end=\"954\" data-start=\"718\"\u003eFabricată din sticlă de calitate, oglinda are un design modern, curat, și vine însoțită de accesoriile necesare pentru montaj. Forma circulară o face potrivită pentru o varietate de stiluri de amenajare, de la contemporan la minimalist.\u003c\/p\u003e\u003cp class=\"\" data-end=\"986\" data-start=\"956\"\u003e \u003c\/p\u003e","published_at":"2025-04-07T19:43:55+03:00","created_at":"2025-04-07T19:25:42+03:00","updated_at":"2026-09-14T1