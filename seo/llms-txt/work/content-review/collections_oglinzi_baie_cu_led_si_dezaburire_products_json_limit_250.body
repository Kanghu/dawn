0795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_80x60cm_RADIANTE_Touch_Sistem_Dezaburire_Dimabila_6.png?v=1784027365","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10137942917387,"title":"Oglinda LED Rectangulara, 50x70cm, RADIANTE Touch, Lumina Rece, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rectangulara-50x70cm-radiante-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp class=\"\"\u003eInsideus Touch este oglinda ideală pentru spații moderne în care funcționalitatea se îmbină cu un design discret și elegant. Cu dimensiuni compacte de 50x70cm, iluminare LED dimabilă și sistem de dezaburire integrat, această oglindă oferă confort și vizibilitate excelente, indiferent de momentul zilei.\u003c\/p\u003e\u003cp class=\"\"\u003e✔ \u003cstrong\u003eDimensiuni 50x70cm\u003c\/strong\u003e – format eficient, potrivit pentru băi de orice dimensiune.\u003cbr\u003e✔ \u003cstrong\u003eIluminare LED dimabilă\u003c\/strong\u003e – reglezi lumina exact cum ai nevoie, fie pentru machiaj, fie pentru relaxare.\u003cbr\u003e✔ \u003cstrong\u003eSistem de dezaburire integrat\u003c\/strong\u003e – oglinda rămâne clară chiar și în cele mai umede condiții.\u003cbr\u003e✔ \u003cstrong\u003eControl tactil (Touch)\u003c\/strong\u003e – activare ușoară, printr-o simplă atingere.\u003c\/p\u003e","published_at":"2025-04-29T14:17:45+03:00","created_at":"2025-04-16T12:27:15+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","Ciresar 25"],"variants":[{"id":52429658816779,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E09S\/50X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"259.99","position":1,"product_id":10137942917387,"created_at":"2025-09-30T16:56:19+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":56792940019979,"created_at":"2025-06-26T17:50:56+03:00","position":1,"updated_at":"2026-07-08T10:07:56+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_4.png?v=1783494476","width":2500,"height":2500},{"id":56792939888907,"created_at":"2025-06-26T17:50:56+03:00","position":2,"updated_at":"2026-07-08T10:07:46+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_3.png?v=1783494466","width":2000,"height":2000},{"id":56792939757835,"created_at":"2025-06-26T17:50:56+03:00","position":3,"updated_at":"2026-07-08T10:07:22+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_1.png?v=1783494442","width":2000,"height":2000},{"id":56792957976843,"created_at":"2025-06-26T17:51:46+03:00","position":4,"updated_at":"2026-07-08T10:07:36+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_2.png?v=1783494456","width":2000,"height":2000},{"id":69713490215179,"created_at":"2026-07-08T09:31:01+03:00","position":5,"updated_at":"2026-07-08T09:31:18+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_50x70cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_1.png?v=1783492278","width":1254,"height":1254},{"id":69713530781963,"created_at":"2026-07-08T09:35:43+03:00","position":6,"updated_at":"2026-07-08T09:36:50+03:00","product_id":10137942917387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_50x70cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_2.png?v=1783492610","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760318488843,"title":"Oglinda LED Rotunda, 60cm, Lucea Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-60cm-sfera-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg.webp?v=1744020565\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eTransformați-vă rutina zilnică de înfrumusețare cu această Oglindă LED Touch de excepție. Cu un design rotund modern și o estetică curată, această oglindă cu diametrul de 60cm devine nu doar un obiect funcțional, dar și un accesoriu elegant pentru orice baie sau toaletă.\u003cbr\u003e\u003cbr\u003ePunctul său forte constă în iluminarea cu LED-uri cu lumina rece, care oferă o vizibilitate optimă și reflectă culorile în mod realist. Acest lucru face ca aplicarea machiajului sau bărbieritul să fie mai precise și eficiente, asigurându-se că veți ieși din casă arătând impecabil în fiecare zi. Un alt aspect remarcabil este funcția de dezaburire integrată. Zilele cu oglinzi aburite după un duș fierbinte sunt de domeniul trecutului. Cu o simplă atingere, oglinda se dezaburește rapid, economisindu-vă timp prețios în diminețile aglomerate.\u003cbr\u003e\u003cbr\u003eControlul touch sensibil face ca utilizarea să fie intuitivă și ușoară. Fără butoane inestetice sau comutatoare vizibile, designul său este neted și minimalist. Robusta și durabilă, Oglinda LED Touch este construită pentru a rezista la utilizare zilnică și pentru a vă oferi ani de serviciu fără probleme. În plus, instalarea este simplă și rapidă, permițându-vă să vă bucurați de noul dvs. accesoriu în cel mai scurt timp.\u003cbr\u003e\u003cbr\u003eOptând pentru această oglindă LED cu funcție touch, veți adăuga un strop de modernitate și eficiență spațiului dvs., oferindu-vă în același timp un produs de înaltă calitate care vă va servi mulți ani de acum încolo.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:14:41+02:00","created_at":"2025-02-25T02:14:41+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","BF2025"],"variants":[{"id":52428100763915,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E01S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"319.79","grams":0,"compare_at_price":"359.99","position":1,"product_id":9760318488843,"created_at":"2025-09-30T12:27:17+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55098047529227,"created_at":"2025-04-30T18:55:28+03:00","position":1,"updated_at":"2026-07-13T16:45:00+03:00","product_id":9760318488843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Lucea_Touch_Sistem_Dezaburire_Dimabila_1.png?v=1783950300","width":2000,"height":2000},{"id":55098047496459,"created_a