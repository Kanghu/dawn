iles\/1\/0782\/5175\/3739\/files\/a3_6711d283-e07d-42b0-9dcd-b7e8ba5dae03.png?v=1758105654","width":2000,"height":2000},{"id":68162831974667,"created_at":"2026-04-09T16:20:03+03:00","position":5,"updated_at":"2026-04-09T16:20:05+03:00","product_id":10725894914315,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E69S-60X80.png?v=1775740805","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760846479627,"title":"Oglinda LED Organica 50x70cm, Forma Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-organica-50x70cm-forma-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e \u003cspan style=\"font-size: 16px;\"\u003eCu un design elegant și tehnologie avansată, aceste oglinzi sunt echipate cu o bandă LED integrată ce aduce o lumină plăcută în orice încăpere. Funcția de reglare a intensității luminii, accesibilă prin menținerea degetului pe butonul de aprindere, permite adaptarea perfectă a luminii la orice situație sau preferință. \u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:38:30+02:00","created_at":"2025-02-25T03:38:29+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52423821361419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E56S\/50X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9760846479627,"created_at":"2025-09-29T11:26:41+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":51855576662283,"created_at":"2025-02-25T03:38:32+02:00","position":1,"updated_at":"2025-02-25T03:38:33+02:00","product_id":9760846479627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-iside-sistem-dezaburire-50x70cm-colectia-korman-1738612264.webp?v=1740447513","width":1024,"height":1024},{"id":51855576695051,"created_at":"2025-02-25T03:38:32+02:00","position":2,"updated_at":"2025-02-25T03:38:33+02:00","product_id":9760846479627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1-1738612266.webp?v=1740447513","width":1024,"height":1024},{"id":64442023280907,"created_at":"2026-01-16T14:24:37+02:00","position":3,"updated_at":"2026-01-16T14:24:40+02:00","product_id":9760846479627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E56S_50X70_EPREL.png?v=1768566280","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10914228044043,"title":"Oglinda LED Rotunda, 60cm, Lira Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-60cm-lira-touch-sistem-dezaburire-dimabila-1","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"105\" data-end=\"178\" class=\"\"\u003e\u003cstrong data-start=\"105\" data-end=\"178\"\u003eOglindă LED Rotundă Lira Touch 60cm – rafinament și funcționalitate\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"180\" data-end=\"502\" class=\"\"\u003eOglinda LED Lira Touch, cu design rotund și dimensiune de 60cm, adaugă un aer modern și elegant oricărui spațiu. Tehnologia de iluminare LED dimabilă îți permite să reglezi intensitatea luminii pentru confortul dorit, iar sistemul de dezaburire integrat păstrează oglinda perfect clară chiar și în condiții de umiditate.\u003c\/p\u003e\u003cp data-start=\"504\" data-end=\"951\" class=\"\"\u003e✔ \u003cstrong data-start=\"506\" data-end=\"525\"\u003eDimensiune 60cm\u003c\/strong\u003e – un echilibru ideal între dimensiune și vizibilitate.\u003cbr data-start=\"580\" data-end=\"583\"\u003e✔ \u003cstrong data-start=\"585\" data-end=\"609\"\u003eSistem de dezaburire\u003c\/strong\u003e – elimină condensul, menținând oglinda impecabilă după fiecare utilizare.\u003cbr data-start=\"683\" data-end=\"686\"\u003e✔ \u003cstrong data-start=\"688\" data-end=\"714\"\u003eIluminare LED dimabilă\u003c\/strong\u003e – ajustezi lumina pentru a se potrivi cu fiecare moment al zilei.\u003cbr data-start=\"780\" data-end=\"783\"\u003e✔ \u003cstrong data-start=\"785\" data-end=\"802\"\u003eControl Touch\u003c\/strong\u003e – simplu și modern, cu funcționare prin atingere ușoară.\u003cbr data-start=\"859\" data-end=\"862\"\u003e✔ \u003cstrong data-start=\"864\" data-end=\"889\"\u003eDesign rotund elegant\u003c\/strong\u003e – adaugă un accent sofisticat în baie, dormitor sau dressing.\u003c\/p\u003e","published_at":"2026-03-19T21:56:02+02:00","created_at":"2026-03-19T21:55:37+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","BF2025","IULIE25"],"variants":[{"id":52983414948107,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E49S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10914228044043,"created_at":"2026-03-19T21:55:38+02:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69697431306507,"created_at":"2026-07-05T00:38:38+03:00","position":1,"updated_at":"2026-07-05T00:38:41+03:00","product_id":10914228044043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/file