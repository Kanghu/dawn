dated_at":"2025-12-17T16:04:36+02:00","product_id":10837780726027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_17_2025_04_04_23_PM.png?v=1765980276","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779342311691,"title":"Oglinda LED Touch Ivory, Sistem Dezaburire, Diametru 60cm, Lumina Rece 6000K","handle":"oglinda-led-touch-ivory-sistem-dezaburire-60x60cm-colectia-korman","body_html":"\u003cp data-start=\"0\" data-end=\"81\"\u003e\u003cstrong data-start=\"0\" data-end=\"81\"\u003eOglindă LED Touch Ivory, diametru 60 cm, sistem dezaburire, lumină rece 6000K\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"0\" data-end=\"81\"\u003e\u003cstrong data-start=\"0\" data-end=\"81\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"83\" data-end=\"325\"\u003eOglinda LED Touch Ivory, cu diametrul de 60 cm, este concepută pentru băi moderne, unde claritatea și funcționalitatea sunt esențiale. Forma rotundă și designul simplu oferă un aspect elegant, ușor de integrat în diverse stiluri de amenajare.\u003c\/p\u003e\u003cp data-start=\"83\" data-end=\"325\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"327\" data-end=\"572\"\u003eIluminarea LED cu lumină rece 6000K asigură vizibilitate precisă, ideală pentru machiaj, bărbierit și îngrijire personală. Controlul touch permite utilizare rapidă și intuitivă, iar sistemul de dezaburire menține oglinda clară chiar și după duș.\u003c\/p\u003e\u003cp data-start=\"327\" data-end=\"572\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-cutie-oglinda.jpg?v=1744029165\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"574\" data-end=\"712\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eConsum redus de energie, lumină uniformă și finisaje de calitate, pentru un produs practic și fiabil, potrivit utilizării zilnice în baie.\u003c\/p\u003e","published_at":"2026-01-18T12:09:36+02:00","created_at":"2025-03-06T18:39:51+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman E","tags":["active","Oglinzi draft count"],"variants":[{"id":52429824327947,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E71S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.97","grams":0,"compare_at_price":"199.99","position":1,"product_id":9779342311691,"created_at":"2025-09-30T17:26:37+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":66871173251339,"created_at":"2026-03-05T17:58:38+02:00","position":1,"updated_at":"2026-03-05T18:04:46+02:00","product_id":9779342311691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a6_b36a3870-afe2-467f-bcf8-220221fa51cb.png?v=1772726686","width":2400,"height":2400},{"id":66871161979147,"created_at":"2026-03-05T17:53:03+02:00","position":2,"updated_at":"2026-03-05T18:04:46+02:00","product_id":9779342311691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_0ad89c18-fcb3-4e96-978b-43954873e1af.png?v=1772726686","width":2400,"height":2400},{"id":66871162044683,"created_at":"2026-03-05T17:53:03+02:00","position":3,"updated_at":"2026-03-05T18:04:46+02:00","product_id":9779342311691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_79d7eba8-128d-4746-8236-f9ed795cec7a.png?v=1772726686","width":2400,"height":2400},{"id":66871162077451,"created_at":"2026-03-05T17:53:03+02:00","position":4,"updated_at":"2026-03-05T18:04: