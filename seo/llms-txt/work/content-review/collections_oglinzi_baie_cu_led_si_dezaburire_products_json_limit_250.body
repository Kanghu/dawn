\/E71S_70X70_EPREL.png?v=1772726337","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779341852939,"title":"Oglinda LED Touch Infinitium Sistem Dezaburire, 4000K, 60X80cm","handle":"oglinda-led-touch-infinitium-sistem-dezaburire-60x80cm-colectia-korman","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg.webp?v=1744020565\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-12-17T06:41:28+02:00","created_at":"2025-03-06T18:39:11+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman E","tags":["active","Oglinzi draft count"],"variants":[{"id":52429875249419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E68S\/50X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9779341852939,"created_at":"2025-09-30T17:46:50+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":63495813300491,"created_at":"2025-12-16T13:51:44+02:00","position":1,"updated_at":"2025-12-16T13:51:48+02:00","product_id":9779341852939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-ovala-cu-iluminare-london-led_1.png?v=1765885908","width":1000,"height":1000},{"id":63495813333259,"created_at":"2025-12-16T13:51:44+02:00","position":2,"updated_at":"2025-12-16T13:51:48+02:00","product_id":9779341852939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-ovala-cu-iluminare-london-led.png?v=1765885908","width":1000,"height":1000},{"id":63495820312843,"created_at":"2025-12-16T13:53:15+02:00","position":3,"updated_at":"2025-12-16T13:53:20+02:00","product_id":9779341852939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_16_2025_01_53_04_PM.png?v=1765886000","width":1024,"height":1024},{"id":63495820280075,"created_at":"2025-12-16T13:53:15+02:00","position":4,"updated_at":"2025-12-16T13:53:19+02:00","product_id":9779341852939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_16_2025_01_53_07_PM.png?v=1765885999","width":1024,"height":1024},{"id":63495864615179,"created_at":"2025-12-16T14:02:16+02:00","position":5,"updated_at":"2025-12-16T14:02:21+02:00","product_id":9779341852939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_16_2025_02_02_08_PM.png?v=1765886541","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760795361547,"title":"Oglinda LED Giga, 60x80cm, 14W, Touch, Lumina 6000K","handle":"oglinda-led-giga-60x80cm-14w-touch-lumina-6000k","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\n\u003cp data-end=\"56\" data-start=\"0\"\u003e\u003cstrong data-end=\"56\" data-start=\"0\"\u003eOglindă LED Giga, 60x80 cm, touch, lumină rece 6000K\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-end=\"260\" data-start=\"58\"\u003eOglinda LED Giga, cu dimensiunea de 60x80 cm, este o soluție practică și modernă pentru băi contemporane. Forma dreptunghiulară oferă o suprafață generoasă de reflexie, ideală pentru utilizarea zilnică.\u003c\/p\u003e\n\u003cp data-end=\"260\" data-start=\"58\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\"\u003e\u003c\/p\u003e\n\u003cp data-end=\"500\" data-start=\"262\"\u003eIluminarea LED cu lumină rece 6000K asigură vizibilitate clară și precisă, potrivită pentru machiaj, bărbierit și îngrijire personală. Sistemul de control touch permite pornirea și oprirea rapidă a iluminării, fără întrerupătoare externe.\u003c\/p\u003e\n\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"702\" data-start=\"502\"\u003eDesignul simplu și curat se integrează ușor în diverse stiluri de amenajare. Consum redus de energie, iluminare uniformă și fiabilitate ridicată, pentru un produs eficient și ușor de utilizat în baie.\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-cutie-oglinda.jpg?v=1744029165\"\u003e\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cbr\u003e\u003c\/div\u003e","published_at":"2025-02-25T03:27:36+02:00","created_at":"2025-02-25T03:27:35+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","Back2school","iulie_26","oglinda led"],"variants":[{"id":52399158886667,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E28S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"229.97","grams":0,"compare_at_price":"319.99","position":1,"product_id":9760795361547,"created_at":"2025-09-21T17:06:34+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":64340918501643,"created_at":"2026-01-13T11:42:14+02:00","position":1,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Jan_13_2026_11_42_03_AM.png?v=1768297678","width":1024,"height":1024},{"id":63488498073867,"created_at":"2025-12-16T11:23:09+02:00","position":2,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_98a471e5-b673-4404-a86c-9bd18ff59a56.png?v=1768297678","width":2400,"height":2400},{"id":63488818807051,"created_at":"2025-12-16T11:26:04+02:00","position":3,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_30eb388f-0302-460b-a914-c5c8544044e5.png?v=1768297678","width":2400,"height":2400},{"id":51854906851595,"created_at":"2025-02-25T03:27:38+02:00","position":4,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/c1-1727946524.webp?v=1768297678","width":900,"height":900},{"id":63488492536075,"created_at":"2025-12-16T11:22:30+02:00","position":5,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_f56c3c40-b65d-49b1-a9d5-0185840ae051.png?v=1768297678","width":2400,"height":2400},{"id":51854906261771,"created_at":"2025-02-25T03:27:38+02:00","position":6,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-giga-60x80cm-colectia-korman-1727946524.webp?v=1768297678","width":900,"height":900},{"id":51854907932939,"created_at":"2025-02-25T03:27:38+02:00","position":7,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/c3-1727946525.webp?v=1768297678","width":900,"height":900},{"id":64309533245707,"created_at":"2026-01-12T13:38:09+02:00","position":8,"updated_at":"2026-01-13T11:47:58+02:00","product_id":9760795361547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E28S_60X80_EPREL.png?v=1768297678","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10837780431115,"title":"Oglinda LED Ovala, 45x65cm, Velara Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-ovala-45x65cm-velara-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cstrong\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e30 000 de ore\u003c\/strong\u003e de functionare! Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eIn ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2025-12-13T13:04:47+02:00","created_at":"2025-12-13T13:04:47+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52763579187467,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E06S\/45X65","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.97","grams":0,"compare_at_price":"339.99","position":1,"product_id":10837780431115,"created_at":"2025-12-13T13:04:47+02:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659527610635,"created_at":"2026-07-03T16:26:24+03:00","position":1,"updated_at":"2026-07-03T16:26:27+03:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_0ae8aee5-7f66-4814-bf12-95750918dac9.webp?v=1783085187","width":800,"height":800},{"id":63490340585739,"created_at":"2025-12-16T11:49:03+02:00","position":2,"updated_at":"2025-12-17T06:55:53+02:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_b9f3da37-dba4-4d5e-a646-2873abf4722c.png?v=1765947353","width":2400,"height":2400},{"id":56933413650699,"created_at":"2025-07-01T18:15:34+03:00","position":3,"updated_at":"2025-12-17T06:55:53+02:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_7c4494f1-66e3-4ee3-99ab-3fee07dd0eb3.png?v=1765947353","width":3000,"height":3000},{"id":63489964802315,"created_at":"2025-12-16T11:44:55+02:00","position":4,"updated_at":"2025-12-17T06:55:53+02:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_14a92fc1-dc55-484c-8012-8d81685172cc.png?v=1765947353","width":2400,"height":2400},{"id":63447676322059,"created_at":"2025-12-15T15:23:26+02:00","position":5,"updated_at":"2026-07-13T16:46:17+03:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Lucea_Touch_Sistem_Dezaburire_Dimabila_6.png?v=1783950377","width":1024,"height":1024},{"id":63489963229451,"created_at":"2025-12-16T11:44:46+02:00","position":6,"updated_at":"2025-12-17T06:55:53+02:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_96429bbe-ab37-487a-a637-cecc293d85f3.png?v=1765947353","width":2400,"height":2400},{"id":63489963032843,"created_at":"2025-12-16T11:44:45+02:00","position":7,"updated_at":"2025-12-16T11:51:28+02:00","product_id":10837780431115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_583f8fbf-8d06-4d14-8cd3-e2f6e16218a1.png?v=1765878688","width":2400,"height":2400}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10837780726027,"title":"Oglinda LED Dreptunghiulara ARTEA Touch, 80X60cm, Sistem Dezaburire, Dimabila, Lumina Race 6000K","handle":"oglinda-led-dreptunghiulara-artea-touch-80x60cm-sistem-dezaburire-dimabila-6000k","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp data-end=\"310\" data-start=\"0\"\u003e\u003cstrong data-end=\"52\" data-start=\"0\"\u003eOglinda LED Dreptunghiulară ARTEA Touch 80×60 cm\u003c\/strong\u003e este alegerea ideală pentru băi moderne și spații high-end, unde designul minimalist se îmbină cu funcționalitatea avansată. Dotată cu \u003cstrong data-end=\"221\" data-start=\"188\"\u003esistem de dezaburire integrat\u003c\/strong\u003e, oglinda asigură o vizibilitate clară imediat după duș, fără condens sau urme neplăcute.\u003c\/p\u003e\n\u003cp data-end=\"310\" data-start=\"0\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cp data-end=\"625\" data-start=\"312\"\u003eIluminarea LED \u003cstrong data-end=\"350\" data-start=\"327\"\u003e6000K (lumină rece)\u003c\/strong\u003e oferă o claritate excelentă pentru machiaj, bărbierit sau rutinele zilnice, iar funcția \u003cstrong data-end=\"451\" data-start=\"439\"\u003edimmable\u003c\/strong\u003e permite reglarea intensității luminii în funcție de ambient și preferințe. Controlul se face simplu și intuitiv prin \u003cstrong data-end=\"584\" data-start=\"569\"\u003epanou touch\u003c\/strong\u003e, integrat elegant în suprafața oglinzii.\u003c\/p\u003e\n\u003cp data-end=\"625\" data-start=\"312\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cp data-end=\"885\" data-start=\"627\"\u003eCu un format \u003cstrong data-end=\"667\" data-start=\"640\"\u003edreptunghiular 80×60 cm\u003c\/strong\u003e, ARTEA se integrează perfect deasupra lavoarelor standard, aducând un plus de stil, lumină uniformă și confort. Construcția premium și finisajele curate o recomandă pentru băi contemporane, rezidențiale sau hoteliere.\u003c\/p\u003e\n\u003cp data-end=\"917\" data-start=\"887\"\u003e\u003cstrong data-end=\"917\" data-start=\"887\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-end=\"1186\" data-start=\"918\"\u003e\n\u003cli data-end=\"957\" data-start=\"918\"\u003e\u003cp data-end=\"957\" data-start=\"920\"\u003eOglindă LED dreptunghiulară modernă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"986\" data-start=\"958\"\u003e\u003cp data-end=\"986\" data-start=\"960\"\u003eDimensiune: \u003cstrong data-end=\"984\" data-start=\"972\"\u003e80×60 cm\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"1018\" data-start=\"987\"\u003e\u003cp data-end=\"1018\" data-start=\"989\"\u003eLumină LED \u003cstrong data-end=\"1016\" data-start=\"1000\"\u003e6000K – rece\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"1071\" data-start=\"1019\"\u003e\u003cp data-end=\"1071\" data-start=\"1021\"\u003e\u003cstrong data-end=\"1041\" data-start=\"1021\"\u003eFuncție dimabilă\u003c\/strong\u003e (reglaj intensitate lumină)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"1106\" data-start=\"1072\"\u003e\u003cp data-end=\"1106\" data-start=\"1074\"\u003e\u003cstrong data-end=\"1104\" data-start=\"1074\"\u003eSistem dezaburire integrat\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"1128\" data-start=\"1107\"\u003e\u003cp data-end=\"1128\" data-start=\"1109\"\u003e\u003cstrong data-end=\"1126\" data-start=\"1109\"\u003eControl touch\u003c\/strong\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"1186\" data-start=\"1129\"\u003e\u003cp data-end=\"1186\" data-start=\"1131\"\u003eDesign elegant, potrivit pentru băi moderne și luxury\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1298\" data-start=\"1188\"\u003eOglinda LED ARTEA nu este doar un obiect funcțional, ci un element de design care ridică nivelul oricărei băi.\u003c\/p\u003e\n\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1298\" data-start=\"1188\"\u003e \u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-12-13T13:07:52+02:00","created_at":"2025-12-13T13:07:52+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","Back2school","oglinda led"],"variants":[{"id":52763580891403,"title":"Default Title","option1":"Default Title","optio