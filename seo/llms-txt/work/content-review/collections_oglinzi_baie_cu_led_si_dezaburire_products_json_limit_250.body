35082565899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_6ce335ee-ee89-4294-a6ca-77bd7043adf9.png?v=1747062696","width":2000,"height":2000},{"id":55360040042763,"created_at":"2025-05-12T18:10:02+03:00","position":4,"updated_at":"2025-05-12T18:11:36+03:00","product_id":10135082565899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_9bfc4010-1e5e-4eae-af87-0c4625ec6c56.png?v=1747062696","width":2000,"height":2000},{"id":55360040173835,"created_at":"2025-05-12T18:10:02+03:00","position":5,"updated_at":"2025-05-12T18:11:36+03:00","product_id":10135082565899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_7bed096b-653b-4b18-b154-15d7deeb5e8e.png?v=1747062696","width":2000,"height":2000},{"id":64309357609227,"created_at":"2026-01-12T13:08:45+02:00","position":6,"updated_at":"2026-01-12T13:08:50+02:00","product_id":10135082565899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E49S_70X70_EPREL.png?v=1768216130","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10080714785035,"title":"Oglinda LED Rotunda 60cm,  Stellaire Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-60cm-stellaire-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eAdaugă o notă de eleganță modernă și tehnologie avansată băii tale cu oglinda LED Rotundă Stellaire Touch. Forma sa circulară perfectă, cu un diametru de 60 cm, creează un punct focal armonios, în timp ce funcțiile inteligente îți oferă confort și control.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eDesign Elegant și Armonios:\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eForma rotundă a oglinzii Stellaire aduce o senzație de echilibru și fluiditate în spațiul tău de baie. Dimensiunea de 60 cm este ideală pentru a oferi o vizibilitate excelentă fără a ocupa prea mult spațiu.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eTehnologie Intuitivă pentru Confort Maxim:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eSistem Anti-Aburire Eficient:\u003c\/strong\u003e Bucură-te de o imagine clară și neobstrucționată chiar și după cele mai fierbinți dușuri, datorită sistemului de dezaburire integrat.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eControl Tactil Sensibil (Touch):\u003c\/strong\u003e Gestionează cu ușurință iluminarea LED și funcția de dimare printr-o simplă atingere a senzorului tactil, oferind o interacțiune modernă și intuitivă.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eIntensitate Luminoasă Personalizabilă (Dimabilă):\u003c\/strong\u003e Creează atmosfera perfectă pentru fiecare moment, ajustând nivelul de lumină emis de LED-uri în funcție de preferințele tale și de necesități.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-03-17T16:59:23+02:00","created_at":"2025-03-17T14:31:13+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52428814811403,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E47S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"379.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10080714785035,"created_at":"2025-09-30T15:36:21+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":52849006838027,"created_at":"2025-04-03T01:04:54+03:00","position":1,"updated_at":"2026-07-14T16:16:41+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_1.png?v=1784035001","width":2000,"height":2000},{"id":52849006641419,"created_at":"2025-04-03T01:04:54+03:00","position":2,"updated_at":"2026-07-14T16:16:53+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_2.png?v=1784035013","width":2000,"height":2000},{"id":52849006444811,"created_at":"2025-04-03T01:04:54+03:00","position":3,"updated_at":"2026-07-14T16:17:08+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_3.png?v=1784035028","width":2000,"height":2000},{"id":52849035772171,"created_at":"2025-04-03T01:05:41+03:00","position":4,"updated_at":"2026-07-14T16:17:19+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_4.png?v=1784035039","width":2000,"height":2000},{"id":69760299335947,"created_at":"2026-07-14T13:19:40+03:00","position":5,"updated_at":"2026-07-14T16:17:32+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_6.png?v=1784035052","width":1024,"height":1024},{"id":64309270708491,"created_at":"2026-01-12T12:54:23+02:00","position":6,"updated_at":"2026-07-14T16:17:42+03:00","product_id":10080714785035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Stellaire_Touch_Sistem_Dezaburire_Dimabila_7.png?v=1784035062","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10080703774987,"title":"Oglinda LED Semiluna 54x60, Arcana Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-semiluna-54x60-arcana-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:256\"\u003eIluminează-ți baia cu un design unic și funcționalitate modernă prin oglinda LED Semiluna Arcana Touch. Forma sa distinctivă de semilună adaugă o notă de originalitate și rafinament, transformând spațiul tău de îngrijire personală într-un sanctuar de stil.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:20\"\u003e\u003cstrong\u003eDesign Inovator:\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:167\"\u003eForma de semilună a oglinzii, cu dimensiunile de 54x60 cm, oferă un aspect vizual atrăgător și o prezență delicată, perfectă pentru a completa diverse stiluri de baie.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:24\"\u003e\u003cstrong\u003eTehnologie Avansată:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-16:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:142\"\u003e\n\u003cstrong\u003eSistem Dezaburire:\u003c\/strong\u003e Bucură-te de o imagine clară și neaburită chiar și după un duș fierbinte, datorită sistemului integrat de dezaburire.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:164\"\u003e\n\u003cstrong\u003eControl Tactil (Touch):\u003c\/strong\u003e Interacționează intuitiv cu oglinda prin intermediul senzorului tactil, pentru a activa\/dezactiva iluminarea și funcțiile disponibile.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-16:0\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Ajustează intensitatea luminii LED în funcție de preferințele tale și de momentul zilei, creând atmosfera perfectă pentru fiecare nevoie.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-03-17T16:41:24+02:00","created_at":"2025-03-17T14:28:11+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52399159247115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E52S\/54X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"359.99","grams":0,"compare_at_price":"359.99","position":1,"product_id":10080703774987,"created_at":"2025-09-21T17:06:40+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659473182987,"created_at":"2026-07-03T16:13:06+03:00","position":1,"updated_at":"2026-07-03T16:13:09+03:00","product_id":10080703774987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_9568b146-cc89-4dff-bc93-71c06b7df871.webp?v=1783084389","width":800,"height":800},{"id":52840052130059,"created_at":"2025-04-02T18:01:05+03:00","position":2,"updated_at":"2025-04-02T18:07:50+03:00","product_id":10080703774987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_353717d9-0c03-4eb8-bda2-cd4d9c2d5033.png?v=1743606470","width":2000,"height":2000},{"id":52840216035595,"created_at":"2025-04-02T18:07:34+03:00","position":3,"updated_at":"2025-04-02T18:07:50+03:00","product_id":10080703774987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_1618a5c9-7d15-4c24-a2aa-b6792571c06f.png?v=1743606470","width":2000,"height":2000},{"id":52840052326667,"created_at":"2025-04-02T18:01:06+03:00","position":4,"updated_at":"2025-04-02T18:07:49+03:00","product_id":10080703774987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_e56bd0cb-ff31-4da5-9a40-045033941ce2.png?v=1743606469","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759339020555,"title":"Oglinda LED Rectangulara 70x90cm EDGE Touch Sistem Dezaburire, Rama Neagra","handle":"oglinda-led-rectangulara-70x90cm-edge-touch-sistem-dezaburire-rama-neagra","body_html":"\u003cp\u003e\u003cstrong\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e30 000 de ore\u003c\/strong\u003e de functionare! ﻿Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿In ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2026-03-19T20:52:17+02:00","created_at":"2025-02-24T23:36:59+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["Oglinzi draft count"],"variants":[{"id":52399148138763,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E03S\/70X90","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"729.99","grams":0,"compare_at_price":"799.99","position":1,"product_id":9759339020555,"created_at":"2025-09-21T16:56:16+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":51831925604619,"created_at":"2025-02-24T23:37:02+02:00","position":1,"updated_at":"2025-02-24T23:37:03+02:00","product_id":9759339020555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-functie-dezaburire-ceas-rama-neagra-smack-90x70cm_OB2734AG_01.webp?v=1740433023","width":900,"height":900},{"id":51831926423819,"created_at":"2025-02-24T23:37:02+02:00","position":2,"updated_at":"2025-07-22T17:49:48+03:00","product_id":9759339020555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-functie-dezaburire-ceas-rama-neagra-smack-90x70cm_OB2734AG_03.webp?v=1753195788","width":900,"height":900},{"id":51831926259979,"created_at":"2025-02-24T23:37:02+02:00","position":3,"updated_at":"2025-07-22T17:49:48+03:00","product_id":9759339020555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-functie-dezaburire-ceas-rama-neagra-smack-90x70cm_OB2734AG_02.webp?v=1753195788","width":900,"height":900},{"id":51831925473547,"created_at":"2025-02-24T23:37:02+02:00","position":4,"updated_at":"2025-02-24T23:37:03+02:00","product_id":9759339020555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-functie-dezaburire-ceas-rama-neagra-smack-90x70cm_OB2734AG_04.webp?v=1740433023","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758204494091,"title":"Oglinda LED Rectangulara 100x65cm EDGE Touch Sistem Dezaburire, Rama Neagra","handle":"oglinda-led-rectangulara-100x65cm-edge-touch-sistem-dezaburire-rama-neagra","body_html":"\u003cp\u003e\u003cstrong\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e30 000 de ore\u003c\/strong\u003e de functionare! ﻿Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿In ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2025-05-30T17:23:41+03:00","created_at":"2025-02-24T20:50:19+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52399180448011,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E03S\/100X65","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"848.00","grams":0,"compare_at_price":"659.99","position":1,"product_id":9758204494091,"created_at":"2025-09-21T17:26:27+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659400995083,"created_at":"2026-07-03T15:43:35+03:00","position":1,"updated_at":"2026-07-03T15:43:38+03:00","product_id":9758204494091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_e3e52469-7909-4208-a679-434f05fccdcd.webp?v=1783082618","width":800,"height":800},{"id":56934347243787,"created_at":"2025-07-01T19:14:18+03:00","position":2,"updated_at":"2025-07-01T20:23:32+03:00","product_id":9758204494091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_1fbf202f-027f-463a-be16-0f2485b64b72.png?v=1751390612","width":1024,"height":1024},{"id":56934347276555,"created_at":"2025-07-01T19:14:18+03:00","position":3,"updated_at":"2025-07-01T19:29:05+03:00","product_id":9758204494091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_6f919b61-5091-4168-b619-f2ac768d81e2.png?v=1751387345","width":2000,"height":2000},{"id":56934462161163,"created_at":"2025-07-01T19:24:17+03:00","position":4,"updated_at":"2025-07-01T19:29:05+03:00","product_id":9758204494091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_b49cda8d-ec47-4e15-90cd-8b2ae8b1d6d6.png?v=1751387345","width":2000,"height":2000},{"id":57390362329355,"created_at":"2025-07-16T11:34:12+03:00","position":5,"updated_at":"2025-07-16T11:34:26+03:00","product_id":9758204494091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_f8f21cc0-c3d4-4ff9-bdfc-77a782baef90.png?v=1752654866","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10080634241291,"title":"Oglinda LED Organica 80x60cm, Fluido Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-organica-80x60cm-fluido-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg.webp?v=1744020565\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:287\"\u003eÎmbrățișează un design natural și o tehnologie avansată în baia ta cu oglinda LED Organică Fluido Touch. Forma sa organică unică, cu dimensiunile de 80x60 cm, aduce o notă de fluiditate și originalitate, transformând spațiul tău de îngrijire personală într-un refugiu modern și relaxant.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:32\"\u003e\u003cstrong\u003eDesign Organic și Captivant:\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:225\"\u003eForma neregulată și curbele line ale oglinzii Fluido creează un aspect vizual distinctiv și artistic, inspirat de elementele naturale. Dimensiunile sale generoase oferă o imagine amplă și devin un punct focal elegant în baie.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:53\"\u003e\u003cstrong\u003eTehnologie Intuitivă pentru Confort Personalizat:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-16:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:199\"\u003e\n\u003cstrong\u003eSistem Anti-Aburire Eficient:\u003c\/strong\u003e Menține o suprafață perfect clară chiar și după cele mai aburinde băi, datorită sistemului de dezaburire integrat, asigurând o vizibilitate optimă în orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:178\"\u003e\n\u003cstrong\u003eControl Tactil Sensibil (Touch):\u003c\/strong\u003e Gestionează cu ușurință iluminarea LED printr-o simplă atingere a senzorului tactil, oferind o interacțiune modernă, elegantă și intuitivă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-16:0\"\u003e\n\u003cstrong\u003eIntensitate Luminoasă Ajustabilă (Dimabilă):\u003c\/strong\u003e Personalizează nivelul de lumină emis de LED-uri pentru a se potrivi stării tale de spirit și diferitelor activități, creând exact ambianța dorită în baie.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-03-17T15:15:39+02:00","created_at":"2025-03-17T14:09:42+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","IULIE25"],"variants":[{"id":52399159050507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E50S\/80X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10080634241291,"created_at":"2025-09-21T17:06:37+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659480260875,"created_at":"2026-07-03T16:15:33+03:00","position":1,"updated_at":"2026-07-03T16:15:36+03:00","product_id":10080634241291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_e395b53e-e5f6-47b9-b505-19983e2a9c3e.webp?v=1783084536","width":800,"height":800},{"id":52732893200651,"created_at":"2025-03-31T17:57:46+03:00","position":2,"updated_at":"2025-03-31T18:00:20+03:00","product_id":10080634241291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_1b58e68a-8648-4ebe-acab-27c73de6f952.png?v=1743433220","width":1700,"height":1700},{"id":52732893298955,"created_at":"2025-03-31T17:57:46+03:00","position":3,"updated_at":"2025-03-31T18:00:20+03:00","product_id":10080634241291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_3f07e3c8-518e-4e2e-9921-812b2aa6597c.png?v=1743433220","width":1700,"height":1700},{"id":52732893233419,"created_at":"2025-03-31T17:57:46+03:00","position":4,"updated_at":"2025-03-31T18:00:20+03:00","product_id":10080634241291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_fa9ad6ee-9093-4f74-afec-1774316d5b5d.png?v=1743433220","width":1700,"height":1700}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10866697437451,"title":"Oglinda LED Giga, 80x60cm, Argintiu, Touch, Lumina 6000K","handle":"oglinda-led-giga-80x60cm-touch-lumina-6000k","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\n\u003cp data-start=\"0\" data-end=\"56\"\u003e\u003cstrong data-start=\"0\" data-end=\"56\"\u003eOglindă LED Giga, 80x60 cm, touch, lumină rece 6000K\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-start=\"58\" data-end=\"260\"\u003eOglinda LED Giga, cu dimensiunea de 80x60 cm, este o soluție practică și modernă pentru băi contemporane. Forma dreptunghiulară oferă o suprafață generoasă de reflexie, ideală pentru utilizarea zilnică.\u003c\/p\u003e\n\u003cp data-start=\"58\" data-end=\"260\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-start=\"262\" data-end=\"500\"\u003eIluminarea LED cu lumină rece 6000K asigură vizibilitate clară și precisă, potrivită pentru machiaj, bărbierit și îngrijire personală. Sistemul de control touch permite pornirea și oprirea rapidă a iluminării, fără întrerupătoare externe.\u003c\/p\u003e\n\u003cp data-start=\"502\" data-end=\"702\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eDesignul simplu și curat se integrează ușor în diverse stiluri de amenajare. Consum redus de energie, iluminare uniformă și fiabilitate ridicată, pentru un produs eficient și ușor de utilizat în baie.\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-cutie-oglinda.jpg?v=1744029165\" alt=\"\"\u003e\u003c\/div\u003e","published_at":"2026-02-13T11:27:47+02:00","created_at":"2026-01-28T18:27:41+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","oglinda led"],"variants":[{"id":52851063193867,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E28S\/80X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"229.97","grams":0,"compare_at_price":"319.99","position":1,"product_id":10866697437451,"created_at":"2026-01-28T18:27:42+02:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":64983693525259,"created_at":"2026-01-29T12:24:20+02:00","position":1,"updated_at":"2026-01-29T12:27:42+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_03dd494e-22fc-4f81-804a-72ce22b4a8e4.png?v=1769682462","width":1500,"height":1500},{"id":64983677796619,"created_at":"2026-01-29T12:22:17+02:00","position":2,"updated_at":"2026-01-29T12:27:42+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_44baf317-ec9d-4646-a93b-fc8d7c360667.png?v=1769682462","width":1500,"height":1500},{"id":64983670292747,"created_at":"2026-01-29T12:21:16+02:00","position":3,"updated_at":"2026-01-29T12:27:42+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_ba59da15-f2db-4569-857c-2d027c70336c.png?v=1769682462","width":1500,"height":1500},{"id":64983693492491,"created_at":"2026-01-29T12:24:20+02:00","position":4,"updated_at":"2026-01-29T12:24:25+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_4cffae5b-137d-4e4b-a1e4-7fd895ffe2cf.png?v=1769682265","width":1500,"height":1500},{"id":64983700341003,"created_at":"2026-01-29T12:25:11+02:00","position":5,"updated_at":"2026-01-29T12:25:15+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_93c41035-fcf6-4632-9735-29d7629c419a.png?v=1769682315","width":1500,"height":1500},{"id":64983714267403,"created_at":"2026-01-29T12:27:17+02:00","position":6,"updated_at":"2026-01-29T12:27:22+02:00","product_id":10866697437451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a6_02621299-58dc-423d-b338-288dbd7a7d87.png?v=1769682442","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10080688603403,"title":"Oglinda LED Organica 60x60cm, Duna Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-uguccione-sistem-dezaburire-60x60cm-colectia-korman","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg.webp?v=1744020565\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:336\"\u003eOglinda LED Organică Duna Touch, cu dimensiunile de aproximativ 60x60 cm (forma organică poate varia ușor față de un pătrat perfect), aduce un element de design fluid și natural în spațiul tău. Spre deosebire de formele rectangulare sau rotunde tradiționale, conturul său neregulat și armonios adaugă un plus de originalitate și finețe.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:246\"\u003eAceastă oglindă este echipată cu \u003cstrong\u003eiluminare LED integrată\u003c\/strong\u003e, urmând linia formei organice, ceea ce creează un efect luminos ambiental distinctiv și elegant. Lumina este distribuită uniform, oferind o iluminare adecvată pentru diverse activități.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:234\"\u003eUn beneficiu important este \u003cstrong\u003esistemul de dezaburire integrat\u003c\/strong\u003e, esențial pentru utilizarea în baie. Acesta asigură că suprafața oglinzii rămâne clară chiar și în condiții de umiditate ridicată, eliminând nevoia de a șterge condensul.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:197\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți oferă control asupra intensității luminoase. Poți ajusta luminozitatea în funcție de preferințe și de necesități, creând atmosfera ideală pentru diferite momente ale zilei.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:255\"\u003eControlul \u003cstrong\u003etactil (Touch)\u003c\/strong\u003e adaugă o notă modernă și intuitivă. Un senzor tactil discret integrat în oglindă permite pornirea\/oprirea iluminării și, probabil, ajustarea intensității luminoase (dacă funcția dimabilă este implementată prin control tactil).\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:404\"\u003eÎn concluzie, Oglinda LED Organică Duna Touch este o alegere sofisticată pentru cei care apreciază designul non-conformist combinat cu tehnologia modernă. Forma sa unică, împreună cu sistemul de dezaburire, funcția dimabilă și controlul tactil, o transformă într-un element central atrăgător și extrem de practic pentru orice baie sau alt spațiu în care dorești să adaugi o notă artistică și funcțională.\u003c\/p\u003e","published_at":"2025-03-17T16:17:07+02:00","created_at":"2025-03-17T14:24:16+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52426002202891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E51S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10080688603403,"created_at":"2025-09-30T01:15:58+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659515158795,"created_at":"2026-07-03T16:21:10+03:00","position":1,"updated_at":"2026-07-03T16:21:13+03:00","product_id":10080688603403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_ccb1b58f-86f6-4fe4-b1c3-bd06f9084f80.webp?v=1783084873","width":800,"height":800},{"id":52727442768139,"created_at":"2025-03-31T13:58:57+03:00","position":2,"updated_at":"2025-03-31T14:27:33+03:00","product_id":10080688603403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_4699c089-ae76-455c-94b0-2eb1067dc521.png?v=1743420453","width":2000,"height":2000},{"id":52727286825227,"created_at":"2025-03-31T13:51:13+03:00","position":3,"updated_at":"2025-03-31T14:27:33+03:00","product_id":10080688603403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_439d9871-dd28-4c5f-8f56-36919af0e814.png?v=1743420453","width":2000,"height":2000},{"id":52727791157515,"created_at":"2025-03-31T14:17:22+03:00","position":4,"updated_at":"2025-03-31T14:27:31+03:00","product_id":10080688603403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_a7998082-9f9d-4790-a703-ec81125b9ae1.png?v=1743420451","width":2000,"height":2000},{"id":64309472821515,"created_at":"2026-01-12T13:27:53+02:00","position":5,"updated_at":"2026-01-12T13:27:56+02:00","product_id":10080688603403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E51S_60X60_EPREL.png?v=1768217276","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779341263115,"title":"Oglinda LED Touch Alexandra,Sistem Dezaburire 45X60cm","handle":"oglinda-led-touch-alexandra-sistem-dezaburire-45x60cm-colectia-korman","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/37