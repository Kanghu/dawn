987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"195\" data-end=\"518\" class=\"\"\u003eOglinda LED Essenza Touch adaugă un plus de funcționalitate și stil oricărui spațiu, fiind ideală pentru baie sau dressing. Cu dimensiunile de 80x60cm și iluminare LED dimabilă, aceasta oferă o reflexie clară și ajustabilă, în timp ce sistemul de dezaburire menține oglinda perfect clară, chiar și în condiții de umiditate.\u003c\/p\u003e\u003cp data-start=\"520\" data-end=\"995\" class=\"\"\u003e✔ \u003cstrong data-start=\"522\" data-end=\"555\"\u003eDimensiuni generoase: 80x60cm\u003c\/strong\u003e – o oglindă de dimensiuni mari pentru o vizibilitate excelentă.\u003cbr data-start=\"619\" data-end=\"622\"\u003e✔ \u003cstrong data-start=\"624\" data-end=\"648\"\u003eSistem de dezaburire\u003c\/strong\u003e – previne condensul, păstrând oglinda impecabilă chiar după duș.\u003cbr data-start=\"713\" data-end=\"716\"\u003e✔ \u003cstrong data-start=\"718\" data-end=\"744\"\u003eIluminare LED dimabilă\u003c\/strong\u003e – reglezi intensitatea luminii pentru un efect perfect, în funcție de moment.\u003cbr data-start=\"822\" data-end=\"825\"\u003e✔ \u003cstrong data-start=\"827\" data-end=\"844\"\u003eTouch control\u003c\/strong\u003e – ușor de operat prin atingere, pentru un design modern și intuitiv.\u003cbr data-start=\"913\" data-end=\"916\"\u003e✔ \u003cstrong data-start=\"918\" data-end=\"948\"\u003eDesign rectangular elegant\u003c\/strong\u003e – se potrivește perfect în orice decor modern.\u003c\/p\u003e","published_at":"2025-04-29T14:03:02+03:00","created_at":"2025-04-15T16:13:58+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52424617853195,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E39S\/80X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10135074701579,"created_at":"2025-09-29T16:36:01+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659725168907,"created_at":"2026-07-03T17:26:41+03:00","position":1,"updated_at":"2026-07-03T17:26:43+03:00","product_id":10135074701579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_695c9b1e-7f33-418a-afd3-acb04255aca6.webp?v=1783088803","width":800,"height":800},{"id":55299917283595,"created_at":"2025-05-10T10:31:02+03:00","position":2,"updated_at":"2025-05-10T10:31:07+03:00","product_id":10135074701579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_4a071c1f-052f-4e60-991f-9b809ab3c5df.png?v=1746862267","width":2000,"height":2000},{"id":55299917316363,"created_at":"2025-05-10T10:31:02+03:00","position":3,"updated_at":"2025-05-10T10:31:07+03:00","product_id":10135074701579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_93d5e471-6f5b-49e3-b244-ef041bbdc573.png?v=1746862267","width":2000,"height":2000},{"id":55299917250827,"created_at":"2025-05-10T10:31:02+03:00","position":4,"updated_at":"2025-05-10T10:31:07+03:00","product_id":10135074701579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_291b35ff-7dce-4478-8c5e-565d787e80bd.png?v=1746862267","width":2000,"height":2000},{"id":69709941866763,"created_at":"2026-07-07T17:55:52+03:00","position":5,"updated_at":"2026-07-07T17:55:56+03:00","product_id":10135074701579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/imagebhjghj.png?v=1783436156","width":1254,"height":1254},{"id":64131097002251,"created_at":"2026-01-05T15:32:34+02:00","position":6,"updated_at":"2026-01-05T15:32:37+02:00","product_id":1013507470