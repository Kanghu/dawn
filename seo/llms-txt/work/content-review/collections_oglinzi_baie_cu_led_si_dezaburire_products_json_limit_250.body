\/5175\/3739\/files\/banner-capac-pvc-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-30T22:10:05+03:00","created_at":"2025-09-22T16:50:28+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman S","tags":["active"],"variants":[{"id":52428927009035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-S04\/70X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":10730538139915,"created_at":"2025-09-30T15:47:01+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":57844549288203,"created_at":"2025-07-25T12:34:25+03:00","position":1,"updated_at":"2025-09-22T16:51:06+03:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_fdfb8c2a-4396-4956-a7bb-a8e42ebfda7e.png?v=1758549066","width":2500,"height":2500},{"id":57844577042699,"created_at":"2025-07-25T12:34:45+03:00","position":2,"updated_at":"2025-09-22T16:51:06+03:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_1a772a15-cd0c-4958-a3d6-41749be07027_1.png?v=1758549066","width":2500,"height":2500},{"id":57844549189899,"created_at":"2025-07-25T12:34:25+03:00","position":3,"updated_at":"2025-09-22T16:51:06+03:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_ae11ede8-a1f5-436f-a98e-0e6778e5e095.png?v=1758549066","width":2500,"height":2500},{"id":57844549222667,"created_at":"2025-07-25T12:34:25+03:00","position":4,"updated_at":"2025-09-22T16:51:06+03:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_726b89f8-7ddb-487c-aabc-875cfafec4a6.png?v=1758549066","width":2500,"height":2500},{"id":57844549255435,"created_at":"2025-07-25T12:34:25+03:00","position":5,"updated_at":"2025-09-22T16:51:06+03:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_d20df73a-f64f-4ca9-ba52-cb621cf20517.png?v=1758549066","width":2500,"height":2500},{"id":64309638299915,"created_at":"2026-01-12T14:05:47+02:00","position":6,"updated_at":"2026-01-12T14:05:50+02:00","product_id":10730538139915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/S04_70X70_EPREL.png?v=1768219550","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10121320038667,"title":"Oglinda LED Rectangulara 80x60 Touch Volta Sistem Dezaburire","handle":"oglinda-led-rectangulara-80x60-touch-volta-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/BUTON.png?v=1752151714\" alt=\"\"\u003e\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e \u003cspan style=\"font-size: 16px;\"\u003eCu un design elegant și tehnologie avansată, aceste oglinzi sunt echipate cu o bandă LED integrată ce aduce o lumină plăcută în orice încăpere. Funcția de reglare a intensității luminii, accesibilă prin menținerea degetului pe butonul de aprindere, permite adaptarea perfectă a luminii la orice situație sau preferință. \u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/DEZABURIRE.png?v=1752152437\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eCu o simplă atingere, utilizatorii pot activa un sistem încorporat care încălzește suprafața oglinzii, prevenind formarea aburului. Acest proces nu numai că asigură claritatea constantă a oglinzii, dar și menține un aspect elegant și curat al acesteia, fără a afecta funcționalitatea sau estetica sa modernă. \u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eIntroduceți în spațiul dumneavoastră Oglinda LED Touch Vesta, o capodoperă de design și tehnologie din Colectia Korman Technik. Cu dimensiuni de 60x80 cm și o formă dreptunghiulară elegantă, oglinda Vesta este o piesă de rezistență care combină estetica modernă cu funcționalitatea avansată.\u003cbr\u003e\u003cbr\u003eOglinda Vesta se remarcă printr-un design simplu, dar sofisticat, fiind ideală pentru a completa orice decor interior, fie că este vorba de o baie modernă sau un spațiu de îmbrăcăminte stilat. Forma sa dreptunghiulară clasică este îmbunătățită de tehnologia LED, care oferă o iluminare rece, eficientă energetic și plăcută pentru activități precum machiajul sau îngrijirea personală. Echipată cu un sistem de dezaburire inteligent, oglinda Vesta asigură o imagine clară și netulburată în orice condiții. Acest lucru este deosebit de util în spațiile cu umiditate crescută, cum ar fi băile, asigurând că oglinda rămâne funcțională și eficientă.\u003cbr\u003e\u003cbr\u003eDesignul său minimalist nu numai că adaugă un aer de rafinament spațiului, dar și optimizează experiența utilizatorului. Prin utilizarea unei tehnologii touch intuitive, oglinda Vesta oferă o modalitate simplă și elegantă de a controla iluminarea, sporind astfel confortul și eficiența zilnică. Alegeți Oglinda LED Touch Vesta pentru a adăuga un element de lux și utilitate în spațiul dumneavoastră. O combinație perfectă de design simplu și tehnologie de ultimă generație, oglinda Vesta din Colectia Korman Technik este alegerea ideală pentru a adăuga un strop de eleganță și funcționalitate oricărui interior.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-04-29T13:53:06+03:00","created_at":"2025-04-07T20:12:00+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52414400200971,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E27S\/80X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"349.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10121320038667,"created_at":"2025-09-26T10:00:30+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55592976187659,"created_at":"2025-05-20T11:09:20+03:00","position":1,"updated_at":"2025-05-20T11:09:23+03:00","product_id":10121320038667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_a433813b-643b-455b-a162-ef80b7dfe713.png?v=1747728563","width":1500,"height":1500},{"id":55593006203147,"created_at":"2025-05-20T11:11:58+03:00","position":2,"updated_at":"2025-05-20T11:14:14+03:00","product_id":10121320038667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_c45cd234-732d-452c-87b2-ac5fbe3427a3.png?v=1747728854","width":1500,"height":1500},{"id":55593024127243,"created_at":"2025-05-20T11:13:13+03:00","position":3,"updated_at":"2025-05-20T11:14:14+03:00","product_id":10121320038667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_a0547959-19fe-4168-b0c3-f536f4783b53.png?v=1747728854","width":1500,"height":1500},{"id":55593006170379,"created_at":"2025-05-20T11:11:58+03:00","position":4,"updated_at":"2025-05-20T11:14:14+03:00","product_id":10121320038667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_9b894da0-3ae6-4f70-86b7-25cb552407cf.png?v=1747728854","width":1500,"height":1500},{"id":64309814788363,"created_at":"2026-01-12T