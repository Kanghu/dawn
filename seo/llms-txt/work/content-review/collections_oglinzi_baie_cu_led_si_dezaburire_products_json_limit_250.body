price":"419.99","position":1,"product_id":10693549916427,"created_at":"2025-09-25T14:13:27+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":62781873979659,"created_at":"2025-11-27T14:30:24+02:00","position":1,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Nov_24_2025_06_04_32_PM_09392a31-7ccb-4490-b61b-87c32e68e506.png?v=1764246639","width":1024,"height":1024},{"id":62781873946891,"created_at":"2025-11-27T14:30:24+02:00","position":2,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Nov_24_2025_05_51_38_PM_39d91e9c-2426-4466-afc5-c9ab502f3fcb.png?v=1764246639","width":1024,"height":1024},{"id":59826966003979,"created_at":"2025-09-03T12:00:57+03:00","position":3,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_c9494008-cc4c-4559-b055-bbfecdc4a7bb.png?v=1764246639","width":3000,"height":3000},{"id":59826966036747,"created_at":"2025-09-03T12:00:57+03:00","position":4,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_4998ebd3-84e9-409c-a310-b4d3767e7538.png?v=1764246639","width":3000,"height":3000},{"id":59826965938443,"created_at":"2025-09-03T12:00:57+03:00","position":5,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_0d70228d-4f11-4d95-888a-f38d4f65b2b2.png?v=1764246639","width":3000,"height":3000},{"id":59826965971211,"created_at":"2025-09-03T12:00:57+03:00","position":6,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_d74229ec-fec9-46aa-8134-0675ee73edfd.png?v=1764246639","width":3000,"height":3000},{"id":59826965905675,"created_at":"2025-09-03T12:00:57+03:00","position":7,"updated_at":"2025-11-27T14:30:39+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_82bc6d5c-45db-4df2-9111-0fdc3f7953ad.png?v=1764246639","width":3000,"height":3000},{"id":64441987105035,"created_at":"2026-01-16T14:18:24+02:00","position":8,"updated_at":"2026-01-16T14:18:27+02:00","product_id":10693549916427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E07S_50X70_EPREL.png?v=1768565907","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10722735816971,"title":"Oglinda LED Rotunda, 80cm, Orbis Touch, Sistem Dezaburire, Dimabila, E31S\/80X80","handle":"oglinda-led-rotunda-80cm-orbis-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"width: 100%; text-align: justify; margin-bottom: 20px;\"\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e \u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-start=\"231\" data-end=\"477\" class=\"\"\u003eCu un diametru de 80 cm, oglinda LED Orbis combină funcționalitatea modernă cu un aspect rafinat. Dotată cu iluminare LED dimabilă și sistem de dezaburire, oferă confort și vizibilitate impecabilă în orice moment, chiar și după un duș fierbinte.\u003c\/p\u003e\n\u003cp data-start=\"479\" data-end=\"773\" class=\"\"\u003eControlul se face simplu și intuitiv printr-un \u003cstrong data-start=\"526\" data-end=\"542\"\u003esenzor Touch\u003c\/strong\u003e, care permite ajustarea intensității luminii în funcție de preferințe. Forma rotundă și finisajul curat transformă această oglindă într-un element central al băii, adaptabil atât în spații contemporane, cât și în cele minimaliste.\u003c\/p\u003e\n\u003cp data-start=\"775\" data-end=\"803\" class=\"\"\u003e\u003cstrong data-start=\"775\" data-end=\"803\"\u003eSpecificații principale:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-start=\"804\" data-end=\"1002\"\u003e\n\u003cli data-start=\"804\" data-end=\"823\" class=\"\"\u003e\u003cp data-start=\"806\" data-end=\"823\" class=\"\"\u003eDiametru: 80 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"824\" data-end=\"862\" class=\"\"\u003e\u003cp data-start=\"826\" data-end=\"862\" class=\"\"\u003eIluminare LED reglabilă (dimabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"863\" data-end=\"888\" class=\"\"\u003e\u003cp data-start=\"865\" data-end=\"888\" class=\"\"\u003eFuncție de dezaburire\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"889\" data-end=\"912\" class=\"\"\u003e\u003cp data-start=\"891\" data-end=\"912\" class=\"\"\u003eActivare prin Touch\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"913\" data-end=\"933\" class=\"\"\u003e\u003cp data-start=\"915\" data-end=\"933\" class=\"\"\u003eMaterial: sticlă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"934\" data-end=\"982\" class=\"\"\u003e\u003cp data-start=\"936\" data-end=\"982\" class=\"\"\u003eInclude oglinda și accesoriile pentru montaj\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"983\" data-end=\"1002\" class=\"\"\u003e\u003cp data-start=\"985\" data-end=\"1002\" class=\"\"\u003eUtilizare: baie\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003e \u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-10-16T18:00:02+03:00","created_at":"2025-09-13T09:56:12+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman 