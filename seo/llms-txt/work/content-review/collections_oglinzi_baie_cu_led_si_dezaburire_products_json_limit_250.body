_5bb33f6a-70d7-4577-aba1-f5aa0848ee73.png?v=1767968823","width":1024,"height":1024},{"id":64250125025547,"created_at":"2026-01-09T16:27:10+02:00","position":3,"updated_at":"2026-01-09T16:27:14+02:00","product_id":10853394350347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H2471eec5669f469493bd08a93c7bf6c77.jpg?v=1767968834","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10722736406795,"title":"Oglinda LED Rotunda, 80cm, VIVO Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-80cm-vivo-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:256\"\u003eOglinda LED rotundă Touch VIVO este o piesă de iluminat modernă și elegantă, cu un diametru de 80 cm. \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:197\"\u003eControlul 'Touch' indică faptul că pornirea\/oprirea luminii și posibil alte funcții (cum ar fi intensitatea luminii, dacă este dimabilă) se realizează prin atingerea unei zone specifice pe oglindă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:141\"\u003eAceastă oglindă ar fi potrivită pentru baie, dormitor sau orice alt spațiu unde dorești o oglindă cu iluminare integrată și un aspect modern.\u003c\/p\u003e","published_at":"2025-10-16T01:26:22+03:00","created_at":"2025-09-13T09:59:21+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52428815171851,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E17S\/80X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"479.99","grams":0,"compare_at_price":"539.99","position":1,"product_id":10722736406795,"created_at":"2025-09-30T15:36:25+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":59826088444171,"created_at":"2025-09-03T10:28:46+03:00","position":1,"updated_at":"2025-09-22T15:41:11+03:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_42e6ffa1-c208-4a5f-9aec-cfe4cb894078.png?v=1758544871","width":3000,"height":3000},{"id":59826088378635,"created_at":"2025-09-03T10:28:46+03:00","position":2,"updated_at":"2025-09-22T15:41:11+03:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_b6751cb9-7d9b-42ec-913d-3f92af2ed991.png?v=1758544871","width":2400,"height":2400},{"id":59826088476939,"created_at":"2025-09-03T10:28:47+03:00","position":3,"updated_at":"2025-09-22T15:41:11+03:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_75dd6595-4a74-4ddc-b729-e1daec50d48a.png?v=1758544871","width":2664,"height":2664},{"id":59826088411403,"created_at":"2025-09-03T10:28:46+03:00","position":4,"updated_at":"2025-09-18T09:34:02+03:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_f54faae2-aa41-4aa3-943a-8b3b26619c12.png?v=1758177242","width":2400,"height":2400},{"id":59826088345867,"created_at":"2025-09-03T10:28:46+03:00","position":5,"updated_at":"2025-09-03T10:29:39+03:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_e7420b0c-7e54-4d47-a884-09736f250206.png?v=1756884579","width":2400,"height":2400},{"id":64309549793547,"created_at":"2026-01-12T13:42:54+02:00","position":6,"updated_at":"2026-01-12T13:42:58+02:00","product_id":10722736406795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E17S_80X80_EPREL.png?v=1768218178","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760706396427,"title":"Oglinda LED Rectangulara, 60x80cm, EDGE Touch, Sistem Dezaburire, Rama Neagra","handle":"oglinda-led-rectangulara-60x80cm-edge-touch-sistem-dezaburire-rama-neagra","body_html":"\u003cp\u003e\u003cimg alt=\"\" style=\"height: auto; width: auto;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperă perfecțiunea în designul modern cu Oglinda LED Touch Incantodoro din prestigioasa Colectie Premium Marcello Funghi. Această oglindă elegantă, cu dimensiuni de 60x80 cm, aduce un echilibru perfect între stil și tehnologie, fiind ideală pentru orice spațiu contemporan.\u003cbr\u003e\u003cbr\u003e\u003cimg alt=\"\" style=\"height: auto; width: auto;\"\u003e Cu o ramă neagră distinctivă și un design simplu, dar elegant, Incantodoro se integrează armonios în orice decor, oferind un punct focal sofisticat. Forma sa dreptunghiulară adaugă o notă de eleganță clasică, în timp ce finisajele moderne subliniază un stil contemporan. Dotată cu un sistem de dezaburire avansat, această oglindă asigură claritatea perfectă chiar și în cele mai umede condiții. Tehnologia LED cu lumina rece nu doar că adaugă un plus de lumină spațiului tău, dar este și extrem de utilă pentru activități precum machiajul sau aranjatul, oferind o iluminare optimă fără a distorsiona culorile.\u003cbr\u003e\u003cbr\u003e\u003cimg alt=\"\" style=\"height: auto; width: auto;\"\u003e Funcția touch integrată face utilizarea oglinzii o experiență plăcută și intuitivă, adăugând un nivel de confort modern. În plus, capacul din PVC de pe spatele oglinzii protejează componentele electrice și asigură durabilitatea produsului. Ambalată cu grijă într-un carton dur și etanș, Oglinda LED Touch Incantodoro este pregătită să ajungă în siguranță la tine, reflectând angajamentul nostru pentru calitate și atenția la detalii.\u003cbr\u003e\u003cbr\u003e\u003cimg alt=\"\" style=\"height: auto; width: auto;\"\u003e Alege Oglinda LED Touch Incantodoro pentru a adăuga un accent de rafinament și funcționalitate avansată în baia sau dressingul tău. Un produs emblematic pentru Colectia Marcello Funghi, care îmbină armonios frumusețea clasică cu inovația modernă.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T03:11:28+02:00","created_at":"2025-02-25T03:11:27+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52429848641803,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E03S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"389.99","grams":0,"compare_at_price":"389.99","position":1,"product_id":9760706396427,"created_at":"2025-09-30T17:36:11+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659404665099,"created_at":"2026-07-03T15:45:18+03:00","position":1,"updated_at":"2026-07-14T14:29:02+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_EDGE_Touch_Sistem_Dezaburire_Rama_Neagra_1.webp?v=1784028542","width":800,"height":800},{"id":69393790959883,"created_at":"2026-06-10T16:22:34+03:00","position":2,"updated_at":"2026-07-14T14:29:18+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_EDGE_Touch_Sistem_Dezaburire_Rama_Neagra_2.png?v=1784028558","width":1920,"height":1920},{"id":69393788207371,"created_at":"2026-06-10T16:21:37+03:00","position":3,"updated_at":"2026-07-14T14:29:35+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_EDGE_Touch_Sistem_Dezaburire_Rama_Neagra_3.png?v=1784028575","width":1920,"height":1920},{"id":69393788240139,"created_at":"2026-06-10T16:21:37+03:00","position":4,"updated_at":"2026-07-14T14:29:52+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_EDGE_Touch_Sistem_Dezaburire_Rama_Neagra_4.png?v=1784028592","width":1920,"height":1920},{"id":69760807174411,"created_at":"2026-07-14T14:27:10+03:00","position":5,"updated_at":"2026-07-14T14:30:08+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_EDGE_Touch_Sistem_Dezaburire_Rama_Neagra_5.png?v=1784028608","width":1024,"height":1024},{"id":69760907706635,"created_at":"2026-07-14T14:40:53+03:00","position":6,"updated_at":"2026-07-14T14:40:55+03:00","product_id":9760706396427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/300bf460bcfc6b3137db9c4009685a79.png?v=1784029255","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760710787339,"title":"Oglinda LED Rectangulara, 60x80cm, RADIANTE Touch, Lumina Rece, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rectangulara-60x80cm-radiante-touch-sistem-dezaburire-dimabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp class=\"p1\"\u003eOglinda LED RADIANTE 60x80cm aduce eleganta moderna si functionalitate inteligenta in baia ta. Cu lumina rece de \u003cspan class=\"s1\"\u003e\u003cb\u003e6000K\u003c\/b\u003e\u003c\/span\u003e, ofera o claritate excelenta pentru machiaj si ingrijire zilnica. Sistemul \u003cspan class=\"s1\"\u003e\u003cb\u003eTouch dimabil\u003c\/b\u003e\u003c\/span\u003e permite ajustarea intensitatii luminii, iar functia \u003cspan class=\"s1\"\u003e\u003cb\u003edezaburire integrata\u003c\/b\u003e\u003c\/span\u003e asigura o vizibilitate perfecta chiar si dupa dus. Designul minimalist cu rama luminoasa creeaza un efect sofisticat, ideal pentru bai contemporane si spatii de design.\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:12:02+02:00","created_at":"2025-02-25T03:12:02+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock","BF2025","BLACKSEASON"],"variants":[{"id":52429936722187,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E09S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"379.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":9760710787339,"created_at":"2025-09-30T17:56:41+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":56792939757835,"created_at":"2025-06-26T17:50:56+03:00","position":1,"updated_at":"2026-07-08T10:07:22+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_1.png?v=1783494442","width":2000,"height":2000},{"id":56792957976843,"created_at":"2025-06-26T17:51:46+03:00","position":2,"updated_at":"2026-07-08T10:07:36+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_2.png?v=1783494456","width":2000,"height":2000},{"id":56792939888907,"created_at":"2025-06-26T17:50:56+03:00","position":3,"updated_at":"2026-07-08T10:07:46+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_3.png?v=1783494466","width":2000,"height":2000},{"id":56792940019979,"created_at":"2025-06-26T17:50:56+03:00","position":4,"updated_at":"2026-07-08T10:07:56+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_4.png?v=1783494476","width":2500,"height":2500},{"id":69713940873483,"created_at":"2026-07-08T10:05:58+03:00","position":5,"updated_at":"2026-07-08T10:08:09+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_5.png?v=1783494489","width":1254,"height":1254},{"id":69713922162955,"created_at":"2026-07-08T10:03:40+03:00","position":6,"updated_at":"2026-07-08T10:08:16+03:00","product_id":9760710787339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_RADIANTE_Touch_Lumina_Rece_Sistem_Dezaburire_Dimabila_6.png?v=1783494496","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759334990091,"title":"Oglinda LED Rectangulara 60x90cm EDGE Touch Sistem Dezaburire, Rama Neagra","handle":"oglinda-led-rectangulara-60x90cm-edge-touch-sistem-dezaburire-rama-neagra","body_html":"\u003cp\u003e\u003cstrong\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e30 000 de ore\u003c\/strong\u003e de functionare! ﻿Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e﻿\u003c\/p\u003e\u003cp\u003e﻿In ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2025-06-30T17:19:24+03:00","created_at":"2025-02-24T23:36:39+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52429855162635,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E03S\/60X90","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"439.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9759334990091,"created_at":"2025-09-30T17:37:58+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":51831872815371,"created_at":"2025-02-24T23:36:41+02:00","position":1,"updated_at":"2025-02-24T23:36:43+02:00","product_id":9759334990091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/oglinda-led-touch-cu-functie-dezaburire-si-ceas-rama-neagra-smack-90x60cm-1738849942.webp?v=1740433003","width":1024,"height":1024},{"id":51831873536267,"created_at":"2025-02-24T23:36:41+02:00","position":2,"updated_at":"2025-02-24T23:36:43+02:00","product_id":9759334990091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2-1738849943.webp?v=1740433003","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760901103883,"title":"Oglinda LED Rotunda 60cm, Flusso Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rotunda-60cm-flusso-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:284\"\u003eIntrodu un element de design fluid și tehnologie modernă în spațiul tău de baie cu oglinda LED Rotundă Flusso Touch. Forma sa circulară elegantă, cu un diametru de 60 cm, aduce o notă de armonie și stil, în timp ce funcțiile inteligente îți oferă confort și control asupra iluminării.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:29\"\u003e\u003cstrong\u003eDesign Fluid și Armonios:\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:220\"\u003eForma rotundă a oglinzii Flusso creează o senzație de curgere și echilibru vizual în baie. Dimensiunea de 60 cm este ideală pentru a oferi o imagine clară și completă, adaptându-se perfect diferitelor dimensiuni de baie.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:53\"\u003e\u003cstrong\u003eTehnologie Intuitivă pentru Confort Personalizat:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-16:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:201\"\u003e\n\u003cstrong\u003eSistem Anti-Aburire Eficient:\u003c\/strong\u003e Menține o suprafață clară și fără condens chiar și după băi fierbinți, datorită sistemului de dezaburire integrat, asigurând o vizibilitate perfectă în orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:168\"\u003e\n\u003cstrong\u003eControl Tactil Sensibil (Touch):\u003c\/strong\u003e Gestionează cu ușurință iluminarea LED printr-o simplă atingere a senzorului tactil, oferind o interacțiune modernă și intuitivă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-16:0\"\u003e\n\u003cstrong\u003eIntensitate Luminoasă Ajustabilă (Dimabilă):\u003c\/strong\u003e Personalizează nivelul de lumină emis de LED-uri pentru a se potrivi diferitelor momente ale zilei și preferințelor tale, creând atmosfera ideală pentru fiecare nevoie.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"17:1-17:42\"\u003e \u003c\/p\u003e","published_at":"2025-02-25T03:48:45+02:00","created_at":"2025-02-25T03:48:45+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52400996483339,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E26S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":9760901103883,"created_at":"2025-09-22T12:36:57+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69697436549387,"created_at":"2026-07-05T00:42:45+03:00","position":1,"updated_at":"2026-07-17T13:56:32+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_1.webp?v=1784285792","width":800,"height":800},{"id":55099607548171,"created_at":"2025-04-30T21:15:41+03:00","position":2,"updated_at":"2026-07-17T13:57:06+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_2.png?v=1784285826","width":2000,"height":2000},{"id":55099607580939,"created_at":"2025-04-30T21:15:41+03:00","position":3,"updated_at":"2026-07-17T13:57:17+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_3.png?v=1784285837","width":2000,"height":2000},{"id":55099679998219,"created_at":"2025-04-30T21:21:37+03:00","position":4,"updated_at":"2026-07-17T13:57:28+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_4.png?v=1784285848","width":2000,"height":2000},{"id":55099607875851,"created_at":"2025-04-30T21:15:41+03:00","position":5,"updated_at":"2026-07-17T13:57:40+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_5.png?v=1784285860","width":2000,"height":2000},{"id":64309290107147,"created_at":"2026-01-12T12:58:30+02:00","position":6,"updated_at":"2026-07-17T13:57:51+03:00","product_id":9760901103883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rotunda_60cm_Flusso_Touch_Sistem_Dezaburire_Dimabila_7.png?v=1784285871","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10138666270987,"title":"Oglinda LED Ovala, 50x100cm, Velara Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-ovala-50x100cm-velara-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cstrong\u003ek\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003eOglinda LED\u003c\/strong\u003e este intr-adevar un accesoriu modern special proiectat pentru baile cu o amenajare minimalista. Foarte practica si definita de un design aparte, aceasta va reusi sa te impresioneze inca de la prima utilizare!\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eLED-urile\u003c\/strong\u003e, aflate pe marginile oglinzii, reprezinta una dintre cele mai eficiente metode de iluminat, preferata in ultimii ani de catre tot mai multe persoane gratie \u003cstrong\u003econsumului redus de energie\u003c\/strong\u003e si autonomiei extinse, de pana la \u003cstrong\u003e30 000 de ore\u003c\/strong\u003e de functionare! Acestea distribuie o lumina neutra, apropiata de lumina naturala, astfel ca privirea ta nu va avea de suferit atunci cand petreci o perioada mai lunga de timp in fata oglinzii. Pentru a te bucura de aceasta, este de ajuns sa apesi pe butonul aflat in partea centrala a oglinzii, iar LED-urile vor fi puse instant in functiune. In cazul in care nivelul de lumina este prea puternic sau din contra, prea scazut, ai si posibilitatea de a ajusta intensitatea sa.\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003cp\u003eIn ceea ce priveste functia de dezaburire, aceasta este necesara de fiecare data cand aburii rezultati in urma dusului fierbinte acapareaza intreaga suprafata a oglinzii. Apasarea pe butonul special conceput pentru aceasta functie va activa in doar cateva secunde procesul de dezaburire al oglinzii.\u003c\/p\u003e","published_at":"2025-04-29T14:16:40+03:00","created_at":"2025-04-16T17:53:34+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52399171895563,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E06S\/50X100","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10138666270987,"created_at":"2025-09-21T17:16:47+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69283333341451,"created_at":"2026-06-03T13:03:56+03:00","position":1,"updated_at":"2026-06-03T13:04:02+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_b8af4e5f-9790-450d-aabf-9f4c33e87a79.png?v=1780481042","width":3000,"height":3000},{"id":69283333406987,"created_at":"2026-06-03T13:03:56+03:00","position":2,"updated_at":"2026-06-03T13:04:03+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_8a75a4b9-542b-4f9f-adc9-e30dc8cf4a0c.png?v=1780481043","width":3000,"height":3000},{"id":69283512647947,"created_at":"2026-06-03T13:43:37+03:00","position":3,"updated_at":"2026-06-03T13:43:41+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1b7e4873-463e-4540-a91d-a8fff9a3384f.png?v=1780483421","width":1254,"height":1254},{"id":69283333374219,"created_at":"2026-06-03T13:03:56+03:00","position":4,"updated_at":"2026-06-03T13:04:02+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_41979bdb-0031-4325-9f52-0699fd94fbd0.png?v=1780481042","width":3000,"height":3000},{"id":69283518218507,"created_at":"2026-06-03T13:45:19+03:00","position":5,"updated_at":"2026-06-03T13:45:23+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/09526214-d4dd-4c19-aeec-38bef9d1ba3e.png?v=1780483523","width":1254,"height":1254},{"id":69283333439755,"created_at":"2026-06-03T13:03:56+03:00","position":6,"updated_at":"2026-06-03T13:04:02+03:00","product_id":10138666270987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_ea7fd4ae-b9cd-439d-8c2c-0d6cf88fd3fd.png?v=1780481042","width":3000,"height":3000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10135094722827,"title":"Oglinda LED Rectangulara, 60x80cm, CANTO Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-rectangulara-60x80cm-canto-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\"\u003e\u003c\/p\u003e\u003cp class=\"\"\u003eOglinda LED Magia Canto Touch combină tehnologia avansată cu un design elegant, oferindu-ți o reflecție clară și perfect iluminată. Cu dimensiunile de 60x80cm și opțiunea de iluminare dimabilă, aceasta este ideală pentru baie, dormitor sau dressing. Sistemul de dezaburire asigură o vizibilitate impecabilă chiar și în condiții de umiditate.\u003c\/p\u003e\u003cp class=\"\"\u003e✔ \u003cstrong\u003eDimensiune 60x80cm\u003c\/strong\u003e – o oglindă de dimensiuni medii, potrivită pentru orice încăpere.\u003cbr\u003e✔ \u003cstrong\u003eSistem de dezaburire integrat\u003c\/strong\u003e – menține oglinda clară și funcțională chiar și după un duș cald.\u003cbr\u003e✔ \u003cstrong\u003eIluminare LED dimabilă\u003c\/strong\u003e – reglezi intensitatea luminii pentru confortul dorit, fie pentru un machiaj precis, fie pentru o atmosferă relaxantă.\u003cbr\u003e✔ \u003cstrong\u003eDesign rectangular elegant\u003c\/strong\u003e – se potrivește perfect în orice decor contemporan, adăugând un plus de stil și rafinament.\u003c\/p\u003e","published_at":"2025-04-29T14:05:11+03:00","created_at":"2025-04-15T16:43:38+03:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active","All Stock"],"variants":[{"id":52429423640843,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E39S\/60X80","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10135094722827,"created_at":"2025-09-30T16:16:24+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55300653154571,"created_at":"2025-05-10T11:28:35+03:00","position":1,"updated_at":"2026-07-07T17:49:48+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_1.png?v=1783435788","width":2000,"height":2000},{"id":55300653252875,"created_at":"2025-05-10T11:28:35+03:00","position":2,"updated_at":"2026-07-07T17:49:59+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_2.png?v=1783435799","width":2000,"height":2000},{"id":55300653187339,"created_at":"2025-05-10T11:28:35+03:00","position":3,"updated_at":"2026-07-07T17:50:10+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_3.png?v=1783435810","width":2000,"height":2000},{"id":55300653285643,"created_at":"2025-05-10T11:28:35+03:00","position":4,"updated_at":"2026-07-07T17:50:22+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_4.png?v=1783435822","width":2000,"height":2000},{"id":69709926170891,"created_at":"2026-07-07T17:48:08+03:00","position":5,"updated_at":"2026-07-07T17:50:40+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_6.png?v=1783435840","width":1254,"height":1254},{"id":64309521744139,"created_at":"2026-01-12T13:35:18+02:00","position":6,"updated_at":"2026-07-07T17:50:50+03:00","product_id":10135094722827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rectangulara_60x80cm_CANTO_Touch_Sistem_Dezaburire_Dimabila_7.png?v=1783435850","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760304169227,"title":"Oglinda LED Rectangulara, 50x70cm,  KOVEN Touch, Sistem Dezaburire,Dimabila","handle":"oglinda-led-rectangulara-50x70cm-koven-touch-sistem-dezaburiredimabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"a29d4ed611250880\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c130506317-43 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c130506317-43\"\u003e\u003cdiv class=\"response-container-content ng-tns-c130506317-43\"\u003e\u003cdiv class=\"response-content ng-tns-c130506317-43\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_a29d4ed611250880\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:365\"\u003eOglinda LED Rectangulară Koven Touch, cu dimensiunile de 50x70 cm, îmbină eleganța unui design simplu cu funcționalități moderne pentru a-ți îmbunătăți rutina zilnică. Forma sa dreptunghiulară, cu proporții echilibrate, se potrivește armonios în diverse stiluri de amenajare interioară, fiind ideală pentru baie, dar putând fi integrată cu succes și în alte spații.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:308\"\u003eUn aspect esențial al acestei oglinzi este \u003cstrong\u003esistemul de dezaburire integrat\u003c\/strong\u003e. Această caracteristică elimină problema condensului care se formează pe suprafața oglinzii în timpul sau după utilizarea apei calde, asigurând o imagine clară și neobstrucționată. Nu vei mai pierde timp ștergând oglinda aburită!\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:251\"\u003e\u003cstrong\u003eIluminarea LED\u003c\/strong\u003e integrată oferă o lumină clară și uniformă, perfectă pentru activități precum machiajul, bărbieritul sau îngrijirea personală. Tehnologia LED este, de asemenea, eficientă din punct de vedere energetic și are o durată de viață lungă.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:233\"\u003eDenumirea 'Touch' sugerează prezența unui \u003cstrong\u003esenzor tactil\u003c\/strong\u003e pentru a controla iluminarea. Acest lucru înseamnă că poți porni sau opri lumina cu o simplă atingere a suprafeței oglinzii, adăugând un plus de confort și un aspect modern.\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:254\"\u003eÎn concluzie, Oglinda LED Rectangulară Koven Touch este o alegere excelentă dacă dorești o oglindă practică, cu funcții moderne esențiale precum sistemul de dezaburire și iluminarea LED controlată tactil, toate integrate într-un design simplu și elegant.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv class=\"container hidden ng-star-inserted\"\u003e\u003cbr\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T02:13:07+02:00","created_at":"2025-02-25T02:13:06+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52428569608459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E37S\/50X70","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":9760304169227,"created_at":"2025-09-30T14:25:57+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":55281733468427,"created_at":"2025-05-09T14:57:36+03:00","position":1,"updated_at":"2025-11-12T00:33:24+02:00","product_id":9760304169227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_71c4e260-24ee-4ae7-9219-2027cd07cc81.png?v=1762900404","width":2000,"height":2000},{"id":55281840816395,"created_at":"2025-05-09T15:06:03+03:00","position":2,"updated_at":"2025-11-12T00:33:24+02:00","product_id":9760304169227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_6a4d5233-4637-4e0d-9a61-54a788f8a41c.png?v=1762900404","width":1214,"height":1214},{"id":55281733435659,"created_at":"2025-05-09T14:57:36+03:00","position":3,"updated_at":"2025-11-12T00:33:24+02:00","product_id":9760304169227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_6bb91098-2e88-48d0-9773-d1b74ed4c0e9.png?v=1762900404","width":2000,"height":2000},{"id":55281