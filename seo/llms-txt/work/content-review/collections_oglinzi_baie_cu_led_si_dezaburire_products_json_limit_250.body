nt_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_a30cf024-f0c4-4b55-b69f-00c1ca9c48d7.jpg?v=1760842675","width":3000,"height":3000},{"id":59876444111115,"created_at":"2025-09-05T14:12:11+03:00","position":4,"updated_at":"2025-10-19T05:57:55+03:00","product_id":9779342377227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_7063f06a-353d-4189-b9e6-19a6f30d0873.jpg?v=1760842675","width":3000,"height":3000},{"id":59876444012811,"created_at":"2025-09-05T14:12:11+03:00","position":5,"updated_at":"2025-10-19T05:57:55+03:00","product_id":9779342377227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_259749dc-a3ec-483e-a3c1-c48ee0808a7e.jpg?v=1760842675","width":3000,"height":3000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779341426955,"title":"Oglinda LED Rentagulara, 45x60cm, Touch VENERA , Sistem Dezaburire,Dimabila","handle":"oglinda-led-rentagulara-45x60cm-touch-venera-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"0\" data-end=\"333\"\u003eOglinda LED VENERA este soluția ideală pentru băi moderne, oferind un echilibru perfect între funcționalitate și design elegant. Cu dimensiuni compacte de 45x60 cm și iluminare LED integrată, această oglindă asigură vizibilitate optimă în orice moment al zilei.\u003c\/p\u003e\u003cp data-start=\"335\" data-end=\"526\"\u003eActivarea iluminării se face printr-un buton tactil (Touch), iar sistemul integrat de dezaburire menține suprafața clară chiar și după dușuri fierbinți, eliminând condensul rapid și eficient.\u003c\/p\u003e\u003cp data-start=\"528\" data-end=\"826\"\u003e\u003cstrong data-start=\"528\" data-end=\"558\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003cbr data-start=\"558\" data-end=\"561\"\u003e– Dimensiuni: 45x60 cm – ideală pentru băi mici și medii\u003cbr data-start=\"617\" data-end=\"620\"\u003e– Iluminare LED cu activare prin buton Touch\u003cbr data-start=\"664\" data-end=\"667\"\u003e– Sistem de dezaburire integrat pentru confort sporit\u003cbr data-start=\"720\" data-end=\"723\"\u003e– Design modern, cu margini curate și finisaj elegant\u003cbr data-start=\"776\" data-end=\"779\"\u003e– Montaj facil, eficiență energetică ridicată\u003c\/p\u003e","published_at":"2025-07-23T11:26:06+03:00","created_at":"2025-03-06T18:38:29+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman E","tags":["active","BF2025"],"variants":[{"id":52423710671115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E21S\/45X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9779341426955,"created_at":"2025-09-29T10:26:18+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":62651799240971,"created_at":"2025-11-24T14:05:35+02:00","position":1,"updated_at":"2026-07-17T13:50:41+03:00","product_id":9779341426955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rentagulara_60x80cm_Touch_VENERA_Sistem_Dezaburire_Dimabila_8.png?v=1784285441","width":2400,"height":2400},{"id":57540668391691,"created_at":"2025-07-22T18:12:54+03:00","position":2,"updated_at":"2026-07-17T13:49:26+03:00","product_id":9779341426955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Oglinda_LED_Rentagulara_60x80cm_Touch_VENERA_Sistem_Dezaburire_Dimabila_2.png?v=1784285366","width":2000,"height