:[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10080706691339,"title":"Oglinda LED Semiluna 50x100cm, Arcuat Touch, Sistem Dezaburire, Dimabila","handle":"oglinda-led-semiluna-50x100cm-arcuat-touch-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1744020308\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:82\"\u003e\u003cstrong\u003eOglindă LED Semiluna  Touch: Un Flux Luminos și Inteligent pentru Baia Ta\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:284\"\u003eIntrodu un element de design fluid și tehnologie modernă în spațiul tău de baie cu oglinda LED Rotundă Flusso Touch. Forma sa circulară elegantă, cu un diametru de 60 cm, aduce o notă de armonie și stil, în timp ce funcțiile inteligente îți oferă confort și control asupra iluminării.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:29\"\u003e\u003cstrong\u003eDesign Fluid și Armonios:\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:220\"\u003eForma rotundă a oglinzii Flusso creează o senzație de curgere și echilibru vizual în baie. Dimensiunea de 60 cm este ideală pentru a oferi o imagine clară și completă, adaptându-se perfect diferitelor dimensiuni de baie.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:53\"\u003e\u003cstrong\u003eTehnologie Intuitivă pentru Confort Personalizat:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-16:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:201\"\u003e\n\u003cstrong\u003eSistem Anti-Aburire Eficient:\u003c\/strong\u003e Menține o suprafață clară și fără condens chiar și după băi fierbinți, datorită sistemului de dezaburire integrat, asigurând o vizibilitate perfectă în orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:168\"\u003e\n\u003cstrong\u003eControl Tactil Sensibil (Touch):\u003c\/strong\u003e Gestionează cu ușurință iluminarea LED printr-o simplă atingere a senzorului tactil, oferind o interacțiune modernă și intuitivă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-16:0\"\u003e\n\u003cstrong\u003eIntensitate Luminoasă Ajustabilă (Dimabilă):\u003c\/strong\u003e Personalizează nivelul de lumină emis de LED-uri pentru a se potrivi diferitelor momente ale zilei și preferințelor tale, creând atmosfera ideală pentru fiecare nevoie.\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-03-17T16:56:07+02:00","created_at":"2025-03-17T14:28:57+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Korman Technik","product_type":"Oglinzi Korman E","tags":["active"],"variants":[{"id":52399159312651,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E52S\/50X100","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"489.99","grams":0,"compare_at_price":"489.99","position":1,"product_id":10080706691339,"created_at":"2025-09-21T17:06:42+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":52841468821771,"created_at":"2025-04-02T19:11:54+03:00","position":1,"updated_at":"2025-04-02T19:12:17+03:00","product_id":10080706691339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_d5a5677e-ee29-46fd-82e1-5105cb9811a7.png?v=1743610337","width":2000,"height":2000},{"id":52841348366603,"created_at":"2025-04-02T19:04:50+03:00","position":2,"updated_at":"2025-04-02T19:12:17+03:00","product_id":10080706691339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_bf6885ad-75df-4c95-b05c-cfafaf053fc2.png?v=1743610337","width":2000,"height":2000},{"id":52841347711243,"created_at":"2025-04-02T19:04:47+03:00","position":3,"updated_at":"2025-04-02T19:12:17+03:00","product_id":10080706691339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_d7bc0ec3-ec69-45e0-91b1-4685120ce0a2.png?v=1743610337","width":2000,"height":2000},{"id":69725237281035,"created_at":"2026-07-10T10:19:11+03:00","position":4,"updated_at":"2026-07-10T10:19:13+03:00","product_id":10080706691339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2786821_big_color.png?v=1783667953","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779343261963,"title":"Oglinda LED Touch LUSSO, Sistem Dezaburire, Ceas si Temperatura, Diametru 60cm, Rama Auriu Brushed, Lumina Calda Rece Neutra 3000K\/4500K\/6000K, Dimabila","handle":"oglinda-led-touch-lusso-sistem-dezaburire-ceas-si-temperatura-60-cm-rama-auriu-brushed","body_html":"\u003cp\u003eOglindă LED Touch LUSSO cu sistem de dezaburire, ceas digital și afișaj temperatură, cu lățime de 60 cm și ramă aurie Brushed.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eControl tactil intuitiv pentru iluminare și funcții adiționale, iluminare uniformă și eficientă. Funcția de dezaburire menține oglinda clară după dușuri aburite.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eDesign modern și elegant, potrivit pentru băi contemporane și spații de toaletă sofisticate.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-3tipuri-lumina-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eCombinație de estetică premium și funcționalitate practică pentru rutina de îngrijire zilnică.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-ceas-termometru-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-capac-pvc-oglinda.jpg?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-22T22:29:25+03:00","created_at":"2025-03-06T18:41:38+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman S","tags":["active","Oglinzi draft count"],"variants":[{"id":52429824753931,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-S04\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"439.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":9779343261963,"created_at":"2025-09-30T17:26:41+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69659768062219,"created_at":"2026-07-03T17:37:40+03:00","position":1,"updated_at":"2026-07-03T17:37:43+03:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_17d3856e-1121-4efa-8e7b-85740d2ae5ef.webp?v=1783089463","width":800,"height":800},{"id":60427440193803,"created_at":"2025-09-18T10:52:48+03:00","position":2,"updated_at":"2025-09-18T10:55:43+03:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_1_131d91ef-932c-4f1d-91e9-cc18d6538b8a.png?v=1758182143","width":2500,"height":2500},{"id":60427440226571,"created_at":"2025-09-18T10:52:48+03:00","position":3,"updated_at":"2025-09-18T10:55:43+03:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_f7e5b530-c47c-4156-adda-d4256ec59e4d.png?v=1758182143","width":2500,"height":2500},{"id":60427440292107,"created_at":"2025-09-18T10:52:48+03:00","position":4,"updated_at":"2025-09-18T10:55:43+03:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_196d1c13-6e4f-4f31-9280-e975503bd2e8.png?v=1758182143","width":2500,"height":2500},{"id":60427440324875,"created_at":"2025-09-18T10:52:48+03:00","position":5,"updated_at":"2025-09-18T10:55:43+03:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_ff65fcc1-5e14-44f1-9b2e-4c208b36f068.png?v=1758182143","width":2500,"height":2500},{"id":64309617852683,"created_at":"2026-01-12T14:00:40+02:00","position":6,"updated_at":"2026-01-12T14:00:42+02:00","product_id":9779343261963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/S04_60X60_EPREL.png?v=1768219242","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779341820171,"title":"Oglinda LED Touch Fiero Sistem Dezaburire 60X60cm","handle":"oglinda-led-touch-fiero-sistem-dezaburire-60x60cm-colectia-korman","body_html":"\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\"\u003e\u003c\/p\u003e\u003cp\u003eModernă, elegantă și extrem de practică, oglinda LED Touch Fiero 60x60 cm este alegerea ideală pentru băile contemporane în care funcționalitatea și designul merg mână în mână. Cu un format pătrat și iluminare LED perimetrală, aceasta oferă un plus de lumină și rafinament oricărui spațiu.\u003c\/p\u003e\u003cp\u003eEchipată cu tehnologie touch, oglinda permite controlul rapid al iluminării și activarea funcției de dezaburire printr-o simplă atingere. Lumina LED este uniform distribuită și eficientă energetic, fiind ideală pentru activități zilnice precum machiajul sau bărbieritul. În plus, intensitatea luminii poate fi ajustată în funcție de preferințe, pentru un confort optim în orice moment al zilei.\u003c\/p\u003e\u003cp\u003eFuncția de dezaburire integrată asigură o vizibilitate perfectă chiar și după dușuri fierbinți, eliminând condensul și nevoia de ștergere manuală. Designul slim, cu finisaj modern și iluminare elegantă, transformă oglinda într-un element decorativ de impact, potrivit atât pentru băi rezidențiale, cât și pentru spații premium.\u003c\/p\u003e\u003chr\u003e\u003ch3\u003e✔️ Caracteristici principale:\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eDimensiuni: 60 x 60 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIluminare LED perimetrală – lumină clară și uniformă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSistem touch – control intuitiv (ON\/OFF, reglare lumină)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eFuncție dezaburire – vizibilitate fără condens\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIntensitate luminoasă reglabilă (dimabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDesign modern, formă pătrată\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eAlimentare: 220–230V\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDurată de viață LED: până la 25.000h\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-10-22T22:21:34+03:00","created_at":"2025-03-06T18:39:06+02:00","updated_at":"2026-09-14T13:11:40+03:00","vendor":"Alessandro Design","product_type":"Oglinzi Korman E","tags":["active","Oglinzi draft count"],"variants":[{"id":52429875216651,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-OG1D-E81S\/60X60","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"539.99","grams":0,"compare_at_price":"539.99","position":1,"product_id":9779341820171,"created_at":"2025-09-30T17:46:48+03:00","updated_at":"2026-09-14T13:11:40+03:00"}],"images":[{"id":69697432486155,"created_at":"2026-07-05T00:39:57+03:00","position":1,"updated_at":"2026-07-05T00:40:00+03:00","product_id":9779341820171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_625ac51e-8467-43e4-a562-70cd66cfe9ee.webp?v=1783201200","width":800,"height":800},{"id":60815672803595,"created_at":"2025-09-30T14:58:28+03:00","position":2,"updated_at":"2025-09-30T15:01:45+03:00","product_id":9779341820171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_094ef3c8-15a3-4943-b33a-ba27ba6b4b23.png?v=1759233705","width":2000,"height":2000},{"id":60815655829771,"created_at":"2025-09-30T14:57:01+03:00","position":3,"updated_at":"2025-09-30T15:01:45+03:00","product_id":9779341820171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_2e17c092-6f72-4b7d-ae21-204024e008f0.png?v=1759233705","width":2000,"height":2000},{"id":64309252849931,"created_at":"2026-01-12T12:51:12+02:00","position":4,"updated_at":"2026-01-12T12:51:16+02:00","product_id":9779341820171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/E81S_60X60_EPREL.png?v=1768215076","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779341328651,"title":"Oglinda LED Rentagulara, 80x60cm, Touch VENERA , Sistem Dezaburire,Dimabila","handle":"oglinda-led-rentagulara-80x60cm-touch-venera-sistem-dezaburire-dimabila","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-led-touch-oglinda.jpg?v=1746027766\" alt=\"\"\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-dezaburire-oglinda_jpg_f4354e32-5260-48d0-b717-be314e4fe56e.webp?v=1744028987\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-22