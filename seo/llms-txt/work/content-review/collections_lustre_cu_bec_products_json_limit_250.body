6ba-4002-ac52-c4b6c3799a01.png?v=1778234075","width":1000,"height":1000},{"id":68771739828491,"created_at":"2026-05-08T12:54:31+03:00","position":9,"updated_at":"2026-05-08T12:54:35+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._PLACE_1_1ad106a0-697d-4a83-b5cf-f74c09fff6cd.png?v=1778234075","width":1000,"height":1000},{"id":68771739861259,"created_at":"2026-05-08T12:54:31+03:00","position":10,"updated_at":"2026-05-08T12:54:35+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._PLACE_2_476a1672-47e2-4821-9993-84fe1b856511.png?v=1778234075","width":1000,"height":1000},{"id":68771739762955,"created_at":"2026-05-08T12:54:31+03:00","position":11,"updated_at":"2026-05-08T12:54:35+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._PLACE_3_d8b1747e-7f2d-4d78-b244-1838578b697d.png?v=1778234075","width":1000,"height":1000},{"id":68771739959563,"created_at":"2026-05-08T12:54:31+03:00","position":12,"updated_at":"2026-05-08T12:54:35+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15._PLACE_4_32a66667-0001-4858-9bf6-45b507fa0d70.png?v=1778234075","width":1000,"height":1000},{"id":62998785392907,"created_at":"2025-12-04T14:06:34+02:00","position":13,"updated_at":"2025-12-08T15:43:56+02:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT800_3BK_EPREL.png?v=1765201436","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757628334347,"title":"Lustra LED cu telecomanda ORCHID 40W, 3 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-orchid-40w-3-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"a773d64698b34739\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c1310598610-46 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1310598610-46\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1310598610-46\"\u003e\u003cdiv class=\"response-content ng-tns-c1310598610-46\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_a773d64698b34739\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:275\"\u003eAceastă lustră LED cu telecomandă ORCHID, de 40W și culoare albă, aduce un design floral delicat și o iluminare versatilă în casa ta . Inspirată de frumusețea orhideelor, cu cele 3 petale stilizate, această lustră va deveni un punct focal elegant în orice încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"1:1-1:275\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:31\"\u003e\u003cstrong\u003eCaracteristici remarcabile:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"5:1-15:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:60\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 40W, oferind o iluminare eficientă și plăcută.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:94\"\u003e\n\u003cstrong\u003eDesign floral:\u003c\/strong\u003e Cu 3 'petale' luminoase, adaugă o notă organică și sofisticată spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:200\"\u003e\n\u003cstrong\u003eTip de lumină ajustabil:\u003c\/strong\u003e Poți alege între lumină rece, caldă sau neutră, creând atmosfera ideală pentru diverse activități și momente ale zilei, indiferent dacă te relaxezi sau primești oaspeți.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:142\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii poate fi reglată cu ușurință prin telecomanda inclusă, permițându-ți să personalizezi ambianța luminoasă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:239\"\u003e\n\u003cstrong\u003eControl comod:\u003c\/strong\u003e Telecomanda oferă control complet asupra temperaturii culorii și a intensității luminii. Lustra poate fi controlată și prin intermediul întrerupătorului clasic (prin apăsări succesive pentru a schimba tipul de lumină).\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:181\"\u003e\n\u003cstrong\u003eEstetică elegantă:\u003c\/strong\u003e Culoarea albă și designul inspirat de natură se integrează armonios în diverse stiluri de interior, adăugând o notă de rafinament locuinței tale .\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:83\"\u003e\n\u003cstrong\u003eFlux luminos optim:\u003c\/strong\u003e Asigură o iluminare confortabilă și adecvată a încăperii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:131\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață îndelungată, contribuind la reducerea consumului de energie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-13:79\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție solidă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu instrucțiuni clare pentru o montare ușoară.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"16:1-16:272\"\u003eImaginează-ți această lustră ORCHID în livingul sau dormitorul tău , răspândind o lumină blândă și creând un ambient relaxant. Designul său unic va atrage cu siguranță complimente, iar funcționalitatea telecomenzii îți va oferi control total asupra iluminatului.\u003c\/p\u003e\n\u003cp data-sourcepos=\"16:1-16:272\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-02-24T17:22:51+02:00","created_at":"2025-02-24T17:22:51+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429930594571,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT280\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"99.79","grams":0,"compare_at_price":"119.99","position":1,"product_id":9757628334347,"created_at":"2025-09-30T17:55:50+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70067076071691,"created_at":"2026-09-08T13:30:27+03:00","position":1,"updated_at":"2026-09-08T13:30:56+03:00","product_id":9757628334347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_ORCHID_40W_3_Petale_lumina_Rece_Calda_Neutra_Dimabila_Alb_1.png?v=1788863456","width":1254,"height":1254},{"id":69876297466123,"created_at":"2026-08-04T23:35:21+03:00","position":2,"updated_at":"2026-08-04T23:35:24+03:00","product_id":9757628334347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/017_17_LT280-3WH.webp?v=1785875724"