":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_BANDO_39W_2_Patrate_Lumina_Rece_Calda_Neutra_Dimabila_Negru_Metal_si_Acril5.png?v=1783330194","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10990771175691,"title":"Lustra LED STARK, 20W, Diametru 19cm, Lumina Calda\/Neutra\/Rece, Alb, Metal si Acril","handle":"lustra-led-stark-20w-diametru-19cm-lumina-calda-neutra-rece-alb-metal-si-cristal","body_html":"\u003cp data-sourcepos=\"1:1-1:272\"\u003e\u003cstrong\u003eLustra LED STARK \u003c\/strong\u003eeste o piesă de iluminat modernă și funcțională, cu o putere de 20W și dimensiuni de 19x19 cm. Designul său liniar include un proiector reglabil, totul finisat în alb. Oferă posibilitatea de a alege între lumină rece, caldă sau neutră.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:345\"\u003eForma rectangulara a lustrei si diametrul de 19 cm indică o prezență vizuală semnificativă. Finisajul alb îi conferă un aspect industrial sau modern.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:132\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-06-29T14:54:08+03:00","created_at":"2026-06-29T10:14:58+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":53210320109835,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL731","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"149.99","grams":0,"compare_at_price":"129.99","position":1,"