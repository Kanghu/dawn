,"product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LT500-3WH.webp?v=1785875766","width":1254,"height":1254},{"id":69876299170059,"created_at":"2026-08-04T23:36:03+03:00","position":6,"updated_at":"2026-08-04T23:36:05+03:00","product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LT500-3WH.webp?v=1785875765","width":1254,"height":1254},{"id":69876299235595,"created_at":"2026-08-04T23:36:03+03:00","position":7,"updated_at":"2026-08-04T23:36:06+03:00","product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LT500-3WH.webp?v=1785875766","width":1254,"height":1254},{"id":69876299268363,"created_at":"2026-08-04T23:36:03+03:00","position":8,"updated_at":"2026-08-04T23:36:06+03:00","product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LT500-3WH.webp?v=1785875766","width":1254,"height":1254},{"id":69876299399435,"created_at":"2026-08-04T23:36:03+03:00","position":9,"updated_at":"2026-08-04T23:36:06+03:00","product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LT500-3WH.webp?v=1785875766","width":1254,"height":1254},{"id":69876299432203,"created_at":"2026-08-04T23:36:03+03:00","position":10,"updated_at":"2026-08-04T23:36:06+03:00","product_id":9757584523531,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT500-3WH.webp?v=1785875766","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10730332324107,"title":"Lustra LED cu Telecomanda LT660\/5BK, 5 Elemente, 55W, Lumina 3000\/4000\/6000K, Negru","handle":"lustra-led-lt660-5bk-5-elemente-54w-lumina-3000-4000-6000k-negru-inaltime-reglabila","body_html":"\u003cp\u003eLustra LED \u003cstrong\u003eLT660\/5BK\u003c\/strong\u003e se remarcă prin designul său modern și versatil, ideal pentru interioare contemporane. Cu \u003cstrong\u003e5 elemente elegante\u003c\/strong\u003e și finisaj \u003cstrong\u003enegru mat\u003c\/strong\u003e, devine un punct de atracție în orice încăpere. Puterea de \u003cstrong\u003e55W LED integrat\u003c\/strong\u003e oferă iluminare eficientă și reglabilă pe trei trepte de temperatură a luminii: \u003cstrong\u003e3000K (caldă), 4000K (neutră), 6000K (rece)\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e✔ \u003cstrong\u003ePutere:\u003c\/strong\u003e 55W LED integrat\u003cbr\u003e✔ \u003cstrong\u003eTemperatură culoare:\u003c\/strong\u003e 3000K \/ 4000K \/ 6000K\u003cbr\u003e✔ \u003cstrong\u003eDesign:\u003c\/strong\u003e 5 elemente moderne, finisaj negru elegant\u003cbr\u003e✔ \u003cstrong\u003eMaterial:\u003c\/strong\u003e Metal + Acril\u003cbr\u003e✔ \u003cstrong\u003eUtilizare:\u003c\/strong\u003e Living, dining, dormitor, birou, spații moderne\u003c\/p\u003e\u003cp\u003eAceastă lustra suspendată combină \u003cstrong\u003estilul minimalist\u003c\/strong\u003e cu \u003cstrong\u003eeficiența energetică\u003c\/strong\u003e, aducând un plus de rafinament și funcționalitate.\u003c\/p\u003e","published_at":"2025-11-20T12:42:08+02:00","created_at":"2025-09-22T12:37:44+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat"],"variants":[{"id":52412038709515,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT660\/5BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":10730332324107,"created_at":"2025-09-25T15:53:09+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60558576713995,"created_at":"2025-09-22T12:50:45+03:00","position":1,"updated_at":"2026-09-08T14:46:37+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_LT660_5BK_5_Elemente_55W_Lumina_3000_4000_6000K_Negru_1.jpg?v=1788867997","width":4500,"height":4500},{"id":70067420430603,"created_at":"2026-09-08T14:45:58+03:00","position":2,"updated_at":"2026-09-08T14:46:49+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_LT660_5BK_5_Elemente_55W_Lumina_3000_4000_6000K_Negru_2.png?v=1788868009","width":1254,"height":1254},{"id":63139659022603,"created_at":"2025-12-08T18:34:33+02:00","position":3,"updated_at":"2025-12-08T18:34:57+02:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT6605BK_1.png?v=1765211697","width":1500,"height":1500},{"id":70067413156107,"created_at":"2026-09-08T14:44:18+03:00","position":4,"updated_at":"2026-09-08T14:47:20+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LE4D_cu_Telecomanda_LT660_5BK_5_Elemente_55W_Lumina_3000_4000_6000K_NegruChatGPTImageSep8_2026_02_44_06PM.png?v=1788868040","width":1254,"height":1254},{"id":63139658694923,"created_at":"2025-12-08T18:34:26+02:00","position":5,"updated_at":"2025-12-08T18:34:57+02:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ha54b333589e6483fbe4079d9229b8291u.jpg?v=1765211697","width":800,"height":800},{"id":69704240759051,"created_at":"2026-07-06T16:13:20+03:00","position":6,"updated_at":"2026-07-06T16:14:37+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H368d5c4cc9694de9a2b5fcd06a6133779_eb94e99a-9f4c-4c8c-b3ac-09c883ba16c8.jpg?v=1783343677","width":1024,"height":1024},{"id":63139658760459,"created_at":"2025-12-08T18:34:26+02:00","position":7,"updated_at":"2026-07-06T16:13:02+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H368d5c4cc9694de9a2b5fcd06a6133779.jpg?v=1783343582","width":1024,"height":1024},{"id":69704248492299,"created_at":"2026-07-06T16:14:53+03:00","position":8,"updated_at":"2026-07-06T16:16:28+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H368d5c4cc9694de9a2b5fcd06a6133779_ca4f5d61-00b2-420a-98e8-0188c329faff.jpg?v=1783343788","width":1024,"height":1024},{"id":63139658727691,"created_at":"2025-12-08T18:34:26+02:00","position":9,"updated_at":"2025-12-08T18:34:57+02:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ha9b0f22e28e045ed9e113a0db8f4c6f0n.jpg?v=1765211697","width":800,"height":800},{"id":69959719649547,"created_at":"2026-08-21T13:21:41+03:00","position":10,"updated_at":"2026-08-21T13:21:43+03:00","product_id":10730332324107,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2484962_big_color.png?v=1787307703","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758353195275,"title":"Lustra LED NIVARA 3D 20W, Diametru 30cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-nivara-3d-20w-diametru-30cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp\u003eDescoperă magia iluminatului modern cu această lustră LED ultra-slim care transformă instantaneu atmosfera oricărei încăperi! Perfectă pentru holuri elegante, dormitoare cochete sau camera copilului tău, această bijuterie tehnologică îmbină designul contemporan cu funcționalitatea avansată.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e\u003ch2\u003eDesign Captivant și Versatilitate\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003eSiluetă circulară minimalistă cu profil ultra-subțire de doar 6 cm - o prezență discretă dar impunătoare pe tavan\u003c\/li\u003e\n\u003cli\u003eConstrucție inovatoare cu 4 surse LED integrate strategic pentru o distribuție armonioasă a luminii\u003c\/li\u003e\n\u003cli\u003eJoc fascinant de lumini creat de straturile concentrice, care adaugă profunzime și caracter spațiului\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e \u003c\/p\u003e\u003ch2\u003eTehnologie de Iluminare Avansată\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003eSistem inteligent RGB cu spectru complet de culori pentru personalizarea atmosferei după starea de spirit\u003c\/li\u003e\n\u003cli\u003eTrei temperaturi de culoare distincte (caldă 3000K, neutră 4000K, rece 6000K) pentru adaptare la orice moment al zilei\u003c\/li\u003e\n\u003cli\u003eFlux luminos optimizat de 1600 lumeni, perfect calibrat pentru spații intime\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003eFuncționalitate și Eficiență Premium\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003eConsum energetic redus de doar 20W, reflectând grija pentru mediu și factura ta de energie\u003c\/li\u003e\n\u003cli\u003eDimensiune perfect proporționată cu diametrul de 30 cm pentru holuri și încăperi compacte\u003c\/li\u003e\n\u003cli\u003eDurabilitate garantată prin construcția premium din acril și metal de înaltă calitate\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eRedefinește-ți spațiul cu această lustră LED multifuncțională care îmbină măiestrit tehnologia de ultimă generație cu designul contemporan. Perfectă pentru cei care apreciază atât estetica modernă, cât și controlul inteligent al ambianței luminoase.\u003c\/p\u003e\u003cp\u003e\u003c!-- notionvc: 0ae4bf03-36fb-45c0-aa2f-3fba5b509a68 --\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:23:02+02:00","created_at":"2025-02-24T21:23:01+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","SpringSale1"],"variants":[{"id":52423832797451,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL601RGB","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"69.99","grams":0,"compare_at_price":"129.99","position":1,"product_id":9758353195275,"created_at":"2025-09-29T11:36:46+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51821097025803,"created_at":"2025-02-24T21:23:04+02:00","position":1,"updated_at":"2025-03-13T19:40:46+02:00","product_id":9758353195275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-scorinis-3d-84w-acril-metal_LL1874AL_01.webp?v=1741887646","width":1024,"height":1024},{"id":51821097058571,"created_at":"2025-02-24T21:23:04+02:00","position":2,"updated_at":"2025-03-13T19:44:29+02:00","product_id":9758353195275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-scorinis-3d-84w-acril-metal_LL1874AL_02.webp?v=1741887869","width":1024,"height":1024},{"id":51821096960267,"created_at":"2025-02-24T21:23:04+02:00","position":3,"updated_at":"2025-03-13T19:47:58+02:00","product_id":9758353195275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-scorinis-3d-84w-acril-metal_LL1874AL_03.webp?v=1741888078","width":1024,"height":1024},{"id":51821096927499,"created_at":"2025-02-24T21:23:04+02:00","position":4,"updated_at":"2025-03-13T19:48:28+02:00","product_id":9758353195275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-scorinis-3d-84w-acril-metal_LL1874AL_04.webp?v=1741888108","width":1024,"height":1024},{"id":51821096894731,"created_at":"2025-02-24T21:23:04+02:00","position":5,"updated_at":"2025-03-13T19:48:55+02:00","product_id":9758353195275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-scorinis-3d-84w-acril-metal_LL1874AL_05.webp?v=1741888135","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757942153483,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA RGB 75W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-nova-rotonda-rgb-75w-3-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:85\"\u003e\u003cstrong\u003eEleganță Modernă și Spectacol de Culoare: Lustra LED NOVA Rotonda cu Cristale RGB\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:85\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:255\"\u003eTransformă-ți spațiul într-un univers de lumină și stil cu Lustra LED NOVA Rotonda. Această plafonieră îmbină un design rotund modern, accente de \u003cstrong\u003einox\u003c\/strong\u003e elegant și strălucirea captivantă a \u003cstrong\u003ecristalelor\u003c\/strong\u003e, oferind o iluminare spectaculoasă și versatilă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:255\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:378\"\u003eCu \u003cstrong\u003e3 surse de lumină\u003c\/strong\u003e puternice, alimentate de o putere totală de \u003cstrong\u003e75W\u003c\/strong\u003e, lustra NOVA Rotonda asigură o iluminare amplă și uniformă, ideală pentru livinguri, dininguri sau dormitoare moderne. Elementul distinctiv este tehnologia \u003cstrong\u003eRGB\u003c\/strong\u003e integrată, care îți permite să alegi dintr-o paletă variată de culori și efecte dinamice, creând atmosfera perfectă pentru orice ocazie.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:378\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:302\"\u003eStrălucirea cristalelor de înaltă calitate adaugă un plus de eleganță și rafinament, refractând lumina în mod spectaculos și creând jocuri vizuale încântătoare. Designul rotund, cu detalii din \u003cstrong\u003einox\u003c\/strong\u003e, conferă un aspect contemporan și sofisticat, integrându-se armonios în diverse stiluri de interior.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:302\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:226\"\u003eControlul este intuitiv și comod datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e. Poți schimba culorile RGB, ajusta intensitatea luminoasă (funcție dimmabilă) și selecta efectele de iluminare preferate, totul fără a te ridica de pe canapea.\u003c\/p\u003e\u003cp data-sourcepos=\"13:1-13:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"15:1-22:0\"\u003e\n\u003cli data-sourcepos=\"15:1-15:89\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Formă rotundă, accente de inox și cristale strălucitoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:76\"\u003e\n\u003cstrong\u003eIluminare Puternică:\u003c\/strong\u003e 3 surse de lumină LED cu o putere totală de 75W.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:97\"\u003e\n\u003cstrong\u003eTehnologie RGB:\u003c\/strong\u003e Paletă variată de culori și efecte dinamice pentru atmosferă personalizată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:88\"\u003e\n\u003cstrong\u003eCristale de Înaltă Calitate:\u003c\/strong\u003e Refractă lumina spectaculos, adăugând un plus de lux.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-19:73\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:81\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil al culorilor, intensității și efectelor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-22:0\"\u003e\n\u003cstrong\u003eMateriale Durabile:\u003c\/strong\u003e Inox și cristale de înaltă calitate pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"23:1-23:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"25:1-30:0\"\u003e\n\u003cli data-sourcepos=\"25:1-25:109\"\u003e\n\u003cstrong\u003eCreează un Punct Focal Modern și Elegant:\u003c\/strong\u003e Designul atrăgător și cristalele strălucitoare impresionează.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:120\"\u003e\n\u003cstrong\u003eOferă o Iluminare Versatilă:\u003c\/strong\u003e Adaptează culorile și intensitatea luminoasă la starea ta de spirit sau la eveniment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:88\"\u003e\n\u003cstrong\u003eAdaugă un Plus de Lux:\u003c\/strong\u003e Cristalele de înaltă calitate conferă un aspect sofisticat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-28:76\"\u003e\n\u003cstrong\u003eControl Facil:\u003c\/strong\u003e Telecomanda intuitivă face ajustările simple și rapide.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-30:0\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"31:1-31:229\"\u003eLustra LED NOVA Rotonda cu Cristale RGB este alegerea perfectă pentru a adăuga un element de design modern, o iluminare puternică și un spectacol de culoare în casa ta. Transformă fiecare moment într-o experiență luminoasă unică!\u003c\/p\u003e","published_at":"2025-02-24T19:45:02+02:00","created_at":"2025-02-24T19:45:01+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52417907884299,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT073\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"329.99","position":1,"product_id":9757942153483,"created_at":"2025-09-27T13:17:06+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69858439135499,"created_at":"2026-07-31T23:35:40+03:00","position":1,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439102731,"created_at":"2026-07-31T23:35:40+03:00","position":2,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439168267,"created_at":"2026-07-31T23:35:40+03:00","position":3,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439299339,"created_at":"2026-07-31T23:35:40+03:00","position":4,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439037195,"created_at":"2026-07-31T23:35:40+03:00","position":5,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439004427,"created_at":"2026-07-31T23:35:40+03:00","position":6,"updated_at":"2026-07-31T23:35:42+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LT073-3WH.webp?v=1785530142","width":1254,"height":1254},{"id":69858439201035,"created_at":"2026-07-31T23:35:40+03:00","position":7,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439233803,"created_at":"2026-07-31T23:35:40+03:00","position":8,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LT073-3WH.webp?v=1785530143","width":1254,"height":1254},{"id":69858439266571,"created_at":"2026-07-31T23:35:40+03:00","position":9,"updated_at":"2026-07-31T23:35:43+03:00","product_id":9757942153483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT073-3WH.webp?v=1785530143","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759554109707,"title":"Lustra LED cu telecomanda AYDA 116W, Ondulata, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-ayda-116w-ondulata-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:126\"\u003eLustra LED cu telecomandă AYDA este o opțiune de iluminat modernă și puternică, cu o putere de 116W și un finisaj alb elegant.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:212\"\u003eDeși descrierea nu menționează forma specifică, având în vedere că este LED cu telecomandă și funcție de dimare, ne putem aștepta la un design contemporan, probabil cu linii fluide sau forme geometrice stilizate.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:322\"\u003eTelecomanda inclusă îți oferă control total asupra atmosferei: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:244\"\u003eFinisajul alb îi conferă un aspect curat și versatil, ușor de integrat în diverse stiluri de decor. Cu o putere de 116W, această lustră este potrivită pentru a ilumina eficient livinguri, sufragerii sau alte spații de dimensiuni medii sau mari.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:04:04+02:00","created_at":"2025-02-25T00:04:03+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52427655217419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2212WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9759554109707,"created_at":"2025-09-30T09:55:59+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51834021445899,"created_at":"2025-02-25T00:04:06+02:00","position":1,"updated_at":"2025-05-15T16:47:21+03:00","product_id":9759554109707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-ayda-116w-alb_LL1899AL_02.webp?v=1747316841","width":900,"height":900},{"id":51834021380363,"created_at":"2025-02-25T00:04:06+02:00","position":2,"updated_at":"2025-05-15T16:47:21+03:00","product_id":9759554109707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-ayda-116w-alb_LL1899AL_01.webp?v=1747316841","width":900,"height":900},{"id":51834021413131,"created_at":"2025-02-25T00:04:06+02:00","position":3,"updated_at":"2025-05-15T16:47:21+03:00","product_id":9759554109707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-ayda-116w-alb_LL1899AL_03.webp?v=1747316841","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757796696331,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA RGB 82W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-nova-rotonda-rgb-82w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru-crom","body_html":"\u003cp data-end=\"513\" data-start=\"142\"\u003e\u003cstrong data-end=\"181\" data-start=\"142\"\u003eLustra LED NOVA Rotonda cu Cristale\u003c\/strong\u003e este o piesă de iluminat modernă, spectaculoasă și extrem de versatilă, concepută pentru a aduce eleganță și dinamism în orice încăpere. Designul rotund, completat de \u003cstrong data-end=\"372\" data-start=\"349\"\u003efinisaje negru–inox\u003c\/strong\u003e și accente de \u003cstrong data-end=\"413\" data-start=\"387\"\u003ecristale strălucitoare\u003c\/strong\u003e, transformă această lustra într-un element decorativ care captează atenția încă de la prima vedere.\u003c\/p\u003e\u003cp data-end=\"513\" data-start=\"142\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp data-end=\"853\" data-start=\"515\"\u003eDispune de \u003cstrong data-end=\"541\" data-start=\"526\"\u003e4 surse LED\u003c\/strong\u003e integrate și o putere totală de \u003cstrong\u003e82W\u003c\/strong\u003e, oferind o iluminare eficientă pentru încăperi de dimensiuni medii precum livinguri, dormitoare sau zone de dining. Cristalele montate pe structura circulară amplifică reflexia luminii și creează un efect vizual sofisticat, perfect pentru interioare moderne sau elegante.\u003c\/p\u003e\u003cp data-end=\"853\" data-start=\"515\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-end=\"1313\" data-start=\"855\"\u003eFuncția \u003cstrong data-end=\"870\" data-start=\"863\"\u003eRGB\u003c\/strong\u003e adaugă un nivel suplimentar de personalizare, permițându-ți să alegi dintr-o gamă variată de culori pentru a seta atmosfera exact așa cum o dorești — fie că vrei o lumină ambientală relaxantă, o nuanță vibrantă pentru seri speciale sau o lumină clasică pentru activitățile zilnice. Telecomanda inclusă facilitează controlul complet al luminii: schimbarea culorilor, ajustarea intensității (dimmable) și accesul rapid la modurile de iluminare.\u003c\/p\u003e\u003cp data-end=\"1313\" data-start=\"855\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-end=\"1514\" data-start=\"1315\"\u003e\u003cstrong data-end=\"1343\" data-start=\"1315\"\u003eNOVA Rotonda cu Cristale\u003c\/strong\u003e este soluția ideală dacă îți dorești un corp de iluminat modern, elegant și versatil, capabil să ofere atât funcționalitate, cât și impact vizual într-un mod excepțional.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:178\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:23:50+02:00","created_at":"2025-02-24T18:23:49+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Back2school","CH_ONLINE-MASS","Corpuri de Iluminat","iulie_26","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52406990897419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT073\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9757796696331,"created_at":"2025-09-24T01:42:54+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":63138079605003,"created_at":"2025-12-08T13:27:01+02:00","position":1,"updated_at":"2026-05-14T14:42:52+03:00","product_id":9757796696331,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT0734BK.png?v=1778758972","width":1024,"height":1024},{"id":51817998811403,"created_at":"2025-02-24T18:23:53+02:00","position":2,"updated_at":"2026-05-14T14:50:29+03:00","product_id":9757796696331,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-malina-cu-telecomanda-132w-dimabila-acril-si-cristal-negru-1720594955.webp?v=1778759429","width":1024,"height":1024},{"id":51817998778635,"created_at":"2025-02-24T18:23:53+02:00","position":3,"updated_at":"2026-05-14T14:51:46+03:00","product_id":9757796696331,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/517