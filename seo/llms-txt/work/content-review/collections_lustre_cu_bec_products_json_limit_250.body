y.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_DAISY_53W_4_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Alb_5.webp?v=1784725033","width":1024,"height":1024},{"id":69393753702667,"created_at":"2026-06-10T16:15:30+03:00","position":12,"updated_at":"2026-07-22T15:57:41+03:00","product_id":9760822067467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_DAISY_53W_4_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Alb_8.png?v=1784725061","width":1269,"height":1239},{"id":69393762189579,"created_at":"2026-06-10T16:16:51+03:00","position":13,"updated_at":"2026-07-22T15:58:33+03:00","product_id":9760822067467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_DAISY_53W_4_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Alb_13.png?v=1784725113","width":1254,"height":1254},{"id":69814952198411,"created_at":"2026-07-22T15:55:57+03:00","position":14,"updated_at":"2026-07-22T15:58:42+03:00","product_id":9760822067467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_DAISY_53W_4_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Alb14.png?v=1784725122","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759547818251,"title":"Lustra LED cu telecomanda BETTY 40W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-betty-40w-3-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-end=\"428\" data-start=\"72\"\u003e\u003cstrong data-end=\"107\" data-start=\"72\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_3971afca-9435-402d-aed6-33a6cf357855.png?v=1778234077\" alt=\"\"\u003eLustra LED cu telecomandă BETTY\u003c\/strong\u003e aduce un plus de modernitate și rafinament oricărui interior, datorită designului său format din \u003cstrong data-end=\"233\" data-start=\"205\"\u003etrei cercuri concentrice\u003c\/strong\u003e, finisate într-un negru elegant. Cu o putere de \u003cstrong data-end=\"289\" data-start=\"282\"\u003e40W\u003c\/strong\u003e, acest corp de iluminat oferă lumină suficientă pentru camere de dimensiuni medii, fiind ideal pentru \u003cstrong data-end=\"427\" data-start=\"392\"\u003eliving, dormitor, birou sau hol\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-end=\"637\" data-start=\"430\"\u003eCele trei cercuri creează un joc vizual modern și echilibrat, iar iluminarea LED integrată îți permite să alegi exact atmosfera dorită. Prin telecomanda inclusă, poți selecta ușor \u003cstrong data-end=\"636\" data-start=\"610\"\u003etemperatura de culoare\u003c\/strong\u003e:\u003c\/p\u003e\u003cul data-end=\"837\" data-start=\"639\"\u003e\n\u003cli data-end=\"723\" data-start=\"639\"\u003e\u003cp data-end=\"723\" data-start=\"641\"\u003e\u003cstrong data-end=\"664\" data-start=\"641\"\u003eLumină rece (6000K)\u003c\/strong\u003e pentru momente în care ai nevoie de claritate și energie\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"774\" data-start=\"724\"\u003e\u003cp data-end=\"774\" data-start=\"726\"\u003e\u003cstrong data-end=\"750\" data-start=\"726\"\u003eLumină caldă (3000K)\u003c\/strong\u003e pentru seri relaxante\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"837\" data-start=\"775\"\u003e\u003cp data-end=\"837\" data-start=\"777\"\u003e\u003cstrong data-end=\"802\" data-start=\"777\"\u003eLumină neutră (4000K)\u003c\/strong\u003e pentru iluminat general, natural\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-end=\"1006\" data-start=\"839\"\u003eÎn plus, funcția \u003cstrong data-end=\"869\" data-start=\"856\"\u003edimmabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii în funcție de activitate – de la o lumină ambientală discretă, până la iluminare puternică.\u003c\/p\u003e\u003cp data-end=\"1006\" data-start=\"839\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-end=\"1268\" data-start=\"1008\"\u003eFinisajul negru mat și geometria curată fac din BETTY o lustră cu personalitate, perfectă pentru interioare moderne, minimaliste sau industriale. Este o alegere excelentă pentru oricine vrea o sursă de lumină versatilă, economică și cu impact estetic puternic.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:240\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:02:23+02:00","created_at":"2025-02-25T00:02:23+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52422695944459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"129.99","grams":0,"compare_at_price":"129.99","position":1,"product_id":9759547818251,"created_at":"2025-09-28T21:53:30+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68771739795723,"created_at":"2026-05-08T12:54:31+03:00","position":1,"updated_at":"2026-05-08T12:54:35+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1._COVER_2d544f70-bbcb-48de-8317-57e67d0c82bd.png?v=1778234075","width":1000,"height":1000},{"id":68771739599115,"created_at":"2026-05-08T12:54:30+03:00","position":2,"updated_at":"2026-05-08T12:54:37+03:00","product_id":9759547818251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2._C