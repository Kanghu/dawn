ated_at":"2026-06-29T10:50:45+03:00","product_id":10990771175691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_STARK_20W_Diametru_19cm_Lumina_Calda_Neutra_Rece_Alb_Metal_si_Acril_6.png?v=1782719445","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10989494927627,"title":"Lustra LED cu telecomanda KANGNING, 3000K\/4000K\/6000K, 53W, Metal și Acrilic, Alb","handle":"lustra-led-cu-telecomanda-kangning-3-surse-3000k-4000k-6000k-120w-metal-și-acrilic-alb","body_html":"\u003cp\u003e\u003cstrong\u003eLustră LED cu telecomandă KANGNING, 120W, Negru – Design modern și iluminare personalizabilă\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_c7794b7d-46c1-4007-a790-a48b3fc38c6a.webp?v=1780900928\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eTransformă orice încăpere într-un spațiu elegant și confortabil cu lustra LED KANGNING. Cu un design contemporan realizat din metal și acrilic de înaltă calitate, această lustră alba impresionează prin liniile sale fluide și aspectul minimalist, fiind ideală pentru living, dining sau spatii comerciale.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led_14c7bac0-499f-4dc4-a89a-a17c336ea946.webp?v=1780900928\" alt=\"\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003eEchipată cu iluminare LED integrată și o putere totală de 120W, lustra oferă o iluminare puternică și uniformă. Prin intermediul telecomenzii incluse, poți selecta cu ușurință temperatura de culoare dorită între lumină caldă (3000K), neutră (4000K) și rece (6000K), adaptând atmosfera în funcție de momentul zilei sau de activitățile desfășurate.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic_7390e217-29c6-431b-b6fe-0ebf737258ce.webp?v=1780900928\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-06-29T17:54:13+03:00","created_at":"2026-06-26T10:20:37+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["Lustre LED cu Telecomanda"],"variants":[{"id":53206620209419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT5004WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"599.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10989494927627,"created_at":"2026-06-26T10:20:37+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69604337385739,"created_at":"2026-06-26T10:52:29+03:00","position":1,"updated_at":"2026-06-30T17:44:28+03:00","product_id":10989494927627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_KANGNING_3000K_4000K_6000K_120W_Metal_i_Acrilic_Alb_1.png?v=1782830668","width":1254,"height":1254},{"id":69604343513355,"created_at":"2026-06-26T10:54:27+03:00","position":2,"updated_at":"2026-06-30T17:44:39+03:00","product_id":10989494927627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_KANGNING_3000K_4000K_6000K_120W_Metal_i_Acrilic_Alb_2.png?v=1782830679","width":1254,"height":1254},{"id":69604351115531,"created_at":"2026-06-26T10:56:25+03:00","position":3,"updated_at":"2026-06-30T17:44:48+03:00","product_id":10989494927627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_KANGNING_3000K_4000K_6000K_120W_Metal_i_Acrilic_Alb_3.png?v=1782830688","width":1254,"height":1254},{"id":69604310188299,"created_at":"2026-06-26T10:43:04+03:00","position":4,"updated_at":"2026-06-30T17:44:58+03:00","product_id":10989494927627,"variant_ids":[]