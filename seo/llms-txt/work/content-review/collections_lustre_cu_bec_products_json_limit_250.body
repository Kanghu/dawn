:1000,"height":1000},{"id":69858315305227,"created_at":"2026-07-31T22:25:21+03:00","position":8,"updated_at":"2026-07-31T22:25:24+03:00","product_id":9758325178635,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LL770-3BK.webp?v=1785525924","width":1000,"height":1000},{"id":69858315370763,"created_at":"2026-07-31T22:25:21+03:00","position":9,"updated_at":"2026-07-31T22:25:24+03:00","product_id":9758325178635,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/012_12_LL770-3BK.webp?v=1785525924","width":1000,"height":1000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757459284235,"title":"Lustra LED cu telecomanda JASMINE 73W, 5 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-jasmine-66w-5-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cspan style=\"font-size: 16px; text-align: justify;\"\u003eExperimentați un amestec de eleganță și tehnologie modernă cu \u003c\/span\u003e\u003cstrong style=\"font-size: 16px; text-align: justify;\"\u003eLustra LED JASMINE\u003c\/strong\u003e\u003cspan style=\"font-size: 16px; text-align: justify;\"\u003e, disponibilă în magazinul Alessandro Design din Voluntari. Această lustră superbă, cu cinci brațe și un design floral rafinat, este piesa centrală ideală pentru orice spațiu care dorește să combine frumusețea naturală cu iluminarea modernă. Finisată în alb, \u003c\/span\u003e\u003cstrong style=\"font-size: 16px; text-align: justify;\"\u003eLustra JASMINE\u003c\/strong\u003e\u003cspan style=\"font-size: 16px; text-align: justify;\"\u003e este perfectă pentru a aduce un aer proaspăt și luminos în orice cameră.\u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cspan style=\"font-size: 16px; text-align: justify;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003ch3 style=\"font-size: 18px;\"\u003eFuncționalitate și Iluminare\u003c\/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e Cu o putere impresionantă de 66W și un diametru de 64cm, această lustră oferă o iluminare generoasă, ideală pentru \u003cstrong\u003elivinguri\u003c\/strong\u003e, \u003cstrong\u003esăli de mese\u003c\/strong\u003e sau \u003cstrong\u003eholuri\u003c\/strong\u003e. Funcționalitatea dimabilă, controlabilă prin \u003cstrong\u003etelecomandă\u003c\/strong\u003e, vă permite să ajustați luminozitatea în funcție de nevoile dumneavoastră, oferind flexibilitate totală. \u003c\/span\u003e\u003c\/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e Cele trei tipuri de lumină disponibile - \u003cstrong\u003ecaldă\u003c\/strong\u003e, \u003cstrong\u003erece\u003c\/strong\u003e sau \u003cstrong\u003eneutră\u003c\/strong\u003e - pot schimba cu ușurință atmosfera camerei printr-o simplă apăsare de buton. Astfel, JASMINE devine soluția perfectă atât pentru momentele de relaxare cât și pentru cele care necesită o lumină puternică și clară. \u003c\/span\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv class=\"containerimg-mobile\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003ch3 style=\"font-size: 18px;\"\u003ePutere și Eficiență\u003c\/h3\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e Cu un flux luminos impresionant de 5280lm, \u003cstrong\u003eLustra JASMINE\u003c\/strong\u003e asigură o iluminare puternică și eficientă, transformând-o într-un element decorativ versatil și practic. Designul său floral inspirat din natură se integrează armonios în diverse stiluri de decor, oferind un plus de eleganță și rafinament oricărui interior.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e \u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e","published_at":"2025-02-24T16:22:14+02:00","created_at":"2025-02-24T16:22:13+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52423831322891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT661\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757459284235,"created_at":"2025-09-29T11:36:07+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70027144102155,"created_at":"2026-09-02T14:49:07+03:00","position":1,"updated_at":"2026-09-02T14:49:53+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_JASMINE_73W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Alb_1.png?v=1788349793","width":1254,"height":1254},{"id":63037079027979,"created_at":"2025-12-05T15:02:32+02:00","position":2,"updated_at":"2025-12-05T15:03:11+02:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT6615WH_1.png?v=1764939791","width":1586,"height":1586},{"id":68688662790411,"created_at":"2026-05-04T09:54:49+03:00","position":3,"updated_at":"2026-05-04T09:54:53+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage4mai2026_09_54_40.png?v=1777877693","width":1254,"height":1254},{"id":63037078569227,"created_at":"2025-12-05T15:02:31+02:00","position":4,"updated_at":"2025-12-05T15:03:11+02:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT6615WH_2.png?v=1764939791","width":800,"height":800},{"id":59031238541579,"created_at":"2025-08-12T11:58:04+03:00","position":5,"updated_at":"2025-12-05T15:03:11+02:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Aa40f064d519d43e48b66cd4eb1675c50H_1.jpg?v=1764939791","width":800,"height":800},{"id":51815789101323,"created_at":"2025-02-24T16:22:18+02:00","position":6,"updated_at":"2026-05-04T09:52:48+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-marta-24-ghz-aplicatie-ios---android-112w-alb_LL1802AL_03.webp?v=1777877568","width":1024,"height":1024},{"id":61647886156043,"created_at":"2025-10-23T18:44:25+03:00","position":7,"updated_at":"2026-05-13T09:25:08+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_2d022e08-146a-4fb4-9050-45c3c4826b35.png?v=1778653508","width":1024,"height":1024},{"id":51815789887755,"created_at":"2025-02-24T16:22:18+02:00","position":8,"updated_at":"2026-05-04T09:51:55+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-marta-24-ghz-aplicatie-ios---android-112w-alb_LL1802AL_02.webp?v=1777877515","width":1024,"height":1024},{"id":68861602332939,"created_at":"2026-05-13T09:27:42+03:00","position":9,"updated_at":"2026-05-13T09:27:45+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage13mai2026_09_27_35.png?v=1778653665","width":1254,"height":1254},{"id":70027119886603,"created_at":"2026-09-02T14:40:25+03:00","position":10,"updated_at":"2026-09-02T14:40:27+03:00","product_id":9757459284235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2451526_big_color_4cec3972-d47a-4912-b159-6b8e9a72dfe2.png?v=1788349227","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757476913419,"title":"Lustra LED cu telecomanda SUSAN 96W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-susan-96w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"c132acb521656eef\"\u003e\n\u003cdiv class=\"response-container ng-tns-c1310598610-51 response-container-with-gpi tts-removed ng-star-inserted\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1310598610-51\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1310598610-51\"\u003e\u003cdiv class=\"response-content ng-tns-c1310598610-51\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_c132acb521656eef\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:279\"\u003eAceastă lustră LED cu telecomandă SUSAN, de 96W și culoare neagră, este o alegere excelentă pentru a adăuga un plus de modernitate și funcționalitate locuinței tale . Designul său contemporan, cu 4 pătrate interconectate, va crea un punct focal elegant în orice cameră.\u003c\/p\u003e\n\u003cp data-sourcepos=\"1:1-1:279\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:28\"\u003e\u003cstrong\u003eIată ce o face specială:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"5:1-12:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:224\"\u003e\n\u003cstrong\u003eIluminare puternică și eficientă:\u003c\/strong\u003e Cu o putere de 96W, această lustră oferă o lumină intensă, ideală pentru a ilumina spații mari, contribuind în același timp la reducerea consumului de energie datorită tehnologiei LED.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:384\"\u003e\n\u003cstrong\u003eVersatilitate în alegerea culorii luminii:\u003c\/strong\u003e Telecomanda îți permite să selectezi între lumină rece (perfectă pentru activități care necesită concentrare), lumină caldă (ideală pentru a crea o atmosferă relaxantă și primitoare) și lumină neutră (potrivită pentru utilizarea generală de zi cu zi). Poți schimba tipul de lumină și prin apăsări succesive ale întrerupătorului clasic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:237\"\u003e\n\u003cstrong\u003eIntensitate reglabilă:\u003c\/strong\u003e Funcția de dimare, controlată tot prin telecomandă, îți oferă posibilitatea de a ajusta intensitatea luminii în funcție de preferințe și de momentul zilei, creând astfel ambianța perfectă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:213\"\u003e\n\u003cstrong\u003eDesign modern și elegant:\u003c\/strong\u003e Forma geometrică a celor 4 pătrate și culoarea neagră conferă lămpii un aspect sofisticat și contemporan, integrându-se cu ușurință în diverse stiluri de design interior .\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:110\"\u003e\n\u003cstrong\u003eControl comod prin telecomandă:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea luminii fără a te deplasa.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:137\"\u003e\n\u003cstrong\u003eDurabilitate și longevitate:\u003c\/strong\u003e Tehnologia LED asigură o durată de viață îndelungată a lămpii, reducând nevoia de înlocuire frecventă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eInstalare facilă:\u003c\/strong\u003e Lustra vine cu toate accesoriile necesare și instrucțiuni clare pentru o montare simplă și rapidă.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"13:1-13:298\"\u003eImaginează-ți această lustră SUSAN în livingul tău , oferind o lumină adaptabilă pentru serile relaxante în familie sau pentru momentele în care primești oaspeți. Designul său atrăgător va completa decorul, iar funcționalitatea telecomenzii îți va oferi control total asupra iluminatului.\u003c\/p\u003e\n\u003cp data-sourcepos=\"13:1-13:298\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv class=\"feedback-form-turn-index\" id=\"feedback-form-6\"\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:26:02+02:00","created_at":"2025-02-24T16:26:01+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428664635659,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT804\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757476913419,"created_at":"2025-09-30T14:55:34+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70092234195211,"created_at":"2026-09-09T14:35:56+03:00","position":1,"updated_at":"2026-09-09T14:36:01+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep9_2026_02_35_41PM.png?v=1788953761","width":1254,"height":1254},{"id":62997834137867,"created_at":"2025-12-04T12:03:29+02:00","position":2,"updated_at":"2025-12-04T12:47:06+02:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8044BK_2.png?v=1764845226","width":800,"height":800},{"id":62997834170635,"created_at":"2025-12-04T12:03:29+02:00","position":3,"updated_at":"2025-12-04T12:47:06+02:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8044BK_1.png?v=1764845226","width":1586,"height":1586},{"id":69030664896779,"created_at":"2026-05-22T10:56:12+03:00","position":4,"updated_at":"2026-05-22T10:56:15+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-balans-104w-dimabila-acril-negru_LL1621_03_c66dcb41-d34f-4cb8-93a3-8287dd0e3f35.webp?v=1779436575","width":900,"height":900},{"id":51815896940811,"created_at":"2025-02-24T16:26:04+02:00","position":5,"updated_at":"2025-05-26T14:52:10+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-balans-104w-dimabila-acril-negru_LL1621_04.webp?v=1748260330","width":900,"height":900},{"id":55768727290123,"created_at":"2025-05-26T14:52:02+03:00","position":6,"updated_at":"2026-05-22T10:55:55+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6e6946e3-66b4-47dc-a5f9-e061d2279500.webp?v=1779436555","width":1024,"height":1024},{"id":51815897006347,"created_at":"2025-02-24T16:26:04+02:00","position":7,"updated_at":"2026-05-22T10:59:24+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-balans-104w-dimabila-acril-negru_LL1621_03.webp?v=1779436764","width":1024,"height":1024},{"id":51815896645899,"created_at":"2025-02-24T16:26:04+02:00","position":8,"updated_at":"2026-05-22T10:57:14+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-balans-104w-dimabila-acril-negru_LL1621_02.webp?v=1779436634","width":1024,"height":1024},{"id":69701583601931,"created_at":"2026-07-06T11:57:21+03:00","position":9,"updated_at":"2026-07-06T11:57:23+03:00","product_id":9757476913419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2458002_big_color.png?v=1783328243","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757613818123,"title":"Lustra LED cu telecomanda ORCHID 66W, 5 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-orchid-66w-5-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:267\"\u003eAceastă lustră LED cu telecomandă ORCHID, de 66W și culoare albă, aduce o notă florală amplă și o iluminare versatilă în orice încăpere. Cu cele 5 petale stilizate, designul său elegant va atrage cu siguranță privirile și va crea un punct focal luminos și sofisticat.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:267\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-15:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:86\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 66W, asigurând o iluminare eficientă și generoasă pentru spații diverse.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:123\"\u003e\n\u003cstrong\u003eDesign floral amplu:\u003c\/strong\u003e Cele 5 'petale' luminoase creează un aspect bogat și organic, inspirat de frumusețea orhideelor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:166\"\u003e\n\u003cstrong\u003eTip de lumină reglabil:\u003c\/strong\u003e Oferă posibilitatea de a alege între lumină rece, caldă sau neutră, adaptându-se perfect atmosferei dorite și activităților desfășurate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:158\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii poate fi ajustată cu ușurință prin telecomanda inclusă, permițând personalizarea nivelului de lumină pentru orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:253\"\u003e\n\u003cstrong\u003eControl prin telecomandă:\u003c\/strong\u003e Permite modificarea temperaturii culorii și a intensității luminii de la distanță. De asemenea, lustra poate fi controlată și prin intermediul întrerupătorului clasic (schimbarea tipului de lumină prin apăsări succesive).\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:119\"\u003e\n\u003cstrong\u003eEstetică rafinată:\u003c\/strong\u003e Culoarea albă și designul floral complex adaugă un plus de eleganță și stil oricărui interior.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:83\"\u003e\n\u003cstrong\u003eFlux luminos ridicat:\u003c\/strong\u003e Asigură o iluminare optimă și confortabilă a spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:85\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică superioară și durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-13:84\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție robustă pentru o utilizare de lungă durată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu instrucțiuni clare pentru montaj.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"16:1-16:256\"\u003eImaginează-ți această lustră ORCHID impunătoare în livingul sau sufrageria ta, răspândind o lumină plăcută și creând un ambient primitor și elegant. Designul său unic și funcționalitatea telecomenzii îți vor oferi control total asupra atmosferei luminoase.\u003c\/p\u003e\u003cp data-sourcepos=\"16:1-16:256\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"16:1-16:256\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T17:16:43+02:00","created_at":"2025-02-24T17:16:43+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428911051019,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT280\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9757613818123,"created_at":"2025-09-30T15:45:42+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70026919608587,"created_at":"2026-09-02T13:32:13+03:00","position":1,"updated_at":"2026-09-02T13:33:22+03:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_ORCHID_66W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Alb_Metal_si_Acril_1ChatGPTImageSep2_2026_01_32_01PM.png?v=1788345202","width":1254,"height":1254},{"id":63137838760203,"created_at":"2025-12-08T12:59:26+02:00","position":2,"updated_at":"2025-12-08T13:03:10+02:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT2805WH_1.png?v=1765191790","width":800,"height":800},{"id":52822875668747,"created_at":"2025-04-02T10:57:55+03:00","position":3,"updated_at":"2025-12-08T13:03:10+02:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT280_5WH-LustraLEDcutelecomandaORCHID_65W_5Petale_luminaRece_Calda_Neutra_Dimabila_Alb-2.jpg?v=1765191790","width":1080,"height":1080},{"id":51816781119755,"created_at":"2025-02-24T17:16:46+02:00","position":4,"updated_at":"2025-03-25T13:27:34+02:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-anita-110w-dimabila-alb_LL1622_05.webp?v=1742902054","width":1024,"height":1024},{"id":63137850458379,"created_at":"2025-12-08T13:00:57+02:00","position":5,"updated_at":"2026-05-07T17:22:06+03:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H7baa632d824e40b5b41251f7260abb6c6.jpg?v=1778163726","width":1024,"height":1024},{"id":52605472407819,"created_at":"2025-03-25T13:27:24+02:00","position":6,"updated_at":"2026-05-07T17:23:17+03:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/He116f76432004a338cbbe17b90bdb9a4O.webp?v=1778163797","width":1024,"height":1024},{"id":63137850392843,"created_at":"2025-12-08T13:00:57+02:00","position":7,"updated_at":"2026-05-07T17:24:29+03:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H6cba72344e504620b98e8d661b9913dcW.jpg?v=1778163869","width":1024,"height":1024},{"id":64131662905611,"created_at":"2026-01-05T17:25:04+02:00","position":8,"updated_at":"2026-01-05T17:25:08+02:00","product_id":9757613818123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT280_5WH_EPREL.png?v=1767626708","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757512204555,"title":"Lustra LED cu telecomanda IPOMOEA 85W, 5 Stele, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-ipomoea-85w-5-stele-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003eLustra poate fi controlata atat din intrerupatorul clasic cat si din telecomanda inclusa, oferind flexibilitate maxima in utilizare pentru toti membrii familiei. Functionalitatea duala de control face acest corp de iluminat deosebit de practic, permitand ajustarea luminii din orice colt al incaperii. Datorita sistemului intuitiv de control, chiar si cei mici pot opera lustra in siguranta, transformand aprinderea si stingerea luminii intr-o experienta placuta si accesibila.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp\u003eBenzi LED: Lustra este echipata cu banda LED de inalta calitate, integrata perfect in design-ul sau. Aceasta tehnologie avansata ofera o distributie uniforma a luminii, eliminand punctele intunecate si asigurand o iluminare consistenta in intreaga incapere. Banda LED incorporata garanteaza nu doar eficienta energetica superioara, ci si o durata de viata extinsa.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eCu o durata de viata extraordinara de 25.000 de ore de functionare, acest corp de iluminat LED depaseste de pana la 20 ori longevitatea unui bec incandescent traditional. In timp ce un bec incandescent obisnuit trebuie inlocuit dupa aproximativ 1.000-1.500 ore de utilizare, acest produs LED va continua sa functioneze eficient pentru multi ani, reprezentand o alegere inteligenta si economica pentru iluminatul modern. Aceasta diferenta semnificativa in durata de viata se traduce direct in economii substantiale, atat in ceea ce priveste costurile de inlocuire, cat si de consum de energie.\u003c\/p\u003e\u003cp\u003eBeneficiati de controlul total asupra atmosferei din incapere datorita functiei de reglare a intensitatii luminoase. Aceasta caracteristica va permite sa:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003eCreati ambianta perfecta pentru orice moment al zilei - de la lumina puternica pentru activitati practice, pana la lumina difuza pentru seri relaxante\u003c\/li\u003e\n\u003cli\u003eEconomisiti energie si prelungiti durata de viata a produsului prin utilizarea intensitatii optime\u003c\/li\u003e\n\u003cli\u003eAdaptați iluminatul in functie de starea de spirit si activitățile desfășurate - de la intalniri de afaceri pana la cine romantice\u003c\/li\u003e\n\u003cli\u003eReduceti oboseala ochilor prin ajustarea luminii in functie de momentul zilei si nivelul de lumina naturala\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e\u003cp\u003eFlexibilitatea oferita de functia de reglare a intensitatii transforma acest corp de iluminat intr-o solutie versatila pentru orice stil de viata modern.\u003c\/p\u003e\u003cp\u003eGarantia de 2 ani pentru persoane fizice ofera siguranta unei investitii pe termen lung, acoperind orice defecte de fabricatie sau functionare care pot aparea in aceasta perioada. In plus, serviciul nostru dedicat de asistenta tehnica este pregatit sa va ofere suport prompt si profesionist ori de cate ori aveti nevoie. Acest angajament fata de calitate si satisfactia clientului reprezinta unul dintre pilonii fundamentali ai brandului nostru.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp\u003eEste atat de usor sa controlezi atmosfera cu Lustra LED cu Telecomanda Star! Cu 85W si un flux luminos de 6800 lumeni, acest corp de iluminat transforma orice incapere intr-un spatiu primitor. Finisajul sau elegant in culoarea alba si designul modern adauga un plus de rafinament si functionalitate casei tale, in timp ce distributia uniforma a luminii creeaza ambianta perfecta.\u003c\/p\u003e\u003cp\u003e\u003c!-- notionvc: a480ee9f-49d5-4d1a-b83f-98bb3bd66f03 --\u003e\u003c\/p\u003e","published_at":"2025-02-24T16:37:31+02:00","created_at":"2025-02-24T16:37:30+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429654458635,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT220\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757512204555,"created_at":"2025-09-30T16:55:41+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70067014402315,"created_at":"2026-09-08T13:14:40+03:00","position":1,"updated_at":"2026-09-08T13:14:44+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep8_2026_01_14_30PM.png?v=1788862484","width":1254,"height":1254},{"id":52832661864715,"created_at":"2025-04-02T13:38:31+03:00","position":2,"updated_at":"2026-05-13T17:47:25+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT220_5WH-LustraLEDcutelecomandaIPOMOEA_69W_5Stele_luminaRece_Calda_Neutra_Dimabila_Alb-2.jpg?v=1778683645","width":1024,"height":1024},{"id":52832661897483,"created_at":"2025-04-02T13:38:31+03:00","position":3,"updated_at":"2026-05-13T17:51:00+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT220_5WH-LustraLEDcutelecomandaIPOMOEA_69W_5Stele_luminaRece_Calda_Neutra_Dimabila_Alb-1.jpg?v=1778683860","width":1024,"height":1024},{"id":52832661930251,"created_at":"2025-04-02T13:38:31+03:00","position":4,"updated_at":"2026-05-13T17:40:44+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT220_5WH-LustraLEDcutelecomandaIPOMOEA_69W_5Stele_luminaRece_Calda_Neutra_Dimabila_Alb-4.jpg?v=1778683244","width":1024,"height":1024},{"id":52832661831947,"created_at":"2025-04-02T13:38:31+03:00","position":5,"updated_at":"2026-05-13T17:44:39+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT220_5WH-LustraLEDcutelecomandaIPOMOEA_69W_5Stele_luminaRece_Calda_Neutra_Dimabila_Alb-3.jpg?v=1778683479","width":1024,"height":1024},{"id":62947108847883,"created_at":"2025-12-02T17:00:06+02:00","position":6,"updated_at":"2026-05-13T17:52:22+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb6f8734ed1b2473e997472a4eb48d35eW.jpg?v=1778683942","width":1024,"height":1024},{"id":62947108880651,"created_at":"2025-12-02T17:00:06+02:00","position":7,"updated_at":"2026-05-13T17:55:07+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H580ce6c258ef4f638299d173f02ace70q.jpg?v=1778684107","width":832,"height":832},{"id":51816137261323,"created_at":"2025-02-24T16:37:34+02:00","position":8,"updated_at":"2026-05-13T17:56:13+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-star-telecomanda-144w-dimabila-alb_LL1806AL_04.webp?v=1778684173","width":1024,"height":1024},{"id":51816137294091,"created_at":"2025-02-24T16:37:34+02:00","position":9,"updated_at":"2026-05-13T17:53:28+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-star-cu-telecomanda-144w-dimabila-alb-1698933894.webp?v=1778684008","width":1024,"height":1024},{"id":62947109732619,"created_at":"2025-12-02T17:00:13+02:00","position":10,"updated_at":"2025-12-02T17:00:38+02:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_8af70d73-6fa8-4e6e-bdda-cf42ade05ecb.png?v=1764687638","width":1600,"height":1600},{"id":70067009716491,"created_at":"2026-09-08T13:13:13+03:00","position":11,"updated_at":"2026-09-08T13:13:15+03:00","product_id":9757512204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2598276_big_color.png?v=1788862395","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760609566987,"title":"Lustra LED cu telecomanda ZOE 70W, 5 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-zoe-70w-5-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-start=\"124\" data-end=\"453\"\u003e\u003cstrong data-start=\"124\" data-end=\"157\"\u003eLustra LED cu telecomandă ZOE\u003c\/strong\u003e este un corp de iluminat modern și extrem de versatil, creat pentru a aduce un plus de eleganță și luminozitate spațiilor contemporane. Designul său este alcătuit din \u003cstrong data-start=\"325\" data-end=\"352\"\u003ecinci pătrate stilizate\u003c\/strong\u003e, finisate în alb imaculat, formând o compoziție geometrică armonioasă, cu un impact vizual puternic.\u003c\/p\u003e\u003cp data-start=\"124\" data-end=\"453\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"455\" data-end=\"760\"\u003eCu o putere de \u003cstrong\u003e70W\u003c\/strong\u003e, ZOE oferă o iluminare amplă, uniformă și eficientă, ideală pentru \u003cstrong data-start=\"545\" data-end=\"630\"\u003elivinguri, sufragerii, camere open-space sau încăperi de dimensiuni medii și mari\u003c\/strong\u003e. LED-urile integrate permit selectarea temperaturii de culoare, astfel încât atmosfera să poată fi ajustată în funcție de moment:\u003c\/p\u003e\u003cul data-start=\"762\" data-end=\"980\"\u003e\n\u003cli data-start=\"762\" data-end=\"847\"\u003e\u003cp data-start=\"764\" data-end=\"847\"\u003e\u003cstrong data-start=\"764\" data-end=\"779\"\u003eLumină rece\u003c\/strong\u003e – pentru claritate, energie și activități ce necesită concentrare\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"848\" data-end=\"913\"\u003e\u003cp data-start=\"850\" data-end=\"913\"\u003e\u003cstrong data-start=\"850\" data-end=\"866\"\u003eLumină caldă\u003c\/strong\u003e – perfectă pentru relaxare și confort vizual\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"914\" data-end=\"980\"\u003e\u003cp data-start=\"916\" data-end=\"980\"\u003e\u003cstrong data-start=\"916\" data-end=\"933\"\u003eLumină neutră\u003c\/strong\u003e – ideală pentru iluminare generală, naturală\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-start=\"982\" data-end=\"1199\"\u003eDatorită funcției dimmabile, intensitatea luminii poate fi reglată cu precizie, iar \u003cstrong data-start=\"1071\" data-end=\"1094\"\u003etelecomanda inclusă\u003c\/strong\u003e oferă control complet, de la schimbarea culorii luminii, până la setarea nivelului ideal de intensitate.\u003c\/p\u003e\u003cp data-start=\"982\" data-end=\"1199\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"1201\" data-end=\"1427\"\u003eFinisajul alb evidențiază liniile curate ale pătratelor și adaugă un plus de luminozitate și eleganță încăperii. Forma geometrică modernă face din ZOE atât o sursă de lumină performantă, cât și un element decorativ sofisticat.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:247\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:57:38+02:00","created_at":"2025-02-25T02:57:38+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52422697025803,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT808\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9760609566987,"created_at":"2025-09-28T21:54:00+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":63139276521739,"created_at":"2025-12-08T17:08:29+02:00","position":1,"updated_at":"2026-05-14T10:39:01+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8085WH_4_daabf6bf-b933-464a-98b6-884406cb1c66.png?v=1778744341","width":1024,"height":1024},{"id":63139269214475,"created_at":"2025-12-08T17:07:27+02:00","position":2,"updated_at":"2026-05-14T10:37:52+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8085WH_3.png?v=1778744272","width":1024,"height":1024},{"id":51851917295883,"created_at":"2025-02-25T02:57:41+02:00","position":3,"updated_at":"2026-05-14T10:40:23+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-nely-80w-dimabila-alb-1709819130.webp?v=1778744423","width":1024,"height":1024},{"id":51851917590795,"created_at":"2025-02-25T02:57:41+02:00","position":4,"updated_at":"2026-05-14T10:41:55+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/4-1709819130.webp?v=1778744515","width":1024,"height":1024},{"id":51851917230347,"created_at":"2025-02-25T02:57:41+02:00","position":5,"updated_at":"2026-05-14T10:36:44+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6-1709819131.webp?v=1778744204","width":1024,"height":1024},{"id":63139269181707,"created_at":"2025-12-08T17:07:27+02:00","position":6,"updated_at":"2025-12-08T17:09:05+02:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8085WH_1.png?v=1765206545","width":1500,"height":1500},{"id":63139269148939,"created_at":"2025-12-08T17:07:27+02:00","position":7,"updated_at":"2025-12-08T17:09:05+02:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT8085WH.png?v=1765206545","width":800,"height":800},{"id":68891425505547,"created_at":"2026-05-14T10:40:53+03:00","position":8,"updated_at":"2026-05-14T10:40:58+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage14mai2026_10_40_44.png?v=1778744458","width":1254,"height":1254},{"id":69805819724043,"created_at":"2026-07-21T14:37:22+03:00","position":9,"updated_at":"2026-07-21T14:37:24+03:00","product_id":9760609566987,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697192_big_color.png?v=1784633844","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760822067467,"title":"Lustra LED cu telecomanda si cristal DAISY 53W, 4 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-daisy-53w-4-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"containerimg-mobile\" style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%); text-align: justify;\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/caOrpz9a38o\" style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp data-sourcepos=\"3:1-3:86\"\u003e\u003cstrong\u003eEleganță Florală Modernă și Strălucire Cristalină: Lustra LED cu Telecomandă DAISY\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:287\"\u003eÎmbracă-ți spațiul cu o notă de delicatețe și un plus de strălucire cu lustra LED DAISY. Designul său modern, inspirat de o floare stilizată cu \u003cstrong\u003e4 elemente\u003c\/strong\u003e principale, este finisat în \u003cstrong\u003ealb\u003c\/strong\u003e pur și îmbogățit cu detalii din \u003cstrong\u003ecristal\u003c\/strong\u003e, creând un aspect luminos, elegant și atrăgător.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:287\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003eCu o putere de \u003cstrong\u003e53W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și versatilă, perfectă pentru livinguri, dormitoare sau alte spații în care dorești să creezi o atmosferă primitoare și stilată. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Poți alege între \u003cstrong\u003elumină rece\u003c\/strong\u003e, ideală pentru activități care necesită concentrare; \u003cstrong\u003elumină caldă\u003c\/strong\u003e, perfectă pentru a crea un ambient primitor și relaxant; și \u003cstrong\u003elumină neutră\u003c\/strong\u003e, potrivită pentru iluminatul general de zi cu zi.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:511\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:184\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminoasă, creând astfel ambientul perfect pentru fiecare moment, de la o lumină strălucitoare la o lumină ambientală subtilă.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-21:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:96\"\u003e\n\u003cstrong\u003eDesign Floral Modern:\u003c\/strong\u003e Inspirat de o floare stilizată cu 4 elemente și detalii din cristal.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:54\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 53W pentru o iluminare optimă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:91\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al temperaturii culorii și intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:94\"\u003e\n\u003cstrong\u003eTrei Temperaturi de Culoare:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru a se potrivi oricărei ocazii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:82\"\u003e\n\u003cstrong\u003eFinisaj Alb cu Cristal:\u003c\/strong\u003e Aspect luminos, elegant și cu un plus de strălucire.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-19:80\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Acril durabil, metal rezistent și cristale premium.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-21:0\"\u003e\n\u003cstrong\u003eStil Modern și Elegant:\u003c\/strong\u003e Se integrează perfect în interioarele moderne, minimaliste sau cu accente glamour.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"22:1-22:14\"\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"22:1-22:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"24:1-29:0\"\u003e\n\u003cli data-sourcepos=\"24:1-24:93\"\u003e\n\u003cstrong\u003eControl Total al Luminii:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:79\"\u003e\n\u003cstrong\u003eAtmosferă Personalizată:\u003c\/strong\u003e Creează ambientul perfect pentru fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:113\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Designul floral și detaliile din cristal adaugă o notă de eleganță și originalitate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii simplu și confortabil.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"30:1-30:192\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"30:1-30:192\"\u003eLustra LED cu telecomandă DAISY este alegerea ideală pentru a adăuga un plus de stil, confort și strălucire subtilă în casa ta. Bucură-te de iluminarea adaptabilă și de designul floral modern!\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:32:17+02:00","created_at":"2025-02-25T03:32:16+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429936820491,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT213\/4WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9760822067467,"created_at":"2025-09-30T17:56:43+03:00","upda