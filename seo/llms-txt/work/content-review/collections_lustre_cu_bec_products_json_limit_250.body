:"2025-09-30T14:07:47+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":59125542748427,"created_at":"2025-08-14T13:02:25+03:00","position":1,"updated_at":"2025-08-14T13:02:49+03:00","product_id":9779349061899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3b8a6463-f9df-4990-aaed-8f3efffeca02.png?v=1755165769","width":1382,"height":1382},{"id":59125015675147,"created_at":"2025-08-14T12:03:57+03:00","position":2,"updated_at":"2025-08-14T12:04:00+03:00","product_id":9779349061899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H0930d8116ca4434cae57f57598c900124.jpg?v=1755162240","width":800,"height":800},{"id":59125610774795,"created_at":"2025-08-14T13:08:19+03:00","position":3,"updated_at":"2025-08-14T13:08:24+03:00","product_id":9779349061899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_a67d3f01-4091-440c-a2bd-14e1a300c575.png?v=1755166104","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779346604299,"title":"Lustra Suspendata SVEN, 15x G9, Gri","handle":"lustra-suspendata-sven-15x-g9-gri","body_html":"\u003cp data-start=\"106\" data-end=\"391\"\u003e\u003cstrong data-start=\"106\" data-end=\"150\"\u003eLustra suspendata SVEN, 15x G9, argintiu\u003c\/strong\u003e, impresioneaza printr-un design modern cu accente elegante si o structura globulara spectaculoasa. Combinatia de \u003cstrong data-start=\"264\" data-end=\"296\"\u003ediscuri metalice gri deschis\u003c\/strong\u003e si \u003cstrong data-start=\"300\" data-end=\"322\"\u003egloburi albe opace\u003c\/strong\u003e creeaza un efect vizual deosebit, ideal pentru un decor contemporan.\u003c\/p\u003e\u003cp data-start=\"393\" data-end=\"608\"\u003eFunctioneaza cu \u003cstrong data-start=\"409\" data-end=\"425\"\u003e15 socluri G9\u003c\/strong\u003e si se alimenteaza la \u003cstrong data-start=\"447\" data-end=\"459\"\u003e220-230V\u003c\/strong\u003e, oferind o iluminare uniforma si calda. Este recomandata pentru \u003cstrong data-start=\"524\" data-end=\"563\"\u003eliving, dormitor sau zona de dining\u003c\/strong\u003e, fiind potrivita pentru montaj pe \u003cstrong data-start=\"598\" data-end=\"607\"\u003etavan\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-start=\"610\" data-end=\"820\"\u003e\u003cstrong data-start=\"610\" data-end=\"636\"\u003eConstructie suspendata\u003c\/strong\u003e, cu \u003cstrong data-start=\"641\" data-end=\"668\"\u003eclasa de protectie IP21\u003c\/strong\u003e, se integreaza perfect in spatii moderne, minimaliste sau cu accente naturale. Functionare simpla prin \u003cstrong data-start=\"772\" data-end=\"795\"\u003eintrerupator clasic\u003c\/strong\u003e, conectare \u003cstrong data-start=\"807\" data-end=\"819\"\u003ela retea\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-g9.jpg?v=1747387418\"\u003e\u003c\/p\u003e","published_at":"2025-09-21T22:57:45+03:00","created_at":"2025-03-06T18:44:21+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu bec moderne"],"variants":[{"id":52105659220235,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC820\/15GR","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"539.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":9779346604299,"created_at":"2025-08-21T15:56:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":56497240473867,"created_at":"2025-06-17T14:43:31+03:00","position":1,"updated_at":"2025-06-17T14:43:35+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-LustraSuspendataSVEN_15xG9_Argintiu-1.png?v=1750160615","width":1024,"height":1024},{"id":56497240998155,"created_at":"2025-06-17T14:43:31+03:00","position":2,"updated_at":"2025-06-17T14:43:45+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-Lustra_Suspendata_SVEN_15x_G9_Argintiu-6.png?v=1750160625","width":1080,"height":1080},{"id":56497240703243,"created_at":"2025-06-17T14:43:31+03:00","position":3,"updated_at":"2025-06-17T14:43:35+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-LustraSuspendataSVEN_15xG9_Argintiu-5.png?v=1750160615","width":1024,"height":1024},{"id":56497240834315,"created_at":"2025-06-17T14:43:31+03:00","position":4,"updated_at":"2025-06-17T14:43:35+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-LustraSuspendataSVEN_15xG9_Argintiu-4.png?v=1750160615","width":1024,"height":1024},{"id":56497240506635,"created_at":"2025-06-17T14:43:31+03:00","position":5,"updated_at":"2025-06-17T14:43:35+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-LustraSuspendataSVEN_15xG9_Argintiu-3.png?v=1750160615","width":1024,"height":1024},{"id":56497240604939,"created_at":"2025-06-17T14:43:31+03:00","position":6,"updated_at":"2025-06-17T14:43:35+03:00","product_id":9779346604299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC82015GR-LustraSuspendataSVEN_15xG9_Argintiu-2.png?v=1750160615","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759477989643,"title":"Conector Liniar Sina Magnetica, 10 cm, Negru","handle":"conector-liniar-sina-magnetica-10-cm-negru","body_html":"","published_at":"2025-02-24T23:53:13+02:00","created_at":"2025-02-24T23:53:12+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Produse LED","tags":["active","Corpuri de Iluminat","Produse LED","Proiectoare sina magnetica"],"variants":[{"id":52408663408907,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-CNTR10","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"49.99","grams":0,"compare_at_price":"49.99","position":1,"product_id":9759477989643,"created_at":"2025-09-24T14:42:54+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51833241895179,"created_at":"2025-02-24T23:53:15+02:00","position":1,"updated_at":"2025-02-24T23:53:16+02:00","product_id":9759477989643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/conector-liniar-sina-magnetica-10-cm-negru__01.webp?v=1740433996","width":900,"height":900},{"id":51833241927947,"created_at":"2025-02-24T23:53:15+02:00","position":2,"updated_at":"2026-08-19T17:16:12+03:00","product_id":9759477989643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Conector_Electric_Drept_Pentru_Sina_Magnetica_NAVOI_Metal_si_Acrilic_Negru_2.webp?v=1787148972","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758252794123,"title":"Pendul Archer 4x E27 Negru","handle":"pendul-archer-4x-e27-negru","body_html":"\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003e\u003cstrong\u003e'Este atat de usor sa controlezi atmosfera'\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size:16px\"\u003e\u003cem\u003eDeși conceptul de pendul are origini antice, corpurile de iluminat de acest tip și-au început povestea odată cu amploarea luată de designul industrial în anii 1930 - 1940. Moderne, fascinante prin modul în care lumina lor coboară din tavan și umple de energie întreaga încăpere de la nivelul privirii, pendulele vor intensifica atmosfera plăcută din casa ta.\u003c\/em\u003e\u003cbr\u003e \u003cbr\u003ePendulul, cunoscute și ca lampă suspendată, poate să aducă un plus de valoare vizuală în spații precum bucătăria, living-ul, dormitorul, holul înalt ș.a. Pendulele sunt alese pentru iluminarea proiectată pe o anumită zonă a încăperii - spre exemplu, vei obține un efect superb dacă amplasezi pendulul deasupra mesei sau a insulei de bucătărie. La fel poți proceda și cu un obiect decorativ special sau cu un tablou: va fi pus în evidență de lumina concentrată deasupra acestuia.\u003cbr\u003e\u003cbr\u003ePendulele sunt corpuri de iluminat cu unul sau mai multe becuri, suspendate printr-un cablu flexibil sau tija rigidă dar reglabilă, astfel încat poți regla ușor înalțimea dorită.\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003eUtilizând pendulele în planurile tale de design interior vei crea cu ajutorul lor zone de lumină, vei putea delimita sau pune un accent pe anumite suprafețe sau zone ale spațiului interior. Un pendul deasupra mesei va crea mici oaze de calm și relaxare, unde vei putea să savurezi o cină în tihnă cu cei dragi, să lucrezi sau să citești.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eBECURILE NU SUNT INCLUSE!\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T21:01:10+02:00","created_at":"2025-02-24T21:01:09+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52425681469707,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8183\/4","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"289.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":9758252794123,"created_at":"2025-09-29T23:05:47+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51820736151819,"created_at":"2025-02-24T21:01:11+02:00","position":1,"updated_at":"2025-02-24T21:01:13+02:00","product_id":9758252794123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-archer-4x-e27-negru-1722956974.webp?v=1740423673","width":900,"height":900},{"id":51820736184587,"created_at":"2025-02-24T21:01:11+02:00","position":2,"updated_at":"2025-02-24T21:01:13+02:00","product_id":9758252794123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-archer-4x-e27-negru_PDL2210N_02.webp?v=1740423673","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10977236320523,"title":"Lustra LED Ventilator ANEMO cu Telecomanda, 30W, D61cm, Lumina Rece\/Neutra\/Calda, Metal si Plastic, Alb","handle":"lustra-led-ventilator-anemo-cu-telecomanda-30w-d61cm-lumina-rece-neutra-calda-metal-si-plastic-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003chr\u003e\n\u003cp\u003eTransformă orice încăpere într-un spațiu modern și funcțional cu această lustră LED cu ventilator integrat și telecomandă. Concepută pentru a combina designul elegant cu utilitatea, oferă atât iluminare eficientă, cât și răcire discretă, într-un singur produs compact.\u003c\/p\u003e\n\u003cp\u003eCu un \u003cstrong\u003ediametru de 61 \u003c\/strong\u003ecm și finisaj alb mat, lustra se integrează perfect în interioare contemporane, fie că este vorba de living, dormitor sau birou.\u003c\/p\u003e\n\u003cp\u003eVentilatorul silențios asigură o circulație optimă a aerului, iar iluminarea LED de 30W permite alegerea temperaturii de culoare în funcție de momentul zilei sau atmosferă.\u003c\/p\u003e\n\u003cp\u003eControlul este simplu și rapid datorită telecomenzii incluse, care îți oferă acces la toate funcțiile fără efort.\u003c\/p\u003e✨ \u003cspan style=\"text-decoration: underline;\"\u003e\u003cstrong\u003eBeneficii principale:\u003c\/strong\u003e\u003c\/span\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e2 în 1:\u003c\/strong\u003e iluminare LED + ventilator integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTelecomandă inclusă:\u003c\/strong\u003e control facil al luminii și ventilatorului\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e3 tipuri de lumină:\u003c\/strong\u003e rece, neutră și caldă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEficiență energetică:\u003c\/strong\u003e consum redus de doar 30W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVentilator silențios:\u003c\/strong\u003e confort fără zgomot\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesign modern:\u003c\/strong\u003e finisaj alb elegant, potrivit pentru orice decor\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eAlege această lustră LED cu ventilator pentru un echilibru perfect între estetică, tehnologie și confort zilnic. Ideală pentru cei care își doresc un ambient plăcut, modern și eficient energetic.\u003cstrong\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic_7bd40fac-f842-40eb-8767-5d8091b2a033.webp?v=1777037376\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0ec16c49-06e2-4a50-a751-a47b07e70ba2.webp?v=1777037375\" alt=\"\"\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led_eb01595f-f014-453a-b6b0-e255cf96ad97.webp?v=1777037376\" alt=\"\"\u003e\u003c\/div\u003e","published_at":"2026-06-15T14:35:51+03:00","created_at":"2026-06-10T11:59:34+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":53173304197387,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CF102\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"269.79","grams":0,"compare_at_price":"269.79","position":1,"product_id":10977236320523,"created_at":"2026-06-10T11:59:35+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69392534601995,"created_at":"2026-06-10T12:02:57+03:00","position":1,"updated_at":"2026-06-10T12:58:20+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_01_10_125a6f9e-88fe-4a28-9cab-be52dd3f649f.png?v=1781085500","width":1024,"height":1024},{"id":69392528408843,"created_at":"2026-06-10T12:01:51+03:00","position":2,"updated_at":"2026-06-10T12:55:10+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_01_10.png?v=1781085310","width":1024,"height":1024},{"id":69392534503691,"created_at":"2026-06-10T12:02:55+03:00","position":3,"updated_at":"2026-06-10T12:59:13+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_01_10_1fcfa4d9-c7ab-4421-8799-2c5a861a5b6b.png?v=1781085553","width":1024,"height":1024},{"id":69392803365131,"created_at":"2026-06-10T12:59:21+03:00","position":4,"updated_at":"2026-06-10T13:00:30+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_01_10_b4703206-552b-4246-9209-71191b32629b.png?v=1781085630","width":1024,"height":1024},{"id":69392810148107,"created_at":"2026-06-10T13:00:40+03:00","position":5,"updated_at":"2026-06-10T13:00:46+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_58_14.png?v=1781085646","width":1254,"height":1254},{"id":69392810180875,"created_at":"2026-06-10T13:00:40+03:00","position":6,"updated_at":"2026-06-10T13:00:44+03:00","product_id":10977236320523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_12_01_10_8f2ba9b4-17e8-4b9c-9216-29eb39ee7ab5.png?v=1781085644","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760664518923,"title":"Lustra LED cu telecomanda LELAHEL 190W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomanda-lelahel-190w-4-patrate-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp data-sourcepos=\"1:1-1:283\"\u003eLustra LED cu telecomandă LELAHEL este o piesă de iluminat modernă și opulentă, cu un design format din 4 pătrate stilizate, finisate într-o nuanță aurie care adaugă o notă de lux și căldură. Cu o putere impresionantă de 190W, oferă o iluminare amplă și versatilă pentru spații mari.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:476\"\u003eCele patru pătrate, dispuse probabil într-o manieră care creează un ansamblu vizual echilibrat și impunător, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:302\"\u003eFinisajul auriu al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de eleganță și somptuozitate încăperii. Cu o putere de 190W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte spații de dimensiuni considerabile unde se dorește un element de design statement.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:04:28+02:00","created_at":"2025-02-25T03:04:27+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52412030943499,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-L71139\/300+200GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9760664518923,"created_at":"2025-09-25T15:49:11+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852822675723,"created_at":"2025-02-25T03:04:29+02:00","position":1,"updated_at":"2025-02-25T03:04:31+02:00","product_id":9760664518923,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-lelahel-190w-dimabila-alb-1709891211.webp?v=1740445471","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760259375371,"title":"Panou LED Incastrat 48W Lumina Calda Alb","handle":"panou-led-incastrat-48w-lumina-calda-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003ePanoul LED încastrat cu forma dreptunghiulară este o alegere excelentă pentru a crea o atmosferă caldă și primitoare în diverse încăperi. Cu o putere de 48W și culoarea albă, acest panou LED încastrat oferă o lumină caldă, potrivită pentru momentele de relaxare și confort.\u003cbr\u003e  \u003cbr\u003e  Dimensiunile sale de 120cm lungime, 30cm lățime și 3cm înălțime îl fac ideal pentru a fi montat în tavan sau pe perete, asigurând un iluminat bine distribuit și estetic în încăpere.\u003cbr\u003e  \u003cbr\u003e  Cu un flux luminos de 3840lm, acest panou LED încastrat furnizează o iluminare plăcută și suficientă, potrivită pentru diverse activități din rutina zilnică.\u003cbr\u003e  \u003cbr\u003e  Lumina caldă oferită de acest panou LED încastrat creează o atmosferă relaxantă și primitoare, fiind ideală pentru zonele de odihnă și pentru a crea o ambianță plăcută în locuință sau în spațiul comercial.\u003cbr\u003e  \u003cbr\u003e  Designul său minimalist și ordonat îl face să se integreze cu ușurință în diferite stiluri de interior, aducând un aspect modern și estetic în încăperea dvs.\u003cbr\u003e  \u003cbr\u003e  Panoul LED încastrat cu puterea de 48W și fluxul luminos de 3840lm, împreună cu lumina caldă pe care o oferă, reprezintă o alegere excelentă pentru a beneficia de un iluminat confortabil și relaxant în diferite încăperi. Indiferent dacă este utilizat în bucătărie sau alte spații, acest panou LED va aduce o lumină plăcută și primitoare, contribuind la crearea unui mediu ambiental plăcut și reconfortant în fiecare zi.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:03:03+02:00","created_at":"2025-02-25T02:03:02+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Spin Comexim","product_type":"","tags":["active","Corpuri de Iluminat","Delistat Alessandro","Plafoniere LED"],"variants":[{"id":52406912876811,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-SP1N-HT2L-SPN7487","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"69.97","grams":0,"compare_at_price":"0.00","position":1,"product_id":9760259375371,"created_at":"2025-09-24T01:04:08+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51845964431627,"created_at":"2025-02-25T02:03:04+02:00","position":1,"updated_at":"2025-02-25T02:03:06+02:00","product_id":9760259375371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-lumina-calda-alb-1690801562.webp?v=1740441786","width":900,"height":900},{"id":51845964333323,"created_at":"2025-02-25T02:03:04+02:00","position":2,"updated_at":"2025-02-25T02:03:06+02:00","product_id":9760259375371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-alb_spn7487_02-1690801563.webp?v=1740441786","width":900,"height":900},{"id":51846001623307,"created_at":"2025-02-25T02:03:17+02:00","position":3,"updated_at":"2025-02-25T02:03:18+02:00","product_id":9760259375371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-lumina-calda-alb-1690802257.webp?v=1740441798","width":900,"height":900},{"id":51846001590539,"created_at":"2025-02-25T02:03:17+02:00","position":4,"updated_at":"2025-02-25T02:03:18+02:00","product_id":9760259375371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-alb_spn7471_02-1690802258.webp?v=1740441798","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759739576587,"title":"Lustra LED suspendata cu telecomanda si cristal MERVE 24W, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-merve-24w-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cristal Merve este o piesă de artă în domeniul iluminatului, combinând eleganța cristalelor cu un design modern și funcțional. Cu o putere de 24W și un finisaj argintiu rafinat, această lustră aduce un plus de stil și lumină în orice spațiu interior.\u003cbr\u003e\u003cbr\u003eDesignul distinctiv al lustrei Merve este format din două linii curbate, împodobite cu cristale transparente, care creează un efect vizual captivant. Stilul tip pendul al acestor linii conferă un aspect dinamic și atrăgător, în timp ce cristalele amplasate de-a lungul lor refractă lumina în moduri spectaculoase, creând un joc de scânteieri și străluciri sofisticate.\u003cbr\u003e\u003cbr\u003eLustra Merve vine echipată cu o telecomandă convenabilă, care vă permite să schimbați între trei tipuri de lumină – caldă, rece și neutră. Această caracteristică oferă flexibilitatea de a adapta iluminatul în funcție de atmosfera dorită sau de nevoile specifice, făcând din această lustră o soluție ideală pentru diferite momente ale zilei. Cu un flux luminos de 1920lm, lustra LED Cristal Merve oferă o iluminare adecvată pentru spații medii, fiind ideală pentru livinguri, dormitoare sau zone de dining. Tehnologia LED asigură o eficiență energetică ridicată și o durată de viață îndelungată, ceea ce o transformă într-o opțiune economică și ecologică.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal Merve este alegerea perfectă pentru cei care doresc să combine un design curbat și elegant cu funcționalitatea modernă și eficiența energetică. Este soluția ideală pentru a adăuga un strop de rafinament și versatilitate în orice ambient, oferind un iluminat de calitate superioră care să îmbunătățească aspectul și atmosfera oricărui interior.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:31:41+02:00","created_at":"2025-02-25T00:31:41+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Candelabre Moderne","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52409354584331,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-6994\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"599.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":9759739576587,"created_at":"2025-09-24T17:53:51+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51836606906635,"created_at":"2025-02-25T00:31:43+02:00","position":1,"updated_at":"2025-02-25T00:31:45+02:00","product_id":9759739576587,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-merve-24w-argintiu-1695808220.webp?v=1740436305","width":900,"height":900},{"id":51836606152971,"created_at":"2025-02-25T00:31:43+02:00","position":2,"updated_at":"2025-02-25T00:31:45+02:00","product_id":9759739576587,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-merve-24w-argintiu_AT1CT-CH1A-HT2L-6994-2_01-1695808220.webp?v=1740436305","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759640518923,"title":"Plafoniera LED Damla 12W Alb","handle":"plafoniera-led-damla-12w-alb","body_html":"\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-family: Roboto, sans-serif; font-size: 14.000001px; text-align: center;\"\u003e\n\u003cspan style=\"font-size:16px\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-family: Roboto, sans-serif; font-size: 14.000001px;\"\u003e\u003cspan style=\"font-size:16px\"\u003ePlafoniera Alessandro Design incorporează atât tehnologia modernă cât și eleganța într-un produs unic, menit să-i confere casei tale un aspect vibrant si plăcut estetic. Realizată din materiale de calitate păstrând înălțimea redusă și designul simplu această plafonieră reprezintă cea mai bună variantă de iluminare pentru spațiile cu tavane joase. \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:13:51+02:00","created_at":"2025-02-25T00:13:51+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Spin Comexim","product_type":"Plafoniere LED","tags":["active","Corpuri de Iluminat","Delistat Alessandro","Plafoniere LED"],"variants":[{"id":52038294503691,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-SP1N-HT2L-DL75513","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"79.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":9759640518923,"created_at":"2025-08-05T15:19:43+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51835161411851,"created_at":"2025-02-25T00:13:52+02:00","position":1,"updated_at":"2025-02-25T00:13:54+02:00","product_id":9759640518923,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-damla-12w-alb_PF2374AL_01.webp?v=1740435234","width":900,"height":900},{"id":51835161248011,"created_at":"2025-02-25T00:13:52+02:00","position":2,"updated_at":"2025-02-25T00:13:54+02:00","product_id":9759640518923,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-damla-12w-alb_PF2374AL_02.webp?v=1740435234","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759512166667,"title":"Alimentator Sina Magnetica 100W, Negru, Metal","handle":"alimentator-sina-magnetica-100w-negru-metal","body_html":"\u003cspan style=\"font-size:16px\"\u003e\u003cspan style=\"font-family:verdana,geneva,sans-serif\"\u003eSe poziționează în capătul șinei și prin el se alimentează toată linia. Puteți pune și zece metri liniari de șină pe 1 singur alimentator cu condiția să nu depășească puterea proiectoarelor cât ține alimentatorul.\u003c\/span\u003e\u003c\/span\u003e","published_at":"2025-02-24T23:57:28+02:00","created_at":"2025-02-24T23:57:27+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Produse LED","tags":["active","Corpuri de Iluminat","Produse LED","Proiectoare sina magnetica"],"variants":[{"id":52408683036939,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-ALM100","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"99.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":9759512166667,"created_at":"2025-09-24T14:52:57+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51833595363595,"created_at":"2025-02-24T23:57:29+02:00","position":1,"updated_at":"2025-02-24T23:57:32+02:00","product_id":9759512166667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/alimentator-sina-magnetica-100w-negru-metal_AT1CT-CH1A-HT2L-ALM100_01.webp?v=1740434252","width":900,"height":900},{"id":51833594413323,"created_at":"2025-02-24T23:57:30+02:00","position":2,"updated_at":"2025-02-24T23:57:31+02:00","product_id":9759512166667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/alimentator-sina-magnetica-100w-negru-metal_AT1CT-CH1A-HT2L-ALM100_02.webp?v=1740434251","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758251909387,"title":"Pendul Patrisi 2x E27 Negru","handle":"pendul-patrisi-2x-e27-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003eAceastă lustră expune un design simplistic dar extrem de elegant. Scheletul este realizat atât din metal (pentru o durată de viață ridicată) cât și din lemn, conferind un aspect plăcut unui produs de înaltă calitate. Cel mai impresionant însă este abajurul fin, realizat din sticlă, ce înconjoară sursele de lumină. Odată aprinse, abajurul luminează într-un mod surprinzător, plăcut estetic, datorită proprietăților materialului. Elegant pentru orice încăpere.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T21:00:57+02:00","created_at":"2025-02-24T21:00:56+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52408520081675,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8183\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9758251909387,"created_at":"2025-09-24T13:44:03+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51820731957515,"created_at":"2025-02-24T21:00:59+02:00","position":1,"updated_at":"2025-02-24T21:01:01+02:00","product_id":9758251909387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrisi-2xe27-metal-negru_8183-2_01.webp?v=1740423661","width":900,"height":900},{"id":51820731924747,"created_at":"2025-02-24T21:00:59+02:00","position":2,"updated_at":"2025-02-24T21:01:01+02:00","product_id":9758251909387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrisi-2xe27-metal-negru_8183-2_02.webp?v=1740423661","width":900,"height":900},{"id":51820731891979,"created_at":"2025-02-24T21:00:59+02:00","position":3,"updated_at":"2025-02-24T21:01:01+02:00","product_id":9758251909387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrisi-2xe27-metal-negru_8183-2_03.webp?v=1740423661","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757213065483,"title":"Lustra Franghie, 2*E27, Maro, Metal si Sfoara","handle":"lustra-franghie-2-e27-maro-metal-si-sfoara","body_html":"\u003cdiv\u003e\u003cspan style=\"font-size:16px\"\u003eLustra reprezintă un element de iluminare practic ce completează atmosfera elegantă a încăperii unde îți dorești să creezi o atmosferă caldă și primitoare. \u003cbr\u003e \u003cbr\u003eRealizate din materiale de înaltă calitate acestea au o durată lungă de viață și vă veți putea bucura mult timp de frumusețea și lumina lustrei alese!\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T14:42:29+02:00","created_at":"2025-02-24T14:42:28+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52408426692875,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2204\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"199.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757213065483,"created_at":"2025-09-24T13:16:52+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":56268573573387,"created_at":"2025-06-10T12:28:16+03:00","position":1,"updated_at":"2026-05-14T11:48:55+03:00","product_id":9757213065483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-2204_2-Lustra_Franghie_2_E27_Maro_Metal_si_Sfoara-1.webp?v=1778748535","width":1024,"height":1024},{"id":51813538529547,"created_at":"2025-02-24T14:42:31+02:00","position":2,"updated_at":"2026-05-14T11:56:55+03:00","product_id":9757213065483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-2xe27-maro-metal-sfoara_LC1078_03.webp?v=1778749015","width":1024,"height":1024},{"id":51813538595083,"created_at":"2025-02-24T14:42:31+02:00","position":3,"updated_at":"2026-05-14T11:59:17+03:00","product_id":9757213065483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-2xe27-maro-metal-sfoara_LC1078_02.webp?v=1778749157","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10895700656395,"title":"Plafonieră LED Stele 35 cm, 31W, 3000K \/ 4000K \/ 6000K, Alb, Metal si Acril","handle":"plafoniera-led-pl156-35-35-cm-32w-3000k-4000k-6000k-alb-metal-si-acril","body_html":"\u003cp\u003ePlafoniera LED cu diametrul de 35 cm este soluția ideală pentru iluminatul modern al locuinței. Cu un design simplu și finisaj alb elegant, aceasta se integrează ușor în orice tip de amenajare – de la spații rezidențiale până la birouri sau zone comerciale. Dimensiunea compactă o face potrivită pentru holuri, bucătării, băi, dormitoare sau camere de dimensiuni mici și medii.\u003c\/p\u003e\u003cp\u003eCu o putere de 31W, plafoniera oferă un flux luminos puternic și uniform, asigurând iluminare optimă cu un consum redus de energie. Tehnologia LED contribuie la economii semnificative la factura de electricitate și garantează o durată de viață îndelungată, fără costuri suplimentare de întreținere.\u003c\/p\u003e\u003cp\u003eModelul permite selectarea temperaturii de culoare între 3000K (lumină caldă), 4000K (lumină neutră) și 6000K (lumină rece), oferind flexibilitate în funcție de preferințe și de destinația spațiului. Poți crea o atmosferă relaxantă sau una energizantă, adaptată activităților zilnice.\u003c\/p\u003e\u003cp\u003eInstalarea este rapidă și simplă, iar dispersia uniformă a luminii elimină zonele umbrite sau efectul de orbire. Este o alegere practică și estetică pentru cei care caută un corp de iluminat eficient, durabil și versatil.\u003c\/p\u003e\u003chr\u003e\u003ch3\u003eSpecificații tehnice:\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eTip produs: Plafonieră LED\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003ePutere: 31W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDiametru: 35 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eCuloare carcasă: Alb\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTemperatură culoare: 3000K \/ 4000K \/ 6000K\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTehnologie: LED integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eMontaj: Aplicat pe tavan\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2026-03-31T12:21:55+03:00","created_at":"2026-02-26T13:37:46+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["Corpuri de Iluminat","Plafoniere LED"],"variants":[{"id":52933085364491,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-PL156\/35","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"43.79","grams":0,"compare_at_price":"49.99","position":1,"product_id":10895700656395,"created_at":"2026-02-26T13:37:47+02:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68972811845899,"created_at":"2026-05-19T17:01:59+03:00","position":1,"updated_at":"2026-06-04T13:59:19+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/496342_7_0405085d-59d1-4ad4-90cd-64685cb1b95b.jpg?v=1780570759","width":1024,"height":1024},{"id":66441748676875,"created_at":"2026-02-26T13:38:04+02:00","position":2,"updated_at":"2026-06-04T14:03:19+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/496342_7_23c1a6d6-fb87-42f5-aab5-e89d60bd2568.jpg?v=1780570999","width":832,"height":832},{"id":68972811518219,"created_at":"2026-05-19T17:01:50+03:00","position":3,"updated_at":"2026-06-04T14:04:10+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/496342_7_d625c222-6a88-4e9e-9bad-5924c4f23b23.jpg?v=1780571050","width":1024,"height":1024},{"id":66441748644107,"created_at":"2026-02-26T13:38:04+02:00","position":4,"updated_at":"2026-05-19T17:11:55+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/180019169_43fc7161-b67b-4d19-99e7-9eb7499b9811.webp?v=1779199915","width":1024,"height":1024},{"id":66441748709643,"created_at":"2026-02-26T13:38:04+02:00","position":5,"updated_at":"2026-05-19T17:12:44+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/496342_6_e26badf8-48a3-4692-9716-59622303ec5e.jpg?v=1779199964","width":1024,"height":1024},{"id":66441748742411,"created_at":"2026-02-26T13:38:04+02:00","position":6,"updated_at":"2026-05-19T17:13:39+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/496342_2_29c31da7-7ce2-49b1-a710-4bd1af089ede.jpg?v=1779200019","width":1024,"height":1024},{"id":68972812501259,"created_at":"2026-05-19T17:02:11+03:00","position":7,"updated_at":"2026-05-19T17:02:15+03:00","product_id":10895700656395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage19mai2026_16_26_18_e507eb57-613d-4172-9ac9-c11e4998a730.png?v=1779199335","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10888304525579,"title":"Lustra LM530\/3BK, 3 X E27, Negru, Metal si Sticla","handle":"lustra-lm530-3bk-3-x-e27-negru-metal-si-sticla","body_html":"\u003cp data-start=\"0\" data-end=\"267\"\u003eLustra \u003cstrong data-start=\"7\" data-end=\"28\"\u003eMonica LM530\/3BK\u003c\/strong\u003e este un corp de iluminat modern, realizat din metal și sticlă, cu finisaj \u003cstrong data-start=\"103\" data-end=\"112\"\u003enegru\u003c\/strong\u003e, ideal pentru interioare contemporane. Echipată cu \u003cstrong data-start=\"164\" data-end=\"181\"\u003e3 socluri E27\u003c\/strong\u003e, oferă o iluminare uniformă și plăcută, potrivită pentru living, dining sau dormitor.\u003c\/p\u003e\u003cp data-start=\"269\" data-end=\"496\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eAbajururile din sticlă fumurie adaugă eleganță și profunzime vizuală, iar contrastul cu structura neagră conferă un aspect rafinat și modern. Lustra Monica LC910\/3RBK este o alegere versatilă pentru decoruri stilate și actuale.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2026-02-25T20:28:13+02:00","created_at":"2026-02-19T14:07:18+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","Corpuri de Iluminat","Lustre Clasice","Lustre cu Abajur","Lustre cu bec"],"variants":[{"id":52910927020299,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LM530\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.79","grams":0,"compare_at_price":"179.99","position":1,"product_id":10888304525579,"created_at":"2026-02-19T14:07:19+02:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":66029085851915,"created_at":"2026-02-19T15:46:26+02:00","position":1,"updated_at":"2026-02-19T15:46:32+02:00","product_id":10888304525579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_dc3fed99-e96d-4f51-829c-81af47af7e4f.jpg?v=1771508792","width":3000,"height":3500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10724053418251,"title":"Lustra Franghie, 5xE27, Maro, Metal si Sfoara LV570\/5BK","handle":"lustra-franghie-5-e27-maro-metal-si-sfoara-lv570-5bk","body_html":"\u003cdiv\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cem\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte\u003c\/em\u003e\u003cspan style=\"color: rgb(50, 51, 56);\"\u003e.\u003cbr\u003e\u003cbr\u003eAceastă lustră este realizată din materiale de înaltă calitate și vă veți putea bucura de lumina sa un timp îndelungat!\u003c\/span\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e","published_at":"2025-10-21T21:44:09+03:00","created_at":"2025-09-15T15:13:05+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52397508559115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LV570\/5BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10724053418251,"created_at":"2025-09-20T21:42:01+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60333603193099,"created_at":"2025-09-15T15:14:27+03:00","position":1,"updated_at":"2025-09-15T15:14:42+03:00","product_id":10724053418251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_99277ba4-2fe3-4445-a81e-0acc03010803.png?v=1757938482","width":800,"height":800},{"id":51813577490699,"created_at":"2025-02-24T14:44:42+02:00","position":2,"updated_at":"2025-09-15T15:14:42+03:00","product_id":10724053418251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-5xe27-maro-metal-sfoara_LC1010_04.webp?v=1757938482","width":794,"height":794},{"id":51813577523467,"created_at":"2025-02-24T14:44:42+02:00","position":3,"updated_at":"2025-09-15T15:14:42+03:00","product_id":10724053418251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-5xe27-maro-metal-sfoara_LC1010_02.webp?v=1757938482","width":900,"height":900},{"id":51813577457931,"created_at":"2025-02-24T14:44:42+02:00","position":4,"updated_at":"2025-09-15T15:15:03+03:00","product_id":10724053418251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-5xe27-maro-metal-sfoara_LC1010_01.webp?v=1757938503","width":795,"height":795},{"id":60333602930955,"created_at":"2025-09-15T15:14:26+03:00","position":5,"updated_at":"2025-09-15T15:14:30+03:00","product_id":10724053418251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_2_45c7e283-a19c-4da4-bccd-e38bea6e20b1.png?v=1757938470","width":1200,"height":1200}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133785477387,"title":"Lustra LED cu telecomanda VARIO 69W, Oval , lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-vario-110w-oval-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-start=\"236\" data-end=\"486\" class=\"\"\u003eDescoperă eleganța geometrică a lustrei VARIO, o piesă statement pentru interioarele moderne. Cu un design oval oblic, accente negre , albe și linii fluide, această lustră adaugă un plus de rafinament oricărui spațiu – living, dormitor sau birou.\u003c\/p\u003e\u003cp data-start=\"488\" data-end=\"761\" class=\"\"\u003eEchipată cu tehnologie LED de 69W, VARIO oferă trei tipuri de lumină (rece, caldă și neutră), adaptabile prin telecomandă în funcție de momentul zilei sau atmosfera dorită. Funcția dimabilă permite ajustarea intensității luminoase, pentru un confort vizual personalizat.\u003c\/p\u003e\u003cp data-start=\"488\" data-end=\"761\" class=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:32:30+03:00","created_at":"2025-04-14T23:13:44+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Back2school","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429938721035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT637\/500BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"281.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":10133785477387,"created_at":"2025-09-30T17:56:58+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68688525525259,"created_at":"2026-05-04T09:22:47+03:00","position":1,"updated_at":"2026-05-04T09:23:52+03:00","product_id":10133785477387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT637_500BK-LustraLEDcutelecomandaVARIOOBLIQUO_110W_Oval_luminaRece_Calda_Neutra_Dimabila_Negru-1_fb8b3952-6f0c-475f-aca6-e89d3ec8ef5f.jpg?v=1777875832","width":1024,"height":1024},{"id":68688525558027,"created_at":"2026-05-04T09:22:49+03:00","position":2,"updated_at":"2026-05-04T09:24:56+03:00","product_id":10133785477387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT637_500BK-LustraLEDcutelecomandaVARIOOBLIQUO_110W_Oval_luminaRece_Calda_Neutra_Dimabila_Negru-1_f379d1e5-d413-4