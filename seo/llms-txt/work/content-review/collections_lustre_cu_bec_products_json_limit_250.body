:900,"height":900},{"id":63040078545163,"created_at":"2025-12-05T15:43:55+02:00","position":6,"updated_at":"2025-12-05T15:44:31+02:00","product_id":9757398237451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT0736WH_1.png?v=1764942271","width":1586,"height":1586},{"id":63040078512395,"created_at":"2025-12-05T15:43:55+02:00","position":7,"updated_at":"2025-12-05T15:44:31+02:00","product_id":9757398237451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT0736WH_2.png?v=1764942271","width":800,"height":800},{"id":68775839727883,"created_at":"2026-05-08T17:00:05+03:00","position":8,"updated_at":"2026-05-08T17:00:09+03:00","product_id":9757398237451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8mai2026_16_59_46.png?v=1778248809","width":1254,"height":1254},{"id":69708855673099,"created_at":"2026-07-07T13:20:08+03:00","position":9,"updated_at":"2026-07-07T13:20:10+03:00","product_id":9757398237451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2524123_big_color.png?v=1783419610","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759990677771,"title":"Lustra Ailyn 3x E27 Negru","handle":"lustra-ailyn-3x-e27-negru","body_html":"\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-family: Poppins, sans-serif; font-size: 14.000001px; text-align: justify;\"\u003e\n\u003cspan style=\"font-size:16px\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte\u003c\/span\u003e\u003cspan style=\"color:rgb(50, 51, 56); font-size:16px\"\u003e.\u003c\/span\u003e\n\u003c\/div\u003e\u003cbr\u003e\u003cspan style=\"color:rgb(50, 51, 56); font-family:poppins,sans-serif; font-size:16px\"\u003eAceastă lustră este realizată din materiale de înaltă calitate și vă veți putea bucura de lumina sa un timp îndelungat!\u003c\/span\u003e","published_at":"2025-02-25T01:16:54+02:00","created_at":"2025-02-25T01:16:54+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52427947475211,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8121\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"79.97","grams":0,"compare_at_price":"159.99","position":1,"product_id":9759990677771,"created_at":"2025-09-30T11:26:23+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51841055621387,"created_at":"2025-02-25T01:16:56+02:00","position":1,"updated_at":"2025-02-25T01:16:58+02:00","product_id":9759990677771,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ailyn-3x-e27-metal-negru_8121-3_01.webp?v=1740439018","width":900,"height":900},{"id":51841055654155,"created_at":"2025-02-25T01:16:56+02:00","position":2,"updated_at":"2025-02-25T01:16:59+02:00","product_id":9759990677771,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ailyn-3x-e27-metal-negru_8121-3_02.webp?v=1740439019","width":900,"height":900},{"id":51841055686923,"created_at":"2025-02-25T01:16:57+02:00","position":3,"updated_at":"2025-02-25T01:16:59+02:00","product_id":9759990677771,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ailyn-3x-e27-metal-negru_8121-3_03.webp?v=1740439019","width":900,"height":900},{"id":51841055588619,"created_at":"2025-02-25T01:16:57+02:00","position":4,"updated_at":"2025-02-25T01:16:58+02:00","product_id":9759990677771,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ailyn-3x-e27-metal-negru_8121-3_04.webp?v=1740439018","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759990612235,"title":"Lustra Aerope, 2x E27, Metal, Negru","handle":"lustra-aerope-2x-e27-metal-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:324\"\u003eLustra Aerope nu este doar un corp de iluminat, ci o declaratie de design compacta, creata sa imbine functionalitatea cu o estetica indrazneata, perfecta pentru a infuza personalitate atat in interioare, cat si in zonele exterioare acoperite.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:206\"\u003e\n\u003cstrong\u003eDesign Geometric, Aer Industrial:\u003c\/strong\u003e Doua abajururi metalice tip 'cusca', finisate in negru mat, creeaza o silueta distincta, oferind o interpretare moderna a stilului industrial-chic ce atrage privirea.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:222\"\u003e\n\u003cstrong\u003eLumina Directionata, Ambianta Definita:\u003c\/strong\u003e Echipata cu doua socluri E27, Lustra Aerope emite o lumina focusata, ideala pentru a accentua detalii, a ilumina cai de acces sau a crea o atmosfera vibranta in spatiile alese.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:196\"\u003e\n\u003cstrong\u003ePrezenta Compacta, Impact Maximal:\u003c\/strong\u003e Cu un diametru de 30 cm si o inaltime de 26 cm, se integreaza discret, dar cu personalitate, oferind o solutie de iluminat eficienta fara a incarca vizual.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-9:0\"\u003e\n\u003cstrong\u003eVersatilitate Durabila:\u003c\/strong\u003e Construita din metal rezistent, este conceputa pentru utilizare atat in interior, cat si exterior (acoperit), garantand o prezenta stilistica de lunga durata si o adaptabilitate remarcabila.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:188\"\u003eLustra Aerope nu doar lumineaza functional, ci modeleaza spatiul cu o estetica indrazneata, transformand fiecare zona intr-un loc cu stil, personalitate si o lumina ce vorbeste de la sine.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-02-25T01:16:48+02:00","created_at":"2025-02-25T01:16:48+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","All Stock","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52416074613003,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8121\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"119.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":9759990612235,"created_at":"2025-09-26T18:08:48+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51841054277899,"created_at":"2025-02-25T01:16:50+02:00","position":1,"updated_at":"2025-02-25T01:16:52+02:00","product_id":9759990612235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aerope-2x-e27-metal-negru_8121-2_01.webp?v=1740439012","width":900,"height":900},{"id":51841054212363,"created_at":"2025-02-25T01:16:50+02:00","position":2,"updated_at":"2025-02-25T01:16:51+02:00","product_id":9759990612235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aerope-2x-e27-metal-negru_8121-2_02.webp?v=1740439011","width":900,"height":900},{"id":51841054179595,"created_at":"2025-02-25T01:16:50+02:00","position":3,"updated_at":"2025-02-25T01:16:51+02:00","product_id":9759990612235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aerope-2x-e27-metal-negru_8121-2_03.webp?v=1740439011","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757746004235,"title":"Lustra Roata, 6 x E27, Maro, Metal \/ Sfoara","handle":"lustra-roata-6-x-e27-maro-metal-sfoara","body_html":"\u003cp data-sourcepos=\"3:1-3:284\"\u003eLustra Roata nu este doar o sursa de lumina, ci o piesa centrala robusta, ce imbina farmecul traditional cu o lumina generoasa, transformand orice incapere intr-un spatiu cu personalitate.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-8:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:202\"\u003e\n\u003cstrong\u003eDesign Iconic, Materiale Autentice:\u003c\/strong\u003e O structura circulara din metal maro, ce evoca o roata de caruta, este imbracata in sfoara groasa, oferind o estetica rustica distincta si o textura primitoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:236\"\u003e\n\u003cstrong\u003eIluminare Abundenta, Versatilitate Functionala:\u003c\/strong\u003e Echipata cu sase socluri E27, lustra ofera o distributie generoasa a luminii, fiind compatibila cu becuri LED, economice sau fluorescente, pentru o ambianta adaptabila nevoilor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-8:0\"\u003e\n\u003cstrong\u003ePrezenta Impunatoare, Proportii Grandioase:\u003c\/strong\u003e Cu un diametru de 55 cm si o inaltime de 135 cm, domina estetic spatiul, devenind un punct focal de admiratie in orice incapere.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"9:1-9:137\"\u003eAceasta lustra nu doar lumineaza, ci redefineste spatiul cu un spirit rural-chic, creand o atmosfera de poveste si un stil inconfundabil.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:03:26+02:00","created_at":"2025-02-24T18:03:25+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52360658747659,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8155\/6","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":9757746004235,"created_at":"2025-09-12T17:10:26+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51817615065355,"created_at":"2025-02-24T18:03:27+02:00","position":1,"updated_at":"2025-02-24T18:03:29+02:00","product_id":9757746004235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-roata-6e27-maro-metal-si-sfoara-1710160428.webp?v=1740413009","width":900,"height":900},{"id":51817615032587,"created_at":"2025-02-24T18:03:27+02:00","position":2,"updated_at":"2025-02-24T18:03:29+02:00","product_id":9757746004235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3-1710160428.webp?v=1740413009","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10153225257227,"title":"Lustra LED cu telecomanda si cristal GUIDA 38W, 6 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu","handle":"lustra-led-cu-telecomanda-si-cristal-guida-38w-6-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu","body_html":"\u003cp data-sourcepos=\"3:1-3:74\"\u003e\u003cstrong\u003eEleganță Modernă și Control Inteligent: Lustra LED cu Telecomandă GUIDA \u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:74\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:248\"\u003eDesignul său modern îmbină armonios contrastele dintre finisajul \u003cstrong\u003eauriu\u003c\/strong\u003e și elementele \u003cstrong\u003enegre\u003c\/strong\u003e, creând un aspect sofisticat și atrăgător, perfect pentru interioarele contemporane.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:248\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:237\"\u003eCu o putere de \u003cstrong\u003e38W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și plăcută. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra luminii, putând ajusta intensitatea luminoasă pentru a crea atmosfera perfectă în orice moment.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:237\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:236\"\u003eDeși descrierea nu menționează temperatura culorii, majoritatea lustrelor LED cu telecomandă oferă posibilitatea de a schimba între lumină caldă, rece și neutră. Dacă această funcție este disponibilă, ar adăuga un plus de versatilitate.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-19:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:74\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Combinație contrastantă de auriu și negru.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:54\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 38W pentru o iluminare optimă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:67\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:112\"\u003e\n\u003cstrong\u003ePosibilă Temperatură Culoare Variabilă:\u003c\/strong\u003e Caldă, Rece și Neutră.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:64\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaje elegante.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-19:0\"\u003e\n\u003cstrong\u003eStil Contemporan:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și minimaliste.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"20:1-20:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"22:1-27:0\"\u003e\n\u003cli data-sourcepos=\"22:1-22:73\"\u003e\n\u003cstrong\u003eControl Facil al Luminii:\u003c\/strong\u003e Ajustează intensitatea fără a te deplasa.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:88\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Combinația de culori adaugă un plus de stil și modernitate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:86\"\u003e\n\u003cstrong\u003eUșor de Integrat:\u003c\/strong\u003e Designul modern se potrivește în diverse amenajări interioare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-27:0\"\u003e\n\u003cstrong\u003eCreează Ambianta Dorită:\u003c\/strong\u003e Ajustează lumina pentru diferite activități și momente.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"28:1-28:203\"\u003eLustra LED cu telecomandă GUIDA  este alegerea ideală pentru a adăuga un plus de stil, confort și control inteligent în casa ta. Bucură-te de iluminarea modernă și de flexibilitatea oferită de telecomandă!\u003c\/p\u003e","published_at":"2025-04-29T18:13:26+03:00","created_at":"2025-04-28T02:24:59+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52048592929035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT600\/7BKGD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"319.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10153225257227,"created_at":"2025-08-07T15:11:19+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":57346408677643,"created_at":"2025-07-14T10:08:26+03:00","position":1,"updated_at":"2026-07-23T14:23:39+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_1.png?v=1784805819","width":1800,"height":1800},{"id":57525211824395,"created_at":"2025-07-22T09:27:29+03:00","position":2,"updated_at":"2026-07-23T14:23:49+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_2a1_017c7599-dcbf-47e9-b942-ab81347a259e.png?v=1784805829","width":1500,"height":1500},{"id":62997659484427,"created_at":"2025-12-04T11:47:03+02:00","position":3,"updated_at":"2026-07-23T14:24:00+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_3.png?v=1784805840","width":1586,"height":1586},{"id":62997659255051,"created_at":"2025-12-04T11:47:02+02:00","position":4,"updated_at":"2026-07-23T14:24:22+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_5.png?v=1784805862","width":800,"height":800},{"id":55032719016203,"created_at":"2025-04-28T02:31:01+03:00","position":5,"updated_at":"2026-07-23T14:24:44+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_7.png?v=1784805884","width":1080,"height":1080},{"id":57525211857163,"created_at":"2025-07-22T09:27:29+03:00","position":6,"updated_at":"2026-07-23T14:25:00+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_8.png?v=1784805900","width":1500,"height":1500},{"id":57525211758859,"created_at":"2025-07-22T09:27:29+03:00","position":7,"updated_at":"2026-07-23T14:27:55+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_4.png?v=1784806075","width":1024,"height":1024},{"id":69819855241483,"created_at":"2026-07-23T14:22:50+03:00","position":8,"updated_at":"2026-07-23T14:25:10+03:00","product_id":10153225257227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_9.png?v=1784805910","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757797056779,"title":"Lustra LED cu telecomanda si cristal QUADRIS RGB 177W, 6 Patrate, lumina Rece\/Calda\/Neutra 3000K\/4000K\/6000K, Dimabila, Negru, Metal si Cristal","handle":"lustra-led-cu-telecomanda-si-cristal-quadris-rgb-177w-6-patrate-lumina-rece-calda-neutra-3000k-4000k-6000k-dimabila-negru-metal-si-cristal","body_html":"\u003cdiv style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\" src=\"https:\/\/www.youtube.com\/embed\/ojG5jMBuMy8?list=PLLgyTjEnUblYjgo5KBGj4gHhPg7l_JqnF\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp data-start=\"0\" data-end=\"127\"\u003e \u003c\/p\u003e\n\u003cp data-start=\"0\" data-end=\"127\"\u003e\u003cstrong data-start=\"0\" data-end=\"127\"\u003eLustră LED cu telecomandă și cristal QUADRIS RGB, 177W, 6 pătrate, dimabilă, 3000K \/ 4000K \/ 6000K, negru, metal și cristal\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-start=\"0\" data-end=\"127\"\u003e\u003cstrong data-start=\"0\" data-end=\"127\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/strong\u003eLustra LED QUADRIS RGB este un corp de iluminat modern cu design geometric puternic, compus din 6 pătrate suprapuse, creat pentru interioare contemporane și spații cu impact vizual ridicat. Structura din metal cu finisaj negru este completată de elemente din cristal, care amplifică efectul luminos și adaugă un plus de rafinament.\u003c\/p\u003e\n\u003cp data-start=\"129\" data-end=\"460\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/strong\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cp data-start=\"462\" data-end=\"828\"\u003eIluminarea LED integrată de 177W este dimabilă și permite selectarea temperaturii de culoare caldă, neutră sau rece (3000K \/ 4000K \/ 6000K), precum și funcție RGB pentru efecte decorative și ambientale. Controlul prin telecomandă oferă reglaj complet al intensității, culorii și modurilor de iluminare, pentru adaptarea atmosferei în funcție de moment și preferințe.\u003c\/p\u003e\n\u003cp data-start=\"462\" data-end=\"828\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003cp data-start=\"830\" data-end=\"1106\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eDistribuția luminii este uniformă și eficientă, cu consum redus de energie și confort vizual ridicat. Materialele de calitate și designul modern transformă lustra QUADRIS într-o piesă statement, ideală pentru livinguri spațioase, zone de dining sau interioare moderne premium.\u003c\/p\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T18:23:58+02:00","created_at":"2025-02-24T18:23:57+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":[