.com\/s\/files\/1\/0782\/5175\/3739\/files\/5._3-TONE_CONTROL_e62894c2-02a7-4664-bdd4-b6c2a6236152.png?v=1775582419","width":1000,"height":1000},{"id":68117367095563,"created_at":"2026-04-07T20:18:59+03:00","position":6,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6._NIGHT_LIGHT_b7e218db-ba99-4bd0-abb7-c20eeeabad58.png?v=1775582419","width":1000,"height":1000},{"id":68117367161099,"created_at":"2026-04-07T20:18:59+03:00","position":7,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8._SPECIFICATION_4fb5c41e-48af-4d22-b07e-cddf839b79a4.png?v=1775582419","width":1000,"height":1000},{"id":68117367030027,"created_at":"2026-04-07T20:18:58+03:00","position":8,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7._SIZE_9918a29e-0e5e-4e0c-98d8-61570751e6c5.png?v=1775582419","width":1000,"height":1000},{"id":68117367357707,"created_at":"2026-04-07T20:19:02+03:00","position":9,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._CLOSE_UP_4.png?v=1775582419","width":1000,"height":1000},{"id":68117367423243,"created_at":"2026-04-07T20:19:04+03:00","position":10,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._PLACE_1_adb00dfb-a4ae-4e22-89f9-e426f8d43299.png?v=1775582419","width":1000,"height":1000},{"id":68117367390475,"created_at":"2026-04-07T20:19:03+03:00","position":11,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15._PLACE_4_664cd29a-6b7a-4098-97b8-37e72fa50801.png?v=1775582419","width":1000,"height":1000},{"id":68117367456011,"created_at":"2026-04-07T20:19:05+03:00","position":12,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._PLACE_2_86437119-797b-4720-95cc-801b25494ccc.png?v=1775582419","width":1000,"height":1000},{"id":68117367488779,"created_at":"2026-04-07T20:19:06+03:00","position":13,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._PLACE_3_79904ff3-7336-4681-847a-581c2f44e2fe.png?v=1775582419","width":1000,"height":1000},{"id":64130997911819,"created_at":"2026-01-05T15:16:17+02:00","position":14,"updated_at":"2026-04-07T20:20:19+03:00","product_id":9757936189707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT810BK_EPREL.png?v=1775582419","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759585665291,"title":"Lustra LED cu telecomanda SAKURA 62W, 5 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-sakura-62w-5-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp\u003eDescopera eleganta si functionalitatea perfecta cu \u003cstrong\u003elustra LED\u003c\/strong\u003e SAKURA, o piesa de design moderna ce transforma orice incapere prin forma sa deosebita de floare si iluminatul versatil. Cu un design minimalist in nuante de alb, aceasta \u003cstrong\u003elustra cu telecomanda\u003c\/strong\u003e cu 5 brate aduce un plus de rafinament si lumina in orice spatiu interior.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e\u003ch2\u003eDesign si Versatilitate\u003c\/h2\u003e\u003cp\u003eCu dimensiuni generoase de 74 cm diametru si doar 8.5 cm inaltime, \u003cstrong\u003elustra led\u003c\/strong\u003e SAKURA se remarca prin designul sau modern in forma de floare, perfect pentru a deveni punctul focal al incaperii. Constructia cu brate din metal si finisajul alb ofera un aspect contemporan ce se integreaza perfect in orice stil de amenajare.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/www.alessandrodesign.ro\/upload\/userfiles\/images\/documentations\/banners\/banner_telecomanda_lustra_led.webp\"\u003e\u003c\/p\u003e\u003ch2\u003eIluminat Personalizabil\u003c\/h2\u003e\u003cp\u003eBeneficiind de tehnologie LED avansata, \u003cstrong\u003elustra pe led\u003c\/strong\u003e ofera:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003ePutere de 62W cu flux luminos de 4960 lumeni\u003c\/li\u003e\n\u003cli\u003eTrei tipuri de lumina: calda (3000K), neutra (4000K) si rece (6000K)\u003c\/li\u003e\n\u003cli\u003eFunctie de dimare pentru controlul intensitatii luminoase\u003c\/li\u003e\n\u003cli\u003eControl dual prin intrerupator clasic si telecomanda\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003ePerformanta si Durabilitate\u003c\/h2\u003e\u003cp\u003eConstruita pentru a rezista, \u003cstrong\u003elustra led pentru living\u003c\/strong\u003e SAKURA ofera:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003eAutonomie extinsa de 25.000 ore de functionare\u003c\/li\u003e\n\u003cli\u003eClasa de protectie IP20 pentru utilizare in interior\u003c\/li\u003e\n\u003cli\u003eTehnologie LED eficienta energetic\u003c\/li\u003e\n\u003cli\u003eSistem de iluminat integrat cu banda LED\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003e\n\u003cimg src=\"https:\/\/www.alessandrodesign.ro\/upload\/userfiles\/images\/documentations\/banners\/banner_mod_noapte_lustra_led.webp\"\u003e\u003cbr\u003eAplicatii Recomandate\u003c\/h2\u003e\u003cp\u003eDatorita versatilitatii sale, lustra SAKURA este ideala pentru:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003eLiving - pentru o atmosfera moderna si primitoare\u003c\/li\u003e\n\u003cli\u003eDormitor - oferind optiuni variate de iluminat pentru orice moment al zilei\u003c\/li\u003e\n\u003cli\u003eBucatarie sau zona de dining - asigurand iluminat optim pentru activitatile zilnice\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003ePerfect adaptata pentru spatiile moderne, lustra LED SAKURA combina designul inovator cu functionalitatea superioara, oferind o solutie de iluminat completa pentru casa ta.\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e notionvc: 811f4359-542d-4aee-b087-6f1ce6d0dbdf","published_at":"2025-02-25T00:08:07+02:00","created_at":"2025-02-25T00:08:07+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428665651467,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT620\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"169.99","grams":0,"compare_at_price":"169.99","position":1,"product_id":9759585665291,"created_at":"2025-09-30T14:55:42+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":63138873508107,"created_at":"2025-12-08T15:48:45+02:00","position":1,"updated_at":"2026-06-17T11:23:40+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/617osZMXhqL._AC_SL1000.jpg?v=1781684620","width":1024,"height":1024},{"id":63138873671947,"created_at":"2025-12-08T15:48:45+02:00","position":2,"updated_at":"2026-06-17T11:26:53+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.s