/span\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e","published_at":"2025-02-24T12:39:04+02:00","created_at":"2025-02-24T12:39:03+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","Corpuri de Iluminat","Lustre Clasice","Lustre cu bec"],"variants":[{"id":52038298632459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-891\/1TV","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"73.60","grams":0,"compare_at_price":"73.60","position":1,"product_id":9756872114443,"created_at":"2025-08-05T15:21:06+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51810784575755,"created_at":"2025-02-24T12:39:05+02:00","position":1,"updated_at":"2025-02-24T12:39:07+02:00","product_id":9756872114443,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-mina-1xe27-maro-alb-lemn-sticla_LC1650_01.webp?v=1740393547","width":900,"height":900},{"id":51810784608523,"created_at":"2025-02-24T12:39:05+02:00","position":2,"updated_at":"2025-02-24T12:39:07+02:00","product_id":9756872114443,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-mina-1xe27-maro-alb-lemn-sticla_LC1650_02.webp?v=1740393547","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759376441611,"title":"Lustra LED cu telecomanda si cristal MEILI ZAFINA RGB 238W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-zafina-rgb-238w-6-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:297\"\u003eLustra LED cu telecomandă și cristale ZAFINA RGB este o piesă de iluminat impresionantă și spectaculoasă, cu un design format din șase cercuri concentrice, finisate în alb și împodobite cu cristale strălucitoare. Cu o putere mare de 238W, oferă o iluminare amplă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003eCele șase cercuri albe, decorate cu cristale, creează un aspect luminos și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:326\"\u003eFinisajul alb al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 238W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte încăperi ample unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:39:52+02:00","created_at":"2025-02-24T23:39:52+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52120216174859,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19373\/4+2WH+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9759376441611,"created_at":"2025-08-25T12:21:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832350408971,"created_at":"2025-02-24T23:39:53+02:00","position":1,"updated_at":"2025-02-24T23:39:55+02:00","product_id":9759376441611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-shayma-telecomanda-238w-alb-rgb_1743_01.webp?v=1740433195","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10152477557003,"title":"Lustra cu Abajur Rotund, PENTHOUSE Dome, 6x G9, Auriu, Metal","handle":"lustra-cu-abajur-rotund-penthouse-dome-6x-g9-auriu-metal","body_html":"\u003c!-- codex-banner:AT1CT-IM1P-HT2L-LC825GD --\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_2000x900_LC825GD_cdc9291b-625c-4c78-9124-627204635d2e.jpg?v=1785521362\" alt=\"Lustra cu Abajur Rotund, PENTHOUSE Dome, 6x G9, Auriu, Metal banner\" width=\"2000\" height=\"900\"\u003e\u003c\/p\u003e\u003c!-- \/codex-banner:AT1CT-IM1P-HT2L-LC825GD --\u003e\u003cp data-sourcepos=\"3:1-3:64\"\u003e\u003cstrong\u003eEleganță Simplă și Accente Aurii Strălucitoare: Lustra PENTHOUSE Dome\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:216\"\u003eAdu un strop de eleganță clasică cu o notă modernă în casa ta cu Lustra PENTHOUSE Dome. Designul său atemporal, realizat din \u003cstrong\u003emetal \u003c\/strong\u003ecu un finisaj \u003cstrong\u003eauriu\u003c\/strong\u003e strălucitor, adaugă o notă de rafinament subtil oricărui interior.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:279\"\u003eCu \u003cstrong\u003e6 socluri G9 \u003c\/strong\u003e, lustra PENTHOUSE Dome oferă o iluminare amplă și uniformă, ideală pentru livinguri, dininguri sau dormitoare elegante. Forma sa simplă și brațele delicate permit luminii să se răspândească armonios în întreaga încăpere, creând o atmosferă primitoare și confortabilă.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:162\"\u003eFinisajul auriu adaugă o notă de căldură și lux, integrându-se cu ușurință în diverse stiluri de decor, de la clasic și tradițional la modern cu accente elegante.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-18:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:66\"\u003e\n\u003cstrong\u003eDesign Elegant și Atemporal:\u003c\/strong\u003e Formă simplă cu brațe delicate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:65\"\u003e\n\u003cstrong\u003eFinisaj Auriu Strălucitor:\u003c\/strong\u003e Adaugă o notă de lux și căldură.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:60\"\u003e\n\u003cstrong\u003eIluminare Amplă:\u003c\/strong\u003e 6 socluri G9 pentru o lumină bogată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:73\"\u003e\n\u003cstrong\u003eMaterial Durabil:\u003c\/strong\u003e Metal de calitate pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-18:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare clasice, moderne elegante sau eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"19:1-19:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"21:1-26:0\"\u003e\n\u003cli data-sourcepos=\"21:1-21:118\"\u003e\n\u003cstrong\u003eCreează o Atmosferă Elegantă și Primitoare:\u003c\/strong\u003e Designul său simplu și finisajul auriu adaugă un plus de rafinament.\u003c\/li\u003e\n\u003cli data-sourcepos=\"22:1-22:70\"\u003e\n\u003cstrong\u003eOferă o Iluminare Generoasă:\u003c\/strong\u003e Ideală pentru spații medii și mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:83\"\u003e\n\u003cstrong\u003eAdaugă o Notă de Lux Subtil:\u003c\/strong\u003e Finisajul auriu completează cu eleganță decorul.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:79\"\u003e\n\u003cstrong\u003eCompletează Diverse Stiluri de Interior:\u003c\/strong\u003e Un element de iluminat versatil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-26:0\"\u003e\n\u003cstrong\u003eDurabilitate și Longevitate:\u003c\/strong\u003e Materialele de calitate asigură o utilizare îndelungată.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"27:1-27:184\"\u003eLustra PENTHOUSE Dome este alegerea perfectă pentru a adăuga un element de iluminat elegant, o lumină plăcută și o notă de lux subtil în casa ta. Bucură-te de o atmosferă primitoare și stilată!\u003c\/p\u003e","published_at":"2025-04-29T16:56:01+03:00","created_at":"2025-04-27T11:23:00+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","All Stock","Corpuri de Iluminat","Lustre cu bec","Lustre cu bec moderne"],"variants":[{"id":52424304984331,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC825GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"349.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10152477557003,"created_at":"2025-09-29T14:46:38+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69858029895947,"created_at":"2026-07-31T20:27:24+03:00","position":1,"updated_at":"2026-07-31T20:27:28+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LC825GD.webp?v=1785518848","width":1254,"height":1254},{"id":69858029928715,"created_at":"2026-07-31T20:27:24+03:00","position":2,"updated_at":"2026-07-31T20:27:28+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LC825GD.webp?