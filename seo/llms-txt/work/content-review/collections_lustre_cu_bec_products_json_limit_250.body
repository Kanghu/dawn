:229\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-07-14T14:30:20+03:00","created_at":"2026-07-07T10:00:04+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","All Stock"],"variants":[{"id":53225212313867,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC6006\/6BK","requires_shipping":true,"taxable":false,"featured_image":null,"available":true,"price":"319.99","grams":0,"compare_at_price":null,"position":1,"product_id":10997626077451,"created_at":"2026-07-07T10:00:05+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69708015960331,"created_at":"2026-07-07T10:30:32+03:00","position":1,"updated_at":"2026-07-07T10:36:49+03:00","product_id":10997626077451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_NUUK_90x57cm_6xE27_metal_si_plastic_Negru_1.png?v=1783409809","width":1254,"height":1254},{"id":69708021793035,"created_at":"2026-07-07T10:32:39+03:00","position":2,"updated_at":"2026-07-07T10:36:57+03:00","product_id":10997626077451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_NUUK_90x57cm_6xE27_metal_si_plastic_Negru_2.png?v=1783409817","width":1254,"height":1254},{"id":69708032737547,"created_at":"2026-07-07T10:36:20+03:00","position":3,"updated_at":"2026-07-07T10:37:06+03:00","product_id":10997626077451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_NUUK_90x57cm_6xE27_metal_si_plastic_Negru_3.png?v=1783409826","width":1254,"height":1254},{"id":69708029886731,"created_at":"2026-07-07T10:35:33+03:00","position":4,"updated_at":"2026-07-07T10:37:15+03:00","product_id":10997626077451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_NUUK_90x57cm_6xE27_metal_si_plastic_Negru_4.png?v=1783409835","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10997621424395,"title":"Lustra LED cu telecomanda COSMEE 84W, 3 Petale, Lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-cosmee-84w-3-petale-lumina-rece-calda-neutra-dimabila-alb-metal-si-acril","body_html":"\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\n\u003cp\u003eDescopera eleganta moderna a lustrei LED COSMEE, un corp de iluminat care imbina perfect designul contemporan cu functionalitatea avansata. Cu forma sa inspirata din linii naturale, aceasta lustra va deveni punctul de atractie al dormitorului sau zonei tale de dining.\u003c\/p\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\n\u003ch2\u003eDesign Modern si Spatios\u003c\/h2\u003e\n\u003cp\u003eCele trei cercuri cu linii fluide se unesc armonios intr-o compozitie moderna de 85x61cm. Profilul subtire de 7 cm si finisajul alb elegant se integreaza perfect in orice interior contemporan, oferind o prezenta distinctiva pe tavan.\u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eControl Intuitiv al Luminii\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003eCu ajutorul telecomenzii, poti adapta usor atmosfera incaperii tale. Alege intre lumina calda (3000K) pentru momente relaxante, lumina neutra (4000K) pentru activitati zilnice, sau lumina rece (6000K) pentru claritate maxima. Functia de dimming iti permite sa ajustezi intensitatea luminii dupa preferinte.\u003c\/p\u003e\n\u003cp\u003e Beneficii principale:\u003c\/p\u003e\n\u003cp\u003e• Iluminare puternica si uniforma cu 6720 lumeni \u003c\/p\u003e\n\u003cp\u003e• Control convenabil prin telecomanda si intrerupator\u003c\/p\u003e\n\u003cp\u003e• Durata de viata extinsa de 25.000 ore\u003c\/p\u003e\n\u003cp\u003e• Consum eficient de energie de 84W\u003c\/p\u003e\n\u003cp\u003e• Instalare simpla pe tavan\u003c\/p\u003e\n\u003cp\u003eCOSMEE este alegerea perfecta pentru cei care apreciaza designul modern si doresc flexibilitate in controlul iluminatului. Ideala pentru crearea ambiantei potrivite in timpul cinelor in familie sau pentru momentele de relaxare in dormitor.\u003c\/p\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\n\u003cp\u003e\u003c!-- notionvc: 76e17c57-2ac0-44b4-85eb-ab34e14e05d3 --\u003e\u003c\/p\u003e","published_at":"2026-07-07T09:54:41+03:00","created_at":"2026-07-07T09:25:43+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":53225186492683,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT5006\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"919.99","grams":0,"compare_at_price":"149.99","position":1,"product_id":10997621424395,"created_at":"2026-07-07T09:25:44+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69707887575307,"created_at":"2026-07-07T09:41:57+03:00","position":1,"updated_at":"2026-07-07T09:43:06+03:00","product_id":10997621424395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_2_d39e0e15-18c2-4d83-9003-53d9da813079.jpg?v=1783406586","width":1024,"height":1024},{"id":69707891605771,"created_at":"2026-07-07T09:43:14+03:00","position":2,"updated_at":"2026-07-07T09:44:36+03:00","product_id":10997621424395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_2_ad0e8a8e-6837-41f7-8418-9f644117caf2.jpg?v=1783406676","width":1024,"height":1024},{"id":69707891671307,"created_at":"2026-07-07T09:43:15+03:00","position":3,"updated_at":"2026-07-07T09:46:29+03:00","product_id":10997621424395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_2_d0a7c07a-d2b2-47b4-91b9-5d734ce370eb.jpg?v=1783406789","width":1024,"height":1024},{"id":69707891704075,"created_at":"2026-07-07T09:43:17+03:00","position":4,"updated_at":"2026-07-07T09:43:19+03:00","product_id":10997621424395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_2_c6f788fc-3742-4107-8853-8b33042e2765.jpg?v=1783406599","width":800,"height":800},{"id":69707913298187,"created_at":"2026-07-07T09:51:32+03:00","position":5,"updated_at":"2026-07-07T09:51:34+03:00","product_id":10997621424395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WhatsAppImage2026-07-07at09.50.23.jpg?v=1783407094","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10997365047563,"title":"Lustra cristal ORI, 46cm, 3xG9, Globuri, Negru","handle":"lustra-led-si-cristal-ori-46cm-3xg9-globuri-negru","body_html":"\u003cp class=\"p1\"\u003eTransformă orice încăpere într-un spațiu elegant și rafinat cu lustra ORI, un corp de iluminat modern ce îmbină armonios \u003cspan class=\"s1\"\u003efinisajul negru premium\u003c\/span\u003e cu globurile opaline și designul curbat minimalist. Ideală pentru living, dining, dormitor sau hol, această lustră oferă un accent decorativ sofisticat și o lumină plăcută, perfectă pentru interioare contemporane.\u003c\/p\u003e\n\u003cp class=\"p1\"\u003eDesignul său fluid, inspirat de orbitele cosmice, creează un efect vizual elegant și aerisit, în timp ce combinația dintre \u003cspan class=\"s1\"\u003emetalul negru\u003c\/span\u003e și globurile albe adaugă un plus de eleganță și căldură ambientului.\u003c\/p\u003e\n\u003ch2\u003e\u003cspan class=\"s1\"\u003e\u003cb\u003eCaracteristici principale\u003c\/b\u003e\u003c\/span\u003e\u003c\/h2\u003e\n\u003cul\u003e\n\u003cli\u003eDesign modern și elegant cu \u003cspan class=\"s1\"\u003efinisaj negru\u003c\/span\u003e\n\u003c\/li\u003e\n\u003cli\u003e3 globuri opaline pentru iluminare uniformă\u003c\/li\u003e\n\u003cli\u003eCompatibilă cu becuri G9\u003c\/li\u003e\n\u003cli\u003ePotrivită pentru living, dormitor, dining sau birou\u003c\/li\u003e\n\u003cli\u003eConstrucție premium din metal și sticlă\u003c\/li\u003e\n\u003cli\u003eMontaj pe tavan\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003ch2\u003e\u003cspan class=\"s1\"\u003e\u003cb\u003eSpecificații tehnice\u003c\/b\u003e\u003c\/span\u003e\u003c\/h2\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eModel:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e ORI, 46cm, 3xG9\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eTip produs:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e Lustra decorativă\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eLungime:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e 46 cm\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eSoclu:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e 3 × G9\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eMaterial:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e Metal + sticlă\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eCuloare:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e \u003c\/span\u003e\u003cspan class=\"s1\"\u003eNegru\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eTip globuri:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e Opal \/ alb mat\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p3\"\u003e\u003cb\u003eAlimentare:\u003c\/b\u003e\u003cspan class=\"s2\"\u003e 220–230V\u003c\/span\u003e\u003c\/p\u003e\n\u003cp class=\"p1\"\u003e\u003cb\u003eStil:\u003c\/b\u003e Modern \/ Luxury \/ Minimalist\u003c\/p\u003e\n\u003cp class=\"p4\"\u003eLustra \u003cspan class=\"s1\"\u003eORI\u003c\/span\u003e este alegerea perfectă pentru cei care doresc un corp de iluminat statement, cu design modern și accente elegante.\u003c\/p\u003e\n\u003cp data-sourcepos=\"1:1-1:229\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2026-07-07T15:21:22+03:00","created_at":"2026-07-06T17:34:49+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat"],"variants":[{"id":53224652046603,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC6005\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"219.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":10997365047563,"created_at":"2026-07-06T17:34:50+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69704787394827,"created_at":"2026-07-06T17:48:58+03:00","position":1,"updated_at":"2026-07-06T17:52:46+03:00","product_id":10997365047563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_si_cristal_ORI_46cm_3xG9_Globuri_Negru_1.png?v=1783349566","width":1024,"height":1024},{"id":69704787820811,"created_at":"2026-07-06T17:49:00+03:00","position":2,"updated_at":"2026-07-06T17:52:58+03:00","product_id":10997365047563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_si_cristal_ORI_46cm_3xG9_Globuri_Negru_2.png?v=1783349578","width":1024,"height":1024},{"id":69704787919115,"created_at":"2026-07-06T17:49:01+03:00","position":3,"updated_at":"2026-07-06T17:53:08+03:00","product_id":10997365047563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_si_cristal_ORI_46cm_3xG9_Globuri_Negru_3.png?v=1783349588","width":1024,"height":1024},{"id":69704783266059,"created_at":"2026-07-06T17:47:29+03:00","position":4,"updated_at":"2026-07-06T17:53:26+03:00","product_id":10997365047563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_si_cristal_ORI_46cm_3xG9_Globuri_Negru_4.png?v=1783349606","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10997132755211,"title":"Lustra Clasica Sisimiut, 4xGU10, Metal, Negru","handle":"lustra-clasica-sisimiut-4xgu10-metal-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp class=\"p1\"\u003eLustra \u003cspan class=\"s1\"\u003e\u003cb\u003eSISIMIUT\u003c\/b\u003e\u003c\/span\u003e îmbină eleganța discretă a stilului clasic cu un design modern și funcțional. Realizată din metal cu finisaj negru mat, aceasta adaugă un accent rafinat oricărui interior, integrându-se cu ușurință în amenajări contemporane, industriale sau minimaliste.\u003c\/p\u003e\n\u003cp class=\"p1\"\u003eCu dimensiunile de 80 cm lungime, 12 cm lățime și 20 cm înălțime, lustra are un format generos, fiind potrivită pentru încăperi spațioase. Se integrează excelent în livinguri, dininguri sau spații comerciale, unde poate oferi o iluminare eficientă și uniformă, devenind totodată un element decorativ cu impact vizual.\u003c\/p\u003e\n\u003cp class=\"p1\"\u003eEchipată cu \u003cstrong\u003e4\u003c\/strong\u003e\u003cspan class=\"s1\"\u003e\u003cb\u003e socluri standard GU10\u003c\/b\u003e\u003c\/span\u003e, oferă flexibilitate în alegerea surselor de lumină. Puteți utiliza becuri LED cu lumină caldă pentru o atmosferă primitoare sau becuri cu lumină neutră ori rece pentru un iluminat clar și funcțional. \u003cspan class=\"s1\"\u003e\u003cb\u003eBecurile nu sunt incluse\u003c\/b\u003e\u003c\/span\u003e, permițându-vă să alegeți intensitatea și temperatura de culoare potrivite preferințelor dumneavoastră.\u003c\/p\u003e\n\u003cp class=\"p1\"\u003eStructura metalică robustă asigură durabilitate și stabilitate în utilizare, iar finisajul negru mat conferă un aspect elegant, ușor de integrat în diferite stiluri de amenajare. \u003cspan class=\"s1\"\u003e\u003cb\u003eSISIMIUT\u003c\/b\u003e\u003c\/span\u003e este alegerea ideală pentru cei care caută un corp de iluminat compact, rezistent și versatil, capabil să ofere atât funcționalitate, cât și un plus de stil locuinței.\u003c\/p\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_1_png.png?v=1769162635\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"10:1-10:139\"\u003e\u003cbr\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"10:1-10:139\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_final_f7ebc4f3-922f-45a1-9ce3-c338b6574a31.png?v=1769164054\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2026-07-07T15:21:01+03:00","created_at":"2026-07-06T15:52:22+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","All Stock","Corpuri de Iluminat","Lustre Clasice","Lustre cu bec","Lustre din fier"],"variants":[{"id":53224162623755,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC6003\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"289.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":10997132755211,"created_at":"2026-07-06T15:52:23+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69704179843339,"created_at":"2026-07-06T16:02:53+03:00","position":1,"updated_at":"2026-07-06T16:53:21+03:00","product_id":10997132755211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_Sisimiut_4xGU10_Metal_Negru_1.png?v=1783346001","width":1024,"height":1024},{"id":69704185676043,"created_at":"2026-07-06T16:03:55+03:00","position":2,"updated_at":"2026-07-06T16:53:31+03:00","product_id":10997132755211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_Sisimiut_4xGU10_Metal_Negru_2.png?v=1783346011","width":1024,"height":1024},{"id":69704224243979,"created_at":"2026-07-06T16:10:19+03:00","position":3,"updated_at":"2026-07-06T16:53:41+03:00","product_id":10997132755211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_Sisimiut_4xGU10_Metal_Negru_3.png?v=1783346021","width":1024,"height":1024},{"id":69704469709067,"created_at":"2026-07-06T16:51:53+03:00","position":4,"updated_at":"2026-07-06T16:53:50+03:00","product_id":10997132755211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Clasica_Sisimiut_4xGU10_Metal_Negru_4.png?v=1783346030","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10997025636619,"title":"Lustra Clasica Sisimiut, 3xGU10, Metal, Negru","handle":"lustra-clasica-sisimiut-3xgu10-metal-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp class=\"p1\"\u003eLustra \u003cspan class=\"s1\"\u003e\u003cb\u003eSISIMIUT\u003c\/b\u003e\u003c\/span\u003e îmbină eleganța discretă a stilului clasic cu un design modern și funcțional. Realizată din metal cu finisaj negru mat, aceasta adaugă un accent rafinat oricărui interior, integrându-se cu ușurință în amenajări contemporane, industriale sau minimaliste.\u003c\/p\u003e\n\u003cp class=\"p1\"\u003eCu dimensiu