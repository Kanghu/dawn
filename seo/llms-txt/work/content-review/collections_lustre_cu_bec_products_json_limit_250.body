_at":"2025-12-08T15:48:45+02:00","position":9,"updated_at":"2025-12-08T16:03:31+02:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71E4qeYhOSL._AC_SL1208.jpg?v=1765202611","width":1207,"height":1208},{"id":63138873573643,"created_at":"2025-12-08T15:48:45+02:00","position":10,"updated_at":"2025-12-08T16:03:31+02:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71JAAIr5MYL._AC_SL1208.jpg?v=1765202611","width":1207,"height":1208},{"id":63138873770251,"created_at":"2025-12-08T15:48:45+02:00","position":11,"updated_at":"2025-12-08T16:03:31+02:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71oAJfn3ibL._AC_SL1208.jpg?v=1765202611","width":1207,"height":1208},{"id":63138873540875,"created_at":"2025-12-08T15:48:45+02:00","position":12,"updated_at":"2026-06-17T11:24:38+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/51bLfN1UegL._AC_SL1208.jpg?v=1781684678","width":1024,"height":1024},{"id":69543152091403,"created_at":"2026-06-17T11:55:31+03:00","position":13,"updated_at":"2026-06-17T11:55:36+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage17iun.2026_11_55_19.png?v=1781686536","width":1254,"height":1254},{"id":69543152615691,"created_at":"2026-06-17T11:55:47+03:00","position":14,"updated_at":"2026-06-17T11:55:51+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage17iun.2026_11_55_39.png?v=1781686551","width":1254,"height":1254},{"id":69707808702731,"created_at":"2026-07-07T09:13:34+03:00","position":15,"updated_at":"2026-07-07T09:13:36+03:00","product_id":9759585665291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/fi