e de temperatură a luminii: \u003cstrong data-start=\"331\" data-end=\"378\"\u003e3000K (caldă), 4000K (neutră), 6000K (rece)\u003c\/strong\u003e. \u003cstrong data-start=\"380\" data-end=\"403\"\u003eÎnălțimea reglabilă\u003c\/strong\u003e permite adaptarea ușoară la orice tip de spațiu.\u003c\/p\u003e\u003cp data-start=\"456\" data-end=\"692\"\u003e✔ \u003cstrong data-start=\"458\" data-end=\"469\"\u003ePutere:\u003c\/strong\u003e 23W LED integrat\u003cbr data-start=\"486\" data-end=\"489\"\u003e✔ \u003cstrong data-start=\"491\" data-end=\"515\"\u003eTemperatură culoare:\u003c\/strong\u003e 3000K \/ 4000K \/ 6000K\u003cbr data-start=\"537\" data-end=\"540\"\u003e✔ \u003cstrong data-start=\"542\" data-end=\"555\"\u003eMaterial:\u003c\/strong\u003e Metal + Acril\u003cbr data-start=\"569\" data-end=\"572\"\u003e✔ \u003cstrong data-start=\"574\" data-end=\"586\"\u003eFinisaj:\u003c\/strong\u003e Auriu elegant\u003cbr data-start=\"600\" data-end=\"603\"\u003e✔ \u003cstrong data-start=\"605\" data-end=\"618\"\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003cbr data-start=\"628\" data-end=\"631\"\u003e✔ \u003cstrong data-start=\"633\" data-end=\"647\"\u003eUtilizare:\u003c\/strong\u003e Living, dining, dormitor, bucătărie, birou\u003c\/p\u003e\u003cp data-start=\"694\" data-end=\"840\"\u003eAceastă lustra suspendată îmbină \u003cstrong data-start=\"727\" data-end=\"751\"\u003eeficiența energetică\u003c\/strong\u003e cu \u003cstrong data-start=\"755\" data-end=\"776\"\u003eun design rafinat\u003c\/strong\u003e, fiind alegerea ideală pentru interioare elegante și moderne.\u003c\/p\u003e","published_at":"2025-11-11T15:43:16+02:00","created_at":"2025-09-16T13:02:17+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre LED Suspendate"],"variants":[{"id":52429951926539,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LM551\/4GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10724806885643,"created_at":"2025-09-30T17:58:53+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60365090980107,"created_at":"2025-09-16T13:02:53+03:00","position":1,"updated_at":"2025-09-16T13:02:56+03:00","product_id":10724806885643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_85b35ad2-5b78-49fe-ae86-3663d3b3dab0.png?v=1758016976","width":800,"height":800},{"id":60365094387979,"created_at":"2025-09-16T13:03:20+03:00","position":2,"updated_at":"2025-09-16T13:03:24+03:00","product_id":10724806885643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_c70dcc4c-513f-47fb-8d89-f257e414f797.png?v=1758017004","width":2000,"height":2000},{"id":60365095436555,"created_at":"2025-09-16T13:03:31+03:00","position":3,"updated_at":"2025-09-16T13:04:06+03:00","product_id":10724806885643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_9f35ef06-14f0-408d-a065-3d3e805912da.png?v=1758017046","width":1910,"height":1910},{"id":62878215635211,"created_at":"2025-11-30T12:17:06+02:00","position":4,"updated_at":"2025-11-30T12:17:09+02:00","product_id":10724806885643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LM551_4GD_PREL.png?v=1764497829","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10724052566283,"title":"Lustra Franghie, 3xE27, Maro, Metal si Sfoara LV570\/3BK","handle":"lustra-franghie-3-e27-maro-metal-si-sfoara-lv570-3bk","body_html":"\u003cdiv\u003e\u003cspan style=\"font-size:16px\"\u003eLustra reprezintă un element de iluminare practic ce completează atmosfera elegantă a încăperii unde îți dorești să creezi o atmosferă caldă și primitoare. \u003cbr\u003e \u003cbr\u003eRealizate din materiale de înaltă calitate acestea au o durată lungă de viață și vă veți putea bucura mult timp de frumusețea și lumina lustrei alese!\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-10-21T21:44:08+03:00","created_at":"2025-09-15T15:11:35+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52397508493579,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LV570\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":10724052566283,"created_at":"2025-09-20T21:41:58+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813459689739,"created_at":"2025-02-24T14:36:39+02:00","position":1,"updated_at":"2025-11-06T20:30:34+02:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_02.webp?v=1762453834","width":900,"height":900},{"id":51813459853579,"created_at":"2025-02-24T14:36:40+02:00","position":2,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_05.webp?v=1757938336","width":900,"height":900},{"id":51813459788043,"created_at":"2025-02-24T14:36:40+02:00","position":3,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_06.webp?v=1757938336","width":900,"height":900},{"id":51813459886347,"created_at":"2025-02-24T14:36:39+02:00","position":4,"updated_at":"2025-11-06T20:30:34+02:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_01.webp?v=1762453834","width":900,"height":900},{"id":51813459820811,"created_at":"2025-02-24T14:36:39+02:00","position":5,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_03.webp?v=1757938336","width":900,"height":900},{"id":51813459755275,"created_at":"2025-02-24T14:36:39+02:00","position":6,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10724052566283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_04.webp?v=1757938336","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10515877167371,"title":"Lustra LED PORTAVION pentru copii, 128W, lumina Rece\/Calda\/Neutra, Gri Aeronautic","handle":"lustra-led-fighter-128w-lumina-rece-calda-neutra-gri","body_html":"\u003cp\u003eLustra LED FIGHTER este un corp de iluminat cu un design modern si tematica de avion, perfecta pentru camera copiilor.\u003c\/p\u003e\u003cp\u003eFunctioneaza la o tensiune de \u003cstrong data-start=\"149\" data-end=\"161\"\u003e220–230V\u003c\/strong\u003e, are o \u003cstrong data-start=\"169\" data-end=\"194\"\u003eputere totala de 128W\u003c\/strong\u003e si se monteaza \u003cstrong data-start=\"210\" data-end=\"222\"\u003epe tavan\u003c\/strong\u003e, fiind prevazuta cu \u003cstrong data-start=\"243\" data-end=\"256\"\u003ebanda LED\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003eStructura este realizata din \u003cstrong data-start=\"287\" data-end=\"305\"\u003eacril si metal\u003c\/strong\u003e, finisaj \u003cstrong data-start=\"315\" data-end=\"327\"\u003eargintiu\u003c\/strong\u003e, cu o \u003cstrong data-start=\"334\" data-end=\"355\"\u003einaltime de 22 cm\u003c\/strong\u003e, \u003cstrong data-start=\"357\" data-end=\"377\"\u003elungime de 75 cm\u003c\/strong\u003e si \u003cstrong data-start=\"381\" data-end=\"400\"\u003elatime de 37 cm\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003eOfera un \u003cstrong data-start=\"411\" data-end=\"440\"\u003eflux luminos de 10.240 lm\u003c\/strong\u003e si poate emite \u003cstrong data-start=\"456\" data-end=\"489\"\u003elumina rece, calda sau neutra\u003c\/strong\u003e, compatibila cu \u003cstrong data-start=\"506\" data-end=\"529\"\u003eintrerupator clasic\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003eEste recomandata pentru \u003cstrong data-start=\"555\" data-end=\"587\"\u003ecamera copiilor sau dormitor\u003c\/strong\u003e, avand o \u003cstrong data-start=\"597\" data-end=\"621\"\u003eautonomie de 25.000h\u003c\/strong\u003e, \u003cstrong data-start=\"623\" data-end=\"641\"\u003eprotectie IP20\u003c\/strong\u003e si este destinata \u003cstrong data-start=\"660\" data-end=\"686\"\u003eutilizarii la interior\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-24T10:13:56+03:00","created_at":"2025-06-24T10:10:14+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Copii","tags":["active","BLACKSEASON","Corpuri de Iluminat","Lustre Copii","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52104742764811,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CP6631","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"899.99","position":1,"product_id":10515877167371,"created_at":"2025-08-21T11:37:37+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":56711862714635,"created_at":"2025-06-24T10:12:19+03:00","position":1,"updated_at":"2025-08-21T11:34:23+03:00","product_id":10515877167371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6631-LustraLEDFIGHTER_128W_luminaReceCaldaNeutra_Argintiu-3.jpg?v=1755765263","width":1080,"height":1080},{"id":56711862780171,"created_at":"2025-06-24T10:12:19+03:00","position":2,"updated_at":"2025-08-21T11:34:23+03:00","product_id":10515877167371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6631-LustraLEDFIGHTER_128W_luminaReceCaldaNeutra_Argintiu-2.jpg?v=1755765263","width":1080,"height":1080},{"id":56711862518027,"created_at":"2025-06-24T10:12:18+03:00","position":3,"updated_at":"2025-06-24T10:12:28+03:00","product_id":10515877167371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6631-LustraLEDFIGHTER_128W_luminaReceCaldaNeutra_Argintiu-1.jpg?v=1750749148","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759478284555,"title":"Sina Incastrata pentru Proiectoare Magnetice, 2m, Negru","handle":"sina-incastrata-pentru-proiectoare-magnetice-2m-negru","body_html":"\u003cspan style=\"font-size:16px\"\u003e\u003cstrong\u003eSina\u003c\/strong\u003e\u003cstrong\u003e nu contine alimentator! Acesta se achizitioneaza separat!\u003c\/strong\u003e\u003c\/span\u003e","published_at":"2025-02-24T23:53:19+02:00","created_at":"2025-02-24T23:53:18+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Produse LED","tags":["active","All Stock","Corpuri de Iluminat","Produse LED","Proiectoare sina magnetica"],"variants":[{"id":52408682807563,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-MGN\/2M\/INC","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9759478284555,"created_at":"2025-09-24T14:52:46+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51833244057867,"created_at":"2025-02-24T23:53:21+02:00","position":1,"updated_at":"2025-02-24T23:53:23+02:00","product_id":9759478284555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/sina-incastrata-pentru-proiectoare-magnetice-2m-negru__01.webp?v=1740434003","width":900,"height":900},{"id":51833243566347,"created_at":"2025-02-24T23:53:21+02:00","position":2,"updated_at":"2025-02-24T23:53:22+02:00","product_id":9759478284555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/sina-incastrata-pentru-proiectoare-magnetice-2m-negru__02.webp?v=1740434002","width":900,"height":900},{"id":51833243959563,"created_at":"2025-02-24T23:53:21+02:00","position":3,"updated_at":"2025-02-24T23:53:23+02:00","product_id":9759478284555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/sina-incastrata-pentru-proiectoare-magnetice-2m-negru__03.webp?v=1740434003","width":900,"height":900},{"id":51833243631883,"created_at":"2025-02-24T23:53:21+02:00","position":4,"updated_at":"2025-02-24T23:53:22+02:00","product_id":9759478284555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/sina-incastrata-pentru-proiectoare-magnetice-2m-negru__04.webp?v=1740434002","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10996978876683,"title":"Lustra LED cu telecomanda BANDO 38W, 2 Drepunghiuri, Lumina Rece\/Calda\/Neutra, Dimabila, Negru, Metal si Acril","handle":"lustra-led-cu-telecomanda-bando-38w-2-drepunghiuri-lumina-rece-calda-neutra-dimabila-negru-metal-si-acril","body_html":"\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"c132acb521656eef\"\u003e\n\u003cdiv class=\"response-container ng-tns-c1310598610-51 response-container-with-gpi tts-removed ng-star-inserted\"\u003e\n\u003cdiv class=\"presented-response-container ng-tns-c1310598610-51\"\u003e\n\u003cdiv class=\"response-container-content ng-tns-c1310598610-51\"\u003e\n\u003cdiv class=\"response-content ng-tns-c1310598610-51\"\u003e\n\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_c132acb521656eef\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:279\"\u003eAceastă lustră LED cu telecomandă BANDO, de 39W și culoare neagră, este o alegere excelentă pentru a adăuga un plus de modernitate și funcționalitate locuinței tale . Designul său contemporan, cu 2 dreptunghiuri interconectate, va crea un punct focal elegant în orice cameră.\u003c\/p\u003e\n\u003cp data-sourcepos=\"1:1-1:279\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:28\"\u003e\u003cstrong\u003eIată ce o face specială:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"5:1-12:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:224\"\u003e\n\u003cstrong\u003eIluminare puternică și eficientă:\u003c\/strong\u003e Cu o putere de 38W, această lustră oferă o lumină intensă, ideală pentru a ilumina spații mari, contribuind în același timp la reducerea consumului de energie datorită tehnologiei LED.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:384\"\u003e\n\u003cstrong\u003eVersatilitate în alegerea culorii luminii:\u003c\/strong\u003e Telecomanda îți permite să selectezi între lumină rece (perfectă pentru activități care necesită concentrare), lumină caldă (ideală pentru a crea o atmosferă relaxantă și primitoare) și lumină neutră (potrivită pentru utilizarea generală de zi cu zi). Poți schimba tipul de lumină și prin apăsări succesive ale întrerupătorului clasic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:237\"\u003e\n\u003cstrong\u003eIntensitate reglabilă:\u003c\/strong\u003e Funcția de dimare, controlată tot prin telecomandă, îți oferă posibilitatea de a ajusta intensitatea luminii în funcție de preferințe și de momentul zilei, creând astfel ambianța perfectă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:213\"\u003e\n\u003cstrong\u003eDesign modern și elegant:\u003c\/strong\u003e Forma geometrică a celor 2 pătrate și culoarea neagră conferă lămpii un aspect sofisticat și contemporan, integrându-se cu ușurință în diverse stiluri de design interior .\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:110\"\u003e\n\u003cstrong\u003eControl comod prin telecomandă:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea luminii fără a te deplasa.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:137\"\u003e\n\u003cstrong\u003eDurabilitate și longevitate:\u003c\/strong\u003e Tehnologia LED asigură o durată de viață îndelungată a lămpii, reducând nevoia de înlocuire frecventă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eInstalare facilă:\u003c\/strong\u003e Lustra vine cu toate accesoriile necesare și instrucțiuni clare pentru o montare simplă și rapidă.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"13:1-13:298\"\u003eImaginează-ți această lustră BANDO în livingul tău , oferind o lumină adaptabilă pentru serile relaxante în familie sau pentru momentele în care primești oaspeți. Designul său atrăgător va completa decorul, iar funcționalitatea telecomenzii îți va oferi control total asupra iluminatului.\u003c\/p\u003e\n\u003cp data-sourcepos=\"13:1-13:298\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"feedback-form-turn-index\" id=\"feedback-form-6\"\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2026-07-06T13:34:02+03:00","created_at":"2026-07-06T13:04:41+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":53223794737419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT8001\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10996978876683,"created_at":"2026-07-06T13:04:42+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69701976523019,"created_at":"2026-07-06T13:31:12+03:00","position":1,"updated_at":"2026-07-06T13:31:17+03:00","product_id":10996978876683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_13_29_32.png?v=1783333877","width":1254,"height":1254},{"id":69701976555787,"created_at":"2026-07-06T13:31:12+03:00","position":2,"updated_at":"2026-07-06T13:31:17+03:00","product_id":10996978876683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_13_30_57.png?v=1783333877","width":1254,"height":1254},{"id":69702001131787,"created_at":"2026-07-06T13:33:19+03:00","position":3,"updated_at":"2026-07-06T13:33:23+03:00","product_id":10996978876683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_13_33_09.png?v=1783334003","width":1254,"height":1254},{"id":69701924716811,"created_at":"2026-07-06T13:25:54+03:00","position":4,"updated_at":"2026-07-06T13:25:58+03:00","product_id":10996978876683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_13_25_46.png?v=1783333558","width":1254,"height":1254},{"id":69701894635787,"created_at":"2026-07-06T13:23:04+03:00","position":5,"updated_at":"2026-07-06T13:23:09+03:00","product_id":10996978876683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_13_22_26.png?v=1783333389","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10996920189195,"title":"Lustra LED cu telecomanda BLUM, 108W, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Metal si Acril","handle":"lustra-led-cu-telecomanda-blum-108w-lumina-rece-calda-neutra-dimabila-negru-metal-si-acril","body_html":"\u003cp data-sourcepos=\"3:1-3:79\"\u003e\u003cstrong\u003eUn Accent de Modernitate și Control Luminos Personalizat: Lustra LED BLUM\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:234\"\u003eTransformă-ți spațiul cu eleganța minimalistă și funcționalitatea inteligentă a lustrei LED BLUM. Designul său contemporan, definit de linii curate și o nuanță \u003cb\u003eneagra \u003c\/b\u003esofisticată, aduce un aer modern și stilat în orice încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:194\"\u003eCu o putere eficientă de \u003cstrong\u003e108W\u003c\/strong\u003e, lustra BLUM oferă o iluminare versatilă, adaptabilă oricărei nevoi. Explorează spectrul complet de lumină cu cele \u003cstrong\u003etrei temperaturi de culoare\u003c\/strong\u003e disponibile:\u003c\/p\u003e\n\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:82\"\u003e\n\u003cstrong\u003eAlb rece:\u003c\/strong\u003e Stimulant și ideal pentru a spori concentrarea în zonele de lucru.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:107\"\u003e\n\u003cstrong\u003eAlb cald:\u003c\/strong\u003e Primitor și relaxant, perfect pentru a crea o atmosferă confortabilă în zonele de relaxare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eAlb neutru:\u003c\/strong\u003e Echilibrat și versatil, potrivit pentru iluminatul general al casei.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"13:1-13:231\"\u003e\u003cstrong\u003eTelecomanda inclusă\u003c\/strong\u003e îți oferă puterea de a modela lumina după preferințele tale. Ajustează intensitatea cu funcția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, creând o ambianță luminoasă vibrantă sau o lumină ambientală subtilă, totul cu o simplă atingere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"15:1-15:58\"\u003e\u003cstrong\u003eGILDIS: Simplitate elegantă, control luminos intuitiv.\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"17:1-17:29\"\u003e\u003cstrong\u003eCaracteristici Esențiale:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"19:1-25:0\"\u003e\n\u003cli data-sourcepos=\"19:1-19:73\"\u003e\n\u003cstrong\u003eDesign Minimalist Modern:\u003c\/strong\u003e Linii curate și finisaj negru sofisticat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:73\"\u003e\n\u003cstrong\u003eIluminare Adaptabilă (108W):\u003c\/strong\u003e Putere eficientă pentru diverse spații.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-21:77\"\u003e\n\u003cstrong\u003eSpectru Luminos Complet:\u003c\/strong\u003e Alb rece, cald și neutru, pentru orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"22:1-22:83\"\u003e\n\u003cstrong\u003eControl Personalizat (Dimmabilă):\u003c\/strong\u003e Ajustează intensitatea luminii cu ușurință.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:78\"\u003e\n\u003cstrong\u003eConfort Inteligent (Telecomandă):\u003c\/strong\u003e Gestionează iluminatul de la distanță.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-25:0\"\u003e\n\u003cstrong\u003eEstetică Versatilă:\u003c\/strong\u003e Se integrează armonios în diverse stiluri de interior.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"26:1-26:24\"\u003e\u003cstrong\u003eBeneficii Resimțite:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"28:1-33:0\"\u003e\n\u003cli data-sourcepos=\"28:1-28:83\"\u003e\n\u003cstrong\u003eAdaptează Lumina Perfect:\u003c\/strong\u003e Creează atmosfera ideală pentru fiecare activitate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-29:82\"\u003e\n\u003cstrong\u003eEleganță Subtilă:\u003c\/strong\u003e Designul minimalist adaugă un plus de stil fără a copleși.\u003c\/li\u003e\n\u003cli data-sourcepos=\"30:1-30:71\"\u003e\n\u003cstrong\u003eControl Fără Efort:\u003c\/strong\u003e Telecomanda face ajustările rapide și comode.\u003c\/li\u003e\n\u003cli data-sourcepos=\"31:1-31:73\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e Te bucuri de lumină optimă cu un consum redus.\u003c\/li\u003e\n\u003cli data-sourcepos=\"32:1-33:0\"\u003e\n\u003cstrong\u003eIntegrare Armonioasă:\u003c\/strong\u003e Se potrivește cu ușurință în decorul existent.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"34:1-34:225\"\u003eLustra LED cu telecomandă BLUM nu este doar un corp de iluminat, ci o combinație de design modern și control inteligent, oferindu-ți flexibilitatea de a crea exact lumina de care ai nevoie, cu un stil minimalist și elegant.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-07-21T12:16:36+03:00","created_at":"2