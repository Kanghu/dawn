ted_at":"2025-09-30T09:36:31+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68117309227275,"created_at":"2026-04-07T19:46:42+03:00","position":1,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1._COVER_2509fc11-916f-4e37-af46-c2c4ee954804.png?v=1775580678","width":1000,"height":1000},{"id":68117309391115,"created_at":"2026-04-07T19:46:44+03:00","position":2,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2._CLOSE_UP_53fbb0ab-8682-4742-89d0-826dde5fc1de.png?v=1775580678","width":1000,"height":1000},{"id":68117316469003,"created_at":"2026-04-07T19:50:46+03:00","position":3,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5.3-TONECONTROL.png?v=1775580678","width":1000,"height":1000},{"id":68117309718795,"created_at":"2026-04-07T19:46:48+03:00","position":4,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT1306WH_spec_5d104fdb-4fe0-4407-9cad-40549527e0a2.png?v=1775580678","width":2000,"height":2000},{"id":68117309686027,"created_at":"2026-04-07T19:46:46+03:00","position":5,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT1306WH_39bafe0d-02d6-4e4d-b423-edc31ced1f75.png?v=1775580678","width":2000,"height":2000},{"id":68117309522187,"created_at":"2026-04-07T19:46:45+03:00","position":6,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._PLACE_1_43a63117-47d3-4cfb-b59b-962358a7cf67.png?v=1775580678","width":1000,"height":1000},{"id":68117309423883,"created_at":"2026-04-07T19:46:44+03:00","position":7,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._PLACE_2_d4c63f04-66c3-483e-a5ef-bdeb3b7d1beb.png?v=1775580678","width":1000,"height":1000},{"id":68117309489419,"created_at":"2026-04-07T19:46:45+03:00","position":8,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._PLACE_3_df1f9241-2853-4f69-981e-260d85f37bdf.png?v=1775580678","width":1000,"height":1000},{"id":68117309358347,"created_at":"2026-04-07T19:46:44+03:00","position":9,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15._PLACE_4_dff62f30-37b4-40f7-ad5f-98a75d4b818c.png?v=1775580678","width":1000,"height":1000},{"id":68117309620491,"created_at":"2026-04-07T19:46:45+03:00","position":10,"updated_at":"2026-04-07T19:51:18+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/16._PLACE_5_90252f53-a8b9-431a-a607-f9848c0de31f.png?v=1775580678","width":1000,"height":1000},{"id":69658244841739,"created_at":"2026-07-03T11:14:00+03:00","position":11,"updated_at":"2026-07-03T11:14:29+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_VICTORIA_19W_Patrata_lumina_Rece_Calda_Neutra_Negru_Alb_1.jpg?v=1783066469","width":1254,"height":1254},{"id":69824688259339,"created_at":"2026-07-24T13:15:18+03:00","position":12,"updated_at":"2026-07-24T13:15:20+03:00","product_id":9757821174027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2523632_big_color.png?v=1784888120","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760862798091,"title":"Lustra LED cu telecomanda VECTOR ARCUS 52W, 2 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb Negru, Metal","handle":"lustra-led-cu-telecomanda-vector-arcus-52w-2-elemente-lumina-rece-calda-neutra-dimabila-alb-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:222\"\u003eAceastă lustră LED cu telecomandă VECTOR ARCUS, de 52W, îmbină un design modern cu funcționalități avansate de iluminare. Cele două cercuri, în combinația elegantă de alb și negru, adaugă un plus de stil oricărui interior.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-14:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:75\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 52W, asigurând o iluminare eficientă pentru diverse încăperi.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:113\"\u003e\n\u003cstrong\u003eDesign modern:\u003c\/strong\u003e Două cercuri într-o combinație cromatică alb-negru, oferind un aspect contrastant și stilat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:143\"\u003e\n\u003cstrong\u003eTip de lumină reglabil:\u003c\/strong\u003e Permite selectarea între lumină rece, caldă sau neutră, adaptându-se perfect activităților și preferințelor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:127\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii este reglabilă cu ajutorul telecomenzii incluse, permițându-ți să creezi atmosfera dorită.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:230\"\u003e\n\u003cstrong\u003eControl prin telecomandă:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea luminii de la distanță. Lustra poate fi controlată și prin intermediul întrerupătorului clasic (schimbarea modului de iluminare prin apăsări succesive).\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:99\"\u003e\n\u003cstrong\u003eFlux luminos optim:\u003c\/strong\u003e Oferă o cantitate adecvată de lumină pentru a ilumina eficient încăperea.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:83\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:83\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție solidă pentru o utilizare de lungă durată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-14:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu instrucțiuni clare pentru o montare simplă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"15:1-15:203\"\u003eAceastă lustră LED VECTOR ARCUS este o soluție de iluminat modernă și practică, care oferă control total asupra atmosferei luminoase din locuința ta, combinând estetica plăcută cu performanța energetică.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:203\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:40:52+02:00","created_at":"2025-02-25T03:40:51+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52428608078091,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT810WHBK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":9760862798091,"created_at":"2025-09-30T14:36:17+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":52606105649419,"created_at":"2025-03-25T14:05:40+02:00","position":1,"updated_at":"2026-07-06T11:12:16+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hd575130e9b8f4c53895c81d9ea8b054eV.webp?v=1783325536","width":1024,"height":1024},{"id":51855759835403,"created_at":"2025-02-25T03:40:53+02:00","position":2,"updated_at":"2026-07-06T11:13:22+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-diones-telecomanda-64w-metalic-3000k-4000k-6000k-negru-alb_LL175_01.webp?v=1783325602","width":1024,"height":1024},{"id":52606105813259,"created_at":"2025-03-25T14:05:40+02:00","position":3,"updated_at":"2026-07-06T11:14:42+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/He4d482cc99e444c39dd9cb3b08ed0598I.webp?v=1783325682","width":1024,"height":1024},{"id":52606105846027,"created_at":"2025-03-25T14:05:40+02:00","position":4,"updated_at":"2025-03-25T14:06:28+02:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H2afa9fe9eb9e4ecfb31f57f0226ad297x.webp?v=1742904388","width":800,"height":800},{"id":69701478187275,"created_at":"2026-07-06T11:22:16+03:00","position":5,"updated_at":"2026-07-06T11:22:20+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_11_22_04.png?v=1783326140","width":1254,"height":1254},{"id":69701460951307,"created_at":"2026-07-06T11:18:47+03:00","position":6,"updated_at":"2026-07-06T11:18:51+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage6iul.2026_11_18_37.png?v=1783325931","width":1254,"height":1254},{"id":69701434867979,"created_at":"2026-07-06T11:09:29+03:00","position":7,"updated_at":"2026-07-06T11:09:31+03:00","product_id":9760862798091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2527842_big_color.png?v=1783325371","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759990513931,"title":"Lustra Aethra, 1x E27, Metal, Negru","handle":"lustra-aethra-1x-e27-metal-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:242\"\u003eInfuzeaza-ti spatiul cu un strop de stil industrial, reinventat. Lustra Aethra nu este doar o sursa de lumina, ci o declaratie de design compacta, creata sa aduca un caracter distinct atat in interioare, cat si in zonele exterioare acoperite.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:195\"\u003e\n\u003cstrong\u003eSilueta Geometrica Captivanta:\u003c\/strong\u003e Cu o forma ce aminteste de un diamant, realizata din metal negru, aceasta lustra ofera o estetica minimalista, dar plina de forta, un accent vizual memorabil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:201\"\u003e\n\u003cstrong\u003ePunct de Lumina Versatil:\u003c\/strong\u003e Echipata cu un soclu E27, Aethra focalizeaza lumina, ideala pentru a crea o atmosfera intima sau a accentua zone specifice, atat in living, cat si pe o terasa acoperita.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:193\"\u003e\n\u003cstrong\u003ePrezenta Discreta, Impact Major:\u003c\/strong\u003e Cu un diametru de 14 cm si o inaltime de 22 cm, se integreaza armonios in spatii diverse, de la holuri inguste la balcoane cochete, fara a incarca vizual.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-9:0\"\u003e\n\u003cstrong\u003eDurabilitate si Adaptabilitate:\u003c\/strong\u003e Construita din metal rezistent si conceputa pentru utilizare atat in interior, cat si exterior (acoperit), asigura o prezenta estetica de lunga durata.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:151\"\u003eAceasta lustra nu doar lumineaza functional, ci redefineste estetica spatiului, aducand o nota de caracter si rafinament, indiferent de locatia aleasa.\u003c\/p\u003e","published_at":"2025-02-25T01:16:41+02:00","created_at":"2025-02-25T01:16:40+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52424031731979,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8121\/1","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"48.97","grams":0,"compare_at_price":"48.97","position":1,"product_id":9759990513931,"created_at":"2025-09-29T13:06:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51841052934411,"created_at":"2025-02-25T01:16:43+02:00","position":1,"updated_at":"2025-02-25T01:16:45+02:00","product_id":9759990513931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aethra-1x-e27-metal-negru-1733163567.webp?v=1740439005","width":1024,"height":1024},{"id":51841052999947,"created_at":"2025-02-25T01:16:43+02:00","position":2,"updated_at":"2025-05-30T19:51:54+03:00","product_id":9759990513931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aethra-1x-e27-metal-negru_8121-1_04.webp?v=1748623914","width":900,"height":900},{"id":51841052868875,"created_at":"2025-02-25T01:16:43+02:00","position":3,"updated_at":"2025-05-30T19:51:54+03:00","product_id":9759990513931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aethra-1x-e27-metal-negru_8121-1_03.webp?v=1748623914","width":900,"height":900},{"id":51841052967179,"created_at":"2025-02-25T01:16:43+02:00","position":4,"updated_at":"2025-05-30T19:51:54+03:00","product_id":9759990513931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H9e72066845db46da9936859d6529f4984-1733163590.webp?v=1748623914","width":1024,"height":1024},{"id":51841052901643,"created_at":"2025-02-25T01:16:43+02:00","position":5,"updated_at":"2025-05-30T19:51:54+03:00","product_id":9759990513931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-aethra-1x-e27-metal-negru_8121-1_02.webp?v=1748623914","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758378852619,"title":"Lustra LED cu telecomanda ELLA 67W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-ella-67w-4-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp data-start=\"156\" data-end=\"490\"\u003e\u003cstrong data-start=\"156\" data-end=\"190\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_8a0de901-8989-4a89-9459-90b1b62d5054.png?v=1778458094\"\u003eLustra LED cu telecomandă ELLA\u003c\/strong\u003e este o piesă de iluminat modernă și elegantă, creată pentru a redefini orice interior printr-un design geometric spectaculos. Cele \u003cstrong data-start=\"322\" data-end=\"354\"\u003epatru pătrate interconectate\u003c\/strong\u003e, finisate în alb imaculat, formează o compoziție vizuală armonioasă, perfectă pentru interioare contemporane, minimaliste sau rafinate.\u003c\/p\u003e\n\u003cbr\u003e\u003cp data-start=\"492\" data-end=\"831\"\u003eCu o putere de \u003cstrong\u003e67W\u003c\/strong\u003e, ELLA oferă o iluminare amplă și uniformă, ideală pentru \u003cstrong data-start=\"572\" data-end=\"613\"\u003elivinguri, dininguri, zone open-space\u003c\/strong\u003e sau camere cu tavan mediu înalt. LED-urile integrate permit selectarea temperaturii de culoare — \u003cstrong data-start=\"711\" data-end=\"737\"\u003erece, neutră sau caldă\u003c\/strong\u003e — pentru a adapta instant atmosfera în funcție de momentul zilei sau activitatea desfășurată:\u003c\/p\u003e\n\u003cul data-start=\"833\" data-end=\"1051\"\u003e\n\u003cli data-start=\"833\" data-end=\"908\"\u003e\u003cp data-start=\"835\" data-end=\"908\"\u003e\u003cstrong data-start=\"835\" data-end=\"855\"\u003eAlb rece (6000K)\u003c\/strong\u003e – pentru concentrare, energie și claritate vizuală\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"909\" data-end=\"962\"\u003e\u003cp data-start=\"911\" data-end=\"962\"\u003e\u003cstrong data-start=\"911\" data-end=\"931\"\u003eAlb cald (3000K)\u003c\/strong\u003e – pentru relaxare și confort\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"963\" data-end=\"1051\"\u003e\u003cp data-start=\"965\" data-end=\"1051\"\u003e\u003cstrong data-start=\"965\" data-end=\"987\"\u003eAlb neutru (4000K)\u003c\/strong\u003e – pentru utilizare zilnică, cu lumină naturală și echilibrată\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cbr\u003e\u003cp data-start=\"1053\" data-end=\"1301\"\u003ePrin funcția de \u003cstrong data-start=\"1069\" data-end=\"1080\"\u003edimmare\u003c\/strong\u003e, poți regla intensitatea luminii de la ambient discret la iluminare puternică. Controlul se realizează ușor prin telecomanda inclusă, oferind libertate totală asupra atmosferei din cameră, fără a te ridica de pe canapea.\u003ca class=\"video-link\" href=\"https:\/\/www.youtube.com\/watch?v=jgWYTez0ihQ\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003c\/a\u003e\u003c\/p\u003e\n\u003cp data-start=\"1303\" data-end=\"1632\"\u003e\u003cstrong data-start=\"1303\" data-end=\"1333\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003cbr data-start=\"1333\" data-end=\"1336\"\u003e• Design geometric modern cu 4 pătrate interconectate\u003cbr data-start=\"1389\" data-end=\"1392\"\u003e• Finisaj alb, perfect pentru decoruri luminoase\u003cbr data-start=\"1440\" data-end=\"1443\"\u003e• Putere 67W și iluminare uniformă\u003cbr data-start=\"1477\" data-end=\"1480\"\u003e• Trei temperaturi de culoare: rece \/ neutră \/ caldă\u003cbr data-start=\"1532\" data-end=\"1535\"\u003e• Funcție dimmabilă pentru reglarea intensității\u003cbr data-start=\"1583\" data-end=\"1586\"\u003e• Telecomandă inclusă pentru control complet\u003c\/p\u003e\n\u003cp data-start=\"1634\" data-end=\"1853\"\u003e\u003cstrong data-start=\"1634\" data-end=\"1648\"\u003eBeneficii:\u003c\/strong\u003e\u003cbr data-start=\"1648\" data-end=\"1651\"\u003e• Aspect modern și elegant\u003cbr data-start=\"1677\" data-end=\"1680\"\u003e• Iluminare versatilă, adaptată nevoilor tale\u003cbr data-start=\"1725\" data-end=\"1728\"\u003e• Control rapid și intuitiv\u003cbr data-start=\"1755\" data-end=\"1758\"\u003e• Eficiență energetică datorită tehnologiei LED\u003cbr data-start=\"1805\" data-end=\"1808\"\u003e• Instalare simplă, design ușor de integrat\u003c\/p\u003e\n\u003chr data-start=\"1855\" data-end=\"1858\"\u003e\n\u003c\/div\u003e\u003ch1 style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/h1\u003e\u003ch1 style=\"text-align: center;\"\u003e \u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003eVezi video demonstrativ\u003c\/strong\u003e\u003c\/span\u003e\n\u003c\/h1\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003cdiv style=\"text-align: center;\"\u003e\n\u003cspan style=\"color: #000000;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\u003cp\u003e\u003ca class=\"video-link\" href=\"https:\/\/www.youtube.com\/watch?v=jgWYTez0ihQ\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e \u003cimg alt=\"YouTube video thumbnail\" src=\"https:\/\/img.youtube.com\/vi\/jgWYTez0ihQ\/maxresdefault.jpg\" style=\"width: 860px;\"\u003e \u003c\/a\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:29:05+02:00","created_at":"2025-02-24T21:29:04+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429383598347,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT130\/4WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9758378852619,"created_at":"2025-09-30T16:05:51+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70052289118475,"created_at":"2026-09-04T11:22:39+03:00","position":1,"updated_at":"2026-09-04T11:22:44+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep4_2026_11_22_26AM.png?v=1788510164","width":1254,"height":1254},{"id":68820867481867,"created_at":"2026-05-11T03:07:43+03:00","position":2,"updated_at":"2026-05-11T03:07:48+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.SPECIFICATION_5f813551-776a-4b6e-bed0-b30cb143f462.png?v=1778458068","width":1000,"height":1000},{"id":68820867580171,"created_at":"2026-05-11T03:07:43+03:00","position":3,"updated_at":"2026-05-11T03:07:48+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5.3-TONECONTROL_cb1285ab-5ff7-4f53-9b73-ce5818682180.png?v=1778458068","width":1000,"height":1000},{"id":68820867612939,"created_at":"2026-05-11T03:07:43+03:00","position":4,"updated_at":"2026-05-11T03:07:48+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopif