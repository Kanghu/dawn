ată lungă de viață și vă veți putea bucura mult timp de frumusețea și lumina lustrei alese!\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T14:36:37+02:00","created_at":"2025-02-24T14:36:36+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52428124455179,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2204\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"216.00","grams":0,"compare_at_price":"279.99","position":1,"product_id":9757204775179,"created_at":"2025-09-30T12:35:29+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813459886347,"created_at":"2025-02-24T14:36:39+02:00","position":1,"updated_at":"2025-11-06T20:30:34+02:00","product_id":9757204775179,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_01.webp?v=1762453834","width":900,"height":900},{"id":51813459689739,"created_at":"2025-02-24T14:36:39+02:00","position":2,"updated_at":"2025-11-06T20:30:34+02:00","product_id":9757204775179,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_02.webp?v=1762453834","width":900,"height":900},{"id":51813459820811,"created_at":"2025-02-24T14:36:39+02:00","position":3,"updated_at":"2025-09-15T15:12:16+03:00","product_id":9757204775179,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_03.webp?v=1757938336","width":900,"height":900},{"id":51813459755275,"created_at":"2025-02-24T14:36:39+02:00","position":4,"updated_at":"2025-09-15T15:12:16+03:00","product_id":9757204775179,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/