:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT723_6-lustra-led-cu-telecomanda_4.webp?v=1757669201","width":1080,"height":1080},{"id":62981868159243,"created_at":"2025-12-03T16:54:47+02:00","position":8,"updated_at":"2026-07-23T14:24:33+03:00","product_id":10239479808267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_6.png?v=1784805873","width":2000,"height":2000},{"id":69883237237003,"created_at":"2026-08-06T13:05:04+03:00","position":9,"updated_at":"2026-08-06T13:05:06+03:00","product_id":10239479808267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2483402_big_color.png?v=1786010706","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757816750347,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA RGB 145W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-nova-rotonda-rgb-145w-6-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp\u003e\u003cstrong\u003eLustra LED cu telecomanda si cristal NOVA ROTONDA, 145W, 6 cercuri, RGB, lumina reglabila, negru\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eNOVA ROTONDA este o lustra LED spectaculoasa cu 6 cercuri, conceputa pentru camere mari, unde lumina trebuie sa fie nu doar suficienta, ci si impresionanta. Designul modern cu elemente din cristal si finisaj negru o face sa iasa in evidenta in orice living, dormitor sau bucatarie cu tavan generos.\u003c\/p\u003e\u003cp\u003e✔ \u003cstrong\u003ePutere mare – 145W si 11600 lumeni\u003c\/strong\u003e – lumineaza fara probleme incaperi de mari dimensiuni.\u003cbr\u003e✔ \u003cstrong\u003e3 tipuri de lumina (calda, neutra, rece)\u003c\/strong\u003e – selectabile usor cu telecomanda inclusa.\u003cbr\u003e✔ \u003cstrong\u003eDimabila\u003c\/strong\u003e – reglezi intensitatea exact cum ai nevoie, de la lumina ambientala la lumina puternica.\u003cbr\u003e✔ \u003cstrong\u003eDurata de viata 25.000h\u003c\/strong\u003e – gandita pentru utilizare indelungata, fara grija inlocuirii frecvente.\u003cbr\u003e✔ \u003cstrong\u003eConstructie solida si materiale premium (acril, cristal, metal)\u003c\/strong\u003e – combinatia perfecta intre aspect si rezistenta.\u003cbr\u003e✔ \u003cstrong\u003eTelecomanda inclusa + comutator clasic\u003c\/strong\u003e – flexibilitate totala la control.\u003cbr\u003e✔ \u003cstrong\u003eTemperatura de culoare reglabila: 3000K \/ 4000K \/ 6000K\u003c\/strong\u003e – adaptabila oricarui moment al zilei sau stil de amenajare.\u003c\/p\u003e\u003cp\u003eRecomandata pentru \u003cstrong\u003elivinguri moderne, dormitoare mari sau bucatarii open-space\u003c\/strong\u003e, NOVA ROTONDA nu este doar o sursa de lumina, ci un element de impact vizual in orice casa. Se monteaza pe tavan si se alimenteaza la reteaua standard 220-230V.\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:30:38+02:00","created_at":"2025-02-24T18:30:37+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52424486224139,"t