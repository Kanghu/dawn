files\/2._Remote_Show_3c69ed1a-7fbc-4d3b-b3e9-8a40f16507c8.jpg?v=1773139123","width":3999,"height":3999},{"id":67110435029259,"created_at":"2026-03-10T12:35:12+02:00","position":7,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9._Detail_2_9a522e75-934f-431c-ad13-07bc17fa882e.jpg?v=1775078298","width":3999,"height":3999},{"id":67110431359243,"created_at":"2026-03-10T12:34:08+02:00","position":8,"updated_at":"2026-03-10T12:38:43+02:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8._Detail_1_c14b1b5f-24cf-4150-8d56-fa85c8ad99d1.jpg?v=1773139123","width":3999,"height":3999},{"id":67110432768267,"created_at":"2026-03-10T12:34:34+02:00","position":9,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/10._Detail_3_940ead82-cc29-49d9-ad28-9be9e11dd230.jpg?v=1775078298","width":3999,"height":3999},{"id":67110434668811,"created_at":"2026-03-10T12:35:05+02:00","position":10,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_1_9fc69341-a498-4064-bcf4-6bff4a200f0f.jpg?v=1775078298","width":3999,"height":3999},{"id":67110435848459,"created_at":"2026-03-10T12:35:16+02:00","position":11,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._Place_2_016a8f9e-a9be-43e7-bdac-da2042c4f6fd.jpg?v=1775078298","width":3999,"height":3999},{"id":67110586581259,"created_at":"2026-03-10T12:35:35+02:00","position":12,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_32176a87-91ce-44f6-b971-c2446528d3a7.jpg?v=1775078298","width":3999,"height":3999},{"id":67110435782923,"created_at":"2026-03-10T12:35:16+02:00","position":13,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_da85bffc-2f99-43ec-854e-a0255127a80f.jpg?v=1775078298","width":3999,"height":3999},{"id":67110427853067,"created_at":"2026-03-10T12:33:11+02:00","position":14,"updated_at":"2026-04-02T00:18:18+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6._Size_e38b72f7-1a40-4ca2-bcf2-dd87f0dc4085.jpg?v=1775078298","width":3999,"height":3999},{"id":69815576396043,"created_at":"2026-07-22T17:18:17+03:00","position":15,"updated_at":"2026-07-22T17:19:23+03:00","product_id":9757891821835,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_ELLA_119W_6_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Alb_Metal_si_Acril_1.png?v=1784729963","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757187047691,"title":"Lustra Forma Cub, STRUKTUR Uno, 1x E27, Negru, Suspendat, Metal","handle":"lustra-forma-cub-struktura-uno-1x-e27-negru-suspendat-metal","body_html":"\u003ch6\u003ePendulele sunt corpuri de iluminat cu unul sau mai multe becuri, suspendate printr-un cablu flexibil sau tija rigidă dar reglabilă, astfel încat poți regla ușor înalțimea dorită.\u003c\/h6\u003e\u003ch6\u003eUtilizând pendulele în planurile tale de design interior vei crea cu ajutorul lor zone de lumină, vei putea delimita sau pune un accent pe anumite suprafețe sau zone ale spațiului interior. Un pendul deasupra mesei va crea mici oaze de calm și relaxare, unde vei putea să savurezi o cină în tihnă cu cei dragi, să lucrezi sau să citești.\u003c\/h6\u003e","published_at":"2025-02-24T14:28:40+02:00","created_at":"2025-02-24T14:28:39+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52414934155531,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-528\/1","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"38.40","grams":0,"compare_at_price":"44.79","position":1,"product_id":9757187047691,"created_at":"2025-09-26T14:39:41+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813369053451,"created_at":"2025-02-24T14:28:42+02:00","position":1,"updated_at":"2025-02-24T14:28:44+02:00","product_id":9757187047691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrat-1xe27-negru-metal_PDL2193N_01.webp?v=1740400124","width":900,"height":900},{"id":51813369020683,"created_at":"2025-02-24T14:28:42+02:00","position":2,"updated_at":"2025-02-24T14:28:44+02:00","product_id":9757187047691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrat-1xe27-negru-metal_PDL2193N_02.webp?v=1740400124","width":900,"height":900},{"id":51813369151755,"created_at":"2025-02-24T14:28:43+02:00","position":3,"updated_at":"2025-02-24T14:28:45+02:00","product_id":9757187047691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrat-1xe27-negru-metal_PDL2193N_03.webp?v=1740400125","width":900,"height":900},{"id":51813369184523,"created_at":"2025-02-24T14:28:43+02:00","position":4,"updated_at":"2025-02-24T14:28:45+02:00","product_id":9757187047691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrat-1xe27-negru-metal_PDL2193N_04.webp?v=1740400125","width":900,"height":900},{"id":51813369086219,"created_at":"2025-02-24T14:28:43+02:00","position":5,"updated_at":"2025-02-24T14:28:44+02:00","product_id":9757187047691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-patrat-1xe27-negru-metal_PDL2193N_05.webp?v=1740400124","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757563027723,"title":"Lustra LED cu telecomanda si cristal Alejandro RGB 88W, 5 Flori, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-alejandro-rgb-88w-5-flori-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003e\u003cstrong\u003eLustra LED cu telecomandă , RGB\u003c\/strong\u003e, de \u003cstrong\u003e88W\u003c\/strong\u003e, impresionează prin designul său floral modern, având cinci elemente stilizate în formă de floare, finisate într-un argintiu elegant. Această lustră nu este doar o sursă de lumină, ci și o piesă centrală decorativă, oferind o iluminare extrem de versatilă datorită tehnologiei \u003cstrong\u003eRGB\u003c\/strong\u003e, care permite alegerea dintr-o gamă largă de culori. În plus, poți opta pentru lumină \u003cstrong\u003erece\u003c\/strong\u003e, \u003cstrong\u003ecaldă \u003c\/strong\u003esau \u003cstrong\u003eneutră\u003c\/strong\u003e, adaptând atmosfera în funcție de preferințe sau necesități. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eTelecomanda inclusă facilitează controlul intensității luminii prin funcția de dimare, permițându-ți să creezi ambianța perfectă. Designul său floral stilizat și culoarea argintie adaugă o notă de rafinament și modernitate oricărui interior, fiind ideală pentru livinguri spațioase, sufragerii sau alte zone în care se dorește un impact vizual puternic și o lumină adaptabilă. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eCu o putere de \u003cstrong\u003e88W\u003c\/strong\u003e, asigură o iluminare amplă și eficientă, perfectă pentru a lumina generos încăperi mari.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T16:59:32+02:00","created_at":"2025-02-24T16:59:31+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52382791368971,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT071\/5","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"419.99","grams":0,"compare_at_price":"419.99","position":1,"product_id":9757563027723,"created_at":"2025-09-18T17:47:30+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69858437497099,"created_at":"2026-07-31T23:34:59+03:00","position":1,"updated_at":"2026-07-31T23:35:02+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT071-5.webp?v=1785530102","width":1254,"height":1254},{"id":69858437333259,"created_at":"2026-07-31T23:34:59+03:00","position":2,"updated_at":"2026-07-31T23:35:04+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LT071-5.webp?v=1785530104","width":1254,"height":1254},{"id":69858437398795,"created_at":"2026-07-31T23:34:59+03:00","position":3,"updated_at":"2026-07-31T23:35:02+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LT071-5.webp?v=1785530102","width":1254,"height":1254},{"id":69858437431563,"created_at":"2026-07-31T23:34:59+03:00","position":4,"updated_at":"2026-07-31T23:35:01+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LT071-5.webp?v=1785530101","width":1254,"height":1254},{"id":69858437267723,"created_at":"2026-07-31T23:34:59+03:00","position":5,"updated_at":"2026-07-31T23:35:01+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LT071-5.webp?v=1785530101","width":1254,"height":1254},{"id":69858437234955,"created_at":"2026-07-31T23:34:59+03:00","position":6,"updated_at":"2026-07-31T23:35:02+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LT071-5.webp?v=1785530102","width":1254,"height":1254},{"id":69858437595403,"created_at":"2026-07-31T23:34:59+03:00","position":7,"updated_at":"2026-07-31T23:35:01+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/012_12_LT071-5.webp?v=1785530101","width":1254,"height":1254},{"id":69858437366027,"created_at":"2026-07-31T23:34:59+03:00","position":8,"updated_at":"2026-07-31T23:35:02+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LT071-5.webp?v=1785530102","width":1254,"height":1254},{"id":69858437464331,"created_at":"2026-07-31T23:34:59+03:00","position":9,"updated_at":"2026-07-31T23:35:02+03:00","product_id":9757563027723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LT071-5.webp?v=1785530102","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760634044683,"title":"Lustra LED MIMA 30W, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-mima-30w-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED  MIMA  este o alegere ideală pentru cei care caută să adauge un element de design modern și inovator în spațiul lor interior. Cu un stil unic, împletit și finisaje în alb și negru, această lustră este perfectă pentru a ilumina și îmbogăți estetica holurilor sau altor spații mici, oferind în același timp un impact vizual deosebit.\u003cbr\u003e\u003cbr\u003eEchipată cu o putere de 30W, Lustra  MIMA oferă o iluminare eficientă și versatilă, fiind ideală pentru spații care necesită o lumină adecvată fără a ocupa mult spațiu. Cu un diametru de 35 cm și o înălțime de doar 10 cm, lustra se integrează armonios în diverse stiluri de decor, de la cele moderne la cele minimaliste.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai remarcabile aspecte ale Lustrei  MIMA  este capacitatea sa de a schimba între trei tipuri de lumină - caldă, rece și neutru. Această caracteristică vă permite să personalizați atmosfera în funcție de momentul zilei sau de activitatea desfășurată, creând un ambient perfect adaptat nevoilor dvs.\u003cbr\u003e\u003cbr\u003eDesignul împletit al lustrei adaugă o notă artistică și contemporană, transformând-o într-un punct focal interesant în orice hol. Combinația de culori alb și negru asigură o prezență marcantă, făcând din această lustră o alegere excelentă pentru cei care doresc să îmbine estetica cu funcționalitatea.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003cbr\u003e\u003cbr\u003eInstalarea Lustrei LED Seven este simplă și intuitivă, făcând posibilă transformarea rapidă a spațiului dvs. Alegeți Lustra LED Seven pentru a adăuga un element de design modern și o iluminare de calitate în casa dvs., combinând estetica plăcută cu funcționalitate avansată. Este soluția perfectă pentru a crea un ambient plăcut și pentru a adăuga un element de eleganță contemporană în locuința dvs.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T03:00:56+02:00","created_at":"2025-02-25T03:00:56+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52427658002699,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-B0221BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9760634044683,"created_at":"2025-09-30T09:56:35+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852316573963,"created_at":"2025-02-25T03:00:57+02:00","position":1,"updated_at":"2025-02-25T03:00:59+02:00","product_id":9760634044683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-seven-30w-negru-1705392264.webp?v=1740445259","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10239479808267,"title":"Lustra LED cu Telecomanda KARINA, 26W, 6 Elemente, Lumina Calda\/Rece\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomnda-karina-26w-6-elemente-lumina-calda-rece-neutra-dimabila-auriu","body_html":"\u003cdiv class=\"presented-response-container ng-tns-c3304092847-190\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3304092847-190\"\u003e\n\u003cdiv class=\"response-content ng-tns-c3304092847-190\"\u003e\n\u003cdiv dir=\"ltr\" id=\"model-response-message-contentr_a06f6a43b80c213d\" style=\"--animation-duration: 400ms; --fade-animation-function: linear;\" class=\"markdown markdown-main-panel stronger enable-updated-hr-color\"\u003e\n\u003cp\u003eLustra LED KARINA, o piesa de iluminat ce imbina estetica moderna cu functionalitatea avansata. Conceputa pentru a adauga o nota de rafinament si un efect vizual deosebit, aceasta lustra este mai mult decat o sursa de lumina, este o declaratie de stil.\u003c\/p\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare Personalizabila \u0026amp; Puternica:\u003c\/strong\u003e Beneficiati de o putere totala de \u003cstrong\u003e26W \u003c\/strong\u003esi un flux luminos generos de \u003cstrong\u003e1843lm\u003c\/strong\u003e. Alegeti din cele trei temperaturi de culoare (calda, neutra, rece) si controlati lumina intuitiv, fie prin intrerupatorul clasic, fie prin telecomanda.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eEficienta Energetica \u0026amp; Durabilitate:\u003c\/strong\u003e Tehnologia LED avansata asigura un consum optim si o durata de viata remarcabila de 25.000 de ore, oferind performanta pe termen lung si o intretinere minima.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\n\u003cp\u003eLustra LED KARINA este solutia ideala pentru cei ce cauta o iluminare eficienta, estetica si durabila, transformand fiecare incapere intr-un spatiu plin de personalitate si un confort vizual exceptional, perfect pentru dormitor sau living.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c!----\u003e\u003c!----\u003e\u003cdiv class=\"response-footer gap complete\"\u003e\n\u003c!----\u0