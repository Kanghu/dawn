e7e-1152-4f4e-92a5-9563066508ba.png?v=1763128096","width":1024,"height":1024},{"id":62981868159243,"created_at":"2025-12-03T16:54:47+02:00","position":3,"updated_at":"2026-07-23T14:24:33+03:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_6.png?v=1784805873","width":2000,"height":2000},{"id":56315031781643,"created_at":"2025-06-11T15:46:49+03:00","position":4,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT72310-LustraLEDKARINAcuTelecomnda_68W_LuminaCaldaReceNeutra_Negru-1.png?v=1764849543","width":1080,"height":1080},{"id":56328104902923,"created_at":"2025-06-12T01:29:00+03:00","position":5,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda_4.webp?v=1764849543","width":1080,"height":1080},{"id":56328104968459,"created_at":"2025-06-12T01:29:00+03:00","position":6,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda.webp?v=1764849543","width":1080,"height":1080},{"id":56328105001227,"created_at":"2025-06-12T01:29:00+03:00","position":7,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda_5.webp?v=1764849543","width":1080,"height":1080},{"id":56328104870155,"created_at":"2025-06-12T01:29:00+03:00","position":8,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda_2.webp?v=1764849543","width":1080,"height":1080},{"id":56328104837387,"created_at":"2025-06-12T01:29:00+03:00","position":9,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda_6.webp?v=1764849543","width":1080,"height":1080},{"id":56328104804619,"created_at":"2025-06-12T01:29:00+03:00","position":10,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt723_10-lustra-led-cu-telecomanda_3.webp?v=1764849543","width":1080,"height":1080},{"id":62528867795211,"created_at":"2025-11-20T17:27:21+02:00","position":11,"updated_at":"2025-12-04T13:59:03+02:00","product_id":10239202754827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT723_10GD_EPREL_24abc4fb-f069-4ce5-9b69-9f438342d922.png?v=1764849543","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758253252875,"title":"Lustra LED suspendata cu telecomanda ZIGZAG 27W, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-zigzag-27w-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:267\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_bf07a25e-b441-4273-8006-3bcf29eeab60.png?v=1775581819\" alt=\"\"\u003eAceastă lustră LED cu telecomandă ZIGZAG, de 27W și culoare neagră, adaugă un plus de eleganță modernă și flexibilitate în iluminarea locuinței tale . Cu designul său minimalist și înălțimea reglabilă, se adaptează perfect diverselor spații și preferințe.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:29\"\u003e\u003cstrong\u003eCaracteristici esențiale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-15:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:113\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 27W, asigurând o iluminare puternică și eficientă energetic pentru încăperi de diferite dimensiuni.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:223\"\u003e\n\u003cstrong\u003eTip de lumină variabil:\u003c\/strong\u003e Poți alege între lumină rece (ideală pentru birou sau bucătărie), caldă (perfectă pentru living sau dormitor) și neutră (potrivită pentru uz general), creând atmosfera dorită în fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:146\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii poate fi ajustată cu ușurință prin telecomanda inclusă, oferindu-ți control total asupra ambianței luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:183\"\u003e\n\u003cstrong\u003eÎnălțime reglabilă:\u003c\/strong\u003e Această caracteristică practică permite adaptarea poziției lămpii în funcție de înălțimea tavanului și de necesitățile specifice ale spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:247\"\u003e\n\u003cstrong\u003eControl inteligent:\u003c\/strong\u003e Telecomanda permite reglarea temperaturii culorii și a intensității luminii de la distanță. Lustra poate fi controlată și prin intermediul întrerupătorului clasic (prin apăsări succesive pentru a schimba tipul de lumină).\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:129\"\u003e\n\u003cstrong\u003eDesign modern și minimalist:\u003c\/strong\u003e Culoarea neagră conferă un aspect sofisticat și se integrează ușor în interioare contemporane.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:83\"\u003e\n\u003cstrong\u003eFlux luminos ridicat:\u003c\/strong\u003e Asigură o iluminare optimă și confortabilă a spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:111\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Durată de viață lungă și consum redus de energie, contribuind la economisirea costurilor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-13:80\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție robustă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu toate accesoriile necesare și instrucțiuni clare pentru montaj.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"16:1-16:307\"\u003eImaginează-ți această lustră ZIGZAG elegantă deasupra mesei din sufrageria ta din Voluntari, oferind o lumină caldă și primitoare pentru cine sau o lumină mai intensă pentru serile de jocuri. Flexibilitatea înălțimii și a tipului de lumină o fac o alegere versatilă și practică pentru orice locuință modernă.\u003c\/p\u003e\u003cp data-sourcepos=\"16:1-16:307\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:01:15+02:00","created_at":"2025-02-24T21:01:15+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","Back2school","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52423861305611,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT115BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":9758253252875,"created_at":"2025-09-29T11:55:28+03:00","updated_at":"2026-09-1