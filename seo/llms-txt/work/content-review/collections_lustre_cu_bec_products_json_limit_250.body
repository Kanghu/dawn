-07-06T15:09:03+03:00","product_id":9756919890187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_LOTUS_91W_9_Petale_lumina_Rece_Calda_Neutra_Dimabila_Alb12.png?v=1783339743","width":1254,"height":1254},{"id":69814853304587,"created_at":"2026-07-22T15:36:05+03:00","position":8,"updated_at":"2026-07-22T15:37:56+03:00","product_id":9756919890187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_LOTUS_91W_9_Petale_lumina_Rece_Calda_Neutra_Dimabila_Alb20.png?v=1784723876","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10180214685963,"title":"Lustra MODERNA LOFT Bagliore, Glob, 9xE27, Inaltime Reglabila, Auriu","handle":"lustra-moderna-bagliore-glob-9xe27-inaltime-reglabila-auriu","body_html":"\u003c!-- codex-banner:AT1CT-IM1P-HT2L-LC816\/9GD --\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_2000x900_LC816-9GD.jpg?v=1785518819\" alt=\"Lustra MODERNA LOFT Bagliore, Glob, 9xE27, Inaltime Reglabila, Auriu banner\" width=\"2000\" height=\"900\"\u003e\u003c\/p\u003e\u003c!-- \/codex-banner:AT1CT-IM1P-HT2L-LC816\/9GD --\u003e\u003cp class=\"p1\"\u003eLustra moderna LOFT Bagliore, design spectaculos cu 9 globuri albe, soclu E27, finisaj auriu elegant.\u003c\/p\u003e\u003cp class=\"p1\"\u003ePotrivita pentru living, dormitor sau dining, aceasta lustra adauga un aer rafinat si modern oricarui spatiu. Inaltime reglabila pentru flexibilitate maxima, compatibila cu becuri LED E27. Ideal pentru interioare in stil loft, contemporan sau minimalist.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-11T13:24:03+03:00","created_at":"2025-05-15T14:50:07+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","All Stock","BF2025","Corpuri de Iluminat","Lustre cu bec","Lustre cu bec moderne","Lustre LED Suspendate"],"variants":[{"id":52423674560779,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC816\/9GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10180214685963,"created_at":"2025-09-29T09:56:56+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70022732185867,"created_at":"2026-09-01T13:30:44+03:00","position":1,"updated_at":"2026-09-01T13:30:49+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep1_2026_01_30_18PM.png?v=1788258649","width":1254,"height":1254},{"id":69858027700491,"created_at":"2026-07-31T20:26:52+03:00","position":2,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027766027,"created_at":"2026-07-31T20:26:52+03:00","position":3,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027798795,"created_at":"2026-07-31T20:26:52+03:00","position":4,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027634955,"created_at":"2026-07-31T20:26:52+03:00","position":5,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027536651,"created_at":"2026-07-31T20:26:52+03:00","position":6,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027831563,"created_at":"2026-07-31T20:26:52+03:00","position":7,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858027929867,"created_at":"2026-07-31T20:26:52+03:00","position":8,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/013_13_LC816-9GD.webp?v=1785518815","width":1000,"height":1000},{"id":69858028126475,"created_at":"2026-07-31T20:26:52+03:00","position":9,"updated_at":"2026-07-31T20:26:55+03:00","product_id":10180214685963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/020_20_LC816-9GD.webp?v=1785518815","width":1000,"height":1000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760623821067,"title":"Lustra LED cu telecomanda FILO 188W, 6 Elemente, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-filo-188w-6-elemente-liniara-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu Telecomandă FILO este o alegere impresionantă pentru cei care doresc să adauge un element de modernitate și eficiență în orice spațiu interior. Cu un design contemporan, ce include șase brațe liniare suprapuse câte două și finisaje elegante în alb și negru, această lustră este perfectă pentru a aduce un strop de stil și inovație în livinguri, săli de mese sau spații de birouri.\u003cbr\u003e\u003cbr\u003eCu o putere de 188W și funcție dimabilă, Lustra FILO oferă un flux luminos puternic de 12633 lumeni, asigurând o iluminare amplă și versatilă. Aceasta permite adaptarea atmosferei la diferite momente ale zilei sau activități, de la o lumină intensă necesară pentru lucrul sau cititul, la o lumină mai suavă, ideală pentru relaxare.\u003cbr\u003e\u003cbr\u003eTelecomanda inclusă aduce un nivel suplimentar de confort, permițându-vă să controlați intensitatea și setările de lumină de la distanță. Această funcționalitate face din Lustra Caden o opțiune convenabilă și user-friendly.\u003cbr\u003e\u003cbr\u003eDesignul său cu brațe liniare suprapuse oferă un look geometric și sofisticat, transformând lustra într-un punct focal impresionant în decorul oricărei încăperi. Combinația de culori alb și negru adaugă un contrast vizual atractiv, conferind lustrei o prezență elegantă și contemporană.\u003cbr\u003e\u003cbr\u003eCu un diametru generos de 75 cm, Lustra Caden este ideală pentru a ilumina spații mari, oferind o distribuție uniformă și eficientă a luminii. Instalarea este simplă și intuitivă, facilitând o transformare rapidă și ușoară a oricărui spațiu interior.\u003cbr\u003e\u003cbr\u003eOptând pentru Lustra LED cu Telecomandă Caden, veți beneficia de un mix ideal de design modern, iluminare de calitate și funcționalitate avansată. Este soluția perfectă pentru cei care caută să creeze un ambient plăcut și să adauge un element de eleganță contemporană în locuința lor.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:59:12+02:00","created_at":"2025-02-25T02:59:11+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52409391251723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-306\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"416.00","grams":0,"compare_at_price":"569.99","position":1,"product_id":9760623821067,"created_at":"2025-09-24T18:14:36+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852159582475,"created_at":"2025-02-25T02:59:13+02:00","position":1,"updated_at":"2025-02-25T02:59:15+02:00","product_id":9760623821067,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-caden-188w-dimabila-alb-negru-1704787477.webp?v=1740445155","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757767631115,"title":"Lustra LED cu telecomanda KILLIAN 74W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Alb","handle":"lustra-led-cu-telecomanda-killian-74w-6-cercuri-lumina-rece-calda-neutra-dimabila-auriu-alb","body_html":"\u003cdiv style=\"text-align: center;\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"1:1-1:181\"\u003eLustra LED cu telecomandă KILLIAN este o piesă de iluminat modernă și impunătoare, cu o putere de 74W și un design format din 6 cercuri, finisate într-o combinație de auriu și alb.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:487\" style=\"text-align: left;\"\u003eCele șase cercuri, probabil de dimensiuni diferite sau aranjate într-un mod artistic, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece, caldă sau neutră, și poți ajusta intensitatea luminii datorită funcției de dimare. Combinația de auriu și alb adaugă o notă de eleganță și luminozitate designului. Cu o putere de 74W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte spații ample.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:487\" style=\"text-align: left;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/LTRH-czmw_4\" style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/bvYDYK2aABc\" style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e","published_at":"2025-02-24T18:12:52+02:00","created_at":"2025-02-24T18:12:51+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52417831010571,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT120\/6GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9757767631115,"created_at":"2025-09-27T12:57:02+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51817817997579,"created_at":"2025-02-24T18:12:54+02:00","position":1,"updated_at":"2025-02-24T18:12:56+02:00","product_id":9757767631115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lacerta-telecomanda-200w-auriu-acril-dimabila_LL52AU_01.webp?v=1740413576","width":900,"height":900},{"id":51817817932043,"created_at":"2025-02-24T18:12:54+02:00","position":2,"updated_at":"2025-02-24T18:12:56+02:00","product_id":9757767631115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lacerta-telecomanda-200w-auriu-acril-dimabila_LL52AU_02.webp?v=1740413576","width":900,"height":900},{"id":51817817866507,"created_at":"2025-02-24T18:12:54+02:00","position":3,"updated_at":"2025-02-24T18:12:56+02:00","product_id":9757767631115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lacerta-telecomanda-200w-auriu-acril-dimabila_LL52AU_03.webp?v=1740413576","width":900,"height":900},{"id":51817818030347,"created_at":"2025-02-24T18:12:55+02:00","position":4,"updated_at":"2025-02-24T18:12:56+02:00","product_id":9757767631115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lacerta-telecomanda-200w-auriu-acril-dimabila_LL52AU_04.webp?v=1740413576","width":900,"height":900},{"id":51817817899275,"created_at":"2025-02-24T18:12:55+02:00","position":5,"updated_at":"2025-02-24T18:12:56+02:00","product_id":9757767631115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lacerta-telecomanda-200w-auriu-acril-dimabila_LL52AU_05.webp?v=1740413576","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757236330763,"title":"Lustra LED cu telecomanda ANEMONA 71W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-anemona-75w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:86\"\u003e\u003cstrong\u003eEleganță Modernă și Control Luminos Personalizat: Lustra LED cu Telecomandă ANEMONA \u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:237\"\u003eÎmbracă-ți spațiul cu un rafinament contemporan și o iluminare complet adaptabilă cu lustra LED ANEMONA . Designul său elegant și minimalist, finisat într-o nuanță pură de \u003cstrong\u003ealb\u003c\/strong\u003e, adaugă o notă de stil modern și aerisit oricărei încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:439\"\u003eCu o putere generoasă de \u003cstrong\u003e75W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și amplă, ideală pentru livinguri, dininguri, dormitoare sau birouri moderne. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Deși descrierea nu menționează temperatura culorii, este foarte probabil ca o lustră LED cu telecomandă să ofere posibilitatea de a alege între \u003cstrong\u003elumină rece\u003c\/strong\u003e, \u003cstrong\u003elumină caldă\u003c\/strong\u003e și \u003cstrong\u003elumină neutră\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:184\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminoasă, creând astfel ambientul perfect pentru fiecare moment, de la o lumină strălucitoare la o lumină ambientală subtilă.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:75\"\u003e\n\u003cstrong\u003eDesign Modern și Minimalist:\u003c\/strong\u003e Formă simplă și elegantă cu finisaj alb.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:80\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 75W pentru o iluminare optimă a spațiilor medii și mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:105\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și, probabil, al temperaturii culorii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:112\"\u003e\n\u003cstrong\u003ePosibilă Temperatură Culoare Variabilă:\u003c\/strong\u003e (Verifică specificațiile produsului) Lumină Rece, Caldă și Neutră.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:111\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Acril durabil și metal rezistent cu finisaj alb elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Aerisit:\u003c\/strong\u003e Se integrează perfect în interioarele moderne, scandinave sau minimaliste.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"23:1-29:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:114\"\u003e\n\u003cstrong\u003eControl Total al Luminii:\u003c\/strong\u003e Ajustează intensitatea luminoasă și, probabil, temperatura culorii cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:79\"\u003e\n\u003cstrong\u003eAtmosferă Personalizată:\u003c\/strong\u003e Creează ambientul perfect pentru fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:103\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Designul simplu și finisajul alb adaugă un plus de stil modern și luminos.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:91\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii simplu și confortabil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eIluminare Amplă:\u003c\/strong\u003e Potrivită pentru iluminarea eficientă a diverselor spații.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"30:1-30:219\"\u003eLustra LED cu telecomandă ANEMONA este alegerea ideală pentru a adăuga un plus de stil modern, confort și control inteligent în casa ta. Bucură-te de iluminarea adaptabilă și de designul simplu și elegant în nuanța albă!\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T14:55:23+02:00","created_at":"2025-02-24T14:55:22+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52094290526475,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT125\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"249.99","grams":0,"compare_at_price":"269.99","position":1,"product_id":9757236330763,"created_at":"2025-08-18T15:32:00+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813757288715,"created_at":"2025-02-24T14:55:26+02:00","position":1,"updated_at":"2026-07-07T12:07:09+03:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_04.webp?v=1783415229","width":1024,"height":1024},{"id":51813757255947,"created_at":"2025-02-24T14:55:26+02:00","position":2,"updated_at":"2026-07-07T12:06:12+03:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_03.webp?v=1783415172","width":1024,"height":1024},{"id":62340916379915,"created_at":"2025-11-14T15:16:33+02:00","position":3,"updated_at":"2025-11-14T15:16:59+02:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5aff9104-d5e6-44c3-9515-a59fd173eb6f.png?v=1763126219","width":1600,"height":1600},{"id":51813757157643,"created_at":"2025-02-24T14:55:26+02:00","position":4,"updated_at":"2025-11-14T15:16:59+02:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_01.webp?v=1763126219","width":900,"height":900},{"id":62340930437387,"created_at":"2025-11-14T15:19:08+02:00","position":5,"updated_at":"2026-07-07T11:59:03+03:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/06367f42-9291-489c-aad8-0480564bb647.png?v=1783414743","width":1024,"height":1024},{"id":55047557316875,"created_at":"2025-04-28T17:42:08+03:00","position":6,"updated_at":"2025-11-14T15:19:33+02:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT125_3WH-LustraLEDcuTelecomanda_Sandra_75W_DimabilaAlbl-1.png?v=1763126373","width":1080,"height":1080},{"id":51813756862731,"created_at":"2025-02-24T14:55:26+02:00","position":7,"updated_at":"2026-07-07T12:04:12+03:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_02.webp?v=1783415052","width":1024,"height":1024},{"id":51813757190411,"created_at":"2025-02-24T14:55:26+02:00","position":8,"updated_at":"2025-11-14T15:16:59+02:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_06.webp?v=1763126219","width":900,"height":900},{"id":51813756928267,"created_at":"2025-02-24T14:55:26+02:00","position":9,"updated_at":"2025-11-14T15:19:27+02:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-sandra-80w-dimabila-alb_LL1782AL_05.webp?v=1763126367","width":900,"height":900},{"id":69708431294731,"created_at":"2026-07-07T12:07:56+03:00","position":10,"updated_at":"2026-07-07T12:07:59+03:00","product_id":9757236330763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2722194_big_color.png?v=1783415279","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757333651723,"title":"Lustra LED suspendata DARIN, 120cm, 23W, Inaltime Reglabila, Lumina Rece, Alb","handle":"lustra-led-martina-23w-liniara-lumina-rece-6000k-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:154\"\u003eLustra LED DARIN este o piesă de iluminat modernă și eficientă, cu un design liniar, o putere de 23W și un finisaj alb. Aceasta oferă o lumină rece.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:417\"\u003eForma liniară sugerează o distribuție uniformă a luminii pe o anumită lungime, fiind potrivită pentru deasupra meselor, birourilor sau în alte spații unde se dorește o iluminare funcțională și uniformă. Lumina rece este ideală pentru activități care necesită o percepție clară a culorilor și un confort vizual bun. Finisajul alb îi conferă un aspect elegant, ușor de integrat în diverse decoruri moderne.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T15:48:33+02:00","created_at":"2025-02-24T15:48:32+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED Suspendate","Plafoniere LED"],"variants":[{"id":52398048379147,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL633WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"149.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":9757333651723,"created_at":"2025-09-21T01:08:58+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60159691686155,"created_at":"2025-09-10T16:23:23+03:00","position":1,"updated_at":"2025-09-10T16:23:26+03:00","product_id":9757333651723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_dda83be7-6b60-4879-af21-d9fd54f5bd0c.png?v=1757510606","width":800,"height":800},{"id":60159703318795,"created_at":"2025-09-10T16:24:53+03:00","position":2,"updated_at":"2025-09-10T16:24:57+03:00","product_id":9757333651723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_7db4872f-dcd1-45c0-a509-d6b4d789f6df.png?v=1757510697","width":1500,"height":1500},{"id":62783758106891,"created_at":"2025-11-27T17:17:35+02:00","position":3,"updated_at":"2025-11-27T17:17:38+02:00","product_id":9757333651723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL633WH_PREL.png?v=1764256658","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760442188043,"title":"Lustra LOFT Atelier, 2x E27, Alb Auriu, Metal, Inaltime Reglabila","handle":"lustra-loft-atelier-2x-e27-alb-auriu-metal-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LOFT Atelier, iluminatul se transformă în artă. Această lustră sofisticată aduce un amestec sublim de eleganță și lumină în orice încăpere. Cu un cadru auriu strălucitor și două dulii E27, această lustră este o adevărată operă de artă în sine. Abajurul glob alb subtil emite o lumină moale și primitoare, creând o atmosferă caldă și reconfortantă în camera dvs. Diametrul său compact de 30 de centimetri și înălțimea totală de 130 de centimetri o fac potrivită pentru o varietate de spații interioare, de la sufragerii elegante până la dormitoare rafinate.\u003cbr\u003e\u003cbr\u003eLustra LOFT Atelier dispune de un design tip pendul, adăugând o notă contemporană și chic. Cadru său auriu este atemporal și se potrivește perfect în orice decor interior, aducând un aer de lux și strălucire în fiecare colț al camerei. Cu lustra LOFT Atelier, aveți posibilitatea de a personaliza iluminatul cu becurile E27 preferate, permițându-vă să creați atmosfera perfectă pentru orice ocazie. Instalarea este simplă și rapidă, iar rezultatul este o lustră care atrage toate privirile și conferă o notă inconfundabilă de eleganță spațiului dvs.\u003cbr\u003e\u003cbr\u003eNu lăsați să treacă această ocazie de a transforma iluminatul într-o experiență artistică. Cu lustra LOFT Atelier, lumina devine mai mult decât o necesitate funcțională - devine un element central al designului dvs. interior. Achiziționați-o astăzi și transformați-vă spațiul într-un mediu elegant și luminos.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:31:14+02:00","created_at":"2025-02-25T02:31:14+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre cu bec moderne"],"variants":[{"id":52423010353419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8205\/2GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"149.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9760442188043,"created_at":"2025-09-29T00:56:03+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60762860912907,"created_at":"2025-09-29T00:44:25+03:00","position":1,"updated_at":"2025-09-29T00:44:50+03:00","product_id":9760442188043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a45ec981e327e15be710dc9ed001973f633d49dcb12bae0bffd0f200486782a4.png?v=1759095890","width":1024,"height":1024},{"id":51849331769611,"created_at":"2025-02-25T02:31:17+02:00","position":2,"updated_at":"2025-09-29T00:44:50+03:00","product_id":9760442188043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-julien-2x-e27-alb-auriu-1695979892.webp?v=1759095890","width":900,"height":900},{"id":51849331933451,"created_at":"2025-02-25T02:31:17+02:00","position":3,"updated_at":"2025-09-29T00:44:50+03:00","product_id":9760442188043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-julien-2xe27-alb-auriu_8205-2gd_02-1695979892.webp?v=1759095890","width":900,"height":900},{"id":51849331638539,"created_at":"2025-02-25T02:31:17+02:00","position":4,"updated_at":"2025-09-29T00:44:50+03:00","product_id":9760442188043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-julien-2xe27-alb-auriu_8205-2gd_03-1695979893.webp?v=1759095890","width":900,"height":900},{"id":51849331867915,"created_at":"2025-02-25T02:31:17+02:00","position":5,"updated_at":"2025-09-29T00:44:50+03:00","product_id":9760442188043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-julien-2xe27-alb-auriu_8205-2gd_04-1695979893.webp?v=1759095890","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757700292875,"title":"Lustra Clasica Aramis cu lemn, Abajur Patrat, 4 X Dulie E27, Alb \/ Negru","handle":"lustra-clasica-cu-lemn-abajur-patrat-4-x-dulie-e27-alb-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:284\"\u003eLustra Clasica Aramis nu este doar o sursa de lumina, ci o declaratie de stil, conceputa sa aduca o ambianta sofisticata si un joc vizual memorabil in livingul sau holul tau.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:240\"\u003e\n\u003cstrong\u003eDesign Epurat, Joc de Contraste:\u003c\/strong\u003e Cu o forma geometrica distincta, ce integreaza patru abajururi patrate in nuante atemporale de alb si negru, aceasta lustra creeaza un echilibru vizual dinamic, conferind un aer rafinat si contemporan.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:254\"\u003e\n\u003cstrong\u003eIluminare Abundenta, Atmosfera Definită:\u003c\/strong\u003e Echipata cu patru socluri E27, Lustra Aramis inunda incaperea cu o lumina generoasa si uniforma, ideala pentru a defini si a incalzi atmosfera oricarei camere, de la zonele de socializare la cele de tranzit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:224\"\u003e\n\u003cstrong\u003ePrezenta Impunatoare, Proportii Armonioase:\u003c\/strong\u003e Cu un diametru de 56 cm si o inaltime de 28 cm, se monteaza elegant pe tavan, oferind o acoperire luminoasa extinsa si un punct focal de design fara a coplesi vizual spatiul.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-9:0\"\u003e\n\u003cstrong\u003eVersatilitate Discreta:\u003c\/strong\u003e Desi pastrand un design clasic, liniile sale curate si cromatica neutra ii permit sa se integreze armonios intr-o multitudine de decoruri, de la cele traditionale la cele minimaliste, adaugand intotdeauna o nota de stil si rafinament.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:181\"\u003eAceasta lustra nu doar lumineaza functional, ci modeleaza spatiul cu o prezenta sculptata, transformand fiecare incapere intr-un loc cu stil, personalitate si o lumina inspiratoare.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-02-24T17:48:43+02:00","created_at":"2025-02-24T17:48:42+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","All Stock","Corpuri de Iluminat","Lustre cu Abajur","Lustre cu bec"],"variants":[{"id":52418356543755,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC880\/4","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"239.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":9757700292875,"created_at":"2025-09-27T14:47:01+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51817277423883,"created_at":"2025-02-24T17:48:44+02:00","position":1,"updated_at":"2025-02-24T17:48:46+02:00","product_id":9757700292875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-rustic-4x-e27-alb-negru_S88-4_01.webp?v=1740412126","width":900,"height":900},{"id":51817277391115,"created_at":"2025-02-24T17:48:44+02:00","position":2,"updated_at":"2025-02-24T17:48:46+02:00","product_id":9757700292875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-rustic-4x-e27-alb-negru_S88-4_02.webp?v=1740412126","width":900,"height":900},{"id":51817277489419,"created_at":"2025-02-24T17:48:44+02:00","position":3,"updated_at":"2025-02-24T17:48:46+02:00","product_id":9757700292875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-rustic-4x-e27-alb-negru_S88-4_03.webp?v=1740412126","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757691412747,"title":"Lustra Cala, 1 x E27, Maro cu Alb, Lemn si Sticla","handle":"lustra-cala-1-x-e27-maro-cu-alb-lemn-si-sticla","body_html":"\u003cp data-sourcepos=\"3:1-3:235\"\u003eLustra Cala imbina armonios lemnul cu sticla, creand o piesa de design cu un farmec rustic distinct, perfecta pentru a defini atmosfera in hol, dressing, foisor sau veranda.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-7:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:205\"\u003e\n\u003cstrong\u003eDesign Natural, Lumina Adaptabila:\u003c\/strong\u003e Cu un abajur patrat alb si o structura din lemn maro, ofera o lumina difuza si primitoare, compatibila cu becuri LED sau economice, pentru o ambianta personalizata.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-7:0\"\u003e\n\u003cstrong\u003ePrezenta Discreta, Impact Vizual:\u003c\/strong\u003e Dimensiunile compacte (diametru 21 cm, inaltime 20 cm) o fac ideala pentru integrarea subtila, dar de efect, in diverse interioare, aducand o nota de caracter fara a aglomera spatiul.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"8:1-8:111\"\u003eAceasta lustra nu doar lumineaza, ci infuzeaza fiecare zona cu o senzatie de confort natural si stil atemporal.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-03-06T14:29:17+02:00","created_at":"2025-02-24T17:45:26+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","Corpuri de Iluminat","Lustre Clasice","Lustre cu bec"],"variants":[{"id":52422892126475,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-977\/1H","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9757691412747,"created_at":"2025-09-28T23:53:31+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51817219457291,"created_at":"2025-02-24T17:45:28+02:00","position":1,"updated_at":"2025-02-24T17:45:30+02:00","product_id":9757691412747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-cala-1xe27-maro-alb-lemn-sticla_LC1090_01.webp?v=1740411930","width":900,"height":900},{"id":51817219424523,"created_at":"2025-02-24T17:45:28+02:00","position":2,"updated_at":"2025-02-24T17:45:29+02:00","product_id":9757691412747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-cala-1xe27-maro-alb-lemn-sticla_LC1090_02.webp?v=1740411929","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760571130123,"title":"Plafoniera LED cu Senzor Atlas 18W Alb","handle":"plafoniera-led-cu-senzor-atlas-18w-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003eDescoperiți plafoniera LED cu Senzor Atlas, o soluție de iluminat inovatoare și eficientă pentru casa sau spațiul dvs. de lucru. Cu o putere de 18W și o lumină rece, această plafonieră oferă o iluminare clară și vibrantă, ideală pentru a crea un mediu de lucru energic sau pentru a revitaliza spațiile de trai.\u003cbr\u003e\u003cbr\u003ePlafoniera Atlas, cu diametrul de 29cm și un flux luminos impresionant de 1800lm, asigură o dispersie largă a luminii, acoperind eficient zonele necesare. Designul său alb, curat și simplu, se integrează fără efort în orice stil de decor, oferind un aspect proaspăt și modern.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai remarcabile caracteristici ale Plafonierei Atlas este senzorul integrat, care detectează mișcarea și automatizează procesul de iluminare, crescând eficiența energetică și conveniența în utilizare. Această caracteristică face din plafoniera Atlas o opțiune inteligentă pentru coridoare, băi, bucătării sau alte zone unde iluminatul automat este de dorit.\u003cbr\u003e\u003cbr\u003eInstalarea este rapidă și ușor de realizat, făcând din actualizarea sistemului de iluminat un proces simplu și fără bătăi de cap. Alegeți Plafoniera LED cu Senzor Atlas pentru a beneficia de avantajele iluminatului LED: durabilitate, economie de energie și performanță superioară.\u003cbr\u003e\u003cbr\u003eInvestiți în Plafoniera LED cu Senzor Atlas pentru a aduce în spațiul dvs. o lumină de calitate, care nu numai că va îmbunătăți aspectul, dar și funcționalitatea zilnică, toate acestea cu un impact minim asupra facturii de electricitate. Aceasta este alegerea ideală pentru oricine caută o combinație de design modern, tehnologie inteligentă și eficiență energetică.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:52:52+02:00","created_at":"2025-02-25T02:52:51+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["active","Corpuri de Iluminat","Plafoniere LED"],"variants":[{"id":52409390792971,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-A09R","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9760571130123,"created_at":"2025-09-24T18:14:28+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51851362271499,"created_at":"2025-02-25T02:52:53+02:00","position":1,"updated_at":"2025-02-25T02:52:55+02:00","product_id":9760571130123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-cu-senzor-atlas-18w-alb-1706279036.webp?v=1740444775","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759840993547,"title":"Lustra LED Ruby 40W Alb Negru","handle":"lustra-led-cu-proiector-reglabil-ruby-40w-diametru-60cm-liniara-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:272\"\u003eLustra LED cu Proiector Reglabil RUBY este o piesă de iluminat modernă și funcțională, cu o putere de 40W și un diametru de 60cm. Designul său liniar include un proiector reglabil, totul finisat în negru. Oferă posibilitatea de a alege între lumină rece, caldă sau neutră.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:345\"\u003eForma liniară a lustrei sugerează o distribuție uniformă a luminii principale, în timp ce proiectorul reglabil adaugă un plus de flexibilitate, permițându-ți să direcționezi lumina suplimentară către o anumită zonă sau obiect. Diametrul de 60cm indică o prezență vizuală semnificativă. Finisajul negru îi conferă un aspect industrial sau modern.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:132\"\u003eProiectorul reglabil ar putea fi integrat în structura liniară, oferindu-ți posibilitatea de a accentua anumite elemente din cameră.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:48:37+02:00","created_at":"2025-02-25T00:48:37+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52429421478155,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2055\/600WH+BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9759840993547,"created_at":"2025-09-30T16:15:53+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51838281646347,"created_at":"2025-02-25T00:48:39+02:00","position":1,"updated_at":"2025-02-25T00:48:41+02:00","product_id":9759840993547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ruby-40w-alb-negru_LL1937AL_01.webp?v=1740437321","width":900,"height":900},{"id":51838281711883,"created_at":"2025-02-25T00:48:39+02:00","position":2,"updated_at":"2025-02-25T00:48:41+02:00","product_id":9759840993547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ruby-40w-alb-negru_LL1937AL_02.webp?v=1740437321","width":900,"height":900},{"id":51838281679115,"created_at":"2025-02-25T00:48:39+02:00","position":3,"updated_at":"2025-02-25T00:48:41+02:00","product_id":9759840993547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ruby-40w-alb-negru_LL1937AL_03.webp?v=1740437321","width":900,"height":900},{"id":51838281613579,"created_at":"2025-02-25T00:48:39+02:00","position":4,"updated_at":"2025-02-25T00:48:41+02:00","product_id":9759840993547,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ruby-40w-alb-negru_LL1937AL_04.webp?v=1740437321","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757476618507,"title":"Lustra LED cu telecomanda ALANI 152W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-alani-152w-6-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: center;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%); text-align: center;\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/IAhXr_F9r2U\" style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: center;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cem\u003e    \u003c\/em\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003eModelul corpului de iluminat este creat cu ajutorul a sase cercuri, poziționate în direcții și la înălțimi diferite, care creează un efect asimetric dar totodată plăcut vizual. Fiecare cerc are încorporată o sursă de iluminare creată din bandă LED.\u003c\/span\u003e\u003cbr\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eBenzile LED sunt cunoscute pentru beneficiile financiare pe care le aduc, având în vedere că produsele bazate pe această tehnologie sunt mult mai rezistente și consumă mai putin curent electric, fiind foarte economice.\u003c\/span\u003e\u003cbr\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra Dora are o putere de 152W și este controlată cu ajutorul unei telecomenzi - poți aprinde\/stinge lumina, ajusta intestentitatea acesteia, schimba tonul de culoare după bunul plac dintre Cald, Neutru, Rece.\u003c\/span\u003e\u003cbr\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e \u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:25:54+02:00","created_at":"2025-02-24T16:25:53+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52102937182475,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-8067\/4+2intBK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"229.99","grams":0,"compare_at_price":"229.99","position":1,"product_id":9757476618507,"created_at":"2025-08-21T01:05:39+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51815893762315,"created_at":"2025-02-24T16:25:56+02:00","position":1,"updated_at":"2025-05-16T13:47:32+03:00","product_id":9757476618507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-dora-152w-negru-acril-dimabila_LL179_06.webp?v=1747392452","width":900,"height":900},{"id":51815893664011,"created_at":"2025-02-24T16:25:57+02:00","position":2,"updated_at":"2025-05-16T13:47:32+03:00","product_id":9757476618507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-dora-152w-negru-acril-dimabila_LL179_04.webp?v=1747392452","width":900,"height":900},{"id":51815893860619,"created_at":"2025-02-24T16:25:56+02:00","position":3,"updated_at":"2025-05-16T13:47:30+03:00","product_id":9757476618507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-dora-152w-negru-acril-dimabila_LL179_02.webp?v=1747392450","width":900,"height":900},{"id":51815893795083,"created_at":"2025-02-24T16:25:57+02:00","position":4,"updated_at":"2025-05-16T13:47:30+03:00","product_id":9757476618507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-dora-152w-negru-acril-dimabila_LL179_03.webp?v=1747392450","width":900,"height":900},{"id":51815893729547,"created_at":"2025-02-24T16:25:57+02:00","position":5,"updated_at":"2025-02-24T16:25:59+02:00","product_id":9757476618507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-dora-152w-negru-acril-dimabila_LL179_05.webp?v=1740407159","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760896516363,"title":"Lustra Vera, 1xE27, D17xH20cm,  Auriu, Metal si Cristal","handle":"lustra-vera-1xe27-d18h15cm-auriu-metal-si-cristal","body_html":"\u003cp data-end=\"383\" data-start=\"108\"\u003e\u003cstrong data-end=\"123\" data-start=\"108\"\u003eLustra Vera\u003c\/strong\u003e impresionează printr-un design sofisticat și elegant, fiind alegerea ideală pentru interioare care pun accent pe detalii rafinate. Este dotată cu \u003cstrong data-end=\"304\" data-start=\"270\"\u003e1 sursă de lumină cu soclu E27\u003c\/strong\u003e, oferind flexibilitate în alegerea becului potrivit stilului tău de iluminare.\u003c\/p\u003e\u003cp data-end=\"721\" data-start=\"385\"\u003eFuncționează la \u003cstrong data-end=\"409\" data-start=\"401\"\u003e220V\u003c\/strong\u003e și se montează aplicat pe tavan, fiind potrivită pentru \u003cstrong data-end=\"491\" data-start=\"466\"\u003eliving, hol, dormitor\u003c\/strong\u003e sau orice spațiu în care dorești un accent decorativ luminos. Structura este realizată dintr-o combinație premium de \u003cstrong data-end=\"637\" data-start=\"609\"\u003ecristal, sticlă și metal\u003c\/strong\u003e, cu un finisaj \u003cstrong data-end=\"670\" data-start=\"653\"\u003eauriu elegant\u003c\/strong\u003e, ce adaugă un plus de lux și strălucire încăperii.\u003c\/p\u003e\u003cp data-end=\"969\" data-start=\"723\"\u003eDimensiunile compacte — \u003cstrong data-end=\"783\" data-start=\"747\"\u003e17 cm diametru și 20 cm înălțime\u003c\/strong\u003e — o fac ideală pentru spații mici sau medii, fără a încărca vizual decorul. \u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:45:02+02:00","created_at":"2025-02-25T03:45:02+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","All Stock","Corpuri de Iluminat","Lustre cu Abajur","Lustre cu bec"],"variants":[{"id":52427620974859,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC912GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9760896516363,"created_at":"2025-09-30T09:36:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":63139404873995,"created_at":"2025-12-08T17:39:28+02:00","position":1,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H629aead5bad8456888d8f3ba1c862160c.jpg?v=1765208409","width":750,"height":750},{"id":63139404841227,"created_at":"2025-12-08T17:39:28+02:00","position":2,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb178af2f236f45bcb539394c90fb6ece0.jpg?v=1765208409","width":750,"height":750},{"id":63139404808459,"created_at":"2025-12-08T17:39:28+02:00","position":3,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H2b1775b4391b411faebb7f6e2556d7348.jpg?v=1765208409","width":750,"height":750},{"id":63139404742923,"created_at":"2025-12-08T17:39:28+02:00","position":4,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H7dc1057e9d2d4b779e50f3e921b895f2W.jpg?v=1765208409","width":750,"height":750},{"id":63139404775691,"created_at":"2025-12-08T17:39:28+02:00","position":5,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb352ade6915d46b3a054795e0e6a1ab85.jpg?v=1765208409","width":750,"height":750},{"id":52835955474699,"created_at":"2025-04-02T16:10:57+03:00","position":6,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LC912GD-Lustra_Vera_1_E27_Auriu_Metal_si_Cristal-2.jpg?v=1765208409","width":1080,"height":1080},{"id":63139404677387,"created_at":"2025-12-08T17:39:28+02:00","position":7,"updated_at":"2025-12-08T17:40:09+02:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hc436c9206b1d43f3885da59834040327c.jpg?v=1765208409","width":800,"height":800},{"id":68756084130059,"created_at":"2026-05-07T17:19:07+03:00","position":8,"updated_at":"2026-06-16T17:47:54+03:00","product_id":9760896516363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage7mai2026_17_18_59.png?v=1781621274","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760419086603,"title":"Lustra Forma Cub, STRUKTUR Duo, 2xE27, Negru, Metal","handle":"lustra-forma-cub-struktura-duo-2xe27-negru-metal","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți lustra FORMA CUB, STRUKTUR Duo, exemplu remarcabil de design modern și funcționalitate. Această lustră cu formă pătrată se distinge prin contururile sale clare și finisajul său negru mat, adăugând o notă de sofisticare oricărui interior.  Cu posibilitatea de a integra două becuri E27, STRUKTUR Duo oferă o flexibilitate optimă în alegerea intensității și tipului de lumină, potrivită pentru nevoile dvs. de iluminare. Notați că becurile nu sunt incluse, ceea ce vă oferă ocazia de a selecta cele mai potrivite becuri pentru spațiul dvs. Cu o lungime de 40 cm și o lățime de 17 cm, lustra STRUKTUR Duo este proporționată ideal pentru a se potrivi într-o gamă variată de spații, fie că este vorba de living, dormitor sau hol. \u003cbr\u003e\u003cbr\u003eFinisajul său negru adaugă un strop de eleganță și modernitate, asigurându-se că această lustră va fi un punct de atracție în orice decor. Forma sa pătrată îi conferă un caracter geometric și contemporan. Alegeți lustra Pablo pentru un echilibru perfect între stil și funcționalitate, adăugând un accent modern și sofisticat oricărei încăperi.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:27:49+02:00","created_at":"2025-02-25T02:27:49+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre Clasice","Lustre cu bec","Lustre Moderne"],"variants":[{"id":52427947671819,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8218\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"91.20","grams":0,"compare_at_price":"91.20","position":1,"product_id":9760419086603,"created_at":"2025-09-30T11:26:28+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51848873083147,"created_at":"2025-02-25T02:27:51+02:00","position":1,"updated_at":"2025-02-25T02:27:52+02:00","product_id":9760419086603,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-pablo-2x-e27-negru-1695021690.webp?v=1740443272","width":900,"height":900},{"id":51848872984843,"created_at":"2025-02-25T02:27:51+02:00","position":2,"updated_at":"2025-02-25T02:27:52+02:00","product_id":9760419086603,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-pablo-2xe27-negru_8218-2_02-1694701128.webp?v=1740443272","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757915218187,"title":"Lustra LED cu telecomanda VECTOR VORTEX 96W, 3 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-vector-vortex-96w-3-elemente-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-end=\"184\" data-start=\"124\"\u003e\u003cstrong data-end=\"182\" data-start=\"124\"\u003eDesign Modern și Minimalist pentru un Iluminat Elegant\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-end=\"541\" data-start=\"186\"\u003eLustra LED \u003cstrong data-end=\"214\" data-start=\"197\"\u003eVector Vortex\u003c\/strong\u003e este o piesă de iluminat sofisticată, creată pentru interioare moderne și minimaliste. Cu un design fluid, inspirat de mișcarea unui vortex, această lustră combină forme geometrice dinamice cu un finisaj elegant în negru metalic. Elementele curbate creează un efect vizual deosebit, adăugând un plus de stil oricărui spațiu.\u003c\/p\u003e\n\u003ch3 data-end=\"579\" data-start=\"543\"\u003e\u003cstrong data-end=\"577\" data-start=\"547\"\u003eCaracteristici Principale:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1001\" data-start=\"581\"\u003e✅ \u003cstrong data-end=\"626\" data-start=\"583\"\u003eDesign Inspirat de Geometrie și Mișcare\u003c\/strong\u003e – Forma circulară și liniile fluide evocă un vortex în mișcare, oferind un aspect futurist și rafinat.\u003cbr data-end=\"732\" data-start=\"729\"\u003e✅ \u003cstrong data-end=\"757\" data-start=\"734\"\u003eIluminare Versatilă\u003c\/strong\u003e – Dotată cu tehnologie LED de \u003cstrong data-is-only-node=\"\" data-end=\"795\" data-start=\"788\"\u003e96W\u003c\/strong\u003e, această lustră asigură un iluminat eficient și confortabil, cu trei temperaturi de culoare: \u003cstrong data-end=\"914\" data-start=\"889\"\u003erece, caldă și neutră\u003c\/strong\u003e.\u003cbr data-end=\"918\" data-start=\"915\"\u003e✅ \u003cstrong data-end=\"957\" data-start=\"920\"\u003eControl Inteligent cu Telecomandă\u003c\/strong\u003e – Reglați intensitatea luminii și schimbați\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T19:24:30+02:00","created_at":"2025-02-24T19:24:29+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52427946328331,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2258BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"232.00","grams":0,"compare_at_price":"299.99","position":1,"product_id":9757915218187,"created_at":"2025-09-30T11:25:47+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51818989846795,"created_at":"2025-02-24T19:24:32+02:00","position":1,"updated_at":"2025-02-24T19:24:34+02:00","product_id":9757915218187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-zonia-telecomanda-120w-3000k-4000k-6000k-dimabila-negru_LL442_01.webp?v=1740417874","width":900,"height":900},{"id":51818989781259,"created_at":"2025-02-24T19:24:32+02:00","position":2,"updated_at":"2025-02-24T19:24:34+02:00","product_id":9757915218187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-zonia-telecomanda-120w-3000k-4000k-6000k-dimabila-negru_LL442_02.webp?v=1740417874","width":900,"height":900},{"id":51818989715723,"created_at":"2025-02-24T19:24:32+02:00","position":3,"updated_at":"2025-02-24T19:24:34+02:00","product_id":9757915218187,"v