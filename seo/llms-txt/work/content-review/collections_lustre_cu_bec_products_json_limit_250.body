7658035467,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8127\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9760640499979,"created_at":"2025-09-30T09:56:37+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852418089227,"created_at":"2025-02-25T03:01:43+02:00","position":1,"updated_at":"2025-02-25T03:01:45+02:00","product_id":9760640499979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ema-3xe27-maro-metal-lemn_LC1011_01.webp?v=1740445305","width":900,"height":900},{"id":51852418842891,"created_at":"2025-02-25T03:01:43+02:00","position":2,"updated_at":"2025-02-25T03:01:45+02:00","product_id":9760640499979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-ema-3xe27-maro-metal-lemn_LC1011_02.webp?v=1740445305","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760258621707,"title":"Panou LED Incastrat 48W Lumina Rece Alb","handle":"panou-led-incastrat-48w-lumina-rece-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003ePanoul LED încastrat cu forma dreptunghiulară este o alegere excelentă pentru a oferi un iluminat puternic și eficient în diverse încăperi. Cu o putere de 48W și culoarea albă, acest panou LED încastrat oferă o lumină rece, perfectă pentru a asigura o vedere clară și precisă în spațiul dvs.\u003cbr\u003e \u003cbr\u003e Dimensiunile sale de 120cm lungime, 30cm lățime și 3cm înălțime îl fac ideal pentru a fi montat în tavan sau pe perete, asigurând un iluminat bine distribuit și estetic în încăpere.\u003cbr\u003e \u003cbr\u003e Cu un flux luminos de 3840lm, acest panou LED încastrat furnizează o iluminare puternică, fiind potrivit pentru activitățile de zi cu zi, cum ar fi cititul, lucratul la birou sau alte activități care necesită o vedere precisă.\u003cbr\u003e \u003cbr\u003e Lumina rece oferită de acest panou LED încastrat creează o atmosferă energetică și luminoasă, fiind ideală pentru spațiile de lucru sau pentru zonele în care aveți nevoie de o iluminare strălucitoare și stimulatoare.\u003cbr\u003e \u003cbr\u003e Designul său minimalist și ordonat îl face să se integreze cu ușurință în diferite stiluri de interior, aducând un aspect modern și estetic în locuința sau în spațiul comercial.\u003cbr\u003e \u003cbr\u003e Panoul LED încastrat cu puterea de 48W și fluxul luminos de 3840lm, împreună cu lumina rece pe care o oferă, reprezintă o alegere excelentă pentru a beneficia de un iluminat puternic și eficient în diferite încăperi. Indiferent dacă este utilizat în birou, bucătărie sau alte spații, acest panou LED va asigura un mediu ambiental stimulativ și bine luminat, îmbunătățind productivitatea și confortul în fiecare zi.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:02:57+02:00","created_at":"2025-02-25T02:02:56+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Spin Comexim","product_type":"","tags":["active","Corpuri de Iluminat","Delistat Alessandro","Plafoniere LED"],"variants":[{"id":52360528167179,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-SP1N-HT2L-SPN7489","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"89.99","grams":0,"compare_at_price":"131.38","position":1,"product_id":9760258621707,"created_at":"2025-09-12T16:20:28+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51845946540299,"created_at":"2025-02-25T02:02:58+02:00","position":1,"updated_at":"2025-02-25T02:03:00+02:00","product_id":9760258621707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-lumina-rece-alb-1690801250.webp?v=1740441780","width":900,"height":900},{"id":51845946867979,"created_at":"2025-02-25T02:02:58+02:00","position":2,"updated_at":"2025-02-25T02:03:00+02:00","product_id":9760258621707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-alb_spn7489_02-1690801250.webp?v=1740441780","width":900,"height":900},{"id":51845983895819,"created_at":"2025-02-25T02:03:10+02:00","position":3,"updated_at":"2025-02-25T02:03:12+02:00","product_id":9760258621707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-lumina-rece-alb-1690801970.webp?v=1740441792","width":900,"height":900},{"id":51845984092427,"created_at":"2025-02-25T02:03:11+02:00","position":4,"updated_at":"2025-02-25T02:03:12+02:00","product_id":9760258621707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/panou-led-incastrat-48w-alb_spn7473_02-1690801971.webp?v=1740441792","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759560204555,"title":"Lustra Forma Diamant, STRUKTUR, 6x E27, Negru, Metal","handle":"lustra-forma-diamant-geo-cluster-6x-e27-negru-metal","body_html":"\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003e\u003cstrong\u003e'Este atat de usor sa controlezi atmosfera'\u003c\/strong\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size:16px\"\u003e\u003cem\u003eDeși conceptul de pendul are origini antice, corpurile de iluminat de acest tip și-au început povestea odată cu amploarea luată de designul industrial în anii 1930 - 1940. Moderne, fascinante prin modul în care lumina lor coboară din tavan și umple de energie întreaga încăpere de la nivelul privirii, pendulele vor intensifica atmosfera plăcută din casa ta.\u003c\/em\u003e\u003cbr\u003e \u003cbr\u003ePendulul, cunoscute și ca lampă suspendată, poate să aducă un plus de valoare vizuală în spații precum bucătăria, living-ul, dormitorul, holul înalt ș.a. Pendulele sunt alese pentru iluminarea proiectată pe o anumită zonă a încăperii - spre exemplu, vei obține un efect superb dacă amplasezi pendulul deasupra mesei sau a insulei de bucătărie. La fel poți proceda și cu un obiect decorativ special sau cu un tablou: va fi pus în evidență de lumina concentrată deasupra acestuia.\u003cbr\u003e\u003cbr\u003ePendulele sunt corpuri de iluminat cu unul sau mai multe becuri, suspendate printr-un cablu flexibil sau tija rigidă dar reglabilă, astfel încat poți regla ușor înalțimea dorită.\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-size: 14.000001px; font-family: Poppins, sans-serif; text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003eUtilizând pendulele în planurile tale de design interior vei crea cu ajutorul lor zone de lumină, vei putea delimita sau pune un accent pe anumite suprafețe sau zone ale spațiului interior. Un pendul deasupra mesei va crea mici oaze de calm și relaxare, unde vei putea să savurezi o cină în tihnă cu cei dragi, să lucrezi sau să citești.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:05:46+02:00","created_at":"2025-02-25T00:05:45+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52409352945931,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-6630\/6","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9759560204555,"created_at":"2025-09-24T17:53:13+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51834047070475,"created_at":"2025-02-25T00:05:47+02:00","position":1,"updated_at":"2025-02-25T00:05:49+02:00","product_id":9759560204555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-arfan-6x-e27-metal-negru_PDL2217N_01.webp?v=1740434749","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759377752331,"title":"Lustra LED cu telecomanda si cristal MEILI ZAFINA RGB 238W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-zafina-rgb-238w-6-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:299\"\u003eLustra LED cu telecomandă și cristale ZAFINA RGB este o piesă de iluminat impresionantă și spectaculoasă, cu un design format din șase cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere mare de 238W, oferă o iluminare amplă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:481\"\u003eCele șase cercuri negre, decorate cu cristale, creează un aspect opulent și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:328\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 238W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte încăperi ample unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:39:58+02:00","created_at":"2025-02-24T23:39:58+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365376520459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19373\/4+2BK+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"432.00","grams":0,"compare_at_price":"559.99","position":1,"product_id":9759377752331,"created_at":"2025-09-13T13:36:10+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832365973771,"created_at":"2025-02-24T23:40:00+02:00","position":1,"updated_at":"2025-02-24T23:40:01+02:00","product_id":9759377752331,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sumayya-telecomanda-238w-negru-rgb_1744_01.webp?v=1740433201","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758377771275,"title":"Lustra LED cu telecomanda FARYDA 120W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-faryda-120w-3-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp\u003e\u003cspan style=\"font-size: 0.875rem;\"\u003eLustra LED cu telecomandă FARYDA este o piesă de iluminat modernă și puternică, cu un design format din 3 pătrate stilizate, finisate în negru. Cu o putere de 120W, oferă o iluminare amplă și versatilă pentru diverse spații.\u003c\/span\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:477\"\u003eCele trei pătrate, dispuse probabil într-o manieră care creează un ansamblu vizual echilibrat și contemporan, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:253\"\u003eFinisajul negru al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de eleganță și sofisticare încăperii. Cu o putere de 120W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte spații de dimensiuni considerabile.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:28:50+02:00","created_at":"2025-02-24T21:28:49+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52047718973707,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-6042\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9758377771275,"created_at":"2025-08-07T09:27:36+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51821175865611,"created_at":"2025-02-24T21:28:52+02:00","position":1,"updated_at":"2025-02-24T21:28:54+02:00","product_id":9758377771275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-faryda-telecomanda-120w-acril-metal-negru_LL1690_01.webp?v=1740425334","width":900,"height":900},{"id":51821175963915,"created_at":"2025-02-24T21:28:52+02:00","position":2,"updated_at":"2025-02-24T21:28:54+02:00","product_id":9758377771275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-faryda-telecomanda-120w-acril-metal-negru_LL1690_02.webp?v=1740425334","width":900,"height":900},{"id":51821175898379,"created_at":"2025-02-24T21:28:52+02:00","position":3,"updated_at":"2025-02-24T21:28:54+02:00","product_id":9758377771275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-faryda-telecomanda-120w-acril-metal-negru_LL1690_03.webp?v=1740425334","width":900,"height":900},{"id":51821176029451,"created_at":"2025-02-24T21:28:52+02:00","position":4,"updated_at":"2025-02-24T21:28:54+02:00","product_id":9758377771275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-faryda-telecomanda-120w-acril-metal-negru_LL1690_04.webp?v=1740425334","width":900,"height":900},{"id":51821175931147,"created_at":"2025-02-24T21:28:52+02:00","position":5,"updated_at":"2025-02-24T21:28:54+02:00","product_id":9758377771275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-faryda-telecomanda-120w-acril-metal-negru_LL1690_05.webp?v=1740425334","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10888540586251,"title":"Plafoniera LED PL200\/12P 19W Lumina Rece 6000k Alb","handle":"plafoniera-ledpl200-12p-18w-lumina-rece-6000k-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003ePlafoniera LED PL200\/12P reprezintă soluția perfectă pentru iluminarea eficientă și modernă a oricărui spațiu. Cu un dimensiuni de 12x12 cm și un flux luminos impresionant de 1520 de lumeni, această plafonieră oferă o iluminare puternică, chiar și în cele mai mici încăperi.\u003cbr\u003e\u003cbr\u003eDesignul său compact și aspectul alb pur fac din PL200\/12P un element discret și versatil, potrivit pentru orice amenajare interioară. Indiferent dacă o amplasați în bucătărie, baie sau hol, această plafonieră se va integra armonios în decorul dvs. Cu o putere de 19W și lumina sa rece, plafoniera PL200\/12P oferă un mediu luminos și revigorant, perfect pentru zonele unde concentrarea este esențială. Lumina sa rece este potrivită și pentru iluminarea eficientă a spațiilor de lucru.\u003cbr\u003e\u003cbr\u003eEficiența energetică este o caracteristică notabilă a acestei plafoniere. Datorită tehnologiei LED, consumă mai puțină energie, economisindu-vă bani și contribuind la reducerea amprentei de carbon. Instalarea și montarea acestei plafoniere sunt simple și accesibile, permițându-vă să beneficiați rapid de iluminarea sa puternică și eficientă.\u003cbr\u003e\u003cbr\u003ePlafoniera LED PL200\/12P este alegerea perfectă pentru cei care doresc să aducă o lumină puternică și modernă în orice încăpere. Cu un design compact, eficiență energetică și lumina sa rece și revigorantă, PL200\/12P este soluția ideală pentru orice spațiu.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-02-25T21:31:34+02:00","created_at":"2026-02-19T17:34:23+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["active","Corpuri de Iluminat","Plafoniere LED"],"variants":[{"id":52911531557131,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-PL200\/12P","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"15.79","grams":0,"compare_at_price":"18.99","position":1,"product_id":10888540586251,"created_at":"2026-02-19T17:34:24+02:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":66039336927499,"created_at":"2026-02-19T17:36:05+02:00","position":1,"updated_at":"2026-08-19T10:10:23+03:00","product_id":10888540586251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_de_Tavan_Patrata_36W_22x22cm_Lumina_Rece_6000K_Alb_5.jpg?v=1787123423","width":600,"height":600},{"id":66039337877771,"created_at":"2026-02-19T17:36:19+02:00","position":2,"updated_at":"2026-08-19T10:10:32+03:00","product_id":10888540586251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_de_Tavan_Patrata_36W_22x22cm_Lumina_Rece_6000K_Alb_6.png?v=1787123432","width":1024,"height":1024},{"id":68430390296843,"created_at":"2026-04-22T16:30:46+03:00","position":3,"updated_at":"2026-04-22T16:30:48+03:00","product_id":10888540586251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2700459_big_color.svg?v=1776864648","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10223844688139,"title":"Lustra LED suspendata cu telecomanda NIVALIS 55W, Lungime 120cm, lumina Rece\/Calda\/Neutra, Dimabila,Inaltime Reglabila, Auriu","handle":"lustra-led-suspendata-cu-telecomanda-nivalis-55w-lungime-120cm-lumina-rece-calda-neutra-dimabila-inaltime-reglabila-auriu","body_html":"\u003cp data-end=\"411\" data-start=\"96\"\u003e\u003cstrong data-end=\"118\" data-start=\"96\"\u003eLustra LED NIVALIS\u003c\/strong\u003e impresionează prin designul său liniar, cu accente florale subtile, și o lungime generoasă de \u003cstrong data-end=\"223\" data-start=\"213\"\u003e120 cm\u003c\/strong\u003e, fiind ideală pentru \u003cstrong data-end=\"303\" data-start=\"245\"\u003ezona de dining, birou, living sau bucătării open-space\u003c\/strong\u003e. Silueta elegantă și discretă o transformă într-un element decorativ modern, fără a încărca vizual spațiul.\u003c\/p\u003e\u003cp data-end=\"691\" data-start=\"413\"\u003eCu o putere de \u003cstrong data-end=\"435\" data-start=\"428\"\u003e55W\u003c\/strong\u003e și un flux luminos de \u003cstrong data-end=\"473\" data-start=\"458\"\u003e4400lumeni\u003c\/strong\u003e, NIVALIS oferă o iluminare puternică, constantă și uniformă pe întreaga lungime. Este echipată cu tehnologie LED performantă, cu autonomie de \u003cstrong data-end=\"630\" data-start=\"616\"\u003e25.000 ore\u003c\/strong\u003e, asigurând eficiență energetică și durată de viață ridicată.\u003c\/p\u003e\u003cp data-end=\"905\" data-start=\"693\"\u003eTemperatura de culoare poate fi ajustată în \u003cstrong data-end=\"749\" data-start=\"737\"\u003e3 trepte\u003c\/strong\u003e –\u003cbr data-end=\"754\" data-start=\"751\"\u003e• \u003cstrong data-end=\"773\" data-start=\"756\"\u003e3000K (caldă)\u003c\/strong\u003e – pentru seri relaxante\u003cbr data-end=\"800\" data-start=\"797\"\u003e• \u003cstrong data-end=\"820\" data-start=\"802\"\u003e4000K (neutră)\u003c\/strong\u003e – pentru utilizare generală\u003cbr data-end=\"851\" data-start=\"848\"\u003e• \u003cstrong data-is-only-node=\"\" data-end=\"869\" data-start=\"853\"\u003e6000K (rece)\u003c\/strong\u003e – pentru claritate și concentrare\u003c\/p\u003e\u003cp data-end=\"1082\" data-start=\"907\"\u003eÎn plus, intensitatea luminii este \u003cstrong data-end=\"955\" data-start=\"942\"\u003edimabilă\u003c\/strong\u003e, atât din \u003cstrong data-end=\"989\" data-start=\"966\"\u003etelecomanda inclusă\u003c\/strong\u003e, cât și din \u003cstrong data-end=\"1027\" data-start=\"1002\"\u003eîntrerupătorul clasic\u003c\/strong\u003e, oferind control total asupra atmosferei din încăpere.\u003c\/p\u003e\u003cp data-end=\"1204\" data-start=\"1084\"\u003eDesignul suspendat, cu \u003cstrong data-end=\"1129\" data-start=\"1107\"\u003eînălțime reglabilă\u003c\/strong\u003e, permite integrarea perfectă în diferite tipuri de spații și configurații.\u003c\/p\u003e\u003chr data-end=\"1209\" data-start=\"1206\"\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1407\" data-start=\"1211\"\u003e\u003cstrong data-is-last-node=\"\" data-end=\"1407\" data-start=\"1211\"\u003eNIVALIS este alegerea ideală pentru cei care caută o lustra LED funcțională, elegantă și complet ajustabilă — un echilibru perfect între performanță, estetică și control inteligent al luminii.\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:28:01+03:00","created_at":"2025-06-06T15:42:47+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52429943669003,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT361\/120GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10223844688139,"created_at":"2025-09-30T17:57:43+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":63178268049675,"created_at":"2025-12-09T11:06:34+02:00","position":1,"updated_at":"2026-07-07T09:56:44+03:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_a316dbf2-a693-4b65-88c2-200b327b4f19.png?v=1783407404","width":1024,"height":1024},{"id":63178268377355,"created_at":"2025-12-09T11:06:35+02:00","position":2,"updated_at":"2026-07-07T09:58:01+03:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_edcf8a81-7739-4590-a7e0-f873ecc69f66.png?v=1783407481","width":1024,"height":1024},{"id":69707922931979,"created_at":"2026-07-07T09:55:37+03:00","position":3,"updated_at":"2026-07-07T09:59:06+03:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_9986fcd7-f277-4b45-b6d3-95d3c1815146.png?v=1783407546","width":1024,"height":1024},{"id":63178268344587,"created_at":"2025-12-09T11:06:35+02:00","position":4,"updated_at":"2025-12-09T11:08:46+02:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_8028f1bc-0c5c-415e-a832-eb9c215a3c10.png?v=1765271326","width":1600,"height":1600},{"id":69707922964747,"created_at":"2026-07-07T09:55:38+03:00","position":5,"updated_at":"2026-07-07T10:00:51+03:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_f15c0786-05a4-4a3c-850f-4bc6625bca2c.png?v=1783407651","width":1024,"height":1024},{"id":62528502825227,"created_at":"2025-11-20T16:29:22+02:00","position":6,"updated_at":"2025-12-09T11:08:46+02:00","product_id":10223844688139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT361_120GD_EPREL_1be36e2e-9726-4756-8581-75ef91e43082.png?v=1765271326","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779348930827,"title":"Lustră Suspendată LED Acril Nova 57W cu Telecomandă, Dimabilă, 3000K\/4000K\/6000K, Auriu, Metal și Acril","handle":"lustra-suspendata-led-acril-nova-57w-cu-telecomanda-dimabila-3000k-4000k-6000k-auriu-metal-si-acril","body_html":"\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Banner_ee040305-3363-43a3-b812-fe41a3ff6953.png?v=1775001912\" alt=\"\"\u003eLustra suspendată LED Nova, realizată din metal auriu și acril, îmbină eleganța modernă cu funcționalitatea avansată. Designul său rafinat oferă un efect decorativ spectaculos, fiind ideal pentru livinguri, zone de dining sau spații cu decor contemporan. Este echipată cu telecomandă pentru reglarea intensității luminii și schimbarea temperaturii de culoare între 3000K, 4000K și 6000K, adaptând ambianța după preferințe. Sursele LED integrate asigură iluminare uniformă, eficiență energetică și durată lungă de viață.\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e","published_at":"2025-09-08T14:46:53+03:00","created_at":"2025-03-06T18:46:07+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Lustre LED"],"variants":[{"id":52428511740171,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT921GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"639.99","position":1,"product_id":9779348930827,"created_at":"2025-09-30T14:07:46+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":67948227035403,"created_at":"2026-04-01T03:05:07+03:00","position":1,"updated_at":"2026-04-01T03:05:13+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.Cover.png?v=1775001913","width":3999,"height":3999},{"id":67948227264779,"created_at":"2026-04-01T03:05:07+03:00","position":2,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.Detail1.png?v=1775002132","width":3999,"height":3999},{"id":67948227068171,"created_at":"2026-04-01T03:05:07+03:00","position":3,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2.RemoteShow.png?v=1775002132","width":3999,"height":3999},{"id":67948227100939,"created_at":"2026-04-01T03:05:07+03:00","position":4,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3.SteplessDiming.png?v=1775002132","width":3999,"height":3999},{"id":67948227133707,"created_at":"2026-04-01T03:05:07+03:00","position":5,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/4.3-ToneControl.png?v=1775002132","width":3999,"height":3999},{"id":67948227166475,"created_at":"2026-04-01T03:05:07+03:00","position":6,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5.NightLight.png?v=1775002132","width":3999,"height":3999},{"id":67948227199243,"created_at":"2026-04-01T03:05:07+03:00","position":7,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6.Size.png?v=1775002132","width":3999,"height":3999},{"id":67948227232011,"created_at":"2026-04-01T03:05:07+03:00","position":8,"updated_at":"2026-04-01T03:08:52+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.Specifications.png?v=1775002132","width":3999,"height":3999},{"id":67948227297547,"created_at":"2026-04-01T03:05:07+03:00","position":9,"updated_at":"2026-04-01T03:05:14+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11.Place1.png?v=1775001914","width":3999,"height":3999},{"id":67948227330315,"created_at":"2026-04-01T03:05:07+03:00","position":10,"updated_at":"2026-04-01T03:05:14+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.Place2.png?v=1775001914","width":3999,"height":3999},{"id":67948227363083,"created_at":"2026-04-01T03:05:07+03:00","position":11,"updated_at":"2026-04-01T03:05:14+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.Place3.png?v=1775001914","width":3999,"height":3999},{"id":67948227395851,"created_at":"2026-04-01T03:05:07+03:00","position":12,"updated_at":"2026-04-01T03:05:14+03:00","product_id":9779348930827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.Place4.png?v=1775001914","width":3999,"height":3999}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10980236853515,"title":"Lustra LED HALESA Magno cu telecomanda si cristal, 66W, 5 Surse, Lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-halesa-magno-cu-telecomanda-si-cristal-66w-5-surse-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp data-sourcepos=\"5:1-5:294\"\u003eTransformă-ți spațiul într-un spectacol de lumină și culoare cu \u003cstrong\u003elustra LED HALESA Eleganza\u003c\/strong\u003e. Designul său contemporan, cu elemente liniare elegante în finisaj \u003cstrong\u003eauriu\u003c\/strong\u003e, este completat de o putere impresionantă de \u003cstrong\u003e44W\u003c\/strong\u003e, oferind o iluminare amplă și eficientă pentru încăperi mari.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:199\"\u003eDatorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Funcția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii pentru a crea ambientul perfect pentru orice ocazie.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:252\"\u003ePersonalizează iluminatul în funcție de starea ta de spirit, eveniment sau preferințe, de la tonuri calde și relaxante la culori vibrante și energizante.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:78\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Elemente liniare în finisaj auriu.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:75\"\u003e\n\u003cstrong\u003ePutere Impresionantă:\u003c\/strong\u003e 44W pentru o iluminare amplă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și al culorilor\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:92\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj auriu elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Dinamic:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cstrong\u003eLustra LED cu telecomandă HALESA Eleganza\u003c\/strong\u003e este alegerea ideală pentru a adăuga un plus de stil, confort și culoare în spațiile mari. Bucură-te de iluminarea puternică și adaptabilă, completată de spectrul vibrant al culorilor sale.\u003c\/p\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2026-06-17T10:45:31+03:00","created_at":"2026-06-15T15:08:52+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":53183610683659,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT773\/5GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"269.99","grams":0,"compare_at_price":"269.99","position":1,"product_id":10980236853515,"created_at":"2026-06-15T15:08:53+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69504854098187,"created_at":"2026-06-15T15:20:52+03:00","position":1,"updated_at":"2026-06-15T15:22:14+03:00","product_id":10980236853515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_15_20_35.png?v=1781526134","width":1024,"height":1024},{"id":69504854196491,"created_at":"2026-06-15T15:20:54+03:00","position":2,"updated_at":"2026-06-15T15:23:23+03:00","product_id":10980236853515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_15_20_35_c3be753d-48d2-4313-9e01-9d03fc3f89fa.png?v=1781526203","width":1024,"height":1024},{"id":69504854262027,"created_at":"2026-06-15T15:20:56+03:00","position":3,"updated_at":"2026-06-15T15:27:23+03:00","product_id":10980236853515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_15_20_35_0ea546d1-0ee6-4bc9-bcbd-7abc48758ad0.png?v=1781526443","width":1024,"height":1024},{"id":69504854393099,"created_at":"2026-06-15T15:20:58+03:00","position":4,"updated_at":"2026-06-15T15:21:02+03:00","product_id":10980236853515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_15_20_35_56423fea-5c02-489e-b9f3-6c8ac5a1fa08.png?v=1781526062","width":1254,"height":1254},{"id":69504888865035,"created_at":"2026-06-15T15:30:41+03:00","position":5,"updated_at":"2026-06-15T15:30:46+03:00","product_id":10980236853515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_15_20_43.png?v=1781526646","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10727334609163,"title":"Lustra LED cu Telecomanda LINEX, 83W, Lumina 3000K\/4000K\/6000K, Dimabila, Auriu","handle":"lustra-led-cu-telecomanda-lt171-4gd-81w-lumina-3000k-4000k-6000k-dimabila-auriu","body_html":"\u003cp data-end=\"380\" data-start=\"97\"\u003e\u003cstrong data-end=\"121\" data-start=\"97\"\u003eLustra LED LINEX\u003c\/strong\u003e aduce împreună eleganța finisajului \u003cstrong data-end=\"167\" data-start=\"158\"\u003eauriu\u003c\/strong\u003e și performanța tehnologiei LED moderne. Cu \u003cstrong\u003e6\u003c\/strong\u003e\u003cstrong data-end=\"236\" data-start=\"211\"\u003e elemente decorative\u003c\/strong\u003e dispuse armonios și un LED integrat de \u003cstrong data-end=\"283\" data-start=\"276\"\u003e83W\u003c\/strong\u003e, oferă o iluminare puternică, uniformă și extrem de eficientă pentru diverse tipuri de încăperi.\u003c\/p\u003e\u003cp data-end=\"380\" data-start=\"97\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"745\" data-start=\"382\"\u003eTelecomanda inclusă îți oferă control complet asupra luminii:\u003c\/p\u003e\u003cp data-end=\"745\" data-start=\"382\"\u003e• \u003cstrong data-end=\"472\" data-start=\"448\"\u003e3000K – lumină caldă\u003c\/strong\u003e, ideală pentru relaxare\u003cbr data-end=\"499\" data-start=\"496\"\u003e• \u003cstrong data-end=\"526\" data-start=\"501\"\u003e4000K – lumină neutră\u003c\/strong\u003e, perfectă pentru activități zilnice\u003cbr data-end=\"565\" data-start=\"562\"\u003e• \u003cstrong data-is-only-node=\"\" data-end=\"590\" data-start=\"567\"\u003e6000K – lumină rece\u003c\/strong\u003e, potrivită pentru claritate și productivitate\u003c\/p\u003e\u003cp data-end=\"745\" data-start=\"382\"\u003e\u003cbr data-end=\"639\" data-start=\"636\"\u003eÎn plus, funcția \u003cstrong data-end=\"669\" data-start=\"656\"\u003edimmabilă\u003c\/strong\u003e îți permite să reglezi intensitatea luminii în funcție de atmosfera dorită.\u003c\/p\u003e\u003cp data-end=\"745\" data-start=\"382\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1040\" data-start=\"747\"\u003eRealizată din \u003cstrong data-end=\"779\" data-start=\"761\"\u003emetal și acril\u003c\/strong\u003e, lustra îmbină rezistența cu un aspect estetic premium. Finisajul auriu pune în valoare liniile moderne ale celor patru elemente luminoase, transformând-o într-un accent decorativ elegant pentru \u003cstrong data-end=\"1039\" data-start=\"975\"\u003eliving, dining, dormitor, birou sau orice spațiu contemporan\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-end=\"1040\" data-start=\"747\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1280\" data-start=\"1042\"\u003e\u003cstrong data-end=\"1061\" data-start=\"1042\"\u003eCaracteristici:\u003c\/strong\u003e\u003cbr data-end=\"1064\" data-start=\"1061\"\u003e✔ Putere: \u003cstrong data-end=\"1094\" data-start=\"1074\"\u003e83W LED integrat\u003c\/strong\u003e\u003cbr data-end=\"1097\" data-start=\"1094\"\u003e✔ Temperatură culoare: \u003cstrong data-end=\"1145\" data-start=\"1120\"\u003e3000K \/ 4000K \/ 6000K\u003c\/strong\u003e\u003cbr data-end=\"1148\" data-start=\"1145\"\u003e✔ Funcții: \u003cstrong data-end=\"1203\" data-start=\"1159\"\u003eDimmare + control total prin telecomandă\u003c\/strong\u003e\u003cbr data-end=\"1206\" data-start=\"1203\"\u003e✔ Design modern cu \u003cstrong\u003e6\u003c\/strong\u003e\u003cstrong data-end=\"1245\" data-start=\"1225\"\u003e elemente aurii\u003c\/strong\u003e\u003cbr data-end=\"1248\" data-start=\"1245\"\u003e✔ Materiale: \u003cstrong data-end=\"1278\" data-start=\"1261\"\u003eMetal + Acril\u003c\/strong\u003e\u003c\/p\u003e\u003chr data-end=\"1285\" data-start=\"1282\"\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1485\" data-start=\"1287\"\u003e\u003cstrong data-is-last-node=\"\" data-end=\"1485\" data-start=\"1287\"\u003eLINEX este alegerea perfectă pentru cei care își doresc un corp de iluminat puternic, elegant, ușor de controlat și eficient energetic – toate într-un design modern cu adevărat impresionant.\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-09-24T01:54:28+03:00","created_at":"2025-09-18T15:30:32+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"