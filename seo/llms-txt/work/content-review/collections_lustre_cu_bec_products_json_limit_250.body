\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_48W_8_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_9.png?v=1784883177","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10178278523147,"title":"Lustra LED cu telecomanda ZOE, 8 Patrate, 138W, Lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-zoe-138w-8-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cp\u003eLustra LED cu telecomandă \u003cstrong\u003eZOE\u003c\/strong\u003e, în varianta impunătoare cu 8 pătrate și finisaj negru, este o soluție de iluminat modernă și puternică, ideală pentru a adăuga un impact vizual semnificativ în spațiile mari. Cu o putere de \u003cstrong\u003e138W\u003c\/strong\u003e, asigură o iluminare generoasă și adaptabilă.\u003c\/p\u003e\n\u003cp\u003eCele \u003cstrong\u003eopt pătrate\u003c\/strong\u003e, dispuse probabil într-o configurație care creează un design dinamic și echilibrat, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, ai control total asupra atmosferei: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\n\u003cp\u003eFinisajul negru al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de eleganță și sofisticare încăperii. Dimensiunea cu 8 pătrate sugerează o prezență semnificativă, perfectă pentru livinguri mari, sufragerii sau chiar spații comerciale moderne.\u003c\/p\u003e\n\u003cp\u003eCu o putere de \u003cstrong\u003e138W\u003c\/strong\u003e, această lustră este capabilă să ilumineze eficient chiar și încăperi de dimensiuni considerabile.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003ch3 style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/h3\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-06-11T13:25:40+03:00","created_at":"2025-05-14T13:59:32+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52416087458059,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT808\/8BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":10178278523147,"created_at":"2025-09-26T18:09:38+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":55420574826763,"created_at":"2025-05-14T14:27:09+03:00","position":1,"updated_at":"2026-06-17T13:58:11+03:00","product_id":10178278523147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT223WH-LustraLEDcutelecomandaELIZA_65W_1Patrate_luminaReceCaldaNeutra_Dimabila_Alb-1-2.png?v=1781693891","width":1024,"height":1024},{"id":55420003287307,"created_at":"2025-05-14T14:05:06+03:00","position":2,"updated_at":"2026-06-17T