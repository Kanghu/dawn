4,"height":1024},{"id":69702980469003,"created_at":"2026-07-06T15:26:06+03:00","position":5,"updated_at":"2026-07-06T15:27:08+03:00","product_id":9756897083659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT660_5WH-LustraLEDcutelecomandaLOTUS74W_5Petale_luminaRece_Calda_Neutra_Dimabila_Alb-3_1_7903c3a8-96a6-4f5a-b8d4-f24567fb96c7.png?v=1783340828","width":1024,"height":1024},{"id":69702964936971,"created_at":"2026-07-06T15:23:43+03:00","position":6,"updated_at":"2026-07-06T15:24:53+03:00","product_id":9756897083659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT660_5WH-LustraLEDcutelecomandaLOTUS74W_5Petale_luminaRece_Calda_Neutra_Dimabila_Alb-3_1_d23fe239-4730-4e98-961f-0ff04e987a3c.png?v=1783340693","width":1024,"height":1024},{"id":51811041116427,"created_at":"2025-02-24T12:56:30+02:00","position":7,"updated_at":"2025-11-25T17:27:14+02:00","product_id":9756897083659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-cressida-110w-dimabila-alb_LL50AL_02.webp?v=1764084434","width":900,"height":900},{"id":69702889668875,"created_at":"2026-07-06T15:10:22+03:00","position":8,"updated_at":"2026-07-06T15:10:25+03:00","product_id":9756897083659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2522278_big_color.png?v=1783339825","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758090592523,"title":"Plafoniera LED Cotena , 48W, Alb, IP.44, Patrata","handle":"plafoniera-led-cotena-48w-alb-ip-44-patrata","body_html":"\u003cstrong\u003e\u003cspan style=\"font-size:16px\"\u003e'​\u003cem\u003eEste atât de ușor să controlezi atmosfera.'\u003c\/em\u003e\u003c\/span\u003e\u003c\/strong\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196px; padding-right: 10px; padding-left: 10px; color: rgb(102, 102, 102); font-family: Poppins, sans-serif; font-size: 14px; text-align: justify;\"\u003e \u003cdiv style=\"box-sizing: inherit;\"\u003e\u003cspan style=\"font-size:16px\"\u003e​Un moment-cheie în procesul decorării unei încăperi este cel în care alegi aplica potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea aplicei perfecte.\u003cbr\u003e\u003cbr\u003eCu aplicele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar aplice LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T20:28:19+02:00","created_at":"2025-02-24T20:28:18+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["active","Corpuri de Iluminat","Plafoniere LED"],"variants":[{"id":52038325567755,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-APL48P","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"69.99","grams":0,"compare_at_price":"69.99","position":1,"product_id":9758090592523,"created_at":"2025-08-05T15:25:45+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":55964640313611,"created_at":"2025-05-30T19:52:52+03:00","position":1,"updated_at":"2025-05-30T19:52:55+03:00","product_id":9758090592523,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-cotena--48w-alb-ip20-patrata_944_01.jpg?v=1748623975","width":1800,"height":1800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757479633163,"title":"Lustra LED ERIKA 27W, 2 Patrate, lumina Neutra, Alb","handle":"lustra-led-dhara-11w-4000k-alb-acril-ip-20","body_html":"\u003cdiv style=\"text-align: left;\"\u003e\u003cp style=\"font-size: 16px;\"\u003eAvând în vedere că lumina este cea care aduce la viață întreaga încăpere, este esențial să alegem un corp de iluminat plăcut din punct de vedere estetic și funcțional, pentru a ne asigura confortul dorit indiferent de circumstanțe.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"containerimg-mobile\" style=\"text-align: left;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\" style=\"text-align: left;\"\u003e\u003cp style=\"text-align: left;\"\u003eCu o putere de 11W și o durată de viață de 25.000 de ore, Lustra LED ERIKA este potrivită pentru camere mici, cum ar fi holurile sau dressingurile, oferind un flux luminos de 880lm. Este proiectată să asigure un iluminat uniform și confortabil.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"containerimg-mobile\" style=\"text-align: left;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\" style=\"text-align: left;\"\u003e\u003cp style=\"text-align: left;\"\u003eDesignul său geometric modern permite integrarea cu succes în diferite spații din locuință, adăugând o notă de modernitate și stil întregului decor.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp style=\"font-size: 16px; text-align: left;\"\u003eTehnologia LED de înaltă calitate asigură o eficiență energetică excelentă, LED-urile fiind de 10 ori mai eficiente decât becurile clasice. Cu o autonomie de 25.000 de ore, Lustra LED Dhara este concepută să reziste în timp, oferind un iluminat constant și de încredere.\u003c\/p\u003e\n\u003cp style=\"font-size: 16px; text-align: center;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:27:24+02:00","created_at":"2025-02-24T16:27:23+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52429870661899,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL801\/2WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"69.99","grams":0,"compare_at_price":"69.99","position":1,"product_id":9757479633163,"created_at":"2025-09-30T17:45:43+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70026031137035,"created_at":"2026-09-02T10:33:58+03:00","position":1,"updated_at":"2026-09-02T10:34:56+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_1.png?v=1788334496","width":950,"height":950},{"id":69556418674955,"created_at":"2026-06-18T16:02:43+03:00","position":2,"updated_at":"2026-07-24T12:44:10+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_5.png?v=1784886250","width":1254,"height":1254},{"id":69556419395851,"created_at":"2026-06-18T16:03:04+03:00","position":3,"updated_at":"2026-07-24T12:44:21+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_6.png?v=1784886261","width":1254,"height":1254},{"id":69556407009547,"created_at":"2026-06-18T15:57:50+03:00","position":4,"updated_at":"2026-07-24T12:43:23+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_1.webp?v=1784886203","width":1024,"height":1024},{"id":51815929479435,"created_at":"2025-02-24T16:27:25+02:00","position":5,"updated_at":"2026-07-24T12:43:34+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_2.webp?v=1784886214","width":1024,"height":1024},{"id":51815929610507,"created_at":"2025-02-24T16:27:25+02:00","position":6,"updated_at":"2026-07-24T12:43:49+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_27W_2_Patrate_lumina_Neutra_Alb_3.webp?v=1784886229","width":1024,"height":1024},{"id":70026087989515,"created_at":"2026-09-02T10:42:00+03:00","position":7,"updated_at":"2026-09-02T10:42:02+03:00","product_id":9757479633163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2695851_big_color.png?v=1788334922","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756921364747,"title":"Lustra LED SAGEATA 48W, Diametru 20cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-sageata-48w-diametru-20cm-lumina-rece-calda-neutra-alb","body_html":"\u003cstyle\u003e@import url('https:\/\/fonts.googleapis.com\/css2?family=Roboto:wght@400;700\u0026display=swap');body {    font-family: 'Roboto', sans-serif;}.containerimg-mobile,.containerimg {    text-align: center;    margin-left: auto;    margin-right: auto;}.img2 {    width: 100%;}p.paragraf-descrieri {    font-size: 135%;    text-align: justify;    width: 80%;    margin-left: auto;    margin-right: auto;}\u003c\/style\u003e\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp style=\"text-align: left;\" data-sourcepos=\"1:1-1:269\"\u003eLustra LED Săgeată este o piesă de iluminat modernă și compactă, cu o putere de 48W și un diametru de 20cm. Designul său alb oferă o estetică simplă și versatilă, iar posibilitatea de a alege între lumină rece, caldă sau neutră o face adaptabilă diferitelor preferințe.\u003c\/p\u003e\n\u003cp style=\"text-align: left;\" data-sourcepos=\"3:1-3:363\"\u003eNumele 'Săgeată' sugerează că designul ar putea include elemente care amintesc de forma unei săgeți. Cu un diametru de 20cm, dimensiunea este potrivită pentru spații mai mici sau pentru a fi utilizată în grupuri. Puterea de 48W ar trebui să ofere o lumină suficientă pentru aceste zone. Finisajul alb îi conferă un aspect curat și ușor de integrat în orice decor.\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv class=\"containerimg\"\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T13:09:45+02:00","created_at":"2025-02-24T13:09:44+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52105297690891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19148","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"99.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":9756921364747,"created_at":"2025-08-21T14:05:12+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51811357131019,"created_at":"2025-02-24T13:09:47+02:00","position":1,"updated_at":"2025-11-24T16:26:19+02:00","product_id":9756921364747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sageata-48w-3000-4000-6000k-alb_LL1631_01.webp?v=1763994379","width":774,"height":774},{"id":51811357393163,"created_at":"2025-02-24T13:09:47+02:00","position":2,"updated_at":"2025-02-24T13:09:49+02:00","product_id":9756921364747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sageata-48w-3000-4000-6000k-alb_LL1631_02.webp?v=1740395389","width":900,"height":900},{"id":51811357524235,"created_at":"2025-02-24T13:09:47+02:00","position":3,"updated_at":"2025-02-24T13:09:49+02:00","product_id":9756921364747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sageata-48w-3000-4000-6000k-alb_LL1631_03.webp?v=1740395389","width":900,"height":900},{"id":51811357196555,"created_at":"2025-02-24T13:09:47+02:00","position":4,"updated_at":"2025-02-24T13:09:49+02:00","product_id":9756921364747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sageata-48w-3000-4000-6000k-alb_LL1631_04.webp?v=1740395389","width":900,"height":900},{"id":51811357163787,"created_at":"2025-02-24T13:09:47+02:00","position":5,"updated_at":"2025-02-24T13:09:49+02:00","product_id":9756921364747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sageata-48w-3000-4000-6000k-alb_LL1631_05.webp?v=1740395389","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757881008395,"title":"Lustra LED cu telecomanda ELLA 120W, 6 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Metal si Acril","handle":"lustra-led-cu-telecomanda-ella-120w-6-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:57\"\u003e\u003cstrong\u003eUn Joc de Forme și Lumină Inteligent: Lustra LED ELLA\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:279\"\u003eTransformă-ți spațiul într-o galerie de lumină modernă cu lustra LED ELLA. Designul său îndrăzneț, compus din \u003cstrong\u003eșase pătrate interconectate\u003c\/strong\u003e într-o dispunere dinamică, finisate într-un \u003cstrong\u003enegru\u003c\/strong\u003e elegant și profund, devine un punct focal artistic și sofisticat în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:279\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:265\"\u003eCu o putere impresionantă de \u003cstrong\u003e120W\u003c\/strong\u003e, lustra ELLA nu este doar un element de design, ci și o sursă de lumină puternică și eficientă. Experimentează cu paleta de lumină perfectă pentru fiecare moment, alegând dintre cele \u003cstrong\u003etrei temperaturi de culoare\u003c\/strong\u003e disponibile:\u003c\/p\u003e\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:77\"\u003e\n\u003cstrong\u003eAlb rece:\u003c\/strong\u003e Energizant și ideal pentru activități care necesită precizie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:85\"\u003e\n\u003cstrong\u003eAlb cald:\u003c\/strong\u003e Primitor și relaxant, perfect pentru a crea o atmosferă confortabilă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eAlb neutru:\u003c\/strong\u003e Echilibrat și potrivit pentru iluminatul general.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"13:1-13:269\"\u003e\u003cstrong\u003eControlul intuitiv prin telecomandă\u003c\/strong\u003e îți oferă libertatea de a modela lumina după starea ta de spirit. Ajustează intensitatea cu funcția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, transformând o lumină vibrantă într-o strălucire ambientală subtilă, totul fără a părăsi confortul canapelei tale.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:65\"\u003e\u003cstrong\u003eELLA: Unde designul geometric întâlnește inteligența luminii.\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:65\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"17:1-17:29\"\u003e\u003cstrong\u003eCaracteristici Esențiale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"19:1-25:0\"\u003e\n\u003cli data-sourcepos=\"19:1-19:92\"\u003e\n\u003cstrong\u003eSculptură Luminoasă Modernă:\u003c\/strong\u003e Șase pătrate negre interconectate într-un design dinamic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:70\"\u003e\n\u003cstrong\u003ePutere Generoasă (120W):\u003c\/strong\u003e Iluminare eficientă pentru spații mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-21:86\"\u003e\n\u003cstrong\u003eSpectru de Lumină Personalizabil:\u003c\/strong\u003e Alb rece, cald și neutru, pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"22:1-22:76\"\u003e\n\u003cstrong\u003eControl Total (Dimmabilă):\u003c\/strong\u003e Ajustează intensitatea luminii cu ușurință.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:74\"\u003e\n\u003cstrong\u003eConfort Inteligent (Telecomandă):\u003c\/strong\u003e Gestionează lumina de la distanță.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-25:0\"\u003e\n\u003cstrong\u003eImpact Vizual Puternic:\u003c\/strong\u003e O piesă de design care atrage privirile.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"26:1-26:24\"\u003e\u003cstrong\u003eBeneficii Resimțite:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"28:1-33:0\"\u003e\n\u003cli data-sourcepos=\"28:1-28:98\"\u003e\n\u003cstrong\u003eTransformă Atmosfera:\u003c\/strong\u003e Adaptează lumina perfect pentru fiecare activitate și stare de spirit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-29:78\"\u003e\n\u003cstrong\u003eEleganță Contemporană:\u003c\/strong\u003e Designul geometric adaugă un plus de stil modern.\u003c\/li\u003e\n\u003cli data-sourcepos=\"30:1-30:71\"\u003e\n\u003cstrong\u003eControl Fără Efort:\u003c\/strong\u003e Telecomanda face ajustările rapide și comode.\u003c\/li\u003e\n\u003cli data-sourcepos=\"31:1-31:80\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e Te bucuri de lumină puternică cu un consum optimizat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"32:1-33:0\"\u003e\n\u003cstrong\u003ePunct Focal Artistic:\u003c\/strong\u003e Lustra devine o declarație de stil în locuința ta.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"34:1-34:178\"\u003eLustra LED cu telecomandă ELLA nu este doar un corp de iluminat, ci o expresie a designului modern și a controlului inteligent, creând un ambient unic și personalizat în casa ta.\u003c\/p\u003e\u003cp data-sourcepos=\"34:1-34:178\"\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:58:21+02:00","created_at":"2025-02-24T18:58:20+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428428706059,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT130\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9757881008395,"created_at":"2025-09-30T13:56:21+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69876290978059,"created_at":"2026-08-04T23:32:43+03:00","position":1,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":69876290912523,"created_at":"2026-08-04T23:32:43+03:00","position":2,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":69876291141899,"created_at":"2026-08-04T23:32:43+03:00","position":3,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":69876291010827,"created_at":"2026-08-04T23:32:43+03:00","position":4,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":69876291109131,"created_at":"2026-08-04T23:32:43+03:00","position":5,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":69876291043595,"created_at":"2026-08-04T23:32:43+03:00","position":6,"updated_at":"2026-08-04T23:32:47+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LT130-6BK.webp?v=1785875567","width":1254,"height":1254},{"id":69876290945291,"created_at":"2026-08-04T23:32:43+03:00","position":7,"updated_at":"2026-08-04T23:32:47+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LT130-6BK.webp?v=1785875567","width":1254,"height":1254},{"id":69876291076363,"created_at":"2026-08-04T23:32:43+03:00","position":8,"updated_at":"2026-08-04T23:32:46+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LT130-6BK.webp?v=1785875566","width":1254,"height":1254},{"id":70005129543947,"created_at":"2026-08-27T16:04:53+03:00","position":9,"updated_at":"2026-08-27T16:04:55+03:00","product_id":9757881008395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2538034_big_color.png?v=1787835895","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759841583371,"title":"Lustra LED cu telecomanda ELLA 187W, 8 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-ella-187w-8-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:78\"\u003e\u003cstrong\u003eEleganță Geometrică și Iluminare Versatilă: Lustra LED cu Telecomandă Ella\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:426\"\u003eAdu un strop de modernitate sofisticată și o lumină adaptabilă în locuința ta cu Lustra LED Ella. Designul său unic, compus din \u003cstrong\u003e8 pătrate luminoase\u003c\/strong\u003e dispuse într-o manieră artistică și dinamică, creează un efect vizual captivant și contemporan, transformând tavanul într-un element de design remarcabil. Finisajul \u003cstrong\u003ealb\u003c\/strong\u003e elegant îi conferă un aspect curat și luminos, integrându-se armonios în diverse stiluri de interior.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:426\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:344\"\u003eCu o putere totală de \u003cstrong\u003e187W\u003c\/strong\u003e, această lustră LED oferă o iluminare amplă și uniformă, perfectă pentru livinguri mari, open space-uri sau săli de dining moderne. Bucură-te de flexibilitatea \u003cstrong\u003etrei tipuri de lumină\u003c\/strong\u003e integrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:344\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:379\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e, controlată cu ușurință prin \u003cstrong\u003etelecomanda inclusă\u003c\/strong\u003e, îți oferă posibilitatea de a ajusta intensitatea luminoasă în funcție de preferințe, de la o lumină ambientală relaxantă la o iluminare puternică și clară. Telecomanda îți oferă control complet asupra luminii, permițându-ți să reglezi atât intensitatea, cât și temperatura de culoare, fără a te deplasa.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:379\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:91\"\u003e\n\u003cstrong\u003eDesign Geometric Modern și Artistic:\u003c\/strong\u003e Compusă din 8 pătrate luminoase dispuse dinamic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:81\"\u003e\n\u003cstrong\u003eIluminare Puternică și Uniformă:\u003c\/strong\u003e 187W pentru o lumină amplă în spații mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:92\"\u003e\n\u003cstrong\u003eTemperatură Culoare Variabilă:\u003c\/strong\u003e Lumină rece, caldă și neutră, adaptabilă nevoilor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:73\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control total asupra intensității și temperaturii de culoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:73\"\u003e\n\u003cstrong\u003eMaterial Durabil:\u003c\/strong\u003e Structură robustă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare moderne, minimaliste sau contemporane.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"23:1-28:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:94\"\u003e\n\u003cstrong\u003eCreează un Punct Focal Modern și Impresionant:\u003c\/strong\u003e Designul său unic atrage toate privirile.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:113\"\u003e\n\u003cstrong\u003eOferă o Iluminare Extrem de Versatilă:\u003c\/strong\u003e Adaptează temperatura și intensitatea luminoasă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:97\"\u003e\n\u003cstrong\u003eControl Total și Confortabil:\u003c\/strong\u003e Telecomanda intuitivă face reglarea luminii simplă și rapidă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-28:0\"\u003e\n\u003cstrong\u003eAdaugă un Plus de Lumină și Stil:\u003c\/strong\u003e Designul său contemporan îmbogățește decorul.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"29:1-29:213\"\u003eLustra LED cu Telecomandă Ella este alegerea ideală pentru a adăuga un element de design modern, o iluminare puternică și flexibilă în casa ta. Bucură-te de o atmosferă personalizată cu o simplă atingere de buton!\u003c\/p\u003e\u003cp data-sourcepos=\"29:1-29:213\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:49:23+02:00","created_at":"2025-02-25T