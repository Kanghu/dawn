":1024,"height":1024},{"id":69361560682763,"created_at":"2026-06-08T16:12:47+03:00","position":4,"updated_at":"2026-06-08T16:21:17+03:00","product_id":10975108890891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL733_fdb85ac4-ee11-4c4c-8e67-41da09d832ab.png?v=1780924877","width":1024,"height":1024},{"id":69361603510539,"created_at":"2026-06-08T16:22:43+03:00","position":5,"updated_at":"2026-06-08T16:22:47+03:00","product_id":10975108890891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iun.2026_16_17_42.png?v=1780924967","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10967198007563,"title":"Lustra LED si cristal ORBIT, 72cm, 5xE27, Globuri, Negru","handle":"lustra-led-si-cristal-orbit-72cm-5xe27-globuri-negru","body_html":"\u003cp\u003eTransformă orice încăpere într-un spațiu elegant și rafinat cu lustra ORBIT, un corp de iluminat modern ce îmbină armonios finisajul auriu premium cu globurile opaline și designul curbat minimalist. Ideală pentru living, dining, dormitor sau hol, această lustră oferă un accent decorativ sofisticat și o lumină plăcută, perfectă pentru interioare contemporane.\u003c\/p\u003e\u003cp\u003eDesignul său fluid, inspirat de orbitele cosmice, creează un efect vizual elegant și aerisit, în timp ce combinația dintre metalul auriu și globurile albe adaugă un plus de lux și căldură ambientului.\u003c\/p\u003e\u003ch2\u003eCaracteristici principale\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eDesign modern și elegant cu finisaj auriu\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e5 globuri opaline pentru iluminare uniformă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eCompatibilă cu becuri E27\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003ePotrivită pentru living, dormitor, dining sau birou\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eConstrucție premium din metal și sticlă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eMontaj pe tavan\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch2\u003eSpecificații tehnice\u003c\/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eModel: ORBIT\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTip produs: Lustra LED decorativă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDiametru: 72 cm\u003cbr\u003e\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eSoclu: 5 x E27\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eMaterial: Metal + sticlă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eCuloare: Negru\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTip globuri: Opal \/ alb mat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eAlimentare: 220-230V\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eStil: Modern \/ Luxury \/ Minimalist\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eLustra ORBIT este alegerea perfectă pentru cei care doresc un corp de iluminat statement, cu design modern și accente luxoase.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:229\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2026-07-21T15:12:59+03:00","created_at":"2026-05-27T15:54:11+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat"],"variants":[{"id":53137193107723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC6007\/5BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"279.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":10967198007563,"created_at":"2026-05-27T15:54:12