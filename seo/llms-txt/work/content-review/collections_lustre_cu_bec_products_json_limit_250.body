roduct_id":9757797056779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-330w-negru-dimabila-rgb_CC711_03.webp?v=1768835779","width":900,"height":900},{"id":51818000679179,"created_at":"2025-02-24T18:24:01+02:00","position":6,"updated_at":"2026-01-19T17:16:19+02:00","product_id":9757797056779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-330w-negru-dimabila-rgb_CC711_04.webp?v=1768835779","width":900,"height":900},{"id":51818000744715,"created_at":"2025-02-24T18:24:01+02:00","position":7,"updated_at":"2026-01-19T17:16:19+02:00","product_id":9757797056779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-330w-negru-dimabila-rgb_CC711_05.webp?v=1768835779","width":900,"height":900},{"id":51818000843019,"created_at":"2025-02-24T18:24:01+02:00","position":8,"updated_at":"2026-01-19T17:16:19+02:00","product_id":9757797056779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-330w-negru-dimabila-rgb_CC711_06.webp?v=1768835779","width":900,"height":900},{"id":62880838648075,"created_at":"2025-11-30T13:58:59+02:00","position":9,"updated_at":"2026-01-19T17:16:19+02:00","product_id":9757797056779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT076_6BK_PREL.png?v=1768835779","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756919890187,"title":"Lustra LED cu telecomanda LOTUS 91W, 9 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lotus-91w-9-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:59\"\u003e\u003cstrong\u003eLustra LED LOTUS: O Floare de Lumină pentru Tavanul Tău\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:210\"\u003eÎmbrățișează serenitatea și eleganța naturii cu Lustra LED LOTUS. Asemenea unei flori de lotus stilizate, cele \u003cstrong\u003e9 petale albe\u003c\/strong\u003e iradiază o lumină blândă și uniformă, transformând tavanul într-o oază de lumină.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:210\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:389\"\u003eCu o putere de \u003cstrong\u003e91W \u003c\/strong\u003eși tehnologie LED, această lustră oferă o iluminare versatilă, de la tonuri \u003cstrong\u003ereci\u003c\/strong\u003e energizante la nuanțe \u003cstrong\u003ecalde\u003c\/strong\u003e relaxante, și o lumină \u003cstrong\u003eneutră\u003c\/strong\u003e echilibrată. Prin intermediul \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, poți regla intensitatea luminoasă (funcție \u003cstrong\u003edimmabilă\u003c\/strong\u003e) și temperatura culorii cu o simplă atingere, creând astfel atmosfera perfectă pentru fiecare moment.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:389\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:160\"\u003eDesignul său delicat, realizat din acril de înaltă calitate, adaugă un plus de rafinament oricărui interior, de la dormitoare liniștite la livinguri primitoare.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:160\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:13\"\u003e\u003cstrong\u003ePe scurt:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-18:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:53\"\u003e\n\u003cstrong\u003eDesign Floral Elegant:\u003c\/strong\u003e 9 petale albe stilizate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:57\"\u003e\n\u003cstrong\u003eIluminare Adaptabilă:\u003c\/strong\u003e Lumină rece, caldă și neutră.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eControl Total:\u003c\/strong\u003e Telecomandă pentru intensitate (dimmabilă) și temperatură culoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:57\"\u003e\n\u003cstrong\u003eEficiență LED:\u003c\/strong\u003e Consum redus, durată lungă de viață.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-18:0\"\u003e\n\u003cstrong\u003eStil Universal:\u003c\/strong\u003e Se potrivește în diverse interioare.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"19:1-19:56\"\u003eLustra LED LOTUS: Lasă lumina să înflorească în casa ta!\u003c\/p\u003e\u003cp data-sourcepos=\"19:1-19:56\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-05-15T15:27:38+03:00","created_at":"2025-02-24T13:08:33+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429654393099,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT660\/9WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"375.99","grams":0,"compare_at_price":"375.99","position":1,"product_id":9756919890187,"created_at":"2025-09-30T16:55:38+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70026846667019,"created_at":"2026-09-02T13:05:15+03:00","position":1,"updated_at":"2026-09-02T13:08:42+03:00","product_id":9756919890187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_LOTUS_9