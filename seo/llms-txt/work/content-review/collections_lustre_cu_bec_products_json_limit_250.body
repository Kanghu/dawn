\/files\/14.PLACE3_1de7641d-c1c2-4ff6-9c1c-cf4d543238ee.png?v=1778458068","width":1000,"height":1000},{"id":68820867711243,"created_at":"2026-05-11T03:07:43+03:00","position":11,"updated_at":"2026-05-11T03:07:48+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.COVER_77770b12-76fb-4443-99c3-24afc1fd8299.png?v=1778458068","width":1000,"height":1000},{"id":68820867514635,"created_at":"2026-05-11T03:07:43+03:00","position":12,"updated_at":"2026-05-11T03:07:47+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_02679570-1007-4014-b7b9-afa06b45e165.png?v=1778458067","width":1000,"height":1000},{"id":70052280500491,"created_at":"2026-09-04T11:19:23+03:00","position":13,"updated_at":"2026-09-04T11:19:25+03:00","product_id":9758378852619,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2538026_big_color.png?v=1788509965","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760617496843,"title":"Lustra LED cu telecomanda RIGA LILITH, 68W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-riga-lilith-68w-3-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"chat-history-scroll-container\" id=\"chat-history\"\u003e\u003cdiv id=\"d54b0437869e4f9b\" class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\"\u003e\u003cdiv class=\"response-container ng-tns-c3043829428-66 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3043829428-66\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3043829428-66\"\u003e\u003cdiv class=\"response-content ng-tns-c3043829428-66\"\u003e\u003cdiv dir=\"ltr\" id=\"model-response-message-contentr_d54b0437869e4f9b\" class=\"markdown markdown-main-panel stronger\"\u003e\n\u003cp data-sourcepos=\"3:1-3:76\"\u003e\u003cstrong\u003eEleganță Modernă și Iluminare Dinamică: Lustra LED cu Telecomandă\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:280\"\u003eAdu un strop de rafinament contemporan și o lumină adaptabilă în casa ta cu Lustra LED Lilith. Designul său unic, compus din \u003cstrong\u003ecercuri interconectate\u003c\/strong\u003e cu un finisaj \u003cstrong\u003enegru\u003c\/strong\u003e elegant, creează un efect vizual captivant și modern, transformând tavanul într-un punct focal artistic.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:394\"\u003eCu o putere totală de \u003cstrong\u003e68W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și uniformă, perfectă pentru livinguri, dormitoare sau birouri moderne. Funcția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, controlată cu ușurință de \u003cstrong\u003etelecomanda inclusă\u003c\/strong\u003e, îți permite să ajustezi intensitatea luminoasă în funcție de starea ta de spirit sau de activitate, de la o lumină ambientală relaxantă la o iluminare puternică și clară.\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:239\"\u003eTelecomanda îți oferă control complet asupra luminii, permițându-ți să reglezi intensitatea fără a te ridica. Designul cu cercuri interconectate nu doar arată spectaculos, dar asigură și o distribuție optimă a luminii în întreaga încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-19:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:77\"\u003e\n\u003cstrong\u003eDesign Modern și Unic:\u003c\/strong\u003e Cercuri interconectate cu finisaj negru elegant.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:69\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e 68W pentru o lumină uniformă și puternică.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:73\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:67\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:73\"\u003e\n\u003cstrong\u003eMaterial Durabil:\u003c\/strong\u003e Structură robustă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-19:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare moderne, minimaliste sau industriale.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"20:1-20:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"22:1-27:0\"\u003e\n\u003cli data-sourcepos=\"22:1-22:78\"\u003e\n\u003cstrong\u003eCreează un Punct Focal Modern:\u003c\/strong\u003e Designul său unic atrage toate privirile.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:89\"\u003e\n\u003cstrong\u003eOferă o Iluminare Adaptabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:82\"\u003e\n\u003cstrong\u003eControl Facil:\u003c\/strong\u003e Telecomanda intuitivă face reglarea luminii simplă și rapidă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-27:0\"\u003e\n\u003cstrong\u003eAdaugă un Plus de Stil:\u003c\/strong\u003e Designul său contemporan îmbogățește decorul.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"28:1-28:204\"\u003eLustra LED cu Telecomandă Lilith este alegerea ideală pentru a adăuga un element de design modern și o iluminare flexibilă în casa ta. Bucură-te de o atmosferă personalizată cu o simplă atingere de buton!\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003cdiv class=\"input-area-container ng-star-inserted\"\u003e\u003cdiv class=\"input-area ng-tns-c157395579-2 with-toolbox-drawer\" data-node-type=\"input-area\"\u003e\u003cdiv class=\"text-input-field ng-tns-c157395579-2 with-toolbox-drawer height-expanded-past-single-line\"\u003e\u003cdiv class=\"leading-actions-wrapper ng-tns-c157395579-2 ng-star-inserted\"\u003e\u003cdiv class=\"toolbox-drawer-container ng-tns-c549618185-11 ng-trigger ng-trigger-toolboxDrawerEnter\"\u003e\u003cdiv class=\"toolbox-drawer-button-label label\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:58:33+02:00","created_at":"2025-02-25T02:58:32+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52423841644811,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT511\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"199.99","grams":0,"compare_at_price":"299.99","position":1,