.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LC825GD.webp?v=1785518848","width":1254,"height":1254},{"id":69858030190859,"created_at":"2026-07-31T20:27:24+03:00","position":10,"updated_at":"2026-07-31T20:27:28+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LC825GD.webp?v=1785518848","width":1254,"height":1254},{"id":69858030223627,"created_at":"2026-07-31T20:27:24+03:00","position":11,"updated_at":"2026-07-31T20:27:27+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/011_11_LC825GD.webp?v=1785518847","width":1536,"height":1024},{"id":69858030256395,"created_at":"2026-07-31T20:27:24+03:00","position":12,"updated_at":"2026-07-31T20:27:27+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/012_12_LC825GD.webp?v=1785518847","width":1254,"height":1254},{"id":69858030289163,"created_at":"2026-07-31T20:27:24+03:00","position":13,"updated_at":"2026-07-31T20:27:28+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/013_13_LC825GD.webp?v=1785518848","width":1024,"height":1536},{"id":69858030321931,"created_at":"2026-07-31T20:27:24+03:00","position":14,"updated_at":"2026-07-31T20:27:27+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/014_14_LC825GD.webp?v=1785518847","width":1254,"height":1254},{"id":69858030354699,"created_at":"2026-07-31T20:27:24+03:00","position":15,"updated_at":"2026-07-31T20:27:28+03:00","product_id":10152477557003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/015_15_LC825GD.webp?v=1785518848","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757240852747,"title":"Lustra Jade, 3xE27, Alb cu Maro, Metal si Sticla","handle":"lustra-jade-3-e27-alb-cu-maro-metal-si-sticla","body_html":"\u003cdiv\u003e\n\u003cspan style=\"font-size:16px\"\u003e\u003cem\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte\u003c\/em\u003e\u003cspan style=\"color:rgb(50, 51, 56)\"\u003e.\u003cbr\u003e\u003cbr\u003eAceastă lustră este realizată din materiale de înaltă calitate și vă veți putea bucura de lumina sa un timp îndelungat!\u003c\/span\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e","published_at":"2025-02-24T14:58:21+02:00","created_at":"2025-02-24T14:58:20+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Clasice","tags":["active","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu Abajur","Lustre cu bec"],"variants":[{"id":52416849903883,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-977\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757240852747,"created_at":"2025-09-27T01:09:04+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813804802315,"created_at":"2025-02-24T14:58:22+02:00","position":1,"updated_at":"2025-02-24T14:58:24+02:00","product_id":9757240852747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-jade-3xe27-alb-maro-metal-sticla_LC2416AL_01.webp?v=1740401904","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760635093259,"title":"Lustra LED MIMA 30W, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-mima-30w-lumina-rece-calda-neutra-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003eLustra LED MIMA este o opțiune excelentă pentru cei care doresc să adauge un accent modern și eficient în designul interior al holurilor sau altor spații mici. Cu un design împletit unic și un finisaj alb elegant, această lustră de 30W este ideală pentru a crea o atmosferă primitoare și stilată în orice locuință.\u003cbr\u003e\u003cbr\u003eCu un diametru de 35 cm și o înălțime de doar 10 cm, Lustra MIMA se potrivește perfect în spații cu dimensiuni reduse, oferind o iluminare suficientă fără a ocupa mult spațiu. Aspectul său simplu, dar sofisticat, face ca această lustră să fie o alegere populară pentru holuri, aducând un echilibru între funcționalitate și design interior.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai atractive aspecte ale Lustrei MIMA este capacitatea de a schimba între trei tipuri de lumină - caldă, rece și neutru. Această caracteristică versatilă vă permite să ajustați iluminarea în funcție de momentul zilei sau de starea de spirit, creând un ambient adaptabil și confortabil.\u003cbr\u003e\u003cbr\u003eDesignul împletit al lustrei adaugă un element artistic și modern, transformând-o într-un punct focal interesant și atractiv în orice hol. Finisajul alb contribuie la un look curat și luminos, potrivindu-se ușor cu diverse scheme de culori și stiluri de decor.\u003cbr\u003e\u003cbr\u003eInstalarea Lustrei LED MIMA este simplă și ușor de realizat, oferind o soluție rapidă și eficientă pentru actualizarea iluminatului în casa dvs. Alegerea Lustrei LED MIMA\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003e va permite să adăugați un element de design contemporan și o iluminare de calitate în holurile dvs., combinând estetica atrăgătoare cu funcționalitatea avansată. Este soluția perfectă pentru a crea un spațiu primitor și pentru a adăuga un strop de eleganță modernă în locuința dvs.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:01:03+02:00","created_at":"2025-02-25T03:01:02+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52409391415563,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-B0221WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"136.00","grams":0,"compare_at_price":"139.99","position":1,"product_id":9760635093259,"created_at":"2025-09-24T18:14:43+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852329582859,"created_at":"2025-02-25T03:01:04+02:00","position":1,"updated_at":"2025-02-25T03:01:05+02:00","product_id":9760635093259,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-mohamed-30w-alb-1705392686.webp?v=1740445265","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759394824459,"title":"Lustra LED cu telecomanda si cristal MEILI ZAFINA RGB 136W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-zafina-rgb-136w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:289\"\u003eLustra LED cu telecomandă și cristale ZAFINA RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 136W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:484\"\u003eCele patru cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:317\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 136W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:42:24+02:00","created_at":"2025-02-24T23:42:23+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365376749835,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19373\/2+2BK+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9759394824459,"created_at":"2025-09-13T13:36:17+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832456642827,"created_at":"2025-02-24T23:42:25+02:00","position":1,"updated_at":"2025-02-24T23:42:27+02:00","product_id":9759394824459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-zafina-telecomanda-136w-negru-rgb_1742_01.webp?v=1740433347","width":900,"height":900},{"id":51832456741131,"created_at":"2025-02-24T23:42:25+02:00","position":2,"updated_at":"2025-02-24T23:42:27+02:00","product_id":9759394824459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-zafina-telecomanda-136w-negru-rgb_1742_02.webp?v=1740433347","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759380701451,"title":"Lustra LED cu telecomanda si cristal TERRANO RGB 288W, 6 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-terrano-rgb-288w-6-patrate-lumina-rece-calda-neutra-dimabila-alb-crom-lucios","body_html":"\u003cp data-sourcepos=\"1:1-1:263\"\u003eLustra LED cu telecomandă și cristale TERRANO RGB este o piesă de iluminat modernă și spectaculoasă, cu o putere impresionantă de 288W și un design format din 6 pătrate albe, decorate cu cristale strălucitoare. Funcția RGB adaugă o dimensiune dinamică iluminării.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:492\"\u003eCele șase pătrate albe, împodobite cu cristale, creează un aspect geometric elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:326\"\u003eFinisajul alb al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 288W, este ideală pentru a ilumina livinguri mari, săli de mese sau alte spații ample unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:40:16+02:00","created_at":"2025-02-24T23:40:16+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52351405424907,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19376\/4+2WH+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9759380701451,"created_at":"2025-09-10T16:58:42+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832402968843,"created_at":"2025-02-24T23:40:17+02:00","position":1,"updated_at":"2025-02-24T23:40:19+02:00","product_id":9759380701451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-sharifa-telecomanda-288w-alb-rgb_1748_01.webp?v=1740433219","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757810589963,"title":"Lustra LED cu telecomanda si cristal QUADRIS RGB 96W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-quadris-rgb-96w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:285\"\u003eLustra LED cu telecomandă și cristale QUADRIS RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 pătrate stilizate, finisate în negru și decorate cu cristale strălucitoare. Cu o putere de 96W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:494\"\u003eCele patru pătrate negre, împodobite cu cristale, creează un aspect geometric elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:325\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 96W, este ideală pentru a ilumina livinguri mai mici, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:325\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:28:34+02:00","created_at":"2025-02-24T18:28:34+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52358225199371,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT076\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":9757810589963,"created_at":"2025-09-11T22:30:14+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51818081517835,"created_at":"2025-02-24T18:28:36+02:00","position":1,"updated_at":"2026-07-07T13:14:33+03:00","product_id":9757810589963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-160w-negru-dimabila_LL454_01-_1_-1722855993.webp?v=1783419273","width":1024,"height":1024},{"id":69708819235083,"created_at":"2026-07-07T13:13:07+03:00","position":2,"updated_at":"2026-07-07T13:15:30+03:00","product_id":9757810589963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-160w-negru-dimabila_LL454_01-_1_-1722855993_380b9f71-508d-442a-a553-74516c696e7e.webp?v=1783419330","width":1024,"height":1024},{"id":69708819333387,"created_at":"2026-07-07T13:13:08+03:00","position":3,"updated_at":"2026-07-07T13:16:28+03:00","product_id":9757810589963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-telecomanda-160w-negru-dimabila_LL454_01-_1_-1722855993_3d333265-f068-404c-9037-8a107ea9881d.webp?v=1783419388","width":1024,"height":1024},{"id":51818081714443,"created_at":"2025-02-24T18:28:36+02:00","position":4,"updated_at":"2026-07-07T13:18:51+03:00","product_id":9757810589963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ivone-cu-telecomanda-160w-negru-dimabila-1722855992.webp?v=1783419531","width":844,"height":844},{"id":68250325778699,"created_at":"2026-04-14T11:45:27+03:00","position":5,"updated_at":"2026-04-14T11:45:29+03:00","product_id":9757810589963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT076-4BK.png?v=1776156329","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757531635979,"title":"Lustra LED cu telecomanda ARWEN 142W, 2 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomanda-arwen-142w-2-patrate-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperă Arwen, o lustră LED care reprezintă esența modernității și eleganței în designul de iluminat. Parte a gamei Quri, Arwen îmbină un stil geometric distinct cu funcționalitatea avansată, transformând orice spațiu într-un loc plin de strălucire și stil.\u003c\/span\u003e\u003c\/div\u003e\u003ch3\u003eVezi video demonstrativ\u003c\/h3\u003e\u003cp\u003e\u003ca class=\"video-link\" href=\"https:\/\/www.youtube.com\/watch?v=6-ZLfAsXYWY\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg alt=\"YouTube video thumbnail\" src=\"https:\/\/img.youtube.com\/vi\/6-ZLfAsXYWY\/maxresdefault.jpg\"\u003e \u003c\/a\u003e\u003c\/p\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eDesignul inovator al lustrei Arwen este definit de două pătrate aurii, fiecare poziționat la diferite înălțimi, creând un efect vizual tridimensional și dinamic. Acest aranjament geometric nu este doar atrăgător, dar permite și dispersia uniformă a luminii în întreaga cameră.  Cu o putere de 142W și un flux luminos de 11360lm, Arwen este perfectă pentru a ilumina spații ample, de la livinguri mari și până la spații comerciale sau de birouri. Diametrul de 80cm asigură că această lustră nu doar că va lumina spațiul, dar va și deveni un punct focal de neuitat.\u003cbr\u003e\u003cbr\u003eDincolo de designul său impresionant, Arwen este și extrem de versatilă. Echipată cu trei tipuri de lumină - caldă, rece și neutră - îți oferă libertatea de a schimba atmosfera după dorință. Fie că ai nevoie de o lumină caldă pentru o seară relaxantă, o lumină rece pentru sarcini ce necesită concentrare sau o lumină neutră pentru un echilibru perfect, Arwen se adaptează cu ușurință la nevoile tale.\u003cbr\u003e\u003cbr\u003eInstalarea acestei lustre este simplă și intuitivă, oferindu-ți posibilitatea de a te bucura rapid de noua ta piesă centrală. Designul său modern și culoarea aurie se potrivesc perfect într-o varietate de stiluri de interior, adăugând un strop de lux și rafinament.\u003cbr\u003e\u003cbr\u003eAlege lustra LED Arwen din gama Quri pentru a adăuga un element de design modern și strălucitor în casa ta. Sub lumina sa, fiecare moment va fi transformat într-o experiență memorabilă, adăugând un plus de eleganță și modernitate.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:45:17+02:00","created_at":"2025-02-24T16:45:16+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52408137351435,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-168\/2AU","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"352.00","grams":0,"compare_at_price":"352.00","position":1,"product_id":9757531635979,"created_at":"2025-09-24T12:23:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51816258011403,"created_at":"2025-02-24T16:45:19+02:00","position":1,"updated_at":"2025-02-24T16:45:21+02:00","product_id":9757531635979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-arwen-142w-auriu-acril-dimabila_LL152_01.webp?v=1740408321","width":900,"height":900},{"id":51816257880331,"created_at":"2025-02-24T16:45:19+02:00","position":2,"updated_at":"2025-02-24T16:45:21+02:00","product_id":9757531635979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-arwen-142w-auriu-acril-dimabila_LL152_02.webp?v=1740408321","width":900,"height":900},{"id":51816257978635,"created_at":"2025-02-24T16:45:19+02:00","position":3,"updated_at":"2025-02-24T16:45:21+02:00","product_id":9757531635979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-arwen-142w-auriu-acril-dimabila_LL152_03.webp?v=1740408321","width":900,"height":900},{"id":51816257913099,"created_at":"2025-02-24T16:45:19+02:00","position":4,"updated_at":"2025-02-24T16:45:21+02:00","product_id":9757531635979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-arwen-142w-auriu-acril-dimabila_LL152_04.webp?v=1740408321","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759381487883,"title":"Lustra LED cu telecomanda si cristal TERRANO RGB 288W, 6 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-terrano-rgb-288w-6-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:294\"\u003eLustra LED cu telecomandă și cristale TERRANO RGB este o piesă de iluminat impresionantă și modernă, cu un design format din 6 pătrate stilizate, finisate în negru și decorate cu cristale strălucitoare. Cu o putere foarte mare de 288W, oferă o iluminare amplă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:493\"\u003eCele șase pătrate negre, împodobite cu cristale, creează un aspect geometric elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:328\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 288W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte încăperi ample unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:40:22+02:00","created_at":"2025-02-24T23:40:21+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52038333333771,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19376\/4+2BK+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9759381487883,"created_at":"2025-08-05T15:27:28+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832410079499,"created_at":"2025-02-24T23:40:23+02:00","position":1,"updated_at":"2025-02-24T23:40:25+02:00","product_id":9759381487883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-latasha-telecomanda-288w-negru-rgb_1749_01.webp?v=1740433225","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757279748363,"title":"Lustra Kappa 8xE27, Negru, Metal, 730\/8","handle":"lustra-kappa-8xe27-negru-metal-730-8","body_html":"\u003cdiv\u003e\n\u003cspan style=\"font-size:16px\"\u003ePendulele sunt corpuri de iluminat cu unul sau mai multe becuri, suspendate printr-un cablu flexibil sau tija rigidă dar reglabilă, astfel încat poți regla ușor înalțimea dorită.\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv\u003e\u003cspan style=\"font-size:16px\"\u003eUtilizând pendulele în planurile tale de design interior vei crea cu ajutorul lor zone de lumină, vei putea delimita sau pune un accent pe anumite suprafețe sau zone ale spațiului interior. Un pendul deasupra mesei va crea mici oaze de calm și relaxare, unde vei putea să savurezi o cină în tihnă cu cei dragi, să lucrezi sau să citești.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T15:20:29+02:00","created_at":"2025-02-24T15:20:28+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre cu bec moderne","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52365373571339,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC730\/8","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9757279748363,"created_at":"2025-09-13T13:35:47+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51814246154507,"created_at":"2025-02-24T15:20:30+02:00","position":1,"updated_at":"2025-02-24T15:20:32+02:00","product_id":9757279748363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-paianjen-8xe27-negru-metal-743-8_743-8_01.webp?v=1740403232","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760656457995,"title":"Lustra LED cu telecomanda CORA 120W, 5 Elemente, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios","handle":"lustra-led-cu-telecomanda-cora-120w-5-elemente-liniara-lumina-rece-calda-neutra-dimabila-auriu-lucios","body_html":"\u003cp\u003eLustra LED cu Telecomandă Cora, având o putere de 120W și caracteristica de a fi dimabilă, reprezintă o alegere excelentă pentru cei care doresc să combine eficiența energetică avansată cu un control deplin asupra ambianței locuinței. Cu un design modern și elegant, finisat în alb pur, această lustră se adaptează perfect oricărui stil de decor, de la cel minimalist și contemporan, până la configurații mai tradiționale sau eclectice.\u003cbr\u003e\u003cbr\u003eDotată cu tehnologie LED de ultimă generație, lustra Cora nu doar că iluminează eficient spațiul dorit, ci și reduce consumul de energie, oferind o soluție ecologică și economică pe termen lung. Intensitatea luminii poate fi ajustată cu ușurință prin telecomanda inclusă, permițându-vă să creați atmosfera perfectă pentru fiecare moment al zilei, fie că este vorba de o lumină puternică necesară activităților concentrative sau de o lumină ambientală, mai slabă, ideală pentru relaxare și momente de odihnă.\u003cbr\u003e\u003cbr\u003eAceastă lustră LED inovatoare oferă nu doar funcționalitate și eficiență, ci și un element decorativ impresionant, capabil să transforme orice încăpere într-un spațiu primitor și bine iluminat. Montajul este simplu și rapid, asigurând o integrare fără efort în decorul existent, iar durabilitatea LED-urilor înseamnă că veți putea bucura de iluminatul de calitate pentru ani de zile, fără grija înlocuirii frecvente a surselor de lumină.\u003cbr\u003e\u003cbr\u003eÎn concluzie, Lustra LED cu Telecomandă Cora de 120W dimabilă în alb este soluția ideală pentru oricine caută o combinație între estetică și tehnologie avansată în iluminatul interior. Investiția în această lustră se traduce prin beneficii multiple: de la economisirea energiei și adaptabilitatea luminii până la adăugarea unui element de design sofisticat în casa dvs., transformând orice cameră într-un spațiu mai luminos, mai eficient și mai plăcut.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:03:34+02:00","created_at":"2025-02-25T03:03:33+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52038967296267,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-9371\/5WH+GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9760656457995,"created_at":"2025-08-05T18:02:15+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51852690751755,"created_at":"2025-02-25T03:03:35+02:00","position":1,"updated_at":"2025-02-25T03:03:36+02:00","product_id":9760656457995,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-cora-120w-dimabila-auriu-1715594056.webp?v=1740445416","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758318166283,"title":"Pendul LED HAL 24W, lumina Rece\/Calda\/Neutra, Negru Auriu Lucios, Inaltime Reglabila","handle":"pendul-led-hal-24w-lumina-rece-calda-neutra-negru-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cp data-sourcepos=\"1:1-1:135\"\u003ePendulul LED Hal este o piesă de iluminat suspendată, modernă și eficientă, cu o putere de 24W și un finisaj elegant în negru și auriu.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:331\"\u003eFiind LED, oferă un consum redus de energie și o durată de viață lungă. Posibilitatea de a alege între lumină rece, caldă sau neutră, împreună cu funcția de dimare, îți permite să ajustezi atmosfera luminoasă în funcție de preferințe și necesități. Combinația de negru și auriu adaugă o notă sofisticată și contemporană designului.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:150\"\u003eCu o putere de 24W, ar fi ideal pentru a ilumina zone specifice, cum ar fi deasupra unei mese, a unei insule de bucătărie sau într-un colț de lectură.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cbr\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T21:15:37+02:00","created_at":"2025-02-24T21:15:36+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre LED Suspendate"],"variants":[{"id":52408538136843,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-XD410\/1","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9758318166283,"created_at":"2025-09-24T13:53:13+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51820971917579,"created_at":"2025-02-24T21:15:38+02:00","position":1,"updated_at":"2025-02-24T21:15:40+02:00","product_id":9758318166283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-led-halo-telecomanda-24w-24ghz-dimabila-metal-negru-auriu_PE1322_01.webp?v=1740424540","width":900,"height":900},{"id":51820971884811,"created_at":"2025-02-24T21:15:38+02:00","position":2,"updated_at":"2025-02-24T21:15:40+02:00","product_id":9758318166283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pendul-led-halo-telecomanda-24w-24ghz-dimabila-metal-negru-auriu_PE1322_02.webp?v=1740424540","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757906305291,"title":"Lustra LED cu telecomanda LYRA 220W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Periat","handle":"lustra-led-cu-telecomanda-lyra-220w-4-cercuri-lumina-rece-calda-neutra-dimabila-auriu-periat","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.   \u003cem\u003e   \u003c\/em\u003e\u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T19:17:33+02:00","created_at":"2025-02-24T19:17:33+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52408512971019,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-162\/4GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"599.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":9757906305291,"created_at":"2025-09-24T13:43:34+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51818873422091,"created_at":"2025-02-24T19:17:36+02:00","position":1,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_01.webp?v=1740417458","width":900,"height":900},{"id":51818873159947,"created_at":"2025-02-24T19:17:36+02:00","position":2,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_02.webp?v=1740417458","width":900,"height":900},{"id":51818873487627,"created_at":"2025-02-24T19:17:36+02:00","position":3,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_03.webp?v=1740417458","width":900,"height":900},{"id":51818873782539,"created_at":"2025-02-24T19:17:36+02:00","position":4,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_04.webp?v=1740417458","width":900,"height":900},{"id":51818873553163,"created_at":"2025-02-24T19:17:36+02:00","position":5,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_05.webp?v=1740417458","width":900,"height":900},{"id":51818873585931,"created_at":"2025-02-24T19:17:36+02:00","position":6,"updated_at":"2025-02-24T19:17:38+02:00","product_id":9757906305291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gratiana--telecomanda-220w-dimabila-auriu_LL469_06.webp?v=1740417458","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10851809067275,"title":"Lustra Suspendata, LV210\/3L, 3xE27, Negru, Metal si Fir, Inaltime Reglabila","handle":"lustra-suspendata-lv210-3l-3-e27-maro-metal-si-fir","body_html":"\u003cp data-start=\"0\" data-end=\"78\"\u003e\u003cstrong data-start=\"0\" data-end=\"78\"\u003eLustră suspendată LV210\/3L, 3x E27, maro, metal și fir, înălțime reglabilă\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"80\" data-end=\"376\"\u003eLustra suspendată LV210\/3L este un corp de iluminat cu design simplu și funcțional, potrivit pentru interioare moderne, industriale sau rustice. Structura din metal, combinată cu elemente de fir și finisaj maro, oferă un aspect cald și echilibrat, ușor de integrat în diverse tipuri de amenajări.\u003c\/p\u003e\u003cp data-start=\"80\" data-end=\"376\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"378\" data-end=\"651\"\u003ePrevăzută cu 3 socluri tip E27, lustra asigură o iluminare eficientă și bine distribuită, ideală pentru livinguri, bucătării, zone de dining sau spații comerciale. Compatibilitatea cu diferite tipuri de becuri permite personalizarea intensității și temperaturii de culoare.\u003c\/p\u003e\u003cp data-start=\"653\" data-end=\"890\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eSistemul de suspendare cu înălțime reglabilă permite adaptarea lustrei în funcție de tavan și configurația spațiului. Materialele rezistente și designul versatil fac din LV210\/3L o alegere practică și estetică pentru iluminatul interior.\u003c\/p\u003e","published_at":"2026-01-09T11:47:40+02:00","created_at":"2026-01-06T14:55:45+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52808078885131,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LV210\/3L","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"139.97","grams":0,"compare_at_price":"179.99","position":1,"product_id":10851809067275,"created_at":"2026-01-06T14:55:46+02:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":64512128352523,"created_at":"2026-01-19T15:58:44+02:00","position":1,"updated_at":"2026-01-19T16:02:55+02:00","product_id":10851809067275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Jan_19_2026_03_58_37_PM.png?v=1768831375","width":1024,"height":1024},{"id":64512455409931,"created_at":"2026-01-19T16:01:41+02:00","position":2,"updated_at":"2026-01-19T16:04:51+02:00","product_id":10851809067275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/image_198.jpg?v=1768831491","width":824,"height":825},{"id":64512104071435,"created_at":"2026-01-19T15:56:49+02:00","position":3,"updated_at":"2026-01-19T16:02:55+02:00","product_id":10851809067275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Jan_19_2026_03_56_30_PM.png?v=1768831375","width":1024,"height":1024},{"id":64512456458507,"created_at":"2026-01-19T16:01:48+02:00","position":4,"updated_at":"2026-01-19T16:02:55+02:00","product_id":10851809067275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Jan_19_2026_04_01_41_PM.png?v=1768831375","width":1024,"height":1024},{"id":64161913274635,"created_at":"2026-01-06T15:01:46+02:00","position":5,"updated_at":"2026-01-19T16:02:55+02:00","product_id":10851809067275,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_2_3aca5c5e-7c99-46fb-aa40-8fced6f6f2f5.png?v=1768831375","width":1290,"height":1229}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779347947787,"title":"Proiector LED Ellen 46W Lumina Rece\/Calda\/Neutra Reglabil Acril si Metal Negru","handle":"lustra-led-ellen-46w-lumina-rece-calda-neutra-proiector-reglabil-acril-si-metal-negru","body_html":"\u003cp data-start=\"105\" data-end=\"420\"\u003e\u003cstrong data-start=\"105\" data-end=\"129\"\u003eLustra LED Ellen 46W\u003c\/strong\u003e este un corp de iluminat modern, cu design circular și finisaj negru elegant, realizat din acril și metal. Elementul distinctiv este \u003cstrong data-start=\"263\" data-end=\"287\"\u003eproiectorul reglabil\u003c\/strong\u003e, care permite direcționarea luminii exact acolo unde este necesar – ideal pentru evidențierea unei zone sau a unui obiect decorativ.\u003c\/p\u003e\u003ch3 data-start=\"422\" data-end=\"446\"\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul data-start=\"447\" data-end=\"758\"\u003e\n\u003cli data-start=\"447\" data-end=\"466\"\u003e\u003cp data-start=\"449\" data-end=\"466\"\u003e\u003cstrong data-start=\"449\" data-end=\"460\"\u003ePutere:\u003c\/strong\u003e 46W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"467\" data-end=\"522\"\u003e\u003cp data-start=\"469\" data-end=\"522\"\u003e\u003cstrong data-start=\"469\" data-end=\"484\"\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"523\" data-end=\"554\"\u003e\u003cp data-start=\"525\" data-end=\"554\"\u003e\u003cstrong data-start=\"525\" data-end=\"538\"\u003eMaterial:\u003c\/strong\u003e Acril + Metal\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"555\" data-end=\"577\"\u003e\u003cp data-start=\"557\" data-end=\"577\"\u003e\u003cstrong data-start=\"557\" data-end=\"569\"\u003eCuloare:\u003c\/strong\u003e Negru\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"578\" data-end=\"629\"\u003e\u003cp data-start=\"580\" data-end=\"629\"\u003e\u003cstrong data-start=\"580\" data-end=\"595\"\u003eDimensiuni:\u003c\/strong\u003e Diametru 50 cm x Înălțime 20 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"630\" data-end=\"702\"\u003e\u003cp data-start=\"632\" data-end=\"702\"\u003e\u003cstrong data-start=\"632\" data-end=\"643\"\u003eMontaj:\u003c\/strong\u003e Aplicat \/ suspendat (în funcție de sistemul de prindere)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"703\" data-end=\"758\"\u003e\u003cp data-start=\"705\" data-end=\"758\"\u003e\u003cstrong data-start=\"705\" data-end=\"726\"\u003eFuncție specială:\u003c\/strong\u003e Proiector orientabil integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3 data-start=\"760\" data-end=\"772\"\u003eAvantaje\u003c\/h3\u003e\u003cp data-start=\"773\" data-end=\"1062\"\u003e✔ Control al temperaturii de culoare – adaptezi atmosfera în funcție de moment\u003cbr data-start=\"851\" data-end=\"854\"\u003e✔ Proiector reglabil pentru iluminat direcțional\u003cbr data-start=\"902\" data-end=\"905\"\u003e✔ Design modern, potrivit pentru interioare minimaliste\u003cbr data-start=\"960\" data-end=\"963\"\u003e✔ Consum redus datorită tehnologiei LED\u003cbr data-start=\"1002\" data-end=\"1005\"\u003e✔ Distribuție uniformă a luminii prin dispersor acrilic\u003c\/p\u003e\u003cp data-start=\"1161\" data-end=\"1376\"\u003ePrin combinația dintre iluminarea ambientală uniformă și spotul reglabil, \u003cstrong data-start=\"1235\" data-end=\"1259\"\u003eLustra LED Ellen 46W\u003c\/strong\u003e oferă atât confort vizual, cât și funcționalitate avansată, devenind un element central în amenajările contemporane.\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-15T17:03:20+03:00","created_at":"2025-03-06T18:45:24+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED"],"variants":[{"id":52372603371787,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL833\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9779347947787,"created_at":"2025-09-16T01:17:00+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":62527599608075,"created_at":"2025-11-20T15:14:12+02:00","position":1,"updated_at":"2025-11-20T15:14:34+02:00","product_id":9779347947787,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_7d03169a-ff9f-4d7d-b414-3886a4458545.png?v=1763644474","width":1500,"height":1500},{"id":59128244601099,"created_at":"2025-08-14T16:56:05+03:00","position":2,"updated_at":"2025-11-20T15:14:34+02:00","product_id":9779347947787,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_f3b500e5-8f08-4c28-9c4e-b807a9e7e83b.png?v=1763644474","width":2048,"height":2048},{"id":59128262197515,"created_at":"2025-08-14T16:57:56+03:00","position":3,"updated_at":"2025-11-20T15:14:34+02:00","product_id":9779347947787,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H99df042101b946528faa094d603f54244.jpg?v=1763644474","width":1500,"height":1500},