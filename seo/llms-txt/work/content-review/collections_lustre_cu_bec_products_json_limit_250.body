:1024,"height":1024},{"id":63139641458955,"created_at":"2025-12-08T18:30:02+02:00","position":6,"updated_at":"2025-12-08T18:31:17+02:00","product_id":10727334609163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT1716GD.png?v=1765211477","width":1500,"height":1500},{"id":63139641426187,"created_at":"2025-12-08T18:30:02+02:00","position":7,"updated_at":"2025-12-08T18:31:17+02:00","product_id":10727334609163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT1716GD_1.png?v=1765211477","width":800,"height":800},{"id":68894997315851,"created_at":"2026-05-14T12:04:17+03:00","position":8,"updated_at":"2026-05-14T12:04:21+03:00","product_id":10727334609163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage14mai2026_12_01_25.png?v=1778749461","width":1254,"height":1254},{"id":62880313999627,"created_at":"2025-11-30T12:51:23+02:00","position":9,"updated_at":"2025-12-08T18:31:17+02:00","product_id":10727334609163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT171_6GD_PREL.png?v=1765211477","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10724037624075,"title":"Lustra Roata LV580\/6BK, 6xE27, Maro, Metal si Sfoara","handle":"lustra-roata-lv580-6bk-6-e27-maro-metal-si-sfoara","body_html":"\u003cp\u003e\u003cimg\u003e\u003cimg\u003e\u003cimg\u003eLustra Roata nu este doar o sursa de lumina, ci o declaratie de stil, conceputa sa devina punctul central in foisor, veranda sau bucatarie, infuzand fiecare colt cu o caldura naturala si o personalitate robusta.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:246\"\u003e\n\u003cstrong\u003eDesign Unic, Inspiratie Rustica:\u003c\/strong\u003e Cu o structura circulara ce imita o roata, din metal maro, completata de trei pendule impletite din sfoara naturala, aceasta lustra ofera o estetica autentica, amintind de fermecatoarele spatii traditionale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:243\"\u003e\n\u003cstrong\u003eLumina Calda, Atmosfera Primitoare:\u003c\/strong\u003e Echipata cu 6 socluri E27, Lustra Roata permite utilizarea becurilor LED, economice sau fluorescente, difuzand o lumina ambientala generoasa, ideala pentru a crea o atmosfera relaxanta si invitanta.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:262\"\u003e\n\u003cstrong\u003ePrezenta Impunatoare, Versatilitate Functionala:\u003c\/strong\u003e Desi ancorata in stilul rustic, designul sau versatil ii permite sa se integreze armonios atat in decoruri traditionale, cat si in cele cu accente industriale sau boeme, aducand un echilibru vizual de efect.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-9:0\"\u003e\n\u003cstrong\u003eConstructie Solida, Caracter Durabil:\u003c\/strong\u003e Realizata din metal si sfoara, ofera o durabilitate remarcabila si o estetica autentica, care imbatraneste frumos, transformand un simplu spatiu intr-unul cu suflet si poveste.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:191\"\u003eAceasta lustra nu doar lumineaza functional, ci imbraca spatiul cu un spirit rural chic, transformand fiecare moment intr-o experienta vizuala placuta si un spatiu cu un farmec inconfundabil.\u003c\/p\u003e\u003cp data-sourcepos=\"10:1-10:191\"\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"10:1-10:191\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:43:39+03:00","created_at":"2025-09-15T14:47:46+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52397508460811,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LV580\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10724037624075,"created_at":"2025-09-20T21:41:57+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":60333471072523,"created_at":"2025-09-15T14:50:27+03:00","position":1,"updated_at":"2025-09-15T14:51:07+03:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_dbd852c2-9dce-4d40-b0e1-302f0a57f38a.png?v=1757937067","width":800,"height":800},{"id":60333429293323,"created_at":"2025-09-15T14:45:56+03:00","position":2,"updated_at":"2025-12-27T07:32:53+02:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H4dc36dc840184a38be9951ff592cd7daf.jpg?v=1766813573","width":800,"height":800},{"id":60333470777611,"created_at":"2025-09-15T14:50:22+03:00","position":3,"updated_at":"2025-09-15T14:51:07+03:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H16bced3ba1b54772874ae18359c48e4dH.jpg?v=1757937067","width":750,"height":750},{"id":60333470810379,"created_at":"2025-09-15T14:50:22+03:00","position":4,"updated_at":"2025-09-15T14:51:07+03:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ha3d7e2bc8cf943649794cfd8dd8384eek.jpg?v=1757937067","width":609,"height":609},{"id":60333470843147,"created_at":"2025-09-15T14:50:23+03:00","position":5,"updated_at":"2025-09-15T14:51:07+03:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H5cabaaa65cee4eeeba9990a8fa07c7806.png?v=1757937067","width":560,"height":560},{"id":66219130847499,"created_at":"2026-02-22T18:26:23+02:00","position":6,"updated_at":"2026-02-22T18:26:26+02:00","product_id":10724037624075,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LV580_6BK.webp?v=1771777586","width":800,"height":800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10667730108683,"title":"Lustra Franghie 3xE27, Maro, Metal si Sfoara","handle":"lustra-franghie-3xe27-maro-metal-si-sfoara","body_html":"\u003cdiv\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra reprezintă un element de iluminare practic ce completează atmosfera elegantă a încăperii unde îți dorești să creezi o atmosferă caldă și primitoare. \u003cbr\u003e \u003cbr\u003eRealizate din materiale de înaltă calitate acestea au o durată lungă de viață și vă veți putea bucura mult timp de frumusețea și lumina lustrei alese!\u003c\/span\u003e\u003c\/div\u003e\u003cdiv\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-09-08T14:51:13+03:00","created_at":"2025-08-12T13:20:22+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Vintage","tags":["active","BF2025","Corpuri de Iluminat","Lustre cu bec","Lustre Vintage"],"variants":[{"id":52422713737483,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LV310\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.97","grams":0,"compare_at_price":"279.99","position":1,"product_id":10667730108683,"created_at":"2025-09-28T22:06:08+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51813459689739,"created_at":"2025-02-24T14:36:39+02:00","position":1,"updated_at":"2025-11-06T20:30:34+02:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_02.webp?v=1762453834","width":900,"height":900},{"id":51813459886347,"created_at":"2025-02-24T14:36:39+02:00","position":2,"updated_at":"2025-11-06T20:30:34+02:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_01.webp?v=1762453834","width":900,"height":900},{"id":59032634818827,"created_at":"2025-08-12T13:20:36+03:00","position":3,"updated_at":"2025-08-12T13:23:04+03:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_f163f9f3-5c3a-455b-87bb-06f43e0a1c7c.png?v=1754994184","width":844,"height":814},{"id":51813459755275,"created_at":"2025-02-24T14:36:39+02:00","position":4,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_04.webp?v=1757938336","width":900,"height":900},{"id":51813459853579,"created_at":"2025-02-24T14:36:40+02:00","position":5,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_05.webp?v=1757938336","width":900,"height":900},{"id":51813459788043,"created_at":"2025-02-24T14:36:40+02:00","position":6,"updated_at":"2025-09-15T15:12:16+03:00","product_id":10667730108683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-franghie-3xe27-maro-metal-sfoara_LC1022_06.webp?v=1757938336","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759917244683,"title":"Lustra LED  JUNIPER 34W, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-juniper-34w-lumina-rece-calda-neutra-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Juniper este o opțiune ideală pentru adăugarea unui element de iluminat elegant și eficient în spații mici precum holurile și băile. Cu o putere de 34W și un flux luminos de 2720lm, Juniper oferă o iluminare adecvată și plăcută, creând un ambient confortabil și invitator în orice spațiu restrâns.\u003cbr\u003e\u003cbr\u003eDesignul său modern, combinând alb cu negru, adaugă un contrast vizual atrăgător și o notă de rafinament. Cu un diametru de 24cm, forma rotundă a Juniper este perfect proporționată pentru a se integra armonios în spații mai mici, fără a ocupa prea mult spațiu vizual.\u003cbr\u003e\u003cbr\u003eUnul dintre punctele forte ale lustrei Juniper este capacitatea sa de a oferi trei tipuri de lumină - caldă, rece și neutră. Această versatilitate îți permite să schimbi atmosfera camerei în funcție de nevoile tale sau de momentul zilei, fie că este vorba despre o lumină caldă pentru relaxare, o lumină rece pentru claritate sau o lumină neutră pentru un echilibru perfect. Designul său rotund și finisajul elegant fac din Juniper o alegere ideală pentru spații precum holurile și băile, unde funcționalitatea întâlnește stilul. Fie că este folosită singură sau în combinație cu alte surse de iluminat, Juniper va adăuga o notă de modernitate și eleganță.\u003cbr\u003e\u003cbr\u003eInstalarea acestei lustre este simplă și directă, permițându-ți să te bucuri rapid de noua ta sursă de lumină și de elementul de design. Indiferent de locul unde este plasată, Juniper va aduce un plus de stil și funcționalitate, iluminând spațiul cu un fascicul de lumină plăcut și eficient.\u003cbr\u003e\u003cbr\u003eAlege lustra LED Juniper pentru a îmbunătăți orice spațiu mic cu o lumină modernă și eficientă. Sub lumina sa, fiecare colț al camerei va fi revigorat, creând o atmosferă plăcută și sofisticată.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-07-03T15:31:48+03:00","created_at":"2025-02-25T01:00:53+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52424071479563,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-SX8787\/240Y","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"80.00","grams":0,"compare_at_price":"80.00","position":1,"product_id":9759917244683,"created_at":"2025-09-29T13:25:51+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51839668781323,"created_at":"2025-02-25T01:00:55+02:00","position":1,"updated_at":"2025-02-25T01:00:57+02:00","product_id":9759917244683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-juniper-34w-alb-negru_SX8787-240Y_01.webp?v=1740438057","width":900,"height":900},{"id":51839668814091,"created_at":"2025-02-25T01:00:55+02:00","position":2,"updated_at":"2025-02-25T01:00:57+02:00","product_id":9759917244683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-juniper-34w-alb-negru_SX8787-240Y_02.webp?v=1740438057","width":900,"height":900},{"id":51839669338379,"created_at":"2025-02-25T01:00:55+02:00","position":3,"updated_at":"2025-02-25T01:00:58+02:00","product_id":9759917244683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-juniper-34w-alb-negru_SX8787-240Y_03.webp?v=1740438058","width":900,"height":900},{"id":51839669371147,"created_at":"2025-02-25T01:00:55+02:00","position":4,"updated_at":"2025-02-25T01:00:58+02:00","product_id":9759917244683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-juniper-34w-alb-negru_SX8787-240Y_04.webp?v=1740438058","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759384699147,"title":"Lustra LED cu telecomanda si cristal LEOCADIA RGB 134W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-leocadia-rgb-134w-3-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:303\"\u003eLustra LED cu telecomandă și cristale LEOCADIA RGB este o piesă de iluminat spectaculoasă și modernă, cu un design format din 3 cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 134W, oferă o iluminare puternică și extrem de versatilă, datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:483\"\u003eCele trei cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o paletă largă de culori pentru a crea efecte de iluminare dinamice și personalizate.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:325\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 134W, este ideală pentru a ilumina livinguri mari, sufragerii sau alte încăperi unde se dorește un element de design impresionant și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:40:48+02:00","created_at":"2025-02-24T23:40:48+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52122278985995,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19375\/4BK+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"329.99","grams":0,"compare_at_price":"329.99","position":1,"product_id":9759384699147,"created_at":"2025-08-25T21:20:28+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832422170891,"created_at":"2025-02-24T23:40:50+02:00","position":1,"updated_at":"2025-02-24T23:40:52+02:00","product_id":9759384699147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-leocadia-telecomanda-134w-negru-rgb_AT1CT-VV1A-HT2L-19375-4BKCH_01.webp?v=1740433252","width":900,"height":900},{"id":51832422105355,"created_at":"2025-02-24T23:40:50+02:00","position":2,"updated_at":"2025-02-24T23:40:52+02:00","product_id":9759384699147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-leocadia-telecomanda-134w-negru-rgb_AT1CT-VV1A-HT2L-19375-4BKCH_02.webp?v=1740433252","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759383191819,"title":"Lustra LED cu telecomanda si cristal MEILI ZAFINA RGB 106W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-zafina-rgb-106w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:292\"\u003eLustra LED cu telecomandă și cristale ZAFINA RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din două cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 106W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:483\"\u003eCele două cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:326\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 106W, este ideală pentru a ilumina livinguri mai mici, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:40:35+02:00","created_at":"2025-02-24T23:40:34+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52408178835723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19373\/2BK+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"248.00","grams":0,"compare_at_price":"248.00","position":1,"product_id":9759383191819,"created_at":"2025-09-24T12:33:05+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832418205963,"created_at":"2025-02-24T23:40:36+02:00","position":1,"updated_at":"2025-02-24T23:40:37+02:00","product_id":9759383191819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-khalida-telecomanda-106w-negru-rgb_AT1CT-VV1A-HT2L-19373-2BKCH_01.webp?v=1740433237","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756944531723,"title":"Lustra LED cu telecomanda si cristal LIA RGB 182W, 8 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-lia-rgb-182w-8-cercuri-lumina-rece-calda-neutra-dimabila-alb-crom-lucios","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.   \u003cem\u003e   \u003c\/em\u003e\u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e \u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T13:16:00+02:00","created_at":"2025-02-24T13:16:00+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365338575115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-2875\/8RGB","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"816.00","grams":0,"compare_at_price":"889.99","position":1,"product_id":9756944531723,"created_at":"2025-09-13T13:15:53+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":62779687371019,"created_at":"2025-11-27T12:31:50+02:00","position":1,"updated_at":"2025-11-27T12:32:13+02:00","product_id":9756944531723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_3aa509ff-8764-4ada-8e7a-604f7b8fb630.png?v=1764239533","width":800,"height":800},{"id":62772406255883,"created_at":"2025-11-27T10:46:44+02:00","position":2,"updated_at":"2025-11-27T12:32:13+02:00","product_id":9756944531723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/He6051485241e4a058c26148adf3c6054P.jpg?v=1764239533","width":1000,"height":1000},{"id":51811502129419,"created_at":"2025-02-24T13:16:02+02:00","position":3,"updated_at":"2025-11-27T12:32:13+02:00","product_id":9756944531723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-rgb-cristal-telecomanda-lia-240w-crom-cristal-acril-dimabila_CC584_02.webp?v=1764239533","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10727447625995,"title":"Lustra LED cu Telecomanda GIO, 68W, 5 Elemente, Lumina Rece\/Clada\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-gio-68w-5-elemente-lumina-rece-clada-neutra-dimabila-alb","body_html":"\u003cp data-start=\"75\" data-end=\"453\"\u003eLustra LED \u003cstrong data-start=\"86\" data-end=\"93\"\u003eGIO\u003c\/strong\u003e se remarcă prin designul modern și finisajul elegant \u003cstrong data-start=\"147\" data-end=\"154\"\u003ealb\u003c\/strong\u003e, fiind ideală pentru interioare contemporane. Cu \u003cstrong data-start=\"204\" data-end=\"229\"\u003e5 elemente decorative\u003c\/strong\u003e și o putere de \u003cstrong data-start=\"245\" data-end=\"265\"\u003e68W LED integrat\u003c\/strong\u003e, oferă o iluminare intensă și uniformă. Prin \u003cstrong data-start=\"311\" data-end=\"334\"\u003etelecomanda inclusă\u003c\/strong\u003e, poți regla atât intensitatea luminii, cât și temperatura acesteia: \u003cstrong data-start=\"403\" data-end=\"450\"\u003e3000K (caldă), 4000K (neutră), 6000K (rece)\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-start=\"455\" data-end=\"745\"\u003e✔ \u003cstrong data-start=\"457\" data-end=\"468\"\u003ePutere:\u003c\/strong\u003e 68W LED integrat\u003cbr data-start=\"485\" data-end=\"488\"\u003e✔ \u003cstrong data-start=\"490\" data-end=\"514\"\u003eTemperatură culoare:\u003c\/strong\u003e 3000K \/ 4000K \/ 6000K\u003cbr data-start=\"536\" data-end=\"539\"\u003e✔ \u003cstrong data-start=\"541\" data-end=\"553\"\u003eFuncții:\u003c\/strong\u003e Dimabilă, control prin telecomandă\u003cbr data-start=\"588\" data-end=\"591\"\u003e✔ \u003cstrong data-start=\"593\" data-end=\"604\"\u003eDesign:\u003c\/strong\u003e 5 elemente moderne, finisaj alb elegant\u003cbr data-start=\"644\" data-end=\"647\"\u003e✔ \u003cstrong data-start=\"649\" data-end=\"662\"\u003eMaterial:\u003c\/strong\u003e Metal + Acril\u003cbr data-start=\"676\" data-end=\"679\"\u003e✔ \u003cstrong data-start=\"681\" data-end=\"695\"\u003eUtilizare:\u003c\/strong\u003e Living, dining, dormitor, birou, spații moderne\u003c\/p\u003e\u003cp data-start=\"747\" data-end=\"886\"\u003eAceastă lustra LED combină \u003cstrong data-start=\"774\" data-end=\"806\"\u003efuncționalitatea inteligentă\u003c\/strong\u003e cu un \u003cstrong data-start=\"813\" data-end=\"834\"\u003edesign minimalist\u003c\/strong\u003e, aducând confort și rafinament în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e \u003c\/p\u003e","published_at":"2025