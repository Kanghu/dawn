mosferei dorite.\u003c\/p\u003e\u003cp\u003eSursele LED integrate asigură o lumină uniformă, consum redus de energie și durată lungă de utilizare.\u003c\/p\u003e","published_at":"2025-09-08T14:47:46+03:00","created_at":"2025-03-06T18:46:09+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED"],"variants":[{"id":52372593213707,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT922GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"699.99","grams":0,"compare_at_price":"799.99","position":1,"product_id":9779349029131,"created_at":"2025-09-16T01:07:57+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":70052363829515,"created_at":"2026-09-04T11:44:42+03:00","position":1,"updated_at":"2026-09-04T11:45:14+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_1.png?v=1788511514","width":1254,"height":1254},{"id":69426812158219,"created_at":"2026-06-11T17:57:35+03:00","position":2,"updated_at":"2026-09-04T11:45:26+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_2.png?v=1788511526","width":1254,"height":1254},{"id":59032180326667,"created_at":"2025-08-12T12:50:13+03:00","position":3,"updated_at":"2026-09-04T11:45:34+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_3.jpg?v=1788511534","width":800,"height":800},{"id":59032180293899,"created_at":"2025-08-12T12:50:13+03:00","position":4,"updated_at":"2026-09-04T11:45:44+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_4H95ae8c91f68146e2a7a77c5bd11d857cv.jpg?v=1788511544","width":1024,"height":1024},{"id":59032180228363,"created_at":"2025-08-12T12:50:13+03:00","position":5,"updated_at":"2026-09-04T11:45:55+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_5Hbabd3c51b7104439aeee31cb87ffbc85e.png?v=1788511555","width":1024,"height":1024},{"id":59032180261131,"created_at":"2025-08-12T12:50:13+03:00","position":6,"updated_at":"2026-09-04T11:46:04+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_6.png?v=1788511564","width":1024,"height":1024},{"id":59032180195595,"created_at":"2025-08-12T12:50:13+03:00","position":7,"updated_at":"2026-09-04T11:46:13+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_7Hbffcb1cec2bb4ae48527a87050c58eeaO.png?v=1788511573","width":796,"height":796},{"id":69426812190987,"created_at":"2026-06-11T17:57:35+03:00","position":8,"updated_at":"2026-09-04T11:46:25+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_6ChatGPTImage11iun.2026_17_57_23.png?v=1788511585","width":1236,"height":1273},{"id":70052357734667,"created_at":"2026-09-04T11:42:50+03:00","position":9,"updated_at":"2026-09-04T11:46:35+03:00","product_id":9779349029131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustr_Suspendat_LED_Acril_Aurelia_41W_cu_Telecomand_Dimabil_3000K_4000K_6000K_Auriu_Metal_i_Acril_9Label_2749023_big_color.png?v=1788511595","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760862634251,"title":"Lustra LED suspendata cu cristal PRISM REGAL 117W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-cristal-prism-regal-117w-2-cercuri-lumina-rece-calda-neutra-dimabila-auriu-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:332\"\u003eLustra LED suspendată cu cristale PRISM REGAL este o piesă de iluminat opulentă și modernă, concepută pentru a aduce un plus de strălucire și eleganță în orice încăpere. Cu o putere impresionantă de 117W și un design format din două cercuri concentrice, finisate în auriu, această lustră este un adevărat punct focal.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:491\"\u003eCele două cercuri sunt bogat decorate cu cristale transparente de înaltă calitate, care reflectă și refractă lumina LED integrată, creând un efect vizual spectaculos și o atmosferă luxoasă. Poți alege între lumină rece (pentru un ambient vibrant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală).\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:238\"\u003eFinisajul auriu al structurii amplifică senzația de lux și rafinament, completând perfect strălucirea cristalelor. Înălțimea reglabilă îți permite să adaptezi poziția lustrei în funcție de înălțimea tavanului și de preferințele personale.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:222\"\u003eAceastă lustră este ideală pentru livinguri spațioase, sufragerii sau alte zone unde se dorește un impact vizual puternic și o iluminare versatilă, îmbinând perfect eleganța clasică a cristalelor cu tehnologia LED modernă.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:40:41+02:00","created_at":"2025-02-25T03:40:40+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale"],"variants":[{"id":52401120837899,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CC310\/800+600GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"999.99","grams":0,"compare_at_price":"999.99","position":1,"product_id":9760862634251,"created_at":"2025-09-22T13:46:16+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":55864419746059,"created_at":"2025-05-28T11:58:31+03:00","position":1,"updated_at":"2025-05-28T12:02:25+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-cristal-harth-auriu-dimabila-1729110123.jpg?v=1748422945","width":1800,"height":1800},{"id":55864359846155,"created_at":"2025-05-28T11:57:45+03:00","position":2,"updated_at":"2025-05-28T12:02:25+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H35c147be5dfe4ef7aa7c15ae9bd50e6dD.webp?v=1748422945","width":790,"height":790},{"id":55864293228811,"created_at":"2025-05-28T11:56:45+03:00","position":3,"updated_at":"2025-05-28T12:02:25+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb096d806129d4831bcab8ebf715ea718i.jpg?v=1748422945","width":1600,"height":1600},{"id":55864614420747,"created_at":"2025-05-28T12:01:21+03:00","position":4,"updated_at":"2025-05-28T12:02:25+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot_2025-05-28_120006_1.png?v=1748422945","width":2220,"height":2220},{"id":55864292770059,"created_at":"2025-05-28T11:56:45+03:00","position":5,"updated_at":"2025-05-28T12:02:25+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H2f4eb87f6ced43abaa0563b9d4f76e5d9.jpg?v=1748422945","width":1600,"height":1600},{"id":55864292278539,"created_at":"2025-05-28T11:56:45+03:00","position":6,"updated_at":"2025-05-28T12:02:22+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hd4c9ce22470e455e920556aeddfa931cS.jpg?v=1748422942","width":1600,"height":1600},{"id":68401203314955,"created_at":"2026-04-21T17:30:34+03:00","position":7,"updated_at":"2026-04-21T17:30:37+03:00","product_id":9760862634251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2695161_big_color.svg?v=1776781837","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757600874763,"title":"Lustra LED cu telecomanda KYLEN 144W, 6 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-kylen-144w-6-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Kylen, un bijuterie din colecția Omid, îmbină grația designului floral cu eficiența modernă a iluminării LED. Perfectă pentru cei care doresc să aducă un element de naturalețe și lumină în spațiul lor, Kylen este o alegere excelentă pentru a crea o atmosferă plăcută și relaxantă. Dotată cu o putere de 144W, Kylen oferă un flux luminos impresionant de 14400lm, asigurând o iluminare puternică și clară, ideală pentru spații de dimensiuni medii. Fie că este vorba de un living, o zonă de dining sau un birou, această lustră va lumina încăperea cu eleganță și eficiență.\u003cbr\u003e\u003cbr\u003eDesignul său este inspirat din lumea florilor, cu 3 brațe ce evocă formele delicate și armonioase ale naturii. Realizată din acril de înaltă calitate, Kylen combină durabilitatea cu estetica, adăugând un strop de rafinament oricărui decor. Unul dintre cele mai remarcabile aspecte ale lustrei Kylen este capacitatea sa de a oferi trei tipuri de lumină - caldă, rece și neutră. Această caracteristică îți permite să schimbi ambianța camerei în funcție de momentul zilei sau de activitate, oferindu-ți controlul complet asupra atmosferei.\u003cbr\u003e\u003cbr\u003eCu un diametru de 60cm, Kylen este proporționată ideal pentru a adăuga un accent de eleganță în orice spațiu, fără a fi prea impunătoare. Designul său floral și materialul acrilic se potrivesc armonios într-o varietate de stiluri de interior, de la cele minimaliste la cele contemporane. Instalarea acestei lustre este simplă și rapidă, permițându-ți să te bucuri de noua ta sursă de lumină și de elementul de design în cel mai scurt timp. Indiferent de locul unde este amplasată, Kylen va adăuga un plus de lumină și eleganță.\u003cbr\u003e\u003cbr\u003eAlege lustra LED Kylen din gama Omid pentru a îmbunătăți orice cameră cu o lumină caldă și un design floral sofisticat. Sub lumina sa, fiecare colț al camerei va fi învăluit într-o atmosferă de vis și eleganță.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T17:12:49+02:00","created_at":"2025-02-24T17:12:48+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52038316687627,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19252\/3+3","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9757600874763,"created_at":"2025-08-05T15:23:45+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51816704508171,"created_at":"2025-02-24T17:12:52+02:00","position":1,"updated_at":"2025-02-24T17:12:54+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_07.webp?v=1740409974","width":900,"height":900},{"id":51816704409867,"created_at":"2025-02-24T17:12:52+02:00","position":2,"updated_at":"2025-02-24T17:12:54+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_02.webp?v=1740409974","width":900,"height":900},{"id":51816704475403,"created_at":"2025-02-24T17:12:52+02:00","position":3,"updated_at":"2025-02-24T17:12:54+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_03.webp?v=1740409974","width":900,"height":900},{"id":51816704311563,"created_at":"2025-02-24T17:12:52+02:00","position":4,"updated_at":"2025-02-24T17:12:54+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_04.webp?v=1740409974","width":900,"height":900},{"id":51816704442635,"created_at":"2025-02-24T17:12:52+02:00","position":5,"updated_at":"2025-02-24T17:12:54+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_05.webp?v=1740409974","width":900,"height":900},{"id":51816704540939,"created_at":"2025-02-24T17:12:52+02:00","position":6,"updated_at":"2025-02-24T17:12:55+02:00","product_id":9757600874763,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-deneris-144w-dimabila-alb-acril_LL256_06.webp?v=1740409975","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10976513982731,"title":"Lustra LED Ventilator ANEMO cu Telecomanda, 36W, D76.5cm, Lumina Rece\/Neutra\/Calda, Metal si Plastic, Negru","handle":"lustra-led-ventilator-anemo-cu-telecomanda-36w-d76-5cm-lumina-rece-neutra-calda-metal-si-plastic-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003chr\u003e\n\u003cp\u003eTransformă orice încăpere într-un spațiu modern și funcțional cu această lustră LED cu ventilator integrat și telecomandă. Concepută pentru a combina designul elegant cu utilitatea, oferă atât iluminare eficientă, cât și răcire discretă, într-un singur produs compact.\u003c\/p\u003e\n\u003cp\u003eCu un \u003cstrong\u003ediametru de 76.5 \u003c\/strong\u003ecm și finisaj negru mat, lustra se integrează perfect în interioare contemporane, fie că este vorba de living, dormitor sau birou.\u003c\/p\u003e\n\u003cp\u003eVentilatorul silențios asigură o circulație optimă a aerului, iar iluminarea LED de 36W permite alegerea temperaturii de culoare în funcție de momentul zilei sau atmosferă.\u003c\/p\u003e\n\u003cp\u003eControlul este simplu și rapid datorită telecomenzii incluse, care îți oferă acces la toate funcțiile fără efort.\u003c\/p\u003e✨ \u003cspan style=\"text-decoration: underline;\"\u003e\u003cstrong\u003eBeneficii principale:\u003c\/strong\u003e\u003c\/span\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e2 în 1:\u003c\/strong\u003e iluminare LED + ventilator integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTelecomandă inclusă:\u003c\/strong\u003e control facil al luminii și ventilatorului\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e3 tipuri de lumină:\u003c\/strong\u003e rece, neutră și caldă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEficiență energetică:\u003c\/strong\u003e consum redus de doar 36W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVentilator silențios:\u003c\/strong\u003e confort fără zgomot\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesign modern:\u003c\/strong\u003e finisaj negru elegant, potrivit pentru orice decor\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eAlege această lustră LED cu ventilator pentru un echilibru perfect între estetică, tehnologie și confort zilnic. Ideală pentru cei care își doresc un ambient plăcut, modern și eficient energetic.\u003cstrong\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic_7bd40fac-f842-40eb-8767-5d8091b2a033.webp?v=1777037376\"\u003e\u003c\/p\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0ec16c49-06e2-4a50-a751-a47b07e70ba2.webp?v=1777037375\"\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led_eb01595f-f014-453a-b6b0-e255cf96ad97.webp?v=1777037376\"\u003e\u003c\/div\u003e","published_at":"2026-06-15T14:33:09+03:00","created_at":"2026-06-09T17:39:24+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":53171515261195,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CF105\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"329.99","grams":0,"compare_at_price":"329.99","position":1,"product_id":10976513982731,"created_at":"2026-06-09T17:39:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69392378036491,"created_at":"2026-06-10T11:44:17+03:00","position":1,"updated_at":"2026-06-10T11:45:34+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_17_56_41.png?v=1781081134","width":1024,"height":1024},{"id":69392378986763,"created_at":"2026-06-10T11:44:26+03:00","position":2,"updated_at":"2026-06-10T11:49:15+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_17_56_41_f7e6d9ed-ce9b-41f7-a7d5-e9d924a94b0f.png?v=1781081355","width":1024,"height":1024},{"id":69392426533131,"created_at":"2026-06-10T11:49:24+03:00","position":3,"updated_at":"2026-06-10T11:51:17+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_17_56_41_e15782af-80f1-49de-ae91-9a0a4ea6c3bd.png?v=1781081477","width":1024,"height":1024},{"id":69392445079819,"created_at":"2026-06-10T11:51:29+03:00","position":4,"updated_at":"2026-06-10T11:53:15+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_17_56_41_f3de600a-70b0-4e30-aa9f-aa4052d603aa.png?v=1781081595","width":1024,"height":1024},{"id":69392445669643,"created_at":"2026-06-10T11:51:34+03:00","position":5,"updated_at":"2026-06-10T11:51:38+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_17_56_41_9bf5a12a-bf01-4e83-8354-f6591e6ea5ad.png?v=1781081498","width":1254,"height":1254},{"id":69392445636875,"created_at":"2026-06-10T11:51:34+03:00","position":6,"updated_at":"2026-06-10T11:51:38+03:00","product_id":10976513982731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage10iun.2026_11_45_34.png?v=1781081498","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10895681519883,"title":"Plafonieră PL154 LED 35 cm, 31W, 3000K \/ 4000K \/ 6000K, Alb, Metal si Acril","handle":"plafoniera-led-pl154-35-35-cm-32w-3000k-4000k-6000k-alb-metal-si-acril","body_html":"\u003cp\u003ePlafoniera LED cu diametrul de 35 cm este soluția ideală pentru iluminatul modern al locuinței. Cu un design simplu și finisaj alb elegant, aceasta se integrează ușor în orice tip de amenajare – de la spații rezidențiale până la birouri sau zone comerciale. Dimensiunea compactă o face potrivită pentru holuri, bucătării, băi, dormitoare sau camere de dimensiuni mici și medii.\u003c\/p\u003e\u003cp\u003eCu o putere de 31W, plafoniera oferă un flux luminos puternic și uniform, asigurând iluminare optimă cu un consum redus de energie. Tehnologia LED contribuie la economii semnificative la factura de electricitate și garantează o durată de viață îndelungată, fără costuri suplimentare de întreținere.\u003c\/p\u003e\u003cp\u003eModelul permite selectarea temperaturii de culoare între 3000K (lumină caldă), 4000K (lumină neutră) și 6000K (lumină rece), oferind flexibilitate în funcție de preferințe și de destinația spațiului. Poți crea o atmosferă relaxantă sau una energizantă, adaptată activităților zilnice.\u003c\/p\u003e\u003cp\u003eInstalarea este rapidă și simplă, iar dispersia uniformă a luminii elimină zonele umbrite sau efectul de orbire. Este o alegere practică și estetică pentru cei care caută un corp de iluminat eficient, durabil și versatil.\u003c\/p\u003e\u003chr\u003e\u003ch3\u003eSpecificații tehnice:\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eTip produs: Plafonieră LED\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003ePutere: 31W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eDiametru: 35 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eCuloare carcasă: Alb\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTemperatură culoare: 3000K \/ 4000K \/ 6000K\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eTehnologie: LED integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eMontaj: Aplicat pe tavan\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2026-03-31T12:21:51+03:00","created_at":"2026-02-26T12:53:04+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["Corpuri de Iluminat","Plafoniere LED"],"variants":[{"id":52932973134091,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-PL154\/35","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"59.79","grams":0,"compare_at_price":"69.99","position":1,"product_id":10895681519883,"created_at":"2026-02-26T12:53:05+02:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68966985105675,"created_at":"2026-05-19T15:33:15+03:00","position":1,"updated_at":"2026-05-19T15:39:44+03:00","product_id":10895681519883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/PL154_35_fff60ad5-f764-41a3-9925-82a44419f2f3.png?v=1779194384","width":1024,"height":1024},{"id":68966983663883,"created_at":"2026-05-19T15:33:02+03:00","position":2,"updated_at":"2026-05-19T15:37:47+03:00","product_id":10895681519883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/PL154_35_eba55a34-1a21-4dd4-b02e-ab83e28d9e8b.png?v=1779194267","width":1024,"height":1024},{"id":68966986416395,"created_at":"2026-05-19T15:33:27+03:00","position":3,"updated_at":"2026-05-19T15:45:45+03:00","product_id":10895681519883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/PL154_35_0427bab2-c8e4-48b3-a8ef-659b6ceed160.png?v=1779194745","width":1024,"height":1024},{"id":68966981665035,"created_at":"2026-05-19T15:32:59+03:00","position":4,"updated_at":"2026-05-19T15:33:02+03:00","product_id":10895681519883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage19mai2026_15_32_43.png?v=1779193982","width":1254,"height":1254},{"id":68966981697803,"created_at":"2026-05-19T15:32:59+03:00","position":5,"updated_at":"2026-05-19T15:33:03+03:00","product_id":10895681519883,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage19mai2026_15_20_34_705ababf-e7dd-476b-81a6-1070edef5adb.png?v=1779193983","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10514989121803,"title":"Lustra LED pentru copii FIGHTER, Tip avion, 101W, Lumina Rece\/Calda\/Neutra, Aripi mobile, Gri Aeronautic","handle":"lustra-led-fighter-101w-lumina-rece-calda-neutra-gri","body_html":"\u003cp data-end=\"112\" data-start=\"0\"\u003e\u003cstrong data-end=\"112\" data-start=\"0\"\u003eLustră LED pentru copii FIGHTER, tip avion, 101W, lumină caldă \/ neutră \/ rece, aripi mobile, gri aeronautic\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-end=\"412\" data-start=\"114\"\u003eLustra LED FIGHTER este un corp de iluminat modern și spectaculos, conceput special pentru camera copiilor, cu un design inspirat din avioanele de luptă. Forma de avion și finisajul gri aeronautic transformă lustra într-un element decorativ central, ideal pentru camere tematice și spații creative.\u003c\/p\u003e\u003cp data-end=\"412\" data-start=\"114\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-end=\"775\" data-start=\"414\"\u003eEste echipată cu bandă LED integrată și funcționează la o putere de 101W, oferind un flux luminos de 8080 lm, suficient pentru iluminarea eficientă a întregii încăperi. Lustra emite lumină caldă, neutră și rece, permițând adaptarea atmosferei în funcție de activitate și momentul zilei. Aripile mobile adaugă un element interactiv și dinamic, apreciat de copii.\u003c\/p\u003e\u003cp data-end=\"775\" data-start=\"414\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1220\" data-start=\"777\"\u003eConstrucția este realizată din metal și acril, asigurând durabilitate și stabilitate. Se montează pe tavan prin aplicare și funcționează la o tensiune de 220–230V. Dimensiunile sunt de 73 cm lungime, 46 cm lățime și 12 cm înălțime, fiind potrivită pentru camere de copii de dimensiuni medii și mari. Durata de viață a sursei LED este de aproximativ 25.000 de ore, iar gradul de protecție IP20 o recomandă pentru utilizare exclusiv la interior.\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-06-24T09:26:12+03:00","created_at":"2025-06-23T17:44:07+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre Copii","tags":["active","Corpuri de Iluminat","Lustre Copii","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52359986282763,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CP6741","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"799.99","grams":0,"compare_at_price":"899.99","position":1,"product_id":10514989121803,"created_at":"2025-09-12T13:42:59+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":56700969713931,"created_at":"2025-06-23T18:02:16+03:00","position":1,"updated_at":"2025-06-23T18:02:19+03:00","product_id":10514989121803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6741-LustraLEDFIGHTER_101W_luminaReceCaldaNeutra_Argintiu-1_b8c83d9e-8ccf-4bdb-81bc-9aa190e9f234.jpg?v=1750690939","width":1080,"height":1080},{"id":56700969779467,"created_at":"2025-06-23T18:02:17+03:00","position":2,"updated_at":"2025-06-23T18:02:19+03:00","product_id":10514989121803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6741-LustraLEDFIGHTER_101W_luminaReceCaldaNeutra_Argintiu-3_86d29e51-e0b2-446b-a77d-c8f9f1586ed1.jpg?v=1750690939","width":1080,"height":1080},{"id":56700969746699,"created_at":"2025-06-23T18:02:17+03:00","position":3,"updated_at":"2025-06-23T18:02:19+03:00","product_id":10514989121803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6741-LustraLEDFIGHTER_101W_luminaReceCaldaNeutra_Argintiu-2_e37916e6-bc98-489e-a128-6a7a663a435c.jpg?v=1750690939","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10223552790795,"title":"Lustra LED suspendata cu Telecomanda 103W, 5 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-suspendata-cu-telecomanda-rimini-103w-5-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp class=\"p1\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17.BANNER_f23c6d45-b0dd-42c3-9a68-7f03a840cdab.png?v=1778236568\" alt=\"\"\u003eLustra LED Rimini cu \u003cspan class=\"s1\"\u003e\u003cb\u003etelecomanda\u003c\/b\u003e\u003c\/span\u003e, putere de 103W si structura formata din 5 patrate geometrice ofera un iluminat puternic si controlabil, potrivit pentru incaperi generoase. Cu un flux luminos total de 8240lumeni, distribuie lumina uniform, fara zone intunecate, facand-o ideala ca \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru living\u003c\/b\u003e\u003c\/span\u003e, \u003cspan class=\"s1\"\u003e\u003cb\u003edormitor matrimonial\u003c\/b\u003e\u003c\/span\u003e sau \u003cspan class=\"s1\"\u003e\u003cb\u003ezona de dining\u003c\/b\u003e\u003c\/span\u003e.\u003c\/p\u003e\u003cp class=\"p1\"\u003eCu \u003cspan class=\"s1\"\u003e\u003cb\u003etelecomanda lustrei\u003c\/b\u003e\u003c\/span\u003e poti comuta rapid intre cele 3 temperaturi de culoare (3000K, 4000K, 6000K) si regla intensitatea in functie de moment – relaxare, lucru sau masa. Este o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED dimabila cu telecomanda 3 functii\u003c\/b\u003e\u003c\/span\u003e, ce functioneaza atat cu intrerupator clasic, cat si din telecomanda.\u003c\/p\u003e\u003cp class=\"p1\"\u003eDesignul aerisit in straturi patrate, combinat cu finisaje negre si elemente din acril, transforma acest model intr-o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED patrata\u003c\/b\u003e\u003c\/span\u003e care aduce un accent coerent si clar in spatiile mari. Recomandata ca \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED cu telecomanda\u003c\/b\u003e\u003c\/span\u003e, pentru cei care cauta eficienta, simplitate si o prezenta bine definita in decor.\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:27:02+03:00","created_at":"2025-06-06T12:36:07+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52429942554891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT335\/5BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"539.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10223552790795,"created_at":"2025-09-30T17:57:32+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":68771965632779,"created_at":"2026-05-08T13:36:02+03:00","position":1,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.COVER_bdd064dc-baa6-4fbd-8e3e-2cf0f62f0ef8.png?v=1778236566","width":1000,"height":1000},{"id":68771965665547,"created_at":"2026-05-08T13:36:02+03:00","position":2,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2.CLOSEUP_2502042a-0d53-4869-8ffc-d5ef4f68a86c.png?v=1778236566","width":1000,"height":1000},{"id":68771965698315,"created_at":"2026-05-08T13:36:02+03:00","position":3,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3.REMOTESHOW_c9fd032f-108d-43b2-b50b-814d1e3963f0.png?v=1778236566","width":1000,"height":1000},{"id":68771965731083,"created_at":"2026-05-08T13:36:02+03:00","position":4,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/4.STEPLESSDIMING_e2db489a-18e0-4f3b-aff7-88e075c4d0ae.png?v=1778236566","width":1000,"height":1000},{"id":68771965763851,"created_at":"2026-05-08T13:36:02+03:00","position":5,"updated_at":"2026-05-08T13:36:07+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5.3-TONECONTROL_8f13f12e-e156-46c8-b397-b88b6140d410.png?v=1778236567","width":1000,"height":1000},{"id":68771965796619,"created_at":"2026-05-08T13:36:02+03:00","position":6,"updated_at":"2026-05-08T13:36:07+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6.NIGHTLIGHT_5fbc1793-9e64-4293-a823-e8edec8eaad1.png?v=1778236567","width":1000,"height":1000},{"id":68771965829387,"created_at":"2026-05-08T13:36:02+03:00","position":7,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_8c706beb-8ec8-419d-ba2b-57dc7f2d0290.png?v=1778236566","width":1000,"height":1000},{"id":68771981295883,"created_at":"2026-05-08T13:39:04+03:00","position":8,"updated_at":"2026-05-08T13:39:10+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT1306WHspec_f76e5e90-f55b-4134-b045-e5e4fea3ba13.png?v=1778236750","width":4000,"height":4000},{"id":68771965894923,"created_at":"2026-05-08T13:36:02+03:00","position":9,"updated_at":"2026-05-08T13:36:07+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.PLACE1_373ac4df-276e-4540-b617-05b3cd0f134e.png?v=1778236567","width":1000,"height":1000},{"id":68771965927691,"created_at":"2026-05-08T13:36:02+03:00","position":10,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.PLACE2_e51265c3-9004-409d-bb41-0b6ba1f9d850.png?v=1778236566","width":1000,"height":1000},{"id":68771965960459,"created_at":"2026-05-08T13:36:02+03:00","position":11,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.PLACE3_1a805716-8f4c-45ea-a91b-e960256c7d2c.png?v=1778236566","width":1000,"height":1000},{"id":68771965993227,"created_at":"2026-05-08T13:36:02+03:00","position":12,"updated_at":"2026-05-08T13:36:06+03:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15.PLACE4_07a62ec7-3b55-4842-be9d-abba4b54bf64.png?v=1778236566","width":1000,"height":1000},{"id":62528619675915,"created_at":"2025-11-20T16:46:11+02:00","position":13,"updated_at":"2025-11-20T16:46:14+02:00","product_id":10223552790795,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT335_5BK_EPREL_98f73719-59d8-4e41-a446-b710a5e522de.png?v=1763649974","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760568934667,"title":"Lustra Cain 3x G9 Argintiu","handle":"lustra-cain-3x-g9-argintiu","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size:16px\"\u003eLustra Cain este o piesă de iluminat elegantă și modulară, perfectă pentru cei care apreciază designul personalizabil și finisajele moderne. Cu un aspect sofisticat în culoare argintiu, această lustră se distinge prin capacitatea de a transforma orice spațiu cu un joc de lumini și reflexii spectaculoase. Proiectată pentru utilizarea cu trei becuri tip G9, care nu sunt incluse, vă permite să alegeți opțiunile de iluminare ideale pentru a se potrivi cu atmosfera și decorul dumneavoastră (becurile trebuie achiziționate separat).\u003cbr\u003e \u003cbr\u003e Cu un diametru de 40cm și o înălțime de 50cm, Lustra Cain este proporționată ideal pentru a servi ca punct central într-o varietate de spații, de la sufragerii și dormitoare la birouri sau foyer-uri. Designul său unic include șiraguri de 'bănuți' din aluminiu care pot fi aranjate după bunul dvs. plac, oferindu-vă libertatea de a personaliza aspectul lustrei și de a crea diferite efecte vizuale.\u003cbr\u003e \u003cbr\u003e Această lustră nu este doar o sursă de iluminare, ci și o piesă de artă decorativă care poate adăuga o notă distinctă de stil oricărui interior. Fiecare șirag de aluminiu captează și reflectă lumina, creând un efect de strălucire și profunzime care poate îmbunătăți instantaneu aspectul unei încăperi.\u003cbr\u003e \u003cbr\u003e Instalarea Lustrei Cain este simplă și ușor de realizat, făcând din actualizarea decorului dvs. o experiență fără bătăi de cap. Alegeți această lustră pentru a aduce un element de rafinament în casa dvs. și pentru a crea un mediu luminos care este atât practic, cât și încântător estetic.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:52:38+02:00","created_at":"2025-02-25T02:52:37+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"","tags":["active","Corpuri de Iluminat","Lustre Clasice","Lustre cu bec","Lustre Moderne"],"variants":[{"id":52409390498059,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-9095\/400CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"389.99","grams":0,"compare_at_price":"389.99","position":1,"product_id":9760568934667,"created_at":"2025-09-24T18:14:25+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51851328553227,"created_at":"2025-02-25T02:52:39+02:00","position":1,"updated_at":"2025-02-25T02:52:41+02:00","product_id":9760568934667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-cain-3x-g9-argintiu-1700821558.webp?v=1740444761","width":900,"height":900},{"id":51851328717067,"created_at":"2025-02-25T02:52:39+02:00","position":2,"updated_at":"2025-02-25T02:52:41+02:00","product_id":9760568934667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-cain-3xg9-argintiu_9095-400cr_02-1700821559.webp?v=1740444761","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760018399499,"title":"Lustra LED cu telecomanda si cristal BLAKELY RGB 163W, 8 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-blakely-rgb-163w-8-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cristal RGB Kyomi reprezintă un amestec impresionant de design artistic și funcționalitate tehnologică avansată. Cu o putere remarcabilă de 163W și un design atrăgător în negru, această lustră este perfectă pentru a adăuga un strop de eleganță și modernitate în orice spațiu interior. Designul unic al lustrei Kyomi constă într-o serie de opt pătrate - patru de dimensiuni mai mari și patru mai mici - fiecare împodobit cu cristale transparente. Această structură complexă creează un efect vizual captivant și dinamic, în timp ce cristalele refractă lumina pentru a produce scânteieri și străluciri care adaugă un nivel de rafinament și lux.\u003cbr\u003e\u003cbr\u003eInclusiv tehnologia LED RGB, controlabilă prin telecomandă, aduce un plus de versatilitate acestei lustre. Aveți posibilitatea de a schimba între trei tipuri de lumină – caldă, rece și neutră – și de a ajusta culoarea și intensitatea luminii după preferințe. Funcția de dimare a lustrei permite crearea unei atmosfere perfecte pentru diferite ocazii sau momente ale zilei. Cu un flux luminos impresionant de 13040lm, lustra LED Cristal RGB Kyomi asigură o iluminare puternică și eficientă, fiind ideală pentru spații ample precum livinguri mari, săli de mese sau spații comerciale. Eficiența energetică a tehnologiei LED face din această lustră o opțiune economică și ecologică pe termen lung.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal RGB Kyomi este alegerea ideală pentru cei care caută un echilibru între un design inovator, funcționalitatea modernă și eficiența energetică. Este soluția perfectă pentru a adăuga un element de iluminat sofisticat și versatil în orice ambient, oferind un iluminat de calitate superioară care să îmbunătățească aspectul și atmosfera oricărui interior.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T01:23:18+02:00","created_at":"2025-02-25T01:23:17+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365396345099,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7965\/4+4BK+CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"592.00","grams":0,"compare_at_price":"592.00","position":1,"product_id":9760018399499,"created_at":"2025-09-13T13:45:50+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51841512898827,"created_at":"2025-02-25T01:23:19+02:00","position":1,"updated_at":"2025-02-25T01:23:20+02:00","product_id":9760018399499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-cu-telecomanda-kyomi-163w-dimabila-alb-negru-1686901483.webp?v=1740439400","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759477039371,"title":"Grila LED Magnetica, Fixa, 6W, Lumina Neutra, Incastrata, Negru","handle":"grila-led-magnetica-fixa-6w-lumina-neutra-incastrata-negru","body_html":"\u003cstrong\u003e\u003cspan style=\"font-size:16px\"\u003e\u003cspan style=\"font-family:verdana,geneva,sans-serif\"\u003eGrila LED nu contine alimentator! Acesta se achizitioneaza separat!\u003c\/span\u003e\u003c\/span\u003e\u003c\/strong\u003e","published_at":"2025-02-24T23:53:00+02:00","created_at":"2025-02-24T23:52:59+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Produse LED","tags":["active","Corpuri de Iluminat","Produse LED","Proiectoare sina magnetica"],"variants":[{"id":52408572772619,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-KFQ20GS6","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"69.99","grams":0,"compare_at_price":"69.99","position":1,"product_id":9759477039371,"created_at":"2025-09-24T14:13:13+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51833239404811,"created_at":"2025-02-24T23:53:02+02:00","position":1,"updated_at":"2025-02-24T23:53:03+02:00","product_id":9759477039371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/grila-led-magnetica-fixa-6w-lumina-neutra-incastrata-negru_AT1CT-CH1A-HT2L-KFQ20GS6_01.webp?v=1740433983","width":900,"height":900},{"id":51833239372043,"created_at":"2025-02-24T23:53:02+02:00","position":2,"updated_at":"2025-02-24T23:53:03+02:00","product_id":9759477039371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/grila-led-magnetica-fixa-6w-lumina-neutra-incastrata-negru_AT1CT-CH1A-HT2L-KFQ20GS6_02.webp?v=1740433983","width":900,"height":900},{"id":51833239437579,"created_at":"2025-02-24T23:53:02+02:00","position":3,"updated_at":"2025-02-24T23:53:03+02:00","product_id":9759477039371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/grila-led-magnetica-fixa-6w-lumina-neutra-incastrata-negru_AT1CT-CH1A-HT2L-KFQ20GS6_03.webp?v=1740433983","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759397478667,"title":"Lustra LED cu telecomanda si cristal GRACIANA 168W, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-graciana-168w-liniara-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cp data-sourcepos=\"1:1-1:286\"\u003eLustra LED suspendată cu telecomandă și cristale GRACIANA este o piesă de iluminat elegantă și modernă, cu un design liniar și un finisaj crom lucios, împodobit cu cristale strălucitoare. Cu o putere impresionantă de 168W, oferă o iluminare amplă și un plus de rafinament spațiului tău.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:626\"\u003eForma liniară sugerează o distribuție uniformă a luminii pe o anumită lungime, perfectă pentru deasupra meselor lungi, insulelor de bucătărie sau în livinguri spațioase. Cristalele vor reflecta și refracta lumina LED integrată, creând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), permițându-ți să personalizezi iluminarea. Finisajul crom lucios accentuează strălucirea cristalelor și adaugă o notă contemporană și sofisticată designului. Fiind suspendată, va deveni un punct focal elegant în încăpere.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:42:48+02:00","created_at":"2025-02-24T23:42:47+02:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365376848139,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-JB003\/6","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"499.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9759397478667,"created_at":"2025-09-13T13:36:20+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":51832461590795,"created_at":"2025-02-24T23:42:49+02:00","position":1,"updated_at":"2025-02-24T23:42:50+02:00","product_id":9759397478667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-graciana-telecomanda-168w-argintiu_AT1CT-VV1A-HT2L-JB003-6_01.webp?v=1740433370","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10977222361355,"title":"Lustra LED Ventilator DAFIA cu Telecomanda, 49W, D85cm, Lumina Rece\/Neutra\/Calda, Metal si Plastic, Alb","handle":"lustra-led-ventilator-dafia-cu-telecomanda-30w-d61cm-lumina-rece-neutra-calda-metal-si-plastic-negru-copie","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003chr\u003e\n\u003cp\u003eTransformă orice încăpere într-un spațiu modern și funcțional cu această lustră LED cu ventilator integrat și telecomandă. Concepută pentru a combina designul elegant cu utilitatea, oferă atât iluminare eficientă, cât și răcire discretă, într-un singur produs compact.\u003c\/p\u003e\n\u003cp\u003eCu un \u003cstrong\u003ediametru de 85 \u003c\/strong\u003ecm și finisaj alb mat, lustra se integrează perfect în interioare contemporane, fie că este vorba de living, dormitor sau birou.\u003c\/p\u003e\n\u003cp\u003eVentilatorul silențios asigură o circulație optimă a aerului, iar iluminarea LED de \u003cstrong\u003e49W \u003c\/strong\u003epermite alegerea temperaturii de culoare în funcție de momentul zilei sau atmosferă.\u003c\/p\u003e\n\u003cp\u003eControlul este simplu și rapid datorită telecomenzii incluse, care îți oferă acces la toate funcțiile fără efort.\u003c\/p\u003e✨ \u003cspan style=\"text-decoration: underline;\"\u003e\u003cstrong\u003eBeneficii principale:\u003c\/strong\u003e\u003c\/span\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e2 în 1:\u003c\/strong\u003e iluminare LED + ventilator integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTelecomandă inclusă:\u003c\/strong\u003e control facil al luminii și ventilatorului\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e3 tipuri de lumină:\u003c\/strong\u003e rece, neutră și caldă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEficiență energetică:\u003c\/strong\u003e consum redus de doar 49W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVentilator silențios:\u003c\/strong\u003e confort fără zgomot\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesign modern:\u003c\/strong\u003e finisaj alb elegant, potrivit pentru orice decor\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eAlege această lustră LED cu ventilator pentru un echilibru perfect între estetică, tehnologie și confort zilnic. Ideală pentru cei care își doresc un ambient plăcut, modern și eficient energetic.\u003cstrong\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic_7bd40fac-f842-40eb-8767-5d8091b2a033.webp?v=1777037376\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0ec16c49-06e2-4a50-a751-a47b07e70ba2.webp?v=1777037375\" alt=\"\"\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led_eb01595f-f014-453a-b6b0-e255cf96ad97.webp?v=1777037376\" alt=\"\"\u003e\u003c\/div\u003e","published_at":"2026-06-15T14:34:27+03:00","created_at":"2026-06-10T11:10:04+03:00","updated_at":"2026-09-14T13:11:26+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":53173243674891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CF101\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"289.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":10977222361355,"created_at":"2026-06-10T11:10:05+03:00","updated_at":"2026-09-14T13:11:26+03:00"}],"images":[{"id":69392252764427,"created_at":"2026-06-10T11:15:21+03:00","position":1,"updated_at":"2026-06-10T11:21:24+03:00","product_id":10977222361355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_fdddf39d-4543-4b7e-820d-6a86c2ba4a4b.png?v=1781079684","width":1024,"height":1024},{"id":69392292970763,"created_at":"2026-06-10T1