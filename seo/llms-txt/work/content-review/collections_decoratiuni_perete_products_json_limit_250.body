s(+br)]:inline-block [\u0026amp;_strong:has(+br)]:align-top\"\u003eIluminarea LED integrată de 24W, cu lumină neutră, oferă o atmosferă plăcută și echilibrată, evidențiind subtil detaliile tabloului fără a deranja privirea. Realizat din sticlă, aliaj de aluminiu și MDF, produsul îmbină un aspect rafinat cu o structură stabilă și rezistentă. Este alegerea potrivită pentru interioare moderne, minimaliste sau contemporane.\u003c\/p\u003e","published_at":"2026-08-26T15:56:58+03:00","created_at":"2026-08-25T16:33:51+03:00","updated_at":"2026-09-14T13:12:59+03:00","vendor":"Alessandro Design","product_type":"Tablou LED","tags":[],"variants":[{"id":53322198057227,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-JW014","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"569.99","grams":0,"compare_at_price":"669.99","position":1,"product_id":11026732974347,"created_at":"2026-08-25T16:33:52+03:00","updated_at":"2026-09-14T13:12:59+03:00"}],"images":[{"id":69980998598923,"created_at":"2026-08-25T16:37:54+03:00","position":1,"updated_at":"2026-08-25T16:43:33+03:00","product_id":11026732974347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Tablou_Sticla_cu_iluminare_LED_Planeta_Albastra_Diametru_80_cm_24W_Lumina_Neutra_Aliaj_de_Aluminiu_si_MDF_1.png?v=1787665413","width":1254,"height":1254},{"id":69972689551627,"created_at":"2026-08-24T16:18:35+03:00","position":2,"updated_at":"2026-08-25T16:44:53+03:00","product_id":11026732974347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Tablou_Sticla_cu_iluminare_LED_Planeta_Albastra_Diametru_80_cm_24W_Lumina_Neutra_Aliaj_de_Aluminiu_si_MDF_2.png?v=1787665493","width":1254,"height":1254},{"id":69971948994827,"created_at":"2026-08-24T14:12:08+03:00","position":3,"updated_at":"2026-08-25T16:45:02+03:00","product_id":11026732974347,"variant_ids":[],"src":"https:\/\/cdn