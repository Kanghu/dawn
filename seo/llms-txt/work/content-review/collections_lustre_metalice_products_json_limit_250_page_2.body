8771494068491,"created_at":"2026-05-08T12:16:43+03:00","position":6,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.SPECIFICATION_f5bfa218-7c18-4d6e-9896-eb3cad9dda39.png?v=1778231808","width":1000,"height":1000},{"id":68771493871883,"created_at":"2026-05-08T12:16:43+03:00","position":7,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2.CLOSEUP_2168e003-a48c-4cc5-8b03-9daafd110f30.png?v=1778231808","width":1000,"height":1000},{"id":68771494101259,"created_at":"2026-05-08T12:16:43+03:00","position":8,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.PLACE1_539b2153-1cba-4861-a82e-b716691210e8.png?v=1778231808","width":1000,"height":1000},{"id":68771494134027,"created_at":"2026-05-08T12:16:43+03:00","position":9,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.PLACE2_7330f3cc-fbf7-40a7-8708-c73db90838cb.png?v=1778231808","width":1000,"height":1000},{"id":68771494166795,"created_at":"2026-05-08T12:16:43+03:00","position":10,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.PLACE3_7979785e-bf83-4947-96f8-8f8b5c1028aa.png?v=1778231808","width":1000,"height":1000},{"id":68771494199563,"created_at":"2026-05-08T12:16:43+03:00","position":11,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15.PLACE4_0622412d-bd9d-4b70-a94b-166ab90c2d5e.png?v=1778231808","width":1000,"height":1000},{"id":68771494035723,"created_at":"2026-05-08T12:16:43+03:00","position":12,"updated_at":"2026-05-08T12:16:48+03:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_d9e1946b-fb91-4264-9c48-7c15bbac62ed.png?v=1778231808","width":1000,"height":1000},{"id":62998794076427,"created_at":"2025-12-04T14:08:16+02:00","position":13,"updated_at":"2025-12-08T12:22:11+02:00","product_id":9757492412683,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT800_6WH_EPREL.png?v=1765189331","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757822353675,"title":"Lustra LED cu telecomanda BETTY 82W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-betty-82w-6-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Banner_abce45ac-ecc7-45ae-af80-824993fcc9d9.jpg?v=1773138414\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/span\u003e\u003cbr\u003e \u003cspan style=\"font-size: 16px;\"\u003eModelul corpului de iluminat este creat cu ajutorul a \u003cstrong\u003esase cercuri\u003c\/strong\u003e, poziționate în direcții și la înălțimi diferite, care creează un efect asimetric dar totodată plăcut vizual. Fiecare cerc are încorporată o \u003cstrong\u003esursă de iluminare creată din bandă LED\u003c\/strong\u003e.\u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eBenzile LED sunt cunoscute pentru beneficiile financiare pe care le aduc, având în vedere că \u003cstrong\u003eprodusele bazate pe această tehnologie sunt mult mai rezistente și consumă mai putin curent electric, fiind foarte economice\u003c\/strong\u003e.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/span\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra Cerc are o \u003cstrong\u003eputere de 82W\u003c\/strong\u003e și este controlată cu ajutorul unei telecomenzi- poți aprinde\/stinge lumina, ajusta intestentitatea acesteia, schimba tonul de culoare după bunul plac dintre Cald, Neutru, Rece.\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/IN_VS_LED.jpg?v=1773087323\"\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003cem\u003e\u003cspan style=\"font-size: 24px;\"\u003e\u003cstrong\u003e\u003c\/strong\u003e\u003c\/span\u003e\u003c\/em\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto;\"\u003e\u003ca class=\"video-link\" href=\"https:\/\/www.youtube.com\/watch?v=TSpcYTGfbuQ\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg alt=\"YouTube video thumbnail\" src=\"https:\/\/img.youtube.com\/vi\/TSpcYTGfbuQ\/maxresdefault.jpg\"\u003e\u003c\/a\u003e\u003c\/div\u003e","published_at":"2025-02-24T18:32:35+02:00","created_at":"2025-02-24T18:32:34+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429930791179,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":9757822353675,"created_at":"2025-09-30T17:55:53+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":67109810077963,"created_at":"2026-03-10T12:25:16+02:00","position":1,"updated_at":"2026-03-10T12:27:44+02:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1_b8f1b1bf-4d43-4ad3-a81b-9b099d22733d.jpg?v=1773138464","width":3999,"height":3999},{"id":67109809455371,"created_at":"2026-03-10T12:24:50+02:00","position":2,"updated_at":"2026-03-10T12:27:44+02:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3._Stepless_Diming_ac617fa3-7d1b-4a0f-a9fe-ea499893f7a