pan\u003e, se montează discret pe tavan, oferind o soluție de iluminat puternică fără a încărca vizual spațiul.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:179\"\u003eLustra Joom nu doar lumineaza functional, ci redefineste modul in care percepi lumina in spatiul tau, oferind un control precis asupra atmosferei si un accent stilistic impecabil.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-gu10.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2026-07-02T16:49:53+03:00","created_at":"2026-07-02T16:24:54+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu bec","Lustre cu bec moderne","Plafoniere LED"],"variants":[{"id":53216969752843,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC500\/1BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"59.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":10992863084811,"created_at":"2026-07-02T16:24:55+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69654040576267,"created_at":"2026-07-02T16:25:29+03:00","position":1,"updated_at":"2026-07-02T16:40:13+03:00","product_id":10992863084811,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Joom_cu_Proiector_1XGU10_Negru_1.jpg?v=1782999613","width":1280,"height":1280},{"id":69654068560139,"created_at":"2026-07-02T16:36:16+03:00","position":2,"updated_at":"2026-07-02T16:40:22+03:00","product_id":10992863084811,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_Joom_cu_Proiector_1XGU10_Negru_2.png?v=1782999622","width":1254,"height":1254},