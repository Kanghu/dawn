_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-06-10T12:51:55+03:00","created_at":"2026-06-08T16:47:01+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":53166799421707,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL726GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":10975130124555,"created_at":"2026-06-08T16:47:02+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69361735631115,"created_at":"2026-06-08T16:50:50+03:00","position":1,"updated_at":"2026-06-08T16:59:13+03:00","product_id":10975130124555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL726GD.png?v=1780927153","width":1024,"height":1024},{"id":69361737662731,"created_at":"2026-06-08T16:51:21+03:00","position":2,"updated_at":"2026-06-08T17:01:12+03:00","product_id":10975130124555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL726GD_d54d7f0d-4259-4163-981b-9652262816d0.png?v=1780927272","width":1024,"height":1024},{"id":69361737367819,"created_at":"2026-06-08T16:51:20+03:00","position":3,"updated_at":"2026-06-08T17:00:11+03:00","product_id":10975130124555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL726GD_2de9a46d-28f2-4bfb-a003-5945240eb650.png?v=1780927211","width":1024,"height":1024},{"id":69361787568395,"created_at":"2026-06-08T17:05:21+03:00","position":4,"updated_at":"2026-06-08T17:05:25+03:00","product_id":10975130124555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iun.2026_17_04_51.png?v=1780927525","width":1254,"height":