,"height":3999},{"id":67109808898315,"created_at":"2026-03-10T12:24:35+02:00","position":9,"updated_at":"2026-04-02T00:30:21+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_1_6d905fa8-fc71-458d-9634-aa5d0d74d0ef.jpg?v=1775079021","width":3999,"height":3999},{"id":67109808996619,"created_at":"2026-03-10T12:24:39+02:00","position":10,"updated_at":"2026-04-02T00:30:21+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_f28dee1f-033a-42e2-b4ba-82a1b64eb88d.jpg?v=1775079021","width":3999,"height":3999},{"id":67109809225995,"created_at":"2026-03-10T12:24:48+02:00","position":11,"updated_at":"2026-04-02T00:30:21+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_e20eb561-d48c-4199-9d1b-abfc5a905a34.jpg?v=1775079021","width":3999,"height":3999},{"id":67109809357067,"created_at":"2026-03-10T12:24:49+02:00","position":12,"updated_at":"2026-04-02T00:30:21+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._Place_2_fef93aba-f8eb-41d0-8ce9-85da1515edce.jpg?v=1775079021","width":3999,"height":3999},{"id":67109808111883,"created_at":"2026-03-10T12:24:17+02:00","position":13,"updated_at":"2026-04-02T00:30:21+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6._Size_ffebe436-fcd3-426e-a3ea-9f1c9b53e92c.jpg?v=1775079021","width":3999,"height":3999},{"id":69157060870411,"created_at":"2026-05-28T10:21:36+03:00","position":14,"updated_at":"2026-05-28T10:21:38+03:00","product_id":9757822353675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2522349_big_color.png?v=1779952898","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756832891147,"title":"Lustra LED NEXA 3D, 20W, Diametru 24cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-nexa-3d-20w-diametru-24cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:323\"\u003e\u003cstrong\u003eLustra LED DARLENE 3D\u003c\/strong\u003e este o piesă de iluminat modernă și compactă, cu o putere de \u003cstrong\u003e20W \u003c\/strong\u003eși un diametru de\u003cstrong\u003e 24cm.\u003c\/strong\u003e Designul său alb include un efect vizual tridimensional, adăugând un element de interes spațiului. De asemenea, oferă posibilitatea de a alege între lumină rece, caldă sau neutră, adaptându-se preferințelor tale.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:377\"\u003eEfectul 3D, combinat cu forma probabil rotundă (având în vedere diametrul specificat) și dimensiunea de 24cm, ar putea crea un punct focal intrigant, chiar și într-un spațiu restrâns. Cu o putere de \u003cstrong\u003e20W\u003c\/strong\u003e, ar fi potrivită pentru a ilumina zone mai mici, cum ar fi holuri, băi, dresinguri sau ca iluminat suplimentar. Finisajul alb îi conferă un aspect curat și ușor de integrat.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T12:18:35+02:00","created_at":"2025-02-24T12:18:35+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52423998996747,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL436\/3D","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9756832891147,"created_at":"2025-09-29T12:45:18+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51810522824971,"created_at":"2025-02-24T12:18:37+02:00","position":1,"updated_at":"2025-06-16T10:52:52+03:00","product_id":9756832891147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL4363D-Lustra_LED_NEXA_3D_24W_Diametru_24cm_lumina_Rece_Calda_Neutra_Alb-1.webp?v=1750060372","width":900,"height":900},{"id":51810522398987,"created_at":"2025-02-24T12:18:37+02:00","position":2,"updated_at":"2025-06-16T10:53:07+03:00","product_id":9756832891147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL4363D-Lustra_LED_NEXA_3D_24W_Diametru_24cm_lumina_Rece_Calda_Neutra_Alb-2.webp?v=1750060387","width":900,"height":900},{"id":51810522890507,"created_at":"2025-02-24T12:18:37+02:00","position":3,"updated_at":"2025-06-16T10:53:16+03:00","product_id":9756832891147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL4363D-Lustra_LED_NEXA_3D_24W_Diametru_24cm_lumina_Rece_Calda_Neutra_Alb-3.webp?v=1750060396","width":900,"height":900},{"id":51810522857739,"created_at":"2025-02-24T12:18:37+02:00","position":4,"updated_at":"2025-06-16T10:53:27+03:00","product_id":9756832891147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL4363D-Lustra_LED_NEXA_3D_24W_Diametru_24cm_lumina_Rece_Calda_Neutra_Alb-4.webp?v=1750060407","width":900,"height":900},{"id":63187622985995,"created_at":"2025-12-09T13:49:36+02:00","position":5,"updated_at":"2025-12-09T13:49:40+02:00","product_id":9756832891147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL436_3D_EPREL.png?v=1765280980","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757572464907,"title":"Lustra LED NEXA 3D 39W, Diametru 25cm, lumina Rece\/Calda\/Neutra , Alb","handle":"lustra-led-nexa-3d-39w-diametru-265cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-start=\"87\" data-end=\"467\"\u003e\u003cstrong data-start=\"87\" data-end=\"109\"\u003eLustra LED NEXA 3D\u003c\/strong\u003e este un corp de iluminat modern și compact, cu o putere de 39W și un diametru de 23 cm. Designul alb este completat de un efect vizual tridimensional care creează profunzime și transformă lustra într-un element decorativ în sine. Poate genera trei tipuri de lumină – \u003cstrong data-start=\"377\" data-end=\"403\"\u003erece, caldă sau neutră\u003c\/strong\u003e – pentru a se adapta perfect preferințelor și momentelor zilei.\u003c\/p\u003e\u003cp data-start=\"87\" data-end=\"467\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"469\" data-end=\"806\"\u003eEfectul 3D, împreună cu forma rotundă și dimensiunile reduse, o face ideală ca punct focal într-un spațiu mic sau ca sursă suplimentară de lumină în încăperi mai mari. Cei 39W oferă iluminare suficientă pentru holuri, băi, dressinguri, balcon sau zone de trecere. Finisajul alb îi permite să se integreze ușor în orice stil de amenajare.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:348\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T17:02:46+02:00","created_at":"2025-02-24T17:02:45+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52383093457163,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL431\/3D","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9757572464907,"created_at":"2025-09-18T21:07:25+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":62945724203275,"created_at":"2025-12-02T14:45:08+02:00","position":1,"updated_at":"2026-07-20T17:55:57+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_1.png?v=1784559357","width":1600,"height":1600},{"id":62945746747659,"created_at":"2025-12-02T14:48:22+02:00","position":2,"updated_at":"2026-07-20T17:56:38+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_5.png?v=1784559398","width":1586,"height":1586},{"id":63032285692171,"created_at":"2025-12-05T12:43:23+02:00","position":3,"updated_at":"2026-07-20T17:56:49+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_6.png?v=1784559409","width":2000,"height":2000},{"id":62945727611147,"created_at":"2025-12-02T14:45:31+02:00","position":4,"updated_at":"2026-07-20T17:56:59+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_6.jpg?v=1784559419","width":1000,"height":1000},{"id":62945727512843,"created_at":"2025-12-02T14:45:31+02:00","position":5,"updated_at":"2026-07-20T17:56:06+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_2.jpg?v=1784559366","width":1000,"height":1000},{"id":65641823174923,"created_at":"2026-02-12T16:51:11+02:00","position":6,"updated_at":"2026-07-20T17:57:20+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_8.webp?v=1784559440","width":1000,"height":1000},{"id":62945727480075,"created_at":"2025-12-02T14:45:31+02:00","position":7,"updated_at":"2026-07-20T17:57:07+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb7.jpg?v=1784559427","width":1000,"height":1000},{"id":51816526905611,"created_at":"2025-02-24T17:02:47+02:00","position":8,"updated_at":"2026-07-20T17:56:17+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_3.webp?v=1784559377","width":900,"height":900},{"id":62528706806027,"created_at":"2025-11-20T17:01:16+02:00","position":9,"updated_at":"2026-07-20T17:57:32+03:00","product_id":9757572464907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_NEXA_3D_39W_Diametru_25cm_lumina_Rece_Calda_Neutra_Alb_9.png?v=1784559452","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757540712715,"title":"Lustra LED cu telecomanda LYRA 100W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Periat","handle":"lustra-led-cu-telecomanda-lyra-100w-3-cercuri-lumina-rece-calda-neutra-dimabila-auriu-periat","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eTransformați orice cameră într-o operă de artă cu Lustra LED LYRA, o combinație armonioasă de design geometric și funcționalitate avansată. Cu o putere de 100W și un design elegant în nuanțe de auriu, această lustră modernă în formă de cerc, cu un diametru de 70cm, este ideală pentru a adăuga un strop de rafinament în orice spațiu. \u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eUnul dintre cele mai mari avantaje ale Lustrei LED LYRA este controlul facil prin telecomandă. Aceasta nu doar că permite ajustarea intensității luminii, dar oferă și posibilitatea de a schimba tipul de lumină dispersat - caldă (3000K), neutră (4000K) sau rece (6000K) - cu o simplă apăsare de buton. Această funcție dimabilă și versatilitatea în alegerea tipului de lumină fac din LYRA o soluție ideală pentru orice situație, fie că doriți o lumină relaxantă pentru serile liniștite acasă sau o iluminare mai intensă și concentrată pentru activități.\u003cbr\u003e\u003cbr\u003eCu un flux luminos de 8000lm și o durată de viață impresionantă de până la 25000 de ore, această lustră nu este doar un element decorativ deosebit, ci și o alegere practică și durabilă. Eficiența sa energetică și capacitatea de a se adapta la diferite nevoi de iluminare fac din LYRA o investiție inteligentă pentru orice locuință sau spațiu comercial.\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED LYRA pentru a beneficia de avantajele controlului prin telecomandă, de versatilitatea în ajustarea luminii și de un design geometric impresionant. Este o alegere elegantă și practică, perfectă pentru a aduce un plus de stil și confort în orice ambient.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:50:02+02:00","created_at":"2025-02-24T16:50:01+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52424434057483,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-162\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"479.99","grams":0,"compare_at_price":"479.99","position":1,"product_id":9757540712715,"created_at":"2025-09-29T15:35:23+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51816330526987,"created_at":"2025-02-24T16:50:04+02:00","position":1,"updated_at":"2025-02-24T16:50:07+02:00","product_id":9757540712715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-lieu-182w-dimabila-acril-auriu_LL146_01.webp?v=1740408607","width":900,"height":900},{"id":51816330395915,"created_at":"2025-02-24T16:50:04+02:00","position":2,"updated_at":"2025-02-24T16:50:06+02:00","product_id":9757540712715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-lieu-182w-dimabila-acril-auriu_LL146_02.webp?v=1740408606","width":900,"height":900},{"id":51816330330379,"created_at":"2025-02-24T16:50:04+02:00","position":3,"updated_at":"2025-02-24T16:50:06+02:00","product_id":9757540712715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-lieu-182w-dimabila-acril-auriu_LL146_03.webp?v=1740408606","width":900,"height":900},{"id":51816330363147,"created_at":"2025-02-24T16:50:04+02:00","position":4,"updated_at":"2025-02-24T16:50:06+02:00","product_id":9757540712715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-lieu-182w-dimabila-acril-auriu_LL146_04.webp?v=1740408606","width":900,"height":900},{"id":51816330428683,"created_at":"2025-02-24T16:50:04+02:00","position":5,"updated_at":"2025-02-24T16:50:06+02:00","product_id":9757540712715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-lieu-182w-dimabila-acril-auriu_LL146_05.webp?v=1740408606","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759550275851,"title":"Lustra LED cu telecomanda si cristal MISEL 168W, 9 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu","handle":"lustra-led-cu-telecomanda-si-cristal-misel-168w-9-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu","body_html":"\u003cp data-sourcepos=\"1:1-1:287\"\u003eLustra LED cu telecomandă și cristale MISEL este o piesă de iluminat opulentă și modernă, cu o putere impresionantă de 168W. Designul său include 9 elemente, probabil brațe sau forme stilizate, finisate într-o combinație elegantă de negru și auriu, și decorate cu cristale strălucitoare.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:402\"\u003eCele nouă elemente, îmbogățite cu cristale, vor reflecta și refracta lumina LED integrată, creând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control total asupra iluminării: poți alege între lumină rece, caldă sau neutră, și poți ajusta intensitatea luminii cu funcția de dimare. Combinația de negru și auriu adaugă un contrast sofisticat și o notă de eleganță designului.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:211\"\u003eCu o putere de 168W, această lustră este ideală pentru a ilumina livinguri mari, sufragerii sau alte spații ample unde se dorește un element de design statement și o sursă de lumină puternică și personalizabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:03:10+02:00","created_at":"2025-02-25T00:03:10+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52427776491787,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-L7821\/5+4BK+GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"659.99","grams":0,"compare_at_price":"659.99","position":1,"product_id":9759550275851,"created_at":"2025-09-30T10:25:39+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51834011910411,"created_at":"2025-02-25T00:03:12+02:00","position":1,"updated_at":"2025-02-25T00:03:14+02:00","product_id":9759550275851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-misel-168w-auriu-negru_1760_04.webp?v=1740434594","width":900,"height":900},{"id":51834011484427,"created_at":"2025-02-25T00:03:12+02:00","position":2,"updated_at":"2025-02-25T00:03:14+02:00","product_id":9759550275851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-misel-168w-auriu-negru_1760_02.webp?v=1740434594","width":900,"height":900},{"id":51834012041483,"created_at":"2025-02-25T00:03:12+02:00","position":3,"updated_at":"2025-02-25T00:03:14+02:00","product_id":9759550275851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-misel-168w-auriu-negru_1760_03.webp?v=1740434594","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757572661515,"title":"Lustra LED cu telecomanda ALANI 168W, 6 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-alani-168w-6-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003eAleha\u003c\/strong\u003e este o \u003cstrong\u003elustra cu cercuri\u003c\/strong\u003e prevazuta cu 6 surse de iluminat, dotate cu \u003cstrong\u003ebanda LED\u003c\/strong\u003e. Fiind un \u003cstrong\u003ecorp de iluminat suspendat\u003c\/strong\u003e cu lungimea de \u003cstrong\u003e50 cm\u003c\/strong\u003e, putem spune ca este mai mult decat potrivit pentru incaperile voluminoase, precum livingul. Deoarece prezinta capacitatea de a ilumina folosindu-se de puterea ce insumeaza \u003cstrong\u003e168W\u003c\/strong\u003e, dispersarea luminii pe toata dimensiunea camerei este asigurata in permanenta.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eLustra cu telecomanda\u003c\/strong\u003e este fabricata din materiale sustenabile, cum ar fi \u003cstrong\u003emetal\u003c\/strong\u003e sau \u003cstrong\u003eacril\u003c\/strong\u003e, astfel ca rezistenta acestei lustre este de necontestat. Tipul de alimentare este \u003cstrong\u003ela retea\u003c\/strong\u003e, iar in ceea ce priveste tensiunea de alimentare a lustrei, aceasta este cuprinsa intre \u003cstrong\u003e220-230V\u003c\/strong\u003e. \u003cbr\u003e\u003cbr\u003eSetul de\u003cstrong\u003e benzi de iluminat cu leduri\u003c\/strong\u003e cu care \u003cstrong\u003elustra led dimabila\u003c\/strong\u003e este utilata, are la baza o tehnologie ce iti va garanta eficienta si durabilitatea pentru aproximativ \u003cstrong\u003e25000\u003c\/strong\u003e de ore. \u003cstrong\u003eLedurile\u003c\/strong\u003e sunt mult mai rezistente la socuri, comparativ cu multe \u003cstrong\u003ebecuri clasice\u003c\/strong\u003e ce risca sa se sparga chiar si la cel mai mic impact, nu au nevoie de timp pentru a se incalzi, astfel ca pornesc instant si scad drastic cantitatea de energie consumata. \u003cbr\u003e\u003cbr\u003eIn mod normal, utilizarea \u003cstrong\u003ecorpurilor\u003c\/strong\u003e de iluminat se realizeaza intr-o maniera simpla, si anume cu ajutorul unui \u003cstrong\u003eintrerupator clasic\u003c\/strong\u003e. Totusi, in cazul lustrei Aleha, se poate folosi si \u003cstrong\u003etelecomanda pentru banda led\u003c\/strong\u003e, ce aduce mai mult confort. In doar cateva secunde, \u003cstrong\u003elumina calda\u003c\/strong\u003e poate deveni \u003cstrong\u003elumina neutra sau rece\u003c\/strong\u003e, iar atmosfera ce va descrie casa va fi intr-adevar una relaxanta.\u003cbr\u003e\u003cbr\u003eObisnuiti sa intalniti des \u003cstrong\u003elustre cu cercuri\u003c\/strong\u003e, insa aceasta este cu mult diferita fata de tot ceea ce ati vazut pana acum. Este recunoscuta pentru designul minimalist, ce aduce modernitate in orice zona in care este amplasata. Nuanta simpla de alb, si totusi deosebit de expresiva, confera eleganta si stralucire celorlalte piese de mobilier ce se gasesc in interiorul locuintei. Totodata, fiind o culoare placuta din punct de vedere vizual ce nu incarca decorul, se poate integra in mai multe tipuri de amenajari in care sunt predominante atat culorile indraznete, cat si cele calde. \u003cbr\u003e\u003cbr\u003eO amenajare moderna poate fi realizata relativ usor daca pe langa piesele de mobilier alese corespunzator cu spatiul folositi \u003cstrong\u003etehnologia led\u003c\/strong\u003e pentru a pune il pune in evidenta, aceasta fiind solutia ideala pentru un \u003cstrong\u003eiluminat ieftin\u003c\/strong\u003e si perfect in trend cu interiorul casei dumneavoastra. \u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003cdiv style=\"text-align: center;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003eMontarea lustrei LED\u003c\/strong\u003e\u003cbr\u003e\u003cbr\u003eVa oferim un ghid video pentru montajul acestei lustre.\u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\" src=\"https:\/\/www.youtube.com\/embed\/tOUyx5SdjWE\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e","published_at":"2025-02-24T17:02:53+02:00","created_at":"2025-02-24T17:02:52+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52400303112459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-8067\/4+2int","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"229.99","grams":0,"compare_at_price":"229.99","position":1,"product_id":9757572661515,"created_at":"2025-09-22T09:16:10+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51816528675083,"created_at":"2025-02-24T17:02:55+02:00","position":1,"updated_at":"2025-02-24T17:02:58+02:00","product_id":9757572661515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-aleha-168w-dimabila-acril-alb_LL3AL_01.webp?v=1740409378","width":900,"height":900},{"id":51816528544011,"created_at":"2025-02-24T17:02:55+02:00","position":2,"updated_at":"2025-02-24T17:02:57+02:00","product_id":9757572661515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-aleha-168w-dimabila-acril-alb_LL3AL_02.webp?v=1740409377","width":900,"height":900},{"id":51816528576779,"created_at":"2025-02-24T17:02:55+02:00","position":3,"updated_at":"2025-02-24T17:02:57+02:00","product_id":9757572661515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-aleha-168w-dimabila-acril-alb_LL3AL_03.webp?v=1740409377","width":900,"height":900},{"id":51816528412939,"created_at":"2025-02-24T17:02:55+02:00","position":4,"updated_at":"2025-02-24T17:02:56+02:00","product_id":9757572661515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-aleha-168w-dimabila-acril-alb_LL3AL_04.webp?v=1740409376","width":900,"height":900},{"id":51816528445707,"created_at":"2025-02-24T17:02:55+02:00","position":5,"updated_at":"2025-02-24T17:02:57+02:00","product_id":9757572661515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-aleha-168w-dimabila-acril-alb_LL3AL_05.webp?v=1740409377","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759842009355,"title":"Lustra LED suspendata cu telecomanda DAMARA 44W, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-damara-44w-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:257\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15._Cover_content_7545ac71-c97b-4f28-a077-f108f5dad464.jpg?v=1772927812\" alt=\"\"\u003eLustra LED suspendată cu telecomandă DAMARA este o piesă de iluminat modernă și elegantă, cu o putere de 44W și un finisaj negru sofisticat. Fiind suspendată, este ideală pentru a ilumina de deasupra o zonă specifică sau ca iluminat general într-o încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:337\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/IN_VS_LED.png?v=1772904965\" alt=\"\"\u003eDeși descrierea nu menționează forma specifică, fiind LED cu telecomandă și funcție de ajustare a temperaturii culorii (rece, caldă, neutră) și intensității luminii (dimabilă), ne putem aștepta la un design contemporan și versatil. Telecomanda îți oferă control asupra atmosferei luminoase, permițându-ți să creezi exact ambianța dorită.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:219\"\u003eFinisajul negru accentuează liniile moderne ale designului și adaugă o notă de eleganță și sobrietate. Cu o putere de 44W, este potrivită pentru a ilumina livinguri, dormitoare sau zone de luat masa de dimensiuni medii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:219\"\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:49:52+02:00","created_at":"2025-02-25T00:49:52+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","ETA 03.Oct","iulie_26","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate","Summer_start"],"variants":[{"id":52428746195211,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT210BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"2