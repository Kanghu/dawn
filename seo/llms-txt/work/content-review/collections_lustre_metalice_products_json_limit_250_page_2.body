:[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_DALIA_96W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Negru_1.png?v=1782722279","width":1254,"height":1254},{"id":69618904039691,"created_at":"2026-06-29T11:30:47+03:00","position":5,"updated_at":"2026-06-29T11:39:45+03:00","product_id":9756793766155,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_DALIA_96W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Negru_2.png?v=1782722385","width":1254,"height":1254},{"id":69618908037387,"created_at":"2026-06-29T11:33:03+03:00","position":6,"updated_at":"2026-06-29T11:41:25+03:00","product_id":9756793766155,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_DALIA_96W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Negru_3.png?v=1782722485","width":1254,"height":1254},{"id":69618873368843,"created_at":"2026-06-29T11:18:58+03:00","position":7,"updated_at":"2026-06-29T11:44:17+03:00","product_id":9756793766155,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_DALIA_96W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Negru_7.png?v=1782722657","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10980210770187,"title":"Lustra LED MOND Eleganza cu telecomanda si cristal, 72W, 4 Patrate, Lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-mond-eleganza-cu-telecomanda-si-cristal-72w-4-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"5:1-5:294\"\u003eTransformă-ți spațiul într-un spectacol de lumină și culoare cu \u003cstrong\u003elustra LED RENATO Eleganza\u003c\/strong\u003e. Designul său contemporan, probabil cu elemente circulare sau liniare elegante în finisaj \u003cstrong\u003ealb\u003c\/strong\u003e, este completat de o putere impresionantă de \u003cstrong\u003e72W\u003c\/strong\u003e, oferind o iluminare amplă și eficientă pentru încăperi mari.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:199\"\u003eDatorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Funcția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii pentru a crea ambientul perfect pentru orice ocazie.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:252\"\u003ePersonalizează iluminatul în funcție de starea ta de spirit, eveniment sau preferințe, de la tonuri calde și relaxante la culori vibrante și energizante.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:78\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Elemente circulare sau liniare în finisaj alb.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:75\"\u003e\n\u003cstrong\u003ePutere Impresionantă:\u003c\/strong\u003e 72W pentru o iluminare amplă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și al culorilor\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:92\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj alb elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Dinamic:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cstrong\u003eLustra LED cu telecomandă RENATO Eleganza \u003c\/strong\u003eeste alegerea ideală pentru a adăuga un plus de stil, confort și culoare în spațiile mari. Bucură-te de iluminarea puternică și adaptabilă, completată de spectrul vibrant al culorilor sale.\u003c\/p\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-06-17T10:26:05+03:00","created_at":"2026-06-15T13:43:55+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":53183447433483,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT766\/4WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"259.99","grams":0,"compare_at_price":"259.99","position":1,"product_id":10980210770187,"created_at":"2026-06-15T13:43:56+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69504552075531,"created_at":"2026-06-15T13:46:20+03:00","position":1,"updated_at":"2026-06-15T13:48:57+03:00","product_id":10980210770187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_13_46_06.png?v=1781520537","width":1024,"height":1024},{"id":69504555188491,"created_at":"2026-06-15T13:46:58+03:00","position":2,"updated_at":"2026-06-15T13:50:17+03:00","product_id":10980210770187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_13_46_06_075af0cd-669b-40c4-b065-57b295feea02.png?v=1781520617","width":1500,"height":1500},{"id":69504555286795,"created_at":"2026-06-15T13:47:01+03:00","position":3,"updated_at":"2026-06-15T13:55:00+03:00","product_id":10980210770187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_13_46_06_9f9e7984-d286-44b5-9968-1b22c8bd687e.png?v=1781520900","width":1024,"height":1024},{"id":69504552370443,"created_at":"2026-06-15T13:46:25+03:00","position":4,"updated_at":"2026-06-15T13:46:30+03:00","product_id":10980210770187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage15iun.2026_13_45_57.png?v=1781520390","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759839944971,"title":"Lustra LED VERTEX HELIX, 65W, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-vertex-helix-65w-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"1:1-1:203\"\u003eLustra LED VERTEX HELIX de 65W, cu opțiuni pentru lumină rece, caldă sau neutră, și finisaj negru, sugerează un design modern, probabil cu o formă spiralată sau elicoidală, așa cum indică numele 'Helix'.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:293\"\u003eCu o putere de 65W, este potrivită pentru a oferi o lumină ambientală plăcută sau pentru a ilumina zone mai mici. Posibilitatea de a alege temperatura culorii îți permite să creezi atmosfera dorită în funcție de moment sau de preferințe. Finisajul negru adaugă o notă elegantă și contemporană.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:125\"\u003eAvând în vedere numele, designul ar putea include elemente care se răsucesc sau se înfășoară, creând un efect vizual dinamic.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-03-29T11:58:40+02:00","created_at":"2025-02-25T00:46:46+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52428745769227,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL305BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9759839944971,"created_at":"2025-09-30T15:26:39+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70027222712587,"created_at":"2026-09-02T15:12:18+03:00","position":1,"updated_at":"2026-09-02T15:13:19+03:00","product_id":9759839944971,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_VERTEX_HELIX_65W_lumina_Rece_Calda_Neutra_Negru_1.png?v=1788351199","width":1019,"height":1019},{"id":56341977235723,"created_at":"2025-06-12T15:37:51+03:00","position":2,"updated_at":"2026-09-04T17:50:52+03:00","product_id":9759839944971,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL305BK-LustraLEDVERTEXHELIX_15W_luminaRece_Calda_Neutra_Negru-3.jpg?v=1788533452","width":1024,"height":1024},{"id":56341977792779,"created_at":"2025-06-12T15:37:52+03:00","position":3,"updated_at":"2025-06-12T15:37:56+03:00","product_id":9759839944971,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\