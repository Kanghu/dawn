03e\u003cimg\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0b38953e-6df8-4961-a1b4-2f466d0e92f6.webp?v=1772544229\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:236\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2026-07-21T15:13:33+03:00","created_at":"2026-05-27T17:17:55+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":53137361797387,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT5005WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"579.99","grams":0,"compare_at_price":"659.99","position":1,"product_id":10967233593611,"created_at":"2026-05-27T17:17:56+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69140837990667,"created_at":"2026-05-27T17:22:03+03:00","position":1,"updated_at":"2026-05-27T17:25:23+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_341ae182-711f-4576-9c7d-e755f73a90c5.jpg?v=1779891923","width":832,"height":832},{"id":69140838252811,"created_at":"2026-05-27T17:22:11+03:00","position":2,"updated_at":"2026-05-27T17:26:51+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_a615683c-d0f0-4ac0-9f63-559c2e75bf08.jpg?v=1779892011","width":752,"height":752},{"id":69140836581643,"created_at":"2026-05-27T17:21:25+03:00","position":3,"updated_at":"2026-05-27T17:23:45+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_185e70bf-257f-4386-a581-976cf7e6275c.jpg?v=1779891825","width":1024,"height":1024},{"id":69140838482187,"created_at":"2026-05-27T17:22:17+03:00","position":4,"updated_at":"2026-05-27T17:22:20+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_2c4e6565-2f86-49ee-ae08-be0db37606fa.jpg?v=1779891740","width":1080,"height":1080},{"id":69140862107915,"created_at":"2026-05-27T17:31:46+03:00","position":5,"updated_at":"2026-05-27T17:31:50+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage27mai2026_17_31_36.png?v=1779892310","width":1254,"height":1254},{"id":69140866236683,"created_at":"2026-05-27T17:33:05+03:00","position":6,"updated_at":"2026-05-27T17:33:09+03:00","product_id":10967233593611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage27mai2026_17_32_53.png?v=1779892389","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10968248287499,"title":"Lustra LED RENATO Magno cu telecomanda si cristal,  128W, 8 Patrate, Lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-renato-cu-telecomanda-si-cristal-175w-8-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"5:1-5:294\"\u003eTransformă-ți spațiul într-un spectacol de lumină și culoare cu \u003cstrong\u003elustra LED RENATO Magno\u003c\/strong\u003e. Designul său contemporan, probabil cu elemente circulare sau liniare elegante în finisaj \u003cstrong\u003ealb\u003c\/strong\u003e, este completat de o putere impresionantă de \u003cstrong\u003e128W\u003c\/strong\u003e, oferind o iluminare amplă și eficientă pentru încăperi mari.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:199\"\u003eDatorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Funcția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii pentru a crea ambientul perfect pentru orice ocazie.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:252\"\u003ePersonalizează iluminatul în funcție de starea ta de spirit, eveniment sau preferințe, de la tonuri calde și relaxante la culori vibrante și energizante.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:78\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Elemente circulare sau liniare în finisaj alb.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:75\"\u003e\n\u003cstrong\u003ePutere Impresionantă:\u003c\/strong\u003e 128W pentru o iluminare amplă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și al culorilor\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:92\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj alb elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Dinamic:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cstrong\u003eLustra LED cu telecomandă RENATO Magno\u003c\/strong\u003e este alegerea ideală pentru a adăuga un plus de stil, confort și culoare în spațiile mari. Bucură-te de iluminarea puternică și adaptabilă, completată de spectrul vibrant al culorilor sale.\u003c\/p\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2026-07-08T17:06:16+03:00","created_at":"2026-05-29T09:30:44+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":53140482752779,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT765\/8WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"439.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10968248287499,"created_at":"2026-05-29T09:30:45+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69172448821515,"created_at":"2026-05-29T09:34:10+03:00","position":1,"updated_at":"2026-05-29T09:38:27+03:00","product_id":10968248287499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_0801cf99-07d5-4e60-aeb9-3e6bd3cb1a19.jpg?v=1780036707","width":1024,"height":1024},{"id":69172449444107,"created_at":"2026-05-29T09:34:14+03:00","position":2,"updated_at":"2026-05-29T09:40:09+03:00","product_id":10968248287499,"variant_ids":[],"src":"https:\/\/cdn.shopi