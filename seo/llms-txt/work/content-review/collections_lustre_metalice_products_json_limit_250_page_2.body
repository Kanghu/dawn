anner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:33:01+03:00","created_at":"2025-04-14T23:31:52+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52372595867915,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT638\/500GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"259.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":10133825716491,"created_at":"2025-09-16T01:09:00+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70053323735307,"created_at":"2026-09-04T16:37:41+03:00","position":1,"updated_at":"2026-09-04T16:58:50+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_1.png?v=1788530330","width":1254,"height":1254},{"id":70053337760011,"created_at":"2026-09-04T16:42:45+03:00","position":2,"updated_at":"2026-09-04T16:59:10+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_2.png?v=1788530350","width":1274,"height":1234},{"id":70053370691851,"created_at":"2026-09-04T16:56:06+03:00","position":3,"updated_at":"2026-09-04T16:59:18+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_3.png?v=1788530358","width":1254,"height":1254},{"id":70053375738123,"created_at":"2026-09-04T16:58:05+03:00","position":4,"updated_at":"2026-09-04T16:59:28+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_4.png?v=1788530368","width":1254,"height":1254},{"id":59075167453451,"created_at":"2025-08-13T10:56:33+03:00","position":5,"updated_at":"2026-09-04T16:59:59+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_5.png?v=1788530399","width":1500,"height":1500},{"id":59075160670475,"created_at":"2025-08-13T10:56:01+03:00","position":6,"updated_at":"2026-09-04T17:00:35+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_7.png?v=1788530435","width":3200,"height":3200},{"id":59075218931979,"created_at":"2025-08-13T11:02:26+03:00","position":7,"updated_at":"2026-09-04T17:00:47+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GILDRA_48W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Auriu_8.png?v=1788530447","width":800,"height":800},{"id":70053300306187,"created_at":"2026-09-04T16:32:50+03:00","position":8,"updated_at":"2026-09-04T16:32:53+03:00","product_id":10133825716491,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2539575_big_color.png?v=1788528773","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10152393933067,"title":"Lustra LED VERTEX 34W, 3 Patrate, Liniara, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-vertex-34w-3-patrate-liniara-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:72\"\u003e\u003cstrong\u003eEleganță Geometrică și Iluminare Adaptabilă: Lustra LED VERTEX \u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:346\"\u003eAdu un strop de modernitate sofisticată și o lumină versatilă în casa ta cu Lustra LED VERTEX Greco. Designul său minimalist, compus din \u003cstrong\u003etrei pătrate luminoase\u003c\/strong\u003e dispuse într-o linie elegantă, cu un finisaj \u003cstrong\u003ealb\u003c\/strong\u003e pur, creează un efect vizual aerisit și contemporan, perfect pentru a ilumina holuri, bucătării, birouri sau alte spații moderne.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:334\"\u003eCu o putere totală de \u003cstrong\u003e34W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și plăcută, ideală pentru a crea o atmosferă primitoare și bine iluminată. Bucură-te de flexibilitatea \u003cstrong\u003etrei tipuri de lumină\u003c\/strong\u003e integrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:164\"\u003eDesignul liniar cu trei pătrate asigură o distribuție uniformă a luminii pe o suprafață mai lungă, fiind ideală pentru zone de tranzit sau pentru iluminarea zonată.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T17:36:12+03:00","created_at":"2025-04-2