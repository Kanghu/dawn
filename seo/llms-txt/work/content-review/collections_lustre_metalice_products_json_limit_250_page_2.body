\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_700588d3-35e2-466e-80c6-19c0347beefb.jpg?v=1773087785","width":3999,"height":3999},{"id":67091189629195,"created_at":"2026-03-09T22:16:44+02:00","position":14,"updated_at":"2026-03-09T22:23:05+02:00","product_id":9757892706571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_152fff37-3d97-4d9d-a1ac-ae9251bd2547.jpg?v=1773087785","width":3999,"height":3999},{"id":63003175551243,"created_at":"2025-12-04T15:39:07+02:00","position":15,"updated_at":"2026-03-09T22:23:05+02:00","product_id":9757892706571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT800_4BK_EPREL.png?v=1773087785","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10840613617931,"title":"Lustra LED cu Telecomanda, LLC160\/750X350CH, Cristal si Metal, 71W, Dimabila, Inaltime Reglabila, Lumina Rece\/Calda\/Neutra, Iluminat Luxos","handle":"lustra-led-cu-telecomanda-llc160-750x350ch-cristal-si-metal-71w-dimabila-inaltime-reglabila-lumina-rece-calda-neutra-iluminat-luxos","body_html":"\u003cp data-end=\"336\" data-start=\"0\"\u003eLustra LED cu Telecomandă LLC160\/750X350CH este un corp de iluminat premium, conceput pentru interioare elegante și spații moderne care pun accent pe lux și rafinament. Designul său circular, cu un singur cerc decorat cu elemente din cristal și structură metalică aurie, creează un efect vizual spectaculos și o lumină ambientală sofisticată.\u003c\/p\u003e\u003cp data-end=\"336\" data-start=\"0\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"660\" data-start=\"338\"\u003eCu o putere de 71W, lustra oferă iluminare eficientă și uniformă, fiind ideală pentru livinguri, dininguri sau dormitoare high-end. Funcția dimabilă și telecomanda inclusă permit control total asupra intensității și temperaturii de culoare, cu opțiuni de lumină caldă, neutră sau rece, adaptabile oricărui moment al zilei.\u003c\/p\u003e\u003cp data-end=\"660\" data-start=\"338\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"999\" data-start=\"662\"\u003eÎnălțimea reglabilă asigură flexibilitate maximă la montaj, permițând integrarea armonioasă atât în spații cu tavan înalt, cât și în încăperi standard. Combinația dintre cristalul strălucitor și finisajul metalic auriu transformă lustra LLC160\/750X350CH într-un element statement, care nu doar iluminează, ci definește vizual întregul ambient.\u003c\/p\u003e\u003cp data-end=\"999\" data-start=\"662\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1130\" data-start=\"1001\"\u003eO alegere ideală pentru cei care caută iluminat luxos, tehnologie modernă și control complet al atmosferei într-un singur produs.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-12-29T07:32:55+02:00","created_at":"2025-12-18T15:16:12+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52772328767755,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LLC160\/750X350CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":