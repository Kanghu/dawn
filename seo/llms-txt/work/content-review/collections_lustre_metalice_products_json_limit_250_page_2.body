/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_13cafaf5-549d-4d2e-8859-3cd441a5fa34.png?v=1757442858","width":2000,"height":2000},{"id":60145990304011,"created_at":"2025-09-09T21:33:31+03:00","position":5,"updated_at":"2025-09-09T21:34:18+03:00","product_id":10716569436427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_d6811186-0f5f-4213-aa00-0a736ba3a30f.png?v=1757442858","width":2000,"height":2000},{"id":60145990369547,"created_at":"2025-09-09T21:33:32+03:00","position":6,"updated_at":"2025-09-09T21:33:36+03:00","product_id":10716569436427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_f5d8a5ca-2347-425f-a2b1-841101e980ad.png?v=1757442816","width":2000,"height":2000},{"id":62529742012683,"created_at":"2025-11-20T19:07:58+02:00","position":7,"updated_at":"2025-11-20T19:08:01+02:00","product_id":10716569436427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT751_3GD_EPREL_1660300b-e635-40e9-81e8-72d5a8b1f914.png?v=1763658481","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10716577661195,"title":"Lustra LED cu telecomanda ,Suspendata 71W, 3 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Inaltime Reglabila, Negru","handle":"lustra-led-cu-telecomanda-suspendata-71w-3-elemente-lumina-rece-calda-neutra-dimabila-inaltime-reglabila-negru","body_html":"\u003cdiv class=\"chat-history-scroll-container\" id=\"chat-history\"\u003e\u003cdiv id=\"5e11a03670470d98\" class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\"\u003e\u003cdiv class=\"response-container ng-tns-c1310598610-90 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1310598610-90\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1310598610-90\"\u003e\u003cdiv class=\"response-content ng-tns-c1310598610-90\"\u003e\u003cdiv dir=\"ltr\" id=\"model-response-message-contentr_5e11a03670470d98\" class=\"markdown markdown-main-panel\"\u003e\n\u003cp\u003eLustra LED suspendată 71W, cu 3 elemente circulare în finisaj negru mat, este un corp de iluminat modern, conceput pentru interioare contemporane și minimaliste. Designul cu inele suprapuse creează un efect vizual dinamic, transformând lustra într-un element central al încăperii.\u003c\/p\u003e\n\u003ch3\u003eSpecificații tehnice\u003c\/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePutere:\u003c\/strong\u003e 71W (LED integrat)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDimensiuni:\u003c\/strong\u003e 50 x 25 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eÎnălțime:\u003c\/strong\u003e Reglabilă (sistem de suspendare ajustabil)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCuloare:\u003c\/strong\u003e Negru\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMaterial:\u003c\/strong\u003e Metal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMontaj:\u003c\/strong\u003e Suspendat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003ch3\u003eFuncționalități și avantaje\u003c\/h3\u003e\n\u003cp\u003e✔ Selectarea temperaturii de culoare pentru diferite momente ale zilei\u003cbr\u003e✔ Intensitate reglabilă pentru ambient personalizat\u003cbr\u003e✔ Înălțime ajustabilă – adaptabilă la diferite tipuri de tavane\u003cbr\u003e✔ Iluminare uniformă și eficientă energetic\u003cbr\u003e✔ Design modern cu impact vizual\u003c\/p\u003e\n\u003cp\u003ePrin combinația dintre finisajul negru elegant și controlul inteligent al iluminării, această lustra LED de 71W oferă echilibru între estetică și performanță, fiind ideală pentru un iluminat modern și versatil.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003cdiv class=\"container hidden ng-star-inserted\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\n\u003c\/div\u003e","published_at":"2025-09-12T09:46:14+03:00","created_at":"2025-09-09T21:35:03+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52428752257291,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT751\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"299.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":10716577661195,"created_at":"2025-09-30T15:29:27+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":60146017468683,"created_at":"2025-09-09T21:36:56+03:00","posi