9\/files\/7._SIZE_dbc46da9-d30c-4d07-adae-0b429d1b7407.png?v=1778233397","width":1000,"height":1000},{"id":68771676127499,"created_at":"2026-05-08T12:43:14+03:00","position":8,"updated_at":"2026-05-08T12:43:18+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._PLACE_1_582b7d99-8452-4bcb-a805-da924cffab9e.png?v=1778233398","width":1000,"height":1000},{"id":68771676291339,"created_at":"2026-05-08T12:43:15+03:00","position":9,"updated_at":"2026-05-08T12:43:19+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._PLACE_2_76fc355c-bd5d-4b8e-8761-d130b8ef80ea.png?v=1778233399","width":1000,"height":1000},{"id":68771676389643,"created_at":"2026-05-08T12:43:15+03:00","position":10,"updated_at":"2026-05-08T12:43:19+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._PLACE_3_43f8fd8b-e9ff-4532-88c4-c73c72ca6921.png?v=1778233399","width":1000,"height":1000},{"id":68771676324107,"created_at":"2026-05-08T12:43:15+03:00","position":11,"updated_at":"2026-05-08T12:43:19+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15._PLACE_4_16a795d3-9e0a-4e5e-a7b6-97b241587af7.png?v=1778233399","width":1000,"height":1000},{"id":68771676356875,"created_at":"2026-05-08T12:43:15+03:00","position":12,"updated_at":"2026-05-08T12:43:19+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/16._PLACE_5_6807f2c6-2eda-4d66-9513-cf9c20b1ad4c.png?v=1778233399","width":1000,"height":1000},{"id":68771676094731,"created_at":"2026-05-08T12:43:14+03:00","position":13,"updated_at":"2026-05-08T12:43:18+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8._SPECIFICATION_cc331e22-03ba-4f88-90fd-e86488dd45d3.png?v=1778233398","width":1000,"height":1000},{"id":62880701153547,"created_at":"2025-11-30T13:21:30+02:00","position":14,"updated_at":"2025-11-30T13:21:34+02:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT223BK_PREL.png?v=1764501694","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760737034507,"title":"Lustra LED GALIOS 48W, 4 Elemente, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-gelius-minimalist-48w-4-elemente-lumina-rece-calda-neutra-negru","body_html":"\u003ccenter\u003e\u003c\/center\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp style=\"text-align: justify; font-size: 16px;\"\u003e\u003cstrong\u003eLustra LED GALIOS 48W\u003c\/strong\u003e Negru de la Alessandro Design este o piesă rafinată ce îmbină eleganța modernă cu funcționalitatea, fiind perfectă pentru orice interior contemporan. Cu un finisaj sofisticat în negru, această lustră adaugă un plus de stil și rafinament oricărei încăperi, fie că este vorba de living, dormitor sau birou.\u003c\/p\u003e\n\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eEchipată cu tehnologie LED avansată, lustra GALIOS asigură o iluminare puternică și uniformă de 48W, fiind ideală pentru spațiile medii și mari. Durata de viață îndelungată și consumul redus de energie contribuie la eficiența și sustenabilitatea acestei lustre.\u003c\/p\u003e\n\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eDesignul minimalist al lustrei GALIOS , cu linii geometrice clare și finisajul său elegant, o face ideală pentru decoruri moderne și urbane. Lampa emană lumină confortabilă pentru ochi, cu opțiuni de lumină caldă, neutră și rece (3000K, 4000K, 6000K), adaptându-se astfel diverselor momente ale zilei și nevoilor din încăpere.Cu montaj simplu și materiale de înaltă calitate, lustra GALIOS de la Alessandro Design oferă o soluție de iluminat eficientă și estetică, transformând orice spațiu într-un mediu elegant și contemporan.\u003c\/p\u003e\n\u003cp style=\"text-align: justify; font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:15:14+02:00","created_at":"2025-02-25T03:15:13+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","All Stock","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52411182678283,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL360","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":9760737034507,"created_at":"2025-09-25T10:53:39+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":61817158566155,"created_at":"2025-10-29T10:43:33+02:00","position":1,"updated_at":"2025-10-29T10:50:51+02:00","product_id":9760737034507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H56f2cc68c80b40d8a230ebae1c44551et.jpg?v=1761727851","width":681,"height":680},{"id":61817193824523,"created_at":"2025-10-29T10:54:00+02:00","position":2,"updated_at":"2025-10-29T10:54:10+02:00","product_id":9760737034507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_50101b04-c56e-4780-8284-24b7f59457c7.png?v=1761728050","width":1500,"height":1500},{"id":61817228919051,"created_at":"2025-10-29T10:58:40+02:00","position":3,"updated_at":"2025-10-29T10:58:51+02:00","product_id":9760737034507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_06154bfe-6dcc-4573-8a1f-aaf86f3cae5c.png?v=1761728331","width":1500,"height":1500},{"id":51853993181451,"created_at":"2025-02-25T03:15:15+02:00","position":4,"updated_at":"2025-10-29T10:58:51+02:00","product_id":9760737034507,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-gelius-48w-negru-1729109889.webp?v=1761728331","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757522460939,"title":"Lustra LED ADELINE 24W, Diametru 20cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-adeline-24w-diametru-20cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Adeline, parte a gamei Metocril, este o piesă de iluminat care combină perfect funcționalitatea cu estetica modernă. Cu o putere de 24W și un design elegant în alb, această lustră aduce un strop de stil și luminozitate în orice spațiu contemporan. Designul său modern, cu o formă geometrică distinctă, o face o piesă centrală atrăgătoare în orice încăpere. Compactă, cu un diametru de doar 20 cm, lustra Adeline este ideală pentru spații mici, oferind totodată un flux luminos impresionant de 1920lm, suficient pentru a ilumina eficient o varietate de spații.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e\u003ch3\u003eVezi video demonstrativ\u003c\/h3\u003e\u003cp\u003e\u003ca class=\"video-link\" href=\"https:\/\/www.youtube.com\/watch?v=VM30cHjbtdc\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg alt=\"YouTube video thumbnail\" src=\"https:\/\/img.youtube.com\/vi\/VM30cHjbtdc\/maxresdefault.jpg\"\u003e \u003c\/a\u003e\u003c\/p\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eUnul dintre cele mai notabile aspecte ale lustrei Adeline este capacitatea sa de a oferi lumină caldă și rece. Această versatilitate permite ajustarea ambianței în funcție de preferințele personale sau de nevoile momentului, oferind o iluminare plăcută și confortabilă pentru orice ocazie.\u003cbr\u003e\u003cbr\u003eExpoziția în showroom-ul Alessandro Design din Voluntari oferă posibilitatea de a vedea și aprecia direct calitatea și frumusețea lustrei Adeline. Aici, puteți explora întreaga gamă Metocril și beneficiați de consultanță expertă pentru a alege soluția de iluminat perfectă pentru spațiul dumneavoastră.\u003cbr\u003e\u003cbr\u003eAlegerea Lustra LED Adeline din gama Metocril înseamnă a opta pentru o combinație de estetică rafinată și tehnologie avansată. Este soluția ideală pentru cei care caută un iluminat de impact, care să combine designul contemporan cu eficiența și flexibilitatea.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2026-07-13T17:36:33+03:00","created_at":"2025-02-24T16:40:27+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52122258309387,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL490WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"42.99","grams":0,"compare_at_price":"68.18","position":1,"product_id":9757522460939,"created_at":"2025-08-25T21:11:00+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51816187199755,"created_at":"2025-02-24T16:40:29+02:00","position":1,"updated_at":"2025-02-24T16:40:31+02:00","product_id":9757522460939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-adeline-24w_LL171AL_01.webp?v=1740408031","width":900,"height":900},{"id":51816187232523,"created_at":"2025-02-24T16:40:29+02:00","position":2,"updated_at":"2025-02-24T16:40:31+02:00","product_id":9757522460939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-adeline-24w_LL171AL_02.webp?v=1740408031","width":900,"height":900},{"id":51816187429131,"created_at":"2025-02-24T16:40:29+02:00","position":3,"updated_at":"2025-02-24T16:40:32+02:00","product_id":9757522460939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-adeline-24w_LL171AL_03.webp?v=1740408032","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10236579283211,"title":"Lustra LED cu Telecomanda RINOVA, 5 cercuri, 137W, Lumina Calda\/Rece\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomnda-rinova-5-cercuri-137w-lumina-calda-rece-neutra-dimabila-auriu","body_html":"\u003cp data-sourcepos=\"5:1-5:248\"\u003eLustra LED RINOVA, o piesa de iluminat ce imbina estetica moderna cu functionalitatea avansata. Conceputa pentru a adauga o nota de rafinament, aceasta lustra este mai mult decat o sursa de lumina, este o declaratie de stil.\u003c\/p\u003e\u003cul data-sourcepos=\"7:1-10:0\"\u003e\n\u003cli data-sourcepos=\"7:1-7:260\"\u003e\n\u003cstrong\u003eDesign Impunator \u0026amp; Materiale Premium:\u003c\/strong\u003e Cu o forma rotunda\/circulara si finisaj auriu, realizata din acril, metal si aluminiu, lustra RINOVA, cu cele 5 surse, devine punctul central al oricarei incaperi, integrandu-se perfect in decorurile contemporane.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:271\"\u003e\n\u003cstrong\u003eAmbianta Total Personalizabila:\u003c\/strong\u003e Beneficiati de o putere totala de 137W si un flux luminos impresionant de 10.960lm. Alegeti din cele trei temperaturi de culoare (calda, neutra, rece) si controlati lumina intuitiv, fie prin intrerupatorul clasic, fie prin telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-10:0\"\u003e\n\u003cstrong\u003eEficienta Energetica \u0026amp; Durabilitate Extinsa:\u003c\/strong\u003e Tehnologia LED avansata asigura un consum optim si o durata de viata remarcabila de 25.000 de ore, oferind economii semnificative pe termen lung si o intretinere minima.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"11:1-11:238\"\u003eLustra LED RINOVA este solutia ideala pentru cei ce cauta o iluminare eficienta, estetica si durabila, transformand fiecare incapere intr-un spatiu plin de personalitate si un confort vizual exceptional, perfect pentru dormitor sau living.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:238\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:238\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:238\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e","published_at":"2025-06-13T17:11:52+03:00","created_at":"2025-06-11T12:03:18+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","ETA 03.Oct","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52428750029067,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT510\/5GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"599.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10236579283211,"created_at":"2025-09-30T15:28:34+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56307121848587,"created_at":"2025-06-11T12:23:19+03:00","position":1,"updated_at":"2025-06-11T12:23:22+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT5115GD-LustraLEDDARIOcuTelecomnda_120W_LuminaCaldaReceNeutra_Auriu-1.png?v=1749633802","width":1080,"height":1080},{"id":56405185134859,"created_at":"2025-06-14T13:24:32+03:00","position":2,"updated_at":"2025-06-14T13:24:36+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_3.jpg?v=1749896676","width":1080,"height":1080},{"id":56405184741643,"created_at":"2025-06-14T13:24:32+03:00","position":3,"updated_at":"2025-06-14T13:24:35+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_4.jpg?v=1749896675","width":1080,"height":1080},{"id":56405184708875,"created_at":"2025-06-14T13:24:32+03:00","position":4,"updated_at":"2025-06-14T13:24:35+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_5.jpg?v=1749896675","width":1080,"height":1080},{"id":56405184872715,"created_at":"2025-06-14T13:24:32+03:00","position":5,"updated_at":"2025-06-14T13:24:36+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_6.jpg?v=1749896676","width":1080,"height":1080},{"id":56405184676107,"created_at":"2025-06-14T13:24:32+03:00","position":6,"updated_at":"2025-06-14T13:24:35+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_7.jpg?v=1749896675","width":1080,"height":1080},{"id":56405185003787,"created_at":"2025-06-14T13:24:32+03:00","position":7,"updated_at":"2025-06-14T13:24:36+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu.jpg?v=1749896676","width":1080,"height":1080},{"id":56405184938251,"created_at":"2025-06-14T13:24:32+03:00","position":8,"updated_at":"2025-06-14T13:24:36+03:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT511_5GD-LustraLEDcuTelecomndaDARIO_5cercuri_120W_LuminaCalda_Rece_Neutra_Dimabila_Auriu_2.jpg?v=1749896676","width":1080,"height":1080},{"id":62529072169227,"created_at":"2025-11-20T17:55:52+02:00","position":9,"updated_at":"2025-11-20T17:55:55+02:00","product_id":10236579283211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT510_5GD_EPREL_37e7501f-d467-4bb5-b220-3d26eae103eb.png?v=1763654155","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759551717643,"title":"Lustra LED suspendata cu telecomanda OLATHE 180W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Maro, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-olathe-180w-2-cercuri-lumina-rece-calda-neutra-dimabila-maro-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eIntroduceți o notă de eleganță și stil modern în decorul dumneavoastră cu Lustra LED Roya. Această lustră tip pendul, cu un design unic format din două cercuri de dimensiuni diferite, oferă un echilibru perfect între estetică și funcționalitate. Finisată într-o nuanță caldă de maro, Roya este ideală pentru a adăuga un element de stil în livinguri, săli de mese sau holuri. Cu o putere impresionantă de 180W și un flux luminos de 14400lm, această lustră nu doar că iluminează spațiul, dar devine și un punct de atracție vizual.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai mari avantaje ale Lustrei LED Roya este capacitatea sa de a oferi trei tipuri de lumină - caldă, rece și neutră. Această versatilitate vă permite să schimbați ambianța camerei în funcție de momentul zilei sau de activitatea desfășurată. Fie că doriți o atmosferă relaxantă pentru o seară liniștită acasă sau o lumină mai concentrată pentru lectură sau lucrul la birou, Roya se adaptează perfect nevoilor dumneavoastră.\u003cbr\u003e\u003cbr\u003eFuncționalitatea dimabilă, controlabilă prin telecomandă, oferă un nivel suplimentar de confort și adaptabilitate. Acest lucru vă permite să reglați intensitatea luminii după preferințe, creând astfel ambianța ideală pentru orice situație. În plus, înălțimea ajustabilă a lustrei adaugă flexibilitate, permițându-vă să adaptați lustra în funcție de înălțimea tavanului sau de specificul spațiului.\u003cbr\u003e\u003cbr\u003eDesignul său modern, cu două cercuri de dimensiuni diferite, aduce un element geometric interesant și un joc de lumini și umbre captivant. Fie că este plasată într-un interior clasic sau contemporan, Roya se potrivește armonios, adăugând un plus de rafinament și modernitate.\u003cbr\u003e\u003cbr\u003eOptați pentru Lustra LED Roya pentru a combina eficiența în iluminat cu un design contemporan și elegant. Este mai mult decât o sursă de lumină; este o piesă centrală care va îmbogăți și va lumina orice interior cu un stil distinctiv și modern.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-07-01T19:56:08+03:00","created_at":"2025-02-25T00:03:30+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52105128149259,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-SJ030\/500+300","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.97","grams":0,"compare_at_price":"439.99","position":1,"product_id":9759551717643,"created_at":"2025-08-21T12:35:38+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51834016334091,"created_at":"2025-02-25T00:03:32+02:00","position":1,"updated_at":"2025-02-25T00:03:34+02:00","product_id":9759551717643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-roya-180w-maro_AT1CT-VV1A-HT2L-SJ030-500300_01.webp?v=1740434614","width":900,"height":900},{"id":51834016301323,"created_at":"2025-02-25T00:03:32+02:00","position":2,"updated_at":"2025-02-25T00:03:34+02:00","product_id":9759551717643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-roya-180w-maro_AT1CT-VV1A-HT2L-SJ030-500300_02.webp?v=1740434614","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779348898059,"title":"Lustră Suspendată LED Acril Celeste 42W cu Telecomandă, Dimabilă, Lumina Calda\/Neutra\/Rece 3000K\/4000K\/6000K, Auriu, Metal și Acril","handle":"lustra-suspendata-led-acril-celeste-42w-cu-telecomanda-dimabila-3000k-4000k-6000k-auriu-metal-si-acril","body_html":"\u003cp\u003e\u003cstrong\u003eLustră suspendată LED acril Celeste, 42W, cu telecomandă, dimabilă, 3000K \/ 4000K \/ 6000K, auriu, metal și acril\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eLustra LED suspendată Celeste este un corp de iluminat elegant, cu design modern și finisaj auriu, conceput pentru interioare contemporane care cer atât estetică, cât și funcționalitate. Structura din metal este completată de elemente din acril, oferind un aspect rafinat și o distribuție uniformă a luminii.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_1_png.png?v=1769162635\"\u003e\u003c\/p\u003e\u003cp\u003eIluminarea LED integrată de 42W este dimabilă și permite selectarea temperaturii de culoare caldă, neutră sau rece (3000K \/ 4000K \/ 6000K), pentru adaptarea atmosferei în funcție de momentul zilei și activitate. Controlul prin telecomandă asigură reglaj rapid al intensității și al tipului de lumină.\u003c\/p\u003e\u003cp\u003eDesignul suspendat permite evidențierea zonei iluminate, fiind ideal pentru livinguri, zone de dining sau spații elegante. Materialele de calitate, consumul redus de energie și funcționalitatea avansată fac din lustra Celeste o soluție practică și estetică pentru iluminatul interior modern.\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_final_f7ebc4f3-922f-45a1-9ce3-c338b6574a31.png?v=1769164054\"\u003e\u003c\/p\u003e","published_at":"2025-09-08T14:46:30+03:00","created_at":"2025-03-06T18:46:04+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED"],"variants":[{"id":52428106662155,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT920GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"539.99","grams":0,"compare_at_price":"539.99","position":1,"product_id":9779348898059,"created_at":"2025-09-30T12:28:54+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":59032005116171,"created_at":"2025-08-12T12:38:09+03:00","position":1,"updated_at":"2025-08-12T12:38:12+03:00","product_id":9779348898059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H0d8a78c377f9485ba84bec0b4c329a668.jpg?v=1754991492","width":750,"height":750},{"id":59032004919563,"created_at":"2025-08-12T12:38:09+03:00","position":2,"updated_at":"2025-08-12T12:41:05+03:00","product_id":9779348898059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb433fcad14124da89e0532c2460ead6cr.jpg?v=1754991665","width":800,"height":800},{"id":59032005083403,"created_at":"2025-08-12T12:38:09+03:00","position":3,"updated_at":"2025-08-12T12:41:05+03:00","product_id":9779348898059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H935716de27de4a0cbb46a9755f869772T.jpg?v=1754991665","width":800,"height":800},{"id":59032005181707,"created_at":"2025-08-12T12:38:09+03:00","position":4,"updated_at":"2025-08-12T12:38:12+03:00","product_id":9779348898059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hb8ad6417970e422fbdfedee7ea5d2bba6.jpg?v=1754991492","width":800,"height":800},{"id":59032005148939,"created_at":"2025-08-12T12:38:09+03:00","position":5,"updated_at":"2025-08-12T12:38:12+03:00","product_id":9779348898059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/He39cddfac0524417aa88a5739eef74c7O.jpg?v=1754991492","width":750,"height":750}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757454696715,"title":"Lustra LED SIENA 40W, Diametru 23cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-siena-40w-diametru-24cm-lumina-rece-calda-neutra-alb","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003eE atât de ușor să controlezi atmosfera! Descoperă luxul lustrelor LED, unde tehnologia se întâlnește cu eleganța! Caracteristici esențiale precum temperatura de culoare transformă aceste lustre în adevărate opere de artă luminoasă, oferindu-ți posibilitatea de a crea o atmosferă perfectă pentru orice moment.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003eCu o durată de viață ridicată a LED-urilor și o putere de 40W, lustra LED Siena este ideală pentru încăperi de până la 10 metri pătrați.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003eLustra LED Siena din gama Kampas se identifică printr-un design deosebit realizat cu ajutorul materialelor acril și metal. Acest tip de lustra poate fi cu ușurință integrat în spațiile mici care au nevoie de o sursă de iluminat aparte.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003ePrincipalele caracteristici ale modelului constau în puterea de 40W, fluxul luminos de 4838lm și cele 3 surse de lumină care distribuie strălucirea în mod uniform. Pentru cei care doresc corpuri de iluminat unice, această lustra de interior reușește să îmbine designul inovativ cu eficiența energetică oferită de tehnologia LED. Lustra Siena oferă trei opțiuni de lumină (caldă, rece sau neutră) și aduce un plus de modernitate prin aspectul său floral subtil.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003eLustra Siena nu doar iluminează, ci completează armonios spațiul printr-un echilibru perfect între estetică și funcționalitate. Fiind alimentată la rețea, asigură o funcționare durabilă și eficientă, oferind un iluminat modern și atractiv.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003c\/div\u003e","published_at":"2025-02-24T16:21:21+02:00","created_at":"2025-02-24T16:21:20+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52423118029067,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL660WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9757454696715,"created_at":"2025-09-29T02:45:21+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69858311405835,"created_at":"2026-07-31T22:23:55+03:00","position":1,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LL660WH.webp?v=1785525838","width":1254,"height":1254},{"id":69858311438603,"created_at":"2026-07-31T22:23:55+03:00","position":2,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LL660WH.webp?v=1785525838","width":1254,"height":1254},{"id":69858311471371,"created_at":"2026-07-31T22:23:55+03:00","position":3,"updated_at":"2026-07-31T22:23:58+03:00","pro