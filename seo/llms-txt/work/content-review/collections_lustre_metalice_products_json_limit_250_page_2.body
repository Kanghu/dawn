00","position":6,"updated_at":"2026-06-08T17:31:52+03:00","product_id":9757522821387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-erika-48w-alb_LL27AL_03.webp?v=1780929112","width":1024,"height":1024},{"id":51816189591819,"created_at":"2025-02-24T16:40:36+02:00","position":7,"updated_at":"2026-06-08T17:33:06+03:00","product_id":9757522821387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-erika-48w-alb_LL27AL_04.webp?v=1780929186","width":1500,"height":1500},{"id":51816189526283,"created_at":"2025-02-24T16:40:36+02:00","position":8,"updated_at":"2026-06-08T17:36:20+03:00","product_id":9757522821387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-erika-48w-alb_LL27AL_02.webp?v=1780929380","width":1024,"height":1024},{"id":69362251333899,"created_at":"2026-06-08T17:33:29+03:00","position":9,"updated_at":"2026-09-07T11:25:09+03:00","product_id":9757522821387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_ERIKA_20W_3_Patrate_Lumina_Calda_Neutra_Rece_Alb_Metal_si_Acril_3.png?v=1788769509","width":1254,"height":1254},{"id":63232614400267,"created_at":"2025-12-10T13:38:08+02:00","position":10,"updated_at":"2025-12-10T13:38:11+02:00","product_id":9757522821387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL801_3WH_EPREL.png?v=1765366691","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759591989515,"title":"Lustra LED cu telecomanda LILY 147W, 12 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lily-147w-12-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați o declarație de eleganță și rafinament în spațiile dumneavoastră ample cu Lustra LED Mahari din gama Rosas. Această lustră impresionantă, cu un design floral sofisticat este o alegere perfectă pentru camerele de dimensiuni mari, unde designul său în alb și puterea de 147W creează un ambient luxos și primitor.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai mari avantaje ale Lustrei LED Mahari este controlul avansat oferit de telecomandă. Aceasta vă permite să ajustați cu ușurință atât intensitatea, cât și tipul de lumină dispersată - caldă (3000K), neutră (4000K) sau rece (6000K) - pentru a se potrivi oricărui moment al zilei sau oricărei activități. Funcția dimabilă adaugă un nivel de confort și adaptabilitate rar întâlnit în modelele obișnuite de lustre. Cu un flux luminos de 11760lm, Mahari oferă o iluminare abundentă și eficientă, fiind potrivită pentru spații precum sălile de mese mari, livingurile sau sălile de conferințe. Durabilitatea este asigurată de o autonomie de până la 25000 de ore, ceea ce face din această lustră o investiție durabilă și eficientă din punct de vedere energetic.\u003cbr\u003e\u003cbr\u003eAlegerea Lustrei LED Mahari din gama Rosas înseamnă a opta pentru un echilibru între estetică și funcționalitate. Este mai mult decât o sursă de lumină; este un punct focal de neuitat care va îmbogăți orice spațiu cu eleganța sa atemporală și performanța sa luminică de excepție.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:08:41+02:00","created_at":"2025-02-25T00:08:41+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52043831345419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT230\/12WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9759591989515,"created_at":"2025-08-06T15:30:46+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51834468040971,"created_at":"2025-02-25T00:08:42+02:00","position":1,"updated_at":"2025-02-25T00:08:44+02:00","product_id":9759591989515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-mahari-240w-dimabila-alb_LL1910AL_01.webp?v=1740434924","width":900,"height":900},{"id":68422596165899,"created_at":"2026-04-22T12:05:20+03:00","position":2,"updated_at":"2026-04-22T12:05:23+03:00","product_id":9759591989515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697353_big_color.svg?v=1776848723","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10721745535243,"title":"Lustra LED cu telecomanda si cristal VERTUS 31W, 50cm, Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomanda-si-cristal-vertus-31w-50cm-cerc-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp data-start=\"111\" data-end=\"394\"\u003e\u003cstrong data-start=\"111\" data-end=\"158\"\u003eVERTUS 31W – varianta Ø50 cm, finisaj auriu\u003c\/strong\u003e este o lustra LED elegantă, cu design circular amplu și inserții din cristal ce oferă un efect spectaculos de reflexie. Diametrul generos o face potrivită pentru încăperi medii și mari, unde poate deveni elementul central al decorului.\u003c\/p\u003e\u003ch3 data-start=\"396\" data-end=\"420\"\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul data-start=\"421\" data-end=\"781\"\u003e\n\u003cli data-start=\"421\" data-end=\"442\"\u003e\u003cp data-start=\"423\" data-end=\"442\"\u003e\u003cstrong data-start=\"423\" data-end=\"433\"\u003eModel:\u003c\/strong\u003e VERTUS\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"443\" data-end=\"477\"\u003e\u003cp data-start=\"445\" data-end=\"477\"\u003e\u003cstrong data-start=\"445\" data-end=\"456\"\u003ePutere:\u003c\/strong\u003e 31W (LED integrat)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"478\" data-end=\"497\"\u003e\u003cp data-start=\"480\" data-end=\"497\"\u003e\u003cstrong data-start=\"480\" data-end=\"490\"\u003eFormă:\u003c\/strong\u003e Cerc\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"498\" data-end=\"553\"\u003e\u003cp data-start=\"500\" data-end=\"553\"\u003e\u003cstrong data-start=\"500\" data-end=\"515\"\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"554\" data-end=\"602\"\u003e\u003cp data-start=\"556\" data-end=\"602\"\u003e\u003cstrong data-start=\"556\" data-end=\"575\"\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"603\" data-end=\"639\"\u003e\u003cp data-start=\"605\" data-end=\"639\"\u003e\u003cstrong data-start=\"605\" data-end=\"617\"\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"640\" data-end=\"693\"\u003e\u003cp data-start=\"642\" data-end=\"693\"\u003e\u003cstrong data-start=\"642\" data-end=\"655\"\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"694\" data-end=\"716\"\u003e\u003cp data-start=\"696\" data-end=\"716\"\u003e\u003cstrong data-start=\"696\" data-end=\"708\"\u003eCuloare:\u003c\/strong\u003e Auriu\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"717\" data-end=\"749\"\u003e\u003cp data-start=\"719\" data-end=\"749\"\u003e\u003cstrong data-start=\"719\" data-end=\"734\"\u003eDimensiuni:\u003c\/strong\u003e 50 x 12.5 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"750\" data-end=\"781\"\u003e\u003cp data-start=\"752\" data-end=\"781\"\u003e\u003cstrong data-start=\"752\" data-end=\"763\"\u003eMontaj:\u003c\/strong\u003e Tavan (aplicat)\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3 data-start=\"783\" data-end=\"814\"\u003eFuncționalități și avantaje\u003c\/h3\u003e\u003cp data-start=\"815\" data-end=\"1092\"\u003e✔ Selectarea temperaturii de culoare în funcție de ambient\u003cbr data-start=\"873\" data-end=\"876\"\u003e✔ Intensitate reglabilă pentru confort vizual personalizat\u003cbr data-start=\"934\" data-end=\"937\"\u003e✔ Cristale decorative cu efect elegant și luminos\u003cbr data-start=\"986\" data-end=\"989\"\u003e✔ Diametru mare – ideal pentru spații mai generoase\u003cbr data-start=\"1040\" data-end=\"1043\"\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp data-start=\"1210\" data-end=\"1465\"\u003ePrin combinația dintre finisajul auriu sofisticat, cristalele strălucitoare și controlul inteligent al iluminării, \u003cstrong data-start=\"1325\" data-end=\"1346\"\u003eVERTUS 31W Ø50 cm\u003c\/strong\u003e oferă un echilibru între estetică premium și performanță, fiind ideală pentru un iluminat ambiental modern și rafinat.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopi