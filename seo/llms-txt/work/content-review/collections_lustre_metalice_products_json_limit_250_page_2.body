734528553\"\u003e\u003c\/p\u003e","published_at":"2026-06-26T10:18:06+03:00","created_at":"2026-06-09T14:13:17+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED Suspendate","Plafoniere LED"],"variants":[{"id":53170603786507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL5002\/600BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"263.99","grams":0,"compare_at_price":"150.99","position":1,"product_id":10976135282955,"created_at":"2026-06-09T14:13:18+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69377630503179,"created_at":"2026-06-09T14:15:01+03:00","position":1,"updated_at":"2026-06-09T14:18:48+03:00","product_id":10976135282955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_b343e46b-7d40-4ee1-be10-fbae8e6a6b61.jpg?v=1781003928","width":2000,"height":2000},{"id":69377647018251,"created_at":"2026-06-09T14:15:40+03:00","position":2,"updated_at":"2026-06-09T14:53:07+03:00","product_id":10976135282955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_f240cdf3-834c-46d1-9c4b-aab85a7dd89b.jpg?v=1781005987","width":1024,"height":1024},{"id":69377648034059,"created_at":"2026-06-09T14:15:42+03:00","position":3,"updated_at":"2026-06-09T14:45:08+03:00","product_id":10976135282955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_2a7f0857-2051-4a48-b2ea-3ed953008448.jpg?v=1781005508","width":1024,"height":1024},{"id":69377649344779,"created_at":"2026-06-09T14:15:44+03:00","position":4,"updated_at":"2026-06-09T14:48:42+03:00","product_id":10976135282955,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_1_2c552b68-b7c4-4eaf-9dd9-b927d9f3