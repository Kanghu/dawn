aptarea atmosferei în funcție de moment. Lustra LT178\/8WH combină eficiența tehnologiei LED cu un design contemporan, fiind o soluție practică și estetică pentru iluminatul interior.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e \u003c\/p\u003e","published_at":"2025-12-29T08:28:35+02:00","created_at":"2025-12-18T17:01:31+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52772536189195,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT182\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.97","grams":0,"compare_at_price":"399.99","position":1,"product_id":10840694587659,"created_at":"2025-12-18T17:01:31+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63575999217931,"created_at":"2025-12-18T17:09:31+02:00","position":1,"updated_at":"2025-12-18T17:11:50+02:00","product_id":10840694587659,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_c37f1f35-ed0f-4caa-9d38-7c1ad197a6fc.jpg?v=1766070710","width":3333,"height":3334},{"id":635760842181