tml":"\u003cp\u003e\u003cstrong\u003eLustra LED CELUN \u003c\/strong\u003eeste o piesă de iluminat modernă și funcțională, cu o putere de \u003cstrong\u003e33W\u003c\/strong\u003e și un \u003cstrong\u003ediametru de 21cm\u003c\/strong\u003e. Designul său liniar include un proiector reglabil, totul finisat în negru. Oferă posibilitatea de a alege între lumină rece, caldă sau neutră.\u003c\/p\u003e\u003cp\u003eForma circulara a lustrei si \u003cstrong\u003ediametrul de 21cm\u003c\/strong\u003e indică o prezență vizuală semnificativă. Finisajul alb îi conferă un aspect industrial sau modern.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-06-18T10:50:46+03:00","created_at":"2026-06-17T14:57:28+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":53188049207563,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL7003WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"119.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":10981380489483,"created_at":"2026-06-17T14:57:30+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69544041644299,"created_at":"2026-06-17T15:10:05+03:00","position":1,"updated_at":"2026-06-17T15:10:09+03:00","product_id":10981380489483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage17iun.2026_15_07_44.png?v=1781698209","width":1254,"height":1254},{"id":69544041677067,"created_at":"2026-06-17T15:1