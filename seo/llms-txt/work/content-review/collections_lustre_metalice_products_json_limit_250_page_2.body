 impact vizual\u003cbr\u003e✔ Durată mare de viață a LED-urilor integrate\u003c\/p\u003e\n\u003cp\u003ePrin combinația dintre estetică minimalistă și control inteligent al iluminării, \u003cstrong\u003eLustra LED LT750\/3BK 72W\u003c\/strong\u003e oferă versatilitate și performanță, devenind un element central în amenajările moderne.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003cdiv class=\"container hidden ng-star-inserted\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\n\u003c\/div\u003e","published_at":"2025-09-29T19:24:42+03:00","created_at":"2025-09-09T20:52:12+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52428751307019,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT750\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":10716525265163,"created_at":"2025-09-30T15:29:04+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":60145736352011,"created_at":"2025-09-09T20:54:41+03:00","position":1,"updated_at":"2025-09-09T20:54:45+03:00"