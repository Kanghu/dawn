u003c\/li\u003e\n\u003cli data-start=\"597\" data-end=\"650\"\u003e\u003cp data-start=\"599\" data-end=\"650\"\u003e\u003cstrong data-start=\"599\" data-end=\"612\"\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"651\" data-end=\"679\"\u003e\u003cp data-start=\"653\" data-end=\"679\"\u003e\u003cstrong data-start=\"653\" data-end=\"665\"\u003eCuloare:\u003c\/strong\u003e Crom lucios\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"680\" data-end=\"710\"\u003e\u003cp data-start=\"682\" data-end=\"710\"\u003e\u003cstrong data-start=\"682\" data-end=\"697\"\u003eDimensiuni:\u003c\/strong\u003e 40 x 50 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"711\" data-end=\"738\"\u003e\u003cp data-start=\"713\" data-end=\"738\"\u003e\u003cstrong data-start=\"713\" data-end=\"726\"\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"739\" data-end=\"764\"\u003e\u003cp data-start=\"741\" data-end=\"764\"\u003e\u003cstrong data-start=\"741\" data-end=\"752\"\u003eMontaj:\u003c\/strong\u003e Suspendat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3 data-start=\"766\" data-end=\"798\"\u003eFuncționalități și beneficii\u003c\/h3\u003e\u003cp data-start=\"799\" data-end=\"1084\"\u003e✔ Selectarea temperaturii de culoare în funcție de ambient\u003cbr data-start=\"857\" data-end=\"860\"\u003e✔ Intensitate ajustabilă pentru confort vizual optim\u003cbr data-start=\"912\" data-end=\"915\"\u003e✔ Cristale care amplifică și reflectă lumina elegant\u003cbr data-start=\"967\" data-end=\"970\"\u003e✔ Înălțime reglabilă – adaptabilă la diferite tipuri de tavane\u003cbr data-start=\"1032\" data-end=\"1035\"\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp data-start=\"1212\" data-end=\"1434\"\u003ePrin combinația dintre iluminarea LED eficientă și detaliile din cristal, această lustra suspendată de 36W adaugă rafinament și strălucire încăperii, oferind atât funcționalitate avansată, cât și un impact vizual deosebit.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-29T19:27:13+03:00","created_at":"2025-09-09T21:43:19+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428837945611,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT028\/400CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"579.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10716594798859,"created_at":"2025-09-30T15:38:17+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69658373292299,"created_at":"2026-07-03T11:53:35+03:00","position":1,"updated_at":"2026-07-03T11:53:38+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_58364078-3f87-4739-8414-e3a91da80137.webp?v=1783068818","width":800,"height":800},{"id":60146067472651,"created_at":"2025-09-09T21:44:28+03:00","position":2,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hbf20e73038174625bd6dd6e997891226d.jpg?v=1757443694","width":800,"height":800},{"id":60146065113355,"created_at":"2025-09-09T21:44:06+03:00","position":3,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_c12b22dc-699d-49a9-ba6a-65272d479aa6.png?v=1757443694","width":2000,"height":2000},{"id":60146067538187,"created_at":"2025-09-09T21:44:28+03:00","position":4,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H32192f28a0514f67bb0914a7d0cbbeecV.jpg?v=1757443694","width":800,"height":715},{"id":60146065146123,"created_at":"2025-09-09T21:44:06+03:00","position":5,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_13087b41-0c51-41ea-b685-0c03b721abe9.png?v=1757443694","width":2000,"height":2000},{"id":60146065178891,"created_at":"2025-09-09T21:44:06+03:00","position":6,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_1667a137-ea0f-48ee-a5a6-5c09d204aee1.png?v=1757443694","width":2000,"height":2000},{"id":60146065211659,"created_at":"2025-09-09T21:44:06+03:00","position":7,"updated_at":"2025-09-09T21:45:28+03:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_ba332b71-1a31-4609-9708-84bc4e701ce5.png?v=1757443528","width":2000,"height":2000},{"id":62528388038923,"created_at":"2025-11-20T16:16:31+02:00","position":8,"updated_at":"2025-11-20T16:16:53+02:00","product_id":10716594798859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT028_400CH_EPREL_cef53705-adf4-405c-bde9-50f36075dd28.png?v=1763648213","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10716601680139,"title":"Lustra LED suspendata cu telecomanda si cristal 50W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-50w-2-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cp\u003eLustra LED suspendată 50W cu 2 cercuri și elemente din cristal este o piesă decorativă statement, concepută pentru interioare elegante și moderne. Finisajul crom lucios reflectă subtil lumina, iar cristalele amplifică efectul vizual, creând o atmosferă rafinată și luminoasă.\u003c\/p\u003e\u003ch3\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePutere:\u003c\/strong\u003e 50W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCuloare:\u003c\/strong\u003e Crom lucios\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDimensiuni:\u003c\/strong\u003e 55 x 60 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMontaj:\u003c\/strong\u003e Suspendat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eFuncționalități și beneficii\u003c\/h3\u003e\u003cp\u003e✔ Selectarea temperaturii de culoare în funcție de momentul zilei\u003cbr\u003e✔ Intensitate reglabilă pentru ambient personalizat\u003cbr\u003e✔ Cristale decorative ce oferă reflexii elegante\u003cbr\u003e✔ Înălțime ajustabilă – adaptabilă la diferite tipuri de tavane\u003cbr\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp\u003ePrin combinația dintre designul circular suspendat, finisajul crom lucios și detaliile din cristal, lustra LED 50W oferă echilibru între performanță și estetică sofisticată, devenind punctul central al încăperii.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-29T19:27:09+03:00","created_at":"2025-09-09T21:47:12+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428751798539,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT028\/550CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"579.99","grams":0,"compare_at_price":"699.99","position":1,"product_id":10716601680139,"created_at":"2025-09-30T15:29:13+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":60146089459979,"created_at":"2025-09-09T21:47:32+03:00","position":1,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_76f39d24-7cf1-4552-9e53-65ff759c6dc4.jpg?v=1757443694","width":1242,"height":1242},{"id":60146067472651,"created_at":"2025-09-09T21:44:28+03:00","position":2,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hbf20e73038174625bd6dd6e997891226d.jpg?v=1757443694","width":800,"height":800},{"id":60146065113355,"created_at":"2025-09-09T21:44:06+03:00","position":3,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_c12b22dc-699d-49a9-ba6a-65272d479aa6.png?v=1757443694","width":2000,"height":2000},{"id":60146067538187,"created_at":"2025-09-09T21:44:28+03:00","position":4,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H32192f28a0514f67bb0914a7d0cbbeecV.jpg?v=1757443694","width":800,"height":715},{"id":60146065146123,"created_at":"2025-09-09T21:44:06+03:00","position":5,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_13087b41-0c51-41ea-b685-0c03b721abe9.png?v=1757443694","width":2000,"height":2000},{"id":60146065178891,"created_at":"2025-09-09T21:44:06+03:00","position":6,"updated_at":"2025-09-09T21:48:14+03:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_1667a137-ea0f-48ee-a5a6-5c09d204aee1.png?v=1757443694","width":2000,"height":2000},{"id":62528374210827,"created_at":"2025-11-20T16:15:00+02:00","position":7,"updated_at":"2025-11-20T16:15:03+02:00","product_id":10716601680139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT028_550CH_EPREL_01ee2b7b-f681-48d2-8843-ac4640ddbd50.png?v=1763648103","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10721325121803,"title":"Lustra LED suspendata cu Telecomanda RIMINI 86W, 5 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-suspendata-cu-telecomanda-rimini-86w-5-elemente-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp class=\"p1\"\u003e\u003cb\u003eLustra LED cu telecomanda Rimini – Iluminat versatil pentru orice incapere\u003c\/b\u003e\u003cb\u003e\u003c\/b\u003e\u003c\/p\u003e\u003cp class=\"p3\"\u003eCu un design geometric bazat pe 5 cercuri LED, \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED cu telecomanda Rimini\u003c\/b\u003e\u003c\/span\u003e este potrivita pentru dormitor, living sau bucatarie. Cele cinci surse circulare ofera o distributie uniforma a luminii si transforma orice incapere intr-un spatiu bine luminat si placut vizual.\u003c\/p\u003e\u003cp class=\"p3\"\u003eCu o putere de 86W si un flux luminos de 6880lumeni, asigura suficienta lumina pentru activitatile zilnice, fara a consuma excesiv. Poti comuta intre lumina \u003cspan class=\"s1\"\u003e\u003cb\u003erece, calda sau neutra (3000K, 4000K, 6000K)\u003c\/b\u003e\u003c\/span\u003e in functie de momentul zilei, folosind telecomanda inclusa sau intrerupatorul clasic.\u003c\/p\u003e\u003cp class=\"p3\"\u003eEste o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED dimabila cu telecomanda 3 functii\u003c\/b\u003e\u003c\/span\u003e, cu durata de viata estimata la 25.000 de ore, ideala pentru cei care cauta fiabilitate pe termen lung. Constructia din metal si acril, finisata in auriu, o face compatibila cu decoruri diverse, iar forma suspendata si rotunjita o recomanda si ca \u003cspan class=\"s1\"\u003e\u003cb\u003elustra cercuri LED\u003c\/b\u003e\u003c\/span\u003e.\u003c\/p\u003e\u003cp class=\"p3\"\u003eSe monteaza pe tavan si functioneaza cu \u003cspan class=\"s1\"\u003e\u003cb\u003ebanda LED\u003c\/b\u003e\u003c\/span\u003e, fiind potrivita pentru interior. O alegere practica pentru cei care doresc o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru sufragerie\u003c\/b\u003e\u003c\/span\u003e, dar si pentru \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru bucatarie\u003c\/b\u003e\u003c\/span\u003e sau \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru dormitor\u003c\/b\u003e\u003c\/span\u003e.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:170\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:26:15+03:00","created_at":"2025-09-12T10:09:22+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52429941833995,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT331\/5UGD","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.97","grams":0,"compare_at_price":"399.99","position":1,"product_id":10721325121803,"created_at":"2025-09-30T17:57:27+03:00","updated_at":"2026-09-1