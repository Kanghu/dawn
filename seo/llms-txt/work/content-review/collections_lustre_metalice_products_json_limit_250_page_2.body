les\/1\/0782\/5175\/3739\/files\/Label_2546907_big_color_cfe8714b-8256-4377-b1f3-9705c72e5300.png?v=1784531352","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10945770291467,"title":"Lustra LED RONDA Nobile cu telecomanda 46W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-46w-3-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"05eff12602d2cf0a\"\u003e\u003cdiv class=\"response-container ng-tns-c1310598610-31 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"response-content ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_05eff12602d2cf0a\" dir=\"ltr\"\u003e\n\u003cp\u003e\u003cstrong\u003eLustra LED RONDA Nobile\u003c\/strong\u003e cu telecomanda 46W, iti ofera control complet asupra luminii din casa. Design geometric cu patru patrate, finisaj alb mat, materiale solide: metal si acril. Ai trei tipuri de lumina (rece, calda, neutra), toate reglabile din telecomanda – ajustezi intensitatea si temperatura de culoare cum vrei. Se poate schimba tipul de lumina si din intrerupatorul clasic, prin apasari succesive.\u003c\/p\u003e\n\u003cp\u003eFlux luminos puternic, 3680lm, suficient pentru camere mari. Consum redus, durata de viata 25.000 ore. Merge in living, dormitor, bucatarie sau birou. \u003c\/p\u003e\n\u003cp data-sourcepos=\"16:1-16:188\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2026-05-03T23:10:48+03:00","created_at":"2026-04-24T14:43:22+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":53072336978187,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT763\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.79","grams":0,"compare_at_price":"179.99","position":1,"product_id":10945770291467,"created_at":"2026-04-24T14:43:23+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68495434514699,"created_at":"2026-04-24T14:44:04+03:00","position":1,"updated_at":"2026-04-24T14:44:09+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage24apr.2026_14_35_20.png?v=1777031049","width":1254,"height":1254},{"id":68584238973195,"created_at":"2026-04-29T14:32:16+03:00","position":2,"updated_at":"2026-04-29T14:34:11+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage24apr.2026_14_35_20_0d6ed2d5-4cdb-4c28-a713-644806a69eec.png?v=1777462451","width":1024,"height":1024},{"id":68584239825163,"created_at":"2026-04-29T14:32:19+03:00","position":3,"updated_at":"2026-04-29T14:35:02+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage24apr.2026_14_35_20_a0a4e0d7-d69e-49e0-a424-d53632730798.png?v=1777462502","width":1024,"height":1024},{"id":68584240677131,"created_at":"2026-04-29T14:32:23+03:00","position":4,"updated_at":"2026-04-29T14:35:55+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage24apr.2026_14_35_20_c739912d-5055-4a5f-8fe5-3f692da4ad60.png?v=1777462555","width":1024,"height":1024},{"id":68861943316747,"created_at":"2026-05-13T09:46:39+03:00","position":5,"updated_at":"2026-05-13T09:47:50+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage13mai2026_09_46_28.png?v=1778654870","width":1024,"height":1024},{"id":68584256438539,"created_at":"2026-04-29T14:36:05+03:00","position":6,"updated_at":"2026-04-29T14:36:10+03:00","product_id":10945770291467,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage29apr.2026_14_34_33.png?v=1777462570","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10134857810187,"title":"Lustra LED SQUARE 57W, 3 Patrate, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-square-57w-3-patrate-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"5:1-5:222\"\u003eAceastă lustra LED elegantă prezintă un design minimalist, compus din \u003cstrong\u003etrei pătrate dispuse armonios\u003c\/strong\u003e, adăugând un plus de stil contemporan oricărei încăperi. Finisajul \u003cstrong\u003ealb\u003c\/strong\u003e pur conferă un aspect curat și luminos.Cu o putere de \u003cstrong\u003e57W\u003c\/strong\u003e, lustra LED SQUARE oferă o iluminare eficientă și uniformă, ideală pentru livinguri, dormitoare, holuri sau birouri. Bucură-te de flexibilitatea \u003cstrong\u003etrei opțiuni de lumină\u003c\/strong\u003e integrate, adaptabile oricărei atmosfere:\u003c\/p\u003e\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:103\"\u003e\n\u003cstrong\u003eLumină Rece (alb):\u003c\/strong\u003e Perfectă pentru activități care necesită concentrare și o senzație de energie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:100\"\u003e\n\u003cstrong\u003eLumină Caldă (galben):\u003c\/strong\u003e Creează un ambient primitor și relaxant, ideal pentru serile liniștite.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eLumină Neutră:\u003c\/strong\u003e O opțiune echilibrată, potrivită pentru iluminatul general de zi cu zi.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-04-29T15:42:39+03:00","created_at":"2025-04-15T14:45:16+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52406915399947,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL647\/300P","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"144.99","position":1,"product_id":10134857810187,"created_at":"2025-09-24T01:05:07+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70091946787083,"created_at":"2026-09-09T13:23:05+03:00","position":1,"updated_at":"2026-09-09T13:31:34+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_1.png?v=1788949894","width":1254,"height":1254},{"id":70091888591115,"created_at":"2026-09-09T13:09:25+03:00","position":2,"updated_at":"2026-09-09T13:31:47+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_2.png?v=1788949907","width":1254,"height":1254},{"id":70091928666379,"created_at":"2026-09-09T13:18:41+03:00","position":3,"updated_at":"2026-09-09T13:31:59+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_3.png?v=1788949919","width":1247,"height":1247},{"id":70091935875339,"created_at":"2026-09-09T13:21:03+03:00","position":4,"updated_at":"2026-09-09T13:32:08+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_4.png?v=1788949928","width":1254,"height":1254},{"id":70091973656843,"created_at":"2026-09-09T13:29:38+03:00","position":5,"updated_at":"2026-09-09T13:32:19+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_5.png?v=1788949939","width":1254,"height":1254},{"id":70091977556235,"created_at":"2026-09-09T13:30:57+03:00","position":6,"updated_at":"2026-09-09T13:32:31+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_SQUARE_57W_3_Patrate_lumina_Rece_Calda_Neutra_Alb_6.png?v=1788949951","width":1254,"height":1254},{"id":69959811825931,"created_at":"2026-08-21T14:05:25+03:00","position":7,"updated_at":"2026-08-21T14:05:28+03:00","product_id":10134857810187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2523605_big_color_44384be1-b719-4871-8c78-569fa14f583a.png?v=1787310328","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757935108363,"title":"Lustra LED PULSARIS 40W, 3 Patrate, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-pulsaris-40w-3-patrate-lumina-neutra-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:54\"\u003e\u003cstrong\u003eDesign Modern și Lumină Clară: Lustra LED Pulsaris\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:251\"\u003eAdaugă un plus de stil contemporan și o iluminare eficientă în spațiul tău cu lustra LED Pulsaris. Designul său modern, realizat din \u003cstrong\u003eacril\u003c\/strong\u003e de înaltă calitate cu un finisaj \u003cstrong\u003enegru\u003c\/strong\u003e elegant, aduce un aer sofisticat și minimalist oricărei încăperi.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:181\"\u003eCu o putere eficientă de \u003cstrong\u003e40W\u003c\/strong\u003e, lustra \u003cstrong\u003ePulsaris\u003c\/strong\u003e oferă o iluminare uniformă și plăcută. Bucură-te de flexibilitatea \u003cstrong\u003etrei tipuri de lumină\u003c\/strong\u003e integrate, adaptabile oricărei atmosfere:\u003c\/p\u003e\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:80\"\u003e\n\u003cstrong\u003eRece (alb):\u003c\/strong\u003e Ideală pentru activități care necesită concentrare și energie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:95\"\u003e\n\u003cstrong\u003eCaldă (galben):\u003c\/strong\u003e Creează un ambient primitor și relaxant, perfect pentru serile liniștite.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eNeutră:\u003c\/strong\u003e O lumină echilibrată, potrivită pentru utilizarea zilnică.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"9:1-9:253\"\u003eConstrucția din \u003cstrong\u003eacril\u003c\/strong\u003e nu doar conferă un aspect modern, ci și asigură o difuzie uniformă a luminii, eliminând umbrele dure și creând un ambient plăcut. Finisajul \u003cstrong\u003enegru\u003c\/strong\u003e adaugă un contrast elegant și se integrează ușor în diverse stiluri de decor.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:112\"\u003eCu un indice de protecție \u003cstrong\u003eIP20\u003c\/strong\u003e, lustra Pulsaris este potrivită pentru utilizare în interior, în zone uscate.\u003c\/p\u003e\u003cp data-sourcepos=\"13:1-13:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"15:1-21:0\"\u003e\n\u003cli data-sourcepos=\"15:1-15:76\"\u003e\n\u003cstrong\u003eDesign Modern și Minimalist:\u003c\/strong\u003e Formă simplă și elegantă din acril negru.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eTrei Tipuri de Lumină:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru a se potrivi oricărei ocazii.\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:84\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 40W, oferind o iluminare bună cu un consum redus de energie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:61\"\u003e\n\u003cstrong\u003eMaterial Acrilic:\u003c\/strong\u003e Asigură o difuzie uniformă a luminii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-19:58\"\u003e\n\u003cstrong\u003eFinisaj Negru:\u003c\/strong\u003e Adaugă un contrast elegant și modern.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-21:0\"\u003e\n\u003cstrong\u003eProtecție IP20:\u003c\/strong\u003e Potrivită pentru utilizare în interior, în zone uscate.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"22:1-22:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"24:1-29:0\"\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare Versatilă:\u003c\/strong\u003e Alege temperatura de culoare potrivită pentru fiecare moment.\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:86\"\u003e\n\u003cstrong\u003eDesign Modern și Discret:\u003c\/strong\u003e Se potrivește cu ușurință în diverse stiluri de decor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:74\"\u003e\n\u003cstrong\u003eAmbient Plăcut:\u003c\/strong\u003e Difuzia uniformă a luminii previne oboseala ochilor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eUșor de Integrat:\u003c\/strong\u003e Designul simplu se potrivește cu diverse scheme de culori.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"30:1-30:211\"\u003eLustra LED Pulsaris este alegerea ideală pentru cei care apreciază un design modern, o lumină neutră de calitate și o iluminare eficientă pentru interiorul casei lor. Bucură-te de simplitatea elegantă a luminii!\u003c\/p\u003e","published_at":"2025-04-29T17:22:20+03:00","created_at":"2025-02-24T19:37:07+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Delistat","Delistat archived","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52427578441995,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL801\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"49.99","grams":0,"compare_at_price":"119.99","position":1,"p