s:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_8f902a60-eef7-45c5-8fff-43719cae3fb3.png?v=1758205099","width":2000,"height":2000},{"id":60434556649739,"created_at":"2025-09-18T17:15:46+03:00","position":7,"updated_at":"2025-09-18T17:18:19+03:00","product_id":10240601817355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_9389d2c2-8a46-474f-9639-81a293cb3a63.png?v=1758205099","width":2000,"height":2000},{"id":60434557174027,"created_at":"2025-09-18T17:15:52+03:00","position":8,"updated_at":"2025-09-18T17:15:56+03:00","product_id":10240601817355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_72efe27a-7544-4465-952b-2dd396399ca7.png?v=1758204956","width":2000,"height":2000},{"id":60434557894923,"created_at":"2025-09-18T17:15:58+03:00","position":9,"updated_at":"2025-09-18T17:18:09+03:00","product_id":10240601817355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_780ad096-f029-42be-9db7-f2146020d8ec.png?v=1758205089","width":3000,"height":3000},{"id":62880564773131,"created_at":"2025-11-30T12:59:26+02:00","position":10,"updated_at":"2025-11-30T12:59:30+02:00","product_id":10240601817355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT172_6WH_PREL.png?v=1764500370","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10246704103691,"title":"Plafoniera LED SOLIS 47cm 70W Lumina Rece Alb","handle":"plafoniera-led-luma-69w-lumina-rece-alb","body_html":"\u003cp\u003ePlafoniera LED, o solutie de iluminat ce redefinedeste spatiul printr-o estetica minimalista si o performanta luminoasa remarcabila. Conceputa pentru a adauga un accent modern si functional, aceasta plafoniera este alegerea ideala pentru interioarele contemporane.\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Elegant \u0026amp; Profil Subtire:\u003c\/strong\u003e Cu o \u003cstrong\u003eforma de cerc\u003c\/strong\u003e si un finisaj \u003cstrong\u003ealb \u003c\/strong\u003esofisticat, realizata din \u003cstrong\u003emetal si acril\u003c\/strong\u003e, aceasta plafoniera se monteaza \u003cstrong\u003eaplicat pe tavan\u003c\/strong\u003e, integrandu-se discret in orice decor modern. Are o inaltime de doar \u003cstrong\u003e3.5 cm\u003c\/strong\u003e si un diametru de \u003cstrong\u003e47 cm\u003c\/strong\u003e.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare Clare si Eficienta:\u003c\/strong\u003e Beneficiati de o putere de \u003cstrong\u003e70W\u003c\/strong\u003e si un \u003cstrong\u003eflux luminos de 5460lm\u003c\/strong\u003e, cu o \u003cstrong\u003elumina rece de 6000K\u003c\/strong\u003e. Aceasta asigura o vizibilitate excelenta si o atmosfera energizanta, controlabila printr-un \u003cstrong\u003eintrerupator clasic\u003c\/strong\u003e.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eFiabilitate pe Termen Lung:\u003c\/strong\u003e Echipata cu \u003cstrong\u003ebanda LED\u003c\/strong\u003e, plafoniera ofera o \u003cstrong\u003eautonomie de 25.000 de ore\u003c\/strong\u003e, garantand o utilizare indelungata si costuri reduse de intretinere.\u003c\/li\u003e\n\u003cli\u003eEste recomandata pentru \u003cstrong\u003ebucatarie, hol, living, dressing, birou sau dormitor\u003c\/strong\u003e.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eAceasta Plafoniera LED este alegerea perfecta pentru cei ce cauta o combinatie de eficienta, estetica si durabilitate, transformand orice incapere intr-un spatiu vibrant si functional.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-06-17T12:54:31+03:00","created_at":"2025-06-12T13:06:09+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["active","Corpuri de Iluminat","Lustre LED","Plafoniere LED"],"variants":[{"id":52425980969227,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-PL100\/47WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":10246704103691,"created_at":"2025-09-30T01:08:50+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70027016995083,"created_at":"2026-09-02T14:01:55+03:00","position":1,"updated_at":"2026-09-02T14:02:36+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_70W_Lumina_Rece_Alb_1.png?v=1788346956","width":1254,"height":1254},{"id":60804887937291,"created_at":"2025-09-30T11:58:46+03:00","position":2,"updated_at":"2026-08-20T10:53:16+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_5.jpg?v=1787212396","width":800,"height":800},{"id":62983470350603,"created_at":"2025-12-03T17:17:10+02:00","position":3,"updated_at":"2026-08-20T10:53:27+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_6.jpg?v=1787212407","width":800,"height":800},{"id":69955636068619,"created_at":"2026-08-20T10:46:49+03:00","position":4,"updated_at":"2026-08-20T10:53:36+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_7.png?v=1787212416","width":1254,"height":1254},{"id":69517802602763,"created_at":"2026-06-16T14:48:41+03:00","position":5,"updated_at":"2026-08-20T10:52:46+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_2.jpg?v=1787212366","width":1024,"height":1024},{"id":60804887904523,"created_at":"2025-09-30T11:58:46+03:00","position":6,"updated_at":"2026-08-20T10:52:55+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_3H3853423c48b7437ea26be938390c31cfQ.jpg?v=1787212375","width":1024,"height":1024},{"id":60804884234507,"created_at":"2025-09-30T11:58:16+03:00","position":7,"updated_at":"2026-08-20T10:53:04+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_4.png?v=1787212384","width":1024,"height":1024},{"id":69517845823755,"created_at":"2026-06-16T14:59:32+03:00","position":8,"updated_at":"2026-08-20T10:53:44+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Plafoniera_LED_SOLIS_47cm_69W_Lumina_Rece_Alb_8.png?v=1787212424","width":1254,"height":1254},{"id":69959462125835,"created_at":"2026-08-21T11:34:16+03:00","position":9,"updated_at":"2026-08-21T11:34:18+03:00","product_id":10246704103691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2547082_big_color.png?v=1787301258","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759840764171,"title":"Lustra LED VERTEX Flow 24W, Diametru 25cm, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-vertex-flow-24w-diametru-25cm-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED VERTEX Flow este o alegere excelentă pentru a adăuga un element de iluminat modern și stilat în spații mici. Cu o putere de 24W și un flux luminos de 1920lm, VERTEX Flow oferă o iluminare adecvată și atmosferică, ideală pentru a crea un ambient plăcut și confortabil în încăperi restrânse.\u003cbr\u003e\u003cbr\u003eDesignul său distinctiv, cu o formă ondulată și finisajul în negru, aduce un aspect contemporan și elegant. Cu un diametru de 25cm, VERTEX Flow este proporționată ideal pentru a adăuga un punct de accent în spații precum holuri, birouri mici sau chiar ca o sursă de lumină suplimentară în livinguri.\u003cbr\u003e\u003cbr\u003eUnul dintre punctele forte ale lustrei VERTEX Flow este capacitatea sa de a oferi trei tipuri de lumină - caldă, rece și neutră. Această versatilitate îți permite să schimbi atmosfera camerei în funcție de momentul zilei sau de starea dorită, fie că dorești o lumină caldă pentru o atmosferă relaxantă, o lumină rece pentru a accentua claritatea, sau o lumină neutră pentru un echilibru vizual. Designul ondulat al VERTEX Flow nu este doar estetic plăcut, dar și funcțional, deoarece ajută la dispersia uniformă a luminii în încăpere. Fie că este utilizată singură sau în combinație cu alte surse de iluminat, VERTEX Flow va atrage privirile și va adăuga o notă de rafinament.\u003cbr\u003e\u003cbr\u003eInstalarea acestei lustre este simplă și intuitivă, permițându-ți să te bucuri rapid de noua ta sursă de lumină și de elementul de design. Indiferent de locul unde este plasată, VERTEX Flow va aduce un plus de stil și funcționalitate.\u003cbr\u003e\u003cbr\u003eAlege lustra LED VERTEX Flow pentru a transforma orice spațiu mic într-un loc plin de eleganță și lumină modernă. Sub lumina sa, fiecare colț al camerei va fi revigorat, creând o atmosferă plăcută și sofisticată.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:48:15+02:00","created_at":"2025-02-25T00:48:15+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52161436090635,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-3065BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9759840764171,"created_at":"2025-09-04T01:15:14+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51838278500619,"created_at":"2025-02-25T00:48:18+02:00","position":1,"updated_at":"2025-02-25T00:48:20+02:00","product_id":9759840764171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-jenny-24w-alb-negru_LL1933AL_01.webp?v=1740437300","width":900,"height":900},{"id":51838278566155,"created_at":"2025-02-25T00:48:18+02:00","position":2,"updated_at":"2025-02-25T00:48:20+02:00","product_id":9759840764171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-jenny-24w-alb-negru_LL1933AL_02.webp?v=1740437300","width":900,"height":900},{"id":51838278533387,"created_at":"2025-02-25T00:48:18+02:00","position":3,"updated_at":"2025-02-25T00:48:20+02:00","product_id":9759840764171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-jenny-24w-alb-negru_LL1933AL_03.webp?v=1740437300","width":900,"height":900},{"id":51838278598923,"created_at":"2025-02-25T00:48:18+02:00","position":4,"updated_at":"2025-02-25T00:48:20+02:00","product_id":9759840764171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-jenny-24w-alb-negru_LL1933AL_04.webp?v=1740437300","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760414761227,"title":"Lustra LED cu telecomanda BETTY 127W, 8 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-betty-127w-8-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-end=\"481\" data-start=\"97\"\u003e\u003cstrong data-end=\"123\" data-start=\"97\"\u003eLustra LED BETTY, 127W\u003c\/strong\u003e, este un corp de iluminat modern cu impact vizual puternic, conceput pentru interioare ample și contemporane. Structura sa este formată din \u003cstrong data-end=\"294\" data-start=\"264\"\u003eopt cercuri interconectate\u003c\/strong\u003e, finisate într-un \u003cstrong data-end=\"330\" data-start=\"313\"\u003enegru elegant\u003c\/strong\u003e, oferind un joc geometric spectaculos și un efect decorativ deosebit. BETTY nu este doar o lustră, ci o piesă centrală care transformă orice încăpere.\u003c\/p\u003e\u003cp data-end=\"481\" data-start=\"97\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"898\" data-start=\"483\"\u003eDatorită tehnologiei LED integrate, această lustră îți oferă \u003cstrong data-end=\"569\" data-start=\"544\"\u003etrei tipuri de lumină\u003c\/strong\u003e – rece, neutră și caldă – astfel încât poți adapta atmosfera în funcție de activități, momentul zilei sau preferințe. Funcția de \u003cstrong data-end=\"710\" data-start=\"699\"\u003edimming\u003c\/strong\u003e (specifică modelelor moderne din această categorie) permite ajustarea intensității luminoase pentru un confort vizual perfect, fie că este vorba de relaxare, lucru sau iluminare generală.\u003c\/p\u003e\u003cp data-end=\"898\" data-start=\"483\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1138\" data-start=\"900\"\u003eDesignul compus din cele opt cercuri creează un ansamblu dinamic și sofisticat, ideal pentru \u003cstrong data-end=\"1064\" data-start=\"993\"\u003elivinguri spațioase, sufragerii, zone open-space sau spații premium\u003c\/strong\u003e în care se dorește un corp de iluminat atât funcțional, cât și decorativ.\u003c\/p\u003e\u003cp data-end=\"1138\" data-start=\"900\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1356\" data-start=\"1140\"\u003eCu o putere impresionantă de \u003cstrong data-end=\"1177\" data-start=\"1169\"\u003e127W\u003c\/strong\u003e, BETTY asigură o acoperire luminoasă amplă, eficientă și uniformă, devenind alegerea potrivită pentru cei care își doresc un iluminat modern, versatil și cu adevărat spectaculos.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:27:20+02:00","created_at":"2025-02-25T02:27:20+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52359960658187,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/8BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":9760414761227,"created_at":"2025-09-12T13:31:36+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70061961969931,"created_at":"2026-09-07T11:09:06+03:00","position":1,"updated_at":"2026-09-07T11:09:58+03:00","product_id":9760414761227,"variant_ids":[],"src":"https:\/\/cdn.