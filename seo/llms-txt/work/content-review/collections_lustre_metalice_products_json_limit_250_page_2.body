start=\"465\"\u003e\u003cstrong data-end=\"480\" data-start=\"465\"\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"567\" data-start=\"519\"\u003e\u003cp data-end=\"567\" data-start=\"521\"\u003e\u003cstrong data-end=\"540\" data-start=\"521\"\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"604\" data-start=\"568\"\u003e\u003cp data-end=\"604\" data-start=\"570\"\u003e\u003cstrong data-end=\"582\" data-start=\"570\"\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"635\" data-start=\"605\"\u003e\u003cp data-end=\"635\" data-start=\"607\"\u003e\u003cstrong data-end=\"622\" data-start=\"607\"\u003eDimensiuni:\u003c\/strong\u003e 60 x 26 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"692\" data-start=\"636\"\u003e\u003cp data-end=\"692\" data-start=\"638\"\u003e\u003cstrong data-end=\"651\" data-start=\"638\"\u003eÎnălțime:\u003c\/strong\u003e Reglabilă (sistem suspendat ajustabil)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"715\" data-start=\"693\"\u003e\u003cp data-end=\"715\" data-start=\"695\"\u003e\u003cstrong data-end=\"707\" data-start=\"695\"\u003eCuloare:\u003c\/strong\u003e Auriu\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"759\" data-start=\"716\"\u003e\u003cp data-end=\"759\" data-start=\"718\"\u003e\u003cstrong data-end=\"731\" data-start=\"718\"\u003eMaterial:\u003c\/strong\u003e Metal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-end=\"785\" data-start=\"760\"\u003e\u003cp data-end=\"785\" data-start=\"762\"\u003e\u003cstrong data-end=\"773\" data-start=\"762\"\u003eMontaj:\u003c\/strong\u003e Suspendat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003ch3 data-end=\"819\" data-start=\"787\"\u003eFuncționalități și beneficii\u003c\/h3\u003e\n\u003cp data-end=\"1110\" data-start=\"820\"\u003e✔ Ajustarea temperaturii de culoare în funcție de momentul zilei\u003cbr data-end=\"887\" data-start=\"884\"\u003e✔ Control al intensității pentru ambient personalizat\u003cbr data-end=\"943\" data-start=\"940\"\u003e✔ Înălțime reglabilă – adaptabilă la diferite tipuri de tavane\u003cbr data-end=\"1008\" data-start=\"1005\"\u003e✔ Iluminare uniformă și confort vizual ridicat\u003cbr data-end=\"1057\" data-start=\"1054\"\u003e✔ Consum redus și durată mare de viață a LED-urilor\u003c\/p\u003e\n\u003cp data-end=\"1447\" data-start=\"1232\"\u003ePrin combinația dintre designul contemporan în finisaj auriu și controlul inteligent al iluminării, lustra LED 96W devine un element central decorativ, oferind atât funcționalitate avansată, cât și eleganță vizuală.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003cdiv class=\"container hidden ng-star-inserted\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\n\u003c\/div\u003e","published_at":"2025-09-12T09:48:06+03:00","created_at":"2025-09-09T21:25:52+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52428751765771,"title":"Default Title","option1":"Default Title","option2":nu