\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage11iun.2026_09_44_24.png?v=1781160667","width":1254,"height":1254},{"id":69412630331659,"created_at":"2026-06-11T09:51:03+03:00","position":6,"updated_at":"2026-06-11T09:51:07+03:00","product_id":9760744145163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage11iun.2026_09_44_33.png?v=1781160667","width":1254,"height":1254},{"id":69412092182795,"created_at":"2026-06-11T09:40:07+03:00","position":7,"updated_at":"2026-06-11T09:40:10+03:00","product_id":9760744145163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2527871_big_color.png?v=1781160010","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10243184558347,"title":"Lustra LED cu Telecomanda MARIO, 32W, 8 Elemente, Lumina Rece\/Calda\/Neutra, Dimabila, Negru\/Auriu","handle":"lustra-led-cu-telecomanda-mario-32w-8-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu","body_html":"\u003cp data-sourcepos=\"1:1-1:248\"\u003eLED MARIO, o piesa de iluminat ce imbina estetica moderna cu functionalitatea avansata. Conceputa pentru a adauga o nota de rafinament, aceasta lustra este mai mult decat o sursa de lumina, este o declaratie de stil.\u003c\/p\u003e\u003cul data-sourcepos=\"3:1-6:0\"\u003e\n\u003cli data-sourcepos=\"3:1-3:276\"\u003e\n\u003cstrong\u003eDesign Contemporan \u0026amp; Materiale Rezistente:\u003c\/strong\u003e Cu o forma liniara si o combinatie sofisticata de negru si auriu, realizata din \u003cstrong\u003emetal si acril\u003c\/strong\u003e, lustra MARIO, cu cele \u003cstrong\u003e8 surse luminoase\u003c\/strong\u003e, devine un punct focal distinctiv, integrandu-se perfect in decorurile moderne.\u003c\/li\u003e\n\u003cli data-sourcepos=\"4:1-4:275\"\u003e\n\u003cstrong\u003eIluminare Versatila \u0026amp; Puternica:\u003c\/strong\u003e Beneficiati de o putere totala de \u003cstrong\u003e32W \u003c\/strong\u003esi un \u003cstrong\u003eflux luminos generos de 2560lm\u003c\/strong\u003e. Alegeti din cele \u003cstrong\u003etrei temperaturi de culoare (calda, neutra, rece)\u003c\/strong\u003e si controlati lumina intuitiv, oferind ambianta perfecta pentru orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"5:1-6:0\"\u003e\n\u003cstrong\u003eEficienta Energetica \u0026amp; Durabilitate:\u003c\/strong\u003e Tehnologia LED avansata asigura un \u003cstrong\u003econsum optim\u003c\/strong\u003e si o \u003cstrong\u003edurata de viata remarcabila de 25.000 de ore\u003c\/strong\u003e, oferind performanta pe termen lung si o intretinere minima.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"7:1-7:244\"\u003eLustra LED MARIO este solutia ideala pentru cei ce cauta o iluminare eficienta, estetica si durabila, transformand fiecare incapere intr-un spatiu plin de personalitate si un confort vizual exceptional, perfecta pentru hol, living sau dormitor.\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-17T11:06:06+03:00","created_at":"2025-06-12T09:28:42+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52429878526219,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT724\/8","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"399.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":10243184558347,"created_at":"2025-09-30T17:47:34+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56337851384075,"created_at":"2025-06-12T09:59:17+03:00","position":1,"updated_at":"2025-06-12T09:59:20+03:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT7248-LustraLEDMARIO_56W_LuminaReceCaldaNeutra_NegruAuriu-1.webp?v=1749711560","width":1080,"height":1080},{"id":56337851351307,"created_at":"2025-06-12T09:59:17+03:00","position":2,"updated_at":"2025-06-12T09:59:20+03:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT7248-LustraLEDMARIO_56W_LuminaReceCaldaNeutra_NegruAuriu-2.webp?v=1749711560","width":1080,"height":1080},{"id":56337851318539,"created_at":"2025-06-12T09:59:17+03:00","position":3,"updated_at":"2025-06-12T09:59:20+03:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT7248-LustraLEDMARIO_56W_LuminaReceCaldaNeutra_NegruAuriu-3.webp?v=1749711560","width":1080,"height":1080},{"id":56337851416843,"created_at":"2025-06-12T09:59:17+03:00","position":4,"updated_at":"2025-06-12T09:59:21+03:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT7248-LustraLEDMARIO_56W_LuminaReceCaldaNeutra_NegruAuriu-4.webp?v=1749711561","width":1080,"height":1080},{"id":62879780176139,"created_at":"2025-11-30T12:41:21+02:00","position":5,"updated_at":"2025-11-30T12:41:25+02:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT724_8_PREL.png?v=1764499285","width":2048,"height":2048},{"id":66175423676683,"created_at":"2026-02-22T00:24:55+02:00","position":6,"updated_at":"2026-02-22T00:24:57+02:00","product_id":10243184558347,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT724_8.webp?v=1771712697","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760727302411,"title":"Lustra LED cu Telecomanda LINEX, 81W, 6 Elemente, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-linex-81w-6-elemente-liniara-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-end=\"576\" data-start=\"156\"\u003e\u003cstrong data-end=\"201\" data-start=\"156\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_89ca3ac6-a820-4379-b5ea-87e82c3848bc.png?v=1778232411\" alt=\"\"\u003eLustra LED LINEX cu telecomandă (6 brațe)\u003c\/strong\u003e este un corp de iluminat modern, puternic și extrem de versatil. Oferă \u003cstrong\u003e81W\u003c\/strong\u003e și un flux luminos generos de \u003cstrong\u003e6480lm\u003c\/strong\u003e, suficient pentru a ilumina uniform un living, dormitor sau o bucătărie modernă. Lumina este \u003cstrong data-end=\"429\" data-start=\"416\"\u003edimabilă\u003c\/strong\u003e, cu trei temperaturi de culoare – \u003cstrong data-end=\"489\" data-start=\"464\"\u003e3000K, 4000K și 6000K\u003c\/strong\u003e – pentru a alege între atmosferă caldă, neutră sau rece, în funcție de momentul zilei.\u003c\/p\u003e\u003cp data-end=\"804\" data-start=\"578\"\u003ePoate fi controlată atât din \u003cstrong data-end=\"622\" data-start=\"607\"\u003etelecomandă\u003c\/strong\u003e, cât și din \u003cstrong data-end=\"660\" data-start=\"635\"\u003eintrerupătorul clasic\u003c\/strong\u003e, ceea ce o face ușor de utilizat în orice tip de locuință. Funcționează la \u003cstrong data-end=\"748\" data-start=\"736\"\u003e220–230V\u003c\/strong\u003e și are o durată de viață de aproximativ \u003cstrong data-end=\"803\" data-start=\"789\"\u003e25.000 ore\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-end=\"804\" data-start=\"578\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1121\" data-start=\"806\"\u003eDesignul său iese în evidență prin forma liniară, cu \u003cstrong data-end=\"879\" data-start=\"859\"\u003e6 brațe elegante\u003c\/strong\u003e, finisaj negru și combinația dintre \u003cstrong data-end=\"934\" data-start=\"916\"\u003emetal și acril\u003c\/strong\u003e, detalii care îi oferă un aspect modern și premium. Montajul este pe tavan, iar dimensiunile sunt de \u003cstrong data-end=\"1054\" data-start=\"1036\"\u003e70 × 8 × 13.5 cm\u003c\/strong\u003e. Clasa de protecție \u003cstrong data-end=\"1083\" data-start=\"1075\"\u003eIP20\u003c\/strong\u003e o recomandă pentru spații interioare.\u003c\/p\u003e\u003cp data-end=\"1121\" data-start=\"806\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1253\" data-start=\"1123\"\u003eO soluție excelentă dacă vrei lumină puternică, control total și un design actual, potrivit pentru living, bucătărie sau dormitor.\u003c\/p\u003e","published_at":"2025-02-25T03:14:05+02:00","created_at":"2025-02-25T03:14:04+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52423862518027,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT171\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":fal