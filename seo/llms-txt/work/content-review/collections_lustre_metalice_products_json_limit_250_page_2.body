_27W_2_Cercuri_lumina_Rece_Calda_Neutra_Dimabila_Negru_1.png?v=1787312802","width":1254,"height":1254},{"id":68771922575627,"created_at":"2026-05-08T13:27:17+03:00","position":7,"updated_at":"2026-08-21T14:46:08+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_790a7653-fbb6-44aa-a7de-070d1303cfa1.png?v=1787312768","width":1024,"height":1024},{"id":68771922608395,"created_at":"2026-05-08T13:27:17+03:00","position":8,"updated_at":"2026-05-08T13:27:21+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.SPECIFICATION_bc7c66f2-ba09-47a8-bf8e-7e6456906331.png?v=1778236041","width":1000,"height":1000},{"id":68771907666187,"created_at":"2026-05-08T13:23:43+03:00","position":9,"updated_at":"2026-05-08T13:23:47+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.PLACE1_076eedb3-d476-4d5a-b948-cee474a61398.png?v=1778235827","width":1000,"height":1000},{"id":68771907698955,"created_at":"2026-05-08T13:23:43+03:00","position":10,"updated_at":"2026-05-08T13:23:47+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.PLACE2_b409411a-9e65-495e-838f-0fcb08619896.png?v=1778235827","width":1000,"height":1000},{"id":68771907731723,"created_at":"2026-05-08T13:23:43+03:00","position":11,"updated_at":"2026-05-08T13:23:47+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.PLACE3_596adf80-fece-4390-8dfe-a439ec808d78.png?v=1778235827","width":1000,"height":1000},{"id":68771907764491,"created_at":"2026-05-08T13:23:43+03:00","position":12,"updated_at":"2026-05-08T13:23:48+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15.PLACE4_d4c1554f-6fc1-45f5-97df-10d08a81ae07.png?v=1778235828","width":1000,"height":1000},{"id":62880774422795,"created_at":"2025-11-30T13:37:55+02:00","position":13,"updated_at":"2026-05-14T16:13:47+03:00","product_id":9759485427979,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT800_2BK_PREL.png?v=1778764427","width":1010,"height":2018}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757535273227,"title":"Lustra LED suspendata cu telecomanda si cristal PRISM LUMINIS 79W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-prism-luminis-78-3w-3-cercuri-lumina-rece-calda-neutra-dimabila-argintiu-inaltime-reglabila","body_html":"\u003cp\u003eLustra LED cu telecomandă PRISM LUMINIS este o piesă de iluminat sofisticată, care îmbină strălucirea cristalelor cu tehnologia LED modernă. Cu o putere de 79W și un design elegant format din 3 cercuri concentrice, finisate în argintiu, aduce un plus de glamour și funcționalitate în orice încăpere.\u003c\/p\u003e\u003cp\u003eCele trei cercuri, decorate cu cristale strălucitoare, creează un efect vizual captivant, reflectând și refractând lumina într-un mod spectaculos. Telecomanda inclusă oferă un control total asupra atmosferei: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru relaxare) sau neutră (pentru iluminare generală), și poți ajusta intensitatea luminii datorită funcției de dimare.\u003c\/p\u003e\u003cp\u003eFinisajul argintiu al structurii adaugă o notă modernă și elegantă, completând perfect strălucirea cristalelor. Înălțimea reglabilă permite adaptarea lustrei la diferite înălțimi ale tavanelor, asigurând o integrare armonioasă în diverse spații.\u003c\/p\u003e\u003cp\u003eAceastă lustră este ideală pentru livinguri, sufragerii sau alte zone unde se dorește un impact vizual puternic și o iluminare versatilă.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T16:47:23+02:00","created_at":"2025-02-24T16:47:22+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale"],"variants":[{"id":52429930103051,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT029\/3","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"379.99","grams":0,"compare_at_price":"459.99","position":1,"product_id":9757535273227,"created_at":"2025-09-30T17:55:47+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69858433761547,"created_at":"2026-07-31T23:33:19+03:00","position":1,"updated_at":"2026-07-31T23:33:22+03:00","product_id":9757535273227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LT029.webp?v=1785530002","width":1000,"height":1000},{"id":69858434154763,"created_at":"2026-07-31T23:33:19+03:00","position":2,"updated_at":"2026-07-31T23:33:22+03:00","product_id":9757535273227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/014_14_LT029.webp?v=1785530002","width":1254,"height":1254},{"id":69858433728779,"created_at":"2026-07-31T23:33:19+03:00","position":3,"updated_at":"2026-07-31T23:33:22+03:00","product_id":9757535273