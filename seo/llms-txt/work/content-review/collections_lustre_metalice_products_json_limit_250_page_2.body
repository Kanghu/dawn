position":10,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LL660WH.webp?v=1785525838","width":1254,"height":1254},{"id":69858311733515,"created_at":"2026-07-31T22:23:55+03:00","position":11,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/011_11_LL660WH.webp?v=1785525838","width":1254,"height":1254},{"id":69858311766283,"created_at":"2026-07-31T22:23:55+03:00","position":12,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/012_12_LL660WH.webp?v=1785525838","width":1254,"height":1254},{"id":69858311799051,"created_at":"2026-07-31T22:23:55+03:00","position":13,"updated_at":"2026-07-31T22:23:58+03:00","product_id":9757454696715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/013_13_LL660WH.webp?v=1785525838","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779349127435,"title":"Lustră Suspendată LED Acril Butterfly 9W, Lumina Calda\/Neutra\/Rece 3000K\/4000K\/6000K, Auriu, Metal și Acril, Inaltime Reglabila","handle":"lustra-suspendata-led-acril-butterfly-9w-3000k-4000k-6000k-auriu-metal-si-acril-inaltime-reglabila","body_html":"\u003cp data-start=\"0\" data-end=\"101\"\u003e\u003cstrong data-start=\"0\" data-end=\"101\"\u003eLustră suspendată LED acril Butterfly, 9W, dimabilă, 3000K \/ 4000K \/ 6000K, auriu, metal și acril\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"103\" data-end=\"387\"\u003eLustra suspendată LED Butterfly este un corp de iluminat modern și delicat, cu design inspirat din forme organice, ideal pentru interioare elegante și spații contemporane. Finisajul auriu, combinat cu elemente din acril, oferă un aspect rafinat și luminos, cu impact decorativ subtil.\u003c\/p\u003e\u003cp data-start=\"103\" data-end=\"387\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"389\" data-end=\"684\"\u003eIluminarea LED integrată de 9W este dimabilă și permite selectarea temperaturii de culoare caldă, neutră sau rece (3000K \/ 4000K \/ 6000K), pentru adaptarea atmosferei în funcție de momentul zilei și de utilizare. Lumina este uniform distribuită, asigurând confort vizual și eficiență energetică.\u003c\/p\u003e\u003cp data-start=\"389\" data-end=\"684\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-start=\"686\" data-end=\"950\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eStructura din metal și acril garantează durabilitate și stabilitate, iar designul suspendat o face potrivită pentru livinguri, dormitoare, zone de dining sau spații decorative. Lustra Butterfly este o alegere practică și estetică pentru iluminatul interior modern.\u003c\/p\u003e","published_at":"2025-09-19T18:30:47+03:00","created_at":"2025-03-06T18:46:14+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","ETA 03.Oct","Lustre LED"],"variants":[{"id":52428511936779,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT950\/3GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"379.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9779349127435,"created_at":"2025-09-30T14:07:49+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":59262842896651,"created_at":"2025-08-19T10:38:59+03:00","position":1,"updated_at"