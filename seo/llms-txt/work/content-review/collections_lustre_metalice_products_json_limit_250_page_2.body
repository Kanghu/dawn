tive;    display: block;    width: 100%;    max-width: 560px;    margin: 0 auto;    height: 0;    padding-bottom: 40%; \/* Adjusted aspect ratio for less height *\/    overflow: hidden;}.video-link img {    position: absolute;    top: 0;    left: 0;    width: 100%;    height: 100%;}\u003c\/style\u003e\u003cdiv style=\"text-align: center;\" class=\"containerimg-mobile\"\u003e\n\u003cp style=\"text-align: left;\" data-end=\"358\" data-start=\"91\"\u003e\u003cstrong data-end=\"120\" data-start=\"91\"\u003eLustra LED cu telecomanda\u003c\/strong\u003e, aplicata, cu forma rotunda si design discret, potrivita pentru \u003cstrong data-end=\"211\" data-start=\"185\"\u003ebaie, hol sau dressing\u003c\/strong\u003e. Functioneaza pe baza de \u003cstrong data-end=\"250\" data-start=\"237\"\u003ebanda LED\u003c\/strong\u003e si permite selectarea temperaturii de culoare – \u003cstrong data-end=\"332\" data-start=\"299\"\u003elumina calda, neutra sau rece\u003c\/strong\u003e – direct din telecomanda.\u003c\/p\u003e\n\u003cp style=\"text-align: left;\" data-end=\"358\" data-start=\"91\"\u003eAsigura \u003cstrong data-end=\"416\" data-start=\"368\"\u003eiluminare eficienta cu un consum de doar 39W\u003c\/strong\u003e, avand o durata de viata de \u003cstrong data-end=\"462\" data-start=\"445\"\u003e25.000 de ore\u003c\/strong\u003e. Este compatibila cu retele electrice de \u003cstrong data-end=\"516\" data-start=\"504\"\u003e220-230V\u003c\/strong\u003e ideala pentru spatii interioare.\u003c\/p\u003e\n\u003cp style=\"text-align: left;\" data-end=\"358\" data-start=\"91\"\u003eDimensiuni compacte – perfecte pentru incaperi cu tavan jos. Se monteaza usor, iar \u003cstrong data-end=\"728\" data-start=\"697\"\u003estilul modern si functional\u003c\/strong\u003e o face o alegere practica pentru orice locuinta.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:277\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cbr\u003e\n\u003c\/div\u003e\u003ch3 style=\"text-align: center;\"\u003eVideo demonstrativ\u003c\/h3\u003e\u003cdiv style=\"text-align: center;\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https:\/\/www.youtube.com\/watch?v=cLIMq9SsewA\" class=\"video-link\" target=\"_blank\"\u003e \u003cimg alt=\"YouTube video thumbnail\" src=\"https:\/\/img.youtube.com\/vi\/cLIMq9SsewA\/maxresdefault.jpg\"\u003e \u003c\/a\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: center;\" class=\"paragraf-descrieri\"\u003e \u003c\/p\u003e\u003c\/div\u003e","published_at":"2026-07-13T17:49:45+03:00","created_at":"2025-02-24T15:09:47+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","outlet","SUB50"],"variants":[{"id":52424947368203,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL631WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"49.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9757258711307,"created_at":"2025-09-29T18:25:45+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":58392503386379,"created_at":"2025-08-01T16:25:52+03:00","position":1,"updated_at":"2025-08-01T16:26:03+03:00","product_id":9757258711307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H19a2e80eb1824841a21098a1bd660d9bv.png?v=1754054763","width":1000,"height":1000},{"id":51814015271179,"created_at":"2025-02-24T15:09:50+02:00","position":2,"updated_at":"2025-08-01T16:26:03+03:00","product_id":9757258711307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL631WH-Lustra_LED_GUARELLA_18W_lumina_ReceCaldaNeutra_Alb-5.webp?v=1754054763","width":900,"height":900},{"id":51814015533323,"created_at":"2025-02-24T15:09:50+02:00","position":3,"updated_at":"2025-08-01T16:26:03+03:00","product_id":9757258711307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/white-LL631WH-Lustra_LED_GUARELLA_18W_lumina_ReceCaldaNeutra_Alb-1.webp?v=1754054763","width":900,"height":900},{"id":58392499912971,"created_at":"2025-08-01T16:25:47+03:00","position":4,"updated_at":"2025-08-01T16:26:03+03:00","product_id":9757258711307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-mari-30w-alb_LL38AL_03.jpg?v=1754054763","width":900,"height":900},{"id":62705833607435,"created_at":"2025-11-25T16:32:34+02:00","position":5,"updated_at":"2025-11-25T16:32:37+02:00","product_id":9757258711307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL631WH_EPREL.png?v=1764081157","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133459599627,"title":"Lustra LED KOMPACTO 56W, 3 Patrate, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-kompacto-56w-3-patrate-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-start=\"166\" data-end=\"467\" class=\"\"\u003eKOMPACTO  aduce o notă geometrică și ordonată în orice spațiu. Cu un design format din trei pătrate interconectate și un finisaj alb curat, această lustră este ideală pentru interioare moderne sau minimaliste. Puterea de 56W oferă lumină eficientă pentru camere de dimensiuni reduse sau medii.\u003c\/p\u003e\u003cp data-start=\"469\" data-end=\"869\" class=\"\"\u003e✔ \u003cstrong data-start=\"471\" data-end=\"490\"\u003e3 forme pătrate\u003c\/strong\u003e – design echilibrat, cu impact vizual discret.\u003cbr data-start=\"537\" data-end=\"540\"\u003e✔ \u003cstrong data-start=\"542\" data-end=\"578\"\u003eTemperatură de culoare reglabilă\u003c\/strong\u003e – rece, caldă și neutră, pentru fiecare moment al zilei.\u003cbr data-start=\"635\" data-end=\"638\"\u003e✔ \u003cstrong data-start=\"640\" data-end=\"652\"\u003eDimabilă\u003c\/strong\u003e – controlezi intensitatea luminii pentru confort sporit.\u003cbr data-start=\"709\" data-end=\"712\"\u003e✔ \u003cstrong data-start=\"714\" data-end=\"737\"\u003eDimensiuni compacte\u003c\/strong\u003e – perfectă pentru holuri, dormitoare, bucătării sau birouri.\u003cbr data-start=\"798\" data-end=\"801\"\u003e✔ \u003cstrong data-start=\"803\" data-end=\"822\"\u003eFinisaj alb mat\u003c\/strong\u003e – ușor de integrat în orice stil de amenajare.\u003c\/p\u003e\u003cp data-start=\"469\" data-end=\"869\" class=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:40:35+03:00","created_at":"2025-04-14T19:36:40+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428513214731,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL646\/300P","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":10133459599627,"created_at":"2025-09-30T14:08:00+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69858304262411,"created_at":"2026-07-31T22:20:53+03:00","position":1,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LL646-300P.webp?v=1785525656","width":1870,"height":841},{"id":69858304295179,"created_at":"2026-07-31T22:20:53+03:00","position":2,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304327947,"created_at":"2026-07-31T22:20:53+03:00","position":3,"updated_at":"2026-07-31T22:20:55+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LL646-300P.webp?v=1785525655","width":1254,"height":1254},{"id":69858304360715,"created_at":"2026-07-31T22:20:53+03:00","position":4,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304393483,"created_at":"2026-07-31T22:20:53+03:00","position":5,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304426251,"created_at":"2026-07-31T22:20:53+03:00","position":6,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304459019,"created_at":"2026-07-31T22:20:53+03:00","position":7,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304491787,"created_at":"2026-07-31T22:20:53+03:00","position":8,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LL646-300P.webp?v=1785525656","width":1254,"height":1254},{"id":69858304524555,"created_at":"2026-07-31T22:20:53+03:00","position":9,"updated_at":"2026-07-31T22:20:55+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LL646-300P.webp?v=1785525655","width":1254,"height":1254},{"id":69858304557323,"created_at":"2026-07-31T22:20:53+03:00","position":10,"updated_at":"2026-07-31T22:20:56+03:00","product_id":10133459599627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LL646-300P.webp?v=1785525656","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758338973963,"title":"Lustra LED cu telecomanda PAPINI 112W, 2 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios","handle":"lustra-led-cu-telecomanda-papini-112w-2-patrate-lumina-rece-calda-neutra-dimabila-auriu-lucios","body_html":"\u003cp\u003e\u003cspan style=\"font-size: 0.875rem;\"\u003eLustra LED cu telecomandă PAPINI este o piesă de iluminat modernă și elegantă, cu un design format din două pătrate stilizate, finisate în auriu. Cu o putere de 112W, oferă o iluminare versatilă și un plus de rafinament spațiului tău.\u003c\/span\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:509\"\u003eCele două pătrate aurii, dispuse probabil într-o manieră echilibrată și contemporană (fie alăturate, fie suprapuse parțial, sau la distanță), sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:233\"\u003eFinisajul auriu al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de lux și căldură încăperii. Cu o putere de 112W, este ideală pentru a ilumina livinguri, sufragerii sau alte încăperi de dimensiuni medii.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:19:51+02:00","created_at":"2025-02-24T21:19:50+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52408538333451,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-485\/2GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9758338973963,"created_at":"2025-09-24T13:53:17+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51821030965515,"created_at":"2025-02-24T21:19:52+02:00","position":1,"updated_at":"2025-02-24T21:19:53+02:00","product_id":9758338973963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-papini-telecomanda-112w-24ghz-dimabila-acril-auriu_LL1595_01.webp?v=1740424793","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760728711435,"title":"Lustra LED cu telecomanda DELLIAH 144W, 6 Elemente, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu Lucios","handle":"lustra-led-cu-telecomanda-delliah-144w-6-elemente-liniara-lumina-rece-calda-neutra-dimabila-negru-auriu-lucios","body_html":"\u003cp\u003eDescoperă luxul și funcționalitatea cu lustra LED cu telecomandă Delliah 144W, dimabilă, în culoarea negru, de la Alessandro Design. Cu o putere impresionantă de 144W, această lustră oferă o iluminare puternică și ajustabilă, perfectă pentru orice încăpere. Funcția de dimare prin telecomandă îți permite să personalizezi ambianța în funcție de nevoile tale. Designul său elegant și finisajul negru adaugă un plus de rafinament și stil modern locuinței tale. Iluminează-ți casa cu produse de calitate superioară de la Alessandro Design.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:14:16+02:00","created_at":"2025-02-25T03:14:16+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52400860594443,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-9803\/6BK+FGD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"439.99","grams":0,"compare_at_price":"439.99","position":1,"product_id":9760728711435,"created_at":"2025-09-22T11:56:41+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51853845954827,"created_at":"2025-02-25T03:14:18+02:00","position":1,"updated_at":"2025-02-25T03:14:19+02:00","product_id":9760728711435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-delliah-144w-dimabila-negru-1723639515.webp?v=1740446059","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759842861323,"title":"Lustra LED KYLIE 77W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-kylie-77w-3-cercuri-lumina-rece-calda-neutra-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți Lustra LED Kylie, o capodoperă de iluminat care aduce un stil geometric modern în orice spațiu. Această lustră unică, cu o putere de 77W, impresionează prin designul său format din trei cercuri de diferite dimensiuni, finisate într-un alb pur și elegant. Cu un diametru total de 54cm, Kylie este perfectă pentru a adăuga un element artistic în livinguri, dormitoare sau birouri.\u003cbr\u003e\u003cbr\u003eAceastă lustră nu este doar o piesă de decor atrăgătoare, ci și o sursă eficientă de lumină. Cu un flux luminos de 6160lm, Kylie oferă o iluminare puternică și poate fi ajustată pentru a se potrivi oricărui ambient, datorită celor trei tipuri de lumină disponibile: caldă, rece sau neutră. Funcționalitatea dimabilă, controlată ușor prin telecomandă, vă permite să creați atmosfera perfectă pentru fiecare moment.\u003cbr\u003e\u003cbr\u003ePentru a vedea această frumoasă lustră în acțiune și a aprecia calitatea și designul său excepțional, vă invităm să vizitați Showroom-ul Alessandro Design din Voluntari. Aici, puteți explora gama noastră extinsă de soluții de iluminat și puteți alege lustra Kylie pentru a aduce un plus de stil și lumină în casa dumneavoastră.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED Kylie pentru un design geometric modern, eficiență și flexibilitate în iluminat. Este o piesă care nu doar luminează, ci transformă orice încăpere într-un spațiu plin de stil și modernitate.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-07-01T19:57:31+03:00","created_at":"2025-02-25T00:51:09+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52423672267019,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-MV1A-HT2L-6020\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"189.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9759842861323,"created_at":"2025-09-29T09:56:06+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51838323097867,"created_at":"2025-02-25T00:51:12+02:00","position":1,"updated_at":"2025-02-25T00:51:14+02:00","product_id":9759842861323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-kylie-77w-dimabila-alb_LL1953AL_09.webp?v=1740437474","width":900,"height":900},{"id":51838323163403,"created_at":"2025-02-25T00:51:12+02:00","position":2,"updated_at":"2025-02-25T00:51:14+02:00","product_id":9759842861323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-amanda-telecomanda-130w-dimabila-alb_LL173_01-1699248869.webp?v=1740437474","width":900,"height":900},{"id":51838322999563,"created_at":"2025-02-25T00:51:12+02:00","position":3,"updated_at":"2025-02-25T00:51:14+02:00","product_id":9759842861323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-amanda-telecomanda-130w-dimabila-alb_LL173_02-1699248869.webp?v=1740437474","width":900,"height":900},{"id":51838323032331,"created_at":"2025-02-25T00:51:12+02:00","position":4,"updated_at":"2025-02-25T00:51:14+02:00","product_id":9759842861323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-amanda-telecomanda-130w-dimabila-alb_LL173_03-1699248869.webp?v=1740437474","width":900,"height":900},{"id":51838323065099,"created_at":"2025-02-25T00:51:12+02:00","position":5,"updated_at":"2025-02-25T00:51:14+02:00","product_id":9759842861323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-amanda-telecomanda-130w-dimabila-alb_LL173_04-1699248869.webp?v=1740437474","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758322950411,"title":"Lustra LED cu telecomanda DAIKI 69W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-daiki-69w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:237\"\u003eLustra LED cu telecomandă DAIKI este o piesă de iluminat modernă și funcțională, cu un design geometric format din 4 pătrate elegante, finisate în negru. Cu o putere de 69W, oferă o iluminare eficientă și versatilă pentru diverse spații.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:473\"\u003eCele patru pătrate, dispuse într-o manieră estetică, nu doar distribuie lumina uniform, ci creează și un impact vizual contemporan. Telecomanda inclusă îți permite să controlezi temperatura culorii luminii, alegând între lumină rece (pentru o atmosferă energizantă), caldă (pentru un ambient primitor și relaxant) sau neutră (pentru iluminare generală). Funcția de dimare îți oferă posibilitatea de a ajusta intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:242\"\u003eFinisajul negru al lustrei accentuează liniile clare ale designului pătrat și adaugă o notă de eleganță și modernitate încăperii. Această combinație de formă geometrică și culoare neutră o face ușor de integrat în diverse stiluri de interior.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:16:37+02:00","created_at":"2025-02-24T21:16:37+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52380985229579,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT177BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":9758322950411,"created_at":"2025-09-18T10:35:59+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51820987056395,"created_at":"2025-02-24T21:16:39+02:00","position":1,"updated_at":"2025-03-17T18:20:02+02:00","product_id":9758322950411,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-daiki-telecomanda-104w-24ghz-dimabila-acril-alb-negru_LL1579_01.webp?v=1742228402","width":1024,"height":1024},{"id":51820987089163,"created_at":"2025-02-24T21:16:39+02:00","position":2,"updated_at":"2025-03-17T18:20:18+02:00","product_id":9758322950411,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-daiki-telecomanda-104w-24ghz-dimabila-acril-alb-negru_LL1579_02.webp?v=1742228418","width":1024,"height":1024},{"id":63977164570891,"created_at":"2025-12-30T15:05:38+02:00","position":3,"updated_at":"2025-12-30T15:05:41+02:00","product_id":9758322950411,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT177BK_EPREL.png?v=1767099941","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10840690524427,"title":"Lustra LED suspendata cu telecomanda LIBRE, 42W, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-lt1130bk-42w-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cp data-start=\"0\" data-end=\"274\"\u003eLustra LED suspendată cu telecomandă LT1130BK este un corp de iluminat modern, cu design elegant și finisaj negru, conceput pentru interioare contemporane. Cu o putere de 42W, oferă o iluminare puternică și uniformă, ideală pentru livinguri, dininguri sau spații open-space.\u003c\/p\u003e\u003cp data-start=\"0\" data-end=\"274\"\u003e\u003cspan\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003cp data-start=\"276\" data-end=\"589\"\u003eFuncția dimabilă și telecomanda inclusă permit reglarea intensității și a temperaturii de culoare – lumină caldă, neutră sau rece – pentru adaptarea atmosferei în funcție de moment și necesități. Înălțimea reglabilă asigură flexibilitate la montaj, facilitând integrarea armonioasă în încăperi cu tavane diferite.\u003c\/p\u003e\u003cp data-start=\"276\" data-end=\"589\"\u003e\u003cspan\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003cp data-start=\"591\" data-end=\"743\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eLustra LT1130BK îmbină eficiența LED cu un design modern și control complet al luminii, fiind o soluție practică și estetică pentru iluminatul interior.\u003c\/p\u003e\u003cp\u003e\u003cspan\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-12-29T08:25:09+02:00","created_at":"2025-12-18T16:42:10+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52772504764683,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT1130BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"419.99","position":1,"product_id":10840690524427,"created_at":"2025-12-18T16:42:10+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63574267429131,"created_at":"2025-12-18T16:44:07+02:00","position":1,"updated_at":"2026-01-16T15:19:48+02:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_18_2025_04_43_59_PM.png?v=1768569588","width":1024,"height":1024},{"id":64445353492747,"created_at":"2026-01-16T15:18:54+02:00","position":2,"updated_at":"2026-01-16T15:19:48+02:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/61qIIJzgjXL._AC_SL1500.jpg?v=1768569588","width":1500,"height":1500},{"id":63574252388619,"created_at":"2025-12-18T16:42:51+02:00","position":3,"updated_at":"2026-01-16T15:19:48+02:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_4fbafaa9-12f8-4f41-a2dd-ffda486d45af.png?v=1768569588","width":750,"height":750},{"id":63574281552139,"created_at":"2025-12-18T16:44:56+02:00","position":4,"updated_at":"2026-01-16T15:19:48+02:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Haf94644433cb4db89f313545d4b7b3f9o.jpg?v=1768569588","width":648,"height":648},{"id":66215650722059,"created_at":"2026-02-22T17:34:04+02:00","position":5,"updated_at":"2026-02-22T17:34:07+02:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT1130BK.webp?v=1771774447","width":648,"height":648},{"id":68420488593675,"created_at":"2026-04-22T10:53:32+03:00","position":6,"updated_at":"2026-04-22T10:53:35+03:00","product_id":10840690524427,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697149_big_color.svg?v=1776844415","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760863453451,"title":"Lustra LED suspendata PAGANO 95W, Lumina Rece\/Calda\/Neutra, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-pagano-95w-3000-4000-6000k-49x49cm-negru-inaltime-reglabila","body_html":"\u003cp\u003eEleganță Modernă și Lumină Naturală: \u003cstrong\u003eLustra LED  PAGANO\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eÎmbracă-ți spațiul cu un design contemporan și o iluminare confortabilă cu lustra LED  \u003cstrong\u003ePAGANO\u003c\/strong\u003e. Cu dimensiunile sale 49cm, această lustră oferă o prezență echilibrată, potrivită pentru diverse încăperi, de la livinguri și dininguri la dormitoare sau birouri moderne.\u003c\/p\u003e\u003cp\u003eCu o putere de \u003cstrong\u003e95W\u003c\/strong\u003e, lustra LED  \u003cstrong\u003ePAGANO  \u003c\/strong\u003eemite \u003cstrong\u003etrei tipuri de lumină \u003c\/strong\u003eintegrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/p\u003e\u003cp\u003eDesignul lustrei  \u003cstrong\u003ePAGANO  \u003c\/strong\u003eeste probabil minimalist și elegant, folosind materiale moderne și linii curate. Dimensiunile specificate sugerează o formă compactă, dar cu o prezență vizuală distinctă. Materialele utilizate pot include metal, acril sau o combinație a acestora, în funcție de modelul exact.\u003c\/p\u003e\u003cp\u003eCaracteristici Cheie:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Modern și Compact:\u003c\/strong\u003e Dimensiuni de 49x49cm, potrivită pentru diverse spații.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 95W pentru o iluminare optimă.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eTemperatura Culoare Variabila:\u003c\/strong\u003e Lumina rece, caldă și neutră, adaptabilă nevoilor tale.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează ușor în interioare moderne, minimaliste sau scandinave.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eMateriale Moderne:\u003c\/strong\u003e Probabil metal, acril sau o combinație a acestora.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare Uniformă:\u003c\/strong\u003e Tehnologia LED asigură o distribuție plăcută a luminii.\u003cbr\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:41:40+02:00","cre