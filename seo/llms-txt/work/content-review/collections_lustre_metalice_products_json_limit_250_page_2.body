\"305\" data-end=\"629\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eFuncția dimabilă și telecomanda permit reglarea facilă a intensității și a temperaturii de culoare – lumină caldă, neutră sau rece – pentru adaptarea atmosferei în funcție de moment. Lustra AXIAL combină eficiența tehnologiei LED cu un design contemporan, fiind o soluție practică și estetică pentru iluminatul interior.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e \u003c\/p\u003e","published_at":"2025-12-29T08:27:16+02:00","created_at":"2025-12-18T16:46:16+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52772511285515,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT178\/8WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"439.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10840691704075,"created_at":"2025-12-18T16:46:16+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63575272849675,"created_at":"2025-12-18T16:58:27+02:00","position":1,"updated_at":"2025-12-18T17:00:20+02:00","product_id":1084