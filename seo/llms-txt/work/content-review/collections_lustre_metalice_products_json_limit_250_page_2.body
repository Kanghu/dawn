8411,"created_at":"2026-07-31T23:32:02+03:00","position":10,"updated_at":"2026-07-31T23:32:05+03:00","product_id":10721745535243,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/020_20_LLC150-500GD.webp?v=1785529925","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759398134027,"title":"Plafoniera LED Fantas 46W, Rotunda, Abs, Alb si Negru","handle":"plafoniera-led-fantas-46w-rotunda-abs-alb-si-negru","body_html":"\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-family: Poppins, sans-serif; font-size: 14.000001px; text-align: center;\"\u003e\n\u003cspan style=\"font-size:16px\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"box-sizing: inherit; position: relative; width: 1196.005493px; padding-right: 10px; padding-left: 10px; caret-color: rgb(102, 102, 102); color: rgb(102, 102, 102); font-family: Poppins, sans-serif; font-size: 14.000001px;\"\u003e\u003cspan style=\"font-size:16px\"\u003ePlafoniera Alessandro Design incorporează atât tehnologia modernă cât și eleganța într-un produs unic, menit să-i confere casei tale un aspect vibrant si plăcut estetic. Realizată din materiale de calitate păstrând înălțimea redusă și designul simplu această plafonieră reprezintă cea mai bună variantă de iluminare pentru spațiile cu tavane joase. \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T23:42:53+02:00","created_at":"2025-02-24T23:42:53+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Plafoniere LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Plafoniere LED"],"variants":[{"id":52408571986187,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2101\/46W","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"219.99","grams":0,"compare_at_price":"219.99","position":1,"product_id":9759398134027,"created_at":"2025-09-24T14:13:02+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":57561249612043,"created_at":"2025-07-23T02:49:27+03:00","position":1,"updated_at":"2025-07-23T02:49:38+03:00","product_id":9759398134027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/A1_b7d8ec62-be82-433c-bf32-a3e92986c8ef.png?v=1753228178","width":2000,"height":2000},{"id":51832463229195,"created_at":"2025-02-24T23:42:56+02:00","position":2,"updated_at":"2025-07-23T02:49:38+03:00","product_id":9759398134027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-isolda-92w-plastic-alb-negru_AT1CT-CH1A-HT2L-2101-92W_04.webp?v=1753228178","width":900,"height":900},{"id":51832463163659,"created_at":"2025-02-24T23:42:55+02:00","position":3,"updated_at":"2025-07-23T02:49:38+03:00","product_id":9759398134027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-isolda-92w-plastic-alb-negru_AT1CT-CH1A-HT2L-2101-92W_01.webp?v=1753228178","width":900,"height":900},{"id":51832463098123,"created_at":"2025-02-24T23:42:55+02:00","position":4,"updated_at":"2025-07-23T02:49:38+03:00","product_id":9759398134027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-isolda-92w-plastic-alb-negru_AT1CT-CH1A-HT2L-2101-92W_02.webp?v=1753228178","width":900,"height":900},{"id":51832463130891,"created_at":"2025-02-24T23:42:55+02:00","position":5,"updated_at":"2025-07-23T02:49:38+03:00","product_id":9759398134027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/plafoniera-led-isolda-92w-plastic-alb-negru_AT1CT-CH1A-HT2L-2101-92W_03.webp?v=1753228178","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779347915019,"title":"Lustra LED Alejandro cu Telecomanda, 71W, 4 Flori, Lumina Dimabila Rece\/Calda\/Neutra, Crom","handle":"lustra-led-alejandro-cu-telecomanda-71w-4-flori-lumina-dimabila-rece-calda-neutra-crom","body_html":"\u003c!-- codex-banner:AT1CT-IM1P-HT2L-LT071\/4CH --\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_2000x900_LT071-4CH.jpg?v=1785530072\" alt=\"Lustra LED Alejandro cu Telecomanda, 71W, 4 Flori, Lumina Dimabila Rece\/Calda\/Neutra, Crom banner\" width=\"2000\" height=\"900\"\u003e\u003c\/p\u003e\u003c!-- \/codex-banner:AT1CT-IM1P-HT2L-LT071\/4CH --\u003e\u003cp\u003eLustra Alejandro are un design decorativ cu forma \u003cstrong data-end=\"150\" data-start=\"139\"\u003eflorala\u003c\/strong\u003e si finisaj \u003cstrong data-end=\"177\" data-start=\"162\"\u003ecrom lucios\u003c\/strong\u003e, potrivit pentru incaperi moderne. Echipata cu \u003cstrong data-end=\"238\" data-start=\"225\"\u003ebanda LED\u003c\/strong\u003e si \u003cstrong data-end=\"257\" data-start=\"242\"\u003etelecomanda\u003c\/strong\u003e, permite reglarea temperaturii de culoare intre \u003cstrong data-end=\"315\" data-start=\"306\"\u003e3000K\u003c\/strong\u003e si \u003cstrong data-end=\"328\" data-start=\"319\"\u003e6000K\u003c\/strong\u003e, inclusiv mod \u003cstrong data-end=\"350\" data-start=\"343\"\u003eRGB\u003c\/strong\u003e. Ofera un flux luminos de \u003cstrong data-end=\"392\" data-start=\"377\"\u003e5680 lumeni\u003c\/strong\u003e si are o durata de viata de pana la \u003cstrong data-end=\"443\" data-start=\"429\"\u003e25.000 ore\u003c\/strong\u003e. Se monteaza pe \u003cstrong data-end=\"469\" data-start=\"460\"\u003etavan\u003c\/strong\u003e, functioneaza la \u003cstrong data-end=\"499\" data-start=\"487\"\u003e220–230V\u003c\/strong\u003e si are o putere de \u003cstrong data-end=\"526\" data-start=\"519\"\u003e71W\u003c\/strong\u003e, fiind recomandata pentru \u003cstrong data-end=\"565\" data-start=\"553\"\u003edormitor\u003c\/strong\u003e sau \u003cstrong data-end=\"580\" data-start=\"570\"\u003eliving\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-16T14:19:46+03:00","created_at":"2025-03-06T18:45:22+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52423836467467,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT071\/4CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"259.79","grams":0,"compare_at_price":"299.99","position":1,"product_id":9779347915019,"created_at":"2025-09-29T11:38:01+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69858436546827,"created_at":"2026-07-31T23:34:26+03:00","position":1,"updated_at":"2026-07-31T23:34:29+03:00","product_id":9779347915019,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT071-4CH.webp?v=1785530069","width":1254,"height":1254},{"id":69858436382987,"created_at":"2026-07-31T23:34:26+03:00","position":2,"updated_at":"2026-07-31T23:34:29+03:00","pro