739\/files\/ChatGPT_Image_Jan_19_2026_02_35_01_PM.png?v=1768826359","width":1024,"height":1024},{"id":64506794049803,"created_at":"2026-01-19T14:37:50+02:00","position":6,"updated_at":"2026-01-19T14:39:19+02:00","product_id":10851764371723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/518396009_1122740643210546_3530623098855287374_n.jpg?v=1768826359","width":1284,"height":1216},{"id":64506794017035,"created_at":"2026-01-19T14:37:50+02:00","position":7,"updated_at":"2026-01-19T14:39:19+02:00","product_id":10851764371723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/518214210_1122740833210527_594878649990597655_n.jpg?v=1768826359","width":1284,"height":1190}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10851865198859,"title":"Lustra LED Suspendata, STRATUS Supremo, Cristal si Metal, 15W, Lumina Rece\/Calda\/Neutra 3000K\/4000K\/6000K, Iluminat Luxos","handle":"lustra-led-suspendata-stratus-supremo-cristal-si-metal-15w-lumina-rece-calda-neutra-3000k-4000k-6000k-iluminat-luxos","body_html":"\u003cp data-end=\"336\" data-start=\"0\"\u003eLustra LED suspendată \u003cstrong data-end=\"38\" data-start=\"22\"\u003eSTRATUS Supremo\u003c\/strong\u003e este un corp de iluminat elegant, realizat din \u003cstrong data-end=\"106\" data-start=\"86\"\u003emetal și cristal\u003c\/strong\u003e, conceput pentru interioare moderne cu accente luxoase. Cu o putere de \u003cstrong\u003e15W\u003c\/strong\u003e, oferă o iluminare uniformă și eficientă, potrivită pentru living, dining sau spații open-space.\u003c\/p\u003e\u003cp data-end=\"336\" data-start=\"0\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"660\" data-start=\"338\"\u003eDesignul alungit, cu elemente din cristal, creează reflexii spectaculoase și un efect vizual premium.\u003c\/p\u003e\u003cp data-end=\"660\" data-start=\"338\"\u003e\u003cstrong data-end=\"409\" data-start=\"386\"\u003eÎnălțimea reglabilă\u003c\/strong\u003e permite adaptarea la diferite tipuri de tavane, iar posibilitatea selectării temperaturii de culoare – \u003cstrong data-end=\"546\" data-start=\"513\"\u003elumină caldă, neutră sau rece\u003c\/strong\u003e – asigură control asupra atmosferei. Modelul CC370\/1200CH combină estetica luxoasă cu funcționalitatea modernă.\u003c\/p\u003e\u003cp data-end=\"660\" data-start=\"338\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"999\" data-start=\"662\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1130\" data-start=\"1001\"\u003eO alegere ideală pentru cei care caută iluminat luxos, tehnologie modernă și control complet al atmosferei într-un singur produs.\u003c\/p\u003e","published_at":"2026-01-09T06:42:13+02:00","created_at":"2026-01-06T17:16:11+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Candelabre Cristal","tags":["active","All Stock","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52808390410507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CC370\/1200CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"1399.99","grams":0,"compare_at_price":"1399.99","position":1,"product_id":10851865198859,"created_at":"2026-01-06T17:16:12+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":64162926035211,"created_at":"2026-01-06T17:17:17+02:00","position":1,"updated_a