l interior.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e \u003c\/p\u003e","published_at":"2025-12-29T08:29:36+02:00","created_at":"2025-12-18T17:12:46+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52772589764875,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT183\/6WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"419.99","grams":0,"compare_at_price":"479.99","position":1,"product_id":10840732303627,"created_at":"2025-12-18T17:12:47+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63576299110667,"created_at":"2025-12-18T17:14:25+02:00","position":1,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_18_2025_05_14_16_PM.png?v=1766070952","width":1024,"height":1024},{"id":63576298291467,"created_at":"2025-12-18T17:14:19+02:00","position":2,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_a86fda26-3a2c-4e78-9df6-50cd1f9a876a.png?v=1766070952","width":2500,"height":2500},{"id":63576288395531,"created_at":"2025-12-18T17:13:23+02:00","position":3,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_99883504-5a7e-4fff-9be4-91f8c8d93671.jpg?v=1766070952","width":3000,"height":3500},{"id":63576298324235,"created_at":"2025-12-18T17:14:19+02:00","position":4,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_8cb89db2-e7d9-4d96-aee6-13b250123485.png?v=1766070952","width":2500,"height":2500},{"id":63576298258699,"created_at":"2025-12-18T17:14:19+02:00","position":5,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_1ee2a24f-590e-4546-ac50-f08df36651a0.png?v=1766070952","width":2500,"height":2500},{"id":63576298094859,"created_at":"2025-12-18T17:14:18+02:00","position":6,"updated_at":"2025-12-18T17:15:52+02:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_a5c47f45-edb5-439e-a536-dfdae9e272e8.png?v=1766070952","width":2500,"height":2500},{"id":68420848713995,"created_at":"2026-04-22T10:59:12+03:00","position":7,"updated_at":"2026-04-22T10:59:15+03:00","product_id":10840732303627,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697172_big_color.svg?v=1776844755","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10841048187147,"title":"Lustra LED suspendata cu telecomanda LT813\/4BK 139W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-lt813-4bk-41w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.     \u003cem\u003e \u003c\/em\u003e\u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-12-31T06:54:12+02:00","created_at":"2025-12-19T09:43:17+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52773183848715,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT813\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"559.99","grams":0,"compare_at_price":"559.99","position":1,"product_id":10841048187147,"created_at":"2025-12-19T09:43:18+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63609174130955,"created_at":"2025-12-19T09:44:05+02:00","position":1,"updated_at":"2025-12-19T12:04:42+02:00","product_id":10841048187147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_a8d9cfeb-7629-4416-b113-50160bf5f06d.png?v=1766138682","width":800,"height":800},{"id":60332350734603,"created_at":"2025-09-15T12:25:15+03:00","position":2,"updated_at":"2025-12-19T12:04:42+02:00","product_id":10841048187147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H7da374afdc5d4583aa478bbed1636165S_f5b01dd7-513d-4ff4-95f9-7001f82a4633.png?v=1766138682","width":662,"height":672},{"id":63609174098187,"created_at":"2025-12-19T09:44:05+02:00","position":3,"updated_at":"2025-12-19T12:04:42+02:00","product_id":10841048187147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_2_5327cb52-43f7-4557-83d3-f047a3c9478f.png?v=1766138682","width":800,"height":800},{"id":68426245472523,"created_at":"2026-04-22T15:17:16+03:00","position":4,"updated_at":"2026-04-22T15:17:19+03:00","product_id":10841048187147,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2699274_big_color.svg?v=1776860239","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10848509657355,"title":"Lustra LED suspendata cu Telecomanda LT327BK 90W, lumina Rece\/Calda\/Neutra, Dimabila,Inaltime Reglabila, Negru","handle":"lustra-led-suspendata-cu-telecomanda-lt327bk-90w-lumina-rece-calda-neutra-dimabila-inaltime-reglabila-negru","body_html":"\u003cp class=\"p1\"\u003eLustra LED MARISTELLA suspendata, cu \u003cspan class=\"s1\"\u003e\u003cb\u003etelecomanda\u003c\/b\u003e\u003c\/span\u003e si o putere de 90W, ofera un iluminat eficient si reglabil, potrivit pentru incaperi medii precum dining, bucatarie, living sau birou. Designul compact, pe structura neagra, se adapteaza usor in spatii cu mobilier sobru sau industrial.\u003c\/p\u003e\u003cp class=\"p1\"\u003ePoti comuta rapid intre cele 3 trepte de lumina (3000K, 4000K, 6000K) si regla intensitatea in functie de moment. Functioneaza atat din \u003cspan class=\"s1\"\u003e\u003cb\u003etelecomanda lustrei\u003c\/b\u003e\u003c\/span\u003e, cat si cu intrerupatorul clasic.\u003c\/p\u003e\u003cp class=\"p1\"\u003eEste o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED dimabila cu telecomanda si 3 functii\u003c\/b\u003e\u003c\/span\u003e, cu inaltime ajustabila pentru flexibilitate la montaj. Tehnologia LED integrata garanteaza un consum redus si o durata de viata extinsa de pana la 25.000 ore.\u003c\/p\u003e\u003cp class=\"p1\"\u003ePerfecta ca \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru bucatarie\u003c\/b\u003e\u003c\/span\u003e, dar si in zona de dining sau intr-un birou discret.\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2026-01-09T11:29:27+02:00","created_at":"2025-12-31T10:20:16+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52798211981579,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT327BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"479.97","grams":0,"compare_at_price":"539.99","position":1,"product_id":10848509657355,"created_at":"2025-12-31T10:20:17+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":64106494394635,"created_at":"2026-01-04T16:15:14+02:00","position":1,"updated_at":"2026-01-04T16:15:19+02:00","product_id":10848509657355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2026-01-04at22.15.00.png?v=1767536119","width":1348,"height":1318}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10851720495371,"title":"Lustra LED cu Telecomanda LT176\/5GD, 69W, 5 Elemente, Lumina Rece\/Clada\/Neutra 3000K\/4000K\/6000K, Dimabila, Auriu, Inaltime Reglabila,  Metal si Acril","handle":"lustra-led-cu-telecomanda-lt176-5bk-69w-5-elemente-lumina-rece-clada-neutra-dimabila-auriu-inaltime-reglabila","body_html":"\u003cp\u003e\u003cstrong\u003eLustră LED cu telecomandă LT176\/5GD, 69W, 5 elemente, dimabilă, 3000K \/ 4000K \/ 6000K, auriu, înălțime reglabilă, metal și acril\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eLustra LED LT176\/5GD este un corp de iluminat modern, cu design elegant compus din 5 elemente decorative, potrivit pentru interioare contemporane și spații bine definite. Structura din metal cu finisaj auriu este completată de elemente din acril, oferind un aspect rafinat și o distribuție uniformă a luminii.\u003c\/p\u003e\u003cp\u003eIluminarea LED integrată de 69W este dimabilă și permite selectarea temperaturii de culoare rece, neutră sau caldă (3000K \/ 4000K \/ 6000K), adaptând atmosfera în funcție de preferințe și momentul zilei. Controlul prin telecomandă asigură reglaj rapid și utilizare comodă.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp\u003eSistemul de suspendare cu înălțime reglabilă permite ajustarea în funcție de tavan și configurația spațiului. Consum redus de energie, lumină eficientă și materiale de calitate, pentru o lustră durabilă, modernă și estetică.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e și telecomanda permit reglarea intensității și a temperaturii de culoare – \u003cstrong\u003elumină caldă, neutră sau rece\u003c\/strong\u003e – pentru adaptarea rapidă a atmosferei.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eÎnălțimea reglabilă\u003c\/strong\u003e oferă flexibilitate la montaj, iar combinația dintre tonurile aurii și liniile moderne conferă un aspect elegant și sofisticat.\u003c\/p\u003e","published_at":"2026-01-09T11:23:53+02:00","created_at":"2026-01-06T11:17:02+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu T