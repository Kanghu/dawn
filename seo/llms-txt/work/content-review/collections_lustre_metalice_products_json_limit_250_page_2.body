28492601611,"created_at":"2025-11-20T16:28:12+02:00","position":7,"updated_at":"2025-11-20T16:28:15+02:00","product_id":10223804907787,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT362_60X40GD_EPREL_aa56bdbe-bffe-476e-a605-74cb98ec4e49.png?v=1763648895","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757610311947,"title":"Lustra LED cu telecomanda LUCY 69W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lucy-69-7w-4-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"b3a9d147775384c5\"\u003e\n\u003cdiv class=\"user-query-container user-query-bubble-container ng-star-inserted\"\u003e\u003cdiv class=\"query-content ng-star-inserted\" id=\"user-query-content-0\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c3142596195-13 response-container-with-gpi is-mobile tts-removed ng-star-inserted\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3142596195-13\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3142596195-13 is-mobile\"\u003e\u003cdiv class=\"response-content ng-tns-c3142596195-13\"\u003e\u003cdiv class=\"markdown markdown-main-panel is-mobile enable-updated-hr-color\" id=\"model-response-message-contentr_b3a9d147775384c5\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"1:1-1:175\"\u003eLustra LED ROCKET, cu o putere de 69W și un diametru de 60 cm, oferă o iluminare versatilă, având opțiuni pentru lumină rece, caldă sau neutră, și vine într-o culoare albă.\u003c\/p\u003e\n\u003cul data-sourcepos=\"5:1-10:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:168\"\u003eAre un \u003cstrong\u003edesign inovator\u003c\/strong\u003e inspirat de forma unei rachete, fiind potrivită pentru camere de copii, birouri moderne sau spații care necesită un punct focal interesant.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:114\"\u003eOferă o \u003cstrong\u003eiluminare eficientă\u003c\/strong\u003e datorită tehnologiei LED, cunoscută pentru durabilitatea și economia de energie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:90\"\u003eAre un \u003cstrong\u003efinisaj alb elegant\u003c\/strong\u003e, integrându-se ușor în diverse stiluri de decor interior.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:54\"\u003eEste realizată din \u003cstrong\u003emateriale de înaltă calitate\u003c\/strong\u003e.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-10:0\"\u003eVine cu toate componentele necesare pentru o \u003cstrong\u003emontare ușoară\u003c\/strong\u003e.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003c\/div\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"eb8fad1471784337\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c3142596195-18 response-container-with-gpi is-mobile tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3142596195-18\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3142596195-18 is-mobile\"\u003e\u003cdiv class=\"response-content ng-tns-c3142596195-18\"\u003e\u003cdiv class=\"markdown markdown-main-panel is-mobile enable-updated-hr-color\" id=\"model-response-message-contentr_eb8fad1471784337\" dir=\"ltr\"\u003e\u003cul data-sourcepos=\"5:1-12:0\"\u003e\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\n\u003c\/li\u003e\u003c\/ul\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-02-24T17:15:31+02:00","created_at":"2025-02-24T17:15:30+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52422682542347,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT818\/4WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.79","grams":0,"compare_at_price":"159.99","position":1,"product_id":9757610311947,"created_at":"2025-09-28T21:43:39+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51816757559563,"created_at":"2025-02-24T17:15:33+02:00","position":1,"updated_at":"2025-02-24T17:15:35+02:00","product_id":9757610311947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-karl-118w-dimabila-alb-1716382177.webp?v=1740410135","width":900,"height":900},{"id":51816757657867,"created_at":"2025-02-24T17:15:33+02:00","position":2,"updated_at":"2025-02-24T17:15:35+02:00","product_id":9757610311947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-telecomanda-182w-dimabila-alb-acril_8888-4_03.webp?v=1740410135","width":900,"height":900},{"id":51816757592331,"created_at":"2025-02-24T17:15:33+02:00","position":3,"updated_at":"2025-02-24T17:15:35+02:00","product_id":9757610311947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-telecomanda-182w-dimabila-alb-acril_8888-4_04.webp?v=1740410135","width":900,"height":900},{"id":51816757625099,"created_at":"2025-02-24T17:15:33+02:00","position":4,"updated_at":"2025-02-24T17:15:35+02:00","product_id":9757610311947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-telecomanda-182w-dimabila-alb-acril_8888-4_05.webp?v=1740410135","width":900,"height":900},{"id":68422873678091,"created_at":"2026-04-22T12:10:53+03:00","position":5,"updated_at":"2026-04-22T12:10:56+03:00","product_id":9757610311947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697390_big_color.svg?v=1776849056","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10514848448779,"title":"Lustra LED  Harman, 23W, 6 Surse, Lumina Neutra, Negru","handle":"lustra-led-harman-23w-6-surse-lumina-neutra-negru","body_html":"\u003cp\u003eLustra LED Hardman este prevazuta cu 6 surse si banda LED, avand un design liniar si un stil elegant. Functioneaza la o tensiune de 220–230V, are o putere totala de \u003cstrong data-start=\"254\" data-end=\"261\"\u003e23W\u003c\/strong\u003e si se monteaza pe tavan. Structura este realizata din \u003cstrong data-start=\"316\" data-end=\"325\"\u003emetal\u003c\/strong\u003e, finisaj \u003cstrong data-start=\"335\" data-end=\"344\"\u003enegru\u003c\/strong\u003e, cu o inaltime de \u003cstrong data-start=\"363\" data-end=\"372\"\u003e10 cm\u003c\/strong\u003e si o lungime de \u003cstrong data-start=\"389\" data-end=\"399\"\u003e120 cm\u003c\/strong\u003e. Este compatibila cu intrerupator \u003cstrong data-start=\"434\" data-end=\"459\"\u003eclasic\u003c\/strong\u003e,\u003c\/p\u003e\u003cp\u003eFunctioneaza cu \u003cstrong data-start=\"477\" data-end=\"494\"\u003elumina neutra\u003c\/strong\u003e si este recomandata pentru \u003cstrong data-start=\"522\" data-end=\"553\"\u003edormitor, living sau dining\u003c\/strong\u003e. Autonomia este de \u003cstrong data-start=\"573\" data-end=\"584\"\u003e25.000h\u003c\/strong\u003e, protectia este de tip \u003cstrong data-start=\"608\" data-end=\"616\"\u003eIP20\u003c\/strong\u003e, iar utilizarea este destinata interiorului.\u003c\/p\u003e","published_at":"2025-08-12T17:06:39+03:00","created_at":"2025-06-23T15:13:00+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52360120271115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT135\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":10514848448779,"created_at":"2025-09-12T14:15:30+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56699025359115,"created_at":"2025-06-23T16:01:04+03:00","position":1,"updated_at":"2025-06-23T16:01:25+03:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT1356BK-LustraLEDcutelecomandaHarman_23W_6Surse_LuminaNeutra_Negru-3.jpg?v=1750683685","width":1080,"height":1080},{"id":59038041833739,"created_at":"2025-08-12T17:05:43+03:00","position":2,"updated_at":"2025-08-12T17:07:32+03:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hff1b5665ebf44098a83de66eb706c282a.jpg?v=1755007652","width":800,"height":800},{"id":56699025293579,"created_at":"2025-06-23T16:01:04+03:00","position":3,"updated_at":"2025-08-12T17:07:32+03:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT1356BK-LustraLEDcutelecomandaHarman_23W_6Surse_LuminaNeutra_Negru-4.jpg?v=1755007652","width":1080,"height":1080},{"id":56699025391883,"created_at":"2025-06-23T16:01:03+03:00","position":4,"updated_at":"2025-08-12T17:06:34+03:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT1356BK-LustraLEDcutelecomandaHarman_23W_6Surse_LuminaNeutra_Negru-5.jpg?v=1755007594","width":1080,"height":1080},{"id":56699025424651,"created_at":"2025-06-23T16:01:03+03:00","position":5,"updated_at":"2025-08-12T17:06:34+03:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT1356BK-LustraLEDcutelecomandaHarman_23W_6Surse_LuminaNeutra_Negru-1.jpg?v=1755007594","width":1080,"height":1080},{"id":66224552837387,"created_at":"2026-02-22T20:05:36+02:00","position":6,"updated_at":"2026-02-22T20:05:39+02:00","product_id":10514848448779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT135_6BK.webp?v=1771783539","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10851387638027,"title":"Proiector Liniar Joom, 4XGU10, Metal, Negru, Becuri Neincluse","handle":"lustra-clasica-moderna-joom-cu-proiector-liniar-4xgu10-metal-negru-becuri-neincluse","body_html":"\u003cp\u003eLustra clasică modernă \u003cstrong\u003eJOOM \u003c\/strong\u003ecu proiector liniar este o soluție de iluminat funcțională, cu design contemporan și linii curate. Structura realizată integral din metal, cu finisaj negru, oferă un aspect modern și ușor industrial, potrivit pentru interioare actuale.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003eEchipată cu 4 surse de iluminare tip GU10, lustra permite direcționarea precisă a luminii, fiind ideală pentru iluminat general sau de accent în livinguri, bucătării, holuri sau spații de lucru. Proiectorul liniar asigură o distribuție eficientă și controlată a luminii.\u003c\/p\u003e\u003cp\u003eConstrucția solidă, designul minimalist și versatilitatea în utilizare fac din această lustră o alegere practică și estetică pentru iluminatul interior modern.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-gu10.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e \u003c\/p\u003e","published_at":"2026-01-09T10:27:10+02:00","created_at":"2026-01-05T15:35:16+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu bec","Lustre cu bec moderne","Plafoniere LED"],"variants":[{"id":52806543180043,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC500\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10851387638027,"created_at":"2026-01-05T15:35:17+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":64131113582859,"created_at":"2026-01-05T15:35:57+02:00","position":1,"updated_at":"2026-01-05T15:36:01+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_221212c4-320f-4dd1-a1ef-1079bd466549.png?v=1767620161","width":800,"height":800},{"id":64411157135627,"created_at":"2026-01-15T16:28:07+02:00","position":2,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/61ITOCFbuKL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1500},{"id":64131150446859,"created_at":"2026-01-05T15:42:25+02:00","position":3,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Jan_5_2026_03_42_17_PM.png?v=1768487307","width":1024,"height":1024},{"id":64411156939019,"created_at":"2026-01-15T16:28:07+02:00","position":4,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/61JfCDmDkEL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1500},{"id":64411157004555,"created_at":"2026-01-15T16:28:07+02:00","position":5,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71TV3x_BTSL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1500},{"id":64411157070091,"created_at":"2026-01-15T16:28:07+02:00","position":6,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71UyioldOUL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1500},{"id":64411156971787,"created_at":"2026-01-15T16:28:07+02:00","position":7,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/618SlcjOHqL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1476},{"id":64411157037323,"created_at":"2026-01-15T16:28:07+02:00","position":8,"updated_at":"2026-01-15T16:28:27+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71zuw2FWwCL._AC_SL1500.jpg?v=1768487307","width":1500,"height":1461},{"id":66173177790731,"created_at":"2026-02-21T23:46:53+02:00","position":9,"updated_at":"2026-02-21T23:46:55+02:00","product_id":10851387638027,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LC500_4BK.webp?v=1771710415","width":800,"height":800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10223429157131,"title":"Lustra LED suspendata cu Telecomanda RIMINI 52W, 3 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Auriu","handle":"lustra-led-suspendata-cu-telecomanda-rimini-52w-3-elemente-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp class=\"p1\"\u003e\u003cb\u003eLustra LED cu telecomanda Rimini – Iluminat versatil pentru orice incapere\u003c\/b\u003e\u003cb\u003e\u003c\/b\u003e\u003c\/p\u003e\u003cp class=\"p3\"\u003eCu un design geometric bazat pe 3 cercuri LED, \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED cu telecomanda Rimini\u003c\/b\u003e\u003c\/span\u003e este potrivita pentru dormitor, living sau bucatarie. Cele trei surse circulare ofera o distributie uniforma a luminii si transforma orice incapere intr-un spatiu bine luminat si placut vizual.\u003c\/p\u003e\u003cp class=\"p3\"\u003eCu o putere de 52W si un flux luminos de 4160lumeni, asigura suficienta lumina pentru activitatile zilnice, fara a consuma excesiv. Poti comuta intre lumina \u003cspan class=\"s1\"\u003e\u003cb\u003erece, calda sau neutra (3000K, 4000K, 6000K)\u003c\/b\u003e\u003c\/span\u003e in functie de momentul zilei, folosind telecomanda inclusa sau intrerupatorul clasic.\u003c\/p\u003e\u003cp class=\"p3\"\u003eEste o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED dimabila cu telecomanda 3 functii\u003c\/b\u003e\u003c\/span\u003e, cu durata de viata estimata la 25.000 de ore, ideala pentru cei care cauta fiabilitate pe termen lung. Constructia din metal si acril, finisata in auriu, o face compatibila cu decoruri diverse, iar forma suspendata si rotunjita o recomanda si ca \u003cspan class=\"s1\"\u003e\u003cb\u003elustra cercuri LED\u003c\/b\u003e\u003c\/span\u003e.\u003c\/p\u003e\u003cp class=\"p3\"\u003eSe monteaza pe tavan si functioneaza cu \u003cspan class=\"s1\"\u003e\u003cb\u003ebanda LED\u003c\/b\u003e\u003c\/span\u003e, fiind potrivita pentru interior. O alegere practica pentru cei care doresc o \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru sufragerie\u003c\/b\u003e\u003c\/span\u003e, dar si pentru \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru bucatarie\u003c\/b\u003e\u003c\/span\u003e sau \u003cspan class=\"s1\"\u003e\u003cb\u003elustra LED pentru dormitor\u003c\/b\u003e\u003c\/span\u003e.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:170\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-06-06T11:47:08+03:00","created_at":"2025-06-06T11:13:26+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52412037923083,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT331\/3UGD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.97","grams":0,"compare_at_price":"299.99","position":1,"product_id":10223429157131,"created_at":"2025-09-25T15:52:43+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":60234970530059,"created_at":"2025-09-12T10:06:42+03:00","position":1,"updated_at":"2025-09-12T10:07:54+03:00","product_id":10223429157131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_044e802f-e109-40b5-a0a6-6f42384e1389.png?v=1757660874","width":2000,"height":2000},{"id":56190460723467,"created_at":"2025-06-06T11:37:49+03:00","position":2,"updated_at":"2025-09-12T10:07:54+03:00","product_id":10223429157131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT331_3UGD-LustraLEDsuspendatacutelecomandaRIMINI48W_3Elemente_luminaRece_Calda_Neutra_Dimabila_Auriu-1.webp?v=1757660874","width":1080,"height":1080},{"id":60234885595403,"created_at":"2025-09-12T10:02:49+03:00","position":3,"updated_at":"2025-09-12T10:16:43+03:00","product_id":10223429157131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_25746a77-8c5f-413b-8b77-0300c4912302.png?v=1757661403","width":2000,"height":2000},{"id":62528448561419,"created_at":"2025-11-20T16:23:28+02:00","position":4,"updated_at":"2025-11-20T16:23:31+02:00","product_id":10223429157131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT331_3UGD_EPREL_4766fe62-1a5f-4ae9-9366-d7fb9c362e12.png?v=1763648611","width":2048,"height":2048},{"id":66229090484491,"created_at":"2026-02-22T20:51:18+02:00","position":5,"updated_at":"2026-02-22T20:51:20+02:00","product_id":10223429157131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT331_3UGD.webp?v=1771786280","width":2000,"height":2000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10670924497163,"title":"Lustra LED suspendata cu telecomanda CASIANA 130W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-casiana-130w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cem\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.      \u003c\/em\u003e\u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-09-15T16:50:58+03:00","created_at":"2025-08-14T11:56:26+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52396972146955,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT803\/4BK","requires_shipping