ant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/10._Place_3_265ad96e-5b3c-4d9b-9fdf-61584d5d6240.jpg?v=1773100285","width":3999,"height":3999},{"id":67092425801995,"created_at":"2026-03-10T01:47:08+02:00","position":6,"updated_at":"2026-03-10T01:51:25+02:00","product_id":9757252157707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9._Place_2_68379304-355a-4883-bf1f-6ef48d057f8c.jpg?v=1773100285","width":3999,"height":3999},{"id":68844280414475,"created_at":"2026-05-12T11:14:33+03:00","position":7,"updated_at":"2026-05-12T11:14:39+03:00","product_id":9757252157707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3.Size_89dad5f2-e6e9-4d3d-8d96-c3c0bc70be34.png?v=1778573679","width":3999,"height":3999},{"id":67092426064139,"created_at":"2026-03-10T01:47:09+02:00","position":8,"updated_at":"2026-03-10T01:51:25+02:00","product_id":9757252157707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_4_d545b2fc-ff25-4ffd-beef-a6408465f2a1.jpg?v=1773100285","width":3999,"height":3999},{"id":67092426096907,"created_at":"2026-03-10T01:47:09+02:00","position":9,"updated_at":"2026-03-10T01:51:25+02:00","product_id":9757252157707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8._Place_1_f8de9e47-e98d-450f-a90f-4ba17df51bd9.jpg?v=1773100285","width":3999,"height":3999},{"id":69113330630923,"created_at":"2026-05-26T12:07:55+03:00","position":10,"updated_at":"2026-05-26T12:07:57+03:00","product_id":9757252157707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2470271_big_color.png?v=1779786477","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757714743563,"title":"Lustra LED cu telecomanda LUCY 45W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lucy-45w-3-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:209\"\u003eAceastă lustră LED cu telecomandă LUCY, de 45W și culoare albă, aduce un design modern și o iluminare versatilă în locuința ta. Cele 3 cercuri luminoase interconectate creează un aspect elegant și contemporan.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-14:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:88\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 52W, asigurând o iluminare eficientă și luminoasă pentru diverse încăperi.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:78\"\u003e\n\u003cstrong\u003eDesign modern:\u003c\/strong\u003e Trei cercuri albe interconectate pentru un aspect stilat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:116\"\u003e\n\u003cstrong\u003eTip de lumină reglabil:\u003c\/strong\u003e Poți alege între lumină rece, caldă sau neutră, adaptând atmosfera preferințelor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:122\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii este reglabilă cu ajutorul telecomenzii incluse, permițând crearea ambientului dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:230\"\u003e\n\u003cstrong\u003eControl prin telecomandă:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea luminii de la distanță. Lustra poate fi controlată și prin intermediul întrerupătorului clasic (schimbarea modului de iluminare prin apăsări succesive).\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:97\"\u003e\n\u003cstrong\u003eFlux luminos optim:\u003c\/strong\u003e Oferă o cantitate adecvată de lumină pentru a ilumina eficient spațiul.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:83\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:83\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție solidă pentru o utilizare de lungă durată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-14:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu instrucțiuni clare pentru o montare simplă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"15:1-15:224\"\u003eAceastă lustră LED LUCY este o alegere excelentă pentru cei care caută un corp de iluminat modern, funcțional și cu posibilitatea de a personaliza iluminatul în funcție de necesități, adăugând un plus de stil locuinței tale.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:209\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T17:52:47+02:00","created_at":"2025-02-24T17:52:46+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52415017484555,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT818\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"169.99","grams":0,"compare_at_price":"169.99","position":1,"product_id":9757714743563,"created_at":"2025-09-26T14:56:00+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68987578417419,"created_at":"2026-05-20T14:43:14+03:00","position":1,"updated_at":"2026-05-20T14:45:18+03:00","product_id":9757714743563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-98w-dimabila_LL1848AL_03_53d7a4e7-f96e-47ce-aa75-b1fbb613f898.webp?v=1779277518","width":1024,"height":1024},{"id":68987526349067,"created_at":"2026-05-20T14:32:54+03:00","position":2,"updated_at":"2026-05-20T14:34:24+03:00","product_id":9757714743563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-98w-dimabila_LL1848AL_03_c41bf847-c9af-4c48-ac5b-9eb031b2a6db.webp?v=1779276864","width":1024,"height":1024},{"id":68987533820171,"created_at":"2026-05-20T14:34:38+03:00","position":3,"updated_at":"2026-05-20T14:39:57+03:00","product_id":9757714743563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-98w-dimabila_LL1848AL_03_da293710-d3f9-4788-a3f5-3435e20acd30.webp?v=1779277197","width":1024,"height":1024},{"id":51817374253323,"created_at":"2025-02-24T17:52:49+02:00","position":4,"updated_at":"2026-05-20T14:32:42+03:00","product_id":9757714743563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-tabita-98w-dimabila_LL1848AL_03.webp?v=1779276762","width":1024,"height":1024},{"id":62705033511179,"created_at":"2025-11-25T16:18:29+02:00","position":5,"updated_at":"2025-11-25T16:18:32+02:00","product_id":9757714743563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT818_3WH_EPREL.png?v=1764080312","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757505093899,"title":"Lustra LED NEXA Triunghi 3D 39W, Alb, Lumina Rece\/Calda\/Neutra","handle":"lustra-led-nexa-3d-39w-diametru-26cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-start=\"137\" data-end=\"474\"\u003e\u003cstrong data-start=\"137\" data-end=\"174\"\u003eLustra LED NEXA Triunghi 3D (40W)\u003c\/strong\u003e combină tehnologia LED de ultimă generație cu un design geometric spectaculos, oferind o piesă de iluminat care impresionează atât prin estetică, cât și prin eficiență. Forma sa tridimensională, bazată pe un triunghi modern, creează un efect vizual captivant, perfect pentru interioare contemporane.\u003c\/p\u003e\u003cp data-start=\"137\" data-end=\"474\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003cp data-start=\"476\" data-end=\"808\"\u003eTehnologia LED integrată garantează o \u003cstrong data-start=\"514\" data-end=\"545\"\u003edurată de viață îndelungată\u003c\/strong\u003e și un consum redus de energie, eliminând nevoia înlocuirii frecvente a becurilor și contribuind la un consum responsabil pe termen lung. Cu o putere de \u003cstrong\u003e40W\u003c\/strong\u003e, lustra oferă o iluminare eficientă, potrivită pentru dormitoare, livinguri, holuri sau zone de lucru.\u003c\/p\u003e\u003cp data-start=\"476\" data-end=\"808\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/span\u003e\u003c\/p\u003e\u003cp data-start=\"810\" data-end=\"1126\"\u003eNEXA Triunghi permite selectarea a \u003cstrong data-start=\"845\" data-end=\"876\"\u003etrei temperaturi de culoare\u003c\/strong\u003e – lumină caldă, neutră sau rece – oferind flexibilitate totală în funcție de activitate sau atmosfera dorită. Finisajul alb, minimalist, o face extrem de ușor de integrat în orice tip de decor, de la modern la scandinav sau chiar minimalist-elegant.\u003c\/p\u003e\u003cp data-start=\"810\" data-end=\"1126\"\u003e\u003ciframe loading=\"lazy\" title=\"Video montaj Lustra LED Marta\" style=\"width: 100%; height: 315px; border: 0;\" src=\"https:\/\/www.youtube.com\/embed\/fGal1DLblx8\"\u003e\u003c\/iframe\u003e\u003c\/p\u003e\u003cp data-start=\"1128\" data-end=\"1314\"\u003eRezultatul este o sursă de lumină versatilă, eficientă și cu impact vizual puternic: o alegere ideală pentru cei care apreciază designul contemporan și soluțiile de iluminat inteligente.\u003c\/p\u003e\u003cp data-start=\"1128\" data-end=\"1314\"\u003e\u003ciframe loading=\"lazy\" title=\"Video demonstratie Lustra LED Marta\" style=\"width: 100%; height: 315px; border: 0;\" src=\"https:\/\/www.youtube.com\/embed\/kW8C9jDIvqU\"\u003e\u003c\/iframe\u003e\u003c\/p\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003c\/div\u003e\u003cstyle\u003e@import url('https:\/\/fonts.googleapis.com\/css2?family=Roboto:wght@400;700\u0026display=swap');body {font-family: 'Roboto', sans-serif;}.containerimg-mobile,.containerimg {text-align: center;margin-left: auto;margin-right: auto;}.img2 {width: 100%;}p.paragraf-descrieri {font-size: 135%;text-align: justify;width: 80%;margin-left: auto;margin-right: auto;}.iframe-container {width: 60%;margin: 0 auto;text-align: center;}\u003c\/style\u003e","published_at":"2025-02-24T16:36:13+02:00","created_at":"2025-02-24T16:36:13+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52383093391627,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL433\/3D","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9757505093899,"created_at":"2025-09-18T21:07:23+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70029800571147,"created_at":"2026-09-03T09:39:09+03:00