opify.com\/s\/files\/1\/0782\/5175\/3739\/files\/d48677f1-f5a0-4f95-b9ca-7f6c6359aadc.webp?v=1778760168","width":1024,"height":1024},{"id":68895347212555,"created_at":"2026-05-14T15:08:43+03:00","position":8,"updated_at":"2026-09-07T11:10:36+03:00","product_id":9760414761227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_BETTY_127W_8_Cercuri_lumina_Rece_Calda_Neutra_Dimabila_Negru_4.png?v=1788768636","width":1254,"height":1254},{"id":68162841575691,"created_at":"2026-04-09T16:22:08+03:00","position":9,"updated_at":"2026-04-09T16:22:10+03:00","product_id":9760414761227,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT800-8BK.png?v=1775740930","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759485427979,"title":"Lustra LED cu telecomanda BETTY 27W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-betty-27w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-end=\"507\" data-start=\"137\"\u003e\u003cstrong data-end=\"178\" data-start=\"137\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_37d25d57-c8b7-4a45-8de7-f3c5485d37af.png?v=1778235999\" alt=\"\"\u003eLustra LED cu telecomandă BETTY (27W)\u003c\/strong\u003e este un corp de iluminat modern, elegant și perfect pentru spațiile în care vrei o lumină versatilă și un accent decorativ discret. Designul său este format din \u003cstrong data-end=\"368\" data-start=\"340\"\u003edouă cercuri concentrice\u003c\/strong\u003e finisate în negru mat, creând un efect vizual rafinat și contemporan, ușor de integrat în interioare moderne, minimaliste sau industriale.\u003c\/p\u003e\u003cp data-end=\"829\" data-start=\"509\"\u003eCu o putere de \u003cstrong data-end=\"531\" data-start=\"524\"\u003e27W\u003c\/strong\u003e, BETTY oferă o iluminare eficientă pentru \u003cstrong data-end=\"613\" data-start=\"574\"\u003elivinguri mici, dormitoare, birouri\u003c\/strong\u003e sau alte camere de dimensiuni medii. LED-urile integrate permit selectarea temperaturii de culoare — \u003cstrong data-end=\"741\" data-start=\"715\"\u003ecaldă, neutră sau rece\u003c\/strong\u003e — astfel încât poți adapta lumina în funcție de momentul zilei sau de atmosfera dorită.\u003c\/p\u003e\u003cp data-end=\"1062\" data-start=\"831\"\u003eTelecomanda inclusă oferă control complet asupra iluminării: schimbarea culorii luminii și ajustarea intensității prin funcția \u003cstrong data-end=\"970\" data-start=\"958\"\u003edimmable\u003c\/strong\u003e, pentru a crea rapid un ambient relaxant, energizant sau perfect pentru activități zilnice.\u003c\/p\u003e\u003cp data-end=\"1316\" data-start=\"1064\"\u003eFinisajul negru scoate în evidență formele geometrice elegante ale lustrei și adaugă un plus de profunzime vizuală în încăpere. Compactă, eficientă și modernă, \u003cstrong data-end=\"1233\" data-start=\"1224\"\u003eBETTY\u003c\/strong\u003e este o soluție excelentă pentru iluminat interior cu stil și flexibilitate maximă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:240\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:55:15+02:00","created_at":"2025-02-24T23:55:14+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52414209622283,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9759485