ra_LED_RADIAN_Nobile_43W_Diametru_39.5_cm_Lumina_Calda_Neutra_Rece_Alb_6.png?v=1784620314","width":1254,"height":1254},{"id":69804919423243,"created_at":"2026-07-21T10:50:34+03:00","position":7,"updated_at":"2026-07-21T10:52:02+03:00","product_id":10945744666891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_RADIAN_Nobile_43W_Diametru_39.5_cm_Lumina_Calda_Neutra_Rece_Alb_7.png?v=1784620322","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10945770946827,"title":"Lustra LED KOSMO cu telecomanda 115W, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-115w-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"05eff12602d2cf0a\"\u003e\u003cdiv class=\"response-container ng-tns-c1310598610-31 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"response-content ng-tns-c1310598610-31\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_05eff12602d2cf0a\" dir=\"ltr\"\u003e\n\u003cp\u003e\u003cstrong\u003eLustra LED KOSMO\u003c\/strong\u003e cu telecomanda 115W, iti ofera control complet asupra luminii din casa. Design geometric cu patru patrate, finisaj alb mat, materiale solide: metal si acril. Ai trei tipuri de lumina (rece, calda, neutra), toate reglabile din telecomanda – ajustezi intensitatea si temperatura de culoare cum vrei. Se poate schimba tipul de lumina si din intrerupatorul clasic, prin apasari succesive.\u003c\/p\u003e\n\u003cp\u003eFlux luminos puternic, 9200lm, suficient pentru camere mari. Consum redus, durata de viata 25.000 ore. \u003c\/p\u003e\n\u003cp data-sourcepos=\"16:1-16:188\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2026-05-03T23:13:57+03:00","created_at":"2026-04-24T14:47:55+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":53072342548747,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT5001\/500BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"599.99","grams":0,"compare_at_price":"599.99","position":1,"product_id":10945770946827,"created_at":"2026-04-24T14:47:56+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68584257814795,"created_at":"2026-04-29T14:36:48+03:00","position":1,"updated_at":"2026-04-29T14:38:20+03:00","product_id":10945770946827,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage24apr.2026_14_50_16_022eaf78-5ad9-4755-b0d6-7340c1ec8dd0.png?v=1777462700","width":1024,"height":1024},{"id":68495477375243,"creat