\/ChatGPT_Image_Jan_16_2026_04_15_35_PM.png?v=1768574354","width":1024,"height":1024},{"id":51817865347339,"created_at":"2025-02-24T18:16:20+02:00","position":7,"updated_at":"2026-01-16T16:39:14+02:00","product_id":9757775528203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cetus-telecomanda-120w-auriu-acril-dimabila_1724_03.webp?v=1768574354","width":900,"height":900},{"id":62529278640395,"created_at":"2025-11-20T18:24:53+02:00","position":8,"updated_at":"2026-01-16T16:39:14+02:00","product_id":9757775528203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2516738_big_color.png?v=1768574354","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760030654731,"title":"Lustra LED VERTEX Matrix Romburi Suprapuse, Rame Metalice, 48W, 2 Romburi, Lumina Rece\/Calda\/Neutra 3000K\/4000K\/6000K, Negru, Metal si Silicon","handle":"lustra-led-vertex-matrix-romburi-suprapuse-rame-metalice-24w-2-romburi-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-end=\"111\" data-start=\"0\"\u003eLustra LED VERTEX Matrix este un corp de iluminat modern, cu design geometric bazat pe romburi suprapuse și rame metalice, conceput pentru interioare contemporane cu accent pe linii clare și estetică minimalistă. Finisajul negru oferă un aspect elegant și arhitectural, potrivit pentru spații moderne.\u003c\/p\u003e\u003cp data-end=\"414\" data-start=\"113\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp data-end=\"414\" data-start=\"113\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_1_png.png?v=1769162634\"\u003e\u003c\/p\u003e\u003cp data-end=\"673\" data-start=\"416\"\u003eIluminarea LED integrată de 24W permite selectarea temperaturii de culoare caldă, neutră sau rece (3000K \/ 4000K \/ 6000K), adaptând lumina în funcție de ambient și utilizare. Distribuția luminii este uniformă, oferind confort vizual și eficiență energetică.\u003c\/p\u003e\u003cp data-end=\"673\" data-start=\"416\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"935\" data-start=\"675\"\u003eStructura realizată din metal și silicon asigură durabilitate și stabilitate, iar designul cu două romburi creează un efect decorativ distinct, ideal pentru livinguri, dormitoare, birouri sau zone de accent. O soluție de iluminat modernă, practică și estetică.\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"935\" data-start=\"675\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_final_3315e8d2-c0f3-4417-adeb-36a4457c80a8.png?v=1769163047\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T01:25:32+02:00","created_at":"2025-02-25T01:25:31+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Ciresar 25","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave","Summer_start"],"variants":[{"id":52417192722699,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL580BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"69.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":9760030654731,"created_at":"2025-09-27T05:59:03+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68117386658059,"created_at":"2026-04-07T20:33:08+03:00","position":1,"updated_at":"2026-07-17T15:12:18+03:00","product_id":9760030654731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_VERTEX_Matrix_Romburi_Suprapuse_Rame_Metalice_24W_2_Romburi_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Negru_Metal_si_Silicon_1.png?v=1784290338","width":1000,"height":1000},{"id":68117386690827,"created_at":"2026-04-07T20:33:08+03:00","