2:00","position":14,"updated_at":"2026-04-02T00:44:17+03:00","product_id":10716549808395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4.jpg?v=1775079857","width":3999,"height":3999},{"id":62529414856971,"created_at":"2025-11-20T18:41:32+02:00","position":15,"updated_at":"2026-04-02T00:44:17+03:00","product_id":10716549808395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT751_4BK_EPREL_b993bbab-fbd6-4aee-a190-229eb7f23685.png?v=1775079857","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10134773891339,"title":"Lustra LED SKYForma Nexen, 61W, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-skyforma-nexen-61w-stele-lumina-rece-calda-neutra-negru","body_html":"\u003cp class=\"\" data-end=\"479\" data-start=\"206\"\u003eSKYForma Nexen impresionează prin liniile sale dinamice și aspectul arhitectural, evidențiat de finisajul negru mat. Cu o putere de 61W și lumină reglabilă în trei nuanțe – rece, caldă și neutră – această lustră oferă atât funcționalitate, cât și caracter vizual puternic.\u003c\/p\u003e\u003cp class=\"\" data-end=\"938\" data-start=\"481\"\u003e✔ \u003cstrong data-end=\"506\" data-start=\"483\"\u003eIluminare eficientă\u003c\/strong\u003e – 61W ideali pentru spații medii și mari.\u003cbr data-end=\"552\" data-start=\"549\"\u003e✔ \u003cstrong data-end=\"590\" data-start=\"554\"\u003eTemperatură de culoare reglabilă\u003c\/strong\u003e – adaptabilă pentru relaxare, lucru sau activități zilnice.\u003cbr data-end=\"653\" data-start=\"650\"\u003e✔ \u003cstrong data-end=\"682\" data-start=\"655\"\u003eDimabilă cu telecomandă\u003c\/strong\u003e – personalizezi intensitatea luminii în funcție de nevoi.\u003cbr data-end=\"743\" data-start=\"740\"\u003e✔ \u003cstrong data-end=\"772\" data-start=\"745\"\u003eDesign cu personalitate\u003c\/strong\u003e – formele geometrice adaugă profunzime și ritm vizual în orice încăpere.\u003cbr data-end=\"848\" data-start=\"845\"\u003e✔ \u003cstrong data-end=\"871\" data-start=\"850\"\u003eFinisaj negru mat\u003c\/strong\u003e – potrivit pentru interioare moderne, industriale sau minimaliste.\u003c\/p\u003e\u003cp class=\"\" data-end=\"938\" data-start=\"481\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:39:40+03:00","created_at":"2025-04-15T13:20:21+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","BLACKSEASON","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52429920502027,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL645\/500BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"149.99","position":1,"product_id":10134773891339,"created_at":"2025-09-30T17:54:10+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70052692230411,"created_at":"2026-09-04T13:32:51+03:00","position":1,"updated_at":"2026-09-04T13:32:55+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep4_2026_01_32_39PM.png?v=1788517975","width":1254,"height":1254},{"id":70052675780875,"created_at":"2026-09-04T13:28:14+03:00","position":2,"updated_at":"2026-09-04T13:28:18+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep4_2026_01_28_03PM.png?v=1788517698","width":1254,"height":1254},{"id":70052667392267,"created_at":"2026-09-04T13:24:30+03:00","position":3,"updated_at":"2026-09-04T13:24:34+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep4_2026_01_24_19PM.png?v=1788517474","width":1254,"height":1254},{"id":60766475387147,"created_at":"2025-09-29T11:49:28+03:00","position":4,"updated_at":"2025-09-29T11:54:53+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_219df4a3-0605-4c83-956e-e61943236349.png?v=1759136093","width":1800,"height":1800},{"id":60766475485451,"created_at":"2025-09-29T11:49:29+03:00","position":5,"updated_at":"2025-09-29T11:54:53+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/A1_6880e466-ecc2-40b9-b15b-cf81630398fd.png?v=1759136093","width":3200,"height":3200},{"id":70052678566155,"created_at":"2026-09-04T13:28:53+03:00","position":6,"updated_at":"2026-09-04T13:30:41+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2026-09-04at13.28.48.png?v=1788517841","width":1024,"height":1024},{"id":70052661461259,"created_at":"2026-09-04T13:21:57+03:00","position":7,"updated_at":"2026-09-04T13:21:59+03:00","product_id":10134773891339,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2548542_big_color.png?v=1788517319","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760862896395,"title":"Lustra LED cu telecomanda HELIX 63W, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-helix-63w-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp data-sourcepos=\"1:1-1:243\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_c57966f1-2ff2-49be-b5b2-26b1bd6d5c51.png?v=1778233401\" alt=\"\"\u003eLustra LED cu telecomandă HELIX este o piesă de iluminat modernă și dinamică, cu un design care sugerează o formă spiralată sau elicoidală, finisată în negru. Cu o putere de 63W, oferă o iluminare puternică și versatilă pentru diverse spații.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:362\"\u003eNumele 'Helix' indică probabil un design cu elemente care se răsucesc sau se înfășoară, creând un efect vizual interesant și contemporan. Fiind LED, asigură o iluminare eficientă energetic, iar telecomanda inclusă adaugă un plus de confort, permițându-ți să ajustezi temperatura culorii (rece, caldă sau neutră) și intensitatea luminii (dimabilă) de la distanță.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:272\"\u003eFinisajul negru accentuează liniile moderne ale designului și îi conferă un aspect elegant și ușor de integrat în interioarele contemporane. Cu o putere de 63W, este potrivită pentru a ilumina eficient livinguri, sufragerii sau alte încăperi de dimensiuni medii sau mari.\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:40:57+02:00","created_at":"2025-02-25T03:40:57+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52360005091595,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT223BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"229.99","grams":0,"compare_at_price":"229.99","position":1,"product_id":9760862896395,"created_at":"2025-09-12T13:50:26+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68771676061963,"created_at":"2026-05-08T12:43:14+03:00","position":1,"updated_at":"2026-05-08T12:43:18+03:00","product_id":9760862896395,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/fil