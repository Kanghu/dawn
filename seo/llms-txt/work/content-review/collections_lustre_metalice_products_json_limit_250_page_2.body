LED Scandinave"],"variants":[{"id":52411759100171,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL770\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":9760825573643,"created_at":"2025-09-25T14:23:24+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51855302197515,"created_at":"2025-02-25T03:35:52+02:00","position":1,"updated_at":"2025-02-25T03:35:54+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-yoshina-50w-negru-1727785870.webp?v=1740447354","width":900,"height":900},{"id":51855302164747,"created_at":"2025-02-25T03:35:52+02:00","position":2,"updated_at":"2025-02-25T03:35:54+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1-_1_-1727785920.webp?v=1740447354","width":900,"height":900},{"id":51855302131979,"created_at":"2025-02-25T03:35:52+02:00","position":3,"updated_at":"2025-02-25T03:35:54+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/51plvyGhnmL._AC_SL1000_-1727785870.webp?v=1740447354","width":900,"height":900},{"id":51855302099211,"created_at":"2025-02-25T03:35:52+02:00","position":4,"updated_at":"2025-02-25T03:35:54+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/41_fHDP--VL._AC_SL1000_-1727785870.webp?v=1740447354","width":900,"height":900},{"id":65641517547787,"created_at":"2026-02-12T16:49:19+02:00","position":5,"updated_at":"2026-02-12T16:49:31+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LL770_4BK.webp?v=1770907771","width":900,"height":900},{"id":62528224264459,"created_at":"2025-11-20T15:55:57+02:00","position":6,"updated_at":"2026-02-12T16:49:31+02:00","product_id":9760825573643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL770_4BK_EPREL_e5ebceac-2d49-4e50-8db5-b4d28ff2ba02.png?v=1770907771","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757892706571,"title":"Lustra LED cu telecomanda BETTY 43W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-betty-43w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-end=\"458\" data-start=\"134\"\u003e\u003cstrong data-end=\"173\" data-start=\"134\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Artboard_2.jpg?v=1773087332\" alt=\"\"\u003eLustra LED cu telecomandă BETTY \u003c\/strong\u003eeste un corp de iluminat modern, elegant și extrem de versatil, conceput pentru a aduce un plus de rafinament în orice interior. Structura sa este formată din \u003cstrong data-end=\"365\" data-start=\"333\"\u003epatru cercuri interconectate\u003c\/strong\u003e, finisate impecabil în negru, creând un ansamblu geometric echilibrat și vizual spectaculos.\u003c\/p\u003e\u003cp data-end=\"826\" data-start=\"460\"\u003eCu o putere de \u003cstrong data-end=\"482\" data-start=\"475\"\u003e43W\u003c\/strong\u003e, lustra oferă o iluminare eficientă și uniformă, potrivită pentru încăperi de dimensiuni medii precum livinguri, dormitoare, birouri sau zone de relaxare. LED-urile integrate permit selectarea temperaturii de culoare – \u003cstrong data-end=\"735\" data-start=\"702\"\u003elumină caldă, neutră sau rece\u003c\/strong\u003e –, adaptând instant atmosfera în funcție de momentul zilei sau de activitatea desfășurată.\u003c\/p\u003e\u003cp data-end=\"826\" data-start=\"460\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/IN_VS_LED.jpg?v=1773087323\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"1069\" data-start=\"828\"\u003eTelecomanda inclusă oferă control total asupra luminii: schimbarea temperaturii de culoare, selectarea modului ideal de iluminare și reglarea intensității prin funcția \u003cstrong data-end=\"1008\" data-start=\"996\"\u003edimmable\u003c\/strong\u003e, astfel încât să poți crea exact ambianța pe care o dorești.\u003c\/p\u003e\u003cp data-end=\"1365\" data-start=\"1071\"\u003eFinisajul negru scoate în evidență liniile moderne ale designului circular și oferă un contrast elegant, ideal pentru interioare contemporane, minimaliste sau cu accente industriale. BETTY devine rapid un punct de interes în încăpere, îmbinând estetica modernă cu funcționalitatea avansată.\u003c\/p\u003e\u003cp data-end=\"1365\" data-start=\"1071\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Artboard_1.jpg?v=1773087324\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:142\"\u003eCu o putere de 43W, lustra BETTY este ideală pentru a ilumina eficient livinguri, dormitoare, birouri sau alte spații de dimensiuni medii.\u003c\/p\u003e","published_at":"2025-02-24T19:05:54+02:00","created_at":"2025-02-24T19:05:53+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52423832535307,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":9757892706571,"created_at":"2025-09-29T11:36:42+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":67091189432587,"created_at":"2026-03-09T22:16:40+02:00","position":1,"updated_at":"2026-03-19T10:20:25+02:00","pro