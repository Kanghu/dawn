LEDcutelecomanda_ELLA_4Patrate_85W_LuminaRece_Calda_Neutra_Dimabila_Negru-3.png?v=1747822459","width":1080,"height":1080},{"id":51841703313675,"created_at":"2025-02-25T01:25:15+02:00","position":6,"updated_at":"2026-07-07T11:46:34+03:00","product_id":9760030490891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-camellie-88w-dimabila-alb-negru-1687418781-1725021775.webp?v=1783413994","width":1024,"height":1024},{"id":51841703280907,"created_at":"2025-02-25T01:25:15+02:00","position":7,"updated_at":"2026-07-07T11:45:31+03:00","product_id":9760030490891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-camellie_d131-4bk_04-1687418782.webp?v=1783413931","width":1024,"height":1024},{"id":55637022507275,"created_at":"2025-05-21T13:13:03+03:00","position":8,"updated_at":"2025-12-08T16:49:31+02:00","product_id":9760030490891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT130_4BK-LustraLEDcutelecomanda_ELLA_4Patrate_85W_LuminaRece_Calda_Neutra_Dimabila_Negru-5.png?v=1765205371","width":1080,"height":1080},{"id":55637022540043,"created_at":"2025-05-21T13:13:03+03:00","position":9,"updated_at":"2026-07-07T11:35:36+03:00","product_id":9760030490891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT130_4BK-LustraLEDcutelecomanda_ELLA_4Patrate_85W_LuminaRece_Calda_Neutra_Dimabila_Negru-4.png?v=1783413336","width":1024,"height":1024},{"id":69708346163467,"created_at":"2026-07-07T11:54:15+03:00","position":10,"updated_at":"2026-07-07T11:54:18+03:00","product_id":9760030490891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2537959_big_color.png?v=1783414458","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10245306876171,"title":"Lustra LED suspendata DARIN, 120cm, 23W, Inaltime Reglabila, Lumina Rece, Negru","handle":"lustra-led-suspendata-darin-23w-inaltime-reglabila-lumina-rece-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:266\"\u003eLustra LED, o solutie de iluminat ce redefinedeste spatiul printr-o estetica minimalista si o performanta luminoasa remarcabila. Conceputa pentru a adauga un accent modern si functional, aceasta lustra este alegerea ideala pentru interioarele contemporane.\u003c\/p\u003e\u003cul data-sourcepos=\"3:1-6:0\"\u003e\n\u003cli data-sourcepos=\"3:1-3:241\"\u003e\n\u003cstrong\u003eDesign Elegant \u0026amp; Suspendat:\u003c\/strong\u003e Cu o \u003cstrong\u003eforma liniara\u003c\/strong\u003e si un finisaj \u003cstrong\u003enegru\u003c\/strong\u003e sofisticat, aceasta lustra este special conceputa pentru a fi \u003cstrong\u003esuspendata\u003c\/strong\u003e, oferind o prezenta vizuala discreta, dar de impact, in orice incapere moderna.\u003c\/li\u003e\n\u003cli data-sourcepos=\"4:1-4:285\"\u003e\n\u003cstrong\u003eIluminare Puternica \u0026amp; Clara:\u003c\/strong\u003e Beneficiati de o putere de 23W si un \u003cstrong\u003eflux luminos impresionant de 1840lm\u003c\/strong\u003e, cu o \u003cstrong\u003elumina rece de 6000K\u003c\/strong\u003e. Aceasta asigura o claritate vizuala excelenta, ideala pentru spatii de lucru sau zone ce necesita o iluminare intensa si energizanta.\u003c\/li\u003e\n\u003cli data-sourcepos=\"5:1-6:0\"\u003e\n\u003cstrong\u003eEficienta Durabila:\u003c\/strong\u003e Echipata cu tehnologie \u003cstrong\u003eBanda LED\u003c\/strong\u003e, lustra ofera o \u003cstrong\u003eautonomie remarcabila de 25.000 de ore\u003c\/strong\u003e, garantand o utilizare indelungata si costuri reduse de intretinere.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"7:1-7:193\"\u003eAceasta Lustra LED este alegerea perfecta pentru cei ce cauta o combinatie de eficienta, estetica si durabilitate, transformand orice living, hol sau bucatarie intr-un spatiu vibrant si modern.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-17T12:08:44+03:00","created_at":"2025-06-12T11:29:57+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED Suspendate","Plafoniere LED"],"variants":[{"id":52429878690059,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL633BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":10245306876171,"created_at":"2025-09-30T17:47:37+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56339256836363,"created_at":"2025-06-12T12:14:09+03:00","position":1,"updated_at":"2025-09-10T16:26:25+03:00","product_id":10245306876171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL633BK-LustraLED_96W_LuminaRece_Negru-1.png?v=1757510785","width":1080,"height":1080},{"id":56339256967435,"created_at":"2025-06-12T12:14:09+03:00","position":2,"updated_at":"2025-09-10T16:26:25+03:00","product_id":10245306876171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL633BK-LustraLED_96W_LuminaRece_Negru-4.png?v=1757510785","width":1080,"height":1080},{"id":56339256738059,"created_at":"2025-06-12T12:14:09+03:00","position":3,"updated_at":"2025-09-10T16:26:25+03:00","product_id":10245306876171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL633BK-LustraLED_96W_LuminaRece_Negru-3.png?v=1757510785","width":1080,"height":1080},{"id":56339256377611,"created_at":"2025-06-12T12:14:09+03:00","position":4,"updated_at":"2025-06-12T12:14:45+03:00","product_id":1024530687