3+02:00","position":6,"updated_at":"2026-02-12T16:33:26+02:00","product_id":9760030327051,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LL190BK.webp?v=1770906806","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10153973645579,"title":"Lustra LED cu telecomanda ZOE, 60W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-zoe-60w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"83234e7b7c4d42e7\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c3043829428-294 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3043829428-294\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3043829428-294\"\u003e\u003cdiv class=\"response-content ng-tns-c3043829428-294\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_83234e7b7c4d42e7\" dir=\"ltr\"\u003e\n\u003ch3 data-start=\"262\" data-end=\"348\"\u003e\u003cstrong data-start=\"266\" data-end=\"348\"\u003eLustra LED cu Telecomandă ZOE – Eleganță Geometrică \u0026amp; Control Total al Luminii\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cp data-start=\"350\" data-end=\"607\"\u003e\u003cstrong data-start=\"350\" data-end=\"357\"\u003eZOE\u003c\/strong\u003e impresionează prin designul său modern, format din \u003cstrong data-start=\"409\" data-end=\"440\"\u003etrei pătrate interconectate\u003c\/strong\u003e, finisate într-un alb impecabil. Aspectul geometric și aerisit o transformă într-o piesă decorativă ideală pentru interioare contemporane, minimaliste sau scandinave.\u003c\/p\u003e\n\u003cp data-start=\"350\" data-end=\"607\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-start=\"609\" data-end=\"898\"\u003eCu o putere de \u003cstrong data-start=\"624\" data-end=\"631\"\u003e60W\u003c\/strong\u003e, ZOE oferă o iluminare amplă și eficientă, potrivită pentru \u003cstrong data-start=\"692\" data-end=\"740\"\u003elivinguri, dininguri, dormitoare sau birouri\u003c\/strong\u003e. LED-urile integrate permit \u003cstrong data-start=\"769\" data-end=\"807\"\u003eselectarea temperaturii de culoare\u003c\/strong\u003e – \u003cstrong data-start=\"810\" data-end=\"836\"\u003erece, neutră sau caldă\u003c\/strong\u003e – pentru a adapta perfect atmosfera la orice moment al zilei.\u003c\/p\u003e\n\u003cp data-start=\"609\" data-end=\"898\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-start=\"900\" data-end=\"1077\"\u003eTelecomanda inclusă îți oferă \u003cstrong data-start=\"930\" data-end=\"949\"\u003econtrol complet\u003c\/strong\u003e, permițând reglarea intensității luminoase prin funcția \u003cstrong data-start=\"1006\" data-end=\"1018\"\u003edimmable\u003c\/strong\u003e, de la lumină puternică la un ambient discret și relaxant.\u003c\/p\u003e\n\u003cp data-start=\"900\" data-end=\"1077\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\n\u003chr data-start=\"1079\" data-end=\"1082\"\u003e\n\u003ch3 data-start=\"1084\" data-end=\"1118\"\u003e\u003cstrong data-start=\"1088\" data-end=\"1118\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"1119\" data-end=\"1576\"\u003e\n\u003cli data-start=\"1119\" data-end=\"1184\"\u003e\u003cp data-start=\"1121\" data-end=\"1184\"\u003e\u003cstrong data-start=\"1121\" data-end=\"1148\"\u003eDesign geometric modern\u003c\/strong\u003e: 3 pătrate cu finisaj alb elegant\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1185\" data-end=\"1252\"\u003e\u003cp data-start=\"1187\" data-end=\"1252\"\u003e\u003cstrong data-start=\"1187\" data-end=\"1201\"\u003ePutere 60W\u003c\/strong\u003e: iluminare eficientă pentru spații medii și mari\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1253\" data-end=\"1325\"\u003e\u003cp data-start=\"1255\" data-end=\"1325\"\u003e\u003cstrong data-start=\"1255\" data-end=\"1279\"\u003eTelecomandă completă\u003c\/strong\u003e: control al culorii și intensității luminii\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1326\" data-end=\"1381\"\u003e\u003cp data-start=\"1328\" data-end=\"1381\"\u003e\u003cstrong data-start=\"1328\" data-end=\"1356\"\u003e3 temperaturi de culoare\u003c\/strong\u003e: rece \/ neutră \/ caldă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1382\" data-end=\"1441\"\u003e\u003cp data-start=\"1384\" data-end=\"1441\"\u003e\u003cstrong data-start=\"1384\" data-end=\"1405\"\u003eFuncție dimmabilă\u003c\/strong\u003e: ajustare fină a fluxului luminos\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1442\" data-end=\"1503\"\u003e\u003cp data-start=\"1444\" data-end=\"1503\"\u003e\u003cstrong data-start=\"1444\" data-end=\"1465\"\u003eMateriale premium\u003c\/strong\u003e: acril + metal, finisaj alb durabil\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1504\" data-end=\"1576\"\u003e\u003cp data-start=\"1506\" data-end=\"1576\"\u003e\u003cstrong data-start=\"1506\" data-end=\"1526\"\u003eStil contemporan\u003c\/strong\u003e: perfect pentru decoruri moderne și minimaliste\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"1578\" data-end=\"1581\"\u003e\n\u003ch3 data-start=\"1583\" data-end=\"1601\"\u003e\u003cstrong data-start=\"1587\" data-end=\"1601\"\u003eBeneficii:\u003c\/strong\u003e\u003c\/h3\u003e\n\u003cul data-start=\"1602\" data-end=\"1950\"\u003e\n\u003cli data-start=\"1602\" data-end=\"1660\"\u003e\u003cp data-start=\"1604\" data-end=\"1660\"\u003e\u003cstrong data-start=\"1604\" data-end=\"1635\"\u003eControl total al atmosferei\u003c\/strong\u003e direct din telecomandă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1661\" data-end=\"1732\"\u003e\u003cp data-start=\"1663\" data-end=\"1732\"\u003e\u003cstrong data-start=\"1663\" data-end=\"1687\"\u003eIluminare adaptabilă\u003c\/strong\u003e pentru lucru, relaxare sau lumină generală\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1733\" data-end=\"1810\"\u003e\u003cp data-start=\"1735\" data-end=\"1810\"\u003e\u003cstrong data-start=\"1735\" data-end=\"1783\"\u003eEficiență energetică și durată de viață mare\u003c\/strong\u003e datorită tehnologiei LED\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1811\" data-end=\"1874\"\u003e\u003cp data-start=\"1813\" data-end=\"1874\"\u003e\u003cstrong data-start=\"1813\" data-end=\"1841\"\u003eDesign luminos și modern\u003c\/strong\u003e care nu încarcă vizual spațiul\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"1875\" data-end=\"1950\"\u003e\u003cp data-start=\"1877\" data-end=\"1950\"\u003e\u003cstrong data-start=\"1877\" data-end=\"1914\"\u003ePerfectă pentru multiple încăperi\u003c\/strong\u003e datorită proporțiilor echilibrate\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003chr data-start=\"1952\" data-end=\"1955\"\u003e\n\u003cp data-start=\"1957\" data-end=\"2134\"\u003e\u003cstrong data-start=\"1957\" data-end=\"1975\"\u003eLustra LED ZOE\u003c\/strong\u003e este alegerea ideală dacă îți dorești un corp de iluminat modern, versatil și elegant, care combină tehnologia inteligentă cu un design geometric spectaculos.\u003c\/p\u003e\n\u003cp data-sourcepos=\"30:1-30:201\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-04-29T16:37:42+03:00","created_at":"2025-04-28T16:30:16+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428258312459,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT808\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":10153973645579,"created_at":"2025-09-30T13:06:47+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70027196236043,"created_at":"2026-09-02T15:06:30+03:00","position":1,"updated_at":"2026-09-02T15:06:34+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImageSep2_2026_03_06_19PM.png?v=1788350794","width":1254,"height":1254},{"id":69925238243595,"created_at":"2026-08-14T15:15:51+03:00","position":2,"updated_at":"2026-08-14T15:15:54+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/011_LT808-3WH_x01_0035b4f4-817e-4f9e-8b8b-12e15aa54bb3.webp?v=1786709754","width":1254,"height":1254},{"id":69925238014219,"created_at":"2026-08-14T15:15:51+03:00","position":3,"updated_at":"2026-08-26T16:02:59+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_LT808-3WH_closeup6000.webp?v=1787749379","width":1086,"height":1086},{"id":69925237948683,"created_at":"2026-08-14T15:15:51+03:00","position":4,"updated_at":"2026-08-14T15:15:53+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_LT808-3WH_808.webp?v=1786709753","width":1254,"height":1254},{"id":69925237981451,"created_at":"2026-08-14T15:15:51+03:00","position":5,"updated_at":"2026-08-26T16:01:55+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_LT808-3WH_bedroom.webp?v=1787749315","width":1086,"height":1086},{"id":69925238046987,"created_at":"2026-08-14T15:15:51+03:00","position":6,"updated_at":"2026-08-26T16:03:25+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_LT808-3WH_dining.webp?v=1787749405","width":1086,"height":1086},{"id":69925237915915,"created_at":"2026-08-14T15:15:51+03:00","position":7,"updated_at":"2026-08-14T15:15:54+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_LT808-3WH_808_2.webp?v=1786709754","width":1000,"height":1000},{"id":69925238210827,"created_at":"2026-08-14T15:15:51+03:00","position":8,"updated_at":"2026-08-14T15:15:54+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_LT808-3WH_tone.webp?v=1786709754","width":1254,"height":1254},{"id":70003482231051,"created_at":"2026-08-27T09:22:13+03:00","position":9,"updated_at":"2026-08-27T09:22:15+03:00","product_id":10153973645579,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2539605_big_color_2757ef7f-b864-461a-b19b-e9d4e5af4fc7.png?v=1787811735","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757939269899,"title":"Lustra LED cu telecomanda si cristal BLAKELY RGB 74W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-blakely-rgb-74w-4-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cristal RGB Mathilde, parte a rafinatei game Midori, este o combinație perfectă de design contemporan și tehnologie avansată de iluminat. Cu o putere de 74W și un design elegant în alb, această lustră aduce un plus de stil și luminozitate în orice spațiu interior. Designul distinctiv al lustrei Mathilde este format din patru pătrate, fiecare împodobit cu cristale transparente, care adaugă un nivel de rafinament și strălucire. Această structură geometrică creează un efect vizual captivant, în timp ce cristalele refractă lumina, creând un joc de scânteieri și străluciri impresionante.\u003cbr\u003e\u003cbr\u003eLustra include o telecomandă care vă permite să schimbați între trei tipuri de lumină – caldă, rece și neutră – și să reglați intensitatea luminii, oferind astfel flexibilitate și control total asupra ambianței. Funcția RGB adaugă o dimensiune suplimentară de personalizare, permițând selectarea diferitelor culori pentru a se potrivi cu orice ocazie sau dispoziție. Cu un flux luminos de 5920lm, lustra LED Cristal RGB Mathilde oferă o iluminare puternică și eficientă, ideală pentru spații de dimensiuni medii, cum ar fi livinguri, săli de mese sau holuri. Eficiența energetică a tehnologiei LED asigură un consum redus de energie și o durată de viață îndelungată, făcând din această lustră o opțiune economică și sustenabilă.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal RGB Mathilde din gama Midori este alegerea ideală pentru cei care caută să combine eleganța modernă cu funcționalitatea și eficiența energetică. Este soluția perfectă pentru a adăuga un element de iluminat sofisticat și versatil în orice ambient, oferind un iluminat de calitate superioară care să îmbunătățească aspectul și atmosfera oricărui interior.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T19:41:59+02:00","created_at":"2025-02-24T19:41:59+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365358694667,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7965\/4WH+CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.97","grams":0,"compare_at_price":"299.99","position":1,"product_id":9757939269899,"created_at":"2025-09-13T13:26:08+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51819270144267,"created_at":"2025-02-24T19:42:00+02:00","position":1,"updated_at":"2025-02-24T19:42:02+02:00","product_id":9757939269899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-cu-telecomanda-mathilde-74w-dimabila-alb-1686901050.webp?v=1740418922","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757622698251,"title":"Lustra LED cu telecomanda BETTY 40W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-betty-40w-3-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp data-sourcepos=\"1:1-1:228\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_907c8c46-0297-44f6-b917-a22ace955fd7.png?v=1778443390\" alt=\"\"\u003eLustra LED cu telecomandă BRENDA este o opțiune de iluminat modernă și elegantă, cu un design format din 3 cercuri concentrice, finisate în alb. Cu o putere de 40W, oferă o iluminare versatilă și eficientă pentru diverse spații.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:448\"\u003eCele trei cercuri, dispuse într-o manieră care creează un efect vizual armonios, sunt iluminate de LED-uri cu posibilitatea de a schimba temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:225\"\u003eFinisajul alb al lustrei îi conferă un aspect curat și minimalist, făcând-o ușor de integrat în diverse stiluri de decor interior. Designul cu cercuri concentrice asigură o distribuție uniformă a luminii în întreaga încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:141\"\u003eCu o putere de 40W, lustra BRENDA este potrivită pentru a ilumina eficient livinguri, dormitoare, holuri sau alte spații de dimensiuni medii.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003ch3 style=\"text-align: center;\"\u003eVezi video demonstrativ\u003c\/h3\u003e\u003cdiv class=\"row center w-100\"\u003e\n\u003cdiv class=\"col-12 col-md-6\" style=\"width: 50%; height: auto; text-align: center;\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/2smwARfsHy4\" style=\"width: 100%; height: 250px; border: 0;\" title=\"Video demonstratie Lustra LED Brenda\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\n\u003cdiv class=\"col-12 col-md-6\" style=\"width: 50%; height: auto;\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/6lGGurvtttM\" style=\"width: 100%; height: 250px; border: 0;\" title=\"Video montaj Lustra LED Brenda\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\n\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: left;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAcum este mult mai simplu să găsiți \u003cstrong\u003elustre ieftine și frumoase\u003c\/strong\u003e fără prea multe bătăi de cap. Pe site-ul nostru, veți descoperi \u003cstrong\u003ecorpuri de iluminat moderne cu LED\u003c\/strong\u003e, precum lustra Betty, foarte apreciată de clienți datorită combinației perfecte între eficiență și stil.\u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e","published_at":"2025-02-24T17:20:33+02:00","created_at":"2025-02-24T17:20:33+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429782057227,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT800\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"129.99","grams":0,"compare_at_price":"129.99","position":1,"product_id":9757622698251,"created_at":"2025-09-30T17:15:35+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":68820460830987,"created_at":"2026-05-10T23:02:49+03:00","position":1,"updated_at":"2026-05-10T23:02:54+03:00","product_id":9757622698251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.COVER_ec835498-4f1b-4d78-b475-45a739dd2c0e.png?v=1778443374","width":1000,"height":1000},{"id":68820460863755,"created_at":"2026-05-10T23:02:49+03:00","position":2,"updated_at":"2026-05-10T23:02:54+03:00","product_id":9757622698251,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\