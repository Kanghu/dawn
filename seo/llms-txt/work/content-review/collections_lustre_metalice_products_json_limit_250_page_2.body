:2000,"height":2000},{"id":60237236011275,"created_at":"2025-09-12T15:22:53+03:00","position":3,"updated_at":"2025-09-12T15:23:59+03:00","product_id":10721684783371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_a0c6de78-08f1-406a-b983-7973f7ce2e3d.png?v=1757679839","width":2000,"height":2000},{"id":60237235978507,"created_at":"2025-09-12T15:22:53+03:00","position":4,"updated_at":"2025-09-12T15:22:58+03:00","product_id":10721684783371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_14baaaa2-65ea-421f-b6a5-7905bbe100c7.png?v=1757679778","width":2000,"height":2000},{"id":62528302285067,"created_at":"2025-11-20T16:05:26+02:00","position":5,"updated_at":"2025-11-20T16:05:29+02:00","product_id":10721684783371,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8056WH_EPREL_3b1feaf4-4018-4a01-856f-85edaee0f58c.png?v=1763647529","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10721692025099,"title":"Lustra LED suspendata cu telecomanda si cristal PRISM LUMORA 63W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-prism-lumora-63w-3-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cp\u003e\u003cstrong\u003ePRISM LUMORA 63W\u003c\/strong\u003e este o lustra LED suspendată cu design sofisticat, compusă din 3 cercuri elegante decorate cu cristale strălucitoare. Finisajul crom lucios amplifică efectul de reflexie, iar structura suspendată conferă volum și dinamism spațiului.\u003c\/p\u003e\u003ch3\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eModel:\u003c\/strong\u003e PRISM LUMORA\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePutere:\u003c\/strong\u003e 63W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCuloare:\u003c\/strong\u003e Crom lucios\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDimensiuni:\u003c\/strong\u003e 50 x 35 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMontaj:\u003c\/strong\u003e Suspendat\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eFuncționalități și avantaje\u003c\/h3\u003e\u003cp\u003e✔ Selectarea temperaturii de culoare pentru diferite scenarii de iluminare\u003cbr\u003e✔ Intensitate reglabilă pentru ambient personalizat\u003cbr\u003e✔ Cristale decorative cu efect spectaculos de reflexie\u003cbr\u003e✔ Înălțime ajustabilă – adaptabilă la diferite tipuri de tavane\u003cbr\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp\u003ePrin combinația dintre tehnologia LED performantă și detaliile rafinate din cristal, \u003cstrong\u003ePRISM LUMORA 63W\u003c\/strong\u003e devine un element central decorativ, oferind atât iluminare eficientă, cât și un impact vizual remarcabil.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1