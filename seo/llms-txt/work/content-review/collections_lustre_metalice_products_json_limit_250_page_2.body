-LT1358BK-LustraLEDcutelecomandaHarman_29W_8Surse_LuminaNeutra_Negru-3.jpg?v=1755007652","width":1080,"height":1080},{"id":56699748385035,"created_at":"2025-06-23T16:26:35+03:00","position":6,"updated_at":"2025-08-12T17:07:32+03:00","product_id":10514869813515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT1358BK-LustraLEDcutelecomandaHarman_29W_8Surse_LuminaNeutra_Negru-4.jpg?v=1755007652","width":1080,"height":1080},{"id":66230987358475,"created_at":"2026-02-22T21:04:29+02:00","position":7,"updated_at":"2026-02-22T21:04:31+02:00","product_id":10514869813515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT135_8BK.webp?v=1771787071","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10514970444043,"title":"Lustra LED pentru copii FIGHTER, Tip avion, 100W, Lumina Rece\/Calda\/Neutra, Gri Aeronautic","handle":"lustra-led-pentru-copii-fighter-tip-avion-100w-lumina-rece-calda-neutra-gri","body_html":"\u003cp\u003eLustra LED FIGHTER are un corp de iluminat modern cu design tematic in forma de avion, perfect pentru camera copiilor.\u003c\/p\u003e\u003cp\u003eEste realizata din \u003cstrong\u003eacril si metal\u003c\/strong\u003e, cu finisaj \u003cstrong\u003eargintiu\u003c\/strong\u003e, si se monteaza aplicat pe \u003cstrong\u003etavan\u003c\/strong\u003e. Functioneaza la o putere de \u003cstrong data-end=\"244\" data-start=\"236\"\u003e100W\u003c\/strong\u003e si ofera un flux luminos de \u003cstrong data-end=\"283\" data-start=\"273\"\u003e8000 lm\u003c\/strong\u003e, fiind echipata cu banda LED si autonomie de \u003cstrong data-end=\"340\" data-start=\"329\"\u003e25.000h\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003eDimensiunile acesteia sunt \u003cstrong data-end=\"386\" data-start=\"369\"\u003e73 cm lungime\u003c\/strong\u003e, \u003cstrong data-end=\"404\" data-start=\"388\"\u003e46 cm latime\u003c\/strong\u003e si \u003cstrong data-end=\"426\" data-start=\"408\"\u003e38 cm inaltime\u003c\/strong\u003e, avand clasa de protectie \u003cstrong data-end=\"461\" data-start=\"453\"\u003eIP20\u003c\/strong\u003e si alimentare la \u003cstrong data-end=\"491\" data-start=\"479\"\u003e220–230V\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003eEmite lumina \u003cstrong data-end=\"514\" data-start=\"506\"\u003erece\u003c\/strong\u003e, \u003cstrong data-end=\"525\" data-start=\"516\"\u003ecalda\u003c\/strong\u003e si \u003cstrong data-end=\"539\" data-start=\"529\"\u003eneutra\u003c\/strong\u003e, fiind ideala pentru \u003cstrong data-end=\"573\" data-start=\"561\"\u003einterior\u003c\/strong\u003e, in special pentru \u003cstrong data-end=\"613\" data-start=\"593\"\u003ecamera copilului\u003c\/strong\u003e sau \u003cstrong data-end=\"630\" data-start=\"618\"\u003edormitor\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e","published_at":"2025-06-23T17:11:28+03:00","created_at":"2025-06-23T17:11:27+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Copii","tags":["active","Corpuri de Iluminat","Lustre Copii","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52388418224395,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CP6681","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"799.99","grams":0,"compare_at_price":"899.99","position":1,"product_id":10514970444043,"created_at":"2025-09-19T14:33:32+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56700740600075,"created_at":"2025-06-23T17:37:19+03:00","position":1,"updated_at":"2025-06-23T17:37:22+03:00","product_id":10514970444043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6681-LustraLEDFIGHTER_100W_luminaReceCaldaNeutra_Argintiu-3.jpg?v=1750689442","width":1080,"height":1080},{"id":56700742140171,"created_at":"2025-06-23T17:37:27+03:00","position":2,"updated_at":"2025-06-23T17:37:30+03:00","product_id":10514970444043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6681-LustraLEDFIGHTER_100W_luminaReceCaldaNeutra_Argintiu-1.jpg?v=1750689450","width":1080,"height":1080},{"id":56700742074635,"created_at":"2025-06-23T17:37:28+03:00","position":3,"updated_at":"2025-06-23T17:37:30+03:00","product_id":10514970444043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-CP6681-LustraLEDFIGHTER_100W_luminaReceCaldaNeutra_Argintiu-2.jpg?v=1750689450","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10649188106507,"title":"Lustra LED cu telecomanda ZOE, 67W, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-67w-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003carticle data-turn=\"assistant\" data-scroll-anchor=\"true\" data-testid=\"conversation-turn-108\" dir=\"auto\" class=\"text-token-text-primary w-full focus:outline-none scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]\" tabindex=\"-1\"\u003e\u003cdiv class=\"text-base my-auto mx-auto pb-10 [--thread-content-margin:--spacing(4)] @[37rem]:[--thread-content-margin:--spacing(6)] @[72rem]:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)\"\u003e\u003cdiv class=\"[--thread-content-max-width:32rem] @[34rem]:[--thread-content-max-width:40rem] @[64rem]:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group\/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn\" tabindex=\"-1\"\u003e\n\u003cdiv class=\"flex max-w-full flex-col grow\"\u003e\u003cdiv data-message-model-slug=\"gpt-4o\" class=\"min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+\u0026amp;]:mt-5\" dir=\"auto\" data-message-id=\"2a2d87da-8988-4947-bcff-b7d29c43d727\" data-message-author-role=\"assistant\"\u003e\u003cdiv class=\"flex w-full flex-col gap-1 empty:hidden first:pt-[3px]\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv class=\"mt-3 w-full empty:hidden\"\u003e\n\u003cp data-start=\"0\" data-end=\"342\"\u003eAceasta lustra LED moderna, cu forma geometrica dinamica si finisaj alb mat, aduce un accent architectural elegant in orice interior contemporan. Gandita pentru functionalitate si flexibilitate, este echipata cu telecomanda ce permite ajustarea temperaturii de culoare si a intensitatii luminii, adaptandu-se perfect oricarui moment al zilei.\u003c\/p\u003e\n\u003cp data-start=\"344\" data-end=\"524\"\u003eCu un diametru generos de 60 cm si o putere de 67W, este ideala pentru livinguri, dormitoare sau birouri care necesita o iluminare uniforma, dar si o prezenta decorativa de impact.\u003c\/p\u003e\n\u003ch3 data-start=\"526\" data-end=\"556\"\u003eCaracteristici principale:\u003c\/h3\u003e\n\u003cul\u003e\n\u003cli data-start=\"559\" data-end=\"630\"\u003e\n\u003cstrong data-start=\"559\" data-end=\"573\"\u003ePutere 67W\u003c\/strong\u003e – asigura iluminare eficienta si consum optim de energie\u003c\/li\u003e\n\u003cli data-start=\"633\" data-end=\"707\"\u003e\n\u003cstrong data-start=\"633\" data-end=\"656\"\u003eTelecomanda inclusa\u003c\/strong\u003e – controlezi lumina direct din confortul canapelei\u003c\/li\u003e\n\u003cli data-start=\"710\" data-end=\"810\"\u003e\n\u003cstrong data-start=\"710\" data-end=\"731\"\u003eLumina ajustabila\u003c\/strong\u003e: calda, rece sau neutra – in functie de momentul zilei sau de atmosfera dorita\u003c\/li\u003e\n\u003cli data-start=\"813\" data-end=\"888\"\u003e\n\u003cstrong data-start=\"813\" data-end=\"825\"\u003eDimabila\u003c\/strong\u003e – poti regla intensitatea luminii pentru confort vizual sporit\u003c\/li\u003e\n\u003cli data-start=\"891\" data-end=\"951\"\u003e\n\u003cstrong data-start=\"891\" data-end=\"909\"\u003eDiametru 60 cm\u003c\/strong\u003e – potrivita pentru incaperi medii si mari\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-start=\"953\" data-end=\"1136\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eLustra combina designul expresiv cu tehnologia moderna, fiind o alegere ideala pentru cei care isi doresc un corp de iluminat care sa iasa in evidenta atat estetic, cat si functional.\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/article\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-07-28T09:29:58+03:00","created_at":"2025-07-24T16:15:57+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52163028844811,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT831\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"239.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":10649188106507,"created_at":"2025-09-04T14:28:48+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":62341029331211,"created_at":"2025-11-14T15:35:39+02:00","position":1,"updated_at":"