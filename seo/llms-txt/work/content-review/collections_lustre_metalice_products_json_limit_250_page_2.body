n":6,"updated_at":"2025-12-04T12:48:04+02:00","product_id":10238873501963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT723_8-lustra-led-cu-telecomanda_2.webp?v=1764845284","width":1080,"height":1080},{"id":62981868159243,"created_at":"2025-12-03T16:54:47+02:00","position":7,"updated_at":"2026-07-23T14:24:33+03:00","product_id":10238873501963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_6.png?v=1784805873","width":2000,"height":2000},{"id":56467695665419,"created_at":"2025-06-16T14:56:45+03:00","position":8,"updated_at":"2025-12-04T12:48:04+02:00","product_id":10238873501963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT723_8GD-LustraLEDcuTelecomndaKARINA_63W_8Elemente_LuminaCalda_Rece_Neutra_Dimabila_Auriu_4.jpg?v=1764845284","width":1080,"height":1080},{"id":56325787517195,"created_at":"2025-06-12T00:48:11+03:00","position":9,"updated_at":"2026-05-13T10:22:01+03:00","product_id":10238873501963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT723_8-lustra-led-cu-telecomanda_6159f1c7-f654-4f65-9adb-00ee63f79f0e.webp?v=1778656921","width":1024,"height":1024},{"id":62528874053899,"created_at":"2025-11-20T17:28:39+02:00","position":10,"updated_at":"2025-12-04T12:48:04+02:00","product_id":10238873501963,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT723_8GD_EPREL_71504363-5a18-4d85-a878-997cbf934d1d.png?v=1764845284","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10153988292875,"title":"Lustra LED cu telecomanda ZOE 60W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Metal si Acril","handle":"lustra-led-cu-telecomanda-zoe-60w-3-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"4f7f3540ebb0ec65\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c3043829428-299 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3043829428-299\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3043829428-299\"\u003e\u003cdiv class=\"response-content ng-tns-c3043829428-299\"\u003e\u003cdiv class=\"markdown markdown-main-panel\" id=\"model-response-message-contentr_4f7f3540ebb0ec65\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"3:1-3:92\"\u003e\u003cstrong\u003eEleganță Geometrică și Control Luminos Inteligent: Lustra LED cu Telecomandă ZOE (Negru)\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:296\"\u003eÎmbracă-ți spațiul cu un design modern și o iluminare complet adaptabilă cu lustra LED ZOE. Compoziția sa elegantă, formată din \u003cstrong\u003etrei pătrate\u003c\/strong\u003e interconectate sau dispuse armonios, finisate într-o nuanță sofisticată de \u003cstrong\u003enegru\u003c\/strong\u003e, adaugă o notă de stil contemporan și îndrăzneț oricărei încăperi.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:296\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:460\"\u003eCu o putere de \u003cstrong\u003e60W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și amplă, ideală pentru livinguri, dininguri, dormitoare sau birouri moderne. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Poți alege între \u003cstrong\u003elumină rece\u003c\/strong\u003e, perfectă pentru activități care necesită concentrare; \u003cstrong\u003elumină caldă\u003c\/strong\u003e, ideală pentru a crea un ambient primitor și relaxant; și \u003cstrong\u003elumină neutră\u003c\/strong\u003e, potrivită pentru iluminatul general de zi cu zi.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:460\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:184\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminoasă, creând astfel ambientul perfect pentru fiecare moment, de la o lumină strălucitoare la o lumină ambientală subtilă.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:96\"\u003e\n\u003cstrong\u003eDesign Modern și Geometric:\u003c\/strong\u003e Trei pătrate interconectate\/dispuse armonios cu finisaj negru.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:80\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 60W pentru o iluminare optimă a spațiilor medii și mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:91\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al temperaturii culorii și intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:94\"\u003e\n\u003cstrong\u003eTrei Temperaturi de Culoare:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru a se potrivi oricărei ocazii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:113\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Acril durabil și metal rezistent cu finisaj negru elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Minimalist:\u003c\/strong\u003e Se integrează perfect în interioarele moderne, industriale sau scandinave.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"23:1-29:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:93\"\u003e\n\u003cstrong\u003eControl Total al Luminii:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:79\"\u003e\n\u003cstrong\u003eAtmosferă Personalizată:\u003c\/strong\u003e Creează ambientul perfect pentru fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:111\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Designul geometric și finisajul negru adaugă un plus de stil modern și sofisticat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:91\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii simplu și confortabil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eIluminare Amplă:\u003c\/strong\u003e Potrivită pentru iluminarea eficientă a diverselor spații.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"30:1-30:226\"\u003eLustra LED cu telecomandă ZOE (negru) este alegerea ideală pentru a adăuga un plus de stil modern, confort și control inteligent în casa ta. Bucură-te de iluminarea adaptabilă și de designul geometric elegant în nuanța neagră!\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-04-29T16:38:32+03:00","created_at":"2025-04-28T16:41:27+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","Back2school","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52426001973515,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT808\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":10153988292875,"created_at":"2025-09-30T01:15:54+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":70031320645899,"created_at":"2026-09-03T15:36:02+03:00","position":1,"updated_at":"2026-09-03T15:37:52+03:00","product_id":10153988292875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_ZOE_60W_3_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Negru_Metal_si_Acril_12.png?v=1788439072","width":764,"height":764},{"id":63139367682315,"created_at":"2025-12-08T17:31:09+02:00","position":2,"updated_at":"2026-07-22T16:42:02+03:00","product_id":10153988292875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_ZOE_60W_3_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Negru_Metal_si_Acril_6.png?v=1784727722","width":800,"height":800},{"id":68981985149195,"created_at":"2026-05-20T10:29:27+03:00","position":3,"updated_at":"2026-07-22T16:42:26+03:00","product_id":10153988292875,"variant_ids":[],"src":"https:\/\/cdn