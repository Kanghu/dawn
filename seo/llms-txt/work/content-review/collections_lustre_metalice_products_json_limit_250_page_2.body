f6a7e7c4a4.jpg?v=1773139011","width":3999,"height":3999},{"id":63001200525579,"created_at":"2025-12-04T15:09:35+02:00","position":15,"updated_at":"2026-03-10T12:36:51+02:00","product_id":10178298052875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT223WH_EPREL.png?v=1773139011","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10730149413131,"title":"Lustra LED cu Telecomanda AXIAL, 83W, 6 Elemente, Lumina Rece\/Clada\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-axial-84w-6-elemente-lumina-rece-clada-neutra-dimabila-alb","body_html":"\u003cp data-start=\"81\" data-end=\"478\"\u003eLustra LED \u003cstrong data-start=\"92\" data-end=\"105\"\u003eAXIAL\u003c\/strong\u003e aduce un plus de stil și funcționalitate în decorul modern. Cu \u003cstrong data-start=\"169\" data-end=\"192\"\u003e6 elemente elegante\u003c\/strong\u003e și finisaj \u003cstrong data-start=\"204\" data-end=\"222\"\u003ealb minimalist\u003c\/strong\u003e, oferă un design contemporan și rafinat. Puterea de \u003cstrong data-start=\"275\" data-end=\"295\"\u003e83W LED integrat\u003c\/strong\u003e asigură o iluminare intensă și uniformă, iar prin \u003cstrong data-start=\"346\" data-end=\"369\"\u003etelecomanda inclusă\u003c\/strong\u003e poți regla atât intensitatea, cât și temperatura luminii: \u003cstrong data-start=\"428\" data-end=\"475\"\u003e3000K (caldă), 4000K (neutră), 6000K (rece)\u003c\/strong\u003e.\u003c\/p\u003e\u003cp data-start=\"480\" data-end=\"778\"\u003e✔ \u003cstrong data-start=\"482\" data-end=\"493\"\u003ePutere:\u003c\/strong\u003e 83W LED integrat\u003cbr data-start=\"510\" data-end=\"513\"\u003e✔ \u003cstrong data-start=\"515\" data-end=\"539\"\u003eTemperatură culoare:\u003c\/strong\u003e 3000K \/ 4000K \/ 6000K\u003cbr data-start=\"561\" data-end=\"564\"\u003e✔ \u003cstrong data-start=\"566\" data-end=\"578\"\u003eFuncții:\u003c\/strong\u003e Dimabilă, control complet prin telecomandă\u003cbr data-start=\"621\" data-end=\"624\"\u003e✔ \u003cstrong data-start=\"626\" data-end=\"637\"\u003eDesign:\u003c\/strong\u003e 6 elemente moderne, finisaj alb elegant\u003cbr data-start=\"677\" data-end=\"680\"\u003e✔ \u003cstrong data-start=\"682\" data-end=\"695\"\u003eMaterial:\u003c\/strong\u003e Metal + Acril\u003cbr data-start=\"709\" data-end=\"712\"\u003e✔ \u003cstrong data-start=\"714\" data-end=\"728\"\u003eUtilizare:\u003c\/strong\u003e Living, dining, dormitor, birou, spații moderne\u003c\/p\u003e\u003cp data-start=\"780\" data-end=\"921\"\u003eAceastă lustra LED este soluția ideală pentru cei care caută \u003cstrong data-start=\"841\" data-end=\"886\"\u003eeleganță, confort și eficiență energetică\u003c\/strong\u003e într-un singur corp de iluminat.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:223\"\u003e \u003c\/p\u003e","published_at":"2025-11-20T12:31:13+02:00","created_at":"2025-09-22T10:48:13+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52429954449675,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT178\/6WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"339.97","grams":0,"compare_at_price":"399.99","position":1,"product_id":10730149413131,"created_at":"2025-09-30T17:59:18+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":60557914734859,"created_at":"2025-09-22T11:00:12+03:00","position":1,"updated_at":"2025-09-22T11:01:41+03:00","product_id":10730149413131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_a8ae202d-aaae-4278-a0ad-106d82caa3a6.png?v=1758528101","width":662,"height":662},{"id":66527025234187,"created_at":"2026-02-27T10:07:19+02:00","position":2,"updated_at":"2026-02-27T10:11:24+02:00","product_id":10730149413131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pic.webp?v=1772179884","width":800,"height":800},{"id":67964444049675,"created_at":"2026-04-02T00:34:29+03:00","position":3,"updated_at":"2026-04-02T00:34:39+03:00","product_id":10730149413131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/pic_1_fa40ecd3-9014-49a8-81d1-121321582e43.webp?v=1775079279","width":800,"height":800},{"id":66229291876619,"created_at":"2026-02-22T20:53:04+02:00","position":4,"updated_at":"2026-04-02T00:34:39+03:00","product_id":10730149413131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT178_6WH.webp?v=1775079279","width":662,"height":662},{"id":68425758179595,"created_at":"2026-04-22T13:44:54+03:00","position":5,"updated_at":"2026-04-22T13:44:56+03:00","product_id":10730149413131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2698643_big_color.svg?v=1776854696","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10723993354507,"title":"Lustra LED suspendata cu telecomanda CASIANA 41W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-casiana-41w-2-cercuri-lumina-rece-calda-neutra-dimabila-alb-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.     \u003cem\u003e \u003c\/em\u003e\u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-09-15T16:31:47+03:00","created_at":"2025-09-15T13:34:15+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":