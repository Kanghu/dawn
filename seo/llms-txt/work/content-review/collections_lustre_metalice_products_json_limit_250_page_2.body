/0782\/5175\/3739\/files\/Label_2522217_big_color.png?v=1779888395","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133039612171,"title":"Lustra LED cu telecomanda MIRALUX RGB, 62W, lumina Albastra\/Rece\/Neutra\/Calda, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-miralux-rgb-62w-lumina-albastra-rece-neutra-calda-dimabila-alb","body_html":"\u003cp data-start=\"226\" data-end=\"524\" class=\"\"\u003eMIRALUX  aduce iluminarea la un alt nivel – cu un design modern în formă de elemente suprapuse și finisaj negru elegant, această lustră combină eficiența luminii albe (rece, neutra sau calda) cu un spectru complet de culori RGB. Poți seta tonul perfect pentru fiecare moment, direct din telecomandă.\u003c\/p\u003e\u003cp data-start=\"526\" data-end=\"934\" class=\"\"\u003e✔ \u003cstrong data-start=\"528\" data-end=\"561\"\u003eIluminare RGB + alb rece\/ neutru\/ cald\u003c\/strong\u003e – transformă atmosfera dintr-o apăsare de buton.\u003cbr data-start=\"610\" data-end=\"613\"\u003e✔\u003cstrong\u003e 62W\u003c\/strong\u003e\u003cstrong data-start=\"615\" data-end=\"629\"\u003e putere\u003c\/strong\u003e – ideală pentru livinguri, dormitoare sau spații de socializare.\u003cbr data-start=\"694\" data-end=\"697\"\u003e✔ \u003cstrong data-start=\"699\" data-end=\"711\"\u003eDimabilă\u003c\/strong\u003e – ajustezi intensitatea în funcție de nevoile tale.\u003cbr data-start=\"763\" data-end=\"766\"\u003e✔ \u003cstrong data-start=\"768\" data-end=\"809\"\u003eDesign în straturi, culoare negru mat\u003c\/strong\u003e – creează un efect vizual aparte, cu accent contemporan.\u003cbr data-start=\"866\" data-end=\"869\"\u003e✔ \u003cstrong data-start=\"871\" data-end=\"907\"\u003eControl complet prin telecomandă\u003c\/strong\u003e – simplu, rapid, intuitiv.\u003c\/p\u003e\u003cp data-start=\"526\" data-end=\"934\" class=\"\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:43:01+03:00","created_at":"2025-04-14T17:45:30+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428439617803,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT651\/300","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"219.99","position":1,"product_id":10133039612171,"created_at":"2025-09-30T13:57:46+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":56566698344715,"created_at":"2025-06-19T14:38:37+03:00","position":1,"updated_at":"2025-06-19T14:38:41+03:00","product_id":10133039612171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT651300-LustraLEDcutelecomandaMIRALUXRGB_70W_luminaAlbastraReceCalda_Dimabila_Alb-3.png?v=1750333121","width":1024,"height":1024},{"id":56566704603403,"created_at":"2025-06-19T14:39:09+03:00","position":2,"updated_at":"2025-06-19T14:39:13+03:00","product_id":10133039612171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT651300-LustraLEDcutelecomandaMIRALUXRGB_70W_luminaAlbastraReceCalda_Dimabila_Alb-1.png?v=1750333153","width":1024,"height":1024},{"id":56566704275723,"created_at":"2025-06-19T14:39:09+03:00","position":3,"updated_at":"2025-06-19T14:39:13+03:00","product_id":10133039612171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT651300-LustraLEDcutelecomandaMIRALUXRGB_70W_luminaAlbastraReceCalda_Dimabila_Alb-2.png?v=1750333153","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756784034059,"title":"Lustra LED DUOFORM 21W, 3 Patrate, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-duoform-36w-3-patrate-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:44\"\u003e\u003cstrong\u003eEleganță Geometrică și Lumină Adaptabilă\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:307\"\u003eImaginează-ți o infuzie de modernitate subtilă în spațiul tău. Lustra LED DUOFORM aduce un aer contemporan prin designul său minimalist, orchestrat în jurul a trei pătrate albe, perfect echilibrate. Nu este doar un corp de iluminat, ci o declarație de stil discret, care se integrează firesc în orice decor.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:371\"\u003eDincolo de estetica sa curată, această lustră inteligentă îți oferă controlul atmosferei. Cu o putere de 21W, ea emană o lumină eficientă și plăcută, pe care o poți personaliza în funcție de moment. Alege vibrația revigorantă a luminii reci pentru activități dinamice, confortul primitor al luminii calde pentru serile relaxante, sau echilibrul neutru pentru uzul zilnic.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:142\"\u003eLustra LED DUOFORM nu doar iluminează, ci transformă modul în care percepi spațiul, aducând un plus de flexibilitate și rafinament casei tale.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T11:49:32+02:00","created_at":"2025-02-24T11:49:31+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro D