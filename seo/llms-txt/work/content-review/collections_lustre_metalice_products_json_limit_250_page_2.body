neaza functional, ci redefineste modul in care percepi lumina in spatiul tau, oferind un control precis asupra atmosferei si un accent stilistic impecabil.\u003c\/p\u003e\u003cp data-sourcepos=\"10:1-10:179\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-gu10.jpg?v=1747387419\"\u003e\u003c\/p\u003e\u003cp class=\"p1\"\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-12-29T07:19:22+02:00","created_at":"2025-12-18T13:19:11+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre Clasice Moderne","Lustre cu bec","Lustre cu bec moderne","Plafoniere LED"],"variants":[{"id":52771259449611,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC500\/4WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10840416813323,"created_at":"2025-12-18T13:19:11+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63560366391563,"created_at":"2025-12-18T13:33:54+02:00","position":1,"updated_at":"2025-12-18T13:34:16+02:00","product_id":10840416813323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Dec_18_2025_01_33_45_PM.png?v=1766057656","width":1024,"height":1024},{"id":63557290066187,"created_at":"2025-12-18T11:15:13+02:00","position":2,"updated_at":"2026-01-05T05:31:01+02:00","product_id":10840416813323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_d53db0c7-e0e8-47fd-a64d-d781341a9471.png?v=1767583861","width":469,"height":469},{"id":66216044593419,"created_at":"2026-02-22T17:39:17+02:00","position":3,"updated_at":"2026-02-22T17:39:20+02:00","product_id":10840416813323,"va