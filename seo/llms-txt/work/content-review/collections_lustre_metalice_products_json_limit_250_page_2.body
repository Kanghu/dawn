fy.com\/s\/files\/1\/0782\/5175\/3739\/files\/5._Night_Light_c30cf0e3-fe51-4de6-b12e-48b2853d6f3a.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647673099,"created_at":"2026-03-08T01:56:34+02:00","position":7,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6._Size_b643c974-dfce-4f10-8df9-b8974a18e04c.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647771403,"created_at":"2026-03-08T01:56:37+02:00","position":8,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7._Specifications_9988ab41-c179-4cd9-a09f-0d55cf4061df.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647738635,"created_at":"2026-03-08T01:56:37+02:00","position":9,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/10._Detail_3_204279ca-e052-4dad-965e-d6e7cb3b62a6.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647640331,"created_at":"2026-03-08T01:56:32+02:00","position":10,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9._Detail_2_772310e2-4460-426a-bc38-13d80632a8b9.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647968011,"created_at":"2026-03-08T01:56:45+02:00","position":11,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_1_570303fb-4733-4112-94ae-616924d9b380.jpg?v=1775079595","width":3999,"height":3999},{"id":66990648066315,"created_at":"2026-03-08T01:56:46+02:00","position":12,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_aca06ab5-2291-4eaa-9606-edf90ef9a5c1.jpg?v=1775079595","width":3999,"height":3999},{"id":66990647935243,"created_at":"2026-03-08T01:56:45+02:00","position":13,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_d8dcad2e-42bd-4861-af3d-786d0858766d.jpg?v=1775079595","width":3999,"height":3999},{"id":66990648262923,"created_at":"2026-03-08T01:56:46+02:00","position":14,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._Place_2_32e24a99-c4b6-4c19-bd87-645ba37123c0.jpg?v=1775079595","width":3999,"height":3999},{"id":62528572784907,"created_at":"2025-11-20T16:38:46+02:00","position":15,"updated_at":"2026-04-02T00:39:55+03:00","product_id":9759842009355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT210BK_EPREL_804dbe43-94b1-473b-b2d6-1cd9ac95a125.png?v=1775079595","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10976453656843,"title":"Lustra LED Ventilator ANEMO cu Telecomanda, 48W, D87cm, Lumina Rece\/Neutra\/Calda, Metal si Plastic, Alb","handle":"lustra-led-ventilator-anemo-cu-telecomanda-48w-d87cm-lumina-rece-neutra-calda-metal-si-plastic-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003chr\u003e\n\u003cp\u003eTransformă orice încăpere într-un spațiu modern și funcțional cu această lustră LED cu ventilator integrat și telecomandă. Concepută pentru a combina designul elegant cu utilitatea, oferă atât iluminare eficientă, cât și răcire discretă, într-un singur produs compact.\u003c\/p\u003e\n\u003cp\u003eCu un \u003cstrong\u003ediametru de 87 \u003c\/strong\u003ecm și finisaj alb mat, lustra se integrează perfect în interioare contemporane, fie că este vorba de living, dormitor sau birou.\u003c\/p\u003e\n\u003cp\u003eVentilatorul silențios asigură o circulație optimă a aerului, iar iluminarea LED de 47W permite alegerea temperaturii de culoare în funcție de momentul zilei sau atmosferă.\u003c\/p\u003e\n\u003cp\u003eControlul este simplu și rapid datorită telecomenzii incluse, care îți oferă acces la toate funcțiile fără efort.\u003c\/p\u003e✨ \u003cspan style=\"text-decoration: underline;\"\u003e\u003cstrong\u003eBeneficii principale:\u003c\/strong\u003e\u003c\/span\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e2 în 1:\u003c\/strong\u003e iluminare LED + ventilator integrat\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTelecomandă inclusă:\u003c\/strong\u003e control facil al luminii și ventilatorului\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003e3 tipuri de lumină:\u003c\/strong\u003e rece, neutră și caldă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eEficiență energetică:\u003c\/strong\u003e consum redus de doar 48W\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eVentilator silențios:\u003c\/strong\u003e confort fără zgomot\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDesign modern:\u003c\/strong\u003e finisaj alb elegant, potrivit pentru orice decor\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp\u003eAlege această lustră LED cu ventilator pentru un echilibru perfect între estetică, tehnologie și confort zilnic. Ideală pentru cei care își doresc un ambient plăcut, modern și eficient energetic.\u003cstrong\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic_7bd40fac-f842-40eb-8767-5d8091b2a033.webp?v=1777037376\"\u003e\u003c\/p\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0ec16c49-06e2-4a50-a751-a47b07e70ba2.webp?v=1777037375\"\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led_eb01595f-f014-453a-b6b0-e255cf96ad97.webp?v=1777037376\"\u003e\u003c\/div\u003e","published_at":"2026-06-15T14:32:10+03:00","created_at":"2026-06-09T16:43:28+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":53171387105547,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CF103\/8WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"290.99","grams":0,"compare_at_price":"290.99","position":1,"product_id":10976453656843,"created_at":"2026-06-09T16:43:29+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69380359553291,"created_at":"2026-06-09T16:50:03+03:00","position":1,"updated_at":"2026-06-09T16:54:26+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_3_fa116a0d-5b77-46ce-99dd-f411daea0fd8.jpg?v=1781013266","width":1024,"height":1024},{"id":69380359454987,"created_at":"2026-06-09T16:50:03+03:00","position":2,"updated_at":"2026-06-09T16:51:13+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_3_a0677f1b-1b05-4bcd-a418-4d0e83d774d8.jpg?v=1781013073","width":1024,"height":1024},{"id":69380359487755,"created_at":"2026-06-09T16:50:03+03:00","position":3,"updated_at":"2026-06-09T16:52:14+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_3_f4a2830e-f438-4c0b-bcaa-06444197b31f.jpg?v=1781013134","width":2000,"height":2000},{"id":69380359520523,"created_at":"2026-06-09T16:50:03+03:00","position":4,"updated_at":"2026-06-09T16:53:15+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhoto_3_462d32c0-5330-4988-8df1-37182d4b5433.jpg?v=1781013195","width":1024,"height":1024},{"id":69380359061771,"created_at":"2026-06-09T16:49:54+03:00","position":5,"updated_at":"2026-06-09T16:49:58+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_16_49_33.png?v=1781012998","width":1254,"height":1254},{"id":69380359029003,"created_at":"2026-06-09T16:49:54+03:00","position":6,"updated_at":"2026-06-09T16:49:58+03:00","product_id":10976453656843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage9iun.2026_16_48_07.png?v=1781012998","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757937074443,"title":"Lustra LED cu telecomanda si cristal LEILA RGB 69W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-leila-rgb-69w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003ch1 style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003c\/h1\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\" src=\"https:\/\/www.youtube.com\/embed\/y6Uh3jO3oxc?list=PLLgyTjEnUblYjgo5KBGj4gHhPg7l_JqnF\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cem\u003e\u003c\/em\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cem\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte\u003c\/em\u003e\u003cspan style=\"color: rgb(50, 51, 56); font-family: roboto,arial;\"\u003e.\u003c\/span\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T19:39:21+02:00","created_at":"2025-02-24T19:39:20+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429871022347,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT078\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9757937074443,"created_at":"2025-09-30T17:45:48+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":55638650126603,"created_at":"2025-05-21T14:20:32+03:00","position":1,"updated_at":"2025-05-21T14:20:39+03:00","product_id":9757937074443,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-