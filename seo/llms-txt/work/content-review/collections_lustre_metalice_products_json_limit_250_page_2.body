3999},{"id":67092220313867,"created_at":"2026-03-09T23:56:34+02:00","position":10,"updated_at":"2026-03-10T00:01:07+02:00","product_id":9757838999819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12._Place_2_037c3e3c-a9da-4c30-a527-90a58d3e253b.jpg?v=1773093667","width":3999,"height":3999},{"id":67092220346635,"created_at":"2026-03-09T23:56:35+02:00","position":11,"updated_at":"2026-03-10T00:01:07+02:00","product_id":9757838999819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_1_0a63ea1a-2eee-497f-b04b-a52fc7507db6.jpg?v=1773093667","width":3999,"height":3999},{"id":67092220215563,"created_at":"2026-03-09T23:56:31+02:00","position":12,"updated_at":"2026-03-10T00:01:07+02:00","product_id":9757838999819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_9179337a-d9e2-4e91-96dd-63f442fd20be.jpg?v=1773093667","width":3999,"height":3999},{"id":67092220018955,"created_at":"2026-03-09T23:56:29+02:00","position":13,"updated_at":"2026-03-10T00:01:07+02:00","product_id":9757838999819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_ae6784fb-a0b0-43aa-b0c6-17ac8b49e46b.jpg?v=1773093667","width":3999,"height":3999},{"id":63977396764939,"created_at":"2025-12-30T15:54:24+02:00","position":14,"updated_at":"2026-03-10T00:01:07+02:00","product_id":9757838999819,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT233BK_EPREL.png?v=1773093667","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760455328011,"title":"Lustra LED cu telecomanda si cristal QUADRIS 41W, 2 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-cristal-quadris-41w-2-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003e\u003cstrong\u003eLustra LED QUADRIS, de 41W\u003c\/strong\u003e, îmbină un design geometric modern cu funcționalitate inteligentă, având o structură compusă din două pătrate elegante și un finisaj alb luminos. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eAceastă lustră oferă o iluminare adaptabilă, permițând alegerea între lumină \u003cstrong\u003erece\u003c\/strong\u003e, \u003cstrong\u003ecaldă \u003c\/strong\u003esau \u003cstrong\u003eneutră\u003c\/strong\u003e, pentru a se potrivi diferitelor momente și activități. Datorită funcției de dimare, intensitatea luminii poate fi ajustată cu ușurință prin intermediul telecomenzii incluse, oferindu-ți controlul asupra atmosferei din cameră. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eDesignul său minimalist cu cele două pătrate albe adaugă un aer curat și contemporan oricărui interior, fiind ideală pentru dormitoare, birouri sau alte spații în care se dorește o lumină plăcută și un element de design discret și stilat. \u003cstrong\u003ePuterea de 41W\u003c\/strong\u003e asigură o iluminare eficientă și economică, perfectă pentru a crea o ambianță confortabilă.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:32:48+02:00","created_at":"2025-02-25T02:32:47+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52371309789451,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT076\/2WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9760455328011,"created_at":"2025-09-15T15:41:38+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51849565995275,"created_at":"2025-02-25T02:32:51+02:00","position":1,"updated_at":"2025-02-25T02:32:52+02:00","product_id":9760455328011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-magnas-52w-dimabila-alb-1695718992.webp?v=1740443572","width":900,"height":900},{"id":51849566748939,"created_at":"2025-02-25T02:32:51+02:00","position":2,"updated_at":"2025-07-14T14:32:04+03:00","product_id":9760455328011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda_6042-2dwh_cr_06-1695718994.webp?v=1752492724","width":900,"height":900},{"id":51849566814475,"created_at":"2025-02-25T02:32:51+02:00","position":3,"updated_at":"2025-07-14T14:32:04+03:00","product_id":9760455328011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda_6042-2dwh_cr_02-1695718992.webp?v=1752492724","width":900,"height":900},{"id":51849565700363,"created_at":"2025-02-25T02:32:51+02:00","position":4,"updated_at":"2025-07-14T14:32:04+03:00","product_id":9760455328011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda_6042-2dwh_cr_03-1695718993.webp?v=1752492724","width":900,"height":900},{"id":51849566093579,"created_at":"2025-02-25T02:32:51+02:00","position":5,"updated_at":"2025-07-14T14:32:04+03:00","product_id":9760455328011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda_6042-2dwh_cr_05-1695718993.webp?v=1752492724","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10153179283723,"title":"Lustra LED cu telecomanda FLUIRA, 52W, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-fluira-52w-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:79\"\u003e\u003cstrong\u003eUn Accent de Modernitate și Control Luminos Personalizat: Lustra LED FLUIRA\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:234\"\u003eTransformă-ți spațiul cu eleganța minimalistă și funcționalitatea inteligentă a lustrei LED FLUIRA. Designul său contemporan, definit de linii curate și o nuanță \u003cstrong\u003eneagră\u003c\/strong\u003e sofisticată, aduce un aer modern și stilat în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:194\"\u003eCu o putere eficientă de \u003cstrong\u003e52W\u003c\/strong\u003e, lustra FLUIRA oferă o iluminare versatilă, adaptabilă oricărei nevoi. Explorează spectrul complet de lumină cu cele \u003cstrong\u003etrei temperaturi de culoare\u003c\/strong\u003e disponibile:\u003c\/p\u003e\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:82\"\u003e\n\u003cstrong\u003eAlb rece:\u003c\/strong\u003e Stimulant și ideal pentru a spori concentrarea în zonele de lucru.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:107\"\u003e\n\u003cstrong\u003eAlb cald:\u003c\/strong\u003e Primitor și relaxant, perfect pentru a crea o atmosferă confortabilă în zonele de relaxare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eAlb neutru:\u003c\/strong\u003e Echilibrat și versatil, potrivit pentru iluminatul general al casei.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"13:1-13:231\"\u003e\u003cstrong\u003eTelecomanda inclusă\u003c\/strong\u003e îți oferă puterea de a modela lumina după preferințele tale. Ajustează intensitatea cu funcția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, creând o ambianță luminoasă vibrantă sau o lumină ambientală subtilă, totul cu o simplă atingere.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:58\"\u003e\u003cstrong\u003eGILDIS: Simplitate elegantă, control luminos intuitiv.\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"17:1-17:29\"\u003e\u003cstrong\u003eCaracteristici Esențiale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"19:1-25:0\"\u003e\n\u003cli data-sourcepos=\"19:1-19:73\"\u003e\n\u003cstrong\u003eDesign Minimalist Modern:\u003c\/strong\u003e Linii curate și finisaj negru sofisticat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:73\"\u003e\n\u003cstrong\u003eIluminare Adaptabilă (52W):\u003c\/strong\u003e Putere eficientă pentru diverse spații.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-21:77\"\u003e\n\u003cstrong\u003eSpectru Luminos Complet:\u003c\/strong\u003e Alb rece, cald și neutru, pentru orice moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"22:1-22:83\"\u003e\n\u003cstrong\u003eControl Personalizat (Dimmabilă):\u003c\/strong\u003e Ajustează intensitatea luminii cu ușurință.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:78\"\u003e\n\u003cstrong\u003eConfort Inteligent (Telecomandă):\u003c\/strong\u003e Gestionează iluminatul de la distanță.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-25:0\"\u003e\n\u003cstrong\u003eEstetică Versatilă:\u003c\/strong\u003e Se integrează armonios în diverse stiluri de interior.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"26:1-26:24\"\u003e\u003cstrong\u003eBeneficii Resimțite:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"28:1-33:0\"\u003e\n\u003cli data-sourcepos=\"28:1-28:83\"\u003e\n\u003cstrong\u003eAdaptează Lumina Perfect:\u003c\/strong\u003e Creează atmosfera ideală pentru fiecare activitate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-29:82\"\u003e\n\u003cstrong\u003eEleganță Subtilă:\u003c\/strong\u003e Designul minimalist adaugă un plus de stil fără a copleși.\u003c\/li\u003e\n\u003cli data-sourcepos=\"30:1-30:71\"\u003e\n\u003cstrong\u003eControl Fără Efort:\u003c\/strong\u003e Telecomanda face ajustările rapide și comode.\u003c\/li\u003e\n\u003cli data-sourcepos=\"31:1-31:73\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e Te bucuri de lumină optimă cu un consum redus.\u003c\/li\u003e\n\u003cli data-sourcepos=\"32:1-33:0\"\u003e\n\u003cstrong\u003eIntegrare Armonioasă:\u003c\/strong\u003e Se potrivește cu ușurință în decorul existent.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"34:1-34:225\"\u003eLustra LED cu telecomandă FLUIRA nu este doar un corp de iluminat, ci o combinație de design modern și control inteligent, oferindu-ți flexibilitatea de a crea exact lumina de care ai nevoie, cu un stil minimalist și elegant.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T18:15:59+03:00","created_at":"2025-04-28T00:53:19+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52424030650635,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT103BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10153179283723,"created_at":"2025-09-29T13:05:50+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69876285833483,"created_at":"2026-08-04T23:31:00+03:00","position":1,"updated_at":"2026-08-04T23:31:03+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LT103BK.webp?v=1785875463","width":1254,"height":1254},{"id":69876285735179,"created_at":"2026-08-04T23:31:00+03:00","position":2,"updated_at":"2026-08-04T23:31:02+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LT103BK.webp?v=1785875462","width":1000,"height":1000},{"id":69876285899019,"created_at":"2026-08-04T23:31:00+03:00","position":3,"updated_at":"2026-08-04T23:31:02+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LT103BK.webp?v=1785875462","width":1000,"height":1000},{"id":69876285702411,"created_at":"2026-08-04T23:31:00+03:00","position":4,"updated_at":"2026-08-04T23:31:02+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LT103BK.webp?v=1785875462","width":1254,"height":1254},{"id":69876285931787,"created_at":"2026-08-04T23:31:00+03:00","position":5,"updated_at":"2026-08-04T23:31:03+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LT103BK.webp?v=1785875463","width":1254,"height":1254},{"id":69876285866251,"created_at":"2026-08-04T23:31:00+03:00","position":6,"updated_at":"2026-08-04T23:31:02+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LT103BK.webp?v=1785875462","width":1254,"height":1254},{"id":69876285767947,"created_at":"2026-08-04T23:31:00+03:00","position":7,"updated_at":"2026-08-04T23:31:03+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LT103BK.webp?v=1785875463","width":1254,"height":1254},{"id":69876285800715,"created_at":"2026-08-04T23:31:00+03:00","position":8,"updated_at":"2026-08-04T23:31:03+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LT103BK.webp?v=1785875463","width":1254,"height":1254},{"id":69876285964555,"created_at":"2026-08-04T23:31:00+03:00","position":9,"updated_at":"2026-08-04T23:31:02+03:00","product_id":10153179283723,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LT103BK.webp?v=1785875462","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10845263069451,"title":"Lustra LED cu telecomanda si cristal LLC152\/500CH 59W, 50cm, Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-llc152-500ch-59w-50cm-cerc-lumina-rece-calda-neutra-dimabila-auriu","body_html":"\u003cp data-end=\"253\" data-start=\"0\"\u003eLustra LED cu telecomandă și cristal LLC152\/500CH este un corp de iluminat elegant, cu design circular și finisaj crom, conceput pentru interioare moderne cu accente luxoase. Cu o putere de 59W și diametru de 50 cm, oferă iluminare uniformă și plăcută.\u003c\/p\u003e\u003cp data-end=\"253\" data-start=\"0\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"583\" data-start=\"255\"\u003eFuncția dimabilă și telecomanda permit reglarea intensității și a temperaturii de culoare – lumină caldă, neutră sau rece – pentru adaptarea atmosferei în funcție de moment. Elementele din cristal adaugă strălucire și rafinament, transformând lustra într-un accent decorativ sofisticat, ideal pentru living, dining sau dormitor.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-12-31T07:31:09+02:00","created_at":"2025-12-23T13:02:50+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52790790684939,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LLC152\/500CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"559.99","grams":0,"compare_at_price":"559.99","position":1,"product_id":10845263069451,"created_at":"2025-12-23T13:02:51+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":63776940982539,"created_at":"2025-12-23T13:04:25+02:00","position":1,"updated_at":"2025-12-23T13:04:29+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_7da1c23f-bdff-4e61-bcbc-a4fc747495d6.png?v=1766487869","width":800,"height":800},{"id":63776942752011,"created_at":"2025-12-23T13:04:31+02:00","position":2,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H8871b78573ab4bd292e798f23bed4113Y.jpg?v=1766487966","width":800,"height":800},{"id":63776942719243,"created_at":"2025-12-23T13:04:31+02:00","position":3,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H53d03a53da32495caebd6143a9e1491a2.jpg?v=1766487966","width":800,"height":800},{"id":63776942653707,"created_at":"2025-12-23T13:04:30+02:00","position":4,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hd80551fbe53f45d3bf613d750c9dc951H.jpg?v=1766487966","width":800,"height":800},{"id":63776942620939,"created_at":"2025-12-23T13:04:30+02:00","position":5,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ha3e785eddd3443f294071a4548e09da1v.jpg?v=1766487966","width":800,"height":800},{"id":63776942686475,"created_at":"2025-12-23T13:04:30+02:00","position":6,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H78dfcfb8a8e642029dbb3f6cb976a03br.jpg?v=1766487966","width":700,"height":700},{"id":63776940949771,"created_at":"2025-12-23T13:04:25+02:00","position":7,"updated_at":"2025-12-23T13:06:06+02:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_2_25658da9-64fd-4456-b9d1-9bb5d18c4dc1.png?v=1766487966","width":800,"height":800},{"id":68416327647499,"created_at":"2026-04-22T09:50:59+03:00","position":8,"updated_at":"2026-04-22T09:51:02+03:00","product_id":10845263069451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2696761_big_color.svg?v=1776840662","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10223915368715,"title":"Lustra LED suspendata FAUSTO, 83W, lumina Rece\/Calda\/Neutra, Inaltime Reglabila, Auriu","handle":"lustra-led-suspendata-fausto-83w-lumina-rece-calda-neutra-inaltime-reglabila-auriu","body_html":"\u003cp\u003eIlumineaza-ti spatiul cu FAUSTO, lustra LED suspendata care redefineste conceptul de iluminat modern. Cu un design cu doua inele rotunde, finisaj auriu, aceasta piesa este esentiala pentru un living, o bucatarie sau o zona de dining sofisticata.\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Sculptural, Lumina Captivanta:\u003c\/strong\u003e Cele doua inele, cu diametru de 65 cm, pline de 'bule' luminoase din acril, creeaza un efect vizual hipnotizant. Nu e doar o lustra, ci o instalatie artistica ce adauga profunzime si caracter incaperii.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eControl Complet, Atmosfera Personalizata:\u003c\/strong\u003e Beneficiezi de lumina Rece, Calda sau Neutra (3000K, 4000K, 6000K), ajustabila si dimabila.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePutere de Iluminare Impresionanta:\u003c\/strong\u003e Cu 83W si un flux luminos de 6640lm, FAUSTO inunda spatiul cu o lumina abundenta. Este perfect pentru zonele mari, asigurand vizibilitate excelenta si o ambianta primitoare.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eAlege FAUSTO pentru a aduce in casa ta nu doar o sursa de lumina, ci o experienta de iluminat inteligenta si un element de design care va impresiona.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\u003cp\u003e \u003c\/p\u003e","published_at":"2025-06-23T16:16:45+03:00","created_at":"2025-06-06T16:16:55+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428749472011,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT370\/60X30GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"1159.99","grams":0,"compare_at_price":"1299.99","position":1,"product_id":10223915368715,"created_at":"2025-09-30T15:28:25+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":59615837618443,"created_at":"2025-08-28T17:54:04+03:00","position":1,"updated_at":"2025-08-28T17:59:44+03:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_46f27329-977d-40a2-abb0-306832f9f4b6.jpg?v=1756393184","width":800,"height":800},{"id":59615872680203,"created_at":"2025-08-28T17:58:54+03:00","position":2,"updated_at":"2025-08-28T17:59:44+03:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_bbba092c-f8eb-4cb2-920d-3721216d755c.png?v=1756393184","width":1996,"height":2024},{"id":59615837815051,"created_at":"2025-08-28T17:54:04+03:00","position":3,"updated_at":"2025-08-28T17:59:44+03:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_3407dde5-f13f-4f25-80d7-5dbdbf7414af.jpg?v=1756393184","width":800,"height":800},{"id":59615837782283,"created_at":"2025-08-28T17:54:04+03:00","position":4,"updated_at":"2025-08-28T17:59:44+03:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_1bdc6dcd-814c-42ee-a362-66e72f37dbb4.jpg?v=1756393184","width":800,"height":800},{"id":59615838273803,"created_at":"2025-08-28T17:54:08+03:00","position":5,"updated_at":"2025-08-28T17:54:12+03:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_9228b155-a73c-4182-8ba2-090a2b508a5e.png?v=1756392852","width":800,"height":800},{"id":62782906401035,"created_at":"2025-11-27T16:02:20+02:00","position":6,"updated_at":"2025-11-27T16:02:23+02:00","product_id":10223915368715,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT370_60X30GD_PREL.png?v=1764252143","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10179187769611,"title":"Lustra LED suspendata cu telecomanda si cristal MIA Yonca, 34W, 1 Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-mia-latifah-34w-1-cerc-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:298\"\u003eLustra LED suspendată cu telecomandă și cristale MIA Yonca este o piesă de iluminat modernă și elegantă, cu un finisaj crom lucios care îi conferă un aspect strălucitor și contemporan. Cu o putere de 34W și un design format din două cercuri, aduce un plus de lumină și rafinament în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:501\"\u003eCele două cercuri ale lustrei sunt decorate cu cristale transparente, care reflectă și refractă lumina LED integrată, creând un efect vizual captivant și o atmosferă sofisticată. Telecomanda inclusă îți oferă control total asupra iluminării: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-11T13:30:36+03:00","created_at":"2025-05-14T22:02:40+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52424468627723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT023\/1","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"349.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":10179187769611,"created_at":"2025-09-29T15:56:19+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":55441312022795,"created_at":"2025-05-14T22:16:28+03:00","position":1,"updated_at":"2025-05-14T22:16:35+03:00","product_id":10179187769611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT023_1-LustraLEDsuspendatacutelecomandasicristalLATIFAH_70W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-3.png?v=1747250195","width":1080,"height":1080},{"id":51833445777675,"created_at":"2025-02-24T23:56:38+02:00","position":2,"updated_at":"2025-05-14T22:16:35+03:00","product_id":10179187769611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-latifah-118w-argintiu_1752_04.webp?v=1747250195","width":900,"height":900},{"id":55441309729035,"created_at":"2025-05-14T22:16:18+03:00","position":3,"updated_at":"2025-05-14T22:16:35+03:00","product_id":10179187769611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/close-up-AT1CT-CH1A-HT2L-LT023_1-LustraLEDsuspendatacutelecomandasicristalLATIFAH_70W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-1.png?v=1747250195","width":1080,"height":1080},{"id":55441312088331,"created_at":"2025-05-14T22:16:28+03:00","position":4,"updated_at":"2025-05-14T22:16:35+03:00","product_id":10179187769611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT023_1-LustraLEDsuspendatacutelecomandasicristalLATIFAH_70W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-2.png?v=1747250195","width":1080,"height":1080},{"id":63330445492491,"created_at":"2025-12-12T14:35:42+02:00","position":5,"updated_at":"2025-12-12T14:35:46+02:00","product_id":10179187769611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT023_1_EPREL.png?v=1765542946","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757387456779,"title":"Lustra LED cu telecomanda  LILY 101W, 9 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lily-101w-9-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e \u003cspan\u003eLustra LED cu telecomandă LILY, de 101W, este o piesă de iluminat elegantă și modernă, cu un design inspirat de grația florii de crin, având nouă elemente stilizate care sugerează petale delicate, toate într-un finisaj alb imaculat. \u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003eAceastă lustră nu doar iluminează, ci adaugă și un aer sofisticat și luminos oricărui interior. Prin telecomanda inclusă, poți alege cu ușurință temperatura de culoare potrivită dintre rece, caldă sau neutră, adaptând lumina la atmosfera dorită sau la activitățile tale. \u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003eFuncția de dimare îți oferă controlul asupra intensității luminii, permițându-ți să creezi ambianța perfectă pentru fiecare moment. \u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003eDesignul său floral stilizat și culoarea albă pură o fac ideală pentru livinguri, dormitoare sau alte spații în care se dorește un iluminat plăcut și un element de design rafinat și luminos. Cu o putere de 101W, asigură o iluminare amplă și eficientă a spațiului.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:09:20+02:00","created_at":"2025-02-24T16:09:19+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52342357328139,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT230\/9WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9757387456779,"created_at":"2025-09-08T15:32:30+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":51815228801291,"created_at":"2025-02-24T16:09:21+02:00","position":1,"updated_at":"2025-02-24T16:09:23+02:00","product_id":9757387456779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-voaiaj-180w-dimabila-alb_LL1797AL_01.webp?v=1740406163","width":900,"height":900},{"id":51815228768523,"created_at":"2025-02-24T16:09:21+02:00","position":2,"updated_at":"2025-02-24T16:09:23+02:00","product_id":9757387456779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-voaiaj-180w-dimabila-alb_LL1797AL_02.webp?v=1740406163","width":900,"height":900},{"id":64445068771595,"created_at":"2026-01-16T15:12:14+02:00","position":3,"updated_at":"2026-01-16T15:12:17+02:00","product_id":9757387456779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT230_9WH_EPREL.png?v=1768569137","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758288609547,"title":"Lustra LED suspendata cu telecomanda WAVE 89W, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-wave-89w-liniara-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:207\"\u003eAceastă lustră LED cu telecomandă WAVE, de 89W și culoare neagră, aduce un design modern și o iluminare versatilă în locuința ta. Cele 4 cercuri luminoase interconectate creează un aspect dinamic și elegant.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-15:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:88\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 76W, asigurând o iluminare eficientă și luminoasă pentru diverse încăperi.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:82\"\u003e\n\u003cstrong\u003eDesign modern:\u003c\/strong\u003e Patru cercuri negre interconectate, oferind un aspect stilat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:116\"\u003e\n\u003cstrong\u003eTip de lumină reglabil:\u003c\/strong\u003e Poți alege între lumină rece, caldă sau neutră, adaptând atmosfera preferințelor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:122\"\u003e\n\u003cstrong\u003eDimabilă:\u003c\/strong\u003e Intensitatea luminii este reglabilă cu ajutorul telecomenzii incluse, permițând crearea ambientului dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:138\"\u003e\n\u003cstrong\u003eÎnălțime reglabilă:\u003c\/strong\u003e Oferă flexibilitate în ajustarea poziției lămpii în funcție de înălțimea tavanului și de necesitățile spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:230\"\u003e\n\u003cstrong\u003eControl prin telecomandă:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea luminii de la distanță. Lustra poate fi controlată și prin intermediul întrerupătorului clasic (schimbarea modului de iluminare prin apăsări succesive).\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:97\"\u003e\n\u003cstrong\u003eFlux luminos optim:\u003c\/strong\u003e Oferă o cantitate adecvată de lumină pentru a ilumina eficient spațiul.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-12:83\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"13:1-13:83\"\u003e\n\u003cstrong\u003eMateriale de calitate:\u003c\/strong\u003e Construcție solidă pentru o utilizare de lungă durată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-15:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu instrucțiuni clare pentru o montare simplă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"16:1-16:224\"\u003eAceastă lustră LED WAVE este o alegere excelentă pentru cei care caută un corp de iluminat modern, funcțional și cu posibilitatea de a personaliza iluminatul în funcție de necesități, adăugând un plus de stil locuinței tale.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-15:0\"\u003e\u003c\/ul\u003e\u003cp data-sourcepos=\"16:1-16:224\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:207\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:09:01+02:00","created_at":"2025-02-24T21:09:01+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52428102107403,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT100