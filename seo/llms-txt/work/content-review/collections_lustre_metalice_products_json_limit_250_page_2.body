"featured_image":null,"available":true,"price":"109.99","grams":0,"compare_at_price":"109.99","position":1,"product_id":10977630814475,"created_at":"2026-06-11T10:08:33+03:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":69413419090187,"created_at":"2026-06-11T10:11:24+03:00","position":1,"updated_at":"2026-06-11T10:20:10+03:00","product_id":10977630814475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL728.png?v=1781162410","width":1024,"height":1024},{"id":69413439078667,"created_at":"2026-06-11T10:12:11+03:00","position":2,"updated_at":"2026-06-11T10:22:28+03:00","product_id":10977630814475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL728_46a9a8ee-9f55-4a98-832f-c3a88b31df7a.png?v=1781162548","width":1024,"height":1024},{"id":69413441470731,"created_at":"2026-06-11T10:12:18+03:00","position":3,"updated_at":"2026-06-11T10:30:04+03:00","product_id":10977630814475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL728_19b3d122-1fae-45b1-9794-7f947046432e.png?v=1781163004","width":1024,"height":1024},{"id":69413986599179,"created_at":"2026-06-11T10:30:54+03:00","position":4,"updated_at":"2026-06-11T10:30:59+03:00","product_id":10977630814475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage11iun.2026_10_16_18.png?v=1781163059","width":1254,"height":1254},{"id":69413986631947,"created_at":"2026-06-11T10:30:54+03:00","position":5,"updated_at":"2026-06-11T10:30:58+03:00","product_id":10977630814475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage11iun.2026_10_16_27.png?v=1781163058","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10977633534219,"title":"Lustra LED RENATO Nobile cu telecomanda si cristal,  39W, 3 Patrate, Lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-renato-cu-telecomanda-si-cristal-39w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"5:1-5:294\"\u003eTransformă-ți spațiul într-un spectacol de lumină și culoare cu \u003cstrong\u003elustra LED RENATO Nobile\u003c\/strong\u003e. Designul său contemporan, cu elemente rectangulare elegante în finisaj \u003cstrong\u003ealb\u003c\/strong\u003e, este completat de o putere impresionantă de \u003cstrong\u003e39W\u003c\/strong\u003e, oferind o iluminare amplă și eficientă pentru încăperi mari.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:199\"\u003eDatorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Funcția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii pentru a crea ambientul perfect pentru orice ocazie.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:252\"\u003ePersonalizează iluminatul în funcție de starea ta de spirit, eveniment sau preferințe, de la tonuri calde și relaxante la culori vibrante și energizante.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:78\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Elemente rectangulare în finisaj alb.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:75\"\u003e\n\u003cstrong\u003ePutere Impresionantă:\u003c\/strong\u003e 39W pentru o iluminare amplă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și al culorilor\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:92\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj alb elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Dinamic:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cstrong\u003eLustra LED cu telecomandă RENATO Nobile\u003c\/strong\u003e este alegerea ideală pentru a adăuga un plus de stil, confort și culoare în spațiile mari. Bucură-te de iluminarea puternică și adaptabilă, completată de spectrul vibrant al culorilor sale.\u003c\/p\u003e\u003cp data-sourcepos=\"29:1-29:220\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2026-06-16T14:44:34+03:00","created_at":"2026-06-11T10:32:21+03:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","ciresar","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":53175518953739,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT765\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"269.99","grams":0,"compare_at_price":"269.99","position":1,"product_id":10977633534219,"created_at":"2026-06-11T10:32:21+03:00","upda