175\/3739\/files\/banner_20m2_generic.webp?v=1771577284\"\u003e\u003c\/p\u003e","published_at":"2026-02-22T21:06:10+02:00","created_at":"2026-02-19T12:33:33+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52910753775883,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT755\/3BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10888258486539,"created_at":"2026-02-19T12:33:33+02:00","updated_at":"2026-09-14T13:12:17+03:00"}],"images":[{"id":65971382550795,"created_at":"2026-02-18T13:24:44+02:00","position":1,"updated_at":"2026-03-23T13:55:38+02:00","product_id":10888258486539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT755_3BKpic2.png?v=1774266938","width":1500,"height":1500},{"id":65971382518027,"created_at":"2026-02-18T13:24:44+02:00","position":2,"updated_at":"2026-02-20T10:43:08+02:00","product_id":10888258486539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT755_3BKpic1.png?v=1771576988","width":3680,"height":2456},{"id":68426096541963,"created_at":"2026-04-22T14:43:30+03:00","position":3,"updated_at":"2026-04-22T14:43:33+03:00","product_id":10888258486539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2699068_big_color.svg?v=1776858213","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760900186379,"title":"Lustra LED cu Telecomanda, Suspendata AMI 63W, Liniara, lumina Rece\/Calda\/Neutra, Auriu, Inaltime Reglabila","handle":"lustra-led-cu-telecomanda-suspendata-ami-63w-liniara-lumina-rece-calda-neutra-auriu-inaltime-reglabila","body_html":"\u003cp\u003e\u003cstrong\u003eLustra LED cu Telecomandă AMI 63W, Liniară, Auriu\u003c\/strong\u003e este un corp de iluminat modern, cu design minimalist și formă liniară, potrivit pentru living, dining sau bucătărie. Finisajul auriu oferă un aspect elegant și ușor de integrat în interioare contemporane.\u003c\/p\u003e\u003cp\u003eCu o putere de 63W, asigură iluminare eficientă și uniformă. Dispune de trei temperaturi de culoare – lumină rece, neutră și caldă – selectabile prin telecomandă, pentru adaptarea atmosferei în funcție de momentul zilei.\u003c\/p\u003e\u003cp\u003eModelul este prevăzut cu înălțime reglabilă, permițând ajustarea în funcție de spațiu și preferințe. Dimensiuni: lungime 120 cm, lățime 24 cm. Tehnologia LED integrată oferă consum redus și durată de viață extinsă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:236\"\u003e\u003cimg\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_0b38953e-6df8-4961-a1b4-2f466d0e92f6.webp?v=1772544229\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:236\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:46:40+02:00","created_at":"2025-02-25T03:46:38+02:00","updated_at":"2026-09-14T13:12:17+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52414432510219,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL150","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"price":"659.99","grams":0,"compare_at_price":"659.99","position":1,"product_id":976