38:28+02:00","product_id":9756791177483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5._Detail_1_f7dfb564-defe-40f8-9ca4-c6062a1d514c.jpg?v=1773113908","width":3999,"height":3999},{"id":67093611217163,"created_at":"2026-03-10T05:35:29+02:00","position":8,"updated_at":"2026-03-10T05:38:28+02:00","product_id":9756791177483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9._Place_2_5e68599b-7a53-45c0-bf77-560a86bf3f98.jpg?v=1773113908","width":3999,"height":3999},{"id":67093611610379,"created_at":"2026-03-10T05:35:31+02:00","position":9,"updated_at":"2026-03-10T05:38:28+02:00","product_id":9756791177483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_4_9e7ead5e-05a3-4f71-a8c8-161ac389222c.jpg?v=1773113908","width":3999,"height":3999},{"id":67093611315467,"created_at":"2026-03-10T05:35:30+02:00","position":10,"updated_at":"2026-03-10T05:38:28+02:00","product_id":9756791177483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/10._Place_3_6f3f9a9c-8d87-4181-b1d6-fd12a0ddc41a.jpg?v=1773113908","width":3999,"height":3999},{"id":69785268781323,"created_at":"2026-07-20T13:52:37+03:00","position":11,"updated_at":"2026-07-20T13:52:39+03:00","product_id":9756791177483,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2470882_big_color.png?v=1784544759","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757681418507,"title":"Lustra LED cu telecomanda LILY 86W, 5 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-lily-86w-5-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:339\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_40c6e3cf-a9fb-4043-9aca-60da2e019a1f.png?v=1778460359\" alt=\"\"\u003eLustra LED cu telecomandă LILY este o sursă de lumină modernă și adaptabilă, ideală pentru a aduce un plus de stil și funcționalitate în locuința ta. Cu o putere de 86W, această lustră dispune de 5 elemente de design în nuanța albă, a căror formă specifică  contribuie la aspectul său unic.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:451\"\u003eDatorită tehnologiei LED integrate, beneficiezi de o iluminare eficientă energetic și de lungă durată. Telecomanda inclusă îți oferă un control facil asupra atmosferei din cameră, permițându-ți să alegi între lumină rece (pentru o ambianță energizantă), lumină caldă (pentru momente de relaxare) sau lumină neutră (pentru iluminarea generală). Funcția de dimare îți dă posibilitatea de a regla intensitatea luminii, adaptând-o perfect oricărei ocazii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:243\"\u003eFinisajul alb al elementelor conferă lustrei un aspect curat și luminos, integrându-se armonios în diverse stiluri de decor interior. Designul cu 5 elemente creează un punct focal interesant și asigură o distribuție optimă a luminii în spațiu.\u003c\/p\u003e","published_at":"2025-02-24T17:41:46+02:00","created_at":"2025-02-24T17:41:46+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428744917259,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT230\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9757681418507,"created_at":"2025-09-30T15:26:15+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":68821717483787,"created_at":"2026-05-11T03:45:44+03:00","position":1,"updated_at":"2026-05-11T03:45:50+03:00","product_id":9