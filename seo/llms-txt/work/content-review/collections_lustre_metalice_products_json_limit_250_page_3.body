745\" data-start=\"509\"\u003ePuterea de 66W oferă o lumină amplă și eficientă, ajustabilă în intensitate și temperatură (rece, caldă sau neutră), controlată cu ușurință prin telecomandă. Finisajul alb adaugă prospețime vizuală, ideal pentru interioare contemporane.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:28:17+03:00","created_at":"2025-04-14T15:24:56+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","NOSINC"],"variants":[{"id":52372595212555,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT631\/500R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10132422164747,"created_at":"2025-09-16T01:08:34+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59083633197323,"created_at":"2025-08-13T16:54:08+03:00","position":1,"updated_at":"2025-08-13T16:54:22+03:00","product_id":10132422164747,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H3c61bb8361dc4638a4d50505cdbed7cdn.jpg?v=1755093262","width":800,"height":800},{"id":59083633295627,"created_at":"2025-08-13T16:54:08+03:00","position":2,"updated_at":"2025-08-13T16:54:2