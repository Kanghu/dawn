rong\u003e aduce un plus de dinamism și stil în orice spațiu modern. Cele 3 cercuri interconectate creează un joc vizual elegant, susținut de finisajul negru mat și de funcționalități avansate.\u003c\/p\u003e\u003cp data-start=\"485\" data-end=\"777\" class=\"\"\u003eCu o putere de 51W și tehnologie LED eficientă, lustra oferă iluminare versatilă în trei nuanțe (rece, caldă, neutră), ajustabilă în intensitate prin telecomanda inclusă. Ideală pentru living, dining sau spații cu tavan înalt, \u003cstrong data-start=\"713\" data-end=\"725\"\u003eSERPENTA  \u003c\/strong\u003ecombină designul curajos cu confortul personalizat.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:35:37+03:00","created_at":"2025-04-15T00:34:35+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428101452043,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT640\/500R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10133854519563,"created_at":"2025-09-30T12:27:31+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59074749726987,"created_at":"2025-08-13T10:13:43+03:00","p