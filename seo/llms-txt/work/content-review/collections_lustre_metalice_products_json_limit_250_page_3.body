null,"sku":"AT1CT-IM1P-HT2L-LT173\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":10240952959243,"created_at":"2025-09-30T17:47:31+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56490733928715,"created_at":"2025-06-17T10:52:12+03:00","position":1,"updated_at":"2025-06-17T10:52:14+03:00","product_id":10240952959243,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/black-LT173_5WH-LustraLEDcuTelecomandaGIO_90W_5Elemente_LuminaRece_Clada_Neutra_Dimabila_Alb.jpg?v=1750146734","width":1080,"height":1080},{"id":56490734223627,"created_at":"2025-06-17T10:52:12+03:00","position":2,"updated_at":"2025-06-17T10:52:15+03:00","product_id":10240952959243,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT173_5WH-LustraLEDcuTelecomandaGIO_90W_5Elemente_LuminaRece_Clada_Neutra_Dimabila_Alb_2.jpg?v=1750146735","width":1080,"height":1080},{"id":56490734059787,"created_at":"2025-06-17T10:52:12+03:00","position":3,"updated_at":"2025-06-17T10:52:14+03:00","product_id":10240952959243,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT173_5WH-LustraLEDcuTelecomandaGIO_90W_5Elemente_LuminaRece_Clada_Neutra_Dimabila_Alb.jpg?v=1750146734","width":1080,"height":1080},{"id":68094469374219,"created_at":"2026-04-06T12:07:35+03:00","position":4,"updated_at":"2026-04-06T12:07:37+03:00","product_id":10240952959243,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/black-LT173_5WH-LustraLEDcuTelecomandaGIO_90W_5Elemente_LuminaRece_Clada_Neutra_Dimabila_Alb.webp?v=1775466457","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10633371025675,"title":"Lustra LED MARINE 42W, Diametru 38cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-marine-42w-diametru-38cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-start=\"0\" data-end=\"329\"\u003e\u003cstrong\u003eLustra LED MARINE\u003c\/strong\u003e este o soluție de iluminat compactă și versatilă, ideală pentru spații moderne care necesită funcționalitate și design curat. Cu un diametru de \u003cstrong\u003e38cm\u003c\/strong\u003e și un finisaj alb mat, se integrează perfect în camere de zi, dormitoare, holuri sau birouri.\u003c\/p\u003e\u003cp data-start=\"331\" data-end=\"518\"\u003eEchipată cu LED integrat de \u003cstrong\u003e42W\u003c\/strong\u003e, permite schimbarea temperaturii de culoare între \u003cstrong\u003erece \u003c\/strong\u003e(6000K), \u003cstrong\u003eneutră \u003c\/strong\u003e(4000K) și \u003cstrong\u003ecaldă \u003c\/strong\u003e(3000K), oferind flexibilitate maximă în crearea atmosferei dorite.\u003c\/p\u003e\u003cp data-start=\"520\" data-end=\"773\"\u003e\u003cstrong data-start=\"520\" data-end=\"550\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003cbr data-start=\"550\" data-end=\"553\"\u003e– Design minimalist, finisaj alb elegant\u003cbr data-start=\"593\" data-end=\"596\"\u003e– Putere 42W, eficiență energetică ridicată\u003cbr data-start=\"639\" data-end=\"642\"\u003e– Temperaturi de culoare selectabile: rece \/ neutră \/ caldă\u003cbr data-start=\"701\" data-end=\"704\"\u003e– Dimensiune compactă: Ø38 cm\u003cbr data-start=\"733\" data-end=\"736\"\u003e– Iluminare uniformă, fără pâlpâiri\u003c\/p\u003e\u003cp data-start=\"775\" data-end=\"889\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eLustra MARINE este alegerea ideală pentru un iluminat eficient și discret, adaptabil oricărui ambient contemporan.\u003c\/p\u003e\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-07-18T10:32:20+03:00","created_at":"2025-07-18T10:26:40+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","BLACKSEASON","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","IULIE25","Lustre Copii","Lustre LED"],"variants":[{"id":52369469473035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT129BL","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":10633371025675,"created_at":"2025-09-14T20:16:51+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57444547592459,"created_at":"2025-07-18T10:30:18+03:00","position":1,"updated_at":"2025-07-18T10:32:21+03:00","product_id":10633371025675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/b306074f-c466-45f6-b873-5eb793fa0f0e.png?v=1752823941","width":1920,"height":1920},{"id":57444547068171,"created_at":"2025-07-18T10:30:14+03:00","position":2,"updated_at":"2025-07-18T10:32:21+03:00","product_id":10633371025675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/252b9d25-de7b-4859-9164-bb59edb130d6.png?v=1752823941","width":1579,"height":1579}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10666915365131,"title":"Lustra LED Palius 48W Negru, 4 Brate","handle":"lustra-led-palius-48w-negru","body_html":"\u003cp data-start=\"181\" data-end=\"392\"\u003eAdaugă un accent modern și rafinat în orice cameră cu lustra LED \u003cstrong data-start=\"246\" data-end=\"260\"\u003ePalius 48W\u003c\/strong\u003e. Designul său minimalist, în combinație cu finisajul \u003cstrong data-start=\"314\" data-end=\"346\"\u003enegru mat și detaliile aurii\u003c\/strong\u003e, oferă un aspect sofisticat și contemporan.\u003c\/p\u003e\u003cp data-start=\"394\" data-end=\"555\"\u003eCele \u003cstrong data-start=\"399\" data-end=\"420\"\u003e4 brațe reglabile\u003c\/strong\u003e asigură o distribuție uniformă a luminii, creând un ambient plăcut atât în living, dormitor, cât și în spațiile de dining sau birou.\u003c\/p\u003e\u003cp data-start=\"557\" data-end=\"731\"\u003eFiind echipată cu \u003cstrong data-start=\"575\" data-end=\"600\"\u003etehnologie LED de 48W\u003c\/strong\u003e, lustra Palius este eficientă energetic, durabilă și oferă o lumină puternică și confortabilă, ideală pentru utilizarea zilnică.\u003c\/p\u003e\u003cp data-start=\"733\" data-end=\"922\"\u003e✔️ \u003cstrong data-start=\"736\" data-end=\"746\"\u003ePutere\u003c\/strong\u003e: 48W LED\u003cbr data-start=\"755\" data-end=\"758\"\u003e✔️ \u003cstrong data-start=\"761\" data-end=\"771\"\u003eDesign\u003c\/strong\u003e: modern, negru cu accente aurii\u003cbr data-start=\"803\" data-end=\"806\"\u003e✔️ \u003cstrong data-start=\"809\" data-end=\"818\"\u003eBrațe\u003c\/strong\u003e: 4 brațe pentru iluminare uniformă\u003cbr data-start=\"853\" data-end=\"856\"\u003e✔️ \u003cstrong data-start=\"859\" data-end=\"869\"\u003eMontaj\u003c\/strong\u003e: aplicat pe tavan\u003cbr data-start=\"887\" data-end=\"890\" data-is-only-node=\"\"\u003e✔️ \u003cstrong data-start=\"893\" data-end=\"920\"\u003eConsum redus de energie\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-start=\"924\" data-end=\"1009\"\u003eEleganță, funcționalitate și durabilitate – toate într-o singură piesă de iluminat.\u003c\/p\u003e","published_at":"2025-08-19T21:42:42+03:00","created_at":"2025-08-11T16:51:27+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"","tags":["active","Corpuri de Iluminat","Lustre LED"],"variants":[{"id":52429133152523,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL355","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":10666915365131,"created_at":"2025-09-30T15:56:06+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59863078174987,"created_at":"2025-09-04T10:44:32+03:00","position":1,"updated_at":"2025-09-04T10:49:02+03:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_ff44ac9a-d04a-4ca0-901f-ac8e8d4131be.png?v=1756972142","width":1500,"height":1500},{"id":59863078142219,"created_at":"2025-09-04T10:44:32+03:00","position":2,"updated_at":"2025-09-04T10:49:02+03:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/A_5c2b1bd8-2cb0-4041-9fa1-64c5791cf3ea.png?v=1756972142","width":1500,"height":1500},{"id":59863078240523,"created_at":"2025-09-04T10:44:32+03:00","position":3,"updated_at":"2025-09-04T10:49:02+03:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_aa2eaf37-c528-4d87-bfd8-2b1e680a6c03.png?v=1756972142","width":1500,"height":1500},{"id":59863078207755,"created_at":"2025-09-04T10:44:32+03:00","position":4,"updated_at":"2025-09-04T10:49:02+03:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_a6ba1962-3e24-46a2-90fd-9ebb12e6865d.png?v=1756972142","width":1500,"height":1500},{"id":66226365759755,"created_at":"2026-02-22T20:35:04+02:00","position":5,"updated_at":"2026-02-22T20:35:07+02:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LL355.webp?v=1771785307","width":1500,"height":1500},{"id":70066974884107,"created_at":"2026-09-08T13:04:35+03:00","position":6,"updated_at":"2026-09-08T13:04:37+03:00","product_id":10666915365131,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2842918_big_color.png?v=1788861877","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10668871385355,"title":"Lustra LED suspendata cu telecomanda, Cristale K9, 73W, 2 Cerc, 60 cm, lumina Rece\/Calda\/Neutra, Dimabila, Auriu, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-cristale-k9-73w-2-cerc-60-cm-lumina-rece-calda-neutra-dimabila-auriu-inaltime-reglabila","body_html":"\u003cp\u003eTransformă orice încăpere într-un spațiu elegant și modern cu această lustra LED suspendată cu design contemporan în \u003cstrong\u003edouă cercuri suprapuse\u003c\/strong\u003e, finisaj auriu și inserții din \u003cstrong\u003ecristale K9 premium\u003c\/strong\u003e. Combinația dintre liniile minimaliste și reflexiile spectaculoase ale cristalelor creează un efect vizual sofisticat, potrivit atât pentru locuințe moderne, cât și pentru spații comerciale rafinate.\u003c\/p\u003e\u003ch3\u003e✨ Design premium cu cristale K9\u003c\/h3\u003e\u003cp\u003eCristalele K9 sunt recunoscute pentru claritatea și transparența lor superioară, oferind reflexii intense și un joc spectaculos de lumină. Finisajul auriu adaugă un plus de eleganță și se integrează perfect în decoruri moderne, glam sau luxury.\u003c\/p\u003e\u003cp\u003ePoți selecta cu ușurință tipul de lumină dorit:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLumină rece\u003c\/strong\u003e – pentru un ambient energizant\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLumină neutră\u003c\/strong\u003e – echilibru perfect pentru utilizare zilnică\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eLumină caldă\u003c\/strong\u003e – atmosferă relaxantă și primitoare\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminii în funcție de momentul zilei sau de atmosfera dorită.\u003c\/p\u003e\u003ch3\u003e🎮 Control simplu prin telecomandă\u003c\/h3\u003e\u003cp\u003eTelecomanda inclusă oferă control complet asupra:\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003eTemperaturii de culoare\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003eIntensității luminii\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003ePornire\/Oprire rapidă\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eConfort maxim fără a te ridica de pe canapea.\u003c\/p\u003e\u003ch3\u003e📏 Înălțime reglabilă\u003c\/h3\u003e\u003cp\u003eSistemul de prindere permite reglarea înălțimii în funcție de preferințe și de înălțimea tavanului, fiind potrivită atât pentru apartamente, cât și pentru case cu tavane înalte.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:169\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-08-19T21:44:38+03:00","created_at":"2025-08-13T12:07:25+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428545949963,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT109\/2GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams"