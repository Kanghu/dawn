/0782\/5175\/3739\/files\/Label_2546766_big_color.png?v=1784534187","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760169132299,"title":"Lustra LED suspendata cu telecomanda CHRISTINE, 41W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-christine-41w-2-cercuri-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu Telecomanda Christine este o piesă modernă și funcțională de iluminat, ce aduce un aer contemporan în orice încăpere. Cu un diametru total de 60 cm și o înălțime de 42 cm, această lustră suspendată se remarcă prin designul său atrăgător.\u003cbr\u003e\u003cbr\u003eCu o putere de 41W, lustra LED Christine oferă o lumină puternică și eficientă, asigurând o iluminare optimă în încăpere. Cu ajutorul telecomenzii incluse, puteți ajusta ușor intensitatea luminii și puteți opta pentru funcția de dimare, adaptând astfel atmosfera în funcție de preferințe.\u003cbr\u003e\u003cbr\u003eLustra dispune de un aspect alb-auriu elegant, ce adaugă o notă de rafinament și stil. Aceasta combină designul minimalist cu finisajele atractive, creând un echilibru între utilitate și estetică.\u003cbr\u003e\u003cbr\u003eCu o emisie de lumină de 3280 de lumeni, lustra LED Christine asigură o iluminare puternică și uniformă în încăpere. Acest lucru permite o vizibilitate excelentă și un ambient plăcut în spațiul în care este amplasată.\u003cbr\u003e\u003cbr\u003eLustra LED cu Telecomanda Christine este potrivită pentru o varietate de încăperi, precum sufragerii, dormitoare sau birouri moderne. Designul său versatil și funcționalitatea telecomenzii oferă confort și adaptabilitate în utilizare.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T01:48:43+02:00","created_at":"2025-02-25T01:48:42+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428509413643,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT803\/2GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":9760169132299,"created_at":"2025-09-30T14:07:23+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59030996517131,"created_at":"2025-08-12T11:49:28+03:00","position":1,"updated_at":"2026-05-08T17:03:28+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Untitled-1_786ecf2d-b72c-48da-ab66-8689cb59f9bb.png?v=1778249008","width":1024,"height":1024},{"id":59030996484363,"created_at":"2025-08-12T11:49:28+03:00","position":2,"updated_at":"2026-05-08T17:07:06+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-christine-100w-dimabila-alb-auriu-1688714407_4faccca0-4444-460f-beab-d981f37ea0b1.webp?v=1778249226","width":1024,"height":1024},{"id":59030996615435,"created_at":"2025-08-12T11:49:28+03:00","position":3,"updated_at":"2025-08-12T11:49:41+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/He2bd756a5ebe4b40afe7b4ed879d20bc3_1.jpg?v=1754988581","width":750,"height":750},{"id":59030996549899,"created_at":"2025-08-12T11:49:28+03:00","position":4,"updated_at":"2025-08-12T11:49:41+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H374d947bec8b44518ff4312b492c7323S.jpg?v=1754988581","width":1024,"height":1024},{"id":59030996582667,"created_at":"2025-08-12T11:49:28+03:00","position":5,"updated_at":"2026-05-22T12:58:37+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H39dd8058259f41fc908c26ef187e7a8b7_1.jpg?v=1779443917","width":823,"height":823},{"id":69031566901515,"created_at":"2026-05-22T13:57:48+03:00","position":6,"updated_at":"2026-05-22T13:57:52+03:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage22mai2026_13_57_41.png?v=1779447472","width":1254,"height":1254},{"id":62528636223755,"created_at":"2025-11-20T16:48:21+02:00","position":7,"updated_at":"2025-11-20T16:48:25+02:00","product_id":9760169132299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT803_2GD_EPREL_e928ff42-2132-4cc4-b158-f529b0bcb6da.png?v=1763650105","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760616677643,"title":"Lustra LED cu telecomanda RINOVA 66W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-rinova-66w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"3:1-3:88\"\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17._BANNER_230cb8bc-dbfe-4ff5-87c2-6dade128674d.png?v=1778557704\" alt=\"\"\u003eEleganță Circulară și Control Luminos Personalizat: Lustra LED cu Telecomandă RINOVA\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:277\"\u003eÎmbracă-ți spațiul cu un rafinament modern și o iluminare complet adaptabilă cu lustra LED RINOVA. Designul său elegant, compus din \u003cstrong\u003edouă cercuri\u003c\/strong\u003e concentrice sau suprapuse, finisate într-o nuanță sofisticată de \u003cstrong\u003enegru\u003c\/strong\u003e, adaugă o notă de stil contemporan oricărei încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:456\"\u003eCu o putere de \u003cstrong\u003e66W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și amplă, perfectă pentru livinguri, dininguri sau alte spații generoase. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Poți alege între \u003cstrong\u003elumină rece\u003c\/strong\u003e, ideală pentru activități care necesită concentrare; \u003cstrong\u003elumină caldă\u003c\/strong\u003e, perfectă pentru a crea un ambient primitor și relaxant; și \u003cstrong\u003elumină neutră\u003c\/strong\u003e, potrivită pentru iluminatul general de zi cu zi.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:184\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminoasă, creând astfel ambientul perfect pentru fiecare moment, de la o lumină strălucitoare la o lumină ambientală subtilă.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:84\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Două cercuri concentrice\/suprapuse cu finisaj negru.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:71\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 71W pentru o iluminare optimă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:91\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al temperaturii culorii și intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:94\"\u003e\n\u003cstrong\u003eTrei Temperaturi de Culoare:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru a se potrivi oricărei ocazii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:94\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj negru elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Minimalist:\u003c\/strong\u003e Se integrează perfect în interioarele moderne, industriale sau minimaliste.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"23:1-29:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:93\"\u003e\n\u003cstrong\u003eControl Total al Luminii:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:79\"\u003e\n\u003cstrong\u003eAtmosferă Personalizată:\u003c\/strong\u003e Creează ambientul perfect pentru fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:101\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Designul circular și finisajul negru adaugă un plus de eleganță modernă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:91\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii simplu și confortabil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eIluminare Amplă:\u003c\/strong\u003e Potrivită pentru iluminarea eficientă a spațiilor mari.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"30:1-30:200\"\u003eLustra LED cu telecomandă HAILEY este alegerea ideală pentru a adăuga un plus de stil, confort și control inteligent în casa ta. Bucură-te de iluminarea adaptabilă și de designul modern și sofisticat!\u003c\/p\u003e\u003cp data-sourcepos=\"30:1-30:200\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:58:27+02:00","created_at":"2025-02-25T02:58:27+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428099191051,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT510\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"219.99","position