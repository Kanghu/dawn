.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_3.webp?v=1782891207","width":900,"height":900},{"id":64641986691339,"created_at":"2026-01-23T12:18:48+02:00","position":5,"updated_at":"2026-07-01T10:33:36+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_4.jpg?v=1782891216","width":1000,"height":1000},{"id":64641986724107,"created_at":"2026-01-23T12:18:48+02:00","position":6,"updated_at":"2026-07-01T10:33:44+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_5.jpg?v=1782891224","width":1000,"height":1000},{"id":64641986658571,"created_at":"2026-01-23T12:18:48+02:00","position":7,"updated_at":"2026-07-01T10:33:53+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_6.jpg?v=1782891233","width":980,"height":1150},{"id":51843713728779,"created_at":"2025-02-25T01:46:29+02:00","position":8,"updated_at":"2026-07-01T10:34:03+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_7.webp?v=1782891243","width":900,"height":900},{"id":51843714810123,"created_at":"2025-02-25T01:46:29+02:00","position":9,"updated_at":"2026-07-01T10:34:12+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_8.webp?v=1782891252","width":900,"height":900},{"id":51843715268875,"created_at":"2025-02-25T01:46:29+02:00","position":10,"updated_at":"2026-07-01T10:34:22+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_9.webp?v=1782891262","width":900,"height":900},{"id":69633032978699,"created_at":"2026-07-01T10:32:27+03:00","position":11,"updated_at":"2026-07-01T10:34:31+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_10.png?v=1782891271","width":1254,"height":1254},{"id":69633021739275,"created_at":"2026-07-01T10:27:58+03:00","position":12,"updated_at":"2026-07-01T10:34:41+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_11.png?v=1782891281","width":1254,"height":1254},{"id":69633009385739,"created_at":"2026-07-01T10:22:22+03:00","position":13,"updated_at":"2026-07-01T10:34:49+03:00","product_id":9760149504267,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_Telecomanda_KILLIAN_74W_6_Cercuri_Lumina_Rece_Calda_Neutra_3000K_4000K_6000K_Dimabila_Negru_si_Alb_Metal_si_Acril_12.png?v=1782891289","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760248037643,"title":"Lustra LED suspendata cu telecomanda si cristal CAIRO 98W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-cairo-98w-2-cercuri-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu Telecomanda Cairo este o piesă de iluminat impresionantă și luxoasă, care va aduce un strop de eleganță și strălucire în locuința dvs. Cu o putere de 98W și un finisaj auriu, această lustră este formată din cristale, oferindu-vă o experiență vizuală spectaculoasă.\u003cbr\u003e\u003cbr\u003eLustra LED tip pendul dispune de un flux luminos puternic de 7840lm, asigurând o iluminare strălucitoare și uniformă în întreaga încăpere. Designul său impunător, cu un diametru al cercului mare de 60cm și un diametru al cercului mic de 40cm, împreună cu înălțimea de 110cm, va fi un punct de atracție în decorul dvs.\u003cbr\u003e\u003cbr\u003eRealizată din cristale de calitate superioară, această lustră strălucește și creează jocuri de lumină fascinante în jurul său. Auriul subtil al finisajului adaugă un aer sofisticat și rafinat, perfect pentru a complementa diferite stiluri de interior.\u003cbr\u003e\u003cbr\u003eTelecomanda inclusă vă oferă controlul total al culorii luminii, permițându-vă să ajustați atmosfera în funcție de preferințe. Cu această lustră LED Cairo, veți adăuga un efect impresionant și o notă luxoasă în hol, living sau chiar în spațiul comercial.\u003cbr\u003e\u003cbr\u003eBucurați-vă de strălucirea și frumusețea lustra LED cu Telecomanda Cairo, care va aduce o senzație de opulență și o experiență luminoasă deosebită în locuința dvs. Acestă lustră va fi cu siguranță un punct de conversație și va transforma orice încăpere într-un spațiu spectaculos și memorabil.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:01:18+02:00","created_at":"2025-02-25T02:01:18+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365396836619,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-6991\/40+60","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"848.00","grams":0,"compare_at_price":"659.99","position":1,"product_id":9760248037643,"created_at":"2025-09-13T13:46:10+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51845710446859,"created_at":"2025-02-25T02:01:21+02:00","position":1,"updated_at":"2025-05-20T16:15:30+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cairo_6991-40_60_03-1690271892.webp?v=1747746930","width":900,"height":900},{"id":51845709758731,"created_at":"2025-02-25T02:01:21+02:00","position":2,"updated_at":"2025-05-20T16:15:30+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-cairo-98w-auriu-1690271889.webp?v=1747746930","width":900,"height":900},{"id":51845709955339,"created_at":"2025-02-25T02:01:21+02:00","position":3,"updated_at":"2025-05-20T16:15:30+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cairo_6991-40_60_05-1690271895.webp?v=1747746930","width":900,"height":900},{"id":51845710315787,"created_at":"2025-02-25T02:01:22+02:00","position":4,"updated_at":"2025-05-20T16:15:30+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cairo_6991-40_60_06-1690271895.webp?v=1747746930","width":900,"height":900},{"id":51845709791499,"created_at":"2025-02-25T02:01:21+02:00","position":5,"updated_at":"2025-05-20T16:15:30+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cairo_6991-40_60_02-1690271891.webp?v=1747746930","width":900,"height":900},{"id":51845710840075,"created_at":"2025-02-25T02:01:21+02:00","position":6,"updated_at":"2025-05-20T16:15:25+03:00","product_id":9760248037643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cairo_6991-40_60_04-1690271894.webp?v=1747746925","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760402440459,"title":"Lustra LED suspendata cu telecomanda si cristal CANAAN 120W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-canaan-120w-3-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cristal Canaan este o bijuterie a iluminatului și a designului interior. Cu un design rafinat în culoare argintie și trei cercuri dispuse în stil pendul, această lustră oferă iluminare puternică și o estetică deosebită. Cu o putere impresionantă de 120W și un flux luminos de 9600 de lumeni, Canaan umple încăperea cu lumină și strălucire. Cele trei cercuri cu diametre diferite (60 cm, 40 cm și 20 cm) adaugă dimensiune și profunzime designului, oferind un impact vizual remarcabil.\u003cbr\u003e\u003cbr\u003eAceastă lustră este împodobită cu cristale transparente care adaugă un plus de eleganță și strălucire. Cristalele reflectă și refractă lumina, creând un joc subtil de lumină și umbră care conferă o notă de rafinament și lux. Cu culoarea argintie modernă, Canaan se integrează perfect în diferite stiluri de design interior, de la spațiile moderne până la cele tradiționale. Această lustră nu doar iluminează încăperea, ci devine o operă de artă în sine.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal Canaan este alegerea ideală pentru cei care caută să aducă strălucire și eleganță în locuința lor. Cu un design impresionant și performanțe luminoase remarcabile, această lustră transformă orice cameră într-un spațiu de excepție.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:25:34+02:00","created_at":"2025-02-25T02:25:34+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365398376715,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-751\/6+4+2","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"720.00","grams":0,"compare_at_price":"720.00","position":1,"product_id":9760402440459,"created_at":"2025-09-13T13:46:27+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51848563851531,"created_at":"2025-02-25T02:25:36+02:00","position":1,"updated_at":"2025-02-25T02:25:37+02:00","product_id":9760402440459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-canaan-120w-dimabila-argintiu-1703080774.webp?v=1740443137","width":900,"height":900},{"id":51848563818763,"created_at":"2025-02-25T02:25:36+02:00","position":2,"updated_at":"2025-02-25T02:25:37+02:00","product_id":9760402440459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-canaan_751-6_4_2_02-1703080775.webp?v=1740443137","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760437829899,"title":"Lustra LED cu telecomanda ANINA 34W, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Inaltime Reglabila","handle":"lustra-led-cu-telecomanda-anina-34w-lumina-rece-calda-neutra-dimabila-alb-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu telecomanda ANINA are o putere de \u003cstrong data-end=\"55\" data-start=\"48\"\u003e34W\u003c\/strong\u003e si functioneaza cu \u003cstrong data-end=\"88\" data-start=\"75\"\u003ebanda LED\u003c\/strong\u003e, oferind un flux luminos de \u003cstrong data-end=\"128\" data-start=\"117\"\u003e2720lm\u003c\/strong\u003e si lumina reglabila in trei temperaturi de culoare: \u003cstrong data-end=\"204\" data-start=\"181\"\u003e3000K, 4000K, 6000K\u003c\/strong\u003e (calda, neutra, rece). Are o durata de viata de \u003cstrong data-end=\"267\" data-start=\"253\"\u003e25.000 ore\u003c\/strong\u003e, se alimenteaza la \u003cstrong data-end=\"299\" data-start=\"287\"\u003e220–230V\u003c\/strong\u003e si se controleaza prin \u003cstrong data-end=\"362\" data-start=\"323\"\u003etelecomanda sau intrerupator clasic\u003c\/strong\u003e. Designul este \u003cstrong data-end=\"388\" data-start=\"378\"\u003emodern\u003c\/strong\u003e, cu forma \u003cstrong data-end=\"419\" data-start=\"399\"\u003erotunda\/circulara\u003c\/strong\u003e, constructie \u003cstrong data-end=\"447\" data-start=\"433\"\u003esuspendata\u003c\/strong\u003e si montaj pe \u003cstrong data-end=\"470\" data-start=\"461\"\u003etavan\u003c\/strong\u003e. Este realizata din \u003cstrong data-end=\"511\" data-start=\"491\"\u003emetal\u003c\/strong\u003e, finisaj \u003cstrong data-end=\"532\" data-start=\"521\"\u003ealb mat\u003c\/strong\u003e, cu \u003cstrong data-end=\"559\" data-start=\"537\"\u003einaltime reglabila\u003c\/strong\u003e pana la \u003cstrong\u003e100\u003c\/strong\u003e\u003cstrong data-end=\"577\" data-start=\"568\"\u003ecm\u003c\/strong\u003e si \u003cstrong data-end=\"602\" data-start=\"581\"\u003ediametru de 50cm\u003c\/strong\u003e. Protectia este de tip \u003cstrong data-end=\"634\" data-start=\"626\"\u003eIP20\u003c\/strong\u003e. Recomandata pentru \u003cstrong data-end=\"689\" data-start=\"655\"\u003edormitor, living sau bucatarie\u003c\/strong\u003e.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:30:41+02:00","created_at":"2025-02-25T02:30:40+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52425271050507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT803\/1WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"189.99","position":1,"product_id":9760437829899,"created_at":"2025-09-29T20:26:06+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56561658003723,"created_at":"2025-06-19T10:43:05+03:00","position":1,"updated_at":"2025-06-19T10:43:17+03:00","product_id":9760437829899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT8031WH-LustraLEDcutelecomandaANINA33W_luminaReceCaldaNeutra_Dimabila_Alb_InaltimeReglabila-4_9541dd26-b13c-4682-a8c4-7e0a2e94c444.png?v=1750318997","width":1080,"height":1080},{"id":56561621958923,"created_at":"2025-06-19T10:39:18+03:00","position":2,"updated_at":"2025-06-19T10:43:17+03:00","product_id":9760437829899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT8031WH-LustraLEDcutelecomandaANINA33W_luminaReceCaldaNeutra_Dimabila_Alb_InaltimeReglabila-1.png?v=1750318997","width":766,"height":766},{"id":56561658069259,"created_at":"2025-06-19T10:43:05+03:00","position":3,"updated_at":"2025-06-19T10:43:17+03:00","product_id":9760437829899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT8031WH-LustraLEDcutelecomandaANINA33W_luminaReceCaldaNeutra_Dimabila_Alb_InaltimeReglabila-5.png?v=1750318997","width":1080,"height":1080},{"id":56561621926155,"created_at":"2025-06-19T10:39:18+03:00","position":4,"updated_at":"2025-06-19T10:43:15+03:00","product_id":9760437829899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT8031WH-LustraLEDcutelecomandaANINA33W_luminaReceCaldaNeutra_Dimabila_Alb_InaltimeReglabila-2.png?v=1750318995","width":766,"height":766},{"id":63004315517195,"created_at":"2025-12-04T15:58:37+02:00","position":5,"updated_at":"2025-12-04T15:58:41+02:00","product_id":9760437829899,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT803_1WH_EPREL.png?v=1764856721","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760451920139,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA 32W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-nova-rotonda-29w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003ccenter\u003e\u003c\/center\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp data-start=\"128\" data-end=\"223\"\u003e\u003cstrong data-start=\"128\" data-end=\"223\"\u003eLustra LED cu telecomanda si cristal NOVA ROTONDA, 32W, 2 Cercuri, lumina reglabila – Negru\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-start=\"128\" data-end=\"223\"\u003e\u003cstrong data-start=\"128\" data-end=\"223\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-start=\"225\" data-end=\"482\"\u003eLustra LED \u003cstrong data-start=\"236\" data-end=\"252\"\u003eNOVA ROTONDA\u003c\/strong\u003e este alegerea ideala pentru cei care cauta un corp de iluminat modern, cu un design bine echilibrat si finisaje de calitate. Cu o forma rotunda si doua cercuri elegante, completeaza perfect camerele amenajate in stil contemporan.\u003c\/p\u003e\n\u003cp data-start=\"225\" data-end=\"482\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-start=\"484\" data-end=\"852\"\u003eEste dotata cu telecomanda si ofera trei variante de temperatura de culoare: calda, neutra si rece, ceea ce o face versatila atat pentru momente de relaxare, cat si pentru activitati care necesita o lumina mai puternica. Puterea de 32W si fluxul luminos de 2560 lumeni sunt potrivite pentru dormitor, hol, dressing sau chiar baie (in zone ferite de umiditate directa).\u003c\/p\u003e\n\u003cp data-start=\"484\" data-end=\"852\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\n\u003cp data-start=\"854\" data-end=\"1025\"\u003eMaterialele folosite – cristal, metal si acril – asigura atat un aspect vizual placut, cat si durabilitate. Se monteaza pe tavan si functioneaza la tensiune standard 220V.\u003c\/p\u003e\n\u003cp data-start=\"1027\" data-end=\"1163\"\u003eEste o \u003cstrong data-start=\"1034\" data-end=\"1048\"\u003elustra LED\u003c\/strong\u003e cu un stil discret dar rafinat, care aduce lumina eficienta si control total al atmosferei prin functia de dimare.\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T02:32:23+02:00","created_at":"2025-02-25T02:32:23+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52424238825739,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT073\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9760451920139,"created_at":"2025-09-29T14:15:57+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57102078476555,"created_at":"2025-07-06T04:14:40+03:00","position":1,"updated_at":"2025-12-10T