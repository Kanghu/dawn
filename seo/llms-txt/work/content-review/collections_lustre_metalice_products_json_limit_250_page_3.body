rcializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e \u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-12-31T06:54:09+02:00","created_at":"2025-12-19T11:45:32+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52773329010955,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT813\/4GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"559.99","grams":0,"compare_at_price":"559.99","position":1,"product_id":10841114345739,"created_at":"2025-12-19T11:45:33+02:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":63610150453515,"created_at":"2025-12-19T11:47:34+02:00","position":1,"updated_at":"2025-12-19T11:48:12+02:00","product_id":10841114345739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ha3a2170df9914501bdd3d07b3c413325j.jpg?v=1766137692","width":2000