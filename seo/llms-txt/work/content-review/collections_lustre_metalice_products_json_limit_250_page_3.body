a-start=\"684\" data-end=\"687\"\u003e✔ \u003cstrong data-start=\"689\" data-end=\"727\"\u003eDesign expresiv, culoare negru mat\u003c\/strong\u003e – se potrivește perfect în interioare moderne, industriale sau minimaliste.\u003c\/p\u003e\u003cp data-start=\"492\" data-end=\"900\" class=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:39:19+03:00","created_at":"2025-04-14T19:50:22+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52425142599947,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL644\/500BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"149.99","position":1,"product_id":10133501444363,"created_at":"2025-09-29T19:37:00+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56571490074891,"created_at":"2025-06-19T16:17:32+03:00","position":1,"updated_at":"2025-06-19T16:17:45+03:00","product_id":10133501444363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL644500BK-LustraLEDSKYFormaStarry_64W_luminaReceCaldaNeutra_Negru-3.jpg?v=1750339065","width":1080,"height":1080},{"id":56571490435339,"created_at":"2025-06-19T16:17:32+03:00","position":2,"updated_at":"2025-06-19T16:17:45+03:00","product_id":10133501444363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LL644500BK-LustraLEDSKYFormaStarry_64W_luminaReceCaldaNeutra_Negru-1.jpg?v=1750339065","width":1080,"height":1080},{"id":