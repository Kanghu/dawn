2409921569035,"created_at":"2025-03-17T15:53:05+02:00","position":4,"updated_at":"2026-05-20T12:20:45+03:00","product_id":9758323933451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LustraLEDcutelecomandaAMI_50W_3Inimi_luminaRece_Calda_Neutra_Dimabila_Alb_3.png?v=1779268845","width":1024,"height":1024},{"id":68986880557323,"created_at":"2026-05-20T12:20:59+03:00","position":5,"updated_at":"2026-05-20T12:21:06+03:00","product_id":9758323933451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage20mai2026_12_20_51.png?v=1779268866","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758340612363,"title":"Lustra LED cu telecomanda CERELIS 90W, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-cerelis-90w-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:128\"\u003eLustra LED cu telecomandă CERELIS este o piesă de iluminat modernă și eficientă, cu o putere de 90W și un finisaj negru elegant.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:396\"\u003eCu o putere de 90W, este potrivită pentru a ilumina spații de dimensiuni medii sau mari, cum ar fi livinguri sau sufragerii. Telecomanda inclusă îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), permițându-ți să creezi atmosfera dorită. Finisajul negru îi conferă un aspect sobru și modern, ușor de integrat în diverse stiluri de interior.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-11-02T11:12:38+02:00","created_at":"2025-02-24T21:20:14+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52408538398987,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-483\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"399.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9758340612363,"created_at":"2025-09-24T13:53:20+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51821035847947,"created_at":"2025-02-24T21:20:16+02:00","position":1,"updated_at":"2025-02-24T21:20:17+02:00","product_id":9758340612363,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cerelis-telecomanda-90w-24ghz-dimabila-acril-negru_LL1596_01.webp?v=1740424817","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758363025675,"title":"Lustra LED cu telecomanda AFINA 120W, 4 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-afina-120w-4-elemente-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:240\"\u003eLustra LED cu telecomandă AFINA este o piesă de iluminat modernă și eficientă, cu o putere de 120W și un design format din 4 elemente, finisate în negru. Telecomanda inclusă oferă control asupra temperaturii culorii și intensității luminii.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:437\"\u003eCele patru elemente negre, a căror formă nu este specificată, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii (rece, caldă sau neutră). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment. Finisajul negru îi conferă un aspect sobru și modern. Cu o putere de 120W, este potrivită pentru a ilumina livinguri, sufragerii sau alte spații de dimensiuni medii.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:25:22+02:00","created_at":"2025-02-24T21:25:21+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52038332088587,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-SX8753\/4S","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"259.99","grams":0,"compare_at_price":"259.99","position":1,"product_id":9758363025675,"created_at":"2025-08-05T15:27:03+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51821130613003,"created_at":"2025-02-24T21:25:24+02:00","position":1,"updated_at":"2025-02-24T21:25:26+02:00","product_id":9758363025675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-afina-telecomanda-120w-acril-metal-negru_LL1664_01.webp?v=1740425126","width":900,"height":900},{"id":51821130547467,"created_at":"2025-02-24T21:25:24+02:00","posit