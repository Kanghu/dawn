oferă o iluminare de calitate superioară, iar opțiunea de a ajusta între lumina rece, caldă sau neutră îți permite să creezi atmosfera perfectă în funcție de momentul zilei sau de activitatea desfășurată. Funcția de reglare a intensității luminoase (dimabilă) adaugă versatilitate, iar telecomanda inclusă îți oferă un control comod asupra luminii. Finisajul elegant negru completează designul rafinat, făcând lustra potrivită pentru livinguri, dormitoare sau birouri. Un echilibru perfect între estetică și performanță energetică.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:30:20+03:00","created_at":"2025-04-14T16:53:19+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","NOSINC"],"variants":[{"id":52424291057931,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT633\/500R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"219.99","position":1,"product_id":10132854145291,"created_at":"2025-09-29T14:36:43+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69925233164555,"created_at":"2026-08-14T15:13:49+03:00","position":1,"updated_at":"2026-08-14T15:13:52+03:00","product_id":1013285