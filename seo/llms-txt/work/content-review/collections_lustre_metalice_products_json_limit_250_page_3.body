/8._Detail_1_6f086b00-f718-465c-aca0-436cb78308fe.jpg?v=1775078726","width":3999,"height":3999},{"id":67093614526731,"created_at":"2026-03-10T05:36:38+02:00","position":11,"updated_at":"2026-04-02T00:25:26+03:00","product_id":9758373118219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/11._Place_1_6f4e92f7-abfb-4b1e-b4c5-e484411bd502.jpg?v=1775078726","width":3999,"height":3999},{"id":67093614362891,"created_at":"2026-03-10T05:36:36+02:00","position":12,"updated_at":"2026-04-02T00:25:26+03:00","product_id":9758373118219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9._Detail_2_54966eb9-18f8-4430-81ae-91379d4f651f.jpg?v=1775078726","width":3999,"height":3999},{"id":67093614559499,"created_at":"2026-03-10T05:36:38+02:00","position":13,"updated_at":"2026-04-02T00:25:26+03:00","product_id":9758373118219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14._Place_4_bc1c944f-50bb-4c19-8605-72d54bab638f.jpg?v=1775078726","width":3999,"height":3999},{"id":67093614592267,"created_at":"2026-03-10T05:36:38+02:00","position":14,"updated_at":"2026-04-02T00:25:26+03:00","product_id":9758373118219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13._Place_3_0dc19b4f-b403-4369-a9fe-7ae8c0d48be2.jpg?v=1775078726","width":3999,"height":3999},{"id":62704902799627,"created_at":"2025-11-25T16:15:27+02:00","position":15,"updated_at":"2026-04-02T00:25:26+03:00","product_id":9758373118219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT219BK_EPREL.png?v=1775078726","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759374901515,"title":"Lustra LED cu telecomanda si cristal MEILI ZAFINA RGB 136W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-zafina-rgb-136w-4-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:286\"\u003eLustra LED cu telecomandă și cristale ZAFINA RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din patru cercuri concentrice, finisate în alb și împodobite cu cristale strălucitoare. Cu o putere de 136W, oferă o iluminare amplă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003eCele patru\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003e \u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:480\"\u003ecercuri albe, decorate cu cristale, creează un aspect luminos și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:315\"\u003eFinisajul alb al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 136W, este ideală pentru a ilumina livinguri, sufragerii sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:39:46+02:00","created_at":"2025-02-24T23:39:45+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Meili Lighting","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52110421065995,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-19373\/2+2WH+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"280.00","grams":0,"compare_at_price":"280.00","position":1,"product_id":9759374901515,"created_at":"2025-08-23T01:04:31+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51832334549259,"created_at":"2025-02-24T23:39:47+02:00","position":1,"updated_at":"2025-02-24T23:39:49+02:00","product_id":9759374901515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-natara-telecomanda-136w-alb-rgb_1741_01.webp?v=1740433189","width":900,"height":900},{"id":51832334909707,"created_at":"2025-02-24T23:39:47+02:00","position":2,"updated_at":"2025-02-24T23:39:49+02:00","product_id":9759374901515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-natara-telecomanda-136w-alb-rgb_1741_02.webp?v=1740433189","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759388238091,"title":"Lustra LED suspendata cu telecomanda si cristal CAIRO 36W, 1 Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-cairo-36w-1-cerc-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu Telecomanda CAIRO este o piesă de iluminat elegantă și sofisticată, care va aduce o notă de rafinament și strălucire în orice încăpere. Cu o putere de 36W și un finisaj auriu, această lustră este realizată din cristale, oferindu-vă un aspect spectaculos și deosebit.\u003cbr\u003e\u003cbr\u003eLustra LED tip pendul are un flux luminos de 2880lm, asigurând o iluminare puternică și bine distribuită în întreaga încăpere. Cu un diametru de 40cm și o înălțime de 110cm, această lustră va fi un punct focal al decorului dvs., captând privirile și impresionând prin designul său.\u003cbr\u003e\u003cbr\u003eCristalele de calitate superioară reflectă lumină în mod fascinant, creând un joc sclipitor de lumini și umbre în jurul lustra. Finisajul auriu adaugă o notă de eleganță și lux, încântând privirile și creând o atmosferă opulentă. Telecomanda inclusă vă permite să schimbați culoarea în funcție de preferințele dvs., oferindu-vă o experiență personalizată și unică.\u003cbr\u003e\u003cbr\u003eLustra LED cu Telecomanda CAIRO este perfectă pentru a adăuga un strop de glamour și eleganță în living, hol sau chiar într-un spațiu comercial. Această lustră va impresiona prin strălucirea sa și va transforma instant orice încăpere într-un loc luxos și memorabil. Bucurați-vă de frumusețea și splendoarea acestei lustra, care va deveni un punct de atracție în decorul dvs. interior.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T23:41:24+02:00","created_at":"2025-02-24T23:41:23+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365376717067,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-6991\/400","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"448.00","grams":0,"compare_at_price":"448.00","position":1,"product_id":9759388238091,"created_at":"2025-09-13T13:36:16+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51832433213707,"created_at":"2025-02-24T23:41:26+02:00","position":1,"updated_at":"2025-02-24T23:41:28+02:00","product_id":9759388238091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/candelabru-led-esteban-48w-cristal-auriu_CC2031AU_01.webp?v=1740433288","width":900,"height":900},{"id":51832433148171,"created_at":"2025-02-24T23:41:26+02:00","position":2,"updated_at":"2025-02-24T23:41:28+02:00","product_id":9759388238091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/candelabru-led-esteban-48w-cristal-auriu_CC2031AU_02.webp?v=1740433288","width":900,"height":900},{"id":51832433115403,"created_at":"2025-02-24T23:41:26+02:00","position":3,"updated_at":"2025-02-24T23:41:28+02:00","product_id":9759388238091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/candelabru-led-esteban-48w-cristal-auriu_CC2031AU_03.webp?v=1740433288","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759448826123,"title":"Lustra LED cu telecomanda si cristal BLAKELY RGB 166W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-blakely-rgb-166w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:298\"\u003eLustra LED cu telecomandă și cristale BLAKELY RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 3 pătrate stilizate, finisate în alb și decorate cu cristale strălucitoare. Cu o putere impresionantă de 166W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:493\"\u003eCele trei pătrate albe, împodobite cu cristale, creează un aspect geometric elegant și luminos. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă sofisticată. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:320\"\u003eFinisajul alb al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 166W, este ideală pentru a ilumina livinguri mari, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:48:44+02:00","created_at":"2025-02-24T23:48:44+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52365376880907,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7965\/3WH+CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"296.00","grams":0,"compare_at_price":"389.99","position":1,"product_id":9759448826123,"created_at":"2025-09-13T13:36:21+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51833008652555,"created_at":"2025-02-24T23:48:46+02:00","position":1,"updated_at":"2025-02-24T23:48:48+02:00","product_id":9759448826123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lujuana-cu-telecomanda-166w-alb-rgb-1670327364.webp?v=1740433728","width":900,"height":900},{"id":51833007800587,"created_at":"2025-02-24T23:48:46+02:00","position":2,"updated_at":"2025-02-24T23:48:47+02:00","product_id":9759448826123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lujuana-cu-telecomanda-166w-alb-rgb-1666941280-1670327365.webp?v=1740433727","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759497027851,"title":"Lustra LED  MEISSUN 44W, Liniara, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-meissun-44w-liniara-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați un strop de magie și modernitate în decorul dumneavoastră cu Lustra LED Meissun. Această lustră inovatoare, cu un design linear și finisare în negru, este ideală pentru a crea un efect vizual unic în orice spațiu. Cu o putere de 44W și un flux luminos de 1320lm, Meissun oferă o iluminare eficientă, în timp ce designul său distinctiv cu reflexii pe tavan în formă de steluțe adaugă un element de surpriză și farmec.\u003cbr\u003e\u003cbr\u003eUna dintre caracteristicile cheie ale Lustrei LED Meissun este capacitatea sa de a oferi trei tipuri de lumină: rece (6000K), caldă (3000K) și neutră (4000K). Această versatilitate permite adaptarea ușoară a iluminatului la diferite nevoi și momente ale zilei. Fie că doriți o lumină caldă și confortabilă pentru relaxare, o lumină neutră pentru activități de zi cu zi, sau o lumină rece pentru un mediu de lucru concentrat, Meissun se adaptează perfect.\u003cbr\u003e\u003cbr\u003eDesignul său linear și finisajul negru se integrează armonios în decoruri moderne sau contemporane, adăugând un element de stil și sofisticare. Reflexiile stelate pe tavan creează o atmosferă deosebită, ideală pentru a adăuga un strop de creativitate și unicitate în orice încăpere.\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED Meissun pentru a beneficia de un iluminat de calitate superioară, care combină eficiența energetică cu un design artistic și o versatilitate remarcabilă. Este mai mult decât o sursă de lumină; este o declarație de stil care va îmbogăți și va lumina orice interior cu un aer de eleganță modernă și funcționalitate.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T23:56:20+02:00","created_at":"2025-02-24T23:56:19+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52038335430923,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-5812BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"189.99","grams":0,"compare_at_price":"198.99","position":1,"product_id":9759497027851,"created_at":"2025-08-05T15:28:05+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51833401606411,"created_at":"2025-02-24T23:56:23+02:00","position":1,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-si-metal-negru-1699969060.webp?v=1740434185","width":900,"height":900},{"id":51833401442571,"created_at":"2025-02-24T23:56:23+02:00","position":2,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_01-1699969005.webp?v=1740434185","width":900,"height":900},{"id":51833401868555,"created_at":"2025-02-24T23:56:23+02:00","position":3,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_02.webp?v=1740434185","width":900,"height":900},{"id":51833401770251,"created_at":"2025-02-24T23:56:23+02:00","position":4,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_03.webp?v=1740434185","width":900,"height":900},{"id":51833401508107,"created_at":"2025-02-24T23:56:23+02:00","position":5,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_04.webp?v=1740434185","width":900,"height":900},{"id":51833402229003,"created_at":"2025-02-24T23:56:23+02:00","position":6,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_05.webp?v=1740434185","width":900,"height":900},{"id":51833401540875,"created_at":"2025-02-24T23:56:23+02:00","position":7,"updated_at":"2025-02-24T23:56:25+02:00","product_id":9759497027851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-meissun-44w-acril-metal-negru_LL1889N_06.webp?v=1740434185","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759500861707,"title":"Lustra LED suspendata cu telecomanda si cristal MIA LATIFAH 55W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-mia-latifah-55w-2-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:296\"\u003eLustra LED suspendată cu telecomandă și cristale LATIFAH este o piesă de iluminat modernă și elegantă, cu un finisaj crom lucios care îi conferă un aspect strălucitor și contemporan. Cu o putere de 55W și un design format din două cercuri, aduce un plus de lumină și rafinament în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:501\"\u003eCele două cercuri ale lustrei sunt decorate cu cristale transparente, care reflectă și refractă lumina LED integrată, creând un efect vizual captivant și o atmosferă sofisticată. Telecomanda inclusă îți oferă control total asupra iluminării: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:56:36+02:00","created_at":"2025-02-24T23:56:35+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52428024217867,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT023\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"539.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9759500861707,"created_at":"2025-09-30T11:55:42+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55440691462411,"created_at":"2025-05-14T21:58:39+03:00","position":1,"updated_at":"2025-05-14T21:59:47+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT023_2-LustraLEDsuspendatacutelecomandasicristalLATIFAH_70W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-1_2.png?v=1747249187","width":1080,"height":1080},{"id":51833445777675,"created_at":"2025-02-24T23:56:38+02:00","position":2,"updated_at":"2025-05-14T22:16:35+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-latifah-118w-argintiu_1752_04.webp?v=1747250195","width":900,"height":900},{"id":51833445286155,"created_at":"2025-02-24T23:56:38+02:00","position":3,"updated_at":"2025-05-14T21:59:47+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-latifah-118w-argintiu_1752_01.webp?v=1747249187","width":900,"height":900},{"id":51833444368651,"created_at":"2025-02-24T23:56:38+02:00","position":4,"updated_at":"2025-05-14T21:59:47+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-latifah-118w-argintiu_1752_02.webp?v=1747249187","width":900,"height":900},{"id":51833445515531,"created_at":"2025-02-24T23:56:38+02:00","position":5,"updated_at":"2025-05-14T21:59:47+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-latifah-118w-argintiu_1752_03.webp?v=1747249187","width":900,"height":900},{"id":55440691527947,"created_at":"2025-05-14T21:58:39+03:00","position":6,"updated_at":"2025-05-14T21:58:42+03:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/white-AT1CT-CH1A-HT2L-LT023_2-LustraLEDsuspendatacutelecomandasicristalLATIFAH_70W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-1.png?v=1747249122","width":1080,"height":1080},{"id":63330465612043,"created_at":"2025-12-12T14:40:40+02:00","position":7,"updated_at":"2025-12-12T14:40:44+02:00","product_id":9759500861707,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT023_2_EPREL.png?v=1765543244","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759549751563,"title":"Lustra LED cu telecomanda si cristal MISEL 138W, 7 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu","handle":"lustra-led-cu-telecomanda-si-cristal-misel-138w-7-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu","body_html":"\u003cp data-sourcepos=\"1:1-1:280\"\u003eLustra LED cu telecomandă și cristale MISEL este o piesă de iluminat elegantă și puternică, cu o putere de 138W. Designul său include 7 elemente, probabil brațe sau forme stilizate, finisate într-o combinație sofisticată de negru și auriu, și împodobite cu cristale strălucitoare.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:379\"\u003eCele șapte elemente, împreună cu cristalele, vor crea un efect luminos captivant, reflectând și refractând lumina LED integrată. Telecomanda inclusă îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), permițându-ți să adaptezi atmosfera după preferințe. Combinația de negru și auriu adaugă un aer luxos și modern designului.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:205\"\u003eCu o putere de 138W, această lustră este potrivită pentru a ilumina livinguri, sufragerii sau alte spații de dimensiuni medii sau mari, adăugând un element de design rafinat și o sursă de lumină versatilă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:205\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:03:04+02:00","created_at":"2025-02-25T00:03:03+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52365377569035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-L7821\/4+3BK+GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"464.00","grams":0,"compare_at_price":"464.00","position":1,"product_id":9759549751563,"created_at":"2025-09-13T13:36:41+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57346408677643,"created_at":"2025-07-14T10:08:26+03:00","position":1,"updated_at":"2026-07-23T14:23:39+03:00","product_id":9759549751563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_GUIDA_38W_6_Elemente_lumina_Rece_Calda_Neutra_Dimabila_Negru_Auriu_1.png?v=1784805819","width":1800,"height":1800},{"id":51834008207627,"created_at":"2025-02-25T00:03:05+02:00","position":2,"updated_at":"2025-07-14T10:08:39+03:00","product_id":9759549751563,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-nazira-138w-auriu-negru_1759_02.webp?v=1752476919","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759555256587,"title":"Lustra LED suspendata cu telecomanda AMINIA 80W, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Auriu, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-aminia-80w-liniara-lumina-rece-calda-neutra-dimabila-auriu-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați un strop de lux și eleganță în decorul dumneavoastră cu Lustra LED AMINIA . Această lustră tip pendul, cu un design linear sofisticat și o finisare strălucitoare în auriu, este alegerea ideală pentru spații care caută un echilibru între stilul modern și un sentiment de rafinament. Cu o lungime impresionantă de 100cm și o putere de 80W, AMINIA  oferă o iluminare eficientă și un impact vizual remarcabil, fiind perfectă pentru livinguri, săli de mese sau spații comerciale.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai mari avantaje ale Lustrei LED AMINIA  este capacitatea sa de a oferi trei tipuri de lumină - caldă (3000K), neutră (4000K) și rece (6000K). Această versatilitate vă permite să schimbați ambianța camerei în funcție de momentul zilei sau de activitatea desfășurată, asigurând o iluminare adaptabilă pentru orice situație. Funcția de dimare, controlabilă prin telecomandă, adaugă un nivel de confort și adaptabilitate. Aceasta vă permite să reglați intensitatea luminii după preferințe, creând ambianța ideală pentru orice moment al zilei. În plus, înălțimea reglabilă a lustrei adaugă flexibilitate, permițându-vă să adaptați lustra în funcție de înălțimea tavanului sau de specificul spațiului.\u003cbr\u003e\u003cbr\u003eDesignul său linear și finisarea în auriu fac din AMINIA  o piesă centrală modernă și atrăgătoare. Fie că este plasată într-un decor minimalist sau unul mai opulent, această lustră se potrivește armonios, adăugând un plus de rafinament și modernitate.\u003cbr\u003e\u003cbr\u003eOptați pentru Lustra LED AMINIA  pentru a combina eficiența în iluminat cu un design contemporan și elegant. Este mai mult decât o sursă de lumină; este o declarație de stil care va îmbogăți și va lumina orice interior cu un aer sofisticat și modern.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:04:25+02:00","created_at":"2025-02-25T00:04:24+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52423656407307,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-L1660GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"397.99","grams":0,"compare_at_price":"399.99","position":1,"product_id":9759555256587,"created_at":"2025-09-29T09:45:26+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51834026000651,"created_at":"2025-02-25T00:04:26+02:00","position":1,"updated_at":"2025-02-25T00:04:27+02:00","product_id":9759555256587,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-talida-80w-auriu_1758_01.webp?v=1740434667","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759750684939,"title":"Lustra LED cu telecomanda  OSANNA 128W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-osanna-128w-3-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:224\"\u003eLustra LED cu telecomandă OSANNA este o piesă de iluminat modernă și puternică, cu un design format din 3 pătrate stilizate, finisate în negru. Cu o putere de 128W, oferă o iluminare amplă și versatilă pentru diverse spații.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:477\"\u003eCele trei pătrate, dispuse probabil într-o manieră care creează un ansamblu vizual echilibrat și contemporan, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:248\"\u003eFinisajul negru al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de eleganță și sobrietate încăperii. Cu o putere de 128W, este ideală pentru a ilumina livinguri, sufragerii sau alte spații de dimensiuni medii sau mari.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:32:56+02:00","created_at":"2025-02-25T00:32:55+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52038360432907,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-3089","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"389.99","grams":0,"compare_at_price":"389.99","position":1,"product_id":9759750684939,"created_at":"2025-08-05T15:29:42+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51836777890059,"created_at":"2025-02-25T00:32:57+02:00","position":1,"updated_at":"2025-02-25T00:32:58+02:00","product_id":9759750684939,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-osanna-128w-dimabila-alb-negru_LL1918AL_01.webp?v=1740436378","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759764709643,"title":"Lustra LED suspendata cu telecomanda ADELAIDA 226W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-adelaida-226w-4-cercuri-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:259\"\u003eLustra LED suspendată cu telecomandă ADELAIDA este o piesă de iluminat impunătoare și elegantă, cu o putere de 226W și un design format din patru cercuri finisate în auriu lucios. Datorită înălțimii reglabile, se poate adapta diferitelor spații și preferințe.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:524\"\u003eCele patru cercuri aurii lucioase, probabil de dimensiuni variate sau aranjate într-un mod artistic, sunt iluminate de LED-uri puternice, oferind posibilitatea de a selecta temperatura culorii. Telecomanda inclusă permite alegerea între lumină rece, caldă sau neutră, precum și ajustarea intensității luminoase (dimabilă). Finisajul auriu lucios adaugă o notă de lux și opulență designului. Funcția de înălțime reglabilă oferă flexibilitate în instalare, permițând adaptarea la înălțimea tavanului și preferințele personale.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:137\"\u003eCu o putere de 226W, este ideală pentru a ilumina livinguri mari, săli de mese sau alte spații ample, devenind un punct focal sofisticat.\u003c\/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(102, 102, 102); font-family: verdana,geneva,sans-serif; font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:34:36+02:00","created_at":"2025-02-25T00:34:35+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52348633284875,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-5176GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"539.99","grams":0,"compare_at_price":"512.00","position":1,"product_id":9759764709643,"created_at":"2025-09-10T01:08:58+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51837029482763,"created_at":"2025-02-25T00:34:37+02:00","position":1,"updated_at":"2025-02-25T00:34:39+02:00","product_id":9759764709643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-asinefa-226w-dimabila-alb-auriu_AT1CT-CH1A-HT2L-5176GD_01.webp?v=1740436479","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759842074891,"title":"Lustra LED TRIFOI RGB ROZA 24W, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-trifoi-rgb-roza-24w-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:263\"\u003eAceastă lustră LED TRIFOI RGB ROZA, de 24W și culoare albă, aduce un plus de culoare și versatilitate în iluminarea locuinței tale din Galați. Designul său inspirat de un trifoi, combinat cu funcția RGB, îți oferă posibilitatea de a crea ambianțe luminoase unice.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-13:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:62\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 24W, asigurând o iluminare eficientă și plăcută.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:72\"\u003e\n\u003cstrong\u003eDesign inedit:\u003c\/strong\u003e Forma de trifoi adaugă un element estetic original.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:146\"\u003e\n\u003cstrong\u003eLumină versatilă:\u003c\/strong\u003e Oferă lumină rece, caldă și neutră pentru iluminatul general, dar și \u003cstrong\u003efuncție RGB\u003c\/strong\u003e pentru iluminare ambientală colorată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:114\"\u003e\n\u003cstrong\u003eControl RGB:\u003c\/strong\u003e Permite selectarea dintr-o gamă variată de culori pentru a crea efecte luminoase personalizate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:84\"\u003e\n\u003cstrong\u003eCuloare:\u003c\/strong\u003e Alb, un fundal neutru care permite culorilor RGB să iasă în evidență.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:83\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-11:67\"\u003e\n\u003cstrong\u003eFlux luminos optim:\u003c\/strong\u003e Asigură o iluminare adecvată a spațiului.\u003c\/li\u003e\n\u003cli data-sourcepos=\"12:1-13:0\"\u003e\n\u003cstrong\u003eInstalare simplă:\u003c\/strong\u003e Vine cu toate accesoriile necesare și instrucțiuni clare.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"14:1-14:287\"\u003eAceastă lustră LED TRIFOI RGB ROZA este ideală pentru cei care doresc un corp de iluminat modern, cu funcții variate, care să permită personalizarea atmosferei luminoase din locuința , de la iluminatul funcțional de zi cu zi până la efecte colorate pentru momente speciale.\u003c\/p\u003e\u003cp data-sourcepos=\"14:1-14:287\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:50:00+02:00","created_at":"2025-02-25T00:49:59+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","SUB50"],"variants":[{"id":52429872562443,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL635WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"49.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9759842074891,"created_at":"2025-09-30T17:46:10+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51838303731979,"created_at":"2025-02-25T00:50:01+02:00","position":1,"updated_at":"2025-02-25T00:50:03+02:00","product_id":9759842074891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-rgb-roza-40w-alb_LL1943AL_01.webp?v=1740437403","width":900,"height":900},{"id":51838303273227,"created_at":"2025-02-25T00:50:01+02:00","position":2,"updated_at":"2025-02-25T00:50:03+02:00","product_id":9759842074891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-rgb-roza-40w-alb_LL1943AL_02.webp?v=1740437403","width":900,"height":900},{"id":51838303174923,"created_at":"2025-02-25T00:50:01+02:00","position":3,"updated_at":"2025-02-25T00:50:03+02:00","product_id":9759842074891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-rgb-roza-40w-alb_LL1943AL_03.webp?v=1740437403","width":900,"height":900},{"id":51838303142155,"created_at":"2025-02-25T00:50:01+02:00","position":4,"updated_at":"2025-02-25T00:50:03+02:00","product_id":9759842074891,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-rgb-roza-40w-alb_LL1943AL_04.webp?v=1740437403","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759842238731,"title":"Lustra LED  cu cristal ARIELLA 39W, Patrata,  lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-cu-cristal-ariella-39w-patrata-lumina-rece-calda-neutra-negru","body_html":"\u003ch2 style=\"text-align: left;\"\u003eDescriere Lustra LED Ariella 39W Alb Negru\u003c\/h2\u003e\u003cdiv class=\"containerimg-mobile\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED \u003cstrong\u003eAriella\u003c\/strong\u003e, un element rafinat al gamei Yancy, este o alegere perfectă pentru cei care caută să combine eleganța modernă cu eficiența energetică. Această lustră, cu o putere de \u003cstrong\u003e39W \u003c\/strong\u003eși un design atractiv în \u003cstrong\u003ealb și negru\u003c\/strong\u003e, aduce un plus de stil și lumină în orice spațiu interior.\u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003eDesignul său elegant, caracterizat de o \u003cstrong\u003eformă pătrată\u003c\/strong\u003e și \u003cstrong\u003efinisajul bicolor\u003c\/strong\u003e, este accentuat de cristale decorative care adaugă un nivel de rafinament și lux. Aceste cristale nu doar că îmbogățesc aspectul estetic al lustrei, dar și refractă lumina într-un mod spectaculos, creând un joc de scânteieri și străluciri sofisticate.\u003c\/span\u003e\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Ariella oferă un \u003cstrong\u003eflux luminos de 3120lm\u003c\/strong\u003e, asigurând o iluminare clară și eficientă, ideală pentru spații de dimensiuni mici. Tehnologia LED integrată nu numai că oferă o lumină de calitate, dar este și extrem de eficientă din punct de vedere energetic, fiind de până la 10 ori mai eficientă decât becurile clasice.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003cspan style=\"font-size: 16px;\"\u003eCu o autonomie de 25.000 de ore, lustra \u003cstrong\u003eAriella\u003c\/strong\u003e este o soluție economică și sustenabilă pentru iluminarea oricărui interior, oferind durabilitate și performanță pe termen lung. \u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003eEste soluția perfectă pentru a adăuga un strop de eleganță și eficiență în orice ambient, îmbunătățind atât aspectul, cât și atmosfera oricărui spațiu.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T00:50:15+02:00","created_at":"2025-02-25T00:50:15+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52429510934795,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL603BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9759842238731,"created_at":"2025-09-30T16:35:56+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51838307893515,"created_at":"2025-02-25T00:50:18+02:00","position":1,"updated_at":"2025-02-25T00:50:20+02:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_01.webp?v=1740437420","width":900,"height":900},{"id":57507334422795,"created_at":"2025-07-21T11:01:20+03:00","position":2,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_fe3a9a80-6f3e-4f28-8145-d7f0bd91e991.png?v=1753085382","width":2408,"height":2408},{"id":51838308090123,"created_at":"2025-02-25T00:50:18+02:00","position":3,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_02.webp?v=1753085382","width":900,"height":900},{"id":51838307991819,"created_at":"2025-02-25T00:50:18+02:00","position":4,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_03.webp?v=1753085382","width":900,"height":900},{"id":51838307926283,"created_at":"2025-02-25T00:50:18+02:00","position":5,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_04.webp?v=1753085382","width":900,"height":900},{"id":51838307860747,"created_at":"2025-02-25T00:50:18+02:00","position":6,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_05.webp?v=1753085382","width":900,"height":900},{"id":51838307959051,"created_at":"2025-02-25T00:50:18+02:00","position":7,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_06.webp?v=1753085382","width":900,"height":900},{"id":51838308024587,"created_at":"2025-02-25T00:50:18+02:00","position":8,"updated_at":"2025-07-21T11:09:42+03:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ariella-36w-alb-negru_LL1945AL_07.webp?v=1753085382","width":900,"height":900},{"id":63231963070731,"created_at":"2025-12-10T12:32:34+02:00","position":9,"updated_at":"2025-12-10T12:32:38+02:00","product_id":9759842238731,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL603BK_EPREL.png?v=1765362758","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759897223435,"title":"Lustra LED cu telecomanda BLOSSOM 146W, 12 Petale, lumina Rece\/Calda\/Neutra 3000k\/4000k\/6000k, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-blossom-146w-12-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:293\"\u003eLustra LED cu telecomandă BLOSSOM , cu o putere impresionantă de 146W și un design floral spectaculos cu 12 petale, este o piesă de iluminat care îmbină arta cu funcționalitatea. Finisajul alb pur accentuează delicatețea designului și aduce o notă de lumină și eleganță în orice încăpere.\u003c\/p\u003e\u003cp data-sourcepos=\"1:1-1:293\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:232\"\u003eAceastă lustră grandioasă nu este doar o sursă de lumină, ci și un element central de decor. Cele 12 petale stilizate, iluminate eficient de tehnologia LED, creează un efect vizual captivant, amintind de o floare în plină înflorire.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:232\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:365\"\u003eDatorită telecomenzii incluse, ai control total asupra atmosferei. Poți alege între lumină rece, ideală pentru a energiza spațiul, lumină caldă, perfectă pentru a crea un ambient primitor și relaxant, sau lumină neutră, potrivită pentru iluminarea generală. Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:365\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:198\"\u003eCu o putere de 146W, BLOSSOM Grand oferă o iluminare abundentă, fiind ideală pentru livinguri spațioase, sufragerii sau alte zone ample unde dorești un impact vizual puternic și o lumină adaptabilă.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:112\"\u003eAceastă lustră este o declarație de stil, aducând un strop de natură stilizată și lumină inteligentă în casa ta.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:57:57+02:00","created_at":"2025-02-25T00:57:57+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52409062064395,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT260\/12WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"359.99","grams":0,"compare_at_price":"359.99","position":1,"product_id":9759897223435,"created_at":"2025-09-24T16:43:17+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51839317541131,"created_at":"2025-02-25T00:57:58+02:00","position":1,"updated_at":"2025-02-25T00:58:00+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-beladonna-240w-dimabila-alb_LL1970AL_01.webp?v=1740437880","width":900,"height":900},{"id":64505169477899,"created_at":"2026-01-19T10:38:11+02:00","position":2,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/61I1n_lbq4S._AC_SL1500.jpg?v=1768812298","width":1500,"height":1500},{"id":64505169543435,"created_at":"2026-01-19T10:38:11+02:00","position":3,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/61MzXrKBInS._AC_SL1500.jpg?v=1768812298","width":1500,"height":1500},{"id":64505169608971,"created_at":"2026-01-19T10:38:11+02:00","position":4,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71G18rUfVGS._AC_SL1500.jpg?v=1768812298","width":1500,"height":1500},{"id":64505169576203,"created_at":"2026-01-19T10:38:11+02:00","position":5,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/71UVVRJRBcS._AC_SL1500.jpg?v=1768812298","width":1500,"height":1500},{"id":64505169641739,"created_at":"2026-01-19T10:38:11+02:00","position":6,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H06fbc97ed9d241aca9d6a681b08e5f0cX.png?v=1768812298","width":800,"height":800},{"id":62999454613771,"created_at":"2025-12-04T14:46:21+02:00","position":7,"updated_at":"2026-01-19T10:44:58+02:00","product_id":9759897223435,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT260_12WH_EPREL_fa9531cd-749c-4214-b48e-8de862336b6a.png?v=1768812298","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759898075403,"title":"Lustra LED cu telecomanda BLOSSOM 49W, 9 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-blossom-49w-9-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003eLustra LED cu telecomandă BLOSSOM, de 49W, este o piesă de iluminat spectaculoasă și elegantă, cu un design floral amplu, format din nouă elemente stilizate ce imită petalele unei flori, totul într-un finisaj alb imaculat. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eAceastă lustră nu este doar o sursă de lumină, ci și un element decorativ central care aduce un aer sofisticat și luminos în orice încăpere. Oferă o iluminare versatilă, permițând alegerea între lumină rece, ideală pentru o atmosferă energizantă, lumină caldă, perfectă pentru relaxare, și lumină neutră, potrivită pentru iluminatul general. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eFuncția de dimare, controlată prin telecomanda inclusă, îți oferă posibilitatea de a ajusta intensitatea luminii pentru a crea ambianța perfectă. Designul său floral grandios și culoarea albă luminoasă o fac ideală pentru livinguri spațioase, sufragerii sau alte zone în care se dorește un impact vizual puternic și o lumină adaptabilă. Cu o putere de 49W, asigură o iluminare amplă și eficientă a spațiului.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003e \u003c\/span\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:58:03+02:00","created_at":"2025-02-25T00:58:02+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52360046346507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT260\/9WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9759898075403,"created_at":"2025-09-12T14:01:08+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51839330156811,"created_at":"2025-02-25T00:58:05+02:00","position":1,"updated_at":"2025-02-25T00:58:06+02:00","product_id":9759898075403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-willow-180w-dimabila-alb_LL1971AL_01.webp?v=1740437886","width":900,"height":900},{"id":51839330386187,"created_at":"2025-02-25T00:58:05+02:00","position":2,"updated_at":"2025-02-25T00:58:06+02:00","product_id":9759898075403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-willow-180w-dimabila-alb_LL1971AL_02.webp?v=1740437886","width":900,"height":900},{"id":68251323040011,"created_at":"2026-04-14T13:56:25+03:00","position":3,"updated_at":"2026-04-14T13:56:28+03:00","product_id":9759898075403,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lt260-9wh.png?v=1776164188","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759899615499,"title":"Lustra LED suspendata cu telecomanda INFINITY TWIST 180W, Ondulata, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-infinity-twist-180w-ondulata-lumina-rece-calda-neutra-dimabila-alb-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați o notă de eleganță și stil contemporan în interiorul dumneavoastră cu Lustra LED Miyuki. Această lustră tip pendul, cu un design ondulat sofisticat și finisată în alb, este o alegere perfectă pentru a ilumina și a îmbogăți orice spațiu modern. Cu o putere de 180W și un flux luminos impresionant de 14400lm, Miyuki este ideală pentru a deveni punctul central în livinguri, săli de mese sau holuri.\u003cbr\u003e\u003cbr\u003eControlul prin telecomandă aduce un nivel ridicat de comoditate, permițându-vă să ajustați intensitatea și tipul de lumină cu ușurință. Faptul că este dimabilă vă oferă posibilitatea de a schimba atmosfera camerei în funcție de momentul zilei sau de starea de spirit. Cele trei tipuri de lumină - caldă, rece sau neutră - asigură că puteți alege lumina perfectă pentru orice ocazie.\u003cbr\u003e\u003cbr\u003eDesignul său ondulat adaugă un aspect dinamic și modern oricărui interior. Este ideală pentru spații ample, oferind un echilibru perfect între funcționalitate și estetică. Alegeți Lustra LED Miyuki pentru a combina eficiența luminii cu un design artistic unic. Este mai mult decât o sursă de iluminat; este o declarație de stil care va îmbogăți și va lumina orice interior cu eleganță și rafinament.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:58:16+02:00","created_at":"2025-02-25T00:58:15+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52424053293323,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8035WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"368.00","grams":0,"compare_at_price":"368.00","position":1,"product_id":9759899615499,"created_at":"2025-09-29T13:15:39+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55675857076491,"created_at":"2025-05-22T17:12:17+03:00","position":1,"updated_at":"2025-05-22T17:12:30+03:00","product_id":9759899615499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-8035WH-LustraLEDsuspendatacutelecomandaINFINITYTWIST_180W_luminaRece_Calda_Neutra_Dimabila_Alb_InaltimeReglabila-1.webp?v=1747923150","width":1080,"height":1080},{"id":55675857010955,"created_at":"2025-05-22T17:12:17+03:00","position":2,"updated_at":"2025-05-22T17:12:30+03:00","product_id":9759899615499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-8035WH-LustraLEDsuspendatacutelecomandaINFINITYTWIST_180W_luminaRece_Calda_Neutra_Dimabila_Alb_InaltimeReglabila-2.webp?v=1747923150","width":1080,"height":1080},{"id":55675856978187,"created_at":"2025-05-22T17:12:17+03:00","position":3,"updated_at":"2025-05-22T17:12:30+03:00","product_id":9759899615499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-8035WH-LustraLEDsuspendatacutelecomandaINFINITYTWIST_180W_luminaRece_Calda_Neutra_Dimabila_Alb_InaltimeReglabila-3.webp?v=1747923150","width":1080,"height":1080},{"id":55675856945419,"created_at":"2025-05-22T17:12:17+03:00","position":4,"updated_at":"2025-05-22T17:12:30+03:00","product_id":9759899615499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/black-8035WH-LustraLEDsuspendatacutelecomandaINFINITYTWIST_180W_luminaRece_Calda_Neutra_Dimabila_Alb_InaltimeReglabila-1.webp?v=1747923150","width":1080,"height":1080},{"id":55675857043723,"created_at":"2025-05-22T17:12:17+03:00","position":5,"updated_at":"2025-05-22T17:12:30+03:00","product_id":9759899615499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/white-8035WH-LustraLEDsuspendatacutelecomandaINFINITYTWIST_180W_luminaRece_Calda_Neutra_Dimabila_Alb_InaltimeReglabila-1.webp?v=1747923150","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759900598539,"title":"Lustra LED suspendata cu telecomanda INFINITY TWIST 180W, Ondulata, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-infinity-twist-180w-ondulata-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați un element de design unic și impresionant în decorul dumneavoastră cu Lustra LED INFINITY Twist. Această lustră tip pendul, cu un design ondulat modern și o finisare elegantă în negru, este perfectă pentru a crea un punct central în orice spațiu contemporan. Cu o putere remarcabilă de 180W și un flux luminos de 14400lm, INFINITY Twist nu este doar o declarație de stil, ci și o sursă de iluminare eficientă și puternică.\u003cbr\u003e\u003cbr\u003eFuncționalitatea dimabilă, controlabilă ușor prin telecomandă, vă oferă libertatea de a ajusta intensitatea luminii în funcție de atmosfera dorită. În plus, cu cele trei tipuri de lumină disponibile - caldă, rece sau neutră - puteți schimba tonalitatea luminii pentru a se potrivi perfect cu momentul zilei sau cu activitatea pe care o desfășurați.\u003cbr\u003e\u003cbr\u003eDesignul ondulat al Lustrei LED INFINITY Twist adaugă un aspect dinamic și modern oricărui interior. Este ideală pentru livinguri spațioase, săli de mese sau zone de recepție, oferind un echilibru perfect între funcționalitate și estetică.\u003cbr\u003e\u003cbr\u003eOptați pentru Lustra LED INFINITY Twist pentru a combina eficiența luminii cu un design artistic unic. Este o soluție ideală pentru cei care doresc să adauge un strop de eleganță modernă și un iluminat de calitate în spațiile lor.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:58:22+02:00","created_at":"2025-02-25T00:58:22+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52424267694347,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8035BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"368.00","grams":0,"compare_at_price":"368.00","position":1,"product_id":9759900598539,"created_at":"2025-09-29T14:25:48+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51839380783371,"created_at":"2025-02-25T00:58:25+02:00","position":1,"updated_at":"2025-02-25T00:58:27+02:00","product_id":9759900598539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-madeline-180w-dimabila-alb-negru_8035BK_01.webp?v=1740437907","width":900,"height":900},{"id":51839381274891,"created_at":"2025-02-25T00:58:25+02:00","position":2,"updated_at":"2025-05-20T18:15:06+03:00","product_id":9759900598539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-madeline-180w-dimabila-alb-negru_8035BK_05.webp?v=1747754106","width":900,"height":900},{"id":51839382487307,"created_at":"2025-02-25T00:58:25+02:00","position":3,"updated_at":"2025-05-20T18:15:06+03:00","product_id":9759900598539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-madeline-180w-dimabila-alb-negru_8035BK_02.webp?v=1747754106","width":900,"height":900},{"id":51839380685067,"created_at":"2025-02-25T00:58:25+02:00","position":4,"updated_at":"2025-05-20T18:15:06+03:00","product_id":9759900598539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-madeline-180w-dimabila-alb-negru_8035BK_03.webp?v=1747754106","width":900,"height":900},{"id":51839380848907,"created_at":"2025-02-25T00:58:25+02:00","position":5,"updated_at":"2025-05-20T18:15:06+03:00","product_id":9759900598539,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-madeline-180w-dimabila-alb-negru_8035BK_04.webp?v=1747754106","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759901745419,"title":"Lustra LED VIVIAN 24W, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-vivian-24w-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:103\"\u003eLustra LED VIVIAN este o opțiune de iluminat modernă și discretă, cu o putere de 24W și un finisaj alb.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:328\"\u003eCu o putere de 24W, este potrivită pentru a oferi o lumină ambientală plăcută sau pentru a ilumina eficient spații mai mici, cum ar fi holuri, băi sau dressinguri. Posibilitatea de a alege între lumină rece, caldă sau neutră îți permite să adaptezi atmosfera în funcție de preferințe sau de necesitățile specifice ale încăperii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:223\"\u003eFinisajul alb îi conferă un aspect curat și versatil, ușor de integrat în diverse stiluri de decor interior. Numele 'VIVIAN' sugerează o notă elegantă și clasică, deși designul specific ar determina stilul exact al lustrei.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T00:58:30+02:00","created_at":"2025-02-25T00:58:30+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52038362595595,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-3066WH+BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"64.00","grams":0,"compare_at_price":"64.00","position":1,"product_id":9759901745419,"created_at":"2025-08-05T15:30:27+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51839399362827,"created_at":"2025-02-25T00:58:32+02:00","position":1,"updated_at":"2025-02-25T00:58:34+02:00","product_id":9759901745419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-vivian-24w-alb-negru_3066WHBK_01.webp?v=1740437914","width":900,"height":900},{"id":51839399624971,"created_at":"2025-02-25T00:58:32+02:00","position":2,"updated_at":"2025-02-25T00:58:34+02:00","product_id":9759901745419,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-vivian-24w-alb-negru_3066WHBK_02.webp?v=1740437914","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759916130571,"title":"Lustra LED cu telecomanda LYRA 80W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-lyra-80w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:232\"\u003eLustra LED cu telecomandă  LYRA  este o piesă de iluminat modernă și elegantă, cu un design format din două cercuri concentrice, finisate în negru. Cu o putere de 80W, oferă o iluminare versatilă și eficientă pentru diverse spații.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:231\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:231\"\u003eCele două cercuri negre, probabil de dimensiuni diferite sau dispuse într-un mod care creează un efect vizual interesant, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:231\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:231\"\u003eFinisajul negru accentuează liniile moderne ale designului circular și adaugă o notă de eleganță și sobrietate încăperii. Cu o putere de 80W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi de dimensiuni medii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:231\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T01:00:17+02:00","created_at":"2025-02-25T01:00:16+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52409388695819,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-162\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"320.00","grams":0,"compare_at_price":"320.00","position":1,"product_id":9759916130571,"created_at":"2025-09-24T18:13:41+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51839655117067,"created_at":"2025-02-25T01:00:20+02:00","position":1,"updated_at":"2025-02-25T01:00:22+02:00","product_id":9759916130571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-rosalie-80w-dimabila-alb-negru_162-2BK_01.webp?v=1740438022","width":900,"height":900},{"id":51839654756619,"created_at":"2025-02-25T01:00:20+02:00","position":2,"updated_at":"2025-05-20T18:08:27+03:00","product_id":9759916130571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-rosalie-80w-dimabila-alb-negru_162-2BK_05.webp?v=1747753707","width":900,"height":900},{"id":51839654396171,"created_at":"2025-02-25T01:00:20+02:00","position":3,"updated_at":"2025-05-20T18:08:27+03:00","product_id":9759916130571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-rosalie-80w-dimabila-alb-negru_162-2BK_02.webp?v=1747753707","width":900,"height":900},{"id":51839654494475,"created_at":"2025-02-25T01:00:20+02:00","position":4,"updated_at":"2025-05-20T18:08:27+03:00","product_id":9759916130571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-rosalie-80w-dimabila-alb-negru_162-2BK_03.webp?v=1747753707","width":900,"height":900},{"id":51839654461707,"created_at":"2025-02-25T01:00:20+02:00","position":5,"updated_at":"2025-05-20T18:08:27+03:00","product_id":9759916130571,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-rosalie-80w-dimabila-alb-negru_162-2BK_04.webp?v=1747753707","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760005095691,"title":"Lustra LED cu telecomanda si cristal BLAKELY RGB 74W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-blakely-rgb-74w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:290\"\u003eLustra LED cu telecomandă și cristale SOLE KINSLEY RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 pătrate stilizate, finisate în negru și decorate cu cristale strălucitoare. Cu o putere de 74W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:494\"\u003eCele patru pătrate negre, împodobite cu cristale, creează un aspect geometric elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:316\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 74W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:316\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T01:21:51+02:00","created_at":"2025-02-25T01:21:51+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52108031230219,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7965\/4BK+CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"349.99","position":1,"product_id":9760005095691,"created_at":"2025-08-22T12:40:03+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51841282736395,"created_at":"2025-02-25T01:21:53+02:00","position":1,"updated_at":"2025-02-25T01:21:55+02:00","product_id":9760005095691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-cu-telecomanda-kinsley-74w-dimabila-alb-negru-1686900364.webp?v=1740439315","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760020201739,"title":"Lustra LED cu telecomanda si cristal BLAKELY RGB 154W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-blakely-rgb-154w-4-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperă lustra LED Cristal RGB Blakely, o capodoperă a designului de iluminat modern, expusă în showroom-ul Alessandro Design. Această lustră, cu o putere de 154W și un design negru sofisticat, reprezintă o combinație ideală de stil și funcționalitate, fiind perfectă pentru orice spațiu interior modern.\u003cbr\u003e\u003cbr\u003eLustra Blakely se remarcă prin structura sa geometrică unică, compusă din patru pătrate elegante, fiecare împodobit cu cristale transparente. Aceste cristale adaugă o notă de strălucire și rafinament, refractând lumina într-un mod spectaculos și creând un efect vizual impresionant. O caracteristică distinctivă a lustrei este tehnologia LED RGB (Red, Green, Blue) integrată, controlabilă prin telecomandă. Acest lucru vă permite să personalizați lumina în funcție de preferințele dvs., alegând între diferite nuanțe de lumină caldă, rece sau neutră și ajustând intensitatea luminii după nevoie. Mai mult, funcția de dimare a lustrei oferă un control suplimentar asupra ambianței.\u003cbr\u003e\u003cbr\u003eCu un flux luminos generos de 12320lm, Blakely este capabilă să ilumineze chiar și cele mai mari spații, cum ar fi livinguri spațioase, săli de mese sau holuri ample. Eficiența sa energetică, datorată tehnologiei LED, garantează un consum redus de energie și o durată lungă de viață, oferind astfel o soluție durabilă și economică pentru iluminat.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal RGB Blakely este o alegere excelentă pentru cei care doresc să combine un design contemporan cu tehnologia de iluminare avansată și eficiență energetică. Este soluția ideală pentru a adăuga un element de iluminat unic și sofisticat în decorul interior, oferind un iluminat de înaltă calitate care să îmbunătățească aspectul și atmosfera oricărui spațiu.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T01:23:29+02:00","created_at":"2025-02-25T01:23:29+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52038910017803,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7965\/2+2BK+CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"304.00","grams":0,"compare_at_price":"304.00","position":1,"product_id":9760020201739,"created_at":"2025-08-05T17:51:50+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51841546715403,"created_at":"2025-02-25T01:23:32+02:00","position":1,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-cu-telecomanda-blakely-154w-dimabila-alb-negru-1687936247.webp?v=1740439414","width":900,"height":900},{"id":51841547174155,"created_at":"2025-02-25T01:23:32+02:00","position":2,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_02-1687339916.webp?v=1740439414","width":900,"height":900},{"id":51841546912011,"created_at":"2025-02-25T01:23:32+02:00","position":3,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_03-1687339916.webp?v=1740439414","width":900,"height":900},{"id":51841546780939,"created_at":"2025-02-25T01:23:32+02:00","position":4,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_04-1687339916.webp?v=1740439414","width":900,"height":900},{"id":51841546944779,"created_at":"2025-02-25T01:23:32+02:00","position":5,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_05-1687339916.webp?v=1740439414","width":900,"height":900},{"id":51841548124427,"created_at":"2025-02-25T01:23:32+02:00","position":6,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_06-1687339916.webp?v=1740439414","width":900,"height":900},{"id":51841548845323,"created_at":"2025-02-25T01:23:32+02:00","position":7,"updated_at":"2025-02-25T01:23:34+02:00","product_id":9760020201739,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-telecomanda-blakely-154w-dimabila-alb-negru_7965-2_2bk_cr_07-1687339916.webp?v=1740439414","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760149504267,"title":"Lustra LED cu Telecomanda, KILLIAN, 74W, 6 Cercuri, Lumina Rece\/Calda\/Neutra 3000K\/4000K\/6000K, Dimabila, Negru si Alb, Metal si Acril","handle":"lustra-led-cu-telecomanda-killian-74w-6-cercuri-lumina-rece-calda-neutra-dimabila-negru-alb","body_html":"\u003cp data-end=\"116\" data-start=\"0\"\u003e\u003cstrong data-end=\"116\" data-start=\"0\"\u003e\u003cimg style=\"font-size: 0.875rem;\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-end=\"431\" data-start=\"118\"\u003eLustra LED KILLIAN este un corp de iluminat modern, cu design dinamic format din 6 cercuri suprapuse, conceput pentru interioare contemporane care pun accent pe estetică și funcționalitate.\u003c\/p\u003e\u003cp data-end=\"431\" data-start=\"118\"\u003e\u003cimg style=\"font-size: 0.875rem;\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-end=\"431\" data-start=\"118\"\u003eCombinația de finisaje negru și alb oferă un contrast elegant, potrivit pentru livinguri, dormitoare sau spații open-space.\u003c\/p\u003e\u003cp data-end=\"431\" data-start=\"118\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_temp_9a4e039c-9145-4d24-bc80-6826a45aac6c.png?v=1769162858\"\u003e\u003c\/p\u003e\u003cp data-end=\"713\" data-start=\"433\"\u003eIluminarea LED integrată de 74W este dimabilă și permite selectarea temperaturii de culoare caldă, neutră sau rece (3000K \/ 4000K \/ 6000K), pentru adaptarea atmosferei în funcție de momentul zilei și activitate. Controlul prin telecomandă asigură reglaj rapid și utilizare comodă.\u003c\/p\u003e\u003cp data-end=\"713\" data-start=\"433\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_1_png.png?v=1769162635\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"949\" data-start=\"715\"\u003eStructura realizată din metal și acril oferă durabilitate și o distribuție uniformă a luminii, cu consum redus de energie și confort vizual ridicat. Lustra KILLIAN este o soluție practică și estetică pentru iluminatul interior modern.\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"949\" data-start=\"715\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/CRI.png?v=1768840359\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"949\" data-start=\"715\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_desc_final_3315e8d2-c0f3-4417-adeb-36a4457c80a8.png?v=1769163047\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T01:46:27+02:00","created_at":"2025-02-25T01:46:27+02:00","updated_at":"2026-09-14T13:12:21+0