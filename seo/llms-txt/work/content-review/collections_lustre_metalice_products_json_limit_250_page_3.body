e":true,"featured_image":null,"available":false,"price":"289.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":9756844589323,"created_at":"2025-09-24T12:03:32+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51810635383051,"created_at":"2025-02-24T12:26:55+02:00","position":1,"updated_at":"2025-02-24T12:26:57+02:00","product_id":9756844589323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lampa-industriala-fantas-150w-negru-6500k_IS1487_01.webp?v=1740392817","width":900,"height":900},{"id":51810635350283,"created_at":"2025-02-24T12:26:55+02:00","position":2,"updated_at":"2025-02-24T12:26:57+02:00","product_id":9756844589323,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lampa-industriala-fantas-150w-negru-6500k_IS1487_02.webp?v=1740392817","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":11009036583179,"title":"Lustra LED cu telecomanda GEO 29W, 2 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Metal si Acril, Negru","handle":"lustra-led-cu-telecomanda-geo-29w-2-patrate-lumina-rece-calda-neutra-dimabila-metal-si-acril-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:237\"\u003eLustra LED cu telecomandă GEO este o piesă de iluminat modernă și funcțională, cu un design geometric format din 2 pătrate elegante, finisate în negru. Cu o putere de 29W, oferă o iluminare eficientă și versatilă pentru diverse spații.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:473\"\u003eCele dou\u003cmeta charset=\"utf-8\"\u003eă pătrate, dispuse într-o manieră estetică, nu doar distribuie lumina uniform, ci creează și un impact vizual contemporan. Telecomanda inclusă îți permite să controlezi temperatura culorii luminii, alegând între lumină rece (pentru o atmosferă energizantă), caldă (pentru un ambient primitor și relaxant) sau neutră (pentru iluminare generală). Funcția de dimare îți oferă posibilitatea de a ajusta intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:242\"\u003eFinisajul negru al lustrei accentuează liniile clare ale designului pătrat și adaugă o notă de eleganță și modernitate încăperii. Această combinație de formă geometrică și culoare neutră o face ușor de integrat în diverse stiluri de interior.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:242\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e","published_at":"2026-08-13T14:12:01+03:00","created_at":"2026-07-22T14:52:02+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":53263357313291,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT8006\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"329.99","position":1,"product_id":11009036583179,"created_at":"2026-07-22T14:52:03+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69814725673227,"created_at":"2026-07-22T15:12:57+03:00","position":1,"updated_at":"2026-07-22T15:15:25+03:00","product_id":11009036583179,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GEO_29W_2_Patrate_lumina_Rece_Calda_Neutra_Dimabila_Metal_si_Acril_Negru_1.png?v=1784722525","width":1254