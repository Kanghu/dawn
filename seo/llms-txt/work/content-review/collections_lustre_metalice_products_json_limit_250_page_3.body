":"2025-11-20T16:56:41+02:00","product_id":10133258764555,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL649_300R_EPREL_1052ce6f-68b2-414e-9964-77bc28ae339e.png?v=1763650601","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133413003531,"title":"Lustra LED NYXORA  51W, 3 Patrate, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-nyxora-51w-3-patrate-lumina-rece-calda-neutra-alb","body_html":"\u003cp class=\"\" data-end=\"417\" data-start=\"193\"\u003eLustra LED NYXORA aduce un accent grafic elegant în orice interior contemporan. Cu un design format din 3 pătrate dispuse în compoziție armonioasă, această piesă oferă nu doar lumină, ci și un element vizual distinct.\u003c\/p\u003e\u003cp class=\"\" data-end=\"695\" data-start=\"419\"\u003eCu o putere de 51W, oferă iluminare eficientă și uniformă, ajustabilă în trei nuanțe de lumină: rece, caldă și neutră – pentru a se adapta oricărui moment sau atmosferă. Finisajul negru mat conferă o notă modernă, ușor de integrat în livinguri, dormitoare sau spații de lucru.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:41:22+03:00","created_at":"2025-04-14T19:21:10+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52412032549131,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL648\/300P","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"129.99","grams":0,"compare_at_price":"119.99","position"