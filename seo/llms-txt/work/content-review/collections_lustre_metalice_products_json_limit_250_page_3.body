.jpg?v=1748266383","width":1080,"height":1080},{"id":55769250758923,"created_at":"2025-05-26T15:26:07+03:00","position":6,"updated_at":"2025-05-26T16:33:03+03:00","product_id":9786058965259,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/931629d1-83cb-44d1-9ede-4fb8ca0c9b25.webp?v=1748266383","width":416,"height":435}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9790468981003,"title":"Lustra LED VERTEX Pulse, 13W, Ondulata, Lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-vertex-pulse-13w-ondulata-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:196\"\u003eLustra LED VERTEX Pulse este o piesă de iluminat modernă și dinamică, cu un design ondulat și un finisaj negru elegant. Cu o putere de 13W, oferă o lumină versatilă, adaptabilă preferințelor tale.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:300\"\u003eForma ondulată a lustrei sugerează un flux continuu și un aspect vizual interesant, adăugând un element de mișcare spațiului. Tehnologia LED asigură eficiență energetică, iar posibilitatea de a alege între lumină rece, caldă sau neutră îți permite să creezi atmosfera potrivită pentru fiecare moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:271\"\u003eFinisajul negru accentuează liniile moderne și fluide ale designului ondulat, făcând-o potrivită pentru interioare contemporane sau minimaliste. Cu o putere de 13W, este ideală pentru a ilumina spații mai mici sau medii, cum ar fi holuri, dormitoare sau zone de relaxare.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:271\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e","published_at":"2025-03-11T23:20:34+02:00","created_at":"2025-03-11T23:20:34+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Scandinave"],"variants":[{"id":52414542774539,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL562BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9790468981003,"created_at":"2025-09-26T11:41:18+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69858247868683,"created_at":"2026-07-31T21:53:41+03:00","position":1,"updated_at":"2026-07-31T21:53:44+03:00","product_id":9790468981003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/007_07_LL562BK.webp?v=1785524024","width":1254,"height":1254},{"id":69858247704843,"created_at":"2026-07-31T21:53:41+03:00","position":2,"updated_at":"2026-07-31T21:53:44+03:00","product_id":9790468981003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LL562BK.webp?v=1785524024","width":1254,"height":1254},{"id":69858247999755,"created_at":"2026-07-31T21:53:41+03:00","position":3,"updated_at":"2026-07-31T21:53:44+03:00","product_id":9790468981003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/011_11_LL562BK.webp?v=1785524024","width":1254,"height":1254},{"id":69858247737611,"created_at":"2026-07-31T21:53:41+03:00","position":4,"updated_at":"2026-07-31T21:53:43+03:00","product_id":9790468981003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LL562BK.webp?v=1785524023","width":1254,"height":1254},{"id":69858247770379,"created_at":"2026-07-31T21:53:41+03:00","position":5,"updated_at":"2026-07-31T21:53:44+03:00","product_id":9790468981003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004