/0782\/5175\/3739\/files\/013_13_LT078-4WH.webp?v=1785875425","width":1000,"height":1000},{"id":69876283506955,"created_at":"2026-08-04T23:30:22+03:00","position":14,"updated_at":"2026-08-04T23:30:25+03:00","product_id":9760003916043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/014_14_LT078-4WH.webp?v=1785875425","width":1000,"height":1000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10132397523211,"title":"Lustra LED cu cristal PRISMIQ 45W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-cu-cristal-prismiq-45w-3-cercuri-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-start=\"181\" data-end=\"443\" class=\"\"\u003eLustra LED PRISMIQ aduce un plus de stil și eficiență cu cele trei cercuri interconectate și finisajul negru mat. Această lustră modernă oferă iluminare reglabilă în trei nuanțe – rece, caldă și neutră – pentru a crea atmosfera perfectă în orice moment al zilei.\u003c\/p\u003e\u003cp data-start=\"445\" data-end=\"903\" class=\"\"\u003e✔ \u003cstrong data-start=\"447\" data-end=\"475\"\u003e3 cercuri interconectate\u003c\/strong\u003e – design modern și dinamic, potrivit pentru spații contemporane.\u003cbr data-start=\"540\" data-end=\"543\"\u003e✔ 45\u003cstrong data-start=\"545\" data-end=\"559\"\u003eW putere\u003c\/strong\u003e – ideală pentru camere mici și medii, precum dormitoare, holuri sau birouri.\u003cbr data-start=\"636\" data-end=\"639\"\u003e✔ \u003cstrong data-start=\"641\" data-end=\"661\"\u003eLumina reglabilă\u003c\/strong\u003e – alege între tonuri reci, calde sau neutre, pentru un confort optim.\u003cbr data-start=\"731\" data-end=\"734\"\u003e✔ \u003cstrong data-start=\"736\" data-end=\"757\"\u003eFinisaj negru mat\u003c\/strong\u003e – se integrează perfect în interioare moderne sau industriale.\u003cbr data-start=\"820\" data-end=\"823\"\u003e✔ \u003cstrong data-start=\"825\" data-end=\"849\"\u003eEficiență energetică\u003c\/strong\u003e – lumină uniformă și economică pentru orice încăpere.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:44:23+03:00","created_at":"2025-04-14T15:13:39+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52372595179787,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL654\/300BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":10132397523211,"created_at":"2025-09-16T01:08:33+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69858310095115,"created_at":"2026-07-31T22:23:19+03:00","position":1,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_03_LL654-300BK.webp?v=1785525802","width":1254,"height":1254},{"id":69858310029579,"created_at":"2026-07-31T22:23:19+03:00","position":2,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_02_LL654-300BK.webp?v=1785525802","width":1254,"height":1254},{"id":69858310586635,"created_at":"2026-07-31T22:23:19+03:00","position":3,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/021_11_LL654-300BK.webp?v=1785525802","width":1254,"height":1254},{"id":69858310193419,"created_at":"2026-07-31T22:23:19+03:00","position":4,"updated_at":"2026-07-31T22:23:23+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_05_LL654-300BK.webp?v=1785525803","width":1254,"height":1254},{"id":69858310226187,"created_at":"2026-07-31T22:23:19+03:00","position":5,"updated_at":"2026-07-31T22:23:23+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_05_LL654-300BK.webp?v=1785525803","width":1254,"height":1254},{"id":69858310291723,"created_at":"2026-07-31T22:23:19+03:00","position":6,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/012_06_LL654-300BK.webp?v=1785525802","width":1254,"height":1254},{"id":69858310422795,"created_at":"2026-07-31T22:23:19+03:00","position":7,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/016_08_LL654-300BK.webp?v=1785525802","width":1254,"height":1254},{"id":69858309931275,"created_at":"2026-07-31T22:23:19+03:00","position":8,"updated_at":"2026-07-31T22:23:22+03:00","product_id":10132397523211,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LL654-300BK.webp?v=1785525802","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10633428730123,"title":"Lustra LED VERTEX FUSION 21W, 2 Cercuri, Rame Metalice, lumina Rece\/Calda\/Neutra, Alb\/Negru","handle":"lustra-led-vertex-fusion-21w-2-cercuri-rame-metalice-lumina-rece-calda-neutra-alb-negru","body_html":"\u003cp data-start=\"0\" data-end=\"387\"\u003eLustra LED VERTEX FUSION îmbină designul geometric cu funcționalitatea modernă, fiind ideală pentru spații contemporane ce valorifică simplitatea și eficiența. Cele 2 cercuri suprapuse oferă un efect vizual dinamic, în timp ce combinația alb\/negru adaugă un contrast elegant potrivit oricărui decor minimalist.\u003c\/p\u003e\u003cp data-start=\"389\" data-end=\"617\"\u003eCu o putere de 21W și LED integrat, VERTEX FUSION  permite comutarea între trei temperaturi de culoare – caldă (3000K), neutră (4000K) și rece (6000K) – pentru a adapta atmosfera în funcție de momentul zilei sau activitatea desfășurată.\u003c\/p\u003e\u003cp data-start=\"619\" data-end=\"934\"\u003e\u003cstrong data-start=\"619\" data-end=\"649\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003cbr data-start=\"649\" data-end=\"652\"\u003e– Design cu 3 cercuri interconectate, finisaj alb\/negru\u003cbr data-start=\"707\" data-end=\"710\"\u003e– Putere 21W, LED integrat eficient energetic\u003cbr data-start=\"755\" data-end=\"758\"\u003e– Lumină reglabilă: rece \/ neutră \/ caldă\u003cbr data-start=\"799\" data-end=\"802\"\u003e– Construcție solidă din metal, durabilă și ușor de întreținut\u003cbr data-start=\"864\" data-end=\"867\"\u003e– Ideală pentru dormitoare, holuri, birouri sau spații de trecere\u003c\/p\u003e\u003cp data-start=\"936\" data-end=\"1077\" data-is-last-node=\"\" data-is-only-node=\"\"\u003eVERTEX FUSION  este o alegere practică și stilizată pentru cei care doresc un corp de iluminat modern, cu impact vizual și funcționalitate versatilă.\u003c\/p\u003e","published_at":"2025-07-18T11:25:47+03:00","created_at":"2025-07-18T11:18:09+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428546703627,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL565","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":10633428730123,"created_at":"2025-09-30T14:16:34+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57445246042379,"created_at":"2025-07-18T11:24:51+03:00","position":1,"updated_at":"2025-07-18T11:24:55+03:00","product_id":10633428730123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_069951be-3070-43c9-abd7-e56bcd0ffe26.png?v=1752827095","width":1468,"height":1468},{"id":64131183149323,"created_at":"2026-01-05T15:47:43+02:00","position":2,"updated_at":"2026-01-05T15:47:47+02:00","product_id":10633428730123,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL565_EPREL.png?v=1767620867","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756782919947,"title":"Lustra LED MODERNA 26W, Dimensiune 19.5x19.5, Patrata, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-moderna-26w-19-5x19-5-patrata-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:243\"\u003e\u003cstrong\u003eLustra LED MODERNA\u003c\/strong\u003e este o piesă de iluminat compactă și versatilă, cu o \u003cstrong\u003eputere de 26W\u003c\/strong\u003e. Designul său alb și posibilitatea de a alege între lumină rece, caldă sau neutră o fac potrivită pentru diverse spații și preferințe.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:299\"\u003eAvând un \u003cstrong\u003edimensiunea de 19.5x19.5\u003c\/strong\u003e, este ideală pentru a ilumina zone mai mici, cum ar fi holuri, băi, deasupra unei mese laterale sau ca iluminat suplimentar. \u003cstrong\u003ePuterea de 26W\u003c\/strong\u003e oferă o lumină suficientă pentru aceste scopuri. Finisajul alb îi conferă un aspect curat și ușor de integrat în orice stil de decor.\u003c\/p\u003e\u003ch6\u003e\n\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\" style=\"font-size: 0.875rem;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\" style=\"font-size: 0.875rem;\"\u003e\u003cbr\u003e\n\u003c\/h6\u003e","published_at":"2025-02-24T11:48:48+02:00","created_at":"2025-02-24T11:48:46+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52427998101771,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL493WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"89.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9756782919947,"created_at":"2025-09-30T11:45:44+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51810153234699,"created_at":"2025-02-24T11:48:50+02:00","position":1,"updated_at":"2025-07-21T11:10:13+03:00","product_id":9756782919947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-moderna-41w_LL1767AL_02.webp?v=1753085413","width":900,"height":900},{"id":51810153103627,"created_at":"2025-02-24T11:48:49+02:00","position":2,"updated_at":"2025-07-21T11:10:13+03:00","product_id":9756782919947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-moderna-41w_LL1767AL_01.webp?v=1753085413","width":900,"height":900},{"id":59040465649931,"created_at":"2025-08-12T17:29:35+03:00","position":3,"updated_at":"2026-07-20T16:45:25+03:00","product_id":9756782919947,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MODERNA_26W_Dimensiune_19.5x19.5_Patrata_lumina_Rece_Calda_Neutra_Alb_6.jpg?v=1784555125","width":792,"height":792},{"id":59040448217355,"created_at":"2025-08-12T17:28:36+03:00","position":4,"updated_at":"2026-07-20T16:45:13+03:00","product_id":9756782919947,"variant_ids":[],"sr