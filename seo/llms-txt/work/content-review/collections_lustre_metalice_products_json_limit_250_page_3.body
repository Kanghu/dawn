\/5175\/3739\/files\/0ade918a-59cb-4151-81c0-c2383bcc34c5_deb51613-56e0-4a6c-a3b2-7da9f6e1b5d0.png?v=1779275972","width":1024,"height":1024},{"id":68987449114891,"created_at":"2026-05-20T14:18:27+03:00","position":5,"updated_at":"2026-05-20T14:18:32+03:00","product_id":9779347489035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage20mai2026_14_15_49.png?v=1779275912","width":1254,"height":1254},{"id":66029095158027,"created_at":"2026-02-19T15:48:11+02:00","position":6,"updated_at":"2026-02-19T15:48:15+02:00","product_id":9779347489035,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT860_4WH_EPREL.png?v=1771508895","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779347652875,"title":"Lustra LED Astrid cu Telecomanda, 134W, Dimabil, Alb","handle":"lustra-led-astrid-cu-telecomanda-134w-dimabil-alb","body_html":"\u003cp\u003eLustra LED Astrid cu telecomanda are o putere de \u003cstrong data-start=\"49\" data-end=\"57\"\u003e134W\u003c\/strong\u003e si un flux luminos de \u003cstrong data-start=\"80\" data-end=\"91\"\u003e10.720lm\u003c\/strong\u003e, oferind iluminare reglabila in trei temperaturi de culoare: \u003cstrong data-start=\"153\" data-end=\"178\"\u003e3000K, 4000K si 6000K\u003c\/strong\u003e (calda, rece, neutra). Este echipata cu \u003cstrong data-start=\"219\" data-end=\"232\"\u003ebanda LED\u003c\/strong\u003e, are o durata de viata de \u003cstrong data-start=\"259\" data-end=\"273\"\u003e25.000 ore\u003c\/strong\u003e si functioneaza la \u003cstrong data-start=\"293\" data-end=\"305\"\u003e220–230V\u003c\/strong\u003e. Controlul se face prin \u003cstrong data-start=\"330\" data-end=\"369\"\u003etelecomanda sau intrerupator clasic\u003c\/strong\u003e, fiind complet \u003cstrong data-start=\"385\" data-end=\"397\"\u003edimabila\u003c\/strong\u003e. Corpul este construit din \u003cstrong data-start=\"425\" data-end=\"443\"\u003emetal si acril\u003c\/strong\u003e, cu montaj pe \u003cstrong data-start=\"458\" data-end=\"467\"\u003etavan\u003c\/strong\u003e. Protectia este de tip \u003cstrong data-start=\"491\" data-end=\"499\"\u003eIP20\u003c\/strong\u003e, iar alimentarea se face direct \u003cstrong data-start=\"532\" data-end=\"544\"\u003ela retea\u003c\/strong\u003e. Recomandata pentru \u003cstrong data-start=\"565\" data-end=\"596\"\u003edormitor, dining sau living\u003c\/strong\u003e.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-18T15:46:33+03:00","created_at":"2025-03-06T18:45:10+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52428099354891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT862\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"344.99","grams":0,"compare_at_price":"259.99","position":1,"product_id":9779347652875,"created_at":"2025-09-30T12:27:02+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56544073187595,"created_at":"2025-06-18T16:08:00+03:00","position":1,"updated_at":"2025-06-18T16:08:08+03:00","product_id":9779347652875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT8625WH-LustraLEDAstridcuTelecomanda_114W_Dimabil_Alb-6.png?v=1750252088","width":1080,"height":1080},{"id":56543242715403,"created_at":"2025-06-18T15:42:00+03:00","position":2,"updated_at":"2025-06-18T16:08:08+03:00","produc