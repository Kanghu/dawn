/files\/1\/0782\/5175\/3739\/files\/mockup-LT073_2BK-LustraLEDcutelecomandasicristalNOVAROTONDA29W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_Negru_5.jpg?v=1751764502","width":1080,"height":1080},{"id":57102078181643,"created_at":"2025-07-06T04:14:41+03:00","position":7,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT073_2BK-LustraLEDcutelecomandasicristalNOVAROTONDA29W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_Negru_4.jpg?v=1751764502","width":1080,"height":1080},{"id":51849508290827,"created_at":"2025-02-25T02:32:27+02:00","position":8,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-raiden-48w-dimabila-alb-negru-1695717075.webp?v=1751764502","width":900,"height":900},{"id":51849508159755,"created_at":"2025-02-25T02:32:27+02:00","position":9,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-raiden_6041b-2bk_cr_02-1695717075.webp?v=1751764502","width":900,"height":900},{"id":51849508192523,"created_at":"2025-02-25T02:32:27+02:00","position":10,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-raiden_6041b-2bk_cr_03-1695717075.webp?v=1751764502","width":900,"height":900},{"id":51849508487435,"created_at":"2025-02-25T02:32:27+02:00","position":11,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-raiden_6041b-2bk_cr_04-1695717076.webp?v=1751764502","width":900,"height":900},{"id":51849508028683,"created_at":"2025-02-25T02:32:27+02:00","position":12,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-raiden_6041b-2bk_cr_05-1695717076.webp?v=1751764502","width":900,"height":900},{"id":51849509470475,"created_at":"2025-02-25T02:32:27+02:00","position":13,"updated_at":"2025-07-06T04:15:02+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-raiden_6041b-2bk_cr_06-1695717076.webp?v=1751764502","width":900,"height":900},{"id":68425686384907,"created_at":"2026-04-22T13:37:23+03:00","position":14,"updated_at":"2026-04-22T13:37:26+03:00","product_id":9760451920139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2697481_big_color.svg?v=1776854246","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760453230859,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA 34W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-nova-rotonda-29w-2-cercuri-lumina-rece-calda-neutra-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:249\"\u003eLustra LED Cristal cu telecomandă NOVA ROTONDA este o combinație elegantă de modernitate și strălucire. Cu o putere de 29W și un design format din două cercuri concentrice, finisate în alb, această lustră adaugă o notă sofisticată oricărui interior.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:394\"\u003eCele două cercuri sunt decorate cu cristale transparente, care captează și reflectă lumina LED integrată, creând un efect vizual sclipitor și atrăgător. Telecomanda inclusă îți oferă control deplin asupra iluminării: poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare) sau neutră (pentru iluminare generală), adaptând lumina perfect nevoilor tale.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:221\"\u003eFinisajul alb al structurii conferă lustrei un aspect curat și versatil, ușor de integrat în diverse stiluri de decor. Designul cu două cercuri rotunde aduce un echilibru vizual plăcut și o distribuție uniformă a luminii.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:198\"\u003eCu o putere de 29W, este potrivită pentru a ilumina eficient spații de dimensiuni mici sau medii, cum ar fi livinguri, dormitoare sau holuri, adăugând un plus de eleganță prin elementele de cristal.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:32:32+02:00","created_at":"2025-02-25T02:32:32+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52428071993611,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT073\/2WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9760453230859,"created_at":"2025-09-30T12:16:06+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":62781830988043,"created_at":"2025-11-27T14:24:18+02:00","position":1,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Nov_27_2025_02_24_05_PM.png?v=1764246285","width":1024,"height":1024},{"id":51849529393419,"created_at":"2025-02-25T02:32:35+02:00","position":2,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-reese_6041b-2wh_cr_06-1695902689.webp?v=1764246285","width":900,"height":900},{"id":51849529327883,"created_at":"2025-02-25T02:32:35+02:00","position":3,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-reese_6041b-2wh_cr_02-1695902688.webp?v=1764246285","width":900,"height":900},{"id":51849529753867,"created_at":"2025-02-25T02:32:35+02:00","position":4,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-reese_6041b-2wh_cr_03-1695902689.webp?v=1764246285","width":900,"height":900},{"id":51849529131275,"created_at":"2025-02-25T02:32:35+02:00","position":5,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-reese_6041b-2wh_cr_04-1695902689.webp?v=1764246285","width":900,"height":900},{"id":51849529590027,"created_at":"2025-02-25T02:32:35+02:00","position":6,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-reese_6041b-2wh_cr_05-1695902689.webp?v=1764246285","width":900,"height":900},{"id":51849529295115,"created_at":"2025-02-25T02:32:35+02:00","position":7,"updated_at":"2025-11-27T14:24:45+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-reese-48w-dimabila-alb-1695902688.webp?v=1764246285","width":900,"height":900},{"id":64442688602379,"created_at":"2026-01-16T14:42:54+02:00","position":8,"updated_at":"2026-01-16T14:42:58+02:00","product_id":9760453230859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT073_2WH_EPREL.png?v=1768567378","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760477774091,"title":"Lustra LED cu telecomanda si cristal JUSTIN RGB 106W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-justin-rgb-106w-3-patrate-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperă Lustra LED Cristal RGB cu Telecomandă Justin, o piesă de iluminat cu design spectaculos și versatilitate uluitoare. Cu o putere impresionantă de 106W și capacitatea de a regla luminozitatea, această lustră oferă iluminatul perfect pentru a transforma orice spațiu într-un loc unic și fascinant. Designul său cu 3 pătrate suprapuse și finisajul argintiu adaugă un element modern și sofisticat.\u003cbr\u003e\u003cbr\u003eLustra Justin vine cu 4 surse de iluminat diferite, oferind o gamă variată de opțiuni de lumină:\u003cbr\u003e\u003cbr\u003e1. Lumină Caldă: Ideală pentru a crea o atmosferă primitoare și relaxantă în living sau dormitor.\u003cbr\u003e\u003cbr\u003e2. Lumină Neutră: Versatilă și potrivită pentru spații de zi sau camere multifuncționale.\u003cbr\u003e\u003cbr\u003e3. Lumină Rece: Perfectă pentru spațiile de lucru sau zonele unde este necesar un iluminat mai intens.\u003cbr\u003e\u003cbr\u003e4. Funcție RGB: Această funcție îți permite să alegi dintr-o gamă largă de culori pentru a crea o atmosferă personalizată și captivantă. Poți ajusta culorile pentru a se potrivi cu starea de spirit sau evenimentul din moment.\u003cbr\u003e\u003cbr\u003eTelecomanda inclusă face controlul luminii și culorilor un proces ușor și convenabil. Alege între culori vibrante sau tonuri calde și neutre pentru a crea efecte vizuale uluitoare în camera ta. Cu un flux luminos de 8480 de lumeni, Lustra LED Cristal RGB Justin nu numai că oferă iluminat suficient pentru spațiul tău, ci și transformă fiecare moment într-o experiență captivantă. Această lustră nu este doar o sursă de lumină, ci și o operă de artă care adaugă farmec și caracter decorului tău. Alege Lustra LED Cristal RGB cu Telecomandă Justin pentru a adăuga magie și inovație în casa ta. Cu această lustră, vei transforma orice spațiu într-un mediu unic și fascinant, perfect adaptat gusturilor tale și nevoilor tale de iluminat.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:36:10+02:00","created_at":"2025-02-25T02:36:09+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52351406244107,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-L7965D\/3CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"319.99","grams":0,"compare_at_price":"449.99","position":1,"product_id":9760477774091,"created_at":"2025-09-10T16:58:53+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51849928048907,"created_at":"2025-02-25T02:36:11+02:00","position":1,"updated_at":"2025-02-25T02:36:12+02:00","product_id":9760477774091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-rgb-cu-telecomanda-justin-106w-dimabila-argintiu-1695905474.webp?v=1740443772","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760553369867,"title":"Lustra LED suspendata cu telecomanda si cristal ROGER 150W, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-roger-150w-3-cercuri-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eAdăugați un strop de lux și funcționalitate încăperilor dvs. cu Lusta LED cu Telecomandă ROGER Această piesă de iluminat este concepută pentru a combina eleganța cu tehnologia modernă, oferind nu doar lumină, ci și un element central spectaculos în decorul oricărui spațiu. Cu finisajul său strălucitor auriu și cristalele care reflectă lumina, lustra Rodrigo este perfectă pentru cei care caută să combine stilul sofisticat cu inovația tehnologică.\u003cbr\u003e\u003cbr\u003eLustra ROGER este un adevărat punct de atracție, datorită designului său modern format din trei cercuri cu diametre de 60, 40 și 20 cm. Acest design îndrăzneț și aerisit se potrivește perfect într-o varietate de medii, de la cele rezidențiale până la spațiile comerciale sau de birouri care necesită un factor de impresionare vizuală.\u003cbr\u003e\u003cbr\u003eCu o putere impresionantă de 150W, această lustră LED este suficient de puternică pentru a ilumina spații mari, iar funcționalitatea sa dimabilă permite ajustarea intensității luminoase pentru orice situație sau dispoziție. Mai mult, grație telecomenzii incluse, aveți controlul complet asupra iluminării, putând schimba temperatura culorii luminii între caldă, rece și neutră, în funcție de necesitățile și preferințele dvs.\u003cbr\u003e\u003cbr\u003eÎnălțimea totală de 100 cm face ca lustra ROGER să fie ideală pentru plafonările înalte, dar și pentru zonele de living sau săli de conferințe, adăugând un impact vizual substanțial. Plusul de eleganță este oferit de cristalele incluse în design, care dispersează lumina creând un efect desăvârșit și un joc de lumini captivant.\u003cbr\u003e\u003cbr\u003eInstalarea este simplă, iar lustra ROGER va deveni rapid elementul central al oricărei încăperi, emanând o luminozitate caldă și invitândă, sau o lumină proaspătă și dinamică, în funcție de alegerea dvs. Alegeți Lustra LED cu Telecomandă Rodrigo pentru o combinație irezistibilă de frumusețe, stil și tehnologie de ultimă oră, care transformă orice spațiu într-un loc memorabil.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:48:33+02:00","created_at":"2025-02-25T02:48:33+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52424071905547,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8963\/60+40+20","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"999.99","grams":0,"compare_at_price":"1399.99","position":1,"product_id":9760553369867,"created_at":"2025-09-29T13:26:00+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851108417803,"created_at":"2025-02-25T02:48:34+02:00","position":1,"updated_at":"2025-02-25T02:48:36+02:00","product_id":9760553369867,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-rodrigo-150w-dimabila-auriu-1699526704.webp?v=1740444516","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760553468171,"title":"Lustra LED suspendata cu telecomanda si cristal ROGER 100W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-roger-100w-2-cercuri-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți farmecul contemporan cu Lustra LED cu Telecomanda Roger, o piesă de iluminat care îmbină eleganța clasică cu tehnologia modernă. Această lustră este ideală pentru orice spațiu rezidențial sau comercial, oferind nu doar lumină, ci și un puternic punct de interes vizual.\u003cbr\u003e\u003cbr\u003eLustra Roger, cu o putere de 100W, oferă o sursă de lumină generoasă și este dimabilă, permițându-vă să ajustați intensitatea luminoasă după nevoi și momentul zilei. Fie că organizați o cină romantică sau aveți nevoie de lumină puternică pentru activități, această lustră se adaptează perfect.\u003cbr\u003e\u003cbr\u003eAcoperită într-o nuanță sofisticată de auriu, lustra adaugă o notă de lux și căldură oricărui interior. Diametrul cercurilor de 50 cm și 30 cm oferă un design geometric atractiv, ce îmbină liniile curate cu strălucirea discretă a cristalelor incorporate, pentru a capta și refracta lumina într-un joc splendid de scântei.\u003cbr\u003e\u003cbr\u003eCu o înălțime totală de 100cm, lustra Roger este o declarație de stil, oferind amplitudine oricărui spațiu, de la sufragerii la săli de conferință. Telecomanda inclusă oferă comoditate suplimentară, permițându-vă să schimbați între cele trei tipuri de lumină – caldă, rece și neutră – pentru a crea atmosfera perfectă pentru orice ocazie.\u003cbr\u003e\u003cbr\u003eDesignul său unic, cu modelul de cristale, captează atenția și îmbogățește estetica camerei, făcând din Lustra Roger centrul atenției. Este nu doar o sursă de iluminare, ci și o piesă de artă ce contribuie la ambianța generală a spațiului dvs.\u003cbr\u003e\u003cbr\u003ePentru cei care caută un echilibru între funcționalitate și stil, Lustra LED cu Telecomanda Roger este alegerea perfectă. Aduceți o notă de rafinament și versatilitate în casa sau biroul dvs. cu această lustră impresionantă și reglați lumina după bunul plac, pentru a reflecta stilul și personalitatea dvs.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:48:39+02:00","created_at":"2025-02-25T02:48:38+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52409389646091,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8963\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"779.99","grams":0,"compare_at_price":"1099.99","position":1,"product_id":9760553468171,"created_at":"2025-09-24T18:14:13+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851109105931,"created_at":"2025-02-25T02:48:40+02:00","position":1,"updated_at":"2025-02-25T02:48:41+02:00","product_id":9760553468171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-roger-100w-dimabila-auriu-1699526712.webp?v=1740444521","width":900,"height":900},{"id":62780024553739,"created_at":"2025-11-27T12:36:02+02:00","position":2,"updated_at":"2025-11-27T12:37:33+02:00","product_id":9760553468171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hf4aafd8e66334f3eb390e4e4de3f3d47B.jpg?v=1764239853","width":710,"height":710},{"id":62780024488203,"created_at":"2025-11-27T12:36:02+02:00","position":3,"updated_at":"2025-11-27T12:37:33+02:00","product_id":9760553468171,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Hbcc5ff4669504ac5ba92798f33fd6112c.jpg?v=1764239853","width":800,"height":800}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760553664779,"title":"Lustra LED suspendata cu telecomanda si cristal ROGER 80W, 1 Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-roger-80w-1-cerc-lumina-rece-calda-neutra-dimabila-auriu-lucios-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eEleganța întâlnește inovația în designul lustrei LED cu Telecomanda ROGER transformând orice cameră într-un sanctuar de stil și confort vizual. Cu o putere impresionantă de 80W, această piesă centrală dimabilă este concepută pentru a oferi nu doar iluminare, ci și pentru a deveni punctul focal al decorului dumneavoastră interior.\u003cbr\u003e\u003cbr\u003ePictată în nuanțe somptuoase de auriu, lustra ROGER iradiază căldură și rafinament, fiind perfectă pentru cei care doresc să adauge o notă de opulență spațiilor lor de locuit sau de lucru. Datorită caracteristicii dimabile, puteți controla intensitatea luminii pentru a se potrivi cu orice moment al zilei sau pentru a se adapta la orice eveniment, de la întâlniri intime până la întâlniri sociale vibrante.\u003cbr\u003e\u003cbr\u003eCu un diametru de 40 cm, lustra ROGER se impune prin prezența sa îndrăzneață, oferind un echilibru perfect între sofisticare și funcționalitate. Înălțimea totală de 100 cm asigură o dispersie excelentă a luminii, iar cristalele incluse adaugă un nivel suplimentar de lux, captând și refractând lumina pentru a crea un efect desăvârșit de scânteiere și strălucire.\u003cbr\u003e\u003cbr\u003eFurnizată cu o telecomandă, lustra vă permite să schimbați cu ușurință între cele trei tipuri de lumină - caldă, rece și neutră - pentru a echilibra ambiția estetică cu nevoile practice de iluminare. Fie că doriți să creați o atmosferă relaxantă sau să iluminați eficient un spațiu de lucru, lustra Reed se adaptează perfect cerințelor dumneavoastră.\u003cbr\u003e\u003cbr\u003eAceastă lustră LED cu telecomandă este mai mult decât o sursă de lumină; este o declarație de design care îmbogățește decorul și îmbunătățește experiența de a fi acasă sau la birou. Alegeți Lustra LED cu Telecomanda ROGER pentru a aduce un strop de magie luminoasă și pentru a transforma orice încăpere într-un spațiu captivant și elegant\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-04-03T23:54:18+03:00","created_at":"2025-02-25T02:48:43+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52420977099019,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-8963\/1","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"399.99","grams":0,"compare_at_price":"559.99","position":1,"product_id":9760553664779,"created_at":"2025-09-28T07:47:27+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851110547723,"created_at":"2025-02-25T02:48:45+02:00","position":1,"updated_at":"2025-02-25T02:48:46+02:00","product_id":9760553664779,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-cu-telecomanda-reed-80w-dimabila-auriu-1699526721.webp?v=1740444526","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760553763083,"title":"Lustra LED MARIO 24W, lumina Rece\/Calda\/Neutra Alb Negru","handle":"lustra-led-mario-24w-lumina-rece-calda-neutra-alb-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți eleganța minimalistă întâlnită cu inovația în iluminare cu Lustra LED Mario. Această piesă contemporană de design aduce o notă modernă și eficientă oricărui spațiu, devenind o alegere excelentă pentru cei ce caută un echilibru între funcționalitate și estetică. Cu dimensiuni compacte și o formă geometrică simplă, această lustră este ideală pentru iluminarea și accentuarea spațiilor mici și medii, oferind totodată un impact vizual impresionant.\u003cbr\u003e\u003cbr\u003eLustra Mario cu o putere de 24W și finisajul său alb-negru, se încadrează perfect într-o varietate largă de scheme de design interior, de la cele ultra-moderne până la cele mai tradiționale. Jocul de contrast între albul pur și negrul profund adaugă un nivel de sofisticare și stil care se potrivește în orice cameră, fie că este vorba de un living, o bucătărie, un birou sau chiar o zonă de primire.\u003cbr\u003e\u003cbr\u003eUnul dintre cele mai mari avantaje ale lustra LED Mario este varietatea opțiunilor de iluminare. Cu cele trei tipuri de lumină – caldă, rece și neutră – puteți crea ambientul perfect pentru orice moment al zilei sau pentru orice eveniment. Schimbarea temperaturii culorii luminii se face cu ușurință, permițându-vă să ajustați atmosfera din cameră conform preferințelor personale sau necesităților de moment.\u003cbr\u003e\u003cbr\u003eDimensiunile de 24 cm lungime și 18 cm lățime fac ca această lustră să fie extrem de versatilă în ceea ce privește plasarea în spații cu dimensiuni variate. Montarea este simplă și intuitivă, ceea ce înseamnă că puteți bucura rapid de noua sursă de iluminat, fără a necesita serviciile unui electrician profesionist.\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED Mario pentru a aduce un stil actual și performanță în iluminatul casei sau biroului dvs. Cu acest corp de iluminat, veți beneficia nu numai de un aspect estetic plăcut, dar și de funcționalitatea LED-urilor de ultimă generație, care sunt cunoscute pentru durabilitatea și eficiența lor energetică. Fie că vă relaxați, lucrați sau găzduiți, lustra LED Mario este alegerea inteligentă care luminează fiecare moment al zilei\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2026-06-14T21:39:52+03:00","created_at":"2025-02-25T02:48:49+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52105275998475,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-9082R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":9760553763083,"created_at":"2025-08-21T13:55:54+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851111956747,"created_at":"2025-02-25T02:48:50+02:00","position":1,"updated_at":"2025-02-25T02:48:53+02:00","product_id":9760553763083,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-mario-24w-alb-negru-1699527488.webp?v=1740444533","width":900,"height":900},{"id":51851111661835,"created_at":"2025-02-25T02:48:51+02:00","position":2,"updated_at":"2025-02-25T02:48:52+02:00","product_id":9760553763083,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-mario_9082r_02-1699527489.webp?v=1740444532","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760556744971,"title":"Lustra LED cu telecomanda JAYSON 57W, 8 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu Lucios","handle":"lustra-led-cu-telecomanda-jayson-57w-8-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu-lucios","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED cu Telecomandă JAYSON este o piesă de iluminat ultramodernă și multifuncțională, ideală pentru a aduce în casa dumneavoastră nu doar lumină, ci și un design inovator. Cu o putere de 72W și dimensiuni generoase de 85cm lungime și 20cm înălțime, această lustră este perfectă pentru a completa spații ample precum livinguri, săli de mese sau spații de birou deschise.\u003cbr\u003e\u003cbr\u003eLustra JAYSON se distinge prin capacitatea sa de a oferi trei tipuri diferite de lumină: caldă, rece și neutră, permițându-vă să ajustați cu ușurință atmosfera camerei în funcție de activitățile desfășurate sau de starea de spirit dorită. În plus, cu cele 8 surse de lumină, această lustră asigură o dispersie echilibrată a luminii în întreaga încăpere.\u003cbr\u003e\u003cbr\u003eDesignul său este atât de elegant, cât și funcțional, cu o structură ce permite o iluminare optimă. Dimabilitatea este un alt avantaj important, oferindu-vă posibilitatea de a modula intensitatea luminii după preferințe, fie că aveți nevoie de o iluminare subtilă pentru o seară relaxantă, fie că preferați o lumină puternică pentru a lucra.\u003cbr\u003e\u003cbr\u003eTelecomanda inclusă adaugă un nivel suplimentar de comoditate, permițându-vă să schimbați setările de iluminare fără a vă ridica de pe canapea sau de la birou. Această caracteristică face din Lustra LED JAYSON o opțiune de iluminat ce se potrivește perfect cu stilul de viață modern și dinamic.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003cbr\u003e\u003cbr\u003eAlegând Lustra LED cu Telecomandă Jayson, investiți într-un accesoriu de iluminat ce nu doar că va satisface nevoile dvs. de lumină, dar va și îmbunătăți aspectul general al locuinței dvs. Cu un design contemporan și performanțe ridicate, această lustră este o adiție valoroasă pentru orice interior modern.\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:50:38+02:00","created_at":"2025-02-25T02:50:37+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52122222854411,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-7815\/8","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"279.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9760556744971,"created_at":"2025-08-25T20:55:11+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851136073995,"created_at":"2025-02-25T02:50:40+02:00","position":1,"updated_at":"2025-02-25T02:50:41+02:00","product_id":9760556744971,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-jayson-57w-dimabila-alb-negru-1738412852.webp?v=1740444641","width":1024,"height":1024},{"id":51851135942923,"created_at":"2025-02-25T02:50:40+02:00","position":2,"updated_at":"2025-03-14T14:54:17+02:00","product_id":9760556744971,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-jayson-72w-dimabila-alb-negru-1699889214-_1_-1738412852.webp?v=1741956857","width":893,"height":893}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760556908811,"title":"Lustra LED cu telecomanda JAYSON  72W, 6 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Negru Auriu Lucios","handle":"lustra-led-cu-telecomanda-jayson-72w-6-elemente-lumina-rece-calda-neutra-dimabila-negru-auriu-lucios","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eExperimentați iluminatul modern la superlativ cu Lustra LED cu Telecomandă JAYSON  Această piesă de design contemporan nu este doar o sursă de iluminat, ci un element de decor ce aduce un plus de caracter și stil oricărui spațiu interior. Cu o lungime de 61cm și o înălțime de 20cm, această lustră elegantă este echipată cu 72W putere, fiind perfectă pentru zonele de living, spațiile de lucru sau ca un accent central în holurile de intrare.\u003cbr\u003e\u003cbr\u003eLustra JAYSON  se remarcă prin funcționalitatea sa versatilă, oferind trei tipuri de lumină – caldă, rece și neutră – ce pot fi schimbate ușor cu ajutorul telecomenzii incluse. Acest lucru vă permite să personalizați lumina în funcție de momentul zilei sau de activitatea pe care o desfășurați, creând atmosfera perfectă în orice ocazie.\u003cbr\u003e\u003cbr\u003eDesignul inovativ include 6 surse de lumină și tije de culoare neagră care adaugă un contrast îndrăzneț și un aspect grafic încăperii dvs. Acest look modern este completat de capacitatea de a dima lumina, care vă oferă controlul complet asupra intensității luminoase, de la o strălucire suavă și până la o lumină puternică și vibrantă.\u003cbr\u003e\u003cbr\u003eInstalarea Lustrei LED JAYSON este simplă și intuitivă, ceea ce înseamnă că puteți să vă bucurați de noua dvs. piesă de iluminat fără eforturi majore. Cu un design elegant și performanța LED-urilor de ultimă generație, această lustră este perfectă pentru cei care caută un echilibru între estetică și eficiență energetică.\u003cbr\u003e\u003cbr\u003eAdoptând Lustra LED cu Telecomandă JAYSON în decorul dvs., optați pentru o combinație perfectă între stilul contemporan și tehnologia avansată. Este alegerea ideală pentru a aduce un plus de lumină și modernitate în viața de zi cu zi, transformând orice cameră într-un spațiu încântător și funcțional.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:50:44+02:00","created_at":"2025-02-25T02:50:44+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52038379667723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-7815\/6","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"369.99","grams":0,"compare_at_price":"369.99","position":1,"product_id":9760556908811,"created_at":"2025-08-05T15:33:57+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851136434443,"created_at":"2025-02-25T02:50:45+02:00","position":1,"updated_at":"2025-02-25T02:50:47+02:00","product_id":9760556908811,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cu-telecomanda-jensen-72w-dimabila-alb-negru-1699889686.webp?v=1740444647","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760572145931,"title":"Lustra LED CADE 34W, 4 Elemente,  Liniara, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-cade-54w-4-elemente-liniara-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:277\"\u003eLustra LED Cade de 34W, în combinația elegantă de alb și negru, este un corp de iluminat modern care adaugă un contrast vizual interesant oricărui spațiu. Designul său poate varia, dar de obicei prezintă forme geometrice sau linii clare, accentuate de această paletă cromatică.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:46\"\u003e\u003cstrong\u003eAltfel spus, iată ce oferă această lustră:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:218\"\u003e\n\u003cstrong\u003eIluminare eficientă:\u003c\/strong\u003e Cu o putere de 34W, asigură o lumină suficientă pentru a ilumina confortabil o cameră de dimensiuni medii. Tehnologia LED înseamnă un consum redus de energie și o durată de viață îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:172\"\u003e\n\u003cstrong\u003eEstetică modernă:\u003c\/strong\u003e Contrastul dintre alb și negru este întotdeauna la modă și se integrează bine în diverse stiluri de design interior, de la minimalist la industrial.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:124\"\u003e\n\u003cstrong\u003ePunct focal:\u003c\/strong\u003e Datorită aspectului său distinctiv, această lustră poate deveni un element central atrăgător în încăpere.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"1:1-1:277\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:52:58+02:00","created_at":"2025-02-25T02:52:57+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52405835825419,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-AL301BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"159.99","grams":0,"compare_at_price":"189.99","position":1,"product_id":9760572145931,"created_at":"2025-09-23T17:53:38+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851377344779,"created_at":"2025-02-25T02:52:59+02:00","position":1,"updated_at":"2025-02-25T02:53:01+02:00","product_id":9760572145931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cade-22w-alb-negru-1701336237.webp?v=1740444781","width":900,"height":900},{"id":51851378098443,"created_at":"2025-02-25T02:52:59+02:00","position":2,"updated_at":"2025-02-25T02:53:01+02:00","product_id":9760572145931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cade_al8001bk_02-1701336237.webp?v=1740444781","width":900,"height":900},{"id":63977152643339,"created_at":"2025-12-30T15:02:33+02:00","position":3,"updated_at":"2025-12-30T15:02:37+02:00","product_id":9760572145931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AL301BK_EPREL.png?v=1767099757","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760595312907,"title":"Lustra LED cu cristal JEREMIAH 48W, 2 Patrate, lumina Rece\/Calda\/Neutra, Crom Lucios","handle":"lustra-led-cu-cristal-jeremiah-48w-2-patrate-lumina-rece-calda-neutra-crom-lucios","body_html":"\u003cp\u003e\u003cstrong\u003eEleganță Strălucitoare într-o Formă Modernă: Lustra LED Cristal Jeremiah\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003eÎmbracă-ți spațiul cu un rafinament contemporan și o strălucire subtilă cu lustra LED Cristal Jeremiah. Designul său modern este accentuat de elemente din \u003cstrong\u003ecristal\u003c\/strong\u003e de înaltă calitate, integrate într-o structură cu finisaj \u003cstrong\u003eargintiu\u003c\/strong\u003e elegant, creând un punct focal luminos și sofisticat în orice încăpere.\u003c\/p\u003e\u003cp\u003eCu o putere de \u003cstrong\u003e48W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și plăcută, ideală pentru livinguri, dormitoare sau holuri moderne. Cristalele atent șlefuite refractă lumina, creând efecte vizuale încântătoare și adăugând o notă de lux subtil.\u003c\/p\u003e\u003cp\u003eFinisajul \u003cstrong\u003eargintiu\u003c\/strong\u003e al structurii conferă un aspect modern și versatil, ușor de integrat în diverse stiluri de interior, de la minimalist la contemporan sau chiar cu accente glamour.\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Structură argintie cu elemente din cristal strălucitor.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 48W pentru o iluminare optimă.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eStrălucire Subtilă:\u003c\/strong\u003e Cristalele refractă lumina creând efecte vizuale plăcute.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eFinisaj Argintiu:\u003c\/strong\u003e Aspect modern și versatil.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj argintiu și cristale premium.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eStil Modern și Sofisticat:\u003c\/strong\u003e Se integrează ușor în diverse stiluri de interior.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eAdaugă Eleganță Modernă:\u003c\/strong\u003e Designul argintiu și cristalele aduc un plus de stil.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eCreează o Atmosferă Luminoasă și Plăcută:\u003c\/strong\u003e Lumina difuzată prin cristale este caldă și primitoare.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePunct de Atractie Subtil:\u003c\/strong\u003e Designul modern, dar elegant, atrage privirile fără a fi copleșitor.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eUșor de Integrat în Decor:\u003c\/strong\u003e Finisajul argintiu se asortează cu diverse palete de culori.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eLustra LED Cristal Jeremiah este alegerea ideală pentru a adăuga o notă de eleganță modernă și o strălucire subtilă în casa ta. Bucură-te de designul rafinat și de iluminarea plăcută oferită de cristale și tehnologia LED!\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:55:31+02:00","created_at":"2025-02-25T02:55:30+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale"],"variants":[{"id":52416081625355,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL070\/2CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.99","grams":0,"compare_at_price":"219.99","position":1,"product_id":9760595312907,"created_at":"2025-09-26T18:09:17+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51851714658571,"created_at":"2025-02-25T02:55:35+02:00","position":1,"updated_at":"2025-02-25T02:55:37+02:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/aplica-led-cristal-jeremiah-32w-argintiu-1702642056.webp?v=1740444937","width":900,"height":900},{"id":51851715248395,"created_at":"2025-02-25T02:55:35+02:00","position":2,"updated_at":"2025-06-03T12:49:51+03:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-jeremiah_6186-2pch-05-1702642059.webp?v=1748944191","width":900,"height":900},{"id":51851714789643,"created_at":"2025-02-25T02:55:35+02:00","position":3,"updated_at":"2025-06-03T12:49:51+03:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-jeremiah_6186-2pch-02-1702642057.webp?v=1748944191","width":900,"height":900},{"id":51851714822411,"created_at":"2025-02-25T02:55:35+02:00","position":4,"updated_at":"2025-06-03T12:49:51+03:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-jeremiah_6186-2pch-03-1702642058.webp?v=1748944191","width":900,"height":900},{"id":51851715019019,"created_at":"2025-02-25T02:55:35+02:00","position":5,"updated_at":"2025-06-03T12:49:51+03:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-jeremiah_6186-2pch-04-1702642058.webp?v=1748944191","width":900,"height":900},{"id":63186208424203,"created_at":"2025-12-09T13:01:16+02:00","position":6,"updated_at":"2025-12-09T13:01:20+02:00","product_id":9760595312907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL070_2CH_EPREL.png?v=1765278080","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760744407307,"title":"Lustra LED suspendata AVION 148W, lumina Rece\/Calda\/Neutra, Argintiu","handle":"lustra-led-suspendata-avion-148w-lumina-rece-calda-neutra-argintiu","body_html":"\u003cp\u003e\u003cstrong\u003eLustra LED Suspendată Avion\u003c\/strong\u003e, argintiu, combină funcționalitatea modernă cu un design creativ, inspirat de avioane, perfectă pentru a aduce un plus de originalitate și stil în orice încăpere. Această lustră nu doar iluminează, ci și adaugă un element decorativ captivant, ideal pentru camerele copiilor sau spații moderne.\u003cbr\u003e\u003c\/p\u003e\u003cp\u003eCaracteristici principale:\u003cbr\u003e\u003cbr\u003e- **Design Creativ**: \u003cstrong\u003eForma de avion\u003c\/strong\u003e a lustrei adaugă un element de fantezie și aventură în camera copilului sau în orice spațiu creativ. Este ideală pentru camerele de copii, grădinițe sau spații de joacă, aducând un plus de personalitate și stil.\u003cbr\u003e\u003cbr\u003e- **Iluminare Eficientă**: Echipată cu tehnologie \u003cstrong\u003eLED \u003c\/strong\u003eavansată, lustra Avion oferă o iluminare puternică și uniformă. \u003cstrong\u003eLED\u003c\/strong\u003e-urile sunt cunoscute pentru durabilitatea lor și consumul redus de energie, contribuind la economii pe termen lung și la protejarea mediului.\u003cbr\u003e\u003cbr\u003e- **Culoare Alb-Gri**: \u003cstrong\u003eFinisajul argintiu \u003c\/strong\u003econferă lustrei un aspect modern și versatil, integrându-se armonios în diverse stiluri de decor interior. Această combinație de culori adaugă o notă de eleganță și contemporaneitate oricărei încăperi.\u003cbr\u003e\u003cbr\u003e- **Materiale Durabile**: Realizată din materiale de înaltă calitate, lustra Avion este construită pentru a rezista în timp, menținându-și atât funcționalitatea, cât și aspectul estetic. Materialele durabile asigură o utilizare sigură și de lungă durată.\u003cbr\u003e\u003cbr\u003e- **Montare Ușoară**: Lustra vine cu toate componentele necesare pentru o instalare simplă și rapidă. Instrucțiunile clare vă ajută să finalizați procesul de montare fără dificultăți, astfel încât să vă puteți bucura de noua dvs. sursă de iluminat cât mai curând posibil.\u003cbr\u003e\u003cbr\u003e\u003cstrong\u003eLustra LED Suspendată Avion\u003c\/strong\u003e, argintiu, este o alegere excelentă pentru cei care doresc să aducă un plus de creativitate și funcționalitate în spațiul lor. Cu designul său inovator și iluminarea eficientă, această lustră va transforma orice cameră într-un loc plin de imaginație și lumină.\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:18:04+02:00","created_at":"2025-02-25T03:18:03+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Copii","tags":["active","BLACKSEASON","Corpuri de Iluminat","Lustre Copii","Lustre LED"],"variants":[{"id":52411411267851,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-CP6522","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"799.99","grams":0,"compare_at_price":"799.99","position":1,"product_id":9760744407307,"created_at":"2025-09-25T12:03:36+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51854090928395,"created_at":"2025-02-25T03:18:05+02:00","position":1,"updated_at":"2025-03-14T14:51:40+02:00","product_id":9760744407307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-suspendata-74w-avion-alb-gri-1732545572.webp?v=1741956700","width":894,"height":894},{"id":51854090862859,"created_at":"2025-02-25T03:18:05+02:00","position":2,"updated_at":"2025-03-14T14:52:30+02:00","product_id":9760744407307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2-1732545572.webp?v=1741956750","width":1000,"height":1000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760744702219,"title":"Lustra LED SOLENA ROTONDA 13W, Diametru 25cm, lumina Rece\/Calda\/Neutra, Alb Negru","handle":"lustra-led-solena-rotonda-13w-diametru-25cm-lumina-rece-calda-neutra-alb-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:135\"\u003eAceastă lustră LED SOLENA Rotonda, cu un design alb-negru, are o putere de 13W și oferă o lumină reglabilă între rece, caldă și neutră.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-11:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:79\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 13W, ideală pentru iluminat ambiental sau pentru spații mai mici.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:127\"\u003e\n\u003cstrong\u003eDesign bicolor:\u003c\/strong\u003e Combinația de alb și negru oferă un aspect modern și contrastant. Forma rotondă adaugă un element clasic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:113\"\u003e\n\u003cstrong\u003eTip de lumină:\u003c\/strong\u003e Poți alege între lumină rece, caldă sau neutră, adaptând atmosfera în funcție de preferințe.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:84\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Asigură un consum redus de energie și o durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-9:58\"\u003e\n\u003cstrong\u003eFlux luminos:\u003c\/strong\u003e Oferă o iluminare plăcută și uniformă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-11:0\"\u003e\n\u003cstrong\u003eUșor de integrat:\u003c\/strong\u003e Designul său versatil se potrivește în diverse stiluri de interior.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"12:1-12:196\"\u003eAceastă lustră LED SOLENA Rotonda este o opțiune elegantă și eficientă pentru a ilumina diverse zone din locuința ta , oferind flexibilitatea de a alege temperatura de culoare potrivită.\u003c\/p\u003e\u003cp data-sourcepos=\"12:1-12:196\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:18:21+02:00","created_at":"2025-02-25T03:18:20+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52424574238987,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL500BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"69.99","grams":0,"compare_at_price":"89.99","position":1,"product_id":9760744702219,"created_at":"2025-09-29T16:26:45+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51854092009739,"created_at":"2025-02-25T03:18:23+02:00","position":1,"updated_at":"2025-02-25T03:18:24+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-14w-karmen-alb-1728546610.webp?v=1740446304","width":900,"height":900},{"id":51854092140811,"created_at":"2025-02-25T03:18:23+02:00","position":2,"updated_at":"2025-02-25T03:18:25+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H5328799ddd1646a29f277828f1bcbad0r-1728546610.webp?v=1740446305","width":900,"height":900},{"id":51854092370187,"created_at":"2025-02-25T03:18:23+02:00","position":3,"updated_at":"2025-02-25T03:18:25+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2-1726753684-1727029332.webp?v=1740446305","width":900,"height":900},{"id":51854092042507,"created_at":"2025-02-25T03:18:23+02:00","position":4,"updated_at":"2025-02-25T03:18:25+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/3-1726753236-1727029332.webp?v=1740446305","width":900,"height":900},{"id":51854092173579,"created_at":"2025-02-25T03:18:23+02:00","position":5,"updated_at":"2025-02-25T03:18:25+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/2-1726753236-1727029332.webp?v=1740446305","width":900,"height":900},{"id":51854092271883,"created_at":"2025-02-25T03:18:23+02:00","position":6,"updated_at":"2025-02-25T03:18:25+02:00","product_id":9760744702219,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1-1726753236-1727029332.webp?v=1740446305","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760765772043,"title":"Lustra LED cu telecomanda si cristal NOVA ROTONDA RGB 68W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-si-cristal-marina-rgb-68w-4-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv class=\"containerimg-mobile\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"1:1-1:288\"\u003eLustra LED cu telecomandă și cristale \u003cb\u003eNOVA ROTONDA RGB \u003c\/b\u003e este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 68W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:484\"\u003eCele patru cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:316\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 68W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e\u003ch3 style=\"text-align: center;\"\u003eVezi video demonstrativ\u003c\/h3\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; height: 0; padding-top: 56.25%;\" class=\"iframe-container rounded-corner centered\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"1:1-1:288\"\u003eLustra LED cu telecomandă și cristale MARINA RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 68W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:484\"\u003eCele patru cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:316\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 68W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003c\/p\u003e\n\u003cp data-sourcepos=\"1:1-1:288\"\u003eLustra LED cu telecomandă și cristale MARINA RGB este o piesă de iluminat modernă și spectaculoasă, cu un design format din 4 cercuri concentrice, finisate în negru și împodobite cu cristale strălucitoare. Cu o putere de 68W, oferă o iluminare versatilă și dinamică datorită funcției RGB.\u003c\/p\u003e\n\u003cp data-sourcepos=\"3:1-3:484\"\u003eCele patru cercuri negre, decorate cu cristale, creează un contrast elegant și sofisticat. Cristalele vor reflecta și refracta lumina LED integrată, generând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control nu doar asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), ci și asupra funcției \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă variată de culori pentru a crea efecte de iluminare personalizate și vibrante.\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:316\"\u003eFinisajul negru al structurii accentuează modernitatea designului și pune în valoare strălucirea cristalelor și posibilitățile oferite de iluminarea RGB. Cu o putere de 68W, este ideală pentru a ilumina livinguri, dormitoare sau alte încăperi unde se dorește un element de design cu impact și o atmosferă adaptabilă.\u003c\/p\u003e\n\u003ciframe title=\"Lustră LED Maroja RGB cu Telecomandă, 68W, Dimabilă, Crom\" style=\"position: absolute; top: 0; left: 0; width: 50%; height: 50%;\" src=\"https:\/\/www.youtube.com\/embed\/PRe0gjvBuDg\"\u003e\u003c\/iframe\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:23:19+02:00","created_at":"2025-02-25T03:23:19+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52428078809355,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT073\/4BKT","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"189.99","grams":0,"compare_at_price":"189.99","position":1,"product_id":9760765772043,"created_at":"2025-09-30T12:18:14+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55770810450187,"created_at":"2025-05-26T15:49:09+03:00","position":1,"updated_at":"2025-05-26T15:49:14+03:00","product_id":9760765772043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_b27f1dde-e33d-494b-939c-bf3a145d8ac5.webp?v=1748263754","width":1080,"height":1080},{"id":51854410613003,"created_at":"2025-02-25T03:23:21+02:00","position":2,"updated_at":"2025-05-26T15:49:14+03:00","product_id":9760765772043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2-1731316349.webp?v=1748263754","width":900,"height":900},{"id":51854411432203,"created_at":"2025-02-25T03:23:21+02:00","position":3,"updated_at":"2025-05-26T15:49:14+03:00","product_id":9760765772043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-marina-cu-telecomanda-68w-dimabila-acril-si-cristal-negru-1731333802.webp?v=1748263754","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760771440907,"title":"Lustra LED cu telecomanda si cristal ALANUBIS 80W, 5 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-alanubis-80w-5-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003e\u003cstrong\u003eLustra LED cu telecomandă ALANUBIS\u003c\/strong\u003e, de \u003cstrong\u003e80\u003c\/strong\u003e\u003cstrong\u003eW\u003c\/strong\u003e, este o piesă de iluminat modernă și elegantă, cu un design format din cinci cercuri concentrice, finisate într-un argintiu sofisticat. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eAceastă lustră oferă o iluminare versatilă, permițând alegerea între \u003cstrong\u003elumină rece\u003c\/strong\u003e, ideală pentru o atmosferă energizantă, \u003cstrong\u003elumină caldă\u003c\/strong\u003e, perfectă pentru relaxare, și \u003cstrong\u003elumină neutră\u003c\/strong\u003e, potrivită pentru activitățile de zi cu zi. Funcția de dimare, controlată prin telecomanda inclusă, îți oferă posibilitatea de a ajusta intensitatea luminii pentru a crea ambianța perfectă. \u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003eDesignul său cu cele \u003cstrong\u003ecinci cercuri argintii\u003c\/strong\u003e adaugă un plus de stil și modernitate oricărui interior, fiind potrivită pentru livinguri, sufragerii sau alte spații în care se dorește o lumină plăcută și un element de decor atrăgător. Cu o putere de \u003cstrong\u003e80\u003c\/strong\u003e\u003cstrong\u003eW\u003c\/strong\u003e, asigură o iluminare eficientă și suficientă pentru camere de dimensiuni medii spre mari.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:23:56+02:00","created_at":"2025-02-25T03:23:55+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52360583610635,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT080\/5","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":9760771440907,"created_at":"2025-09-12T16:40:38+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57847202218251,"created_at":"2025-07-25T13:14:08+03:00","position":1,"updated_at":"2025-07-25T13:14:11+03:00","product_id":9760771440907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT080_5-LustraLEDcutelecomandasicristalALANUBIS61W_5Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-1.jpg?v=1753438451","width":1080,"height":1080},{"id":57847259988235,"created_at":"2025-07-25T13:18:18+03:00","position":2,"updated_at":"2025-07-25T13:20:26+03:00","product_id":9760771440907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT0805-LustraLEDcutelecomandasicristalALANUBIS61W_5Cercuri_luminaReceCaldaNeutra_Dimabila_CromLucios-4.jpg?v=1753438826","width":1080,"height":1080},{"id":57847202251019,"created_at":"2025-07-25T13:14:08+03:00","position":3,"updated_at":"2025-07-25T13:20:26+03:00","product_id":9760771440907,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LT080_5-LustraLEDcutelecomandasicristalALANUBIS61W_5Cercuri_luminaRece_Calda_Neutra_Dimabila_CromLucios-2.jpg?v=1753438826","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760871022859,"title":"Lustra LED DOLIA, 101W, 50x50cm, lumina Rece\/Calda\/Neutra, Alb","handle":"lustra-led-dolia-101w-50x50cm-lumina-rece-calda-neutra-alb","body_html":"\u003cp\u003e\u003cstrong\u003eAdaugă un strop de eleganță și modernitate cu Lustra LED Dolia, 50 cm, un accesoriu perfect pentru livinguri, dormitoare sau spații comerciale. Designul său simplu și sofisticat, împreună cu iluminarea LED de 101W, oferă o atmosferă luminoasă și plăcută, completând perfect orice decor contemporan.\u003c\/strong\u003e\u003c\/p\u003e\u003cp\u003e\u003cstrong\u003eSpecificații:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDimensiuni:\u003c\/strong\u003e 50x50 cm\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 101W (eficient energetic)\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare:\u003c\/strong\u003e LED integrat, pentru o lumină clară și uniformă\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign:\u003c\/strong\u003e Alb, simplu și elegant, ideal pentru orice încăpere\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eIdeal pentru:\u003c\/strong\u003e Livinguri, dormitoare sau spații comerciale moderne\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eModel:\u003c\/strong\u003e Dolia\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/strong\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:42:30+02:00","created_at":"2025-02-25T03:42:30+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428812550411,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL015WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":9760871022859,"created_at":"2025-09-30T15:36:07+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57004818891019,"created_at":"2025-07-04T12:47:27+03:00","position":1,"updated_at":"2025-07-04T12:47:42+03:00","product_id":9760871022859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_fe0087e3-220b-4466-bf2e-ca03c98e487f.png?v=1751622462","width":2000,"height":2000},{"id":51855856533771,"created_at":"2025-02-25T03:42:32+02:00","position":2,"updated_at":"2025-07-04T12:47:42+03:00","product_id":9760871022859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-dolia-40cm-alb-1737012166.webp?v=1751622462","width":1024,"height":1024},{"id":70027052515595,"created_at":"2026-09-02T14:14:58+03:00","position":3,"updated_at":"2026-09-02T14:15:02+03:00","product_id":9760871022859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2695647_big_color.png?v=1788347702","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760900776203,"title":"Lustra LED cu telecomanda si cristal SHIA 27.1W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-shia-27-1w-2-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cristal Shia, disponibilă pentru vizualizare în showroom-ul Alessandro Design, este o piesă de iluminat care îmbină eleganța cristalelor cu un design contemporan inovator. Cu o putere de 27.1W și un finisaj argintiu strălucitor, lustra Shia adaugă un plus de stil și lumină sofisticată în orice spațiu.\u003cbr\u003e\u003cbr\u003eDesignul acestei lustre se remarcă prin două semicercuri de cristale suprapuse, oferind un aspect tridimensional și o prezență vizuală impresionantă. Cristalele transparente captează și refractă lumina, creând jocuri de scânteieri și străluciri care adaugă un nivel de rafinament și eleganță în orice cameră. Unul dintre cele mai notabile aspecte ale lustrei Shia este versatilitatea oferită de telecomandă. Aceasta vă permite să schimbați între trei tipuri de lumină – caldă, rece și neutră – permițându-vă să personalizați ambianța în funcție de momentul zilei sau de eveniment. În plus, lustra este dimabilă, oferindu-vă posibilitatea de a regla intensitatea luminii pentru a se potrivi cu atmosfera dorită.\u003cbr\u003e\u003cbr\u003eCu un flux luminos de 2168lm, lustra LED Cristal Shia oferă o iluminare puternică și eficientă, fiind perfectă pentru a lumina spații ample, cum ar fi livinguri, săli de mese sau holuri mari. Tehnologia LED integrată asigură eficiență energetică și o durată de viață îndelungată, ceea ce o face o alegere economică și sustenabilă.\u003cbr\u003e\u003cbr\u003eLustra LED Cristal Shia este alegerea ideală pentru cei care caută un echilibru între designul modern, funcționalitate și eficiență energetică. Este soluția perfectă pentru a adăuga un element de iluminat elegant și sofisticat în orice ambient, oferind un iluminat de calitate superioră care să îmbunătățească aspectul și atmosfera oricărui interior.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T03:48:01+02:00","created_at":"2025-02-25T03:48:00+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52415807717643,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT061\/2CR","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"279.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9760900776203,"created_at":"2025-09-26T17:50:26+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57350002475275,"created_at":"2025-07-14T15:25:44+03:00","position":1,"updated_at":"2025-07-14T15:26:06+03:00","product_id":9760900776203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a_1fdb5d7a-6deb-4405-9b8d-e2daa46aee4e.png?v=1752495966","width":1500,"height":1500},{"id":58445284376843,"created_at":"2025-08-02T11:18:44+03:00","position":2,"updated_at":"2025-08-02T11:18:57+03:00","product_id":9760900776203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/b738d37c-588e-47f8-8acb-10a6cedb958a.png?v=1754122737","width":1500,"height":1500},{"id":51856207970571,"created_at":"2025-02-25T03:48:02+02:00","position":3,"updated_at":"2025-08-02T11:18:57+03:00","product_id":9760900776203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-shia-56w-argintiu_AT1CT-VV1A-HT2L-SJ034-2CR_02.webp?v=1754122737","width":900,"height":900},{"id":51856208003339,"created_at":"2025-02-25T03:48:02+02:00","position":4,"updated_at":"2025-08-02T11:18:57+03:00","product_id":9760900776203,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cristal-telecomanda-shia-56w-argintiu_AT1CT-VV1A-HT2L-SJ034-2CR_01.webp?v=1754122737","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760901071115,"title":"Lustra LED cu telecomanda JASMINE 44W, 3 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-jasmine-44w-3-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\" src=\"https:\/\/www.youtube.com\/embed\/qZVylZponcM?list=PLLgyTjEnUblYjgo5KBGj4gHhPg7l_JqnF\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e \u003c\/div\u003e\u003cdiv\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți frumusețea și funcționalitatea compactă cu Lustra LED JASMINE, o alegere ideală pentru camerele mai mici. Această lustră elegantă, cu un design floral atrăgător și trei brațe, aduce un suflu de natură și prospețime în orice spațiu. Finisată într-un alb pur, JASMINE se potrivește perfect în decoruri diverse, de la cele moderne la cele tradiționale.\u003cbr\u003e\u003cbr\u003eCu o putere de 44W și un diametru de 49cm, această lustră oferă o iluminare adecvată pentru spațiile mai restrânse, fără a fi prea invazivă. Funcționalitatea dimabilă, controlabilă prin telecomandă, vă oferă libertatea de a ajusta intensitatea și tipul de lumină - caldă, rece sau neutră - pentru a se potrivi cu orice moment al zilei sau orice activitate.\u003cbr\u003e\u003cbr\u003eFluxul luminos de 3520lm asigură o iluminare eficientă și confortabilă, făcând din JASMINE nu doar un element decorativ, ci și o sursă de lumină practică și versatilă. Designul său inspirat din natură aduce o notă de eleganță și calm în orice cameră, fiind perfect pentru dormitoare mici, birouri sau holuri.\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED JASMINE pentru a combina estetica plăcută cu eficiența luminii în spațiile mici. Este o soluție ideală pentru cei care doresc să adauge un plus de stil și lumină ambientală într-un spațiu compact și confortabil.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T03:48:38+02:00","created_at":"2025-02-25T03:48:37+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429824557323,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT661\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"79.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":9760901071115,"created_at":"2025-09-30T17:26:40+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51856212885771,"created_at":"2025-02-25T03:48:40+02:00","position":1,"updated_at":"2025-02-25T03:48:41+02:00","product_id":9760901071115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-telecomanda-mario-76w-alb-acril-dimabila_LL1792AL_05.webp?v=1740448121","width":900,"height":900},{"id":51856212853003,"created_at":"2025-02-25T03:48:40+02:00","position":2,"updated_at":"2025-02-25T03:48:41+02:00","product_id":9760901071115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-telecomanda-mario-76w-alb-acril-dimabila_LL1792AL_02.webp?v=1740448121","width":900,"height":900},{"id":51856213147915,"created_at":"2025-02-25T03:48:40+02:00","position":3,"updated_at":"2025-02-25T03:48:42+02:00","product_id":9760901071115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-telecomanda-mario-76w-alb-acril-dimabila_LL1792AL_03.webp?v=1740448122","width":900,"height":900},{"id":51856212918539,"created_at":"2025-02-25T03:48:40+02:00","position":4,"updated_at":"2025-02-25T03:48:41+02:00","product_id":9760901071115,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-telecomanda-mario-76w-alb-acril-dimabila_LL1792AL_04.webp?v=1740448121","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779347489035,"title":"Lustră LED Linnea cu Telecomandă, 74W, 3000K\/4000K\/6000K, Dimabil, Alb, Cristale","handle":"lustra-led-linnea-cu-telecomanda-74w-3000k-4000k-6000k-dimabil-alb-cristale","body_html":"\u003cp data-end=\"393\" data-start=\"0\"\u003e\u003cstrong\u003eLustra LED Linnea\u003c\/strong\u003e redefinește eleganța modernă prin îmbinarea finisajului alb cu detalii strălucitoare din cristale, oferind un joc rafinat de lumină și reflexii. Cu o putere de \u003cstrong\u003e74W \u003c\/strong\u003eși LED integrat, este ideală pentru livinguri spațioase, dormitoare sofisticate sau zone de dining cu pretenții estetice.\u003c\/p\u003e\u003cp data-end=\"598\" data-start=\"395\"\u003eTelecomanda inclusă permite \u003cstrong\u003ereglarea intensității luminii\u003c\/strong\u003e și schimbarea temperaturii de culoare – \u003cstrong\u003ecaldă \u003c\/strong\u003e(3000K), \u003cstrong\u003eneutră \u003c\/strong\u003e(4000K) sau \u003cstrong\u003erece \u003c\/strong\u003e(6000K) – pentru a crea atmosfera dorită în orice moment al zilei.\u003c\/p\u003e\u003cp data-end=\"904\" data-start=\"600\"\u003e\u003cstrong data-end=\"630\" data-start=\"600\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli data-end=\"904\" data-start=\"600\"\u003e\n\u003cstrong\u003ePutere: 74W LED\u003c\/strong\u003e – iluminare puternică și economică\u003c\/li\u003e\n\u003cli data-end=\"904\" data-start=\"600\"\u003e\n\u003cstrong\u003eTemperatură de culoare reglabilă\u003c\/strong\u003e: 3000K \/ 4000K \/ 6000K\u003c\/li\u003e\n\u003cli data-end=\"904\" data-start=\"600\"\u003e\n\u003cstrong\u003eFuncție dimabilă\u003c\/strong\u003e cu telecomandă inclusă\u003c\/li\u003e\n\u003cli data-end=\"904\" data-start=\"600\"\u003e\n\u003cstrong\u003eDesign elegant\u003c\/strong\u003e: structură albă cu aplicații din cristale\u003c\/li\u003e\n\u003cli data-end=\"904\" data-start=\"600\"\u003ePotrivită pentru interioare moderne și elegante\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1039\" data-start=\"906\"\u003eLinnea este o lustră statement, ce aduce luminozitate, rafinament și control 