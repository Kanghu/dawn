roduct_id":9757299573003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-hollance-24w-alb-3000-4000-6000k_LL92AL_04.webp?v=1740403851","width":900,"height":900},{"id":51814437028107,"created_at":"2025-02-24T15:30:49+02:00","position":5,"updated_at":"2025-02-24T15:30:51+02:00","product_id":9757299573003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-hollance-24w-alb-3000-4000-6000k_LL92AL_01.webp?v=1740403851","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757379559691,"title":"Aplica LED cu cristal MAJORA 8W, Diametru 20cm, lumina Rece\/Calda\/Neutra, Crom Lucios","handle":"lustra-led-cu-cristal-majora-8w-diametru-20cm-lumina-rece-calda-neutra-crom-lucios","body_html":"\u003cp data-sourcepos=\"1:1-1:253\"\u003eLustra LED cu cristale MAJORA este o piesă de iluminat compactă și elegantă, cu o putere de 8W și un diametru de 20cm. Finisajul crom lucios și prezența cristalelor sugerează un design care îmbină eficiența LED-urilor cu un aspect decorativ strălucitor.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:363\"\u003eCu un diametru de 20cm, este potrivită pentru a ilumina spații mici sau ca iluminat ambiental, adăugând un plus de stil. Posibilitatea de a alege între lumină rece, caldă sau neutră îți permite să adaptezi atmosfera. Finisajul crom lucios va accentua strălucirea cristalelor, adăugând o notă sofisticată încăperii. Puterea de 8W indică un consum redus de energie.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T16:07:15+02:00","created_at":"2025-02-24T16:07:14+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale"],"variants":[{"id":52408094654731,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-702R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757379559691,"created_at":"2025-09-24T12:13:53+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51815104086283,"created_at":"2025-02-24T16:07:16+02:00","position":1,"updated_at":"2025-02-24T16:07:19+02:00","product_id":9757379559691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/aplica-led-maroja-8w-cristal-k9-crom-3000-4000-6000k_AP2122CR_01.webp?v=1740406039","width":900,"height":900},{"id":51815103922443,"created_at":"2025-02-24T16:07:17+02:00","position":2,"updated_at":"2025-02-24T16:07:18+02:00","product_id":9757379559691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/aplica-led-maroja-8w-cristal-k9-crom-3000-4000-6000k_AP2122CR_02.webp?v=1740406038","width":900,"height":900},{"id":51815103955211,"created_at":"2025-02-24T16:07:17+02:00","position":3,"updated_at":"2025-02-24T16:07:18+02:00","product_id":9757379559691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/aplica-led-maroja-8w-cristal-k9-crom-3000-4000-6000k_AP2122CR_03.webp?v=1740406038","width":900,"height":900},{"id":51815104020747,"created_at":"2025-02-24T16:07:17+02:00","position":4,"updated_at":"2025-02-24T16:07:19+02:00","product_id":9757379559691,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/aplica-led-maroja-8w-cristal-k9-crom-3000-4000-6000k_AP2122CR_04.webp?v=1740406039","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757399417099,"title":"Lustra LED cu telecomanda FELIX 119W, 5 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-felix-119w-5-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e \u003cspan\u003eImaginează-ți o sculptură luminoasă care îmbină liniile clare ale geometriei cu funcționalitatea avansată a tehnologiei LED. Lustra FELIX, cu cei 119W ai săi, este exact asta: o compoziție aeriană de cinci pătrate albe, parcă suspendate în lumină. \u003c\/span\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003eTelecomanda devine bagheta ta magică, permițându-ți să transformi instantaneu atmosfera încăperii, de la lumina vibrantă a unei zile însorite (rece), la căldura primitoare a unui apus (caldă), sau la echilibrul neutru perfect pentru orice activitate. \u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003eȘi pentru că lumina se adaptează stării tale, funcția de dimare îți oferă control fin asupra intensității. FELIX nu este doar un corp de iluminat, ci o declarație de stil, un punct focal modern care adaugă dinamism și eleganță spațiului tău.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-24T16:12:34+02:00","created_at":"2025-02-24T16:12:34+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52421749342475,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT262\/5WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9757399417099,"created_at":"2025-09-28T12:07:02+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57561378685195,"created_at":"2025-07-23T02:59:31+03:00","position":1,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_6b99993c-7de2-4ae0-a68f-30b628c820e0.png?v=1753228794","width":2000,"height":2000},{"id":51815426523403,"created_at":"2025-02-24T16:12:38+02:00","position":2,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-tiana-140w-alb-acril-dimabila_LL48AL_05.webp?v=1753228794","width":900,"height":900},{"id":51815426195723,"created_at":"2025-02-24T16:12:37+02:00","position":3,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-tiana-140w-alb-acril-dimabila_LL48AL_06.webp?v=1753228794","width":900,"height":900},{"id":51815427834123,"created_at":"2025-02-24T16:12:38+02:00","position":4,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-tiana-140w-alb-acril-dimabila_LL48AL_02.webp?v=1753228794","width":900,"height":900},{"id":51815426359563,"created_at":"2025-02-24T16:12:38+02:00","position":5,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-tiana-140w-alb-acril-dimabila_LL48AL_03.webp?v=1753228794","width":900,"height":900},{"id":51815426457867,"created_at":"2025-02-24T16:12:38+02:00","position":6,"updated_at":"2025-07-23T02:59:54+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-tiana-140w-alb-acril-dimabila_LL48AL_04.webp?v=1753228794","width":900,"height":900},{"id":68251288928523,"created_at":"2026-04-14T13:49:53+03:00","position":7,"updated_at":"2026-04-14T13:49:55+03:00","product_id":9757399417099,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lt262-5wh.png?v=1776163795","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757458006283,"title":"Lustra LED cu telecomanda GLORIOSA 150W, 5 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-gloriosa-150w-5-petale-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:322\"\u003eLustra LED cu telecomandă GLORIOSA este o piesă de iluminat impunătoare și modernă, cu un design spectaculos format din 5 petale stilizate, finisate într-un negru elegant. Cu o putere impresionantă de 150W, această lustră este concepută pentru a ilumina generos chiar și spații mari, adăugând un plus de stil și dramatism.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:426\"\u003eCele cinci 'petale', iluminate de LED-uri puternice, creează un efect vizual îndrăzneț și asigură o distribuție amplă a luminii. Telecomanda inclusă îți oferă control total asupra ambianței: poți alege între lumină rece (pentru o atmosferă vibrantă), caldă (pentru un confort primitor) sau neutră (pentru iluminare generală optimă), și poți ajusta intensitatea luminii cu funcția de dimare, adaptând-o perfect oricărei ocazii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:265\"\u003eFinisajul negru al lustrei accentuează liniile moderne ale designului și o transformă într-un punct focal sofisticat al încăperii. Forma cu petale, reinterpretată într-un stil contemporan, aduce un element organic, dar cu o notă industrială dată de culoarea neagră.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:153\"\u003eAceastă lustră este ideală pentru livinguri spațioase, sufragerii sau chiar spații comerciale care necesită o iluminare puternică și un design cu impact.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T16:21:58+02:00","created_at":"2025-02-24T16:21:58+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52424569192715,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT296\/5BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"259.99","grams":0,"compare_at_price":"259.99","position":1,"product_id":9757458006283,"created_at":"2025-09-29T16:25:48+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51815777468683,"created_at":"2025-02-24T16:22:00+02:00","position":1,"updated_at":"2025-03-14T18:28:17+02:00","product_id":9757458006283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-maree-150w-negru-acril-dimabila_LL1801N_01.webp?v=1741969697","width":1024,"height":1024},{"id":51815777337611,"created_at":"2025-02-24T16:22:00+02:00","position":2,"updated_at":"2025-03-14T18:28:35+02:00","product_id":9757458006283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-maree-150w-negru-acril-dimabila_LL1801N_02.webp?v=1741969715","width":1024,"height":1024},{"id":51815777435915,"created_at":"2025-02-24T16:22:00+02:00","position":3,"updated_at":"2025-03-14T18:28:55+02:00","product_id":9757458006283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-maree-150w-negru-acril-dimabila_LL1801N_03.webp?v=1741969735","width":1024,"height":1024},{"id":69653957017867,"created_at":"2026-07-02T15:54:15+03:00","position":4,"updated_at":"2026-07-02T15:54:43+03:00","product_id":9757458006283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_GLORIOSA_150W_5_Petale_lumina_Rece_Calda_Neutra_Dimabila_Negru_4.png?v=1782996883","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757469933835,"title":"Lustra LED cu telecomanda FELY 80W, 5 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-fely-80w-5-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp\u003e\u003cbr\u003e\u003c\/p\u003e\u003csty