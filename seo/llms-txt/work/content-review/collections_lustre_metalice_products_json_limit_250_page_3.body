hopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/008_08_LL870-80BK.webp?v=1785526040","width":1000,"height":1000},{"id":69858319630603,"created_at":"2026-07-31T22:27:16+03:00","position":9,"updated_at":"2026-07-31T22:27:19+03:00","product_id":9779351257355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/009_09_LL870-80BK.webp?v=1785526039","width":1000,"height":1000},{"id":69858319663371,"created_at":"2026-07-31T22:27:16+03:00","position":10,"updated_at":"2026-07-31T22:27:19+03:00","product_id":9779351257355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/010_10_LL870-80BK.webp?v=1785526039","width":1000,"height":1000},{"id":69858319696139,"created_at":"2026-07-31T22:27:16+03:00","position":11,"updated_at":"2026-07-31T22:27:20+03:00","product_id":9779351257355,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/011_11_LL870-80BK.webp?v=1785526040","width":1254,"height":1254}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9786058965259,"title":"Lustra LED suspendata cu telecomanda si cristal PRISM ANTEA 57W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-si-cristal-prism-antea-57w-2-cercuri-lumina-rece-calda-neutra-dimabila-crom-lucios-inaltime-reglabila","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003eLustra LED cu telecomandă \u003cstrong\u003ePRISM ANTEA\u003c\/strong\u003e, de \u003cstrong\u003e57\u003c\/strong\u003e\u003cstrong\u003eW\u003c\/strong\u003e, îmbină un design modern cu funcționalitate avansată, având o structură elegantă formată din două cercuri concentrice și un finisaj argintiu sofisticat. Această lustră oferă \u003cstrong\u003etrei tipuri de lumină \u003c\/strong\u003eintegrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003e Datorită funcției de dimare, intensitatea luminii poate fi ajustată cu ușurință prin intermediul telecomenzii incluse, oferindu-ți controlul asupra atmosferei din încăpere.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cspan\u003e Designul său cu două cercuri și culoarea argintie adaugă un plus de stil și modernitate oricărui interior, fiind potrivită pentru livinguri, dormitoare sau alte spații în care se dorește o lumină ambientală plăcută și un element de decor atrăgător. Puterea de \u003cstrong\u003e57\u003c\/strong\u003e\u003cstrong\u003eW\u003c\/strong\u003e asigură o iluminare eficientă, ideală pentru a crea o atmosferă confortabilă și primitoare.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-03-10T15:24:07+02:00","created_at":"2025-03-10T15:24:07+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52428027199755,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT027\/2","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"279.99","grams":0,"compare_at_price":