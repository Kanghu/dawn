\/files\/Lustra_LED_cu_telecomanda_SERPENTA_51W_Rotunda_lumina_Rece_Calda_Neutra_Dimabila_Negru_5.png?v=1784645615","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133859139851,"title":"Lustra LED cu telecomanda SERPENTA 60W, Patrata, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-serpenta-60w-patrata-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp class=\"\" data-end=\"485\" data-start=\"242\"\u003eCu un design geometric și impunător, SERPENTA aduce echilibru și stil într-un format arhitectural. Cele trei pătrate suspendate, finisate în negru mat, creează un efect vizual puternic, ideal pentru interioare moderne și minimaliste.\u003c\/p\u003e\u003cp class=\"\" data-end=\"739\" data-start=\"487\"\u003eTehnologia LED de 60W oferă o lumină eficientă și adaptabilă – poți alege temperatura de culoare (rece, caldă sau neutră) și regla intensitatea cu ajutorul telecomenzii incluse. Perfectă pentru living, dining sau spații de birou cu accent contemporan.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:36:00+03:00","created_at":"2025-04-15T00:49:50+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429938753803,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT640\/500P","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10133859139851,"created_at":"2025-09-30T17:56:59+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59074455470347,"created_at":"2025-08-13T09:45:50+03:00","position":1,"updated_at":"2025-08-13T09:45:54+03:00","product_id":10133859139851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/db05310c-61ab-4861-81b9-c6e82a1f66b4.png?v=1755067554","width":1600,"height":1600},{"id":59074509144331,"created_at":"2025-08-13T09:51:08+03:00","position":2,"updated_at":"2025-08-13T10:00:08+03:00","product_id":10133859139851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_d28faa37-13d3-4671-9fa1-e5558fda3e9d.png?v=1755068408","width":1500,"height":1500},{"id":59074509308171,"created_at":"2025-08-13T09:51:09+03:00","position":3,"updated_at":"2025-08-13T10:00:08+03:00","product_id":10133859139851,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_b76cc598-b351-4917-b0ac-5410a6876cc5.png?v=1755068408","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10133897937163,"title":"Lustra LED cu telecomanda LUNARO 38W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Alb","handle":"lustra-led-cu-telecomanda-lunaro-38w-2-cercuri-lumina-rece-calda-neutra-dimabila-auriu-alb","body_html":"\u003cdiv id=\"749a12679e825632\" class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\"\u003e\n\u003cdiv class=\"user-query-container user-query-bubble-container ng-star-inserted\"\u003e\u003cdiv id=\"user-query-content-0\" class=\"query-content ng-star-inserted\"\u003e\u003cdiv dir=\"ltr\" class=\"query-text gds-body-l\" aria-level=\"2\" role=\"heading\"\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cp data-sourcepos=\"7:1-7:422\"\u003e Cu un design circular modern și un finisaj auriu cald, \u003cstrong data-start=\"326\" data-end=\"344\"\u003eLUNARO \u003c\/strong\u003e aduce un plus de rafinament și lumină echilibrată în orice încăpere. Cele două cercuri interconectate oferă un efect vizual aerisit, ideal pentru spații elegante sau contemporane.\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c1259651453-12 response-container-with-gpi tts-removed ng-star-inserted is-mobile\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c1259651453-12\"\u003e\u003cdiv class=\"response-container-content ng-tns-c1259651453-12\"\u003e\u003cdiv class=\"response-content ng-tns-c1259651453-12\"\u003e\u003cdiv dir=\"ltr\" id=\"model-response-message-contentr_749a12679e825632\" class=\"markdown markdown-main-panel stronger\"\u003e\u003cp data-start=\"526\" data-end=\"808\" class=\"\"\u003eDotată cu tehnologie LED de 38W, lustra permite controlul complet al atmosferei prin reglarea temperaturii de culoare (rece, caldă sau neutră) și a intensității luminoase, direct din telecomandă. Forma minimalistă și detaliile fine o transformă într-un element decorativ de impact.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003c\/div\u003e","published_at":"2025-04-29T15:34:10+03:00","created_at":"2025-04-15T01:37:14+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428747604235,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT636\/500GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":10133897937163,"created_at":"2025-09-30T15:27:26+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":54769066705163,"created_at":"2025-04-15T01:39:12+03:00","position":1,"updated_at":"2025-04-15T01:39:14+03:00","product_id":10133897937163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT636_500GD-LustraLEDcutelecomandaLUNAROLUCENTA_110W_2Cercuri_luminaRece_Calda_Neutra_Dimabila_Auriu-1.jpg?v=1744670354","width":1080,"height":1080},{"id":59608288493835,"created_at":"2025-08-28T11:25:42+03:00","position":2,"updated_at":"2025-08-28T11:25:45+03:00","product_id":10133897937163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_97729b8c-b745-4dd1-b593-eb2e4e73faac.jpg?v=1756369545","width":800,"height":800},{"id":59608288297227,"created_at":"2025-08-28T11:25:41+03:00","position":3,"updated_at":"2025-08-28T11:25:44+03:00","product_id":10133897937163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_f3f55191-f86a-4b92-b6cf-999b2df242e8.png?v=1756369544","width":922,"height":916},{"id":62529246855435,"created_at":"2025-11-20T18:20:02+02:00","position":4,"updated_at":"2025-11-20T18:20:05+02:00","product_id":10133897937163,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT636_500GD_EPREL_e38ae716-df3c-4c9c-8369-da712cee27e1.png?v=1763655605","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10134689382667,"title":"Lustra LED cu telecomanda LINEA 125W, Patrata, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-linea-125w-patrata-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:224\"\u003eLustra LED cu telecomandă LINEA este o piesă de iluminat modernă și eficientă, cu o putere de 125W și o formă pătrată, finisată în negru. Telecomanda inclusă oferă control asupra temperaturii culorii și intensității luminii.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:453\"\u003eForma pătrată sugerează un design geometric ordonat. Datorită tehnologiei LED, este eficientă energetic, iar telecomanda permite selectarea temperaturii culorii (rece, caldă sau neutră) și ajustarea intensității luminii (dimabilă). Finisajul negru îi conferă un aspect sobru și elegant, ușor de integrat în diverse decoruri moderne. Cu o putere de 125W, este potrivită pentru a ilumina livinguri, dormitoare sau alte spații de dimensiuni medii sau mari.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:299\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" style=\"font-size: 0.875rem;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" style=\"font-size: 0.875rem;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" style=\"font-size: 0.875rem;\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" style=\"font-size: 0.875rem;\"\u003e\u003cbr\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:299\"\u003e \u003c\/p\u003e","published_at":"2025-04-29T15:36:43+03:00","created_at":"2025-04-15T12:28:35+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52343622992139,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT642\/500P","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10134689382667,"created_at":"2025-09-08T19:24:53+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":54781463593227,"created_at":"2025-04-15T12:29:43+03:00","position":1,"updated_at":"2025-04-15T12:29:46+03:00","product_id":10134689382667,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT642_500P-LustraLEDcutelecomandaLINEAGEOMETRICA_125W_2Patrate_luminaRece_Calda_Neutra_Dimabila_Negru-1.jpg?v=1744709386","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10152238416139,"title":"Lustra LED cu telecomanda DALIA 67W, 3 Petale, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-dalia-67w-3-petale-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"3:1-3:79\"\u003e\u003cstrong\u003eEleganță Modernă și Iluminare Adaptabilă: Lustra LED cu Telecomandă DALIA\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:281\"\u003eAdu un strop de stil contemporan și o lumină versatilă în casa ta cu Lustra LED DALIA. Designul său atrăgător, compus din \u003cstrong\u003e3 'petale' stilizate\u003c\/strong\u003e cu un finisaj \u003cstrong\u003ealb\u003c\/strong\u003e elegant, creează un efect vizual aerisit și modern, transformând tavanul într-un element de design remarcabil.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:328\"\u003eCu o putere totală de \u003cstrong\u003e67W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și uniformă, ideală pentru livinguri, dormitoare sau holuri moderne. Bucură-te de flexibilitatea \u003cstrong\u003etrei tipuri de lumină\u003c\/strong\u003e integrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:374\"\u003eFuncția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, controlată cu ușurință prin \u003cstrong\u003etelecomanda inclusă\u003c\/strong\u003e, îți oferă posibilitatea de a ajusta intensitatea luminoasă în funcție de preferințe, de la o lumină ambientală relaxantă la o iluminare mai puternică. Telecomanda îți oferă control complet asupra luminii, permițându-ți să reglezi atât intensitatea, cât și temperatura de culoare, fără a te deplasa.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:129\"\u003eDetaliile texturate din interiorul 'petalelor' adaugă un plus de interes vizual și contribuie la o distribuție plăcută a luminii.\u003c\/p\u003e\u003cp data-sourcepos=\"13:1-13:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"15:1-22:0\"\u003e\n\u003cli data-sourcepos=\"15:1-15:68\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e 3 'petale' stilizate cu finisaj alb.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:70\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e 67W pentru o lumină uniformă și suficientă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:92\"\u003e\n\u003cstrong\u003eTemperatură Culoare Variabilă:\u003c\/strong\u003e Lumină rece, caldă și neutră, adaptabilă nevoilor tale.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:73\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-19:88\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control total asupra intensității și temperaturii de culoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:73\"\u003e\n\u003cstrong\u003eMaterial Durabil:\u003c\/strong\u003e Structură robustă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-22:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare moderne, minimaliste sau contemporane.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"23:1-23:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"25:1-30:0\"\u003e\n\u003cli data-sourcepos=\"25:1-25:83\"\u003e\n\u003cstrong\u003eCreează un Punct Focal Modern și Aerisit:\u003c\/strong\u003e Designul său unic atrage privirile.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:113\"\u003e\n\u003cstrong\u003eOferă o Iluminare Extrem de Versatilă:\u003c\/strong\u003e Adaptează temperatura și intensitatea luminoasă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:97\"\u003e\n\u003cstrong\u003eControl Total și Confortabil:\u003c\/strong\u003e Telecomanda intuitivă face reglarea luminii simplă și rapidă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-28:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-30:0\"\u003e\n\u003cstrong\u003eAdaugă un Plus de Lumină și Stil:\u003c\/strong\u003e Designul său contemporan îmbogățește decorul.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\n\u003c\/li\u003e\n\u003c\/ul\u003e","published_at":"2025-04-29T17:20:58+03:00","created_at":"2025-04-27T00:07:55+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52411158561035,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT018\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":10152238416139,"created_at":"2025-09-25T10:44:21+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55011372990731,"created_at":"2025-04-27T00:11:33+03:00","position":1,"updated_at":"2025-04-27T00:11:37+03:00","product_id":10152238416139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-AT1CT-IM1P-HT2L-LT018_3WH-VLustraLEDcuTelecomandaAngioloDimabilaAcrilNegru-1.png?v=1745701897","width":1080,"height":1080},{"id":55011373515019,"created_at":"2025-04-27T00:11:38+03:00","position":2,"updated_at":"2025-04-27T00:11:41+03:00","product_id":10152238416139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/white-AT1CT-IM1P-HT2L-LT018_3WH-LustraLEDcuTelecomandaAngioloDimabilaAcrilNegru-1.png?v=1745701901","width":1080,"height":1080},{"id":63330421899531,"created_at":"2025-12-12T14:32:17+02:00","position":3,"updated_at":"2025-12-12T14:32:20+02:00","product_id":10152238416139,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT018_3WH_EPREL.png?v=1765542740","width":2048,"height":2048}],"options":[{"n