.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-08-19T21:44:10+03:00","created_at":"2025-08-18T22:20:10+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52414554472715,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT109\/1GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10674807374091,"created_at":"2025-09-26T11:49:51+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59240275902731,"created_at":"2025-08-18T22:24:47+03:00","position":1,"updated_at":"2025-08-18T22:24:51+03:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2025-08-18at22.24.43.png?v=1755545091","width":922,"height":924},{"id":59240278720779,"created_at":"2025-08-18T22:25:45+03:00","position":2,"updated_at":"2025-09-04T13:11:18+03:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2025-08-18at22.25.40.png?v=1756980678","width":994,"height":994},{"id":59240276525323,"created_at":"2025-08-18T22:25:02+03:00","position":3,"updated_at":"2025-09-04T13:11:18+03:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2025-08-18at22.24.56.png?v=1756980678","width":832,"height":926},{"id":59240485421323,"created_at":"2025-08-18T22:26:12+03:00","position":4,"updated_at":"2025-09-04T13:11:31+03:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2025-08-18at22.26.07.png?v=1756980691","width":609,"height":608},{"id":59240589525259,"created_at":"2025-08-18T22:27:07+03:00","position":5,"updated_at":"2025-08-18T22:27:10+03:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Screenshot2025-08-18at22.27.02.png?v=1755545230","width":720,"height":712},{"id":64308687962379,"created_at":"2026-01-12T11:14:21+02:00","position":6,"updated_at":"2026-01-12T11:14:25+02:00","product_id":10674807374091,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT109_1GD_EPREL.png?v=1768209265","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10685272817931,"title":"Lustra LED cu telecomanda RINOVA 34W, lumina Rece\/Calda\/Neutra, Dimabila, Auriu Lucios","handle":"lustra-led-cu-telecomanda-rinova-47w-lumina-rece-calda-neutra-lustra-led-cu-telecomanda-rinova-34w-lumina-rece-calda-neutra-dimabila-auriu-luciosdimabila-auriu-lucios","body_html":"\u003cp data-sourcepos=\"3:1-3:86\"\u003e\u003cstrong\u003eEleganță Circulară și Control Luminos Avansat: Lustra LED cu Telecomandă RINOVA\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:284\"\u003eÎmbracă-ți spațiul cu un rafinament modern și o iluminare complet personalizabilă cu lustra LED RINOVA. Designul său elegant, compus din trei \u003cstrong\u003e cercuri\u003c\/strong\u003e concentrice sau suprapuse, finisate într-o nuanță sofisticată de \u003cstrong\u003eauriu\u003c\/strong\u003e, adaugă o notă de lux contemporan oricărei încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:456\"\u003eCu o putere de 47W, această lustră LED oferă o iluminare eficientă și amplă, perfectă pentru livinguri, dininguri sau alte spații generoase. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Poți alege între \u003cstrong\u003elumină rece\u003c\/strong\u003e, ideală pentru activități care necesită concentrare; \u003cstrong\u003elumină caldă\u003c\/strong\u003e, perfectă pentru a crea un ambient primitor și relaxant; și \u003cstrong\u003elumină neutră\u003c\/strong\u003e, potrivită pentru iluminatul general de zi cu zi.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:184\"\u003eFuncția \u003cstrong\u003edimabilă\u003c\/strong\u003e îți permite să ajustezi intensitatea luminoasă, creând astfel ambientul perfect pentru fiecare moment, de la o lumină strălucitoare la o lumină ambientală subtilă.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:84\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Două cercuri concentrice\/suprapuse cu finisaj auriu.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:71\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 47W pentru o iluminare optimă a spațiilor mari.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:91\"\u003e\n\u003cstrong\u003eTelecomanda Inclusă:\u003c\/strong\u003e Control facil al temperaturii culorii și intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:94\"\u003e\n\u003cstrong\u003eTrei Temperaturi de Culoare:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru a se potrivi oricărei ocazii.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:94\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj auriu elegant și elemente LED integrate.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Luxos:\u003c\/strong\u003e Se integrează perfect în interioarele moderne, minimaliste sau cu accente glamour.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"23:1-29:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:93\"\u003e\n\u003cstrong\u003eControl Total al Luminii:\u003c\/strong\u003e Ajustează temperatura culorii și intensitatea cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:79\"\u003e\n\u003cstrong\u003eAtmosferă Personalizată:\u003c\/strong\u003e Creează ambientul perfect pentru fiecare moment.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:93\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Designul circular și finisajul auriu adaugă un plus de eleganță.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-27:91\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii simplu și confortabil.\u003c\/li\u003e\n\u003cli data-sourcepos=\"28:1-29:0\"\u003e\n\u003cstrong\u003eIluminare Amplă:\u003c\/strong\u003e Potrivită pentru iluminarea eficientă a spațiilor mari.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"30:1-30:198\"\u003eLustra LED cu telecomandă RINOVA este alegerea ideală pentru a adăuga un plus de stil, confort și control inteligent în casa ta. Bucură-te de iluminarea adaptabilă și de designul modern și luxos!\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:12:07+03:00","created_at":"2025-08-28T10:53:46+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52429883605259,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT510\/30GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":10685272817931,"created_at":"2025-09-30T17:48:22+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59605918220555,"created_at":"2025-08-28T10:57:57+03:00","position":1,"updated_at":"2025-08-28T10:58:02+03:00","product_id":10685272817931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_22db8dae-4257-497f-884e-042a0c27d556.png?v=1756367882","width":1500,"height":1500},{"id":59605918286091,"created_at":"2025-08-28T10:57:57+03:00","position":2,"updated_at":"2025-08-28T10:58:14+03:00","product_id":10685272817931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_3fea859f-bae3-4284-b2a7-d015b4893151.png?v=1756367894","width":1500,"height":1500},{"id":59605918318859,"created_at":"2025-08-28T10:57:57+03:00","position":3,"updated_at":"2025-08-28T10:58:14+03:00","product_id":10685272817931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_13b48da1-6440-4c0f-b6de-2e8469a6b014.png?v=1756367894","width":1500,"height":1500},{"id":59605918253323,"created_at":"2025-08-28T10:57:57+03:00","position":4,"updated_at":"2025-08-28T10:58:14+03:00","product_id":10685272817931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_b133479d-0846-4954-aadc-0aacefa76af5.png?v=1756367894","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10721588936971,"title":"Lustra LED cu telecomanda LT511\/30+40+50BK, 93W, 2 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-riga-lt511-30-40-50bk-93w-2-cercuri-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cdiv id=\"chat-history\" class=\"chat-history-scroll-container\"\u003e\u003cdiv class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\" id=\"d54b0437869e4f9b\"\u003e\u003cdiv class=\"response-container ng-tns-c3043829428-66 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3043829428-66\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3043829428-66\"\u003e\u003cdiv class=\"response-content ng-tns-c3043829428-66\"\u003e\u003cdiv class=\"markdown markdown-main-panel stronger\" id=\"model-response-message-contentr_d54b0437869e4f9b\" dir=\"ltr\"\u003e\n\u003cp data-sourcepos=\"3:1-3:76\"\u003e\u003cstrong\u003eEleganță Modernă și Iluminare Dinamică: Lustra LED cu Telecomandă\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:280\"\u003eAdu un strop de rafinament contemporan și o lumină adaptabilă în casa ta cu Lustra LED Lilith. Designul său unic, compus din \u003cstrong\u003ecercuri interconectate\u003c\/strong\u003e cu un finisaj \u003cstrong\u003enegru\u003c\/strong\u003e elegant, creează un efect vizual captivant și modern, transformând tavanul într-un punct focal artistic.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:394\"\u003eCu o putere totală de \u003cstrong\u003e93W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și uniformă, perfectă pentru livinguri, dormitoare sau birouri moderne. Funcția \u003cstrong\u003edimmabilă\u003c\/strong\u003e, controlată cu ușurință de \u003cstrong\u003etelecomanda inclusă\u003c\/strong\u003e, îți permite să ajustezi intensitatea luminoasă în funcție de starea ta de spirit sau de activitate, de la o lumină ambientală relaxantă la o iluminare puternică și clară.\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:239\"\u003eTelecomanda îți oferă control complet asupra luminii, permițându-ți să reglezi intensitatea fără a te ridica. Designul cu cercuri interconectate nu doar arată spectaculos, dar asigură și o distribuție optimă a luminii în întreaga încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-19:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:77\"\u003e\n\u003cstrong\u003eDesign Modern și Unic:\u003c\/strong\u003e Cercuri interconectate cu finisaj negru elegant.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:69\"\u003e\n\u003cstrong\u003eIluminare Eficientă:\u003c\/strong\u003e 93W pentru o lumină uniformă și puternică.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:73\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă cu telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:67\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:73\"\u003e\n\u003cstrong\u003eMaterial Durabil:\u003c\/strong\u003e Structură robustă pentru o utilizare îndelungată.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-19:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare moderne, minimaliste sau industriale.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"20:1-20:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"22:1-27:0\"\u003e\n\u003cli data-sourcepos=\"22:1-22:78\"\u003e\n\u003cstrong\u003eCreează un Punct Focal Modern:\u003c\/strong\u003e Designul său unic atrage toate privirile.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:89\"\u003e\n\u003cstrong\u003eOferă o Iluminare Adaptabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru orice ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:82\"\u003e\n\u003cstrong\u003eControl Facil:\u003c\/strong\u003e Telecomanda intuitivă face reglarea luminii simplă și rapidă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-27:0\"\u003e\n\u003cstrong\u003eAdaugă un Plus de Stil:\u003c\/strong\u003e Designul său contemporan îmbogățește decorul.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"28:1-28:204\"\u003eLustra LED cu Telecomandă Lilith este alegerea ideală pentru a adăuga un element de design modern și o iluminare flexibilă în casa ta. Bucură-te de o atmosferă personalizată cu o simplă atingere de buton!\u003c\/p\u003e\n\u003cp data-sourcepos=\"28:1-28:204\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_cal