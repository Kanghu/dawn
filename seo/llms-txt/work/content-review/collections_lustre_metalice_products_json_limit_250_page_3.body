bec-banda-led.jpg?v=1747387418\"\u003e\u003c\/p\u003e","published_at":"2025-06-13T16:51:51+03:00","created_at":"2025-06-11T11:14:28+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428547850507,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT510\/500GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10236521349387,"created_at":"2025-09-30T14:17:12+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56403785220363,"created_at":"2025-06-14T11:16:51+03:00","position":1,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu_5.jpg?v=1749889051","width":1080,"height":1080},{"id":56403785122059,"created_at":"2025-06-14T11:16:51+03:00","position":2,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu_2.jpg?v=1749889051","width":1080,"height":1080},{"id":56303013069067,"created_at":"2025-06-11T11:32:49+03:00","position":3,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT510_500GD-Aplica_LED_Dario_36W_Lumina_Rece_Calda_Neutra_Auriu-1.png?v=1749889051","width":564,"height":564},{"id":56403785580811,"created_at":"2025-06-14T11:16:51+03:00","position":4,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu_4.jpg?v=1749889051","width":1080,"height":1080},{"id":56403785285899,"created_at":"2025-06-14T11:16:51+03:00","position":5,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu_3.jpg?v=1749889051","width":1080,"height":1080},{"id":56403785318667,"created_at":"2025-06-14T11:16:51+03:00","position":6,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu.jpg?v=1749889051","width":1080,"height":1080},{"id":56403785253131,"created_at":"2025-06-14T11:16:51+03:00","position":7,"updated_at":"2025-06-14T11:17:31+03:00","product_id":10236521349387,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/white-AL510_500GD-LustraLEDDario_2Cercuri_36W_LuminaRece_Calda_Neutra_Auriu.jpg?v=1749889051","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10236532228363,"title":"Lustra LED cu Telecomanda RINOVA, 4 cercuri, 112W, Lumina Calda\/Rece\/Neutra, Dimabila, Auriu","handle":"lustra-led-cu-telecomanda-rinova-4-cercuri-112w-lumina-calda-rece-neutra-dimabila-auriu","body_html":"\u003cp\u003eLustra LED RINOVA, o piesa de iluminat ce imbina estetica moderna cu functionalitatea avansata. Conceputa pentru a adauga o nota de rafinament, aceasta lustra este mai mult decat o sursa de lumina, este o declaratie de stil.\u003c\/p\u003e\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Impunator \u0026amp; Materiale Premium:\u003c\/strong\u003e Cu o forma rotunda\/circulara si finisaj auriu, realizata din acril, metal si aluminiu, lustra RINOVA devine punctul central al oricarei incaperi, integrandu-se perfect in decorurile contemporane.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eAmbianta Total Personalizabila:\u003c\/strong\u003e Beneficiati de 4 surse LED cu o putere totala de 112W si un flux luminos impresionant de 6965lm. Alegeti din cele trei temperaturi de culoare (calda, neutra, rece) si controlati lumina intuitiv, fie prin intrerupatorul clasic, fie prin telecomanda.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eEficienta Energetica \u0026amp; Durabilitate Extinsa:\u003c\/strong\u003e Tehnologia LED avansata asigura un consum optim si o durata de viata remarcabila de 25.000 de ore, oferind economii semnificative pe termen lung si o intretinere minima.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp\u003eLustra LED RINOVA este solutia ideala pentru cei ce cauta o iluminare eficienta, estetica si durabila, transformand fiecare incapere intr-un spatiu plin de personalitate si un confort vizual exceptional, perfect pentru dormitor sau living.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-13T17:02:39+03:00","created_at":"2025-06-11T11:41:07+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","ETA 03.Oct","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52428547883275,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-