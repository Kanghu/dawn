ight":900},{"id":51820974735627,"created_at":"2025-02-24T21:15:52+02:00","position":6,"updated_at":"2025-05-22T12:32:21+03:00","product_id":9758319214859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lux-telecomanda-123w-24ghz-dimabila-alb_LL1572_03.webp?v=1747906341","width":900,"height":900},{"id":51820974801163,"created_at":"2025-02-24T21:15:52+02:00","position":7,"updated_at":"2025-05-22T12:32:21+03:00","product_id":9758319214859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lux-telecomanda-123w-24ghz-dimabila-alb_LL1572_05.webp?v=1747906341","width":900,"height":900},{"id":55048883044619,"created_at":"2025-04-28T18:24:32+03:00","position":8,"updated_at":"2025-05-22T12:32:21+03:00","product_id":9758319214859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-AT1CT-IM1P-HT2L-LT110WH-LustraLEDSuspendatacuTelecomandaINFINITYHalo_138W_InaltimeReglabila_LuminaRece_Calda_Neutra_Dimabila_Alb-1.png?v=1747906341","width":1080,"height":1080},{"id":68251171291403,"created_at":"2026-04-14T13:35:56+03:00","position":9,"updated_at":"2026-04-14T13:35:58+03:00","product_id":9758319214859,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lt110wh.png?v=1776162958","width":204,"height":408}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760744309003,"title":"Lustra LED CONSTELATION cu telecomanda 49W, Diametru 48cm, lumina Rece\/Calda\/Neutra, Alb Albastru","handle":"lustra-led-constelation-cu-telecomanda-49w-diametru-48cm-lumina-rece-calda-neutra-alb-albastru","body_html":"\u003cp data-sourcepos=\"1:1-1:241\"\u003eLustra LED Constelation, cu o putere de 49W și un design modern , aduce un strop de eleganță luminoasă în locuința ta. Finisajul alb îi conferă un aspect curat și versatil, ușor de integrat în diverse stiluri de interior.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:381\"\u003eAceastă lustră inteligentă îți oferă flexibilitatea de a alege temperatura de culoare a luminii în funcție de preferințe și necesități. Poți opta pentru lumina rece, ideală pentru a stimula concentrarea în timpul lucrului sau al lecturii, lumina caldă, perfectă pentru a crea o atmosferă primitoare și relaxantă, sau lumina neutră, potrivită pentru iluminarea generală de zi cu zi.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:270\"\u003eCu o putere de 49W, lustra Constelation oferă o iluminare eficientă, fiind potrivită pentru camere de dimensiuni medii.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:270\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner_fd335421-028d-496e-9aae-c246dc2d52b6.webp?v=1771849486\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:139\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:17:59+02:00","created_at":"2025-02-25T03:17:58+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","Corpuri de Iluminat","Lustre Copii","Lustre LED"],"variants":[{"id":52344102715659,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL2386","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"299.99","position":1,"product_id":9760744309003,"created_at":"2025-09-09T01:02:46+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51854090010891,"created_at":"2025-02-25T03:18:00+02:00","position":1,"updated_at":"2025-02-25T03:18:01+02:00","product_id":9760744309003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-constelation-alba-1718266521.webp?v=1740446281","width":900,"height":900},{"id":64443882864907,"created_at":"2026-01-16T14:53:56+02:00","position":2,"updated_at":"2026-01-16T14:53:59+02:00","product_id":9760744309003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL2386_EPREL.png?v=1768568039","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758309384459,"title":"Lustra LED cu telecomanda ELON 120W, Ondulata, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-elon-120w-ondulata-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:136\"\u003eLustra LED cu telecomandă ELON este o piesă de iluminat modernă și dinamică, cu o putere de 120W și un design ondulat, finisat în negru.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:341\"\u003eForma ondulată adaugă un element vizual interesant și contemporan. Fiind LED, asigură o iluminare eficientă, iar telecomanda inclusă îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), permițându-ți să creezi atmosfera dorită. Finisajul negru accentuează liniile moderne ale designului.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:195\"\u003eCu o putere de 120W, este potrivită pentru a ilumina livinguri, sufragerii sau alte spații de dimensiuni medii sau mari unde se dorește un element de design modern și o iluminare personalizabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:13:20+02:00","created_at":"2025-02-24T21:13:19+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","Lustre LED Scandinave"],"variants":[{"id":52408538038539,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-2212BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"289.99","grams":0,"compare_at_price":"289.99","position":1,"product_id":9758309384459,"created_at":"2025-09-24T13:53:09+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51820941672715,"created_at":"2025-02-24T21:13:22+02:00","position":1,"updated_at":"2025-02-24T21:13:23+02:00","product_id":9758309384459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-elon-telecomanda-120w-24ghz-dimabila-acril-negru-_LL1872N_01.webp?v=1740424403","width":900,"height":900},{"id":51820941836555,"created_at":"2025-02-24T21:13:22+02:00","position":2,"updated_at":"2025-08-01T16:00:59+03:00","product_id":9758309384459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-elon-telecomanda-120w-24ghz-dimabila-acril-negru-_LL1872N_04.webp?v=1754053259","width":900,"height":900},{"id":51820941934859,"created_at":"2025-02-24T21:13:22+02:00","position":3,"updated_at":"2025-08-01T16:00:59+03:00","product_id":9758309384459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-elon-telecomanda-120w-24ghz-dimabila-acril-negru-_LL1872N_02.webp?v=1754053259","width":900,"height":900},{"id":51820941639947,"created_at":"2025-02-24T21:13:22+02:00","position":4,"updated_at":"2025-08-01T16:00:59+03:00","product_id":9758309384459,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-elon-telecomanda-120w-24ghz-dimabila-acril-negru-_LL1872N_03.webp?v=1754053259","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10723984802059,"title":"Lustra LED cu Telecomanda  LT188WH, Cristal si Metal, 40W, Dimabila, Inaltime Reglabila, Lumina Rece\/Calda\/Neutra, Iluminat Luxos","handle":"lustra-led-cu-telecomanda-lt188wh-cristal-si-metal-40w-dimabila-inaltime-reglabila-lumina-rece-calda-neutra-iluminat-luxos","body_html":"\u003cp data-start=\"119\" data-end=\"434\"\u003e\u003cstrong data-start=\"119\" data-end=\"134\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Banner_cd7414eb-c193-4d59-80db-ba346dba2206.jpg?v=1773138948\" alt=\"\"\u003eLT188WH 40W\u003c\/strong\u003e este o lustra LED cu design elegant, realizată din metal și elemente din cristal, concepută pentru a oferi un iluminat uniform și un efect vizual sofisticat. Dimensiunile compacte (46 x 10 cm) o fac potrivită pentru spații medii sau încăperi unde se dorește un corp de iluminat rafinat, dar discret.\u003c\/p\u003e\u003ch3 data-start=\"436\" data-end=\"460\"\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul data-start=\"461\" data-end=\"846\"\u003e\n\u003cli data-start=\"461\" data-end=\"483\"\u003e\u003cp data-start=\"463\" data-end=\"483\"\u003e\u003cstrong data-start=\"463\" data-end=\"473\"\u003eModel:\u003c\/strong\u003e LT188WH\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"484\" data-end=\"518\"\u003e\u003cp data-start=\"486\" data-end=\"518\"\u003e\u003cstrong data-start=\"486\" data-end=\"497\"\u003ePutere:\u003c\/strong\u003e 40W (LED integrat)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"519\" data-end=\"574\"\u003e\u003cp data-start=\"521\" data-end=\"574\"\u003e\u003cstrong data-start=\"521\" data-end=\"536\"\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"575\" data-end=\"623\"\u003e\u003cp data-start=\"577\" data-end=\"623\"\u003e\u003cstrong data-start=\"577\" data-end=\"596\"\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"624\" data-end=\"660\"\u003e\u003cp data-start=\"626\" data-end=\"660\"\u003e\u003cstrong data-start=\"626\" data-end=\"638\"\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"661\" data-end=\"714\"\u003e\u003cp data-start=\"663\" data-end=\"714\"\u003e\u003cstrong data-start=\"663\" data-end=\"676\"\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"715\" data-end=\"745\"\u003e\u003cp data-start=\"717\" data-end=\"745\"\u003e\u003cstrong data-start=\"717\" data-end=\"732\"\u003eDimensiuni:\u003c\/strong\u003e 46 x 10 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"746\" data-end=\"773\"\u003e\u003cp data-start=\"748\" data-end=\"773\"\u003e\u003cstrong data-start=\"748\" data-end=\"761\"\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"774\" data-end=\"846\"\u003e\u003cp data-start=\"776\" data-end=\"846\"\u003e\u003cstrong data-start=\"776\" data-end=\"787\"\u003eMontaj:\u003c\/strong\u003e Suspendat \/ aplicat (în funcție de sistemul de prindere)\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3 data-start=\"848\" data-end=\"880\"\u003eFuncționalități și beneficii\u003c\/h3\u003e\u003cp data-start=\"881\" data-end=\"1164\"\u003e✔ Selectarea temperaturii de culoare pentru adaptarea atmosferei\u003cbr data-start=\"945\" data-end=\"948\"\u003e✔ Intensitate reglabilă pentru confort vizual optim\u003cbr data-start=\"999\" data-end=\"1002\"\u003e✔ Cristale decorative ce amplifică efectul luminos\u003cbr data-start=\"1052\" data-end=\"1055\"\u003e✔ Înălțime ajustabilă pentru integrare perfectă în spațiu\u003cbr data-start=\"1112\" data-end=\"1115\"\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp data-start=\"1265\" data-end=\"1476\"\u003ePrin combinația dintre tehnologia LED eficientă și detaliile din cristal, \u003cstrong data-start=\"1339\" data-end=\"1365\"\u003eLustra LED LT188WH 40W\u003c\/strong\u003e oferă un echilibru între funcționalitate și estetică premium, fiind ideală pentru un iluminat modern și luxos.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/IN_VS_LED.png?v=1772904965\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:35:49+03:00","created_at":"2025-09-15T13:13:21+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52429952975115,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT188WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"499.99","position":1,"product_id":10723984802059,"created_at":"2025-09-30T17:59:00+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":67110690881803,"created_at":"2026-03-10T12:35:41+02:00","position":1,"updated_at":"2026-03-10T12:40:38+02:00","product_id":10723984802059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.Cover_3effc84d-7eab-4d1a-b91d-d4e39bad4694.jpg?v=1773139238","width":3999,"height":3999},{"id":67110690652427,"created_at":"2026-03-10T12:35:41+02:00","position":2,"updated_at":"2026-03-10T12:40:38