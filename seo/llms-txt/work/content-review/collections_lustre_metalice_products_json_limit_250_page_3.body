z-acril-3000k-4000k-6000k-dimabila-negru_LL208_04.webp?v=1755009736","width":900,"height":900},{"id":51819215356171,"created_at":"2025-02-24T19:37:41+02:00","position":5,"updated_at":"2025-08-12T17:42:16+03:00","product_id":9757935632651,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-lunatica-telecomanda-140w-24ghz-acril-3000k-4000k-6000k-dimabila-negru_LL208_06.webp?v=1755009736","width":900,"height":900},{"id":66213188567307,"created_at":"2026-02-22T17:00:45+02:00","position":6,"updated_at":"2026-02-22T17:00:49+02:00","product_id":9757935632651,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT736_3BK.webp?v=1771772449","width":900,"height":900},{"id":69806649934091,"created_at":"2026-07-21T17:21:48+03:00","position":7,"updated_at":"2026-07-21T17:21:51+03:00","product_id":9757935632651,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2548638_big_color.png?v=1784643711","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779348701451,"title":"Lustra LED DIVINO Auriu 96W cu Tub Silicon Flexibil, 96W, 150cm – Lumina Reglabila 3000K\/4000K\/6000K","handle":"lustra-led-divino-auriu-96w-cu-tub-silicon-flexibil-150cm-lumina-reglabila-3000k-4000k-6000k","body_html":"\u003cp data-sourcepos=\"3:1-3:30\"\u003eLustra LED DIVINO Auriu aduce rafinament și căldură oricărui interior contemporan. Corpul suspendat elegant este realizat din tub silicon flexibil, care permite forme fluide și o lumină uniformă, ideală pentru living, dining sau birou. Cu o putere de 96W și temperaturi de culoare reglabile 3000K \/ 4000K \/ 6000K, oferă o iluminare versatilă – de la lumină caldă relaxantă până la lumină rece pentru concentrare.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003eFinisajul auriu satinat accentuează designul sofisticat și modern, aducând un plus de eleganță în orice spațiu. Perfectă pentru cei care doresc să combine tehnologia LED eficientă cu stilul premium al designului interior.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-15:0\"\u003e\u003c\/ul\u003e\u003cp data-sourcepos=\"1:1-1:207\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-09-15T16:55:16+03:00","created_at":"2025-03-06T18:45:55+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Moderne","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Suspendate"],"variants":[{"id":52372611694859,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT118\/150GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":9779348701451,"created_at":"2025-09-16T01:26:45+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":62198108782859,"created_at":"2025-11-10T14:28:40+02:00","position":1,"updated_at":"2025-11-10T14:30:46+02:00","product_id":9779348701451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPT_Image_Nov_10_2025_02_28_32_PM.png?v=1762777846","width":1024,"height":1024},{"id":62198125822219,"created_at":"2025-11-10T14:30:34+02:00","position":2,"updated_at":"2025-11-10T14:30:46+02:00","product_id":9779348701451,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/