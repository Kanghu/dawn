/files\/mockup-LT721_4GD-LustraLEDcuTelecomndaMARIA_45W_4Elemente_LuminaCalda_Rece_Neutra_Dimabila_Negru_6.jpg?v=1750073739","width":1080,"height":1080},{"id":56463754854667,"created_at":"2025-06-16T10:45:39+03:00","position":8,"updated_at":"2025-12-23T15:13:42+02:00","product_id":10238210015499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-LT720_6-LustraLEDcuTelecomandaMARIA_6elemente_63W_LuminaCalda_Rece_Neutra_Auriu_5.jpg?v=1766495622","width":1080,"height":1080},{"id":62879163449611,"created_at":"2025-11-30T12:31:46+02:00","position":9,"updated_at":"2025-11-30T12:31:50+02:00","product_id":10238210015499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT721_4GD_PREL.png?v=1764498710","width":2048,"height":2048},{"id":66210810986763,"created_at":"2026-02-22T16:35:09+02:00","position":10,"updated_at":"2026-02-22T16:35:12+02:00","product_id":10238210015499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT721_4GD.webp?v=1771770912","width":1024,"height":1024}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9756775285003,"title":"Lustra LED cu cristal ANAIDA RGB 20W, 3000K \/ 4000K \/ 6000K, Auriu","handle":"lustra-led-cu-cristal-anaida-rgb-20w-lumina-3000k-4000k-6000k-auriu","body_html":"\u003cp data-sourcepos=\"1:1-1:222\"\u003eAceastă lustră \u003cstrong\u003eLED \u003c\/strong\u003eAnaida, de \u003cstrong\u003e20W\u003c\/strong\u003e și culoare auriu, oferă \u003cstrong\u003etrei tipuri de lumină \u003c\/strong\u003eintegrate: \u003cstrong\u003erece, neutră și caldă\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate. În plus, dispune de funcția RGB, adăugând posibilitatea de iluminare ambientală colorată.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:30\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-10:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:51\"\u003e\n\u003cstrong\u003ePutere:\u003c\/strong\u003e 20W, asigurând o iluminare eficientă.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eTemperatură Culoare Variabilă:\u003c\/strong\u003e Lumină rece, caldă și neutră, adaptabilă nevoilor tale.\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:94\"\u003e\n\u003cstrong\u003eFuncție RGB:\u003c\/strong\u003e Permite selectarea dintr-o varietate de culori pentru iluminare ambientală.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-8:69\"\u003e\n\u003cstrong\u003eDesign:\u003c\/strong\u003e Culoarea auriu conferă un aspect elegant și sofisticat.\u003c\/li\u003e\n\u003cli data-sourcepos=\"9:1-10:0\"\u003e\n\u003cstrong\u003eTehnologie LED:\u003c\/strong\u003e Eficiență energetică ridicată și durată de viață lungă.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"11:1-11:154\"\u003eAceastă lustră este ideală pentru cei care doresc o lumină principală caldă, dar și posibilitatea de a adăuga accente de culoare în funcție de preferințe.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:154\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T11:43:37+02:00","created_at":"2025-02-24T11:43:36+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428353339659,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL107RGB","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"139.99","grams":0,"compare_at_price":"139.99","position":1,"product_id":9756775285003,"created_at":"2025-09-30T13:45:37+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51810108801291,"created_at":"2025-02-24T11:43:40+02:00","position":1,"updated_at":"2025-02-24T11:43:43+02:00","product_id":9756775285003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-anaida-48w-auriu-3000k-rgb_LL117AU_01.webp?v=1740390223","width":900,"height":900},{"id":51810108768523,"created_at":"2025-02-24T11:43:40+02:00","position":2,"updated_at":"2025-02-24T11:43:43+02:00","product_id":9756775285003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-anaida-48w-auriu-3000k-rgb_LL117AU_02.webp?v=1740390223","width":900,"height":900},{"id":51810108834059,"created_at":"2025-02-24T11:43:40+02:00","position":3,"updated_at":"2025-02-24T11:43:43+02:00","product_id":9756775285003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-anaida-48w-auriu-3000k-rgb_LL117AU_03.webp?v=1740390223","width":900,"height":900},{"id":51810108735755,"created_at":"2025-02-24T11:43:41+02:00","position":4,"updated_at":"2025-02-24T11:43:43+02:00","product_id":9756775285003,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-anaida-48w-auriu-3000k-rgb_LL117AU_04.webp?v=1740390223","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758070604043,"title":"Lustra LED MARTE 41W, Diametru 30cm, lumina Rece\/Calda\/Neutra, Gri","handle":"lustra-led-marte-41w-diametru-30cm-lumina-rece-calda-neutra-gri","body_html":"\u003cp\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cspan\u003eLustra LED MARTE, de 41W și cu un diametru de 30cm, este o opțiune de iluminat modernă și compactă, finisată în alb. Această lustră oferă o iluminare versatilă, permițând alegerea între lumină rece, ideală pentru activități care necesită concentrare, lumină caldă, care creează o atmosferă primitoare, și lumină neutră, potrivită pentru iluminatul general. Designul său simplu și dimensiunile reduse (30cm diametru) o fac potrivită pentru diverse încăperi, fără a ocupa mult spațiu vizual. Culoarea gri contribuie la un aspect luminos și curat. Cu o putere de 41W, ar trebui să ofere o iluminare bună pentru camere de dimensiuni mici spre medii.\u003c\/span\u003e\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T20:24:14+02:00","created_at":"2025-02-24T20:24:13+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustra LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52405463974155,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL280M","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":9758070604043,"created_at":"2025-09-23T15:53:03+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69658358546699,"created_at":"2026-07-03T11:49:38+03:00","position":1,"updated_at":"2026-07-03T11:56:06+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_1.png?v=1783068966","width":1254,"height":1254},{"id":69658378010891,"created_at":"2026-07-03T11:54:54+03:00","position":2,"updated_at":"2026-07-03T11:56:16+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_2.png?v=1783068976","width":1254,"height":1254},{"id":69658684817675,"created_at":"2026-07-03T13:05:35+03:00","position":3,"updated_at":"2026-07-03T13:06:55+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_11.png?v=1783073215","width":1254,"height":1254},{"id":51819895456011,"created_at":"2025-02-24T20:24:15+02:00","position":4,"updated_at":"2026-07-03T11:56:25+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_3.webp?v=1783068985","width":1024,"height":1024},{"id":51819895914763,"created_at":"2025-02-24T20:24:15+02:00","position":5,"updated_at":"2026-07-03T11:56:34+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_4_1_-1738166117.webp?v=1783068994","width":1024,"height":1024},{"id":69658340950283,"created_at":"2026-07-03T11:45:43+03:00","position":6,"updated_at":"2026-07-03T11:56:44+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_5.png?v=1783069004","width":1254,"height":1254},{"id":69658355892491,"created_at":"2026-07-03T11:48:54+03:00","position":7,"updated_at":"2026-07-03T11:57:16+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_8.png?v=1783069036","width":1254,"height":1254},{"id":69658344456459,"created_at":"2026-07-03T11:46:19+03:00","position":8,"updated_at":"2026-07-03T11:57:05+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_7.jpg?v=1783069025","width":1254,"height":1254},{"id":63977187967243,"created_at":"2025-12-30T15:11:04+02:00","position":9,"updated_at":"2026-07-03T11:56:55+03:00","product_id":9758070604043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_MARTE_41W_Diametru_30cm_lumina_Rece_Calda_Neutra_Gri_6.png?v=1783069015","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760003916043,"title":"Lustra LED cu telecomanda si cristal LEILA RGB 69W, 4 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-si-cristal-leila-rgb-69w-4-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv class=\"chat-history-scroll-container\" id=\"chat-history\"\u003e\u003cdiv id=\"675ff84a35605ee6\" class=\"conversation-container message-actions-hover-boundary tts-removed ng-star-inserted\"\u003e\u003cdiv\u003e\u003cdiv class=\"response-container ng-tns-c3043829428-179 response-container-with-gpi tts-removed ng-star-inserted response-container-has-multiple-responses\"\u003e\u003cdiv class=\"presented-response-container ng-tns-c3043829428-179\"\u003e\u003cdiv class=\"response-container-content ng-tns-c3043829428-179\"\u003e\u003cdiv class=\"response-content ng-tns-c3043829428-179\"\u003e\u003cdiv dir=\"ltr\" id=\"model-response-message-contentr_675ff84a35605ee6\" class=\"markdown markdown-main-panel\"\u003e\n\u003cp data-sourcepos=\"3:1-3:98\"\u003e\u003cstrong\u003eEleganță Modernă, Strălucire Cristalină și Spectru de Culoare: Lustra LED Leila cu Telecomandă\u003c\/strong\u003e\u003c\/p\u003e\n\u003cp data-sourcepos=\"5:1-5:305\"\u003eÎmbracă-ți spațiul cu un rafinament contemporan și o paletă de culori vibrante cu lustra LED Leila. Designul său elegant îmbină finisajul cu elemente \u003cstrong\u003ealbe\u003c\/strong\u003e, accentuate de strălucirea captivantă a \u003cstrong\u003ecristalelor\u003c\/strong\u003e. Această lustră devine un punct focal modern și dinamic în orice încăpere.\u003c\/p\u003e\n\u003cp data-sourcepos=\"7:1-7:249\"\u003eCu o putere de \u003cstrong\u003e69W\u003c\/strong\u003e, lustra LED Leila oferă o iluminare eficientă și amplă. Datorită \u003cstrong\u003etelecomenzii incluse\u003c\/strong\u003e, ai control total asupra atmosferei luminoase. Poți ajusta intensitatea luminii cu funcția \u003cstrong\u003edimabilă\u003c\/strong\u003e pentru a crea ambientul perfect.\u003c\/p\u003e\n\u003cp data-sourcepos=\"9:1-9:295\"\u003eUn aspect remarcabil este capacitatea \u003cstrong\u003eRGB\u003c\/strong\u003e, care îți permite să alegi dintr-o gamă largă de culori pentru a personaliza iluminatul în funcție de starea ta de spirit sau de ocazie. De la tonuri calde și relaxante la culori vibrante și energizante, lustra Leila oferă o flexibilitate uimitoare.\u003c\/p\u003e\n\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"13:1-20:0\"\u003e\n\u003cli data-sourcepos=\"13:1-13:95\"\u003e\n\u003cstrong\u003eDesign Modern și Elegant:\u003c\/strong\u003e Finisaj cu elemente albe și cristale strălucitoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"14:1-14:54\"\u003e\n\u003cstrong\u003ePutere Eficientă:\u003c\/strong\u003e 69W pentru o iluminare optimă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"15:1-15:87\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil al intensității luminoase și al culorilor RGB.\u003c\/li\u003e\n\u003cli data-sourcepos=\"16:1-16:88\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă pentru a crea ambientul dorit.\u003c\/li\u003e\n\u003cli data-sourcepos=\"17:1-17:89\"\u003e\n\u003cstrong\u003eIluminare RGB:\u003c\/strong\u003e Alege dintr-o paletă largă de culori pentru a personaliza atmosfera.\u003c\/li\u003e\n\u003cli data-sourcepos=\"18:1-18:94\"\u003e\n\u003cstrong\u003eMateriale de Calitate:\u003c\/strong\u003e Metal durabil cu finisaj crom, elemente albe și cristale premium.\u003c\/li\u003e\n\u003cli data-sourcepos=\"19:1-20:0\"\u003e\n\u003cstrong\u003eStil Contemporan și Dinamic:\u003c\/strong\u003e Se integrează perfect în interioarele moderne și eclectice.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"21:1-21:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul data-sourcepos=\"23:1-28:0\"\u003e\n\u003cli data-sourcepos=\"23:1-23:93\"\u003e\n\u003cstrong\u003eControl Total al Luminii și Culorii:\u003c\/strong\u003e Personalizează atmosfera în funcție de preferințe.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-24:100\"\u003e\n\u003cstrong\u003eAspect Estetic Plăcut:\u003c\/strong\u003e Combinația de crom, alb și cristale adaugă un plus de eleganță modernă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"25:1-25:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"26:1-26:109\"\u003e\n\u003cstrong\u003eCreează Ambiante Diverse:\u003c\/strong\u003e Perfectă pentru relaxare, petreceri sau pentru a adăuga un accent de culoare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"27:1-28:0\"\u003e\n\u003cstrong\u003eUșor de Utilizat:\u003c\/strong\u003e Telecomanda intuitivă face controlul luminii și culorilor simplu și confortabil.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003cp data-sourcepos=\"29:1-29:217\"\u003eLustra LED Leila cu telecomandă este alegerea ideală pentru a adăuga un plus de stil, confort și culoare în casa ta. Bucură-te de iluminarea modernă, de strălucirea cristalelor și de spectrul vibrant al culorilor RGB!\u003c\/p\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003cdiv class=\"input-area-container ng-star-inserted\"\u003e\u003cdiv class=\"input-area ng-tns-c157395579-2 with-toolbox-drawer\" data-node-type=\"input-area\"\u003e\u003cdiv class=\"text-input-field ng-tns-c157395579-2 with-toolbox-drawer height-expanded-past-single-line\"\u003e\n\u003cdiv class=\"text-input-field_textarea-wrapper ng-tns-c157395579-2\"\u003e\u003cdiv class=\"text-input-field-main-area ng-tns-c157395579-2\"\u003e\u003cdiv class=\"text-input-field_textarea-inner ng-tns-c157395579-2\"\u003e\u003cdiv class=\"ql-clipboard\" tabindex=\"-1\"\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003cdiv class=\"leading-actions-wrapper ng-tns-c157395579-2 ng-star-inserted\"\u003e\u003cdiv class=\"toolbox-drawer-container ng-tns-c549618185-11 ng-trigger ng-trigger-toolboxDrawerEnter\"\u003e\u003cdiv class=\"toolbox-drawer-button-label label\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e\n\u003c\/div\u003e\u003c\/div\u003e\u003c\/div\u003e","published_at":"2025-02-25T01:21:43+02:00","created_at":"2025-02-25T01:21:43+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52412296560907,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT078\/4WH","requires_shipping":true,"taxa