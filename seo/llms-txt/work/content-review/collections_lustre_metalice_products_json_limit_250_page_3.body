/5175\/3739\/files\/11.Place1_5448d1ce-7c38-4012-aad7-ac2375635c33.jpg?v=1775080337","width":3999,"height":3999},{"id":62877338173707,"created_at":"2025-11-30T12:03:17+02:00","position":15,"updated_at":"2026-04-02T00:52:17+03:00","product_id":10723984802059,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT188WH_PREL.png?v=1775080337","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758324556043,"title":"Lustra LED VERTEX 21W, 2 Patrate, Liniara, lumina Rece\/Calda\/Neutra, Neagra","handle":"lustra-led-vertex-21w-2-patrate-liniara-lumina-rece-calda-neutra-neagra","body_html":"\u003cp data-sourcepos=\"3:1-3:88\"\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17.BANNER_26f470c7-2a49-4181-baad-187cd3a4864b.png?v=1778235148\"\u003eEleganță Geometrică și Iluminare Adaptabilă: Lustra LED VERTEX Grid Pătrate Paralele\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:302\"\u003eAdu un strop de modernitate sofisticată și o lumină versatilă în casa ta cu Lustra LED VERTEX Grid. Designul său minimalist, compus din \u003cstrong\u003edouă pătrate paralele\u003c\/strong\u003e cu un finisaj \u003cstrong\u003enegru\u003c\/strong\u003e elegant, creează un efect vizual aerisit și contemporan, perfect pentru a adăuga un accent stilat oricărei încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:379\"\u003eCu o putere totală de \u003cstrong\u003e21W\u003c\/strong\u003e, această lustră LED oferă o iluminare eficientă și plăcută, ideală pentru holuri, birouri mici, dressinguri sau alte spații care necesită o lumină uniformă și modernă. Bucură-te de flexibilitatea \u003cstrong\u003etrei tipuri de lumină \u003c\/strong\u003eintegrate: \u003cstrong\u003erece, caldă și neutră\u003c\/strong\u003e, permițându-ți să adaptezi iluminatul în funcție de starea ta de spirit sau de activitate.\u003c\/p\u003e\u003cp data-sourcepos=\"9:1-9:146\"\u003eDesignul cu pătrate paralele nu doar arată modern, dar asigură și o distribuție echilibrată a luminii, creând o atmosferă plăcută și confortabilă.\u003c\/p\u003e\u003cp data-sourcepos=\"11:1-11:25\"\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-02-24T21:17:02+02:00","created_at":"2025-02-24T21:17:01+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52412065284363,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL770\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":9758324556043,"created_at":"2025-09-25T16:08:04+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":68771834003723,"created_at":"2026-05-08T13:12:24+03:00","position":1,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/1.COVER_1ecf00e8-b22a-4722-9930-993067d2bff3.png?v=1778235148","width":1000,"height":1000},{"id":68771834134795,"created_at":"2026-05-08T13:12:24+03:00","position":2,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9.CLOSE-UP2_527fb353-b1a3-4939-b611-03bacbeb5561.png?v=1778235148","width":1000,"height":1000},{"id":68771834036491,"created_at":"2026-05-08T13:12:24+03:00","position":3,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/5.3-TONECONTROL_5003839f-08f7-4ec8-8227-6c3ad437f9c4.png?v=1778235148","width":1000,"height":1000},{"id":68771834069259,"created_at":"2026-05-08T13:12:24+03:00","position":4,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_9099f60d-428c-488a-b844-aa31403a2a85.png?v=1778235148","width":1000,"height":1000},{"id":68771834102027,"created_at":"2026-05-08T13:12:24+03:00","position":5,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.SPECIFICATION_ab4bfb6d-7f98-443e-879d-6815a7343471.png?v=1778235148","width":1000,"height":1000},{"id":68771834167563,"created_at":"2026-05-08T13:12:24+03:00","position":6,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.PLACE1_903b189d-ca00-4d56-abb6-40003d295220.png?v=1778235148","width":1000,"height":1000},{"id":68771834200331,"created_at":"2026-05-08T13:12:24+03:00","position":7,"updated_at":"2026-05-08T13:12:29+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.PLACE2_03728d42-7560-4587-bfcb-05fa2e18d9d2.png?v=1778235149","width":1000,"height":1000},{"id":68771834233099,"created_at":"2026-05-08T13:12:24+03:00","position":8,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.PLACE3_d95a3ad2-e3de-42b2-9d8d-f0bda51930b2.png?v=1778235148","width":1000,"height":1000},{"id":68771834265867,"created_at":"2026-05-08T13:12:24+03:00","position":9,"updated_at":"2026-05-08T13:12:28+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/15.PLACE4_59d81721-bf6c-4eb4-975e-262ca6b11d7f.png?v=1778235148","width":1000,"height":1000},{"id":68771834298635,"created_at":"2026-05-08T13:12:24+03:00","position":10,"updated_at":"2026-05-08T13:12:29+03:00","product_id":9758324556043,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/17.BANNER_26f470c7-2a49-4181-baad-187cd3a4864b.png?v=1778235149","width":2960,"height":978}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759396823307,"title":"Lustra LED cu telecomanda si cristal GRACIANA 112W, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Crom Lucios","handle":"lustra-led-cu-telecomanda-si-cristal-graciana-112w-liniara-lumina-rece-calda-neutra-dimabila-crom-lucios","body_html":"\u003cp data-sourcepos=\"1:1-1:276\"\u003eLustra LED suspendată cu telecomandă și cristale GRACIANA este o piesă de iluminat elegantă și modernă, cu un design liniar și un finisaj crom lucios, împodobit cu cristale strălucitoare. Cu o putere de 112W, oferă o iluminare eficientă și un plus de rafinament spațiului tău.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:610\"\u003eForma liniară sugerează o distribuție uniformă a luminii pe o anumită lungime, perfectă pentru deasupra meselor, insulelor de bucătărie sau în livinguri. Cristalele vor reflecta și refracta lumina LED integrată, creând un efect sclipitor și o atmosferă luxoasă. Telecomanda inclusă îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și intensității luminii (dimabilă), permițându-ți să personalizezi iluminarea. Finisajul crom lucios accentuează strălucirea cristalelor și adaugă o notă contemporană și sofisticată designului. Fiind suspendată, va deveni un punct focal elegant în încăpere.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T23:42:42+02:00","created_at":"2025-02-24T23:42:41+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Cristal","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda"],"variants":[{"id":52038333890827,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-JB003\/4","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"379.99","grams":0,"compare_at_price":"379.99","position":1,"product_id":9759396823307,"created_at":"2025-08-05T15:27:36+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51832460607755,"created_at":"2025-02-24T23:42:43+02:00","position":1,"updated_at":"2025-02-24T23:42:45+02:00","product_id":9759396823307,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-julitta-telecomanda-112w-argintiu_AT1CT-VV1A-HT2L-JB003-4_01.webp?v=1740433365","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760244891915,"title":"Aplica LED CASSIUS, 24W, Liniara, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-cassius-24w-liniara-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eLustra LED Cassius este alegerea perfectă pentru a adăuga un element elegant și modern în holul sau dressingul dvs. Cu o putere de 24W și culoarea negru, această lustră oferă un flux luminos de 1920lm, asigurând o iluminare strălucitoare și eficientă în spațiul dorit.\u003cbr\u003e\u003cbr\u003eCu o lungime de 60cm, lustra LED Cassius are dimensiuni ideale pentru a se integra armonios în orice colț al holului sau dressingului dvs. Designul său cu aspect lustruit și finisajul negru conferă o notă de eleganță și rafinament, făcând-o potrivită pentru diferite stiluri de interior.\u003cbr\u003e\u003cbr\u003eTehnologia LED utilizată în această lustră oferă o eficiență energetică superioară, contribuind la economisirea energiei și la o durată de viață îndelungată a lămpilor. Acest lucru vă va permite să vă bucurați de iluminat de calitate fără a vă face griji în privința costurilor de întreținere.\u003cbr\u003e\u003cbr\u003eRecomandată pentru a aduce o lumină plăcută și sofisticată în hol sau dressing, lustra LED Cassius va fi punctul central al decorului dvs. Cu un flux luminos puternic și uniform, această lustră va crea o atmosferă primitoare și funcțională în spațiul dorit. Bucurați-vă de eleganța și lumina oferite de lustra LED Cassius pentru a face din hol sau dressing un spațiu plăcut și atrăgător.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T02:00:38+02:00","created_at":"2025-02-25T02:00:37+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52422115557643,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-3052\/600BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"99.99","position":1,"product_id":9760244891915,"created_at":"2025-09-28T14:53:51+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51845629837579,"created_at":"2025-02-25T02:00:40+02:00","position":1,"updated_at":"2025-02-25T02:00:42+02:00","product_id":9760244891915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cassius-24w-alb-negru-1690187750.webp?v=1740441642","width":900,"height":900},{"id":51845629739275,"created_at":"2025-02-25T02:00:40+02:00","position":2,"updated_at":"2025-02-25T02:00:42+02:00","product_id":9760244891915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cassius_3052-600bk_02-1690187751.webp?v=1740441642","width":900,"height":900},{"id":51845629903115,"created_at":"2025-02-25T02:00:40+02:00","position":3,"updated_at":"2025-02-25T02:00:42+02:00","product_id":9760244891915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cassius_3052-600bk_03-1690187752.webp?v=1740441642","width":900,"height":900},{"id":51845629804811,"created_at":"2025-02-25T02:00:40+02:00","position":4,"updated_at":"2025-02-25T02:00:42+02:00","product_id":9760244891915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cassius_3052-600bk_04-1690187753.webp?v=1740441642","width":900,"height":900},{"id":51845629772043,"created_at":"2025-02-25T02:00:40+02:00","position":5,"updated_at":"2025-02-25T02:00:42+02:00","product_id":9760244891915,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cassius_3052-600bk_05-1690187753.webp?v=1740441642","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757621846283,"title":"Lustra LED cu telecomanda ALANI 52W, 4 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-alani-52w-4-cercuri-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eModelul corpului de iluminat este creat cu ajutorul a patru cercuri, poziționate în direcții și la înălțimi diferite, care creează un efect asimetric dar totodată plăcut vizual. Fiecare cerc are incorporat o sursă de iluminare creată din bandă LED.\u003c\/span\u003e\u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cbr\u003e\u003cspan style=\"font-size: 16px;\"\u003eBenzile LED sunt cunoscute pentru beneficiile financiare pe care le aduc, având în vedere că produsele bazate pe această tehnologie sunt mult mai rezistente și consumă mai putin curent electric, fiind foarte economice.\u003cbr\u003e\u003cbr\u003eLustra Alani are o putere de 52W și este controlată cu ajutorul unei telecomenzi - poți aprinde\/stinge lumina, ajusta intestentitatea acesteia, schimba tonul de culoare după bunul plac dintre Cald, Neutru, Rece.\u003cbr\u003e\u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e \u003c\/span\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T17:20:12+02:00","created_at":"2025-02-24T17:20:11+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52389110972683,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-8067\/2+2int","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"159.99","grams":0,"compare_at_price":"159.99","position":1,"product_id":9757621846283,"created_at":"2025-09-19T16:19:25+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51816837775627,"created_at":"2025-02-24T17:20:13+02:00","position":1,"updated_at":"2025-02-24T17:20:15+02:00","product_id":9757621846283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-alani-88w-dimabila-alb_LL1603AL_01.webp?v=1740410415","width":900,"height":900},{"id":51816837873931,"created_at":"2025-02-24T17:20:13+02:00","position":2,"updated_at":"2025-02-24T17:20:15+02:00","product_id":9757621846283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-alani-88w-dimabila-alb_LL1603AL_02.webp?v=1740410415","width":900,"height":900},{"id":51816837906699,"created_at":"2025-02-24T17:20:14+02:00","position":3,"updated_at":"2025-02-24T17:20:16+02:00","product_id":9757621846283,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-alani-88w-dimabila-alb_LL1603AL_03.webp?v=1740410416","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760363249931,"title":"Lustra LED DUOFORM, 21W, 3 Patrate, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-duoform-21w-3-patrate-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:306\"\u003eLustra LED DUOFORM, cu o putere de 21W și un design modern ce integrează 3 pătrate, este acum disponibilă și în nuanța elegantă de negru. Această variantă păstrează versatilitatea iluminării, oferind opțiuni pentru lumină rece, caldă sau neutră, dar adaugă un plus de sofisticare și contrast spațiului tău.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:300\"\u003eDesignul geometric cu cele 3 pătrate negre creează un impact vizual puternic, perfect pentru interioarele moderne, minimaliste sau chiar industriale. Liniile curate și culoarea neagră accentuează structura lămpii, transformând-o într-un punct focal al încăperii, chiar și atunci când nu este aprinsă.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:305\"\u003eSimilar cu varianta albă, această lustră LED de 21W oferă o iluminare eficientă și adaptabilă. Poți schimba temperatura de culoare pentru a crea atmosfera dorită: o lumină rece pentru un ambient energizant, o lumină caldă pentru o senzație confortabilă sau o lumină neutră pentru activitățile de zi cu zi.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:305\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T02:20:01+02:00","created_at":"2025-02-25T02:20:01+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","SUB50"],"variants":[{"id":52429935771915,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL567BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"79.99","position":1,"product_id":9760363249931,"created_at":"2025-09-30T17:56:32+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51847877558539,"created_at":"2025-02-25T02:20:03+02:00","position":1,"updated_at":"2025-02-25T02:20:04+02:00","product_id":9760363249931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-cohen-25w-alb-negru-1693818659.webp?v=1740442804","width":900,"height":900},{"id":64130905112843,"created_at":"2026-01-05T14:59:13+02:00","position":2,"updated_at":"2026-01-05T14:59:17+02:00","product_id":9760363249931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL567BK_EPREL.png?v=1767617957","width":2048,"height":2048},{"id":66230788129035,"created_at":"2026-02-22T21:01:01+02:00","position":3,"updated_at":"2026-02-22T21:01:03+02:00","product_id":9760363249931,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LL567BK.webp?v=1771786863","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10723981984011,"title":"Lustra LED cu Telecomanda LT187WH, Cristal si Metal, 52W, Dimabila, Inaltime Reglabila, lumina Rece\/Calda\/Neutra, Iluminat Luxos","handle":"lustra-led-cu-telecomanda-lt187wh-cristal-si-metal-52w-dimabila-inaltime-reglabila-lumina-rece-calda-neutra-iluminat-luxos","body_html":"\u003cp data-start=\"119\" data-end=\"421\"\u003e\u003cstrong data-start=\"119\" data-end=\"134\"\u003eLT187WH 52W\u003c\/strong\u003e este o lustra LED cu design elegant, realizată din metal și elemente din cristal, concepută pentru a oferi un iluminat luxos și uniform. Proporțiile echilibrate (58 x 12 cm) și finisajele rafinate o transformă într-un corp de iluminat potrivit pentru interioare moderne sau sofisticate.\u003c\/p\u003e\u003ch3 data-start=\"423\" data-end=\"447\"\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul data-start=\"448\" data-end=\"833\"\u003e\n\u003cli data-start=\"448\" data-end=\"470\"\u003e\u003cp data-start=\"450\" data-end=\"470\"\u003e\u003cstrong data-start=\"450\" data-end=\"460\"\u003eModel:\u003c\/strong\u003e LT187WH\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"471\" data-end=\"505\"\u003e\u003cp data-start=\"473\" data-end=\"505\"\u003e\u003cstrong data-start=\"473\" data-end=\"484\"\u003ePutere:\u003c\/strong\u003e 52W (LED integrat)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"506\" data-end=\"561\"\u003e\u003cp data-start=\"508\" data-end=\"561\"\u003e\u003cstrong data-start=\"508\" data-end=\"523\"\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"562\" data-end=\"610\"\u003e\u003cp data-start=\"564\" data-end=\"610\"\u003e\u003cstrong data-start=\"564\" data-end=\"583\"\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"611\" data-end=\"647\"\u003e\u003cp data-start=\"613\" data-end=\"647\"\u003e\u003cstrong data-start=\"613\" data-end=\"625\"\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"648\" data-end=\"701\"\u003e\u003cp data-start=\"650\" data-end=\"701\"\u003e\u003cstrong data-start=\"650\" data-end=\"663\"\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"702\" data-end=\"732\"\u003e\u003cp data-start=\"704\" data-end=\"732\"\u003e\u003cstrong data-start=\"704\" data-end=\"719\"\u003eDimensiuni:\u003c\/strong\u003e 58 x 12 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"733\" data-end=\"760\"\u003e\u003cp data-start=\"735\" data-end=\"760\"\u003e\u003cstrong data-start=\"735\" data-end=\"748\"\u003eÎnălțime:\u003c\/strong\u003e Reglabilă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli data-start=\"761\" data-end=\"833\"\u003e\u003cp data-start=\"763\" data-end=\"833\"\u003e\u003cstrong data-start=\"763\" data-end=\"774\"\u003eMontaj:\u003c\/strong\u003e Suspendat \/ aplicat (în funcție de sistemul de prindere)\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3 data-start=\"835\" data-end=\"867\"\u003eFuncționalități și beneficii\u003c\/h3\u003e\u003cp data-start=\"868\" data-end=\"1167\"\u003e✔ Control al temperaturii de culoare pentru diferite scenarii de iluminare\u003cbr data-start=\"942\" data-end=\"945\"\u003e✔ Intensitate reglabilă pentru confort vizual personalizat\u003cbr data-start=\"1003\" data-end=\"1006\"\u003e✔ Cristale decorative ce oferă un efect strălucitor elegant\u003cbr data-start=\"1065\" data-end=\"1068\"\u003e✔ Înălțime ajustabilă pentru adaptare la spațiu\u003cbr data-start=\"1115\" data-end=\"1118\"\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp data-start=\"1295\" data-end=\"1517\"\u003ePrin combinația dintre tehnologia LED performantă și detaliile sofisticate din cristal, \u003cstrong data-start=\"1383\" data-end=\"1409\"\u003eLustra LED LT187WH 52W\u003c\/strong\u003e oferă un iluminat eficient și o estetică rafinată, devenind un element central în amenajările contemporane.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:35:48+03:00","created_at":"2025-09-15T13:04:36+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Ciresar 25","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52429889634571,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT187WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"279.99","grams":0,"compare_at_price":"539.99","position":1,"product_id":10723981984011,"created_at":"2025-09-30T17:49:03+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":60332708430091,"created_at":"2025-09-15T13:05:11+03:00","position":1,"updated_at":"2025-09-15T13:05:18+03:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_74b30638-1542-46ad-a8ed-3116068cc21b.png?v=1757930718","width":2000,"height":2000},{"id":60332708495627,"created_at":"2025-09-15T13:05:11+03:00","position":2,"updated_at":"2025-09-15T13:06:44+03:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a3_8e7e61fe-be9b-4918-9c80-fb4c09365779.png?v=1757930804","width":2000,"height":2000},{"id":60332708528395,"created_at":"2025-09-15T13:05:11+03:00","position":3,"updated_at":"2025-09-15T13:10:38+03:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a4_1f59a382-a3f6-4be9-beb2-eb954fac6284.png?v=1757931038","width":2000,"height":2000},{"id":60332732317963,"created_at":"2025-09-15T13:07:30+03:00","position":4,"updated_at":"2025-09-15T13:10:38+03:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a5_739498b8-9c9c-42c1-8721-1de5c0c6957c.png?v=1757931038","width":2000,"height":2000},{"id":60332708462859,"created_at":"2025-09-15T13:05:11+03:00","position":5,"updated_at":"2025-09-15T13:10:38+03:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_d95e24c0-d041-48cb-b906-b53e642a26ce.png?v=1757931038","width":2000,"height":2000},{"id":62528734429451,"created_at":"2025-11-20T17:06:19+02:00","position":6,"updated_at":"2025-11-20T17:06:23+02:00","product_id":10723981984011,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT187WH_EPREL_c07b94c7-25e8-49ea-8299-88646f4c52f4.png?v=1763651183","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757833298187,"title":"Lustra LED cu telecomanda  FELIX 87W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-felix-87w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:230\"\u003eLustra LED cu \u003cstrong\u003etelecomandă FELIX\u003c\/strong\u003e este o opțiune de iluminat modernă și funcțională, cu un design format din \u003cstrong\u003e3 pătrate stilizate\u003c\/strong\u003e, finisate în \u003cstrong\u003ealb\u003c\/strong\u003e. Cu o putere de \u003cstrong\u003e87W\u003c\/strong\u003e, oferă o iluminare generoasă și versatilă pentru diverse încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:477\"\u003eCele trei pătrate, dispuse probabil într-o manieră care creează un ansamblu vizual echilibrat și contemporan, sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul \u003cstrong\u003etelecomenzii\u003c\/strong\u003e, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:197\"\u003eFinisajul \u003cstrong\u003ealb \u003c\/strong\u003eal lustrei îi conferă un aspect curat și minimalist, făcând-o ușor de integrat în diverse stiluri de decor interior. Designul cu pătrate adaugă o notă geometrică și modernă spațiului.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:150\"\u003eCu o putere de \u003cstrong\u003e87W\u003c\/strong\u003e, lustra FELIX este ideală pentru a ilumina eficient livinguri, sufragerii, dormitoare sau alte spații de dimensiuni medii sau mari.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T18:36:18+02:00","created_at":"2025-02-24T18:36:17+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428744982795,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT262\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"149.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":9757833298187,"created_at":"2025-09-30T15:26:18+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55425784905995,"created_at":"2025-05-14T16:50:04+03:00","position":1,"updated_at":"2025-05-14T16:51:30+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT262_3WH-LustraLEDcutelecomandaFELIX_75W_3Patrate_luminaRece_Calda_Neutra_Dimabila_Alb-2.png?v=1747230690","width":1080,"height":1080},{"id":51818198925579,"created_at":"2025-02-24T18:36:20+02:00","position":2,"updated_at":"2025-05-14T16:51:30+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-felix-77w-dimabila-alb_LL1973AL_03.webp?v=1747230690","width":900,"height":900},{"id":51818198827275,"created_at":"2025-02-24T18:36:19+02:00","position":3,"updated_at":"2025-05-14T16:51:30+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-felix-77w-dimabila-alb_LL1973AL_05.webp?v=1747230690","width":900,"height":900},{"id":51818198892811,"created_at":"2025-02-24T18:36:20+02:00","position":4,"updated_at":"2025-05-14T16:51:30+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-felix-77w-dimabila-alb_LL1973AL_02.webp?v=1747230690","width":900,"height":900},{"id":51818198958347,"created_at":"2025-02-24T18:36:20+02:00","position":5,"updated_at":"2025-05-14T16:50:11+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-felix-77w-dimabila-alb_LL1973AL_04.webp?v=1747230611","width":900,"height":900},{"id":55425781760267,"created_at":"2025-05-14T16:50:04+03:00","position":6,"updated_at":"2025-05-14T16:50:11+03:00","product_id":9757833298187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT262_3WH-LustraLEDcutelecomandaFELIX_75W_3Patrate_luminaRece_Calda_Neutra_Dimabila_Alb-1.png?v=1747230611","width":1080,"height":1080}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757207953675,"title":"Lustra LED suspendata cu telecomanda SERENA 85W, 60cm, 3 Cercuri, lumina Rece\/Calda\/Neutra, Dimabila, Alb, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-serena-85w-60cm-3-cercuri-lumina-rece-calda-neutra-dimabila-alb-inaltime-reglabila","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e“Este atât de ușor să controlezi atmosfera.”\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e \u003c\/div\u003e\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eUn moment-cheie în procesul decorării unei încăperi este cel în care alegi lustra potrivită. Dimensiunile, designul, materialele de fabricare, sursele de iluminare și destinația de amplasare sunt factorii principali de care ai nevoie să ții cont pentru alegerea lustrei perfecte.      \u003cbr\u003e \u003cbr\u003eCu lustrele LED, posibilitățile de iluminare decorativă devin nelimitate! Suntem conștienți de acest lucru, așa că alegem să comercializăm doar lustre LED de cea mai bună calitate și îți punem la dispoziție un portofoliu extins din care să alegi. \u003c\/span\u003e\u003c\/div\u003e\u003cp\u003e'\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2025-02-24T14:38:43+02:00","created_at":"2025-02-24T14:38:42+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Suspendate"],"variants":[{"id":52428503777547,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT803\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"339.99","position":1,"product_id":9757207953675,"created_at":"2025-09-30T14:06:31+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59030958965003,"created_at":"2025-08-12T11:47:56+03:00","position":1,"updated_at":"2025-08-12T11:48:07+03:00","product_id":9757207953675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_1.png?v=1754988487","width":1900,"height":1900},{"id":59030958997771,"created_at":"2025-08-12T11:47:56+03:00","position":2,"updated_at":"2025-08-12T11:48:07+03:00","product_id":9757207953675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/6c17b495-7c73-460f-a440-93c4b578b148_1.png?v=1754988487","width":1600,"height":1600},{"id":66220556615947,"created_at":"2026-02-22T18:54:32+02:00","position":3,"updated_at":"2026-02-22T18:54:43+02:00","product_id":9757207953675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT803_3WH.png?v=1771779283","width":800,"height":800},{"id":62528405012747,"created_at":"2025-11-20T16:18:42+02:00","position":4,"updated_at":"2026-02-22T18:54:43+02:00","product_id":9757207953675,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT803_3WH_EPREL_875b7c69-39b2-4ac3-bb38-fb66acabc4ac.png?v=1771779283","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9779347521803,"title":"Lustră LED FREJA cu Telecomandă, 51cm, 90W, 3000K\/4000K\/6000K, Dimabil, Alb, Cristale, 6 Cercuri","handle":"lustra-led-freja-cu-telecomanda-51cm-90w-dimabil-alb-cristale","body_html":"\u003cp data-end=\"400\" data-start=\"0\"\u003e\u003cstrong\u003eLustra LED Freja\u003c\/strong\u003e este o piesă decorativă de impact, ce îmbină eleganța detaliilor din cristal cu funcționalitatea iluminatului inteligent. Cu un design sofisticat și \u003cstrong\u003efinisaj alb\u003c\/strong\u003e, completat de accente strălucitoare, \u003cstrong\u003eFreja \u003c\/strong\u003eeste ideală pentru încăperi rafinate precum livinguri, dininguri sau dormitoare generoase.\u003c\/p\u003e\u003cp data-end=\"702\" data-start=\"402\"\u003eCu o putere de \u003cstrong\u003e90W \u003c\/strong\u003eși \u003cstrong\u003eLED integrat\u003c\/strong\u003e, oferă o lumină amplă și eficientă energetic. Telecomanda inclusă permite \u003cstrong\u003eajustarea intensității\u003c\/strong\u003e luminoase și a temperaturii de culoare (\u003cstrong\u003ecaldă \u003c\/strong\u003e3000K, \u003cstrong\u003eneutră \u003c\/strong\u003e4000K, \u003cstrong\u003erece \u003c\/strong\u003e6000K), adaptând perfect atmosfera în funcție de momentul zilei sau preferințele utilizatorului.\u003c\/p\u003e\u003cp data-end=\"988\" data-start=\"704\"\u003e\u003cstrong data-end=\"734\" data-start=\"704\"\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\u003cul\u003e\n\u003cli data-end=\"988\" data-start=\"704\"\u003e\n\u003cstrong\u003ePutere\u003c\/strong\u003e: 90W LED, lumină intensă și uniformă\u003c\/li\u003e\n\u003cli data-end=\"988\" data-start=\"704\"\u003e\n\u003cstrong\u003eTemperatură de culoare reglabilă\u003c\/strong\u003e: 3000K \/ 4000K \/ 6000K\u003c\/li\u003e\n\u003cli data-end=\"988\" data-start=\"704\"\u003e\n\u003cstrong\u003eIntensitate luminoasă\u003c\/strong\u003e dimabilă prin telecomandă\u003cbr\u003e\n\u003c\/li\u003e\n\u003cli data-end=\"988\" data-start=\"704\"\u003e\n\u003cstrong\u003eDiametru\u003c\/strong\u003e: 51 cm, potrivită pentru spații medii și mari\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1152\" data-start=\"990\"\u003eLustra Freja aduce lux discret, tehnologie avansată și atmosferă personalizabilă într-un singur corp de iluminat – o alegere ideală pentru interioare sofisticate.\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1152\" data-start=\"990\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1152\" data-start=\"990\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-is-only-node=\"\" data-is-last-node=\"\" data-end=\"1152\" data-start=\"990\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-07-21T10:51:44+03:00","created_at":"2025-03-06T18:45:05+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED"],"variants":[{"id":52424350957835,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT861\/6WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"229.99","position":1,"product_id":9779347521803,"created_at":"2025-09-29T14:56:55+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":57506694791435,"created_at":"2025-07-21T10:44:54+03:00","position":1,"updated_at":"2025-07-21T10:44:58+03:00","product_id":9779347521803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_10fb65f9-e293-4d8e-8f43-380874004646.png?v=1753083898","width":3000,"height":3000},{"id":57507244179723,"created_at":"2025-07-21T10:48:51+03:00","position":2,"updated_at":"2025-07-21T10:51:44+03:00","product_id":9779347521803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_5e3585d8-9adc-48cb-a879-3b49b49c12f8.png?v=1753084304","width":1500,"height":1500},{"id":57507238609163,"created_at":"2025-07-21T10:48:45+03:00","position":3,"updated_at":"2025-07-21T10:51:44+03:00","product_id":9779347521803,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a2_fb581d92-3b84-45c6-9bac-ff64aa5b4c86.png?v=1753084304","width":1500,"height":1500}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760741982475,"title":"Lustra MODERNIST Hexa 6, 6x E27, Negru, Design Modern","handle":"lustra-modernist-hexa-6-6x-e27-negru-design-modern","body_html":"\u003c!-- codex-banner:AT1CT-IM1P-HT2L-LC370\/6BK --\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_2000x900_LC370-6BK.jpg?v=1785515807\" alt=\"Lustra MODERNIST Hexa 6, 6x E27, Negru, Design Modern banner\" width=\"2000\" height=\"900\"\u003e\u003c\/p\u003e\u003c!-- \/codex-banner:AT1CT-IM1P-HT2L-LC370\/6BK --\u003e\u003cp data-sourcepos=\"3:1-3:282\"\u003eLustra MODERNIST Hexa 6 nu este doar un corp de iluminat, ci o piesa centrala dinamica, sculptata sa adauge o nota de modernitate industriala si un impact vizual puternic in dormitor sau living.\u003c\/p\u003e\u003cul data-sourcepos=\"5:1-9:0\"\u003e\n\u003cli data-sourcepos=\"5:1-5:279\"\u003e\n\u003cstrong\u003eDesign Industrial Reinventat, Estetica Captivanta:\u003c\/strong\u003e Cu o constructie din tije metalice, finisate in negru mat, ce se extind intr-o forma geometrica deschisa, aceasta lustra ofera o prezenta aerisita, dar plina de personalitate, un dialog subtil intre functional si artistic.\u003c\/li\u003e\n\u003cli data-sourcepos=\"6:1-6:235\"\u003e\n\u003cstrong\u003eAura Luminoasa Extinsa, Ambianta Generoasa:\u003c\/strong\u003e Echipata cu sase socluri E27, Lustra Hexa 6 inunda spatiul cu o lumina abundenta si uniforma, ideala pentru a crea o atmosfera calda si primitoare, invitand la relaxare sau socializare.\u003c\/li\u003e\n\u003cli data-sourcepos=\"7:1-7:227\"\u003e\n\u003cstrong\u003ePrezenta Impunatoare, Proportii Armonioase:\u003c\/strong\u003e Cu un diametru si o lungime de 72 cm, dar o inaltime discreta de doar 15 cm, se monteaza elegant pe tavan, oferind o acoperire luminoasa extinsa fara a incarca vizual incaperea.\u003c\/li\u003e\n\u003cli data-sourcepos=\"8:1-9:0\"\u003e\n\u003cstrong\u003ePunct Focal Versatil:\u003c\/strong\u003e Conceputa pentru interioare, se adapteaza fara efort unei game largi de stiluri, de la minimalist si scandinav la industrial-chic, aducand o nota de inovatie si stil distinct in orice context.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"10:1-10:199\"\u003eAceasta lustra nu doar lumineaza functional, ci si transforma fiecare incapere intr-un spatiu vibrant, modern si plin de caracter, un loc unde designul si lumina se intalnesc intr-o armonie perfecta.\u003c\/p\u003e\u003cp data-sourcepos=\"10:1-10:199\"\u003e\u003cstrong\u003e*Becurile nu sunt incluse!\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"10:1-10:199\"\u003e\u003cstrong\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner-candelabre-bec-e27.jpg?v=1747387419\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:15:58+02:00","created_at":"2025-02-25T03:15:57+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre Industrial","tags":["active","All Stock","Corpuri de Iluminat","Lustre cu bec","Lustre din fier","Lustre Minimaliste"],"variants":[{"id":52414455742731,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LC370\/6BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"99.99","grams":0,"compare_at_price":"129.99","position":1,"product_id":9760741982475,"created_at":"2025-09-26T10:40:06+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":69857888043275,"created_at":"2026-07-31T19:36:41+03:00","position":1,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/001_01_LC370-6BK.webp?v=1785515804","width":1000,"height":1000},{"id":69857888207115,"created_at":"2026-07-31T19:36:41+03:00","position":2,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/006_06_LC370-6BK.webp?v=1785515804","width":1000,"height":1000},{"id":69857888076043,"created_at":"2026-07-31T19:36:41+03:00","position":3,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/002_02_LC370-6BK.webp?v=1785515804","width":1000,"height":1000},{"id":69857888108811,"created_at":"2026-07-31T19:36:41+03:00","position":4,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/003_03_LC370-6BK.webp?v=1785515804","width":1000,"height":1000},{"id":69857888141579,"created_at":"2026-07-31T19:36:41+03:00","position":5,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/004_04_LC370-6BK.webp?v=1785515804","width":1000,"height":1000},{"id":69857888174347,"created_at":"2026-07-31T19:36:41+03:00","position":6,"updated_at":"2026-07-31T19:36:44+03:00","product_id":9760741982475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/005_05_LC370-6BK.webp?v=1785515804","width":1000,"height":1000}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760744833291,"title":"Lustra LED GALIOS 26W, 6 Elemente, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-galios-72w-6-elemente-lumina-rece-calda-neutra-negru","body_html":"\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify;\"\u003eLustra LED Galios Negru de la Alessandro Design este o alegere ideală pentru iluminatul spațiilor interioare moderne. Cu un design contemporan și finisaj elegant negru, această lustră adaugă un plus de stil oricărei încăperi, fie că este vorba despre living, dormitor sau birou.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cstrong\u003eCaracteristici principale:\u003c\/strong\u003e\u003c\/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cstrong\u003eIluminare Eficientă\u003c\/strong\u003e: Tehnologia LED integrată asigură o iluminare puternică și uniformă, ideală pentru diverse spații. LED-urile sunt durabile și eficiente, ajutându-vă să economisiți energie pe termen lung.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eDesign Modern\u003c\/strong\u003e: Finisajul negru și liniile curate oferă un aspect elegant, potrivit pentru interioare contemporane.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eMateriale de Calitate\u003c\/strong\u003e: Fabricată din metal de înaltă calitate, lustra este durabilă și oferă o estetică remarcabilă în timp.\u003c\/li\u003e\n\u003cli\u003e\n\u003cstrong\u003eMontare Ușoară\u003c\/strong\u003e: Lustra vine cu toate componentele necesare pentru o instalare rapidă și eficientă.\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\u003cdiv style=\"text-align: center;\" class=\"containerimg-mobile\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\n\u003cp style=\"text-align: justify;\"\u003eLustra LED Galios Negru nu doar că luminează spațiul, ci îmbunătățește designul interior prin stilul său modern și sofisticat. Este o alegere excelentă pentru cei care caută o combinație perfectă de funcționalitate și estetică.\u003c\/p\u003e\n\u003cp style=\"text-align: justify;\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e\n\u003c\/div\u003e","published_at":"2025-02-25T03:18:27+02:00","created_at":"2025-02-25T03:18:26+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED Scandinave"],"variants":[{"id":52424663302411,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL380","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"239.99","grams":0,"compare_at_price":"239.99","position":1,"product_id":9760744833291,"created_at":"2025-09-29T16:55:52+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":55181932626187,"created_at":"2025-05-05T11:02:28+03:00","position":1,"updated_at":"2025-05-05T11:02:46+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H6551b1174dd0432ca3f5e5cd00ce82f8R.jpg?v=1746432166","width":1600,"height":1600},{"id":51854093385995,"created_at":"2025-02-25T03:18:28+02:00","position":2,"updated_at":"2026-06-08T15:28:37+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-galios-negru-1729109761.webp?v=1780921717","width":1024,"height":1024},{"id":55181932790027,"created_at":"2025-05-05T11:02:28+03:00","position":3,"updated_at":"2025-05-05T11:02:32+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H900ac3073bc5432994186bee7cd8538eL.jpg?v=1746432152","width":1600,"height":1600},{"id":69361343365387,"created_at":"2026-06-08T15:25:25+03:00","position":4,"updated_at":"2026-06-08T15:27:38+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-galios-negru-1729109761_cdda397d-67fc-443a-a7a9-a272c491b5ea.webp?v=1780921658","width":1024,"height":1024},{"id":69361343463691,"created_at":"2026-06-08T15:25:27+03:00","position":5,"updated_at":"2026-06-08T15:26:43+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-galios-negru-1729109761_3978a451-7a47-4110-8edb-3868eaddba0a.webp?v=1780921603","width":1024,"height":1024},{"id":69361383506187,"created_at":"2026-06-08T15:33:42+03:00","position":6,"updated_at":"2026-06-08T15:33:46+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/ChatGPTImage8iun.2026_15_29_39.png?v=1780922026","width":1254,"height":1254},{"id":69361340743947,"created_at":"2026-06-08T15:24:31+03:00","position":7,"updated_at":"2026-06-08T15:24:33+03:00","product_id":9760744833291,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2701479_big_color.png?v=1780921473","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760707346699,"title":"Lustra LED suspendata cu telecomanda PAULINA 60W, lumina Rece\/Calda\/Neutra, Dimabila, Negru, Inaltime Reglabila","handle":"lustra-led-suspendata-cu-telecomanda-paulina-60w-lumina-rece-calda-neutra-dimabila-negru-inaltime-reglabila","body_html":"\u003cp data-sourcepos=\"1:1-1:208\"\u003eLustra LED suspendată cu telecomandă PAULINA este o opțiune de iluminat modernă și elegantă, cu un finisaj negru sofisticat. Cu o putere de 60W, oferă o iluminare versatilă și eficientă pentru diverse spații.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:366\"\u003eDeși descrierea nu menționează o formă specifică, faptul că este LED cu telecomandă și dimabilă sugerează un design contemporan, probabil cu linii curate. Telecomanda îți oferă control asupra temperaturii culorii (rece, caldă sau neutră) și asupra intensității luminii, permițându-ți să creezi atmosfera ideală. Înălțimea reglabilă adaugă flexibilitate în instalare.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:218\"\u003eCu o putere de 60W, această lustră ar fi potrivită pentru a ilumina livinguri, sufragerii sau alte încăperi de dimensiuni medii. Finisajul negru îi conferă un aer modern și ușor de integrat în diverse stiluri de decor.\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\"\u003e\u003c\/p\u003e","published_at":"2025-02-25T03:11:36+02:00","created_at":"2025-02-25T03:11:35+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Scandinave","Lustre LED Suspendate"],"variants":[{"id":52428631834891,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT203BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"299.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":9760707346699,"created_at":"2025-09-30T14:46:16+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51853486686475,"created_at":"2025-02-25T03:11:37+02:00","position":1,"updated_at":"2025-05-15T11:54:32+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT203BK-Lustra_LED_suspendata_cu_telecomanda_PAULINA_74W_lumina_Rece_Calda_Neutra_Dimabila_Negru_Inaltime_Reglabila-2.webp?v=1747299272","width":900,"height":900},{"id":51853484687627,"created_at":"2025-02-25T03:11:37+02:00","position":2,"updated_at":"2025-06-12T16:59:05+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-CH1A-HT2L-LT203BK-Lustra_LED_suspendata_cu_telecomanda_PAULINA_74W_lumina_Rece_Calda_Neutra_Dimabila_Negru_Inaltime_Reglabila-1.webp?v=1749736745","width":900,"height":900},{"id":56343794876683,"created_at":"2025-06-12T16:55:55+03:00","position":3,"updated_at":"2025-06-12T16:59:05+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LustraLEDsuspendatacutelecomandaPAULINA74W_luminaRece_Calda_Neutra_Dimabila_Negru_InaltimeReglabila_3.png?v=1749736745","width":1080,"height":1080},{"id":56343822401803,"created_at":"2025-06-12T16:58:33+03:00","position":4,"updated_at":"2025-06-12T16:59:05+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_suspendata_cu_telecomanda_PAULINA_74W_lumina_Rece_Calda_Neutra_Dimabila_Negru_Inaltime_Reglabila_2.png?v=1749736745","width":1080,"height":1080},{"id":56343822369035,"created_at":"2025-06-12T16:58:33+03:00","position":5,"updated_at":"2025-06-12T16:59:05+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_suspendata_cu_telecomanda_PAULINA_74W_lumina_Rece_Calda_Neutra_Dimabila_Negru_Inaltime_Reglabila.png?v=1749736745","width":1080,"height":1080},{"id":66175418597643,"created_at":"2026-02-22T00:22:12+02:00","position":6,"updated_at":"2026-02-22T00:22:14+02:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/AT1CT-IM1P-HT2L-LT203BK_1.webp?v=1771712534","width":900,"height":900},{"id":68425991356683,"created_at":"2026-04-22T14:24:36+03:00","position":7,"updated_at":"2026-04-22T14:24:38+03:00","product_id":9760707346699,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2698806_big_color.svg?v=1776857078","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757940318475,"title":"Lustra LED cu telecomanda BALANS 44W, 2 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomanda-balans-44w-2-patrate-lumina-rece-calda-neutra-dimabila-negru","body_html":"\u003ch2 style=\"text-align: center; font-size: 16px;\"\u003eDescriere Lustra LED Balans 44W, Negru, Dimabilă\u003c\/h2\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto;\"\u003e\u003ca href=\"https:\/\/www.youtube.com\/watch?v=3xTShJEApuM\" class=\"video-link\" rel=\"noopener noreferrer\" target=\"_blank\"\u003e\u003cimg src=\"https:\/\/img.youtube.com\/vi\/3xTShJEApuM\/maxresdefault.jpg\" alt=\"YouTube video thumbnail\" style=\"border-radius: 12px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\"\u003e \u003ch3\u003e\u003cspan style=\"color: rgb(0, 0, 0);\"\u003eLustra LED cu telecomandă BALANS este o piesă de iluminat modernă și echilibrată, cu un design format din două pătrate stilizate, finisate în negru. Cu o putere de 44W, oferă o iluminare versatilă pentru diverse spații.\u003c\/span\u003e\u003c\/h3\u003e\n\u003ch3\u003e\u003cspan style=\"color: rgb(0, 0, 0);\"\u003eCele două pătrate negre, dispuse probabil într-o manieră care sugerează un echilibru vizual (fie alăturate, suprapuse parțial, sau poate unul deasupra celuilalt), sunt iluminate de LED-uri cu posibilitatea de a selecta temperatura culorii. Prin intermediul telecomenzii, poți alege între lumină rece (pentru un ambient energizant), caldă (pentru o atmosferă primitoare și relaxantă) sau neutră (pentru iluminare generală). Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a se potrivi perfect oricărui moment.\u003c\/span\u003e\u003c\/h3\u003e\n\u003ch3\u003e\u003cspan style=\"color: rgb(0, 0, 0);\"\u003eFinisajul negru al lustrei accentuează liniile moderne ale designului pătrat și adaugă o notă de eleganță și sobrietate încăperii. Cu o putere de 44W, este ideală pentru a ilumina livinguri mai mici, dormitoare, holuri sau birouri.\u003c\/span\u003e\u003c\/h3\u003e\n\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003c\/a\u003e\u003c\/div\u003e","published_at":"2025-02-24T19:43:21+02:00","created_at":"2025-02-24T19:43:20+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","outlet"],"variants":[{"id":52415700926731,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT804\/2BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"49.99","grams":0,"compare_at_price":"119.99","position":1,"product_id":9757940318475,"created_at":"2025-09-26T17:40:45+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51819285774603,"created_at":"2025-02-24T19:43:24+02:00","position":1,"updated_at":"2025-02-24T19:43:26+02:00","product_id":9757940318475,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-balans-telecomanda-48w-24ghz-acril-3000k-4000k-6000k-dimabila-negru_LL290_010.webp?v=1740419006","width":900,"height":900},{"id":51819285938443,"created_at":"2025-02-24T19:43:24+02:00","position":2,"updated_at":"20