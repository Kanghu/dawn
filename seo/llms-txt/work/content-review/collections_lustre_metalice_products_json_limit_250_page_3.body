GHTLIGHT_a1f3a53b-6e89-47f7-8af7-18924e44fc5b.png?v=1778557698","width":1000,"height":1000},{"id":68843248779531,"created_at":"2026-05-12T06:48:14+03:00","position":7,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/7.SIZE_4e4f3f9e-5048-4ac3-9230-a17459d1e90d.png?v=1778557698","width":1000,"height":1000},{"id":68843248812299,"created_at":"2026-05-12T06:48:14+03:00","position":8,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/8.SPECIFICATION_d575c8b6-86b7-4b0d-b1ff-9f40bb5c7d5c.png?v=1778557698","width":1000,"height":1000},{"id":68843248845067,"created_at":"2026-05-12T06:48:14+03:00","position":9,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/9.CLOSE-UP2_4da6f768-5308-4f84-82ef-e348709851a3.png?v=1778557698","width":1000,"height":1000},{"id":68843248877835,"created_at":"2026-05-12T06:48:14+03:00","position":10,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/10.CLOSE-UP3.png?v=1778557698","width":1000,"height":1000},{"id":68843248910603,"created_at":"2026-05-12T06:48:14+03:00","position":11,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/12.PLACE1_06a173ed-4432-4951-8b50-ea8061ba87fb.png?v=1778557698","width":1000,"height":1000},{"id":68843248943371,"created_at":"2026-05-12T06:48:14+03:00","position":12,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/13.PLACE2_3956899e-5a11-45a5-8286-8456b7fd1e40.png?v=1778557698","width":1000,"height":1000},{"id":68843248976139,"created_at":"2026-05-12T06:48:14+03:00","position":13,"updated_at":"2026-05-12T06:48:18+03:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/14.PLACE3_87a4d628-a5e0-466c-be9c-af29ebb1db74.png?v=1778557698","width":1000,"height":1000},{"id":62528969441547,"created_at":"2025-11-20T17:41:43+02:00","position":14,"updated_at":"2026-02-12T16:46:20+02:00","product_id":9760616677643,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT510_2BK_EPREL..png?v=1770907580","width":425,"height":850}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757717332235,"title":"Lustra LED cu cristal SERILDA 40W, Diametru 20cm, lumina Rece\/Calda\/Neutra , Alb","handle":"lustra-led-cu-cristal-serilda-40w-diametru-20cm-lumina-rece-calda-neutra-alb","body_html":"\u003ch2 style=\"text-align: center; font-size: 16px;\"\u003eDescriere Lustra LED Serilda, 40W, Alb Mat, Cristale\u003c\/h2\u003e\u003cdiv class=\"containerimg-mobile\" style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv style=\"position: relative; overflow: hidden; width: 100%; max-width: 640px; margin: auto; padding-top: min(360px, 56.25%);\"\u003e\u003ciframe src=\"https:\/\/www.youtube.com\/embed\/nAaK9-v14HU\" style=\"position: absolute; top: 0; left: 0; bottom: 0; right: 0; width: 100%; height: 100%;\"\u003e\u003c\/iframe\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eÎmbunătățiți orice spațiu cu **Lustra LED Serilda**, o combinație perfectă de eleganță și funcționalitate. Această lustră rafinată, cu un design rotund și detalii fine negre, este încrustată cu cristale transparente, adăugând un strop de strălucire și sofisticare. Cu o putere de 40W și un flux luminos de 3200lm, Serilda oferă o iluminare eficientă și un impact vizual deosebit, fiind ideală pentru livinguri, săli de mese sau orice spațiu care necesită un punct central elegant.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eUnul dintre cele mai mari avantaje ale Lustrei LED Serilda este varietatea de tipuri de lumină pe care le oferă: caldă, rece și neutră. Această versatilitate permite adaptarea ușoară a iluminatului la diferite nevoi și momente ale zilei.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eDesignul său rotund, accentuat de cristalele transparente și detaliile fine negre, adaugă un plus de caracter și rafinament, transformând lustra într-o operă de artă în iluminat. Fie că este folosită ca element central sau ca parte a unui decor mai amplu, Serilda se distinge prin stilul său contemporan și opulent.\u003c\/p\u003e\u003c\/div\u003e\u003cdiv class=\"containerimg-mobile\" style=\"text-align: center;\"\u003e\u003cbr\u003e\u003c\/div\u003e\u003cdiv class=\"paragrafe-text\"\u003e\u003cp style=\"text-align: justify; font-size: 16px;\"\u003eOptați pentru Lustra LED Serilda pentru a beneficia de un iluminat de înaltă calitate, care combină eficiența energetică cu un design inovator și o versatilitate remarcabilă. Este mai mult decât o sursă de lumină; este o declarație de stil care va îmbogăți și va lumina orice interior cu un aer de eleganță și rafinament.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Ideala_pentru_Holuri.jpg?v=1741710546\" alt=\"\"\u003e\u003c\/p\u003e\u003c\/div\u003e","published_at":"2026-06-30T11:18:19+03:00","created_at":"2025-02-24T17:53:44+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52428078514443,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL401","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"59.99","grams":0,"compare_at_price":"69.99","position":1,"product_id":9757717332235,"created_at":"2025-09-30T12:18:05+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51817392996619,"created_at":"2025-02-24T17:53:47+02:00","position":1,"updated_at":"2025-02-24T17:53:49+02:00","product_id":9757717332235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-serilda-40w-alb_LL389AL_01.webp?v=1740412429","width":900,"height":900},{"id":51817392963851,"created_at":"2025-02-24T17:53:47+02:00","position":2,"updated_at":"2025-02-24T17:53:49+02:00","product_id":9757717332235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-serilda-40w-alb_LL389AL_02.webp?v=1740412429","width":900,"height":900},{"id":51817393029387,"created_at":"2025-02-24T17:53:47+02:00","position":3,"updated_at":"2025-02-24T17:53:50+02:00","product_id":9757717332235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-serilda-40w-alb_LL389AL_03.webp?v=1740412430","width":900,"height":900},{"id":51817392865547,"created_at":"2025-02-24T17:53:47+02:00","position":4,"updated_at":"2025-02-24T17:53:49+02:00","product_id":9757717332235,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-serilda-40w-alb_LL389AL_04.webp?v=1740412429","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9758377017611,"title":"Lustra LED cu telecomanda FARYDA 120W, 3 Patrate, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-faryda-120w-3-patrate-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-sourcepos=\"1:1-1:229\"\u003eLustra LED cu telecomandă FARYDA este o piesă de iluminat modernă și eficientă, cu o putere de 120W și un design format din trei pătrate albe. Telecomanda inclusă oferă control asupra temperaturii culorii și intensității luminii.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:378\"\u003eCele trei pătrate albe, probabil de dimensiuni diferite sau dispuse într-un mod artistic, sunt iluminate de LED-uri cu posibilitatea de a alege între lumină rece, caldă sau neutră. Funcția de dimare îți permite să ajustezi intensitatea luminii pentru a crea atmosfera dorită. Finisajul alb îi conferă un aspect curat și versatil, ușor de integrat în diverse stiluri de interior.\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:111\"\u003eCu o putere de 120W, este potrivită pentru a ilumina livinguri, dormitoare sau alte spații de dimensiuni medii.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2026-07-13T18:37:38+03:00","created_at":"2025-02-24T21:28:40+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED Aplicate","tags":["Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda","outlet"],"variants":[{"id":52109731987723,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-VV1A-HT2L-6042\/3WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"119.97","grams":0,"compare_at_price":"299.99","position":1,"product_id":9758377017611,"created_at":"2025-08-22T22:08:33+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51821174554891,"created_at":"2025-02-24T21:28:45+02:00","position":1,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-cu-telecomanda-120w-acril-si-metal-alb-1687951199.webp?v=1740425327","width":900,"height":900},{"id":51821174423819,"created_at":"2025-02-24T21:28:45+02:00","position":2,"updated_at":"2025-02-24T21:28:46+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_02.webp?v=1740425326","width":900,"height":900},{"id":51821174653195,"created_at":"2025-02-24T21:28:45+02:00","position":3,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_03.webp?v=1740425327","width":900,"height":900},{"id":51821174587659,"created_at":"2025-02-24T21:28:45+02:00","position":4,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_04.webp?v=1740425327","width":900,"height":900},{"id":51821174620427,"created_at":"2025-02-24T21:28:45+02:00","position":5,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_05.webp?v=1740425327","width":900,"height":900},{"id":51821174685963,"created_at":"2025-02-24T21:28:45+02:00","position":6,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_06.webp?v=1740425327","width":900,"height":900},{"id":51821174456587,"created_at":"2025-02-24T21:28:45+02:00","position":7,"updated_at":"2025-02-24T21:28:47+02:00","product_id":9758377017611,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-ceyda-telecomanda-120w-acril-metal-alb_LL1689_01-_1_-1687951120.webp?v=1740425327","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9760512442635,"title":"Lustra LED cu Telecomanda ZYRON Magno, 80W, 4 elemente, Lumina Rece\/Calda\/Neutra, Dimabila, Negru, Metal, Plexiglas","handle":"lustra-led-cu-telecomanda-lt755-4bk-80w-46x5-5x7-5-lumina-rece-calda-neutra-dimabila-negru-fier-plexiglas","body_html":"\u003cp data-sourcepos=\"3:1-3:81\"\u003e\u003cstrong\u003eEleganță Liniară și Control Total al Luminii: Lustra LED cu Telecomandă\u003c\/strong\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"5:1-5:226\"\u003eIluminează-ți spațiul cu un design modern și o funcționalitate avansată oferită de lustra LED liniară. Corpul său elegant și minimalist, de culoare \u003cstrong\u003eneagră\u003c\/strong\u003e, aduce un plus de lumină și stil contemporan oricărei încăperi.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:249\"\u003eCu o putere generoasă de \u003cstrong\u003e80W\u003c\/strong\u003e, lustra oferă o iluminare amplă și uniformă, ideală pentru livinguri, dininguri sau birouri moderne. Bucură-te de versatilitatea \u003cstrong\u003etrei tipuri de lumină\u003c\/strong\u003e integrate, adaptabile oricărei atmosfere și activități:\u003c\/p\u003e\u003cul data-sourcepos=\"9:1-12:0\"\u003e\n\u003cli data-sourcepos=\"9:1-9:112\"\u003e\n\u003cstrong\u003eRece (alb):\u003c\/strong\u003e Perfectă pentru activități care necesită concentrare și energie, cum ar fi lucrul sau cititul.\u003c\/li\u003e\n\u003cli data-sourcepos=\"10:1-10:115\"\u003e\n\u003cstrong\u003eCaldă (galben):\u003c\/strong\u003e Creează un ambient primitor și relaxant, ideal pentru serile liniștite sau mesele în familie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"11:1-12:0\"\u003e\n\u003cstrong\u003eNeutră:\u003c\/strong\u003e O lumină echilibrată, potrivită pentru iluminatul general de zi cu zi.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"13:1-13:204\"\u003eGrație funcției \u003cstrong\u003edimabile\u003c\/strong\u003e, ai control total asupra intensității luminoase. Ajustează lumina de la o strălucire puternică la o lumină ambientală subtilă, creând atmosfera perfectă pentru fiecare moment.\u003c\/p\u003e\u003cp data-sourcepos=\"15:1-15:168\"\u003e\u003cstrong\u003eTelecomanda inclusă\u003c\/strong\u003e adaugă un nivel superior de confort. Schimbă temperatura culorii, reglează intensitatea luminii și pornește sau oprește lustra fără a te ridica.\u003c\/p\u003e\u003cp data-sourcepos=\"17:1-17:25\"\u003e\u003cstrong\u003eCaracteristici Cheie:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"19:1-25:0\"\u003e\n\u003cli data-sourcepos=\"19:1-19:71\"\u003e\n\u003cstrong\u003eDesign Liniar Modern:\u003c\/strong\u003e Corp elegant și minimalist de culoare neagră.\u003c\/li\u003e\n\u003cli data-sourcepos=\"20:1-20:67\"\u003e\n\u003cstrong\u003ePutere Generoasă:\u003c\/strong\u003e 80W, oferind o iluminare amplă și uniformă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"21:1-21:80\"\u003e\n\u003cstrong\u003eTrei Tipuri de Lumină:\u003c\/strong\u003e Rece, Caldă și Neutră, pentru versatilitate maximă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"22:1-22:83\"\u003e\n\u003cstrong\u003eFuncție Dimmabilă:\u003c\/strong\u003e Ajustează intensitatea luminoasă în funcție de preferințe.\u003c\/li\u003e\n\u003cli data-sourcepos=\"23:1-23:65\"\u003e\n\u003cstrong\u003eTelecomandă Inclusă:\u003c\/strong\u003e Control facil și comod de la distanță.\u003c\/li\u003e\n\u003cli data-sourcepos=\"24:1-25:0\"\u003e\n\u003cstrong\u003eStil Versatil:\u003c\/strong\u003e Se integrează perfect în interioare moderne, minimaliste sau scandinave.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"26:1-26:14\"\u003e\u003cstrong\u003eBeneficii:\u003c\/strong\u003e\u003c\/p\u003e\u003cul data-sourcepos=\"28:1-33:0\"\u003e\n\u003cli data-sourcepos=\"28:1-28:104\"\u003e\n\u003cstrong\u003eIluminare Adaptabilă:\u003c\/strong\u003e Alege temperatura de culoare și intensitatea perfectă pentru fiecare ocazie.\u003c\/li\u003e\n\u003cli data-sourcepos=\"29:1-29:73\"\u003e\n\u003cstrong\u003eControl Total:\u003c\/strong\u003e Ajustează lumina confortabil cu telecomanda inclusă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"30:1-30:81\"\u003e\n\u003cstrong\u003eEficiență Energetică LED:\u003c\/strong\u003e Consum redus de energie și durată de viață lungă.\u003c\/li\u003e\n\u003cli data-sourcepos=\"31:1-31:92\"\u003e\n\u003cstrong\u003eDesign Elegant și Discret:\u003c\/strong\u003e Un element de iluminat modern care completează orice decor.\u003c\/li\u003e\n\u003cli data-sourcepos=\"32:1-33:0\"\u003e\n\u003cstrong\u003eIluminare Uniformă:\u003c\/strong\u003e Ideal pentru a lumina eficient spații mari.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"34:1-34:214\"\u003eLustra LED cu telecomandă liniară este alegerea ideală pentru a adăuga un plus de stil, confort și control inteligent în iluminatul casei tale. Bucură-te de flexibilitatea luminii perfecte la un singur click!\u003c\/p\u003e\u003cp data-sourcepos=\"34:1-34:214\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\"\u003e\u003c\/p\u003e","published_at":"2026-02-22T20:59:54+02:00","created_at":"2025-02-25T02:40:48+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52418443247883,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT755\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.79","grams":0,"compare_at_price":"219.99","position":1,"product_id":9760512442635,"created_at":"2025-09-27T14:57:36+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":65971048546571,"created_at":"2026-02-18T12:09:29+02:00","position":1,"updated_at":"2026-03-23T14:04:14+02:00","product_id":9760512442635,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT755_4BKpic2.png?v=1774267454","width":1500,"height":1500},{"id":65971048513803,"created_at":"2026-02-18T12:09:29+02:00","position":2,"updated_at":"2026-02-20T10:47:37+02:00","product_id":9760512442635,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LT755_4BKpic1.png?v=1771577257","width":3680,"height":2456},{"id":68426153885963,"created_at":"2026-04-22T14:54:52+03:00","position":3,"updated_at":"2026-04-22T14:54:55+03:00","product_id":9760512442635,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Label_2699114_big_color.svg?v=1776858895","width":136,"height":272}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10132126892299,"title":"Lustra LED cu telecomanda NOLUX 34W, Rotunda, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-nolux-34w-rotunda-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cp data-start=\"244\" data-end=\"470\" class=\"\"\u003eCu un design aerisit și accente moderne, \u003cstrong data-start=\"285\" data-end=\"294\"\u003eNOLUX\u003c\/strong\u003e aduce simplitatea sofisticată în centrul oricărei încăperi. Finisajul alb mat și liniile curate creează o prezență discretă, dar elegantă, perfectă pentru spații contemporane.\u003c\/p\u003e\u003cp data-start=\"472\" data-end=\"756\" class=\"\"\u003ePuterea de 34W asigură iluminare puternică și eficientă, iar controlul temperaturii de culoare (rece, caldă sau neutră) și al intensității se face simplu, prin telecomandă. Ideală pentru living, dining sau birouri moderne, \u003cstrong data-start=\"696\" data-end=\"705\"\u003eNOLUX\u003c\/strong\u003e oferă confort vizual și atmosferă personalizabilă.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-04-29T15:26:47+03:00","created_at":"2025-04-14T13:32:08+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52428101255435,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT630\/500R","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"179.99","position":1,"product_id":10132126892299,"created_at":"2025-09-30T12:27:23+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":59128821514507,"created_at":"2025-08-14T17:54:36+03:00","position":1,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_1_e715133a-7c1b-492a-81c5-b11b265c8459.jpg?v=1755183284","width":800,"height":800},{"id":59084434374923,"created_at":"2025-08-13T17:01:12+03:00","position":2,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117654.jpg?v=1755183284","width":1300,"height":1300},{"id":59084434407691,"created_at":"2025-08-13T17:01:12+03:00","position":3,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117653.jpg?v=1755183284","width":1300,"height":1300},{"id":59084434473227,"created_at":"2025-08-13T17:01:12+03:00","position":4,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117652.jpg?v=1755183284","width":1300,"height":1300},{"id":59084434505995,"created_at":"2025-08-13T17:01:12+03:00","position":5,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117650.jpg?v=1755183284","width":1300,"height":1300},{"id":59084434440459,"created_at":"2025-08-13T17:01:12+03:00","position":6,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117651.jpg?v=1755183284","width":1300,"height":1300},{"id":59084434342155,"created_at":"2025-08-13T17:01:12+03:00","position":7,"updated_at":"2025-08-14T17:54:44+03:00","product_id":10132126892299,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/l117655.jpg?v=1755183284","width":1300,"height":1300}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10152395800843,"title":"Lustra LED ELIO 47W, 4 Cercuri, Liniara, lumina Rece\/Calda\/Neutra, Negru","handle":"lustra-led-elio-47w-4-cercuri-liniara-lumina-rece-calda-neutra-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:194\"\u003eLustra LED ELIO este o piesă de iluminat modernă și eficientă, cu o putere de 47W și un design format din patru cercuri negre. Oferă posibilitatea de a alege între lumină rece, caldă sau neutră.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:333\"\u003eCele patru cercuri negre, probabil de dimensiuni diferite sau aranjate într-un mod estetic, sunt iluminate de LED-uri. Cu o putere de 47W, este potrivită pentru a ilumina spații mai mici sau medii, cum ar fi dormitoare, birouri sau holuri. Finisajul negru îi conferă un aspect elegant și ușor de integrat în diverse decoruri moderne.\u003c\/p\u003e\u003cp data-sourcepos=\"3:1-3:59\"\u003e\u003cimg style=\"font-size: 0.875rem;\" alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\"\u003e\u003cimg style=\"font-size: 0.875rem;\" alt=\"\" src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\"\u003e\u003cbr\u003e\u003c\/p\u003e","published_at":"2025-04-29T17:35:26+03:00","created_at":"2025-04-27T09:30:49+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED","tags":["active","All Stock","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate"],"variants":[{"id":52422685819147,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LL771\/4BK","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"199.99","grams":0,"compare_at_price":"199.99","position":1,"product_id":10152395800843,"created_at":"2025-09-28T21:44:43+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":58584730861835,"created_at":"2025-08-04T13:30:27+03:00","position":1,"updated_at":"2025-08-04T13:32:14+03:00","product_id":10152395800843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/a1_16f184b2-eefe-4906-9d6f-2ddcf935fc62.jpg?v=1754303534","width":800,"height":800},{"id":58584730763531,"created_at":"2025-08-04T13:30:27+03:00","position":2,"updated_at":"2025-08-04T13:32:14+03:00","product_id":10152395800843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/H418b15a1be2d4c1386fcbd3f3305aef2u.jpg?v=1754303534","width":800,"height":800},{"id":55016492564747,"created_at":"2025-04-27T09:38:22+03:00","position":3,"updated_at":"2025-08-04T13:32:14+03:00","product_id":10152395800843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-AT1CT-IM1P-HT2L-LL771_4BK-LustraLEDELIOAmedea_24W_4Cercuri_LuminaRece_Calda_Neutra_DimabilaNegru-2.png?v=1754303534","width":770,"height":770},{"id":63232153813259,"created_at":"2025-12-10T12:51:36+02:00","position":4,"updated_at":"2025-12-10T12:51:39+02:00","product_id":10152395800843,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LL771_4BK_EPREL.png?v=1765363899","width":2048,"height":2048}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9759762514187,"title":"Lustra LED cu telecomanda MORA 160W, 8 Elemente, Liniara, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-mora-160w-8-elemente-liniara-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eDescoperiți Lustra LED Samara, o combinație impresionantă de design geometric avangardist și tehnologie de iluminat avansată. Această lustră contemporană, cu o putere de 160W și un flux luminos de 12800lm, este perfectă pentru a adăuga un element de stil și lumină în spații ample, cum ar fi livinguri, săli de conferință sau holuri mari. \u003cbr\u003e\u003cbr\u003eDesignul inovator al lustrei Samara constă într-o construcție din opt linii, dispuse în două seturi de câte patru, așezate asimetric una peste alta. Această structură unică nu doar că creează un punct focal vizual impresionant, dar și dispersează lumina într-un mod egal și interesant, creând un joc captivant de lumini și umbre în încăpere.\u003cbr\u003e\u003cbr\u003eLustra Samara oferă trei tipuri de lumină - caldă (3000K), neutră (4000K) și rece (6000K), care pot fi ajustate pentru a se potrivi oricărei atmosfere sau activități. Fie că doriți o lumină caldă și relaxantă pentru serile petrecute acasă sau o lumină neutră\/rece pentru activități ce necesită concentrare, această lustră se adaptează perfect nevoilor dumneavoastră. Funcția de dimare, controlabilă prin telecomandă, adaugă un nivel suplimentar de confort și adaptabilitate. Aceasta vă permite să reglați intensitatea luminii în funcție de nevoile și preferințele dumneavoastră, creând astfel ambianța ideală pentru orice moment al zilei. \u003cbr\u003e\u003cbr\u003eDesignul său geometric și finisarea albă fac din Samara o piesă centrală modernă și atrăgătoare. Fie că este integrată într-un interior minimalist sau unul mai eclectic, lustra se potrivește perfect, aducând un echilibru între eleganță și funcționalitate.\u003cbr\u003e\u003cbr\u003eAlegeți Lustra LED Samara pentru a adăuga un element de design contemporan și eficiență în iluminat în casa sau biroul dumneavoastră. Este mai mult decât o sursă de lumină; este o declarație de stil care va îmbogăți și va lumina orice interior cu un aer sofisticat și modern.\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/span\u003e\u003c\/div\u003e","published_at":"2025-02-25T00:34:17+02:00","created_at":"2025-02-25T00:34:16+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","Corpuri de Iluminat","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52409372803339,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-CH1A-HT2L-174\/8WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"432.00","grams":0,"compare_at_price":"329.98","position":1,"product_id":9759762514187,"created_at":"2025-09-24T18:03:49+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51836991471883,"created_at":"2025-02-25T00:34:19+02:00","position":1,"updated_at":"2025-02-25T00:34:21+02:00","product_id":9759762514187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-samara-160w-dimabila-alb_LL1920AL_01.webp?v=1740436461","width":900,"height":900},{"id":51836991308043,"created_at":"2025-02-25T00:34:19+02:00","position":2,"updated_at":"2025-02-25T00:34:20+02:00","product_id":9759762514187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-samara-160w-dimabila-alb_LL1920AL_02.webp?v=1740436460","width":900,"height":900},{"id":51836991799563,"created_at":"2025-02-25T00:34:19+02:00","position":3,"updated_at":"2025-02-25T00:34:21+02:00","product_id":9759762514187,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-samara-160w-dimabila-alb_LL1920AL_03.webp?v=1740436461","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10721709621515,"title":"Lustra LED cu telecomanda si cristal VERTUS 31W, 50cm, Cerc, lumina Rece\/Calda\/Neutra, Dimabila, Crom","handle":"lustra-led-cu-telecomanda-si-cristal-vertus-31w-50cm-cerc-lumina-rece-calda-neutra-dimabila-crom","body_html":"\u003cp\u003e\u003cstrong\u003eVERTUS 31W\u003c\/strong\u003e este o lustra LED compactă, cu design circular și finisaj crom elegant, accentuat de inserții din cristal ce oferă un efect vizual sofisticat. Puterea de 31W asigură un flux luminos mai intens comparativ cu varianta de 18W, fiind potrivită pentru spații care necesită iluminare mai puternică.\u003c\/p\u003e\u003ch3\u003eSpecificații tehnice\u003c\/h3\u003e\u003cul\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eModel:\u003c\/strong\u003e VERTUS\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003ePutere:\u003c\/strong\u003e 31W (LED integrat)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFormă:\u003c\/strong\u003e Cerc\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eTip lumină:\u003c\/strong\u003e Rece \/ Caldă \/ Neutră (selectabilă)\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eFuncție dimare:\u003c\/strong\u003e Da – reglare intensitate\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eControl:\u003c\/strong\u003e Telecomandă inclusă\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMaterial:\u003c\/strong\u003e Metal + Cristal + dispersor acrilic\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eCuloare:\u003c\/strong\u003e Crom\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eDimensiuni:\u003c\/strong\u003e 30 x 12.5 cm\u003c\/p\u003e\u003c\/li\u003e\n\u003cli\u003e\u003cp\u003e\u003cstrong\u003eMontaj:\u003c\/strong\u003e Tavan (aplicat)\u003c\/p\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\u003ch3\u003eFuncționalități și avantaje\u003c\/h3\u003e\u003cp\u003e✔ Selectarea temperaturii de culoare în funcție de ambient\u003cbr\u003e✔ Intensitate reglabilă pentru confort vizual personalizat\u003cbr\u003e✔ Cristale decorative cu efect elegant de reflexie\u003cbr\u003e✔ Dimensiune compactă, ideală pentru spații medii sau mici\u003cbr\u003e✔ Consum redus și eficiență energetică ridicată\u003c\/p\u003e\u003cp\u003ePrin combinația dintre finisajul crom modern, cristalele decorative și controlul complet al iluminării, \u003cstrong\u003eVERTUS 31W\u003c\/strong\u003e oferă un echilibru între estetică și performanță, fiind ideală pentru un iluminat ambiental elegant și eficient.\u003c\/p\u003e\u003cp\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led.webp?v=1734528553\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-10-21T21:33:35+03:00","created_at":"2025-09-12T15:54:39+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","BF2025","Corpuri de Iluminat","Lustre LED","Lustre LED \u0026 Cristale","Lustre LED cu Telecomanda","Lustre LED Suspendate"],"variants":[{"id":52412037693707,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LLC150\/500CH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"339.99","grams":0,"compare_at_price":"419.99","position":1,"product_id":10721709621515,"created_at":"2025-09-25T15:52:38+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":60237441794315,"created_at":"2025-09-12T15:51:14+03:00","position":1,"updated_at":"2025-09-12T16:24:06+03:00","product_id":10721709621515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPSPhotos_1_85b29cf8-9569-4dfe-a808-1b1f670407d3.png?v=1757683446","width":750,"height":750},{"id":60237448184075,"created_at":"2025-09-12T15:52:14+03:00","position":2,"updated_at":"2026-08-05T17:21:27+03:00","product_id":10721709621515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_VERTUS_18W_29cm_Cerc_lumina_Rece_Calda_Neutra_Dimabila_Crom_2.jpg?v=1785939687","width":1024,"height":1024},{"id":60237448216843,"created_at":"2025-09-12T15:52:14+03:00","position":3,"updated_at":"2026-08-05T17:21:37+03:00","product_id":10721709621515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/Lustra_LED_cu_telecomanda_si_cristal_VERTUS_18W_29cm_Cerc_lumina_Rece_Calda_Neutra_Dimabila_Crom_3.jpg?v=1785939697","width":790,"height":790},{"id":60237467091211,"created_at":"2025-09-12T15:55:15+03:00","position":4,"updated_at":"2025-09-12T15:55:19+03:00","product_id":10721709621515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/WPS_Photos_2_ca3fb1e6-b4ed-4d29-a9c0-b7f6f5e00c4c.png?v=1757681719","width":704,"height":647},{"id":62527700467979,"created_at":"2025-11-20T15:19:28+02:00","position":5,"updated_at":"2025-11-20T15:19:31+02:00","product_id":10721709621515,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/LLC150_500CH_EPREL_63cdee7c-6553-42d6-a154-e264d14618c5.png?v=1763644771","width":2560,"height":2560}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9757483204875,"title":"Lustra LED cu telecomanda SUNFLOWER 98W, 9 Elemente, lumina Rece\/Calda\/Neutra, Dimabila, Alb","handle":"lustra-led-cu-telecomanda-sunflower-98w-9-elemente-lumina-rece-calda-neutra-dimabila-alb","body_html":"\u003cdiv style=\"text-align: justify;\"\u003e\n\u003cspan style=\"font-size: 16px;\"\u003e\u003cstrong\u003e\u003cmeta charset=\"UTF-8\"\u003e\n\u003cspan\u003eLustra LED cu telecomandă SUNFLOWER, de 98W, aduce un strop de lumină și design floral în casa ta prin cele nouă elemente stilizate care amintesc de petalele unei flori, totul într-un finisaj alb imaculat. Această lustră nu este doar o sursă de lumină, ci și un element decorativ central, oferind o iluminare versatilă prin posibilitatea de a alege între lumină rece, caldă sau neutră, adaptându-se astfel oricărei atmosfere sau activități. Funcția de dimare, controlată cu ușurință prin telecomanda inclusă, îți permite să ajustezi intensitatea luminii pentru a crea exact ambianța dorită. Designul său floral stilizat și culoarea albă luminoasă o fac ideală pentru livinguri, dormitoare sau alte spații în care se dorește un iluminat plăcut și un element de design optimist și modern. Cu o putere de 98W, asigură o iluminare eficientă și generoasă a încăperii.\u003c\/span\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_20m2_generic.png?v=1745323363\" alt=\"\"\u003e\u003c\/strong\u003e\u003c\/span\u003e\u003cbr\u003e\n\u003c\/div\u003e","published_at":"2025-02-24T16:28:40+02:00","created_at":"2025-02-24T16:28:40+02:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","All Stock","CH_ONLINE-MASS","Corpuri de Iluminat","IULIE25","Lustre LED","Lustre LED Aplicate","Lustre LED cu Telecomanda"],"variants":[{"id":52360105296139,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT669\/9WH","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"219.99","position":1,"product_id":9757483204875,"created_at":"2025-09-12T14:11:01+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":51815961035019,"created_at":"2025-02-24T16:28:43+02:00","position":1,"updated_at":"2025-02-24T16:28:46+02:00","product_id":9757483204875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-amata-198w-24-ghz-alb-dimabila-acril_LL262_01.webp?v=1740407326","width":900,"height":900},{"id":51815961002251,"created_at":"2025-02-24T16:28:43+02:00","position":2,"updated_at":"2025-02-24T16:28:45+02:00","product_id":9757483204875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-amata-198w-24-ghz-alb-dimabila-acril_LL262_02.webp?v=1740407325","width":900,"height":900},{"id":51815961067787,"created_at":"2025-02-24T16:28:43+02:00","position":3,"updated_at":"2025-02-24T16:28:46+02:00","product_id":9757483204875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-amata-198w-24-ghz-alb-dimabila-acril_LL262_03.webp?v=1740407326","width":900,"height":900},{"id":51815960903947,"created_at":"2025-02-24T16:28:43+02:00","position":4,"updated_at":"2025-02-24T16:28:45+02:00","product_id":9757483204875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-amata-198w-24-ghz-alb-dimabila-acril_LL262_04.webp?v=1740407325","width":900,"height":900},{"id":51815960969483,"created_at":"2025-02-24T16:28:43+02:00","position":5,"updated_at":"2025-02-24T16:28:45+02:00","product_id":9757483204875,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/lustra-led-telecomanda-amata-198w-24-ghz-alb-dimabila-acril_LL262_05.webp?v=1740407325","width":900,"height":900}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":10238210015499,"title":"Lustra LED cu Telecomanda MARIA, 22W, 4 Elemente, Lumina Calda\/Rece\/Neutra, Dimabila, Negru","handle":"lustra-led-cu-telecomnda-maria-22w-4-elemente-lumina-calda-rece-neutra-dimabila-negru","body_html":"\u003cp data-sourcepos=\"1:1-1:248\"\u003eLustra LED MARIA, o piesa de iluminat ce imbina estetica moderna cu functionalitatea avansata. Conceputa pentru a adauga o nota de rafinament, aceasta lustra este mai mult decat o sursa de lumina, este o declaratie de stil.\u003c\/p\u003e\u003cul data-sourcepos=\"3:1-6:0\"\u003e\n\u003cli data-sourcepos=\"3:1-3:246\"\u003e\n\u003cstrong\u003eDesign Minimalist \u0026amp; Bicolor:\u003c\/strong\u003e Cu o forma liniara si o combinatie eleganta de negru si auriu, realizata din acril si metal, lustra MARIA, cu cele 4 surse luminoase, devine un accent distinctiv, integrandu-se perfect in decorurile moderne.\u003c\/li\u003e\n\u003cli data-sourcepos=\"4:1-4:263\"\u003e\n\u003cstrong\u003eIluminare Adaptabila \u0026amp; Eficienta:\u003c\/strong\u003e Beneficiati de o putere totala de 22W si un flux luminos de 1760lm. Alegeti din cele trei temperaturi de culoare (calda, neutra, rece) si controlati lumina intuitiv, fie prin intrerupatorul clasic, fie prin telecomanda.\u003c\/li\u003e\n\u003cli data-sourcepos=\"5:1-6:0\"\u003e\n\u003cstrong\u003eDurabilitate Extinsa:\u003c\/strong\u003e Tehnologia LED avansata asigura un consum optim si o durata de viata remarcabila de 25.000 de ore, oferind performanta pe termen lung si o intretinere minima.\u003c\/li\u003e\n\u003c\/ul\u003e\u003cp data-sourcepos=\"7:1-7:238\"\u003eLustra LED MARIA este solutia ideala pentru cei ce cauta o iluminare eficienta, estetica si durabila, transformand fiecare incapere intr-un spatiu plin de personalitate si un confort vizual exceptional, perfect pentru dormitor sau living.\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:238\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/noapte-banner.jpg?v=1742391487\" alt=\"\"\u003e\u003c\/p\u003e\u003cp data-sourcepos=\"7:1-7:238\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_general_lustre_led_10m.webp?v=1741780801\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/banner_lumina_rece_calda_neutra_lustra_led.webp?v=1734526074\" alt=\"\"\u003e\u003cimg src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/telecomanda-banner.jpg?v=1742391439\" alt=\"\"\u003e\u003c\/p\u003e","published_at":"2025-06-12T01:40:12+03:00","created_at":"2025-06-11T14:44:51+03:00","updated_at":"2026-09-14T13:12:21+03:00","vendor":"Alessandro Design","product_type":"Lustre LED cu Telecomanda","tags":["active","CH_ONLINE-MASS","Corpuri de Iluminat","Lustre LED","Lustre LED cu Telecomanda"],"variants":[{"id":52429945569547,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"AT1CT-IM1P-HT2L-LT721\/4GD","requires_shipping":true,"taxable":true,"featured_image":null,"available":false,"price":"179.99","grams":0,"compare_at_price":"279.99","position":1,"product_id":10238210015499,"created_at":"2025-09-30T17:58:01+03:00","updated_at":"2026-09-14T13:12:21+03:00"}],"images":[{"id":56328735457547,"created_at":"2025-06-12T01:39:56+03:00","position":1,"updated_at":"2025-06-12T01:43:41+03:00","product_id":10238210015499,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0782\/5175\/3739\/files\/mockup-lt721_4-lustra-led-cu-telecomanda_2.webp?v=1749681821","width":1080,"height":1080},{"id":56463754952971,"created_at":"2025-06-16T