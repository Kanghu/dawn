<script>
  (() => {
    class TempShowcaseazjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j extends HTMLElement {
      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-temp-showcase__button-azjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j');
        this.images = this.querySelectorAll('.ai-temp-showcase__image-azjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j');
        this.placeholders = this.querySelectorAll('.ai-temp-showcase__placeholder-azjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j');

        this.buttons.forEach(button => {
          button.addEventListener('click', () => {
            const temp = button.dataset.temp;

            this.buttons.forEach(item => item.classList.toggle('active', item === button));
            this.images.forEach(image => image.classList.toggle('active', image.dataset.temp === temp));

            this.placeholders.forEach(item => {
              item.style.display = item.dataset.temp === temp ? 'flex' : 'none';
            });
          });
        });
      }
    }

    customElements.define('temp-showcase-azjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j', TempShowcaseazjrjvkp2sffznzvmkaigenblock7356d5dzlyn4j);
  })();
</script>



