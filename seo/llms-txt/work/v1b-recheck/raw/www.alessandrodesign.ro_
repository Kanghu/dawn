<style>
  /* Fix desktop country selector display - show more countries */
  .disclosure__list-wrapper.country-selector {
    max-height: 80vh !important;
  }

  .disclosure__list.country-selector__list {
    max-height: 75vh !important;
  }
  
  /* Ensure proper scrolling and spacing for better UX */
  .country-selector__list {
    padding-bottom: 1rem;
    scroll-behavior: smooth;
  }
  
  /* Optional: Improve visual appearance for longer lists */
  .country-selector__list .disclosure__item {
    padding: 0.25rem 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Optimize DOM queries for better INP - use specific form IDs instead of document-wide scanning
    const headerCountryForm = document.getElementById('HeaderCountryForm');
    const mobileCountryForm = document.getElementById('MobileHeaderCountryForm');
    
    // Early return if no country localization forms exist
    if (!headerCountryForm && !mobileCountryForm) return;
    
    // Collect elements from existing forms only (much more efficient)
    const forms = [headerCountryForm, mobileCountryForm].filter(Boolean);
    const mobileSelectorButtons = [];
    const mobileSelectors = [];
    const closeButtons = [];
    
    forms.forEach(form => {
      // Scoped queries within small containers - much faster than document.querySelectorAll
      mobileSelectorButtons.push(...form.querySelectorAll('button.disclosure__button'));
      mobileSelectors.push(...form.querySelectorAll('.mobile-country-selector'));
      closeButtons.push(...form.querySelectorAll('.country-selector__close-button'));
    });
    
    // Function to open mobile selector
    function openMobileSelector(event) {
      const button = event.currentTarget;
      const selector = button.closest('.disclosure').querySelector('.mobile-country-selector');
      
      if (selector) {
        selector.removeAttribute('hidden');
        document.body.classList.add('mobile-country-selector-active');
        button.setAttribute('aria-expanded', 'true');
      }
    }
    
    // Function to close mobile selector
    function closeMobileSelector() {
      mobileSelectors.forEach(selector => {
        selector.setAttribute('hidden', '');
      });
      document.body.classList.remove('mobile-country-selector-active');
      mobileSelectorButtons.forEach(button => {
        button.setAttribute('aria-expanded', 'false');
      });
      
      // Force a reflow to ensure CSS changes are applied immediately
      document.body.offsetHeight;
    }
    
    // Add event listeners for mobile selectors - now working with pre-filtered arrays
    mobileSelectorButtons.forEach(button => {
      if (button.closest('.disclosure').querySelector('.mobile-country-selector')) {
        button.addEventListener('click', openMobileSelector);
      }
    });
    
    // Add event listeners for close buttons - now working with pre-filtered arrays  
    closeButtons.forEach(button => {
      if (button.closest('.mobile-country-selector')) {
        button.addEventListener('click', closeMobileSelector);
      }
    });
    
    // Close when clicking on the overlay
    document.addEventListener('click', function(event) {
      if (event.target.classList.contains('country-selector__overlay')) {
        closeMobileSelector();
      }
    });
    
    // Close on Escape key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        closeMobileSelector();
      }
    });
    
    // Handle country selection
    document.querySelectorAll('.country-selector a.disclosure__link').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const form = this.closest('form');
        const input = form.querySelector('input[name="country_code"]');
        if (input) {
          input.value = this.getAttribute('data-value');
          form.submit();
        }
        closeMobileSelector();
      });
    });
  });
</script>

<script>
  // Additional safety mechanism to ensure everything is restored properly
  (function() {
    function checkAndRestoreElements() {
      if (!document.querySelector('.mobile-country-selector:not([hidden])')) {
        document.body.classList.remove('mobile-country-selector-active');
      }
    }
    
    // Check periodically and on various events
    setInterval(checkAndRestoreElements, 1000);
    window.addEventListener('resize', checkAndRestoreElements);
    window.addEventListener('scroll', checkAndRestoreElements);
    window.addEventListener('click', checkAndRestoreElements);
  })();
</script>
 </div></form></localization-form>
