 0 0 0 2 2h1v-5H7a2 2 0 0 0-2 2Zm14 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Zm-7 6h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/> </svg> </div> <div class="custom-benefit-item__content"> <div class="custom-benefit-item__title">Suport dedicat</div> <div class="custom-benefit-item__text">Suntem aici pentru tine</div> </div> </div> </div> </div> <style> .custom-benefits-bar { background: #ffffff; margin: 32px 0; } .custom-benefits-bar__inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); background: #f7f7f7; border: 1px solid #ebebeb; border-radius: 12px; overflow: hidden; } .custom-benefit-item { position: relative; display: flex; align-items: center; gap: 16px; padding: 22px 28px; min-height: 92px; } .custom-benefit-item:not(:last-child)::after { content: ""; position: absolute; top: 22%; right: 0; width: 1px; height: 56%; background: #e3e3e3; } .custom-benefit-item__icon { width: 34px; height: 34px; min-width: 34px; color: #111111; display: flex; align-items: center; justify-content: center; } .custom-benefit-item__icon svg { width: 34px; height: 34px; display: block; } .custom-benefit-item__content { display: flex; flex-direction: column; } .custom-benefit-item__title { margin: 0 0 4px; font-size: 20px; line-height: 1.2; font-weight: 600; color: #111111; } .custom-benefit-item__text { font-size: 16px; line-height: 1.45; color: #666666; } @media screen and (max-width: 989px) { .custom-benefits-bar__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); } .custom-benefit-item:nth-child(2n)::after { display: none; } } @media screen and (max-width: 749px) { .custom-benefits-bar { margin: 24px 0; } .custom-benefits-bar__inner { grid-template-columns: 1fr; border-radius: 12px; } .custom-benefit-item { padding: 18px 18px; min-height: auto; } .custom-benefit-item::after { display: none !important; } .custom-benefit-item:not(:last-child) { border-bottom: 1px solid #e3e3e3; } .custom-benefit-item__title { font-size: 18px; } .custom-benefit-item__text { font-size: 14px; } .custom-benefit-item__icon, .custom-benefit-item__icon svg { width: 30px; height: 30px; min-width: 30px; } } </style>" dar unde textele pot fi traduse in orice limba prin localize
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-bar-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
    width: 100%;
    display: block;
  }

  .ai-benefits-bar__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    background: {{ block.settings.container_bg_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    min-height: {{ block.settings.item_min_height }}px;
  }

  .ai-benefit-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 22%;
    right: 0;
    width: 1px;
    height: 56%;
    background: {{ block.settings.divider_color }};
  }

  .ai-benefit-item__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    min-width: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-benefit-item__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: block;
  }

  .ai-benefit-item__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-benefit-item__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
  }

  .ai-benefit-item__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.45;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-bar__inner-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-benefit-item-{{ ai_gen_id }}:nth-child(2n)::after {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-bar-{{ ai_gen_id }} {
      margin: {{ block.settings.margin_top_mobile }}px 0 {{ block.settings.margin_bottom_mobile }}px;
    }

    .ai-benefits-bar__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      border-radius: {{ block.settings.border_radius_mobile }}px;
    }

    .ai-benefit-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding_vertical_mobile }}px {{ block.settings.item_padding_horizontal_mobile }}px;
      min-height: auto;
    }

    .ai-benefit-item-{{ ai_gen_id }}::after {
      display: none !important;
    }

    .ai-benefit-item-{{ ai_gen_id }}:not(:last-child) {
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }

    .ai-benefit-item__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-benefit-item__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-benefit-item__icon-{{ ai_gen_id }},
    .ai-benefit-item__icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
      min-width: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

<benefits-bar-{{ ai_gen_id }} class="ai-benefits-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-bar__inner-{{ ai_gen_id }} page-width">
    {% for i in (1..4) %}
      {% liquid
        assign benefit_enabled_key = 'benefit_' | append: i | append: '_enabled'
        assign benefit_title_key = 'benefit_' | append: i | append: '_title'
        assign benefit_text_key = 'benefit_' | append: i | append: '_text'
        assign benefit_icon_key = 'benefit_' | append: i | append: '_icon'

        assign benefit_enabled = block.settings[benefit_enabled_key]
        assign benefit_title = block.settings[benefit_title_key]
        assign benefit_text = block.settings[benefit_text_key]
        assign benefit_icon = block.settings[benefit_icon_key]
      %}

      {% if benefit_enabled %}
        <div class="ai-benefit-item-{{ ai_gen_id }}">
          <div class="ai-benefit-item__icon-{{ ai_gen_id }}">
            {% case benefit_icon %}
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 6h11v8H3V6Zm11 3h3l3 3v2h-6V9Zm-8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'shield' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M8 7H4m0 0l3-3M4 7l3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M20 12a8 8 0 0 0-13.66-5.66L4 7m16 5a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'headphones' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 14v-2a7 7 0 1 1 14 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  <path d="M5 14a2 2 0 0 0 2 2h1v-5H7a2 2 0 0 0-2 2Zm14 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Zm-7 6h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'check' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'star' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'gift' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M20 12v10H4V12M2 7h20v5H2V7z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zm0 0h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'lock' %}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            {% endcase %}
          </div>
          <div class="ai-benefit-item__content-{{ ai_gen_id }}">
            {% if benefit_title != blank %}
              <div class="ai-benefit-item__title-{{ ai_gen_id }}">{{ benefit_title }}</div>
            {% endif %}
            {% if benefit_text != blank %}
              <div class="ai-benefit-item__text-{{ ai_gen_id }}">{{ benefit_text }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</benefits-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class BenefitsBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('benefits-bar-{{ ai_gen_id }}', BenefitsBar{{ ai_gen_id }});
  })();
</script>

