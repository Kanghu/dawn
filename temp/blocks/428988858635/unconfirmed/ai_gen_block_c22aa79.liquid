{% doc %}
  @prompt
    Create an author box for the blog. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-author-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    margin: 0 auto;
  }

  .ai-author-box-content-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.content_gap }}px;
    align-items: flex-start;
  }

  .ai-author-box-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-author-box-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-author-box-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-author-box-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-author-box-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-author-box-name-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.name_margin_bottom }}px;
    font-size: {{ block.settings.name_font_size }}px;
    font-weight: {{ block.settings.name_font_weight }};
    color: {{ block.settings.name_color }};
    line-height: 1.3;
  }

  .ai-author-box-role-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.role_margin_bottom }}px;
    font-size: {{ block.settings.role_font_size }}px;
    color: {{ block.settings.role_color }};
    line-height: 1.4;
  }

  .ai-author-box-bio-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.bio_font_size }}px;
    color: {{ block.settings.bio_color }};
    line-height: 1.6;
  }

  .ai-author-box-social-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.social_gap }}px;
    margin-top: {{ block.settings.social_margin_top }}px;
    flex-wrap: wrap;
  }

  .ai-author-box-social-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    color: {{ block.settings.social_icon_color }};
    transition: color 0.3s ease;
  }

  .ai-author-box-social-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.social_icon_hover_color }};
  }

  .ai-author-box-social-link-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-author-box-content-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
    }

    .ai-author-box-content-{{ ai_gen_id }}.ai-author-box-mobile-column-{{ ai_gen_id }} {
      align-items: center;
      text-align: center;
    }

    .ai-author-box-content-{{ ai_gen_id }}.ai-author-box-mobile-row-{{ ai_gen_id }} {
      align-items: flex-start;
      text-align: left;
    }

    .ai-author-box-social-{{ ai_gen_id }}.ai-author-box-social-column-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-author-box-social-{{ ai_gen_id }}.ai-author-box-social-row-{{ ai_gen_id }} {
      justify-content: flex-start;
    }

    .ai-author-box-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_image_size }}px;
      height: {{ block.settings.mobile_image_size }}px;
    }
  }
{% endstyle %}

<author-box-{{ ai_gen_id }} class="ai-author-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-author-box-content-{{ ai_gen_id }} ai-author-box-mobile-{{ block.settings.mobile_layout }}-{{ ai_gen_id }}">
    <div class="ai-author-box-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.author_image %}
        <img
          src="{{ block.settings.author_image | image_url: width: 300 }}"
          alt="{{ block.settings.author_name | escape }}"
          class="ai-author-box-image-{{ ai_gen_id }}"
          loading="lazy"
          width="300"
          height="300"
        >
      {% else %}
        <div class="ai-author-box-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-author-box-info-{{ ai_gen_id }}">
      {% if block.settings.author_name != blank %}
        <h3 class="ai-author-box-name-{{ ai_gen_id }}">{{ block.settings.author_name }}</h3>
      {% endif %}

      {% if block.settings.author_role != blank %}
        <p class="ai-author-box-role-{{ ai_gen_id }}">{{ block.settings.author_role }}</p>
      {% endif %}

      {% if block.settings.author_bio != blank %}
        <div class="ai-author-box-bio-{{ ai_gen_id }}">{{ block.settings.author_bio }}</div>
      {% endif %}

      {% if block.settings.show_social_links %}
        <div class="ai-author-box-social-{{ ai_gen_id }} ai-author-box-social-{{ block.settings.mobile_layout }}-{{ ai_gen_id }}">
          {% if block.settings.twitter_url != blank %}
            <a
              href="{{ block.settings.twitter_url }}"
              class="ai-author-box-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.facebook_url != blank %}
            <a
              href="{{ block.settings.facebook_url }}"
              class="ai-author-box-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.instagram_url != blank %}
            <a
              href="{{ block.settings.instagram_url }}"
              class="ai-author-box-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.linkedin_url != blank %}
            <a
              href="{{ block.settings.linkedin_url }}"
              class="ai-author-box-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          {% endif %}

          {% if block.settings.website_url != blank %}
            <a
              href="{{ block.settings.website_url }}"
              class="ai-author-box-social-link-{{ ai_gen_id }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Website"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</author-box-{{ ai_gen_id }}>

<script>
  (function() {
    class AuthorBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('author-box-{{ ai_gen_id }}', AuthorBox{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Author box",
  "settings": [
    {
      "type": "header",
      "content": "Author information"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author image"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "John Doe"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role",
      "default": "Content Writer"
    },
    {
      "type": "richtext",
      "id": "author_bio",
      "label": "Author bio",
      "default": "<p>Passionate about creating engaging content and sharing insights with readers.</p>"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "website_url",
      "label": "Website URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal"
        },
        {
          "value": "column",
          "label": "Vertical"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 60,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_image_size",
      "label": "Mobile image size",
      "min": 50,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "bio_color",
      "label": "Bio",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social icon",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "social_icon_hover_color",
      "label": "Social icon hover",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "name_font_size",
      "label": "Name font size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "name_font_weight",
      "label": "Name font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "name_margin_bottom",
      "label": "Name margin bottom",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "role_font_size",
      "label": "Role font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "role_margin_bottom",
      "label": "Role margin bottom",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "bio_font_size",
      "label": "Bio font size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Social icons"
    },
    {
      "type": "range",
      "id": "social_icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "social_gap",
      "label": "Icon gap",
      "min": 5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "social_margin_top",
      "label": "Margin top",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Author box"
    }
  ]
}
{% endschema %}
