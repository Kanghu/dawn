{% doc %}
  @prompt
    genereaza-mi o sectiunea mobile friendly, unde aleg un produs, si imi apar 3 optiuni. 3000K, 4500K, si 6000K. Astea sunt temperaturile de lumina. Eu selectez una si imi da un overlay la imaginea principala a produsului astfel incat sa para ca incaperea e lumina de o lumina, de kelvinii respectivi., arata prea ciudat. Vreau un layout modern, vreau butoanele mai mici, mai frumoase, mai award winning tot modulul asta, Nu se schimba cu nimic. Arata la fel. indiferent de ce aleg. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-light-temp-selector-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-light-temp-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 0;
  }

  .ai-light-temp-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px 0;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .ai-light-temp-subheading-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    margin: 0;
    font-weight: 400;
  }

  .ai-light-temp-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-light-temp-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-light-temp-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-light-temp-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-light-temp-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    font-size: 13px;
    color: #666;
    text-align: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    backdrop-filter: blur(10px);
  }

  .ai-light-temp-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .ai-light-temp-overlay-{{ ai_gen_id }}.active {
    opacity: {{ block.settings.overlay_intensity | divided_by: 100.0 }};
  }

  .ai-light-temp-buttons-{{ ai_gen_id }} {
    display: inline-flex;
    gap: 8px;
    padding: 6px;
    background: {{ block.settings.pill_bg_color }};
    border-radius: 100px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    width: fit-content;
    margin: 0 auto;
  }

  .ai-light-temp-button-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: none;
    background: transparent;
    color: {{ block.settings.button_text_color }};
    border-radius: 100px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    white-space: nowrap;
    position: relative;
  }

  .ai-light-temp-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
    background: {{ block.settings.button_hover_bg_color }};
  }

  .ai-light-temp-button-{{ ai_gen_id }}.active {
    background: {{ block.settings.button_active_bg_color }};
    color: {{ block.settings.button_active_text_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .ai-light-temp-label-{{ ai_gen_id }} {
    display: inline;
    font-weight: 500;
  }

  .ai-light-temp-kelvin-{{ ai_gen_id }} {
    display: inline;
    font-size: 0.9em;
    opacity: 0.7;
    margin-left: 4px;
  }

  .ai-light-temp-indicator-{{ ai_gen_id }} {
    position: absolute;
    bottom: 16px;
    right: 16px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
    color: #121212;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 2;
  }

  .ai-light-temp-indicator-{{ ai_gen_id }}.visible {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-light-temp-container-{{ ai_gen_id }} {
      gap: 24px;
    }

    .ai-light-temp-buttons-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }

    .ai-light-temp-button-{{ ai_gen_id }} {
      flex: 1;
      padding: 12px 16px;
      font-size: {{ block.settings.button_font_size | minus: 1 }}px;
    }

    .ai-light-temp-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-light-temp-kelvin-{{ ai_gen_id }} {
      display: block;
      margin-left: 0;
      margin-top: 2px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-light-temp-button-{{ ai_gen_id }} {
      padding: 10px 12px;
    }

    .ai-light-temp-label-{{ ai_gen_id }} {
      display: block;
    }

    .ai-light-temp-kelvin-{{ ai_gen_id }} {
      font-size: 11px;
    }
  }
{% endstyle %}

<light-temperature-selector-{{ ai_gen_id }}
  class="ai-light-temp-selector-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-light-temp-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div>
        {% if block.settings.heading != blank %}
          <h2 class="ai-light-temp-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-light-temp-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-light-temp-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product %}
        {% if block.settings.product.featured_image %}
          <img
            src="{{ block.settings.product.featured_image | image_url: width: 1400 }}"
            alt="{{ block.settings.product.featured_image.alt | escape }}"
            width="{{ block.settings.product.featured_image.width }}"
            height="{{ block.settings.product.featured_image.height }}"
            loading="lazy"
            class="ai-light-temp-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-light-temp-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      {% else %}
        <div class="ai-light-temp-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-light-temp-empty-state-{{ ai_gen_id }}">
            Selectează un produs
          </div>
        </div>
      {% endif %}

      <div
        class="ai-light-temp-overlay-{{ ai_gen_id }}"
        data-overlay="3000"
      ></div>
      <div
        class="ai-light-temp-overlay-{{ ai_gen_id }}"
        data-overlay="4500"
      ></div>
      <div
        class="ai-light-temp-overlay-{{ ai_gen_id }}"
        data-overlay="6000"
      ></div>

      <div class="ai-light-temp-indicator-{{ ai_gen_id }}" data-indicator></div>
    </div>

    <div class="ai-light-temp-buttons-{{ ai_gen_id }}">
      <button
        class="ai-light-temp-button-{{ ai_gen_id }}"
        data-temperature="3000"
        data-label="{{ block.settings.warm_label }}"
        aria-pressed="false"
      >
        <span class="ai-light-temp-label-{{ ai_gen_id }}">{{ block.settings.warm_label }}</span>
        <span class="ai-light-temp-kelvin-{{ ai_gen_id }}">3000K</span>
      </button>
      <button
        class="ai-light-temp-button-{{ ai_gen_id }}"
        data-temperature="4500"
        data-label="{{ block.settings.neutral_label }}"
        aria-pressed="false"
      >
        <span class="ai-light-temp-label-{{ ai_gen_id }}">{{ block.settings.neutral_label }}</span>
        <span class="ai-light-temp-kelvin-{{ ai_gen_id }}">4500K</span>
      </button>
      <button
        class="ai-light-temp-button-{{ ai_gen_id }}"
        data-temperature="6000"
        data-label="{{ block.settings.cool_label }}"
        aria-pressed="false"
      >
        <span class="ai-light-temp-label-{{ ai_gen_id }}">{{ block.settings.cool_label }}</span>
        <span class="ai-light-temp-kelvin-{{ ai_gen_id }}">6000K</span>
      </button>
    </div>
  </div>
</light-temperature-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class LightTemperatureSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.buttons = [];
        this.overlays = [];
        this.indicator = null;
        this.currentTemp = null;
        this.warmColor = '{{ block.settings.warm_color }}';
        this.neutralColor = '{{ block.settings.neutral_color }}';
        this.coolColor = '{{ block.settings.cool_color }}';
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-light-temp-button-{{ ai_gen_id }}');
        this.overlays = this.querySelectorAll('.ai-light-temp-overlay-{{ ai_gen_id }}');
        this.indicator = this.querySelector('[data-indicator]');
        this.setupOverlayColors();
        this.setupEventListeners();
      }

      setupOverlayColors() {
        this.overlays.forEach((overlay) => {
          const temp = overlay.getAttribute('data-overlay');
          if (temp === '3000') {
            overlay.style.backgroundColor = this.warmColor;
          } else if (temp === '4500') {
            overlay.style.backgroundColor = this.neutralColor;
          } else if (temp === '6000') {
            overlay.style.backgroundColor = this.coolColor;
          }
        });
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const temperature = button.getAttribute('data-temperature');
            const label = button.getAttribute('data-label');
            this.selectTemperature(temperature, label);
          });
        });
      }

      selectTemperature(temperature, label) {
        this.buttons.forEach((btn) => {
          const btnTemp = btn.getAttribute('data-temperature');
          if (btnTemp === temperature) {
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('active');
            btn.setAttribute('aria-pressed', 'false');
          }
        });

        this.overlays.forEach((overlay) => {
          const overlayTemp = overlay.getAttribute('data-overlay');
          if (overlayTemp === temperature) {
            overlay.classList.add('active');
          } else {
            overlay.classList.remove('active');
          }
        });

        if (this.indicator) {
          this.indicator.textContent = label + ' ' + temperature + 'K';
          this.indicator.classList.add('visible');
        }

        this.currentTemp = temperature;
      }
    }

    customElements.define('light-temperature-selector-{{ ai_gen_id }}', LightTemperatureSelector{{ ai_gen_id }});
  })();
</script>

