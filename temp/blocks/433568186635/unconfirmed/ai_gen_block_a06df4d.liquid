{% doc %}
  @prompt
    <div class="custom-benefits-bar" style="background: {{ section.settings.section_bg }};">
      <div class="custom-benefits-bar__inner page-width" style="
        background: {{ section.settings.inner_bg }};
        border-color: {{ section.settings.border_color }};
        border-radius: {{ section.settings.border_radius }}px;
      ">
        {% for block in section.blocks %}
          <div class="custom-benefit-item" {{ block.shopify_attributes }}>
            <div class="custom-benefit-item__icon" style="color: {{ section.settings.icon_color }};">
              {% case block.settings.icon %}
                {% when 'delivery' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 6h11v8H3V6Zm11 3h3l3 3v2h-6V9Zm-8 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'shield' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'return' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M8 7H4m0 0l3-3M4 7l3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M20 12a8 8 0 0 0-13.66-5.66L4 7m16 5a8 8 0 1 1-2.34-5.66" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'support' %}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 14v-2a7 7 0 1 1 14 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    <path d="M5 14a2 2 0 0 0 2 2h1v-5H7a2 2 0 0 0-2 2Zm14 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Zm-7 6h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </div>
    
            <div class="custom-benefit-item__content">
              <div class="custom-benefit-item__title" style="
                color: {{ section.settings.title_color }};
                font-size: {{ section.settings.title_size }}px;
              ">
                {{ block.settings.title }}
              </div>
              <div class="custom-benefit-item__text" style="
                color: {{ section.settings.text_color }};
                font-size: {{ section.settings.text_size }}px;
              ">
                {{ block.settings.text }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    
    <style>
      .custom-benefits-bar {
        margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px;
      }
    
      .custom-benefits-bar__inner {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
        border: 1px solid;
        overflow: hidden;
      }
    
      .custom-benefit-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px 28px;
        min-height: 92px;
      }
    
      .custom-benefit-item:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 22%;
        right: 0;
        width: 1px;
        height: 56%;
        background: {{ section.settings.divider_color }};
      }
    
      .custom-benefit-item__icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    
      .custom-benefit-item__icon svg {
        width: 34px;
        height: 34px;
        display: block;
      }
    
      .custom-benefit-item__content {
        display: flex;
        flex-direction: column;
      }
    
      .custom-benefit-item__title {
        margin: 0 0 4px;
        line-height: 1.2;
        font-weight: 600;
      }
    
      .custom-benefit-item__text {
        line-height: 1.45;
      }
    
      @media screen and (max-width: 989px) {
        .custom-benefits-bar__inner {
          grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
        }
    
        .custom-benefit-item:nth-child(2n)::after {
          display: none;
        }
      }
    
      @media screen and (max-width: 749px) {
        .custom-benefits-bar {
          margin: {{ section.settings.mobile_margin_top }}px 0 {{ section.settings.mobile_margin_bottom }}px;
        }
    
        .custom-benefits-bar__inner {
          grid-template-columns: 1fr;
        }
    
        .custom-benefit-item {
          padding: 18px 18px;
          min-height: auto;
        }
    
        .custom-benefit-item::after {
          display: none !important;
        }
    
        .custom-benefit-item:not(:last-child) {
          border-bottom: 1px solid {{ section.settings.divider_color }};
        }
    
        .custom-benefit-item__title {
          font-size: {{ section.settings.mobile_title_size }}px !important;
        }
    
        .custom-benefit-item__text {
          font-size: {{ section.settings.mobile_text_size }}px !important;
        }
    
