{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-bar-{{ ai_gen_id }} {
    display: block;
    background: {{ block.settings.section_bg }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .ai-benefits-bar__inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    background: {{ block.settings.inner_bg }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    overflow: hidden;
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 28px;
    min-height: 92px;
  }

  .ai-benefit-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 22%;
    right: 0;
    width: 1px;
    height: 56%;
    background: {{ block.settings.divider_color }};
  }

  .ai-benefit-item__icon-{{ ai_gen_id }} {
    width: 34px;
    height: 34px;
    min-width: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefit-item__icon-{{ ai_gen_id }} svg {
    width: 34px;
    height: 34px;
    display: block;
  }

  .ai-benefit-item__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-benefit-item__title-{{ ai_gen_id }} {
    margin: 0 0 4px;
    line-height: 1.2;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
  }

  .ai-benefit-item__text-{{ ai_gen_id }} {
    line-height: 1.45;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-bar__inner-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, minmax(0, 1fr));
    }

    .ai-benefit-item-{{ ai_gen_id }}:nth-child(2n)::after {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-bar-{{ ai_gen_id }} {
      margin: {{ block.settings.mobile_margin_top }}px 0 {{ block.settings.mobile_margin_bottom }}px;
    }

    .ai-benefits-bar__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-benefit-item-{{ ai_gen_id }} {
      padding: 18px 18px;
      min-height: auto;
    }

    .ai-benefit-item-{{ ai_gen_id }}::after {
      display: none !important;
    }

    .ai-benefit-item-{{ ai_gen_id }}:not(:last-child) {
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }

    .ai-benefit-item__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px !important;
    }

    .ai-benefit-item__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px !important;
    }

    .ai-benefit-item__icon-{{ ai_gen_id }},
    .ai-benefit-item__icon-{{ ai_gen_id }} svg {
      width: 28px;
      height: 28px;
      min-width: 28px;
    }
  }
{% endstyle %}

