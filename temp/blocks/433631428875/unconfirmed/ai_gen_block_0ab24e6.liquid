{% doc %}
  @prompt
    I nevoie sa imi creezi o sectiunea de banner. Uploadez o imagine (in general de ratie de 21:9) si pot adauga texte, butoane, etc pe ea si toate vreau sa aiba fine controls. Pozitie, stil, font, weight, shadow, scale. Trebuie sa pot avea 2 variante, de mobil si de desktop pentru imagini deoarece pe mobil folosim imagini de ratio mai mic (16:9). Si textele trebuie sa poata fi traduse. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-banner-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.desktop_aspect_ratio }}%;
  }

  .ai-banner-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.desktop_image_position }};
  }

  .ai-banner-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.desktop_vertical_alignment }};
    justify-content: {{ block.settings.desktop_horizontal_alignment }};
    padding: {{ block.settings.desktop_content_padding }}px;
    z-index: 2;
  }

  .ai-banner-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_content_max_width }}%;
    text-align: {{ block.settings.desktop_text_alignment }};
  }

  .ai-banner-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.desktop_heading_spacing }}px;
    font-size: {{ block.settings.desktop_heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    line-height: 1.2;
    {% if block.settings.heading_shadow_enabled %}
      text-shadow: {{ block.settings.heading_shadow_x }}px {{ block.settings.heading_shadow_y }}px {{ block.settings.heading_shadow_blur }}px {{ block.settings.heading_shadow_color }};
    {% endif %}
  }

  .ai-banner-subheading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.desktop_subheading_spacing }}px;
    font-size: {{ block.settings.desktop_subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    line-height: 1.4;
    {% if block.settings.subheading_shadow_enabled %}
      text-shadow: {{ block.settings.subheading_shadow_x }}px {{ block.settings.subheading_shadow_y }}px {{ block.settings.subheading_shadow_blur }}px {{ block.settings.subheading_shadow_color }};
    {% endif %}
  }

  .ai-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.desktop_button_padding_vertical }}px {{ block.settings.desktop_button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.desktop_button_font_size }}px;
    font-weight: {{ block.settings.button_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    {% if block.settings.button_shadow_enabled %}
      box-shadow: {{ block.settings.button_shadow_x }}px {{ block.settings.button_shadow_y }}px {{ block.settings.button_shadow_blur }}px {{ block.settings.button_shadow_color }};
    {% endif %}
  }

  .ai-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-banner-image-wrapper-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.mobile_aspect_ratio }}%;
    }

    .ai-banner-image-{{ ai_gen_id }} {
      object-position: {{ block.settings.mobile_image_position }};
    }

    .ai-banner-content-{{ ai_gen_id }} {
      align-items: {{ block.settings.mobile_vertical_alignment }};
      justify-content: {{ block.settings.mobile_horizontal_alignment }};
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-banner-text-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_content_max_width }}%;
      text-align: {{ block.settings.mobile_text_alignment }};
    }

    .ai-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
      margin-bottom: {{ block.settings.mobile_heading_spacing }}px;
    }

    .ai-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_size }}px;
      margin-bottom: {{ block.settings.mobile_subheading_spacing }}px;
    }

    .ai-banner-button-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_button_padding_vertical }}px {{ block.settings.mobile_button_padding_horizontal }}px;
      font-size: {{ block.settings.mobile_button_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-banner-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image %}
      <picture>
        {% if block.settings.mobile_image %}
          <source
            media="(max-width: 749px)"
            srcset="{{ block.settings.mobile_image | image_url: width: 1500 }}"
          >
        {% endif %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 2500 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-banner-image-{{ ai_gen_id }}"
        >
      </picture>
    {% else %}
      <div class="ai-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-banner-content-{{ ai_gen_id }}">
    <div class="ai-banner-text-container-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-banner-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

