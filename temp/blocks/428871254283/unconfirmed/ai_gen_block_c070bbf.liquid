{% doc %}
  @prompt
    vreau o sectiune unde afisez toate blogurile, cu nume autor, data, titlu poza descriere mica etc
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blogs-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-blogs-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-blogs-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-blogs-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-blogs-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin-top: 12px;
  }

  .ai-blogs-grid__list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-blogs-grid__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-blogs-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-blogs-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-blogs-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blogs-grid__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-blogs-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-blogs-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-blogs-grid__meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-blogs-grid__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blogs-grid__author-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-blogs-grid__date-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blogs-grid__date-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-blogs-grid__blog-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.blog_title_size }}px;
    color: {{ block.settings.blog_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-blogs-grid__blog-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-blogs-grid__blog-title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-blogs-grid__excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-blogs-grid__read-more-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.button_text_color }};
    background-color: {{ block.settings.button_background }};
    padding: 10px 20px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .ai-blogs-grid__read-more-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-blogs-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-blogs-grid__empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-blogs-grid__empty-text-{{ ai_gen_id }} {
    font-size: 18px;
    color: #999;
  }

  @media screen and (max-width: 989px) {
    .ai-blogs-grid__list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-blogs-grid__list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-blogs-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-blogs-grid__blog-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.blog_title_size }}px * 0.9);
    }
  }
{% endstyle %}

<blogs-grid-{{ ai_gen_id }} class="ai-blogs-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blogs-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-blogs-grid__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blogs-grid__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-blogs-grid__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if blogs.size > 0 %}
      <div class="ai-blogs-grid__list-{{ ai_gen_id }}">
        {% for blog in blogs %}
          {% if forloop.index <= block.settings.blogs_to_show %}
            {% assign latest_article = blog.articles.first %}
            <article class="ai-blogs-grid__item-{{ ai_gen_id }}">
              <a href="{{ blog.url }}" class="ai-blogs-grid__image-wrapper-{{ ai_gen_id }}">
                {% if latest_article.image %}
                  <img
                    src="{{ latest_article.image | image_url: width: 800 }}"
                    alt="{{ latest_article.image.alt | escape }}"
                    class="ai-blogs-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | divided_by: latest_article.image.aspect_ratio | round }}"
                  >
                {% else %}
                  <div class="ai-blogs-grid__image-placeholder-{{ ai_gen_id }}">
                    {{ 'blog-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </a>

              <div class="ai-blogs-grid__content-{{ ai_gen_id }}">
                {% if block.settings.show_meta %}
                  <div class="ai-blogs-grid__meta-{{ ai_gen_id }}">
                    {% if block.settings.show_author and latest_article.author != blank %}
                      <div class="ai-blogs-grid__author-{{ ai_gen_id }}">
                        <svg class="ai-blogs-grid__author-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>{{ latest_article.author }}</span>
                      </div>
                    {% endif %}
                    {% if block.settings.show_date %}
                      <div class="ai-blogs-grid__date-{{ ai_gen_id }}">
                        <svg class="ai-blogs-grid__date-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>{{ latest_article.published_at | date: '%d %B %Y' }}</span>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

                <h3 class="ai-blogs-grid__blog-title-{{ ai_gen_id }}">
                  <a href="{{ blog.url }}" class="ai-blogs-grid__blog-title-link-{{ ai_gen_id }}">
                    {{ blog.title }}
                  </a>
                </h3>

                {% if block.settings.show_excerpt and latest_article.excerpt != blank %}
                  <div class="ai-blogs-grid__excerpt-{{ ai_gen_id }}">
                    {{ latest_article.excerpt | strip_html | truncate: block.settings.excerpt_length }}
                  </div>
                {% endif %}

                {% if block.settings.show_button %}
                  <a href="{{ blog.url }}" class="ai-blogs-grid__read-more-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                  </a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-blogs-grid__empty-{{ ai_gen_id }}">
        <div class="ai-blogs-grid__empty-icon-{{ ai_gen_id }}">
          {{ 'blog-apparel-1' | placeholder_svg_tag }}
        </div>
        <p class="ai-blogs-grid__empty-text-{{ ai_gen_id }}">Nu există bloguri de afișat</p>
      </div>
    {% endif %}
  </div>
</blogs-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogsGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const items = this.querySelectorAll('.ai-blogs-grid__item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('blogs-grid-{{ ai_gen_id }}', BlogsGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Grila bloguri",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Conținut"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Titlu",
      "default": "<p>Blogurile noastre</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descriere"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Aliniere titlu",
      "options": [
        {
          "value": "left",
          "label": "Stânga"
        },
        {
          "value": "center",
          "label": "Centru"
        },
        {
          "value": "right",
          "label": "Dreapta"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "blogs_to_show",
      "label": "Număr bloguri de afișat",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Coloane desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Coloane tabletă",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Coloane mobil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Spațiu între carduri",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Lățime desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Lățime container",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "header",
      "content": "Imagine"
    },
    {
      "type": "range",
      "id": "image_aspect_ratio",
      "label": "Raport aspect imagine",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "header",
      "content": "Conținut card"
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Afișează metadata",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Afișează autor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Afișează dată",
      "default": true
