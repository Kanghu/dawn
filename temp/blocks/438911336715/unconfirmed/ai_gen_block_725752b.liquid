{% doc %}
  @prompt
    genereaza-mi o sectiune, unde introduc 3 imagini, jos sunt 3 butoane, iar la apasarea feicaruia, imi face tranzitie smooth intre imagini. , Vreau imaginea in dreapta, butoanele in stanga, text mare gen titlu deasupra butoanelor, Nu arata bine. Fa-le layout modern. Asta va fi showcase pentru cele 3 culori de temperatura 3000K / 4500K / 6000K. Unde la fiecare pun imagine cu acelasi produs dar lumina diferita. Vreau mai compact si modern.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-temp-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-temp-showcase__container-{{ ai_gen_id }} {
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-temp-showcase__header-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-temp-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px 0;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-temp-showcase__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    opacity: 0.8;
  }

  .ai-temp-showcase__content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  .ai-temp-showcase__image-area-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-temp-showcase__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
  }

  .ai-temp-showcase__image-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-temp-showcase__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-temp-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-temp-showcase__controls-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.button_padding }}px;
    background: {{ block.settings.button_background }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    overflow: hidden;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: {{ block.settings.button_active_background }};
    transition: width 0.3s ease;
    z-index: 0;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active::before {
    width: 100%;
  }

  .ai-temp-showcase__button-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .ai-temp-showcase__button-indicator-{{ ai_gen_id }} {
    width: {{ block.settings.indicator_size }}px;
    height: {{ block.settings.indicator_size }}px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.button_text_color }};
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active .ai-temp-showcase__button-indicator-{{ ai_gen_id }} {
    background: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_text_color }};
  }

  .ai-temp-showcase__button-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
    flex: 1;
  }

  .ai-temp-showcase__button-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.button_label_size }}px;
    color: {{ block.settings.button_text_color }};
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active .ai-temp-showcase__button-label-{{ ai_gen_id }} {
    color: {{ block.settings.button_active_text_color }};
  }

  .ai-temp-showcase__button-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.button_desc_size }}px;
    color: {{ block.settings.button_text_color }};
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active .ai-temp-showcase__button-desc-{{ ai_gen_id }} {
    color: {{ block.settings.button_active_text_color }};
    opacity: 0.9;
  }

  .ai-temp-showcase__button-temp-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    font-size: {{ block.settings.temp_badge_size }}px;
    font-weight: 700;
    color: {{ block.settings.button_text_color }};
    transition: color 0.3s ease;
    flex-shrink: 0;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active .ai-temp-showcase__button-temp-{{ ai_gen_id }} {
    color: {{ block.settings.button_active_text_color }};
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}:hover {
    transform: translateX(4px);
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-temp-showcase__content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-temp-showcase__controls-{{ ai_gen_id }} {
      order: -1;
    }

    .ai-temp-showcase__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-temp-showcase__container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.7 }}px;
    }

    .ai-temp-showcase__button-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<temp-showcase-{{ ai_gen_id }} class="ai-temp-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-temp-showcase__container-{{ ai_gen_id }}">
    <div class="ai-temp-showcase__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-temp-showcase__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-temp-showcase__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-temp-showcase__content-{{ ai_gen_id }}">
      <div class="ai-temp-showcase__image-area-{{ ai_gen_id }}">
        {% if block.settings.image_3000k %}
          <img
            src="{{ block.settings.image_3000k | image_url: width: 1200 }}"
            alt="{{ block.settings.image_3000k.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_3000k.width }}"
            height="{{ block.settings.image_3000k.height }}"
            class="ai-temp-showcase__image-{{ ai_gen_id }} active"
            data-temp="3000"
          >
        {% else %}
          <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="3000">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.image_4500k %}
          <img
            src="{{ block.settings.image_4500k | image_url: width: 1200 }}"
            alt="{{ block.settings.image_4500k.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_4500k.width }}"
            height="{{ block.settings.image_4500k.height }}"
            class="ai-temp-showcase__image-{{ ai_gen_id }}"
            data-temp="4500"
          >
        {% else %}
          <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="4500" style="display: none;">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.image_6000k %}
          <img
            src="{{ block.settings.image_6000k | image_url: width: 1200 }}"
            alt="{{ block.settings.image_6000k.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_6000k.width }}"
            height="{{ block.settings.image_6000k.height }}"
            class="ai-temp-showcase__image-{{ ai_gen_id }}"
            data-temp="6000"
          >
        {% else %}
          <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="6000" style="display: none;">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-temp-showcase__controls-{{ ai_gen_id }}">
        <button
          class="ai-temp-showcase__button-{{ ai_gen_id }} active"
          data-temp="3000"
          aria-label="3000K Warm White"
        >
          <div class="ai-temp-showcase__button-content-{{ ai_gen_id }}">
            <div class="ai-temp-showcase__button-indicator-{{ ai_gen_id }}"></div>
            <div class="ai-temp-showcase__button-text-{{ ai_gen_id }}">
              <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_3000k }}</span>
              <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_3000k }}</span>
            </div>
          </div>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">3000K</span>
        </button>

        <button
          class="ai-temp-showcase__button-{{ ai_gen_id }}"
          data-temp="4500"
          aria-label="4500K Neutral White"
        >
          <div class="ai-temp-showcase__button-content-{{ ai_gen_id }}">
            <div class="ai-temp-showcase__button-indicator-{{ ai_gen_id }}"></div>
            <div class="ai-temp-showcase__button-text-{{ ai_gen_id }}">
              <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_4500k }}</span>
              <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_4500k }}</span>
            </div>
          </div>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">4500K</span>
        </button>

        <button
          class="ai-temp-showcase__button-{{ ai_gen_id }}"
          data-temp="6000"
          aria-label="6000K Cool White"
        >
          <div class="ai-temp-showcase__button-content-{{ ai_gen_id }}">
            <div class="ai-temp-showcase__button-indicator-{{ ai_gen_id }}"></div>
            <div class="ai-temp-showcase__button-text-{{ ai_gen_id }}">
              <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_6000k }}</span>
              <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_6000k }}</span>
            </div>
          </div>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">6000K</span>
        </button>
      </div>
    </div>
  </div>
</temp-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class TempShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-temp-showcase__button-{{ ai_gen_id }}');
        this.images = this.querySelectorAll('.ai-temp-showcase__image-{{ ai_gen_id }}');
        this.placeholders = this.querySelectorAll('.ai-temp-showcase__placeholder-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const temp = button.getAttribute('data-temp');
            this.switchTemp(temp);
            this.updateActiveButton(button);
          });
        });
      }

      switchTemp(temp) {
        this.images.forEach((image) => {
          const imageTemp = image.getAttribute('data-temp');
          if (imageTemp === temp) {
            image.classList.add('active');
          } else {
            image.classList.remove('active');
          }
        });

        this.placeholders.forEach((placeholder) => {
          const placeholderTemp = placeholder.getAttribute('data-temp');
          if (placeholderTemp === temp) {
            placeholder.style.display = 'flex';
          } else {
            placeholder.style.display = 'none';
          }
        });
      }

      updateActiveButton(activeButton) {
        this.buttons.forEach((button) => {
          button.classList.remove('active');
        });
        activeButton.classList.add('active');
      }
    }

    customElements.define('temp-showcase-{{ ai_gen_id }}', TempShowcase{{ ai_gen_id }});
  })();
</script>

