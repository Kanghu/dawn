{% doc %}
  @prompt
    genereaza-mi o sectiune, unde introduc 3 imagini, jos sunt 3 butoane, iar la apasarea feicaruia, imi face tranzitie smooth intre imagini. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-switcher-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-switcher__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-image-switcher__images-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-switcher__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
  }

  .ai-image-switcher__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
  }

  .ai-image-switcher__image-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-image-switcher__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-switcher__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-switcher__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    justify-content: {{ block.settings.button_alignment }};
    flex-wrap: wrap;
  }

  .ai-image-switcher__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 100px;
  }

  .ai-image-switcher__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-image-switcher__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_color }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-switcher__buttons-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<image-switcher-{{ ai_gen_id }} class="ai-image-switcher-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-switcher__container-{{ ai_gen_id }}">
    <div class="ai-image-switcher__images-{{ ai_gen_id }}">
      <div class="ai-image-switcher__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 2000 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
            class="ai-image-switcher__image-{{ ai_gen_id }} active"
            data-image-index="1"
          >
        {% else %}
          <div class="ai-image-switcher__placeholder-{{ ai_gen_id }}" data-image-index="1">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 2000 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
            class="ai-image-switcher__image-{{ ai_gen_id }}"
            data-image-index="2"
          >
        {% else %}
          <div class="ai-image-switcher__placeholder-{{ ai_gen_id }}" data-image-index="2" style="display: none;">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.image_3 %}
          <img
            src="{{ block.settings.image_3 | image_url: width: 2000 }}"
            alt="{{ block.settings.image_3.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_3.width }}"
            height="{{ block.settings.image_3.height }}"
            class="ai-image-switcher__image-{{ ai_gen_id }}"
            data-image-index="3"
          >
        {% else %}
          <div class="ai-image-switcher__placeholder-{{ ai_gen_id }}" data-image-index="3" style="display: none;">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-image-switcher__buttons-{{ ai_gen_id }}">
      <button
        class="ai-image-switcher__button-{{ ai_gen_id }} active"
        data-image-target="1"
        aria-label="{{ block.settings.button_1_text }}"
      >
        {{ block.settings.button_1_text }}
      </button>
      <button
        class="ai-image-switcher__button-{{ ai_gen_id }}"
        data-image-target="2"
        aria-label="{{ block.settings.button_2_text }}"
      >
        {{ block.settings.button_2_text }}
      </button>
      <button
        class="ai-image-switcher__button-{{ ai_gen_id }}"
        data-image-target="3"
        aria-label="{{ block.settings.button_3_text }}"
      >
        {{ block.settings.button_3_text }}
      </button>
    </div>
  </div>
</image-switcher-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageSwitcher{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-image-switcher__button-{{ ai_gen_id }}');
        this.images = this.querySelectorAll('.ai-image-switcher__image-{{ ai_gen_id }}');
        this.placeholders = this.querySelectorAll('.ai-image-switcher__placeholder-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const targetIndex = button.getAttribute('data-image-target');
            this.switchImage(targetIndex);
            this.updateActiveButton(button);
          });
        });
      }

      switchImage(targetIndex) {
        this.images.forEach((image) => {
          const imageIndex = image.getAttribute('data-image-index');
          if (imageIndex === targetIndex) {
            image.classList.add('active');
          } else {
            image.classList.remove('active');
          }
        });

        this.placeholders.forEach((placeholder) => {
          const placeholderIndex = placeholder.getAttribute('data-image-index');
          if (placeholderIndex === targetIndex) {
            placeholder.style.display = 'flex';
          } else {
            placeholder.style.display = 'none';
          }
        });
      }

      updateActiveButton(activeButton) {
        this.buttons.forEach((button) => {
          button.classList.remove('active');
        });
        activeButton.classList.add('active');
      }
    }

    customElements.define('image-switcher-{{ ai_gen_id }}', ImageSwitcher{{ ai_gen_id }});
  })();
</script>

