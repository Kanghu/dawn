        "custom_liquid": "{%- assign locale_code = request.locale.iso_code \n  | default: localization.language.iso_code \n  | default: 'ro' \n  | downcase -%}\n\n{%- assign host = request.host -%}\n{%- assign tld = host | split: '.' | last -%}\n{%- assign base_url = 'https://cdn.shopify.com/s/files/1/0782/5175/3739/files/' -%}\n\n{%- assign desktop_img = '' -%}\n{%- assign mobile_img = '' -%}\n\n{%- case locale_code -%}\n  {%- when 'ro' -%}\n    {%- assign random_seed = 'now' | date: '%S' | plus: 0 -%}\n    {%- assign random_pick = random_seed | modulo: 2 -%}\n\n    {%- if random_pick == 0 -%}\n      {%- assign desktop_img = base_url | append: 'CTA_RO_WIDE.png' -%}\n    {%- else -%}\n      {%- assign desktop_img = base_url | append: 'CTA_RO_WIDE.png' -%}\n    {%- endif -%}\n\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'hu' -%}\n    {%- assign desktop_img = base_url | append: 'CTA_HU_WIDE.png' -%}\n    {%- assign mobile_img  = base_url | append: 'CTA_HU_WIDE.png' -%}\n\n  {%- when 'bg' -%}\n    {%- assign desktop_img = base_url | append: 'CTA_BG_WIDE.png' -%}\n    {%- assign mobile_img  = base_url | append: 'CTA_BG_WIDE.png' -%}\n\n  {%- when 'pl' -%}\n    {%- assign desktop_img = base_url | append: 'CTA_PL_WIDE.png' -%}\n    {%- assign mobile_img  = base_url | append: 'CTA_PL_WIDE.png' -%}\n\n  {%- when 'sk' -%}\n    {%- assign desktop_img = base_url | append: 'CTA_SK_WIDE.png' -%}\n    {%- assign mobile_img  = base_url | append: 'CTA_SK_WIDE.png' -%}\n\n  {%- else -%}\n    {%- assign desktop_img = base_url | append: 'CTA_ENG_WIDE.png' -%}\n    {%- assign mobile_img  = base_url | append: 'CTA_ENG_WIDE.png' -%}\n{%- endcase -%}\n\n{%- assign target_url = 'https://www.alessandrodesign.' | append: tld | append: '/easter-sale' -%}\n\n<a class=\"hp-banner-link\" href=\"{{ target_url }}\" aria-label=\"Homepage Banner\">\n  <picture class=\"hp-banner\">\n    <source media=\"(min-width: 769px)\" srcset=\"{{ desktop_img }}\">\n    <img\n      src=\"{{ mobile_img }}\"\n      alt=\"Homepage Banner\"\n      loading=\"lazy\"\n      decoding=\"async\"\n      class=\"hp-banner__img\"\n      width=\"1920\"\n      height=\"1080\">\n  </picture>\n</a>\n\n<style>\n.hp-banner-link {\n  display: block;\n  width: 100%;\n  text-decoration: none;\n}\n\n.hp-banner {\n  display: block;\n  width: 100%;\n  max-width: 1300px;\n  margin: 0 auto;\n  line-height: 0;\n}\n\n.hp-banner__img {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n/* Mobile full width */\n@media (max-width: 768px) {\n  .hp-banner-link {\n    width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n  }\n\n  .hp-banner {\n    max-width: 100%;\n  }\n}\n}\n</style>",
