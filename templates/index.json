      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign locale_code = request.locale.iso_code\n  | default: localization.language.iso_code\n  | default: 'ro'\n  | downcase -%}\n\n{%- assign host = request.host -%}\n{%- assign tld = host | split: '.' | last -%}\n{%- assign base_url = 'https://cdn.shopify.com/s/files/1/0782/5175/3739/files/' -%}\n\n{%- assign desktop_img = '' -%}\n{%- assign mobile_img = '' -%}\n\n{%- case locale_code -%}\n\n  {%- when 'ro' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_RO.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'hu' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_HU.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'bg' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_BG.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'sk' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_SK.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'fr' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_FR.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- when 'el', 'gr' -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_GR.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n  {%- else -%}\n    {%- assign desktop_img = base_url | append: 'BANNER_IULIE_26_ENG.png' -%}\n    {%- assign mobile_img = desktop_img -%}\n\n{%- endcase -%}\n\n{%- assign target_url = 'https://www.alessandrodesign.' | append: tld | append: '/summer_start_sale' -%}\n\n<a class=\"hp-banner-link\" href=\"{{ target_url }}\" aria-label=\"Homepage Banner\">\n  <picture class=\"hp-banner\">\n    <source media=\"(min-width: 769px)\" srcset=\"{{ desktop_img }}\">\n    <img\n      src=\"{{ mobile_img }}\"\n      alt=\"Homepage Banner\"\n      loading=\"lazy\"\n      decoding=\"async\"\n      class=\"hp-banner__img\"\n      width=\"1920\"\n      height=\"1080\">\n  </picture>\n</a>\n\n<style>\n