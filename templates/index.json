        "custom_liquid": "{%- assign locale_code = request.locale.iso_code | default: localization.language.iso_code | downcase -%}\n\n{%- assign tld = 'ro' -%}\n{%- case locale_code -%}\n  {%- when 'ro' -%}{%- assign tld = 'ro' -%}\n  {%- when 'bg' -%}{%- assign tld = 'bg' -%}\n  {%- when 'hu' -%}{%- assign tld = 'hu' -%}\n  {%- when 'pl' -%}{%- assign tld = 'pl' -%}\n  {%- else -%}{%- assign tld = 'ro' -%}\n{%- endcase -%}\n\n{%- assign bf_url = 'https://www.alessandrodesign.' | append: tld | append: '/collections/black-friday' -%}\n\n<a class=\"bf-video-link page-width\" href=\"{{ bf_url }}\" aria-label=\"Black Friday - {{ locale_code | upcase }}\">\n  <div class=\"bf-video-wrap\">\n    <video\n      class=\"bf-video\"\n      autoplay\n      muted\n      loop\n      playsinline\n      preload=\"auto\"\n    >\n      {%- case locale_code -%}\n        {%- when 'ro' -%}\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/f0bacc41be874d2ba56732a441f82989.mp4\" type=\"video/mp4\">\n        {%- when 'bg' -%}\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/f9b7ffdde1a14320acc680d441c61ccf.mp4\" type=\"video/mp4\">\n        {%- when 'hu' -%}\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/006d60dd3dda418883b63ed4e6ca56c9.mp4\" type=\"video/mp4\">\n        {%- when 'pl' -%}\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/a436ee38e24b4c2db4b9a30d39d0e0fd.mp4\" type=\"video/mp4\">\n        {%- else -%}\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/7fc4c7b3d1f54f59b3823e98fd8da4f2.mp4\" type=\"video/mp4\">\n      {%- endcase -%}\n    </video>\n  </div>\n</a>\n\n<style>\n  .bf-video-link { display: block; text-decoration: none; }\n  .bf-video-wrap {\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    aspect-ratio: 16 / 6; /* crop pe desktop */\n    background: #120a0a; /* fallback */\n    cursor: pointer;\n  }\n  .bf-video {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 100%;\n    height: 100%;\n    min-width: 100%;\n    min-height: 100%;\n    object-fit: cover;\n    transform: translate(-50%, -50%);\n  }\n  @media (max-width: 768px) {\n    .bf-video-wrap { aspect-ratio: 16 / 9; /* revenire full pe mobil */ }\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 0,
