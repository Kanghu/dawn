('data-srcset-default');\n      });\n      const img = document.querySelector('.banner-img');\n      if (img) {\n        img.src = \"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/MOBILE.png?v=1759244654\";\n      }\n    }\n  })();\n</script>",
        "color_scheme": "",
