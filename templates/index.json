<div class=\"custom-benefit-item__text\">Simplu și rapid</div>\n      </div>\n    </div>\n\n    <div class=\"custom-benefit-item\">\n      <div class=\"custom-benefit-item__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M5 14v-2a7 7 0 1 1 14 0v2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          <path d=\"M5 14a2 2 0 0 0 2 2h1v-5H7a2 2 0 0 0-2 2Zm14 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Zm-7 6h2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <div class=\"custom-benefit-item__content\">\n        <div class=\"custom-benefit-item__title\">Suport dedicat</div>\n        <div class=\"custom-benefit-item__text\">Suntem aici pentru tine</div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .custom-benefits-bar {\n    background: #ffffff;\n    margin: 32px 0;\n  }\n\n  .custom-benefits-bar__inner {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    background: #f7f7f7;\n    border: 1px solid #ebebeb;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n\n  .custom-benefit-item {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    padding: 22px 28px;\n    min-height: 92px;\n  }\n\n  .custom-benefit-item:not(:last-child)::after {\n    content: \"\";\n    position: absolute;\n    top: 22%;\n    right: 0;\n    width: 1px;\n    height: 56%;\n    background: #e3e3e3;\n  }\n\n  .custom-benefit-item__icon {\n    width: 34px;\n    height: 34px;\n    min-width: 34px;\n    color: #111111;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .custom-benefit-item__icon svg {\n    width: 34px;\n    height: 34px;\n    display: block;\n  }\n\n  .custom-benefit-item__content {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .custom-benefit-item__title {\n    margin: 0 0 4px;\n    font-size: 20