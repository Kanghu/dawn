      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- assign locale_code = request.locale.iso_code \n  | default: localization.language.iso_code \n  | default: 'ro' \n  | downcase -%}\n\n{%- assign lang = 'ENG' -%}\n{%- assign tld = 'ro' -%}\n\n{%- if locale_code == 'ro' -%}\n  {%- assign lang = 'RO' -%}\n  {%- assign tld = 'ro' -%}\n{%- elsif locale_code == 'hu' -%}\n  {%- assign lang = 'HU' -%}\n  {%- assign tld = 'hu' -%}\n{%- elsif locale_code == 'bg' -%}\n  {%- assign lang = 'BG' -%}\n  {%- assign tld = 'bg' -%}\n{%- elsif locale_code == 'pl' -%}\n  {%- assign lang = 'PL' -%}\n  {%- assign tld = 'pl' -%}\n{%- endif -%}\n\n{%- assign base_url = 'https://cdn.shopify.com/s/files/1/0782/5175/3739/files/' -%}\n{%- assign desktop_img = base_url | append: 'OM_' | append: lang | append: '_DESKTOP.png' -%}\n{%- assign mobile_img  = base_url | append: 'OM_' | append: lang | append: '_MOBILE.png' -%}\n\n{%- assign target_url = 'https://www.alessandrodesign.' | append: tld | append: '/collections/oglinzi-led-machiaj' -%}\n\n<a class=\"om-banner-link\" href=\"{{ target_url }}\" aria-label=\"Oglinzi Machiaj Banner\">\n\n  <picture class=\"om-banner\">\n    <source media=\"(min-width: 769px)\" srcset=\"{{ desktop_img }}\">\n    <img\n      src=\"{{ mobile_img }}\"\n      alt=\"Oglinzi Machiaj Banner\"\n      loading=\"lazy\"\n      decoding=\"async\"\n      class=\"om-banner__img\"\n      width=\"1920\"\n      height=\"1080\">\n  </picture>\n\n</a>\n\n<style>\n.om-banner-link {\n  display:block;\n  text-decoration:none;\n  width:100%;\n}\n\n.om-banner {\n  display:block;\n  width:100%;\n  line-height:0;\n}\n\n.om-banner__img {\n  display:block;\n  width:100%;\n  height:auto;\n}\n\n@media (min-width: 769px) {\n  .om-banner-link {\n    max-width:1300px;\n    margin:0 auto;\n  }\n}\n</style>",
        "color_scheme": "",
        "padding_top": 24,
        "padding_bottom": 0
      }
