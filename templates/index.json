f -%}\n\n</a>\n\n<style>\n.hp-banner-link {\n  display:block;\n  text-decoration:none;\n  width:100%;\n}\n\n.hp-banner {\n  display:block;\n  width:100%;\n  line-height:0;\n}\n\n.hp-banner__img,\n.hp-banner__video {\n  display:block;\n  width:100%;\n  height:auto;\n}\n\n.hp-banner--desktop { display:none; }\n.hp-banner--mobile { display:block; }\n\n@media (min-width: 769px) {\n\n  .hp-banner-link {\n    max-width:1300px;\n    margin:0 auto;\n  }\n\n  .hp-banner--desktop { display:block; }\n  .hp-banner--mobile { display:none; }\n\n}\n</style>",
