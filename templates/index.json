    "custom_liquid_9HGKkC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Countdown Multilingual Responsive Alessandro Design -->\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap\" rel=\"stylesheet\">\n\n{% assign locale = request.locale.iso_code | downcase %}\n\n<div class=\"ad-countdown-wrapper\" \n     data-deadline=\"2025-10-29T23:59:59+02:00\" \n     data-locale=\"{{ locale }}\">\n  <div class=\"ad-countdown-text\"></div>\n  <div class=\"ad-countdown\"></div>\n  <div class=\"ad-countdown-subtext\"></div>\n</div>\n\n<style>\n  .ad-countdown-wrapper {\n    text-align: center;\n    color: #FFD600;\n    font-family: 'Roboto', sans-serif;\n    background: #000;\n    padding: 1.5rem 1rem;\n    border-radius: 12px;\n    box-shadow: 0 0 20px rgba(255,214,0,0.25);\n    max-width: 500px;\n    margin: 1rem auto;\n  }\n\n  .ad-countdown-text {\n    font-weight: 600;\n    font-size: 1rem;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin-bottom: 0.5rem;\n  }\n\n  .ad-countdown {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 1rem;\n  }\n\n  .ad-countdown .itm { text-align: center; min-width: 4ch; }\n  .ad-countdown .val { font-size: 2rem; font-weight: 700; line-height: 1; display: block; }\n  .ad-countdown .lbl { font-size: 0.8rem; opacity: 0.8; text-transform: uppercase; }\n\n  .ad-countdown-subtext {\n    margin-top: 0.75rem;\n    font-weight: 700;\n    font-size: 1.2rem;\n    text-transform: uppercase;\n    color: #fff;\n    letter-spacing: 0.05em;\n  }\n\n  @media (max-width: 600px) {\n    .ad-countdown { gap: 0.5rem; }\n    .ad-countdown .val { font-size: 1.5rem; }\n    .ad-countdown-text { font-size: 0.9rem; }\n    .ad-countdown-subtext { font-size: 1rem; }\n  }\n</style>\n\n<script>\n(function(){\n  function pad(n){return n<10?'0'+n:''+n;}\n\n  const translations = {\n    ro: { days:'Zile', hours:'Ore', minutes:'Minute', seconds:'Secunde', top:'Reducerile continuă pentru:', bottom:'GRĂBEȘTE-TE!' },\n    hu: { days:'Nap', hours:'Óra', minutes:'Perc', seconds:'Másodperc', top:'A kedvezmények elérhetők még:', bottom:'SIESS!' },\n    pl: { days:'Dni', hours:'Godziny', minutes:'Minuty', seconds:'Sekundy', top:'Promocje trwają jeszcze:', bottom:'POSPIESZ SIĘ!' },\n    bg: { days:'Дни', hours:'Часа', minutes:'Минути', seconds:'Секунди', top:'Намаленията продължават още:', bottom:'ПОБЪРЗАЙ!' },\n    en: { days:'Days', hours:'Hours', minutes:'Minutes', seconds:'Seconds', top:'Discounts continue for:', bottom:'HURRY UP!' }\n  };\n\n  document.querySelectorAll('.ad-countdown-wrapper').forEach(function(wrapper){\n    const locale = wrapper.getAttribute('data-locale') || 'en';\n    const t = translations[locale] || translations.en;\n    const root = wrapper.querySelector('.ad-countdown');\n    const deadline = new Date(wrapper.getAttribute('data-deadline'));\n\n    wrapper.querySelector('.ad-countdown-text').textContent = t.top;\n    wrapper.querySelector('.ad-countdown-subtext').textContent = t.bottom;\n\n    root.innerHTML =\n      `<div class=\"itm\"><span class=\"val js-d\">00</span><span class=\"lbl\">${t.days}</span></div>` +\n      `<div class=\"itm\"><span class=\"val js-h\">00</span><span class=\"lbl\">${t.hours}</span></div>` +\n      `<div class=\"itm\"><span class=\"val js-m\">00</span><span class=\"lbl\">${t.minutes}</span></div>` +\n      `<div class=\"itm\"><span class=\"val js-s\">00</span><span class=\"lbl\">${t.seconds}</span></div>`;\n\n    const dEl = root.querySelector('.js-d'),\n          hEl = root.querySelector('.js-h'),\n          mEl = root.querySelector('.js-m'),\n          sEl = root.querySelector('.js-s');\n\n    function tick(){\n      const diff = deadline - new Date();\n      if(diff <= 0){\n        wrapper.querySelector('.ad-countdown-text').textContent = 'Oferta s-a încheiat.';\n        root.innerHTML = '';\n        wrapper.querySelector('.ad-countdown-subtext').textContent = '';\n        clearInterval(timer);\n        return;\n      }\n\n      let s = Math.floor(diff / 1000);\n      const days = Math.floor(s / 86400); s -= days * 86400;\n      const hours = Math.floor(s / 3600); s -= hours * 3600;\n      const minutes = Math.floor(s / 60); s -= minutes * 60;\n\n      dEl.textContent = pad(days);\n      hEl.textContent = pad(hours);\n      mEl.textContent = pad(minutes);\n      sEl.textContent = pad(s);\n    }\n\n    tick();\n    const timer = setInterval(tick, 1000);\n  });\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 4,
        "padding_bottom": 0
      }
    },
