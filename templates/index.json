        "custom_liquid": "<a href=\"https://www.alessandrodesign.ro/collections/black-friday\">\n  <picture>\n    <!-- Bannere pentru domeniul .ro -->\n    <source \n      media=\"(min-width:768px)\" \n      srcset=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/ro_desktop_banner.jpg?v=1760655704\"\n      data-srcset-ro=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/ro_desktop_banner.jpg?v=1760655704\"\n      data-srcset-default=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/BF_BANNER_ENG.png?v=1760639442\"\n      class=\"desktop-banner\">\n    <source \n      media=\"(max-width:767px)\" \n      srcset=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/BF_25_LP_OPTIMIZED.jpg?v=1760646892\"\n      data-srcset-ro=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/BF_25_LP_OPTIMIZED.jpg?v=1760646892\"\n      data-srcset-default=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/BF_BANNER_ENG.png?v=1760639442\"\n      class=\"mobile-banner\">\n    <img \n      src=\"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/BF_25_LP_OPTIMIZED.jpg?v=1760646892\" \n      alt=\"Black Friday Banner\" \n      class=\"banner-img\">\n  </picture>\n</a>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', () => {\n  const hostname = window.location.hostname;\n\n  // 🗺️ Harta domeniilor -> URL colecție\n  const domainMap = {\n    \"alessandrodesign.ro\": \"https://www.alessandrodesign.ro/collections/black-friday\",\n    \"alessandrodesign.bg\": \"https://www.alessandrodesign.bg/collections/black-friday\",\n    \"alessandrodesign.hu\": \"https://www.alessandrodesign.hu/collections/black-friday\",\n    \"alessandrodesign.gr\": \"https://www.alessandrodesign.gr/collections/black-friday\",\n    \"alessandrodesign.pl\": \"https://www.alessandrodesign.pl/collections/black-friday\",\n    \"alessandrodesign.cz\": \"https://www.alessandrodesign.cz/collections/black-friday\",\n    \"alessandrodesign.sk\": \"https://www.alessandrodesign.sk/collections/black-friday\",\n    \"alessandrodesign.hr\": \"https://www.alessandrodesign.hr/collections/black-friday\"\n  };\n\n  // 🧭 Găsește domeniul curent\n  const currentDomain = Object.keys(domainMap).find(d => hostname.endsWith(d));\n  const correctUrl = domainMap[currentDomain] || domainMap[\"alessandrodesign.ro\"];\n\n  // 🔗 Actualizează linkul <a> principal\n  const bannerLink = document.querySelector('a[href*=\"alessandrodesign.ro/collections/black-friday\"]');\n  if (bannerLink) {\n    bannerLink.href = correctUrl;\n  }\n\n  // 🖼️ Schimbă bannerele dacă nu suntem pe .ro\n  const isRO = hostname.endsWith('.ro');\n  if (!isRO) {\n    document.querySelectorAll('.desktop-banner').forEach(el => {\n      el.srcset = el.dataset.srcsetDefault;\n    });\n    document.querySelectorAll('.mobile-banner').forEach(el => {\n      el.srcset = el.dataset.srcsetDefault;\n    });\n\n    const bannerImg = document.querySelector('.banner-img');\n    if (bannerImg) {\n      bannerImg.src = \"https://cdn.shopify.com/s/files/1/0782/5175/3739/files/MOBILE.png?v=1759244654\";\n    }\n  }\n});\n</script>",
