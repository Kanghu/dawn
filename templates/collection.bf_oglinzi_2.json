      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap\" rel=\"stylesheet\">\n{% assign locale = request.locale.iso_code | downcase %}\n\n<div class=\"ad-countdown-card page-width\"\n     data-deadline=\"2025-11-01T23:59:59+02:00\"\n     data-locale=\"{{ locale }}\">\n  <div class=\"ad-countdown-top\"></div>\n\n  <div class=\"ad-countdown-rail\" role=\"timer\" aria-live=\"polite\">\n    <div class=\"itm\"><span class=\"val js-d\">00</span><span class=\"lbl\">Days</span></div>\n    <span class=\"dot\">•</span>\n    <div class=\"itm\"><span class=\"val js-h\">00</span><span class=\"lbl\">Hours</span></div>\n    <span class=\"dot\">•</span>\n    <div class=\"itm\"><span class=\"val js-m\">00</span><span class=\"lbl\">Minutes</span></div>\n    <span class=\"dot\">•</span>\n    <div class=\"itm\"><span class=\"val js-s\">00</span><span class=\"lbl\">Seconds</span></div>\n  </div>\n\n  <div class=\"ad-countdown-bottom\"></div>\n</div>\n\n<style>\n  /* Theme fit */\n  :root{\n    --ad-gold: #ffd977;\n    --ad-gold-strong: #ffcd3c;\n    --ad-bg: #0b0b0b;\n    --ad-bg-2: #1a1208;\n  }\n  .ad-countdown-card{\n    font-family:'Roboto',sans-serif;\n    color:var(--ad-gold);\n    background: radial-gradient(120% 120% at 50% 0%, var(--ad-bg-2) 0%, var(--ad-bg) 55%);\n    border:1px solid rgba(255,217,119,.25);\n    border-radius:20px;\n    padding:18px 22px;\n    margin:18px auto 12px;\n    box-shadow:0 6px 24px rgba(255,205,60,.12), inset 0 0 0 1px rgba(255,217,119,.08);\n    max-width:920px; /* bine încadrat sub hero pe desktop */\n  }\n  .ad-countdown-top{\n    text-align:center;\n    font-weight:700;\n    letter-spacing:.06em;\n    text-transform:uppercase;\n    font-size:14px;\n    color:var(--ad-gold);\n    opacity:.95;\n    margin-bottom:10px;\n  }\n  .ad-countdown-rail{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:14px;\n    padding:10px 14px;\n    border-radius:14px;\n    background: linear-gradient(180deg, rgba(255,217,119,.06), rgba(255,217,119,.02));\n    box-shadow: inset 0 0 0 1px rgba(255,217,119,.10), 0 0 32px rgba(255,205,60,.10);\n  }\n  .ad-countdown-rail .itm{ text-align:center; min-width:5.2ch }\n  .ad-countdown-rail .val{\n    display:block; font-weight:700; line-height:1; font-size:36px;\n    color:var(--ad-gold-strong); text-shadow:0 0 18px rgba(255,205,60,.25);\n  }\n  .ad-countdown-rail .lbl{\n    display:block; font-size:11px; letter-spacing:.08em; text-transform:uppercase; opacity:.8;\n  }\n  .ad-countdown-rail .dot{ opacity:.45; transform:translateY(-2px) }\n\n  .ad-countdown-bottom{\n    margin-top:10px; text-align:center; font-weight:800; color:#fff;\n    text-transform:uppercase; letter-spacing:.06em; font-size:16px;\n  }\n\n  /* Mobile fit */\n  @media (max-width: 640px){\n    .ad-countdown-card{ padding:14px 14px; border-radius:16px; }\n    .ad-countdown-rail{ gap:10px; padding:8px 10px; }\n    .ad-countdown-rail .val{ font-size:24px; }\n    .ad-countdown-rail .lbl{ font-size:10px; }\n    .ad-countdown-bottom{ font-size:14px; }\n  }\n</style>\n\n<script>\n(function(){\n  function pad(n){return n<10?'0'+n:''+n;}\n  const i18n = {\n    ro:{top:'Reducerile vor fi schimbate in...', bottom:'GRĂBEȘTE-TE!', d:'Zile', h:'Ore', m:'Minute', s:'Secunde', ended:'Oferta s-a încheiat.'},\n    hu:{top:'A kedvezmények elérhetők még:', bottom:'SIESS!', d:'Nap', h:'Óra', m:'Perc', s:'Másodperc', ended:'Az ajánlat lejárt.'},\n    pl:{top:'Promocje trwają jeszcze:', bottom:'POSPIESZ SIĘ!', d:'Dni', h:'Godziny', m:'Minuty', s:'Sekundy', ended:'Oferta zakończona.'},\n    bg:{top:'Намаленията продължават още:', bottom:'ПОБЪРЗАЙ!', d:'Дни', h:'Часа', m:'Минути', s:'Секунди', ended:'Офертата приключи.'},\n    en:{top:'Discounts continue for:', bottom:'HURRY UP!', d:'Days', h:'Hours', m:'Minutes', s:'Seconds', ended:'The offer has ended.'}\n  };\n\n  document.querySelectorAll('.ad-countdown-card').forEach(function(card){\n    const locale = (card.getAttribute('data-locale')||'en').toLowerCase();\n    const t = i18n[locale] || i18n.en;\n    const deadline = new Date(card.getAttribute('data-deadline'));\n\n    // inject labels\n    card.querySelector('.ad-countdown-top').textContent = t.top;\n    card.querySelectorAll('.ad-countdown-rail .itm .lbl')[0].textContent = t.d;\n    card.querySelectorAll('.ad-countdown-rail .itm .lbl')[1].textContent = t.h;\n    card.querySelectorAll('.ad-countdown-rail .itm .lbl')[2].textContent = t.m;\n    card.querySelectorAll('.ad-countdown-rail .itm .lbl')[3].textContent = t.s;\n    card.querySelector('.ad-countdown-bottom').textContent = t.bottom;\n\n    const dEl = card.querySelector('.js-d'),\n          hEl = card.querySelector('.js-h'),\n          mEl = card.querySelector('.js-m'),\n          sEl = card.querySelector('.js-s');\n\n    function tick(){\n      const now = new Date();\n      const diff = deadline - now;\n      if (isNaN(deadline)) { console.warn('Invalid deadline'); return; }\n\n      if (diff <= 0){\n        card.querySelector('.ad-countdown-top').textContent = t.ended;\n        card.querySelector('.ad-countdown-rail').style.display='none';\n        card.querySelector('.ad-countdown-bottom').textContent = '';\n        clearInterval(timer); return;\n      }\n      let s = Math.floor(diff/1000);\n      const d = Math.floor(s/86400); s -= d*86400;\n      const h = Math.floor(s/3600); s -= h*3600;\n      const m = Math.floor(s/60);   s -= m*60;\n\n      dEl.textContent = pad(d);\n      hEl.textContent = pad(h);\n      mEl.textContent = pad(m);\n      sEl.textContent = pad(s);\n    }\n    tick();\n    const timer = setInterval(tick,1000);\n  });\n})();\n</script>",
