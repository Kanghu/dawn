{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .temp-showcase-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    padding: 32px 16px;
    box-sizing: border-box;
  }

  .temp-showcase__inner-{{ ai_gen_id }} {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(360px, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: clamp(18px, 4vw, {{ block.settings.container_padding }}px);
    box-sizing: border-box;
  }

  .temp-showcase__media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .temp-showcase__image-{{ ai_gen_id }},
  .temp-showcase__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .temp-showcase__image-{{ ai_gen_id }} {
    object-fit: cover;
    opacity: 0;
    transition: opacity .32s ease;
    will-change: opacity;
  }

  .temp-showcase__image-{{ ai_gen_id }}.is-active {
    opacity: 1;
  }

  .temp-showcase__placeholder-{{ ai_gen_id }} {
    background: {{ block.settings.image_background }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .temp-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 55%;
    height: 55%;
    opacity: .22;
  }

  .temp-showcase__panel-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .temp-showcase__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-size: 12px;
    line-height: 1;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 700;
    color: {{ block.settings.subtitle_color }};
    opacity: .55;
  }

  .temp-showcase__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.title_color }};
    font-size: clamp(30px, 4vw, {{ block.settings.title_font_size }}px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    font-weight: 750;
  }

  .temp-showcase__subtitle-{{ ai_gen_id }} {
    margin: 16px 0 0;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_font_size }}px;
    line-height: 1.6;
    opacity: .72;
    max-width: 420px;
  }

  .temp-showcase__options-{{ ai_gen_id }} {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0,0,0,.12);
  }

  .temp-showcase__option-{{ ai_gen_id }} {
    appearance: none;
    border: 0;
    border-bottom: 1px solid rgba(0,0,0,.12);
    background: transparent;
    padding: 18px 0;
    cursor: pointer;
    display: grid;
    grid-template-columns: 22px 1fr auto;
    gap: 14px;
    align-items: center;
    text-align: left;
    color: {{ block.settings.button_text_color }};
  }

  .temp-showcase__radio-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    position: relative;
    opacity: .45;
  }

  .temp-showcase__option-{{ ai_gen_id }}.is-active .temp-showcase__radio-{{ ai_gen_id }} {
    opacity: 1;
  }

  .temp-showcase__option-{{ ai_gen_id }}.is-active .temp-showcase__radio-{{ ai_gen_id }}::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 999px;
    background: currentColor;
  }

  .temp-showcase__label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.button_label_size }}px;
    line-height: 1.25;
    font-weight: 650;
    opacity: .62;
    transition: opacity .2s ease;
  }

  .temp-showcase__desc-{{ ai_gen_id }} {
    display: block;
    margin-top: 5px;
    font-size: {{ block.settings.button_desc_size }}px;
    line-height: 1.35;
    opacity: .48;
    transition: opacity .2s ease;
  }

  .temp-showcase__temp-{{ ai_gen_id }} {
    font-size: {{ block.settings.temp_badge_size }}px;
    font-weight: 750;
    letter-spacing: -0.03em;
    opacity: .48;
    white-space: nowrap;
    transition: opacity .2s ease;
  }

  .temp-showcase__option-{{ ai_gen_id }}.is-active .temp-showcase__label-{{ ai_gen_id }},
  .temp-showcase__option-{{ ai_gen_id }}.is-active .temp-showcase__temp-{{ ai_gen_id }} {
    opacity: 1;
  }

  .temp-showcase__option-{{ ai_gen_id }}.is-active .temp-showcase__desc-{{ ai_gen_id }} {
    opacity: .72;
  }

  .temp-showcase__option-{{ ai_gen_id }}:hover .temp-showcase__label-{{ ai_gen_id }},
  .temp-showcase__option-{{ ai_gen_id }}:hover .temp-showcase__temp-{{ ai_gen_id }} {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .temp-showcase__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .temp-showcase__media-{{ ai_gen_id }} {
      max-width: 620px;
      margin: 0 auto;
    }

    .temp-showcase__panel-{{ ai_gen_id }} {
      max-width: 620px;
      width: 100%;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 749px) {
    .temp-showcase-{{ ai_gen_id }} {
      padding: 20px 12px;
    }

    .temp-showcase__inner-{{ ai_gen_id }} {
      padding: 14px;
      border-radius: 18px;
    }

    .temp-showcase__subtitle-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .temp-showcase__options-{{ ai_gen_id }} {
      margin-top: 24px;
    }

    .temp-showcase__option-{{ ai_gen_id }} {
      padding: 15px 0;
      grid-template-columns: 18px 1fr auto;
      gap: 10px;
    }

    .temp-showcase__desc-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<temperature-showcase-{{ ai_gen_id }} class="temp-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="temp-showcase__inner-{{ ai_gen_id }}">
    <div class="temp-showcase__media-{{ ai_gen_id }}">
      {% if block.settings.image_3000k %}
        <img
          src="{{ block.settings.image_3000k | image_url: width: 1400 }}"
          alt="{{ block.settings.image_3000k.alt | escape }}"
          loading="lazy"
          class="temp-showcase__image-{{ ai_gen_id }} is-active"
          data-temp="3000"
        >
      {% else %}
        <div class="temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="3000">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.image_4500k %}
        <img
          src="{{ block.settings.image_4500k | image_url: width: 1400 }}"
          alt="{{ block.settings.image_4500k.alt | escape }}"
          loading="lazy"
          class="temp-showcase__image-{{ ai_gen_id }}"
          data-temp="4500"
        >
      {% else %}
        <div class="temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="4500" style="display: none;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.image_6000k %}
        <img
          src="{{ block.settings.image_6000k | image_url: width: 1400 }}"
          alt="{{ block.settings.image_6000k.alt | escape }}"
          loading="lazy"
          class="temp-showcase__image-{{ ai_gen_id }}"
          data-temp="6000"
        >
      {% else %}
        <div class="temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="6000" style="display: none;">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="temp-showcase__panel-{{ ai_gen_id }}">
      <p class="temp-showcase__eyebrow-{{ ai_gen_id }}">Temperatura luminii</p>

      {% if block.settings.title != blank %}
        <h2 class="temp-showcase__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.subtitle != blank %}
        <p class="temp-showcase__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}

      <div class="temp-showcase__options-{{ ai_gen_id }}">
        <button class="temp-showcase__option-{{ ai_gen_id }} is-active" type="button" data-temp="3000" aria-label="3000K">
          <span class="temp-showcase__radio-{{ ai_gen_id }}"></span>
          <span>
            <span class="temp-showcase__label-{{ ai_gen_id }}">{{ block.settings.label_3000k }}</span>
            <span class="temp-showcase__desc-{{ ai_gen_id }}">{{ block.settings.desc_3000k }}</span>
          </span>
          <span class="temp-showcase__temp-{{ ai_gen_id }}">3000K</span>
        </button>

        <button class="temp-showcase__option-{{ ai_gen_id }}" type="button" data-temp="4500" aria-label="4500K">
          <span class="temp-showcase__radio-{{ ai_gen_id }}"></span>
          <span>
            <span class="temp-showcase__label-{{ ai_gen_id }}">{{ block.settings.label_4500k }}</span>
            <span class="temp-showcase__desc-{{ ai_gen_id }}">{{ block.settings.desc_4500k }}</span>
          </span>
          <span class="temp-showcase__temp-{{ ai_gen_id }}">4500K</span>
        </button>

        <button class="temp-showcase__option-{{ ai_gen_id }}" type="button" data-temp="6000" aria-label="6000K">
          <span class="temp-showcase__radio-{{ ai_gen_id }}"></span>
          <span>
            <span class="temp-showcase__label-{{ ai_gen_id }}">{{ block.settings.label_6000k }}</span>
            <span class="temp-showcase__desc-{{ ai_gen_id }}">{{ block.settings.desc_6000k }}</span>
          </span>
          <span class="temp-showcase__temp-{{ ai_gen_id }}">6000K</span>
        </button>
      </div>
    </div>
  </div>
</temperature-showcase-{{ ai_gen_id }}>

<script>
  (() => {
    class TemperatureShowcase{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.options = this.querySelectorAll('.temp-showcase__option-{{ ai_gen_id }}');
        this.images = this.querySelectorAll('.temp-showcase__image-{{ ai_gen_id }}');
        this.placeholders = this.querySelectorAll('.temp-showcase__placeholder-{{ ai_gen_id }}');

        this.options.forEach(option => {
          option.addEventListener('click', () => {
            const selectedTemp = option.dataset.temp;

            this.options.forEach(item => {
              item.classList.toggle('is-active', item === option);
            });

            this.images.forEach(image => {
              image.classList.toggle('is-active', image.dataset.temp === selectedTemp);
            });

            this.placeholders.forEach(placeholder => {
              placeholder.style.display = placeholder.dataset.temp === selectedTemp ? 'flex' : 'none';
            });
          });
        });
      }
    }

    customElements.define('temperature-showcase-{{ ai_gen_id }}', TemperatureShowcase{{ ai_gen_id }});
  })();
</script>

