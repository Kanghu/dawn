{% doc %}
  @prompt
    Temperature showcase 3000K / 4500K / 6000K. Imagine în stânga, text și butoane în dreapta. Max width 1300px.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-temp-showcase-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    padding: 24px 16px;
    box-sizing: border-box;
  }

  .ai-temp-showcase__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: clamp(20px, 4vw, {{ block.settings.container_padding }}px);
    display: grid;
    grid-template-columns: minmax(320px, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(22px, 4vw, {{ block.settings.grid_gap }}px);
    align-items: center;
    box-shadow: 0 18px 50px rgba(0,0,0,0.06);
    overflow: hidden;
    box-sizing: border-box;
  }

  .ai-temp-showcase__image-area-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.06);
  }

  .ai-temp-showcase__image-{{ ai_gen_id }},
  .ai-temp-showcase__placeholder-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-temp-showcase__image-{{ ai_gen_id }} {
    object-fit: cover;
    opacity: 0;
    transform: scale(1.025);
    transition: opacity {{ block.settings.transition_duration }}s ease, transform .7s ease;
  }

  .ai-temp-showcase__image-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1);
  }

  .ai-temp-showcase__placeholder-{{ ai_gen_id }} {
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-temp-showcase__placeholder-{{ ai_gen_id }} svg {
    width: 55%;
    height: 55%;
    opacity: .25;
  }

  .ai-temp-showcase__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .ai-temp-showcase__eyebrow-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .65;
    margin: 0 0 8px;
    color: {{ block.settings.subtitle_color }};
    font-weight: 600;
  }

  .ai-temp-showcase__title-{{ ai_gen_id }} {
    font-size: clamp(28px, 4vw, {{ block.settings.title_font_size }}px);
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 700;
    line-height: 1.05;
  }

  .ai-temp-showcase__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 12px 0 0;
    opacity: 0.78;
    line-height: 1.55;
    max-width: 460px;
  }

  .ai-temp-showcase__controls-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }} {
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding }}px;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    text-align: left;
    transition: transform .25s ease, border-color .25s ease, background .25s ease, box-shadow .25s ease;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    border-color: {{ block.settings.button_hover_border_color }};
    box-shadow: 0 10px 28px rgba(0,0,0,0.07);
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active {
    background: {{ block.settings.button_active_background }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_background }};
    box-shadow: 0 14px 34px rgba(0,0,0,0.12);
  }

  .ai-temp-showcase__dot-{{ ai_gen_id }} {
    width: {{ block.settings.indicator_size | times: 2 }}px;
    height: {{ block.settings.indicator_size | times: 2 }}px;
    border-radius: 999px;
    background: rgba(0,0,0,.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .ai-temp-showcase__button-{{ ai_gen_id }}.active .ai-temp-showcase__dot-{{ ai_gen_id }} {
    background: rgba(255,255,255,.18);
  }

  .ai-temp-showcase__button-label-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.button_label_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-temp-showcase__button-desc-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.button_desc_size }}px;
    opacity: .68;
    margin-top: 4px;
    line-height: 1.35;
  }

  .ai-temp-showcase__button-temp-{{ ai_gen_id }} {
    font-size: {{ block.settings.temp_badge_size }}px;
    font-weight: 800;
    letter-spacing: -.03em;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    .ai-temp-showcase__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-temp-showcase__image-area-{{ ai_gen_id }} {
      order: 1;
      max-width: 620px;
      width: 100%;
      margin: 0 auto;
    }

    .ai-temp-showcase__content-{{ ai_gen_id }} {
      order: 2;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-temp-showcase-{{ ai_gen_id }} {
      padding: 16px 12px;
    }

    .ai-temp-showcase__container-{{ ai_gen_id }} {
      border-radius: 18px;
      padding: 16px;
      gap: 18px;
    }

    .ai-temp-showcase__button-{{ ai_gen_id }} {
      padding: 13px;
    }

    .ai-temp-showcase__dot-{{ ai_gen_id }} {
      width: 28px;
      height: 28px;
      font-size: 11px;
    }

    .ai-temp-showcase__button-desc-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<temp-showcase-{{ ai_gen_id }} class="ai-temp-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-temp-showcase__container-{{ ai_gen_id }}">
    <div class="ai-temp-showcase__image-area-{{ ai_gen_id }}">
      {% if block.settings.image_3000k %}
        <img src="{{ block.settings.image_3000k | image_url: width: 1300 }}" class="ai-temp-showcase__image-{{ ai_gen_id }} active" data-temp="3000" loading="lazy" alt="{{ block.settings.image_3000k.alt | escape }}">
      {% else %}
        <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="3000">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}

      {% if block.settings.image_4500k %}
        <img src="{{ block.settings.image_4500k | image_url: width: 1300 }}" class="ai-temp-showcase__image-{{ ai_gen_id }}" data-temp="4500" loading="lazy" alt="{{ block.settings.image_4500k.alt | escape }}">
      {% else %}
        <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="4500" style="display:none;">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}

      {% if block.settings.image_6000k %}
        <img src="{{ block.settings.image_6000k | image_url: width: 1300 }}" class="ai-temp-showcase__image-{{ ai_gen_id }}" data-temp="6000" loading="lazy" alt="{{ block.settings.image_6000k.alt | escape }}">
      {% else %}
        <div class="ai-temp-showcase__placeholder-{{ ai_gen_id }}" data-temp="6000" style="display:none;">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endif %}
    </div>

    <div class="ai-temp-showcase__content-{{ ai_gen_id }}">
      <div>
        <p class="ai-temp-showcase__eyebrow-{{ ai_gen_id }}">Temperatura luminii</p>

        {% if block.settings.title != blank %}
          <h2 class="ai-temp-showcase__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}

        {% if block.settings.subtitle != blank %}
          <p class="ai-temp-showcase__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="ai-temp-showcase__controls-{{ ai_gen_id }}">
        <button class="ai-temp-showcase__button-{{ ai_gen_id }} active" data-temp="3000" type="button">
          <span class="ai-temp-showcase__dot-{{ ai_gen_id }}">1</span>
          <span>
            <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_3000k }}</span>
            <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_3000k }}</span>
          </span>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">3000K</span>
        </button>

        <button class="ai-temp-showcase__button-{{ ai_gen_id }}" data-temp="4500" type="button">
          <span class="ai-temp-showcase__dot-{{ ai_gen_id }}">2</span>
          <span>
            <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_4500k }}</span>
            <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_4500k }}</span>
          </span>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">4500K</span>
        </button>

        <button class="ai-temp-showcase__button-{{ ai_gen_id }}" data-temp="6000" type="button">
          <span class="ai-temp-showcase__dot-{{ ai_gen_id }}">3</span>
          <span>
            <span class="ai-temp-showcase__button-label-{{ ai_gen_id }}">{{ block.settings.label_6000k }}</span>
            <span class="ai-temp-showcase__button-desc-{{ ai_gen_id }}">{{ block.settings.desc_6000k }}</span>
          </span>
          <span class="ai-temp-showcase__button-temp-{{ ai_gen_id }}">6000K</span>
        </button>
      </div>
    </div>
  </div>
</temp-showcase-{{ ai_gen_id }}>

<script>
  (() => {
    class TempShowcase{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-temp-showcase__button-{{ ai_gen_id }}');
        this.images = this.querySelectorAll('.ai-temp-showcase__image-{{ ai_gen_id }}');
        this.placeholders = this.querySelectorAll('.ai-temp-showcase__placeholder-{{ ai_gen_id }}');

        this.buttons.forEach(button => {
          button.addEventListener('click', () => {
            const temp = button.dataset.temp;

            this.buttons.forEach(item => item.classList.toggle('active', item === button));
            this.images.forEach(image => image.classList.toggle('active', image.dataset.temp === temp));

            this.placeholders.forEach(item => {
              item.style.display = item.dataset.temp === temp ? 'flex' : 'none';
            });
          });
        });
      }
    }

    customElements.define('temp-showcase-{{ ai_gen_id }}', TempShowcase{{ ai_gen_id }});
  })();
</script>

