{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collections-slider-{{ ai_gen_id }} {
    display: block;
    max-width: {{ settings.page_width }}px;
    margin: {{ block.settings.section_spacing }}px auto;
    font-family: var(--font-body-family);
    width: {{ block.settings.desktop_width_percent }}%;
    position: relative;
  }

  .ai-collections-header-{{ ai_gen_id }} {
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-collections-header-{{ ai_gen_id }} h1,
  .ai-collections-header-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-family: var(--font-body-family);
    line-height: 1.2;
  }

  .ai-collections-header-{{ ai_gen_id }} p {
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
  }

  .ai-collections-slider-shell-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-collections-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0 {{ settings.spacing_grid_horizontal }}px {{ block.settings.scrollbar_spacing }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    user-select: none;
    cursor: grab;
  }

  .ai-collections-track-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .ai-collections-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    flex: 0 0 {{ block.settings.card_width }}px;
    width: {{ block.settings.card_width }}px;
    height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    color: {{ block.settings.card_text_color }};
    background: #000;
    transition: transform {{ block.settings.hover_duration }}s ease, box-shadow {{ block.settings.hover_duration }}s ease;
    display: block;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-collection-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      {{ block.settings.overlay_bottom_color }} 0%,
      {{ block.settings.overlay_middle_color }} {{ block.settings.overlay_middle_position }}%,
      {{ block.settings.overlay_top_color }} {{ block.settings.overlay_top_position }}%
    );
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-collection-card-content-{{ ai_gen_id }} h3 {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.card_text_color }};
    line-height: 1.2;
  }

  .ai-collection-card-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.description_spacing }}px;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.4;
  }

  .ai-collection-card-cta-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_size }}px;
    color: {{ block.settings.cta_color }};
    font-weight: {{ block.settings.cta_weight }};
  }

  .ai-collections-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 5;
    pointer-events: none;
  }

  .ai-collections-nav-inner-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
  }

  .ai-collections-arrow-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.08);
    background: rgba(255,255,255,0.95);
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
  }

  .ai-collections-arrow-{{ ai_gen_id }}:hover {
    transform: scale(1.04);
  }

  .ai-collections-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .ai-collections-arrow-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-collections-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 8px {{ settings.spacing_grid_horizontal }}px 0;
  }

  .ai-collections-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(0,0,0,0.18);
    transition: transform 0.2s ease, background 0.2s ease;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .ai-collections-dot-{{ ai_gen_id }}.is-active {
    background: rgba(0,0,0,0.65);
    transform: scale(1.2);
  }

  @media (max-width: 989px) {
    .ai-collection-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_tablet }}px;
      width: {{ block.settings.card_width_tablet }}px;
      height: {{ block.settings.card_height_tablet }}px;
    }

    .ai-collections-arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 749px) {
    .ai-collections-slider-{{ ai_gen_id }} {
      margin: {{ block.settings.section_spacing_mobile }}px 0;
      width: 100%;
    }

    .ai-collection-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}%;
      width: {{ block.settings.card_width_mobile }}%;
      height: {{ block.settings.card_height_mobile }}px;
    }

    .ai-collections-header-{{ ai_gen_id }} h1,
    .ai-collections-header-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-collections-header-{{ ai_gen_id }} p {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-collections-nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<collections-slider-{{ ai_gen_id }} class="ai-collections-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign default_heading = 'sections.collections_slider.heading' | t
    assign default_subheading = 'sections.collections_slider.subheading' | t
    assign default_cta = 'sections.collections_slider.cta' | t
    assign prev_label = 'sections.collections_slider.prev' | t
    assign next_label = 'sections.collections_slider.next' | t
    assign go_to_slide_label = 'sections.collections_slider.go_to_slide' | t
  %}

  {%- liquid
    comment
      The home page has no other h1 (the logo h1 was dropped for SEO), so this block's heading is the document h1 there. Elsewhere it stays an h2.
    endcomment
    assign heading_tag = 'h2'
    if request.page_type == 'index'
      assign heading_tag = 'h1'
    endif
  -%}
  <div class="ai-collections-header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <{{ heading_tag }}>{{ block.settings.heading }}</{{ heading_tag }}>
    {% else %}
      <{{ heading_tag }}>{{ default_heading }}</{{ heading_tag }}>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p>{{ block.settings.subheading }}</p>
    {% else %}
      <p>{{ default_subheading }}</p>
    {% endif %}
  </div>

  <div class="ai-collections-slider-shell-{{ ai_gen_id }}">
    <div class="ai-collections-nav-{{ ai_gen_id }}">
      <div class="ai-collections-nav-inner-{{ ai_gen_id }}">
        <button
          type="button"
          class="ai-collections-arrow-{{ ai_gen_id }}"
          data-prev
          aria-label="{{ prev_label }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button
          type="button"
          class="ai-collections-arrow-{{ ai_gen_id }}"
          data-next
          aria-label="{{ next_label }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-collections-track-{{ ai_gen_id }}" data-track>
      {% for i in (1..5) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign title_key = 'collection_' | append: i | append: '_title'
          assign description_key = 'collection_' | append: i | append: '_description'
          assign image_key = 'collection_' | append: i | append: '_image'
          assign cta_key = 'collection_' | append: i | append: '_cta'

          assign collection = block.settings[collection_key]
          assign custom_title = block.settings[title_key]
          assign custom_description = block.settings[description_key]
          assign custom_image = block.settings[image_key]
          assign custom_cta = block.settings[cta_key]

          assign locale_title_key = 'sections.collections_slider.cards.card_' | append: i | append: '.title'
          assign locale_description_key = 'sections.collections_slider.cards.card_' | append: i | append: '.description'
          assign locale_cta_key = 'sections.collections_slider.cards.card_' | append: i | append: '.cta'

          assign translated_title = locale_title_key | t
          assign translated_description = locale_description_key | t
          assign translated_cta = locale_cta_key | t

          if collection != blank
            assign collection_url = collection.url
            assign collection_title = collection.title
            assign collection_image = collection.featured_image
          else
            assign collection_url = '#'
            assign collection_title = ''
            assign collection_image = null
          endif

          if custom_title != blank
            assign display_title = custom_title
          elsif translated_title != locale_title_key
            assign display_title = translated_title
          else
            assign display_title = collection_title
          endif

          if custom_description != blank
            assign display_description = custom_description
          elsif translated_description != locale_description_key
            assign display_description = translated_description
          else
            assign display_description = blank
          endif

          if custom_image != blank
            assign display_image = custom_image
          else
            assign display_image = collection_image
          endif

          if custom_cta != blank
            assign display_cta = custom_cta
          elsif translated_cta != locale_cta_key
            assign display_cta = translated_cta
          else
            assign display_cta = default_cta
          endif
        %}

        <a href="{{ collection_url }}" class="ai-collection-card-{{ ai_gen_id }}" data-card>
          {% if display_image %}
            <img
              src="{{ display_image | image_url: width: 600 }}"
              alt="{% if display_title != blank %}{{ display_title | escape }}{% elsif display_image.alt != blank %}{{ display_image.alt | escape }}{% else %}Collection image{% endif %}"
              loading="lazy"
              width="600"
              height="800"
            >
          {% else %}
            <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-collection-card-overlay-{{ ai_gen_id }}"></div>
          <div class="ai-collection-card-content-{{ ai_gen_id }}">
            {% if display_title != blank %}
              <h3>{{ display_title }}</h3>
            {% endif %}
            {% if display_description != blank %}
              <p>{{ display_description }}</p>
            {% endif %}
            <span class="ai-collection-card-cta-{{ ai_gen_id }}">{{ display_cta }}</span>
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="ai-collections-dots-{{ ai_gen_id }}" data-dots></div>
  </div>
</collections-slider-{{ ai_gen_id }}>

<script>
  (() => {
    // Reworked for performance: every layout read (widths, scrollWidth, offsets)
    // happens in a single measure() pass, is cached, and is refreshed only when
    // the track actually resizes. Scroll and drag handlers never read layout,
    // they only write, so the browser is never forced into a synchronous reflow.
    class CollectionsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.dotsWrap = this.querySelector('[data-dots]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));

        this.dots = [];
        this.step = 0;
        this.maxScrollLeft = 0;
        this.maxIndex = 0;
        this.currentIndex = -1;
        this.trackScrollLeft = 0;

        this.isDown = false;
        this.startX = 0;
        this.dragStartScroll = 0;
        this.hasMoved = false;

        this.scrollFrame = 0;
        this.measureFrame = 0;
        this.resizeObserver = null;

        this.onScroll = this.onScroll.bind(this);
        this.scheduleMeasure = this.scheduleMeasure.bind(this);
      }

      connectedCallback() {
        if (!this.track || !this.cards.length) return;
        this.bindEvents();
        this.scheduleMeasure();
      }

      disconnectedCallback() {
        if (this.resizeObserver) this.resizeObserver.disconnect();
        else window.removeEventListener('resize', this.scheduleMeasure);
        cancelAnimationFrame(this.scrollFrame);
        cancelAnimationFrame(this.measureFrame);
      }

      // Coalesce measurement requests into one per frame.
      scheduleMeasure() {
        if (this.measureFrame) return;
        this.measureFrame = requestAnimationFrame(() => {
          this.measureFrame = 0;
          this.measure();
        });
      }

      // The only place that reads layout. All reads first, all writes after.
      measure() {
        const track = this.track;
        const first = this.cards[0];
        const second = this.cards[1];

        const clientWidth = track.clientWidth;
        const scrollWidth = track.scrollWidth;
        const scrollLeft = track.scrollLeft;
        let step = second ? second.offsetLeft - first.offsetLeft : first.offsetWidth;
        if (!step || step < 0) step = clientWidth || 1;

        this.step = step;
        this.trackScrollLeft = scrollLeft;
        this.maxScrollLeft = Math.max(0, scrollWidth - clientWidth);
        this.maxIndex = Math.max(0, Math.round(this.maxScrollLeft / step));

        this.syncDots();
        this.render();
      }

      // Rebuild the dots only when their count changes.
      syncDots() {
        if (!this.dotsWrap) return;
        const total = this.maxIndex + 1;
        if (this.dots.length === total) return;

        const frag = document.createDocumentFragment();
        for (let i = 0; i < total; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ai-collections-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', '{{ go_to_slide_label }} ' + (i + 1));
          dot.addEventListener('click', () => this.scrollToIndex(i));
          frag.appendChild(dot);
        }
        this.dotsWrap.replaceChildren(frag);
        this.dots = Array.from(this.dotsWrap.children);
        this.dotsWrap.style.display = total <= 1 ? 'none' : 'flex';
        this.currentIndex = -1;
      }

      // Pure writes, driven by the cached scroll position.
      render() {
        const index = this.step ? Math.round(this.trackScrollLeft / this.step) : 0;

        if (index !== this.currentIndex) {
          this.currentIndex = index;
          for (let i = 0; i < this.dots.length; i++) {
            this.dots[i].classList.toggle('is-active', i === index);
          }
        }

        if (this.prevBtn && this.nextBtn) {
          const canScroll = this.maxIndex > 0;
          this.prevBtn.disabled = !canScroll || index <= 0;
          this.nextBtn.disabled = !canScroll || index >= this.maxIndex;
        }
      }

      onScroll() {
        if (this.scrollFrame) return;
        this.scrollFrame = requestAnimationFrame(() => {
          this.scrollFrame = 0;
          this.trackScrollLeft = this.track.scrollLeft;
          this.render();
        });
      }

      scrollToIndex(index) {
        const safeIndex = Math.max(0, Math.min(index, this.maxIndex));
        this.track.scrollTo({ left: safeIndex * this.step, behavior: 'smooth' });
      }

      bindEvents() {
        const track = this.track;

        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.scrollToIndex(this.currentIndex - 1));
        }
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.scrollToIndex(this.currentIndex + 1));
        }

        track.addEventListener('scroll', this.onScroll, { passive: true });

        if ('ResizeObserver' in window) {
          this.resizeObserver = new ResizeObserver(this.scheduleMeasure);
          this.resizeObserver.observe(track);
        } else {
          window.addEventListener('resize', this.scheduleMeasure);
        }

        // Mouse drag: read the position once on mousedown, write only on move.
        track.addEventListener('mousedown', (e) => {
          this.isDown = true;
          this.hasMoved = false;
          this.startX = e.pageX;
          this.dragStartScroll = track.scrollLeft;
          track.classList.add('is-dragging');
        });

        const endDrag = () => {
          if (!this.isDown) return;
          this.isDown = false;
          track.classList.remove('is-dragging');
        };
        track.addEventListener('mouseleave', endDrag);
        track.addEventListener('mouseup', endDrag);

        track.addEventListener('mousemove', (e) => {
          if (!this.isDown) return;
          e.preventDefault();
          const walk = (e.pageX - this.startX) * 1.2;
          if (Math.abs(walk) > 4) this.hasMoved = true;
          track.scrollLeft = this.dragStartScroll - walk;
        });

        track.addEventListener('click', (e) => {
          if (this.hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            this.hasMoved = false;
          }
        }, true);

        track.addEventListener('wheel', (e) => {
          if (this.maxScrollLeft > 0 && window.innerWidth > 749 && Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            e.preventDefault();
            track.scrollLeft += e.deltaY;
          }
        }, { passive: false });
      }
    }

    if (!customElements.get('collections-slider-{{ ai_gen_id }}')) {
      customElements.define('collections-slider-{{ ai_gen_id }}', CollectionsSlider{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Collections slider",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading override"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#6f6f6f"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Subheading spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_spacing_mobile",
      "label": "Section spacing (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "scrollbar_spacing",
      "label": "Scrollbar spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (desktop)",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 270
    },
