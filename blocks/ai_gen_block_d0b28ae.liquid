{% style %}
  .ai-collections-slider-{{ ai_gen_id }} {
    display: block;
    max-width: {{ settings.page_width }}px;
    margin: {{ block.settings.section_spacing }}px auto;
    font-family: 'Roboto', sans-serif;
    width: {{ block.settings.desktop_width_percent }}%;
    position: relative;
  }

  .ai-collections-header-{{ ai_gen_id }} {
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-collections-header-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-family: 'Roboto', sans-serif;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .ai-collections-header-{{ ai_gen_id }} p {
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.45;
  }

  .ai-collections-header-accent-{{ ai_gen_id }} {
    width: 52px;
    height: 3px;
    border-radius: 999px;
    margin-top: 10px;
    background: linear-gradient(90deg, #caa14a 0%, #e6c16a 100%);
  }

  .ai-collections-slider-shell-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-collections-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0 {{ settings.spacing_grid_horizontal }}px {{ block.settings.scrollbar_spacing }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    user-select: none;
    cursor: grab;
  }

  .ai-collections-track-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .ai-collections-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    flex: 0 0 {{ block.settings.card_width }}px;
    width: {{ block.settings.card_width }}px;
    height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    color: {{ block.settings.card_text_color }};
    background: #000;
    transition:
      transform {{ block.settings.hover_duration }}s ease,
      box-shadow {{ block.settings.hover_duration }}s ease,
      filter {{ block.settings.hover_duration }}s ease;
    display: block;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    isolation: isolate;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px rgba(0,0,0,0.18);
    filter: saturate(1.03);
  }

  .ai-collection-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transform: scale(1);
    transition: transform 0.6s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover img {
    transform: scale(1.04);
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(0,0,0,0.94) 0%,
        rgba(0,0,0,0.84) 18%,
        rgba(0,0,0,0.58) 40%,
        rgba(0,0,0,0.24) 66%,
        rgba(0,0,0,0.06) 100%
      );
    z-index: 1;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.05) 0%,
        rgba(255,255,255,0) 22%
      );
    mix-blend-mode: screen;
    opacity: 0.55;
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-collection-card-content-{{ ai_gen_id }} h3 {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.card_text_color }};
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .ai-collection-card-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.description_spacing }}px;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.42;
    max-width: 92%;
  }

  .ai-collection-card-cta-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_size }}px;
    color: {{ block.settings.cta_color }};
    font-weight: {{ block.settings.cta_weight }};
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-shadow: 0 1px 1px rgba(0,0,0,0.25);
  }

  .ai-collection-card-cta-{{ ai_gen_id }}::after {
    content: '→';
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-cta-{{ ai_gen_id }}::after {
    transform: translateX(3px);
  }

  .ai-collections-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 5;
    pointer-events: none;
  }

  .ai-collections-nav-inner-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 12px;
  }

  .ai-collections-arrow-{{ ai_gen_id }} {
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.06);
    background: rgba(255,255,255,0.96);
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    backdrop-filter: blur(8px);
  }

  .ai-collections-arrow-{{ ai_gen_id }}:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 28px rgba(0,0,0,0.16);
  }

  .ai-collections-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  }

  .ai-collections-arrow-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-collections-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 10px {{ settings.spacing_grid_horizontal }}px 0;
  }

  .ai-collections-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(0,0,0,0.18);
    transition: transform 0.2s ease, background 0.2s ease, width 0.2s ease;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .ai-collections-dot-{{ ai_gen_id }}.is-active {
    background: rgba(0,0,0,0.75);
    transform: scale(1);
    width: 10px;
  }

  @media (max-width: 989px) {
    .ai-collection-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_tablet }}px;
      width: {{ block.settings.card_width_tablet }}px;
      height: {{ block.settings.card_height_tablet }}px;
    }

    .ai-collections-arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 749px) {
    .ai-collections-slider-{{ ai_gen_id }} {
      margin: {{ block.settings.section_spacing_mobile }}px 0;
      width: 100%;
    }

    .ai-collection-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}%;
      width: {{ block.settings.card_width_mobile }}%;
      height: {{ block.settings.card_height_mobile }}px;
    }

    .ai-collections-header-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-collections-header-{{ ai_gen_id }} p {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-collections-nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<collections-slider-{{ ai_gen_id }} class="ai-collections-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    if current_lang == 'ro'
      assign default_heading = 'Inspiră-ți spațiul'
      assign default_subheading = 'Descoperă colecțiile noastre premium'
      assign default_cta = 'Descoperă colecția →'
      assign prev_label = 'Colecția anterioară'
      assign next_label = 'Colecția următoare'
      assign go_to_slide_label = 'Mergi la slide-ul'
    else
      assign default_heading = 'Inspire your space'
      assign default_subheading = 'Discover our premium collections'
      assign default_cta = 'Explore collection →'
      assign prev_label = 'Previous collection'
      assign next_label = 'Next collection'
      assign go_to_slide_label = 'Go to slide'
    endif
  %}

  <div class="ai-collections-header-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2>{{ block.settings.heading }}</h2>
    {% else %}
      <h2>{{ default_heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p>{{ block.settings.subheading }}</p>
    {% else %}
      <p>{{ default_subheading }}</p>
    {% endif %}
  </div>

  <div class="ai-collections-slider-shell-{{ ai_gen_id }}">
    <div class="ai-collections-nav-{{ ai_gen_id }}">
      <div class="ai-collections-nav-inner-{{ ai_gen_id }}">
        <button
          type="button"
          class="ai-collections-arrow-{{ ai_gen_id }}"
          data-prev
          aria-label="{{ prev_label }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button
          type="button"
          class="ai-collections-arrow-{{ ai_gen_id }}"
          data-next
          aria-label="{{ next_label }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-collections-track-{{ ai_gen_id }}" data-track>
      {% for i in (1..5) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign title_key = 'collection_' | append: i | append: '_title'
          assign description_key = 'collection_' | append: i | append: '_description'
          assign image_key = 'collection_' | append: i | append: '_image'
          assign cta_key = 'collection_' | append: i | append: '_cta'

          assign collection = block.settings[collection_key]
          assign custom_title = block.settings[title_key]
          assign custom_description = block.settings[description_key]
          assign custom_image = block.settings[image_key]
          assign custom_cta = block.settings[cta_key]

          if collection != blank
            assign collection_url = collection.url
            assign collection_title = collection.title
            assign collection_image = collection.featured_image
          else
            assign collection_url = '#'
            assign collection_title = ''
            assign collection_image = null
          endif

          if custom_title != blank
            assign display_title = custom_title
          else
            assign display_title = collection_title
          endif

          if custom_image != blank
            assign display_image = custom_image
          else
            assign display_image = collection_image
          endif

          if custom_cta != blank
            assign display_cta = custom_cta
          else
            assign display_cta = default_cta
          endif
        %}

        <a href="{{ collection_url }}" class="ai-collection-card-{{ ai_gen_id }}" data-card>
          {% if display_image %}
            <img
              src="{{ display_image | image_url: width: 600 }}"
              alt="{% if display_title != blank %}{{ display_title | escape }}{% elsif display_image.alt != blank %}{{ display_image.alt | escape }}{% else %}Collection image{% endif %}"
              loading="lazy"
              width="600"
              height="800"
            >
          {% else %}
            <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          <div class="ai-collection-card-overlay-{{ ai_gen_id }}"></div>
          <div class="ai-collection-card-content-{{ ai_gen_id }}">
            {% if display_title != blank %}
              <h3>{{ display_title }}</h3>
            {% endif %}
            {% if custom_description != blank %}
              <p>{{ custom_description }}</p>
            {% endif %}
            <span class="ai-collection-card-cta-{{ ai_gen_id }}">{{ display_cta }}</span>
          </div>
        </a>
      {% endfor %}
    </div>

    <div class="ai-collections-dots-{{ ai_gen_id }}" data-dots></div>
  </div>
</collections-slider-{{ ai_gen_id }}>

<script>
  (() => {
    class CollectionsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.dotsWrap = this.querySelector('[data-dots]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));

        this.isDown = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.hasMoved = false;
        this.resizeTimer = null;
      }

      connectedCallback() {
        if (!this.track || !this.cards.length) return;
        this.buildDots();
        this.bindEvents();
        this.updateUI();

        requestAnimationFrame(() => {
          this.updateUI();
        });
      }

      getCardStep() {
        const firstCard = this.cards[0];
        if (!firstCard) return this.track.clientWidth;

        const styles = window.getComputedStyle(this.track);
        const gap = parseFloat(styles.columnGap || styles.gap || 0);
        return firstCard.getBoundingClientRect().width + gap;
      }

      getMaxIndex() {
        const step = this.getCardStep();
        return Math.max(0, Math.round((this.track.scrollWidth - this.track.clientWidth) / step));
      }

      getCurrentIndex() {
        const step = this.getCardStep();
        if (!step) return 0;
        return Math.round(this.track.scrollLeft / step);
      }

      scrollToIndex(index) {
        const step = this.getCardStep();
        const maxIndex = this.getMaxIndex();
        const safeIndex = Math.max(0, Math.min(index, maxIndex));

        this.track.scrollTo({
          left: safeIndex * step,
          behavior: 'smooth'
        });
      }

      buildDots() {
        if (!this.dotsWrap) return;

        const totalDots = this.getMaxIndex() + 1;
        this.dotsWrap.innerHTML = '';

        if (totalDots <= 1) {
          this.dotsWrap.style.display = 'none';
          return;
        }

        this.dotsWrap.style.display = 'flex';

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'ai-collections-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', '{{ go_to_slide_label }} ' + (i + 1));
          dot.addEventListener('click', () => this.scrollToIndex(i));
          this.dotsWrap.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsWrap) return;
        const dots = Array.from(this.dotsWrap.children);
        const current = this.getCurrentIndex();

        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === current);
        });
      }

      updateArrows() {
        if (!this.prevBtn || !this.nextBtn) return;

        const maxScrollLeft = this.track.scrollWidth - this.track.clientWidth;
        const canScroll = maxScrollLeft > 4;

        if (!canScroll) {
          this.prevBtn.disabled = true;
          this.nextBtn.disabled = true;
          return;
        }

        this.prevBtn.disabled = this.track.scrollLeft <= 4;
        this.nextBtn.disabled = this.track.scrollLeft >= (maxScrollLeft - 4);
      }

      updateUI() {
        this.buildDots();
        this.updateDots();
        this.updateArrows();
      }

      bindEvents() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => {
            this.scrollToIndex(this.getCurrentIndex() - 1);
          });
        }

        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => {
            this.scrollToIndex(this.getCurrentIndex() + 1);
          });
        }

        this.track.addEventListener('scroll', () => {
          this.updateDots();
          this.updateArrows();
        }, { passive: true });

        window.addEventListener('resize', () => {
          clearTimeout(this.resizeTimer);
          this.resizeTimer = setTimeout(() => this.updateUI(), 150);
        });

        this.track.addEventListener('mousedown', (e) => {
          this.isDown = true;
          this.hasMoved = false;
          this.track.classList.add('is-dragging');
          this.startX = e.pageX - this.track.offsetLeft;
          this.scrollLeft = this.track.scrollLeft;
        });

        this.track.addEventListener('mouseleave', () => {
          this.isDown = false;
          this.track.classList.remove('is-dragging');
        });

        this.track.addEventListener('mouseup', () => {
          this.isDown = false;
          this.track.classList.remove('is-dragging');
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!this.isDown) return;
          e.preventDefault();
          const x = e.pageX - this.track.offsetLeft;
          const walk = (x - this.startX) * 1.2;
          if (Math.abs(walk) > 4) this.hasMoved = true;
          this.track.scrollLeft = this.scrollLeft - walk;
        });

        this.track.addEventListener('click', (e) => {
          if (this.hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            this.hasMoved = false;
          }
        }, true);

        this.track.addEventListener('wheel', (e) => {
          if (window.innerWidth > 749 && Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            const canScrollHorizontally = this.track.scrollWidth > this.track.clientWidth;
            if (canScrollHorizontally) {
              e.preventDefault();
              this.track.scrollLeft += e.deltaY;
            }
          }
        }, { passive: false });
      }
    }

    if (!customElements.get('collections-slider-{{ ai_gen_id }}')) {
      customElements.define('collections-slider-{{ ai_gen_id }}', CollectionsSlider{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Collections slider",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inspiră-ți spațiul"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Descoperă colecțiile noastre premium"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading size (mobile)",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#6f6f6f"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Subheading spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "section_spacing_mobile",
      "label": "Section spacing (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "scrollbar_spacing",
      "label": "Scrollbar spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
