{% comment %}
  Collection banner: a wide photo with a title, a line of text and a button, linking to a collection.
  Replaces the AI-generated "Hero banner" (blocks/ai_gen_block_61ac348), which wrote ~240 lines of CSS
  into the page for every banner and had 46 settings; the four home page banners only ever differed in
  photo, collection, texts and the side the text sits on.

  - Empty texts use built-in translations (snippets/alc-blocks-i18n), so every storefront language gets
    a banner in its own language; the title falls back to the collection's own, translated, title.
    Filled-in texts win and are translated in Translate & Adapt.
  - The whole banner is clickable: the button's hit area is stretched over it.
  - Styles: assets/alc-collection-banner.css. Only the height and the text side change per banner,
    through modifier classes.
  - No photo: three in-stock products of the collection fill the side opposite the text (product
    9 onwards, so they do not repeat the first cards of a row of 8 below), then the collection's
    own image. Collection images are square, which a 1300 × 300 frame crops badly. A product whose
    main photo is a close-up (file named *_DETALIU*) is skipped: cropped into a tile it reads as an
    abstract shape.
  - Markets (snippets/alc-market-visibility): nothing renders in a market the banner is not for.
{% endcomment %}
{%- capture alc_hide -%}{%- render 'alc-market-visibility', visibility: block.settings.visibility -%}{%- endcapture -%}
{%- if alc_hide == blank -%}
{%- liquid
  assign collection = block.settings.collection
  assign link = block.settings.link | default: collection.url
  assign image = block.settings.image
  assign image_mobile = block.settings.image_mobile

  assign tile_count = 0
  if image == blank and collection != blank
    for pass in (1..2)
      assign pos = 0
      for p in collection.products
        if tile_count >= 3
          break
        endif
        if p.available == false or p.featured_media == blank
          continue
        endif
        assign pos = pos | plus: 1
        if pass == 1 and pos <= 8
          continue
        endif
        if pass == 2 and pos > 8
          break
        endif
        assign tile_src = p.featured_media.preview_image.src | downcase
        if tile_src contains '_detaliu'
          continue
        endif
        assign tile_count = tile_count | plus: 1
        case tile_count
          when 1
            assign tile_1 = p.featured_media
          when 2
            assign tile_2 = p.featured_media
          else
            assign tile_3 = p.featured_media
        endcase
      endfor
    endfor
    if tile_count == 0
      assign image = collection.featured_image
    endif
  endif

  assign title = block.settings.title | default: collection.title
  assign subtitle = block.settings.subtitle
  if subtitle == blank
    capture subtitle
      render 'alc-blocks-i18n', key: 'banner_subtitle'
    endcapture
  endif
  assign cta = block.settings.cta_text
  if cta == blank
    capture cta
      render 'alc-blocks-i18n', key: 'banner_cta'
    endcapture
  endif
-%}

{{ 'alc-collection-banner.css' | asset_url | stylesheet_tag }}

<div
  class="alc-cb alc-cb--{{ block.settings.text_position }} alc-cb--{{ block.settings.height }}{% if tile_count > 0 %} alc-cb--tiles{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="alc-cb__media">
    {%- if tile_count > 0 -%}
      {%- for i in (1..tile_count) -%}
        {%- liquid
          case i
            when 1
              assign tile = tile_1
            when 2
              assign tile = tile_2
            else
              assign tile = tile_3
          endcase
        -%}
        <span class="alc-cb__tile">
          {{
            tile
            | image_url: width: 600
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 1300px) 270px, (min-width: 990px) 21vw, (min-width: 750px) 34vw, 50vw',
              loading: 'lazy',
              class: 'alc-cb__img',
              alt: ''
          }}
        </span>
      {%- endfor -%}
    {%- elsif image != blank -%}
      <picture>
        {%- if image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {%- for width in (1..4) -%}
                {%- assign w = width | times: 250 | plus: 150 -%}
                {%- if image_mobile.width >= w or forloop.first -%}
                  {%- unless forloop.first %}, {% endunless -%}
                  {{ image_mobile | image_url: width: w }} {{ w | at_most: image_mobile.width }}w
                {%- endif -%}
              {%- endfor -%}
            "
            sizes="calc(100vw - 32px)"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 1300
          | image_tag:
            widths: '650, 900, 1300, 1950, 2600',
            sizes: '(min-width: 1300px) 1300px, (min-width: 750px) 100vw, calc(100vw - 32px)',
            loading: 'lazy',
            class: 'alc-cb__img',
            alt: title
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'alc-cb__img alc-cb__img--placeholder' }}
    {%- endif -%}
  </div>

  <div class="alc-cb__content">
    <div class="alc-cb__text">
      {%- if title != blank -%}
        <h2 class="alc-cb__title">{{ title | escape }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="alc-cb__subtitle">{{ subtitle | escape }}</p>
      {%- endif -%}
      {%- if link != blank and cta != blank -%}
        <a class="alc-cb__cta" href="{{ link }}">
          {{- cta | escape -}}
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Collection banner",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Markets",
      "options": [
        { "value": "all", "label": "All markets" },
        { "value": "ro", "label": "Romania only (.ro)" },
        { "value": "not_ro", "label": "All markets except Romania" }
      ],
      "default": "all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The banner links to it. Empty title: the collection's own (translated) title. Empty photo: three in-stock products of the collection."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Wide, at least 1700 × 450 px."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Photo on phones",
      "info": "Empty: the photo above."
    },
    {
      "type": "header",
      "content": "Texts"
    },
    {
      "type": "paragraph",
      "content": "Leave a text empty to use the built-in text, translated into every storefront language. A text you type here wins and is translated in Translate & Adapt."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Empty: the collection above."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "compact", "label": "Compact (300 px, 200 px on phones)" },
        { "value": "medium", "label": "Medium (420 px, 320 px on phones)" },
        { "value": "tall", "label": "Tall (560 px, 420 px on phones)" }
      ],
      "default": "compact"
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
