
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collections-slider-{{ ai_gen_id }} {
    display: block;
    max-width: {{ settings.page_width }}px;
    margin: {{ block.settings.section_spacing }}px auto;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    width: {{ block.settings.desktop_width_percent }}%;
    position: relative;
  }

  .ai-collections-header-{{ ai_gen_id }} {
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-collections-header-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    line-height: 1.2;
  }

  .ai-collections-header-{{ ai_gen_id }} p {
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
  }

  .ai-collections-slider-shell-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-collections-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 0 {{ settings.spacing_grid_horizontal }}px {{ block.settings.scrollbar_spacing }}px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    user-select: none;
    cursor: grab;
  }

  .ai-collections-track-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }

  .ai-collections-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    flex: 0 0 {{ block.settings.card_width }}px;
    width: {{ block.settings.card_width }}px;
    height: {{ block.settings.card_height }}px;
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    scroll-snap-align: start;
    text-decoration: none;
    color: {{ block.settings.card_text_color }};
    background: #000;
    transition: transform {{ block.settings.hover_duration }}s ease, box-shadow {{ block.settings.hover_duration }}s ease;
    display: block;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow_y }}px {{ block.settings.hover_shadow_blur }}px {{ block.settings.hover_shadow_color }};
  }

  .ai-collection-card-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-collection-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      {{ block.settings.overlay_bottom_color }} 0%,
      {{ block.settings.overlay_middle_color }} {{ block.settings.overlay_middle_position }}%,
      {{ block.settings.overlay_top_color }} {{ block.settings.overlay_top_position }}%
    );
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.content_padding }}px;
    left: {{ block.settings.content_padding }}px;
    right: {{ block.settings.content_padding }}px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-collection-card-content-{{ ai_gen_id }} h3 {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.card_text_color }};
    line-height: 1.2;
  }

  .ai-collection-card-content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.description_spacing }}px;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.4;
  }

  .ai-collection-card-cta-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_size }}px;
    color: {{ block.settings.cta_color }};
    font-weight: {{ block.settings.cta_weight }};
  }

  .ai-collections-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 5;
    pointer-events: none;
  }

  .ai-collections-nav-inner-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px;
  }

  .ai-collections-nav-btn-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg }};
    border: none;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
    color: {{ block.settings.nav_button_color }};
  }

  .ai-collections-nav-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-collections-nav-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-collections-slider-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width_mobile }}px;
      width: {{ block.settings.card_width_mobile }}px;
      height: {{ block.settings.card_height_mobile }}px;
    }
  }
{% endstyle %}

<collections-slider-{{ ai_gen_id }}
  class="ai-collections-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-collections-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p>{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-collections-slider-shell-{{ ai_gen_id }}">
    <div class="ai-collections-track-{{ ai_gen_id }}" data-track>
      {% for i in (1..10) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign image_key = 'collection_' | append: i | append: '_image'
          assign title_key = 'collection_' | append: i | append: '_title'
          assign description_key = 'collection_' | append: i | append: '_description'
          assign cta_key = 'collection_' | append: i | append: '_cta_text'

          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[image_key]
          assign custom_title = block.settings[title_key]
          assign custom_description = block.settings[description_key]
          assign custom_cta = block.settings[cta_key]
        %}

        {% if collection != blank %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-card-{{ ai_gen_id }}"
          >
            {% if custom_image != blank %}
              <img
                src="{{ custom_image | image_url: width: 800 }}"
                alt="{{ custom_image.alt | escape }}"
                loading="lazy"
                width="{{ custom_image.width }}"
                height="{{ custom_image.height }}"
              >
            {% elsif collection.image %}
              <img
                src="{{ collection.image | image_url: width: 800 }}"
                alt="{{ collection.image.alt | escape }}"
                loading="lazy"
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
              >
            {% else %}
              <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-collection-card-overlay-{{ ai_gen_id }}"></div>

            <div class="ai-collection-card-content-{{ ai_gen_id }}">
              <h3>
                {% if custom_title != blank %}
                  {{ custom_title }}
                {% else %}
                  {{ collection.title }}
                {% endif %}
              </h3>

              {% if custom_description != blank %}
                <p>{{ custom_description }}</p>
              {% endif %}

              <div class="ai-collection-card-cta-{{ ai_gen_id }}">
                {% if custom_cta != blank %}
                  {{ custom_cta }}
                {% else %}
                  {{ block.settings.default_cta_text }}
                {% endif %}
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <div class="ai-collections-nav-{{ ai_gen_id }}">
        <div class="ai-collections-nav-inner-{{ ai_gen_id }}">
          <button
            class="ai-collections-nav-btn-{{ ai_gen_id }}"
            data-prev
            aria-label="Previous"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            class="ai-collections-nav-btn-{{ ai_gen_id }}"
            data-next
            aria-label="Next"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</collections-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionsSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-track]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
      }

      connectedCallback() {
        this.setupDragScroll();
        this.setupNavigation();
      }

      setupDragScroll() {
        if (!this.track) return;

        this.track.addEventListener('mousedown', (e) => {
          this.isDragging = true;
          this.track.classList.add('is-dragging');
          this.startX = e.pageX - this.track.offsetLeft;
          this.scrollLeft = this.track.scrollLeft;
        });

        this.track.addEventListener('mouseleave', () => {
          this.isDragging = false;
          this.track.classList.remove('is-dragging');
        });

        this.track.addEventListener('mouseup', () => {
          this.isDragging = false;
          this.track.classList.remove('is-dragging');
        });

        this.track.addEventListener('mousemove', (e) => {
          if (!this.isDragging) return;
          e.preventDefault();
          const x = e.pageX - this.track.offsetLeft;
          const walk = (x - this.startX) * 2;
          this.track.scrollLeft = this.scrollLeft - walk;
        });

        this.track.addEventListener('touchstart', (e) => {
          this.startX = e.touches[0].pageX - this.track.offsetLeft;
          this.scrollLeft = this.track.scrollLeft;
        });

        this.track.addEventListener('touchmove', (e) => {
          const x = e.touches[0].pageX - this.track.offsetLeft;
          const walk = (x - this.startX) * 2;
          this.track.scrollLeft = this.scrollLeft - walk;
        });
      }

      setupNavigation() {
        if (!this.prevBtn || !this.nextBtn || !this.track) return;

        this.prevBtn.addEventListener('click', () => {
          const cardWidth = this.track.querySelector('.ai-collection-card-{{ ai_gen_id }}').offsetWidth;
          const gap = {{ block.settings.card_gap }};
          this.track.scrollBy({
            left: -(cardWidth + gap),
            behavior: 'smooth'
          });
        });

        this.nextBtn.addEventListener('click', () => {
          const cardWidth = this.track.querySelector('.ai-collection-card-{{ ai_gen_id }}').offsetWidth;
          const gap = {{ block.settings.card_gap }};
          this.track.scrollBy({
            left: cardWidth + gap,
            behavior: 'smooth'
          });
        });
      }
    }

    customElements.define('collections-slider-{{ ai_gen_id }}', CollectionsSlider{{ ai_gen_id }});
  })();
</script>

