{% doc %}
  @prompt
    generate a section with image with bevel on edges, and text (title + text). I can choose title and text font, size and bold and color. Then I can chose position of image (left or right) and background color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bevel-image-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 40px 20px;
  }

  .ai-bevel-image-text__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 40px;
    {% if block.settings.image_position == 'right' %}
      flex-direction: row-reverse;
    {% else %}
      flex-direction: row;
    {% endif %}
  }

  .ai-bevel-image-text__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
  }

  .ai-bevel-image-text__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    clip-path: polygon(
      {{ block.settings.bevel_size }}% 0%,
      100% 0%,
      100% calc(100% - {{ block.settings.bevel_size }}%),
      calc(100% - {{ block.settings.bevel_size }}%) 100%,
      0% 100%,
      0% {{ block.settings.bevel_size }}%
    );
  }

  .ai-bevel-image-text__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(
      {{ block.settings.bevel_size }}% 0%,
      100% 0%,
      100% calc(100% - {{ block.settings.bevel_size }}%),
      calc(100% - {{ block.settings.bevel_size }}%) 100%,
      0% 100%,
      0% {{ block.settings.bevel_size }}%
    );
  }

  .ai-bevel-image-text__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bevel-image-text__content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-bevel-image-text__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px 0;
    {% if block.settings.title_bold %}
      font-weight: 700;
    {% endif %}
  }

  .ai-bevel-image-text__text-{{ ai_gen_id }} {
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
    {% if block.settings.text_bold %}
      font-weight: 700;
    {% endif %}
  }

  @media screen and (max-width: 768px) {
    .ai-bevel-image-text__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 30px;
    }

    .ai-bevel-image-text__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-bevel-image-text__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<bevel-image-text-{{ ai_gen_id }} class="ai-bevel-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bevel-image-text__container-{{ ai_gen_id }}">
    <div class="ai-bevel-image-text__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-bevel-image-text__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-bevel-image-text__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-bevel-image-text__content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-bevel-image-text__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-bevel-image-text__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</bevel-image-text-{{ ai_gen_id }}>

<script>
  (function() {
    class BevelImageText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('bevel-image-text-{{ ai_gen_id }}', BevelImageText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bevel image with text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "bevel_size",
      "label": "Bevel size",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 5
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Your title here</p>"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font",
      "default": "roboto_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "title_bold",
      "label": "Bold",
      "default": true
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description text here. This is a great place to tell your story and connect with your customers.</p>"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "roboto_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "text_bold",
      "label": "Bold",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Bevel image with text"
    }
  ]
}
{% endschema %}
