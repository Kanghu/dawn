{% comment %}
  We assume:
  - product.metafields.custom.product_related_variants is a list of metaobject references.
  - Each metaobject reference (related_variant) exposes:
  related_variant.product_variant.product
  related_variant.product_variant.tag
  - We'll display the "tag" as the "variant name."
{% endcomment %}

<style>
  .ProductForm__Option {
    display: flex;
    gap: 10px;
    /* Spacing between buttons */
    flex-wrap: wrap;
    /* Allow buttons to wrap on smaller screens */
  }

  .VariantButton {
    background-color: #f8f8f8;
    /* Neutral background */
    border: 1px solid #ccc;
    /* Light border */
    padding: 10px 20px;
    /* Button padding */
    font-size: 16px;
    /* Font size */
    cursor: pointer;
    border-radius: 5px;
    /* Rounded corners */
    transition: background-color 0.2s
    , border-color 0.2s;
    /* Smooth hover effect */
  }

  .VariantButton:hover {
    background-color: #e0e0e0;
    /* Hover background */
    border-color: #999;
    /* Darker border on hover */
  }

  .VariantButton--active {
    background-color: #0053ba;
    /* Active state background */
    color: #fff;
    /* Active state text color */
    border-color: #0053ba;
    /* Match background */
  }

  .VariantButton:disabled {
    background-color: #ddd;
    /* Disabled state background */
    cursor: not-allowed;
    /* Indicate unclickable */
  }

  .ProductForm__VariantPickerText {
    font-size: 16px;
    margin-bottom: 10px;
    color: #333;
  }

  .ProductForm__Option--Buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .VariantDropdown {
    width: 100%;
    padding: 10px;
    font-size: 16px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }

  .swiper {
    width: 100%;
    height: 100%;
    /* Fix layout shift: provide consistent height before Swiper initializes */
    min-height: 120px;
    /* ADD THESE TOUCH-ACTION PROPERTIES */
    touch-action: pan-y pinch-zoom;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    overflow: hidden;
  }

  /* Mobile Swiper Styles */
  @media (max-width: 767px) {
    .swiper-wrapper {
      display: flex;
    }

    .swiper-slide {
      flex-shrink: 0;
    }
  }

  /* Desktop Grid Styles */
  @media (min-width: 768px) {
    .variant-container {
      display: grid !important;
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 20px 6px !important;
      /* row-gap column-gap */
      max-width: 100% !important;
      width: 100% !important;
      overflow: visible !important;
      align-items: start !important;
      margin-top: 16px !important;
    }

    /* Tablet: 4 columns */
    .variant-container.variant-grid-tablet {
      grid-template-columns: repeat(4, 1fr) !important;
    }

    /* Desktop: 6 columns with proper spacing */
    @media (min-width: 1024px) {
      .variant-container {
        grid-template-columns: repeat(6, 1fr) !important;
        gap: 24px 8px !important;
      }

      .variant-container.variant-grid-desktop {
        grid-template-columns: repeat(6, 1fr) !important;
      }
    }

    /* Large screens: keep 6 columns but with more gap and slightly larger items */
    @media (min-width: 1280px) {
      .variant-container.variant-grid-large {
        grid-template-columns: repeat(6, 1fr) !important;
        gap: 28px 8px !important;
        /* row-gap column-gap */
      }

      .swiper-slide {
        min-width: 95px !important;
        max-width: 95px !important;
        width: 95px !important;
        min-height: 100px;
        max-height: 115px;
      }

      .swiper-slide a {
        min-height: 100px;
        max-height: 115px;
      }

      .swiper-slide img {
        height: 60px;
      }

      .swiper-slide p {
        font-size: 12px !important;
      }
    }

    /* Override Swiper behavior completely on desktop */
    .swiper {
      overflow: visible !important;
      width: 100% !important;
    }

    .swiper-wrapper {
      display: grid !important;
      grid-template-columns: inherit !important;
      gap: inherit !important;
      transform: none !important;
      transition: none !important;
      width: 100% !important;
      height: auto !important;
      flex-wrap: wrap !important;
    }

    .swiper-slide {
      width: auto !important;
      height: auto !important;
      margin-right: 0 !important;
      margin-bottom: 0 !important;
      transform: none !important;
      flex-shrink: 0 !important;
    }
  }

  .swiper-slide {
    text-align: center;
    font-size: 18px;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    /* Prevent layout shift by setting consistent slide dimensions */
    min-width: 100px;
    min-height: 120px;
    transition: all 0.2s ease;
    cursor: pointer;
    /* ADD THIS FOR BETTER TOUCH HANDLING */
    touch-action: manipulation;
  }

  /* Desktop grid items - consistent sizing */
  @media (min-width: 768px) {
    .swiper-slide {
      min-width: 85px !important;
      max-width: 85px !important;
      width: 85px !important;
      min-height: 90px;
      max-height: 105px;
    }

    .swiper-slide a {
      padding: 4px !important;
      min-height: 90px;
      max-height: 105px;
      display: flex !important;
      flex-direction: column !important;
    }

    .swiper-slide img {
      width: 100%;
      height: 50px;
      object-fit: cover;
      border-radius: 4px;
      flex-shrink: 0;
    }

    .swiper-slide .flex-grow {
      padding: 4px 2px 6px !important;
      flex-grow: 1 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-height: 35px !important;
    }

    .swiper-slide p {
      font-size: 10px !important;
      line-height: 1.3 !important;
      padding: 1px !important;
      margin: 0 !important;
      max-width: 80px !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      text-align: center !important;
    }
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
    border-radius: 6px;
  }

  .swiper-slide:hover {
    transform: scale(1.02);
    z-index: 10;
  }

  .swiper-slide:hover img {
    transform: scale(1.05);
  }

  /* Add new styles for current product variant */
  .swiper-slide.current-product a {
    border: 2px solid #181818 !important;
    position: relative;
  }

  .swiper-slide.current-product a::before {
    position: absolute;
    top: 0;
    left: 0;
    background: rgba(65, 64, 66);
    color: white;
    padding: 2px 8px;
    font-size: 12px;
    border-bottom-right-radius: 4px;
  }

  /* Hover effect for variant options */
  .swiper-slide:not(.current-product) a:hover {
    border-color: #0053ba;
    background-color: #f8f8f8;
    transform: translateY(-3px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  /* Ensure current product doesn't have hover effect */
  .swiper-slide.current-product a:hover {
    transform: none;
    background-color: white;
  }
</style>

<div class="ProductForm__VariantPicker">
  {% assign related_variants = product.metafields.custom.variant_groups.value %}

  {% if related_variants %}
    {% if block.settings.picker_style == 'buttons' %}
      <!-- Button Picker -->
      <div class="ProductForm__Option ProductForm__Option--Buttons gap-4">
        <!-- Variant group iteration -->
        {% for variant_group in related_variants %}
          {% assign group_metaobj = variant_group | metaobject %}
          {% assign group_group_metaobj = variant_group.group | metaobject %}

          {% comment %} Count available variants in this group {% endcomment %}
          {% assign available_variants_count = 0 %}
          {% for group_product in group_group_metaobj.value %}
            {% assign group_product_metaobj = group_product | metaobject %}
            {% if group_product_metaobj.product.value.available %}
              {% assign available_variants_count = available_variants_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% comment %} Only show group if it has more than 1 available variant {% endcomment %}
          {% if available_variants_count > 1 %}
            <div class="w-full flex flex-col">
            <!-- Display group info + tag (i.e. colors, sizes, etc.) -->
            {% if block.settings.custom_text %}
              <p class="ProductForm__VariantPickerText mb-0">
                {{ block.settings.custom_text }}
                {{ group_metaobj.tag_type }}
              </p>
            {% endif %}

            <!-- Variant container - Swiper on mobile, Grid on desktop -->
            <div class="swiper variant-container variant-grid-tablet variant-grid-desktop variant-grid-large" id="ProductVariantsSlider">
              <div class="swiper-wrapper">
                <!-- Add current product first if it matches the variant group -->
                {% for group_product in group_group_metaobj.value %}
                  {% assign group_product_metaobj = group_product | metaobject %}
                  {% if group_product_metaobj.product.value.handle == product.handle and group_product_metaobj.product.value.available %}
                    <div class="swiper-slide current-product">
                      <a
                        href="/products/{{ product.handle }}"
                        title="{{ product.title }}"
                        class="w-full h-auto flex flex-col border bg-white shadow-md rounded-md overflow-hidden hover:bg-black transition p-2 no-underline">
                        {% if product.featured_image %}
                          <div>
                            <img
                              class="rounded-md"
                              src="{{ product.featured_image | img_url: '400x400' }}"
                              alt="{{ product.title }}">
                          </div>
                        {% endif %}
                        <div class="flex-grow px-1 pt-2">
                          <p class="text-base text-gray-800 no-underline mb-0 p-1">
                            {{ group_product_metaobj.tag }}
                          </p>
                        </div>
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}

                <!-- Then show all other variants except current product -->
                {% for group_product in group_group_metaobj.value %}
                  {% assign group_product_metaobj = group_product | metaobject %}
                  {% unless group_product_metaobj.product.value.handle == product.handle %}
                    {% if group_product_metaobj.product.value.available %}
                      <div class="swiper-slide">
                      <a
                        href="/products/{{ group_product_metaobj.product.value.handle }}"
                        title="{{ group_product_metaobj.product.value.title }}"
                        class="w-full h-auto flex flex-col border bg-white shadow-md rounded-md overflow-hidden hover:bg-black transition p-2 no-underline">
                        <!-- Variant image -->
                        {% if group_product_metaobj.product.value.featured_image %}
                          <div>
                            <img src="{{ group_product_metaobj.product.value.featured_image | img_url: '400x400' }}" alt="{{ group_product_metaobj.product.value.title }}">
                          </div>
                        {% endif %}

                        <!-- Variant info -->
                        <div class="flex-grow px-1 pt-2">
                          <p class="text-base text-gray-800 no-underline mb-0 p-1">
                            {{ group_product_metaobj.tag }}
                          </p>
                        </div>
                      </a>
                      </div>
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <!-- Dropdown Picker -->
      <div class="ProductForm__Option ProductForm__Option--Dropdown">
        <select
          name="related_variant_selection"
          class="VariantDropdown"
          onchange="window.location.href='/products/' + this.value;">
          <!-- Current Product -->
          <option value="{{ product.handle }}" selected>
            {{ product.metafields.custom.product_variant_tag.value }}
          </option>

          <!-- Related Variants -->
          {% for variant_group in related_variants %}
            {% assign group_metaobj = variant_group | metaobject %}
            {% assign group_group_metaobj = variant_group.group | metaobject %}
            {% for group_product in group_group_metaobj.value %}
              {% assign group_product_metaobj = group_product | metaobject %}
              <option value="{{ group_product_metaobj.product.value.handle }}">
                {{ group_product_metaobj.tag }}
              </option>
            {% endfor %}
          {% endfor %}
        </select>
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Only initialize Swiper on mobile devices
    const isMobile = window.matchMedia('(max-width: 767px)');

    function handleScreenChange(e) {
      if (e.matches) {
        // Mobile - initialize Swiper
        initializeVariantSwiperIfNeeded();
      } else {
        // Desktop - destroy Swiper if it exists and initialize hover
        destroyVariantSwiper();
        initializeImageHoverChange();
      }
    }

    // Initial check
    handleScreenChange(isMobile);

    // Listen for screen size changes
    isMobile.addEventListener('change', handleScreenChange);
  });

  let variantSwiper = null;

  function initializeVariantSwiperIfNeeded() {
    // Don't initialize if Swiper already exists or library not loaded
    if (variantSwiper || typeof Swiper === 'undefined') {
      if (typeof Swiper === 'undefined') {
        console.warn('Swiper library not loaded yet, retrying...');
        setTimeout(() => {
          if (typeof Swiper !== 'undefined') {
            initializeVariantSwiperIfNeeded();
          }
        }, 500);
      }
      return;
    }

    initializeVariantSwiper();
  }

  function destroyVariantSwiper() {
    if (variantSwiper) {
      variantSwiper.destroy(true, true);
      variantSwiper = null;
    }
  }

  function initializeVariantSwiper() {
    variantSwiper = new Swiper('#ProductVariantsSlider', {
      slidesPerView: 1,
      spaceBetween: 8,

      // Simplified freeMode settings
      freeMode: true,
      freeModeMomentum: true,
      grabCursor: true,
      touchRatio: 1,
      simulateTouch: true,
      allowTouchMove: true,

      // Consistent resistance and momentum settings
      resistanceRatio: 0.2,
      freeModeMomentumRatio: 0.25,
      freeModeMomentumBounce: false,
      watchSlidesProgress: true,

      // Proper offset for last slide accessibility
      slidesOffsetAfter: 40,

      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        320: {
          slidesPerView: 3.5,
          spaceBetween: 6,
          slidesOffsetAfter: 30,
        },
        480: {
          slidesPerView: 4,
          spaceBetween: 6,
          slidesOffsetAfter: 35,
        },
        640: {
          slidesPerView: 4.5,
          spaceBetween: 8,
          slidesOffsetAfter: 40,
        },
        768: {
          slidesPerView: 4.5,
          spaceBetween: 8,
          slidesOffsetAfter: 45,
        },
        1024: {
          slidesPerView: 4.5,
          spaceBetween: 8,
          slidesOffsetAfter: 50,
        },
      },
    });

    // Add hover functionality to change main product image
    initializeImageHoverChange();
  }

  function initializeImageHoverChange() {
    const variantSlides = document.querySelectorAll('#ProductVariantsSlider .swiper-slide');

    console.log('Initializing hover for', variantSlides.length, 'variant slides');
    
    // Try multiple selectors to find the main product image
    const possibleSelectors = [
      '.product__media-item.is-active .product__media img',
      '.product__media-item.is-active img',
      '.product__media-list .is-active img',
      '.product__media img',
      '.product__media-wrapper img'
    ];
    
    let mainProductImage = null;
    for (const selector of possibleSelectors) {
      mainProductImage = document.querySelector(selector);
      if (mainProductImage) {
        console.log('Found main product image with selector:', selector);
        break;
      }
    }
    
    if (!mainProductImage) {
      return;
    }
  
    // Store original image and srcset for restoration
    const originalImageSrc = mainProductImage.src;
    const originalImageSrcset = mainProductImage.srcset;

    variantSlides.forEach((slide, index) => {
      const variantImg = slide.querySelector('img');
      if (!variantImg) return;
      
      slide.addEventListener('mouseenter', () => {
        console.log(`Hovering over variant ${index + 1}`);
        // Get high-res version of variant image (upgrade from 400x400 to 800x800)
        const variantImageSrc = variantImg.src.replace('400x400', '800x800');
        
        // Pre-load the new image to prevent flash
        const tempImage = new Image();
        tempImage.onload = () => {
          // Image is loaded, now switch smoothly
          mainProductImage.style.opacity = '0.8';
          mainProductImage.srcset = '';
          mainProductImage.src = variantImageSrc;
          mainProductImage.style.opacity = '1';
          console.log('Image src changed to:', mainProductImage.src);
        };
        tempImage.src = variantImageSrc;
      });
      
      slide.addEventListener('mouseleave', () => {
        // Pre-load original image to prevent flash on restore
        const tempImage = new Image();
        tempImage.onload = () => {
          // Original image is loaded, restore smoothly
          mainProductImage.style.opacity = '0.8';
          mainProductImage.src = originalImageSrc;
          mainProductImage.srcset = originalImageSrcset;
          mainProductImage.style.opacity = '1';
        };
        tempImage.src = originalImageSrc;
      });
    });
  }

  document.querySelectorAll('input[name="related_variant_selection"]').forEach(function (radio) {
    radio.addEventListener('change', function (event) {
      var productHandle = event.target.dataset.productHandle;

      // Redirect to the product page with that variant pre-selected
      window.location.href = '/products/' + productHandle;
    });
  });
</script>