{% comment %}
  We assume:
  - product.metafields.custom.product_related_variants is a list of metaobject references.
  - Each metaobject reference (related_variant) exposes:
  related_variant.product_variant.product
  related_variant.product_variant.tag
  - We'll display the "tag" as the "variant name."
{% endcomment %}

<style>
  .ProductForm__Option {
    display: flex;
    gap: 10px;
    /* Spacing between buttons */
    flex-wrap: wrap;
    /* Allow buttons to wrap on smaller screens */
  }

  .VariantButton {
    background-color: #f8f8f8;
    /* Neutral background */
    border: 1px solid #ccc;
    /* Light border */
    padding: 10px 20px;
    /* Button padding */
    font-size: 16px;
    /* Font size */
    cursor: pointer;
    border-radius: 5px;
    /* Rounded corners */
    transition: background-color 0.2s
    , border-color 0.2s;
    /* Smooth hover effect */
  }

  .VariantButton:hover {
    background-color: #e0e0e0;
    /* Hover background */
    border-color: #999;
    /* Darker border on hover */
  }

  .VariantButton--active {
    background-color: #0053ba;
    /* Active state background */
    color: #fff;
    /* Active state text color */
    border-color: #0053ba;
    /* Match background */
  }

  .VariantButton:disabled {
    background-color: #ddd;
    /* Disabled state background */
    cursor: not-allowed;
    /* Indicate unclickable */
  }

  .ProductForm__VariantPickerText {
    font-size: 16px;
    margin-bottom: 10px;
    color: #333;
  }

  .ProductForm__Option--Buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .VariantDropdown {
    width: 100%;
    padding: 10px;
    font-size: 16px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }

  .swiper {
    width: 100%;
    height: 100%;
    /* Fix layout shift: provide consistent height before Swiper initializes */
    min-height: 120px;
  }

  .swiper-slide {
    text-align: center;
    font-size: 18px;
    background: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    /* Prevent layout shift by setting consistent slide dimensions */
    min-width: 100px;
    min-height: 120px;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
    border-radius: 8px;
  }
  
  .swiper-slide:hover {
    transform: scale(1.02);
    z-index: 10;
  }
  
  .swiper-slide:hover img {
    transform: scale(1.05);
  }

  /* Add new styles for current product variant */
  .swiper-slide.current-product a {
    border: 2px solid #181818 !important;
    position: relative;
  }

  .swiper-slide.current-product a::before {
    position: absolute;
    top: 0;
    left: 0;
    background: rgba(65, 64, 66);
    color: white;
    padding: 2px 8px;
    font-size: 12px;
    border-bottom-right-radius: 4px;
  }

  /* Hover effect for variant options */
  .swiper-slide:not(.current-product) a:hover {
    border-color: #0053ba;
    background-color: #f8f8f8;
    transform: translateY(-3px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  /* Ensure current product doesn't have hover effect */
  .swiper-slide.current-product a:hover {
    transform: none;
    background-color: white;
  }
</style>

<div class="ProductForm__VariantPicker">
  {% assign related_variants = product.metafields.custom.variant_groups.value %}

  {% if related_variants %}
    {% if block.settings.picker_style == 'buttons' %}
      <!-- Button Picker -->
      <div class="ProductForm__Option ProductForm__Option--Buttons gap-4">
        <!-- Variant group iteration -->
        {% for variant_group in related_variants %}
          {% assign group_metaobj = variant_group | metaobject %}
          {% assign group_group_metaobj = variant_group.group | metaobject %}

            <div class="w-full flex flex-col">
            <!-- Display group info + tag (i.e. colors, sizes, etc.) -->
            {% if block.settings.custom_text %}
              <p class="ProductForm__VariantPickerText mb-0">
                {{ block.settings.custom_text }}
                {{ group_metaobj.tag_type }}
              </p>
            {% endif %}

            <!-- Swiper container -->
            <div class="swiper" id="ProductVariantsSlider">
              <div class="swiper-wrapper">
                <!-- Add current product first if it matches the variant group -->
                {% for group_product in group_group_metaobj.value %}
                  {% assign group_product_metaobj = group_product | metaobject %}
                  {% if group_product_metaobj.product.value.handle == product.handle %}
                    <div class="swiper-slide current-product">
                      <a
                        href="/products/{{ product.handle }}"
                        title="{{ product.title }}"
                        class="w-full h-auto flex flex-col border bg-white shadow-md rounded-lg overflow-hidden hover:bg-black transition p-2 no-underline">
                        {% if product.featured_image %}
                          <div>
                            <img
                              class="rounded-sm"
                              src="{{ product.featured_image | img_url: '400x400' }}"
                              alt="{{ product.title }}">
                          </div>
                        {% endif %}
                        <div class="flex-grow px-1 pt-2">
                          <p class="text-base text-gray-800 no-underline mb-0 p-1">
                            {{ group_product_metaobj.tag }}
                          </p>
                        </div>
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}

                <!-- Then show all other variants except current product -->
                {% for group_product in group_group_metaobj.value %}
                  {% assign group_product_metaobj = group_product | metaobject %}
                  {% unless group_product_metaobj.product.value.handle == product.handle %}
                    <div class="swiper-slide">
                      <a
                        href="/products/{{ group_product_metaobj.product.value.handle }}"
                        title="{{ group_product_metaobj.product.value.title }}"
                        class="w-full h-auto flex flex-col border bg-white shadow-md rounded-lg overflow-hidden hover:bg-black transition p-2 no-underline">
                        <!-- Variant image -->
                        {% if group_product_metaobj.product.value.featured_image %}
                          <div>
                            <img src="{{ group_product_metaobj.product.value.featured_image | img_url: '400x400' }}" alt="{{ group_product_metaobj.product.value.title }}">
                          </div>
                        {% endif %}

                        <!-- Variant info -->
                        <div class="flex-grow px-1 pt-2">
                          <p class="text-base text-gray-800 no-underline mb-0 p-1">
                            {{ group_product_metaobj.tag }}
                          </p>
                        </div>
                      </a>
                    </div>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <!-- Dropdown Picker -->
      <div class="ProductForm__Option ProductForm__Option--Dropdown">
        <select
          name="related_variant_selection"
          class="VariantDropdown"
          onchange="window.location.href='/products/' + this.value;">
          <!-- Current Product -->
          <option value="{{ product.handle }}" selected>
            {{ product.metafields.custom.product_variant_tag.value }}
          </option>

          <!-- Related Variants -->
          {% for variant_group in related_variants %}
            {% assign group_metaobj = variant_group | metaobject %}
            {% assign group_group_metaobj = variant_group.group | metaobject %}
            {% for group_product in group_group_metaobj.value %}
              {% assign group_product_metaobj = group_product | metaobject %}
              <option value="{{ group_product_metaobj.product.value.handle }}">
                {{ group_product_metaobj.tag }}
              </option>
            {% endfor %}
          {% endfor %}
        </select>
      </div>
    {% endif %}
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize Swiper with safety check
    if (typeof Swiper === 'undefined') {
      console.warn('Swiper library not loaded yet, retrying...');
      // Retry after a short delay
      setTimeout(() => {
        if (typeof Swiper !== 'undefined') {
          initializeVariantSwiper();
        }
      }, 500);
      return;
    }
    
    initializeVariantSwiper();
  });

  function initializeVariantSwiper() {
    const swiper = new Swiper('.swiper', {
      slidesPerView: 1,
      spaceBetween: 8,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        320: { slidesPerView: 4.5 },
        480: { slidesPerView: 4.75 },
        640: { slidesPerView: 5 },
        768: { slidesPerView: 5.2 },
        1024: { slidesPerView: 5.5 },
      },
    });

    // Add hover functionality to change main product image
    initializeImageHoverChange();
  }

  function initializeImageHoverChange() {
    const variantSlides = document.querySelectorAll('#ProductVariantsSlider .swiper-slide');
    
    // Try multiple selectors to find the main product image
    const possibleSelectors = [
      '.product__media-item.is-active .product__media img',
      '.product__media-item.is-active img',
      '.product__media-list .is-active img',
      '.product__media img',
      '.product__media-wrapper img'
    ];
    
    let mainProductImage = null;
    for (const selector of possibleSelectors) {
      mainProductImage = document.querySelector(selector);
      if (mainProductImage) {
        console.log('Found main product image with selector:', selector);
        break;
      }
    }
    
    if (!mainProductImage) {
      console.warn('Main product image not found with any selector');
      // Debug: log what elements we can find
      console.log('Available product media elements:', document.querySelectorAll('[class*="product__media"]'));
      return;
    }
    
    // Store original image for restoration
    const originalImageSrc = mainProductImage.src;
    console.log('Original image src:', originalImageSrc);
    
    variantSlides.forEach((slide, index) => {
      const variantImg = slide.querySelector('img');
      if (!variantImg) return;
      
      slide.addEventListener('mouseenter', () => {
        console.log(`Hovering over variant ${index + 1}`);
        // Get high-res version of variant image (upgrade from 400x400 to 800x800)
        const variantImageSrc = variantImg.src.replace('400x400', '800x800');
        console.log('Changing to variant image:', variantImageSrc);
        
        // Force image reload by clearing src first, then setting new one
        mainProductImage.style.opacity = '0.7';
        mainProductImage.src = '';
        
        // Use setTimeout to ensure DOM update
        setTimeout(() => {
          mainProductImage.src = variantImageSrc;
          mainProductImage.style.opacity = '1';
          console.log('Image src changed to:', mainProductImage.src);
        }, 10);
      });
      
      slide.addEventListener('mouseleave', () => {
        console.log('Mouse left variant, restoring original image');
        // Force restore original image with same reload technique
        mainProductImage.style.opacity = '0.7';
        mainProductImage.src = '';
        
        setTimeout(() => {
          mainProductImage.src = originalImageSrc;
          mainProductImage.style.opacity = '1';
          console.log('Restored to original image:', mainProductImage.src);
        }, 10);
      });
    });
  }

  document.querySelectorAll('input[name="related_variant_selection"]').forEach(function (radio) {
    radio.addEventListener('change', function (event) {
      var productHandle = event.target.dataset.productHandle;

      // Redirect to the product page with that variant pre-selected
      window.location.href = '/products/' + productHandle;
    });
  });
</script>