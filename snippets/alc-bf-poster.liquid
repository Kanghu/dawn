{%- comment -%}
  One "poster" of sections/alc-black-friday.liquid: a product shown like the Black Friday
  ads (gold seal, red-struck old price, big gold price with raised decimals, gold button).

  Accepts:
  - product: {Object}
  - position: {Number} 0-based, the first three load eagerly
  - section_id: {String}
  - save_label: {String} "You save" in the page language
  - eager: {Boolean} false to load every photo lazily (below the first screen)
  - widths, sizes: {String} the photo's srcset widths and sizes (default: the page's posters)
  - reveal: {Boolean} false in sideways rows (no scroll reveal, like Dawn's sliders)

  The price is cut at its decimal separator so the decimals can sit raised ("79,⁹⁹ lei"):
  the separator is the one ("," or ".") followed by the two cent digits with no digit after
  them, so "1,099.99 €" splits at the dot and "1.099,99 lei" at the comma. Prices without
  decimals ("7 990 Ft") stay whole.
{%- endcomment -%}
{%- liquid
  assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'bf-poster-' | append: section_id | append: '-' | append: product.id

  assign money_full = product.price | money
  assign money_was = product.compare_at_price | money
  if settings.currency_code_enabled
    assign money_full = product.price | money_with_currency
    assign money_was = product.compare_at_price | money_with_currency
  endif

  assign cents = product.price | modulo: 100 | plus: 100 | append: '' | slice: 1, 2
  assign whole = money_full
  assign sep = ''
  assign tail = ''
  for candidate in (1..2)
    if candidate == 1
      assign try_sep = ','
    else
      assign try_sep = '.'
    endif
    assign token = try_sep | append: cents
    unless money_full contains token
      continue
    endunless
    assign cut = money_full | split: token
    assign after = cut[1] | default: ''
    assign after_digits = after | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    if after_digits == after and cut.size < 3
      assign whole = cut[0]
      assign sep = try_sep
      assign tail = after | strip
      break
    endif
  endfor
  comment
    Whole prices ("5.600 Ft"): the currency after the last space still goes small.
  endcomment
  if sep == ''
    assign last_word = money_full | split: ' ' | last
    assign last_digits = last_word | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
    if last_digits == last_word and last_word != money_full
      assign whole = money_full | remove_last: last_word | strip
      assign tail = last_word
    endif
  endif

  assign img_widths = widths | default: '360, 540, 720, 900'
  assign img_sizes = sizes | default: '(min-width: 990px) 400px, (min-width: 750px) 45vw, 80vw'
  assign img_loading = 'lazy'
  if position < 3 and eager != false
    assign img_loading = 'eager'
  endif
-%}
{%- liquid
  assign use_reveal = settings.animations_reveal_on_scroll
  if reveal == false
    assign use_reveal = false
  endif
-%}
<li class="alc-bf__poster{% if use_reveal %} scroll-trigger animate--slide-in{% endif %}"{% if use_reveal %} data-cascade style="--animation-order: {{ position | plus: 1 }};"{% endif %}>
  <article class="alc-bf__card" style="--alc-bf-i: {{ position | modulo: 4 }};">
    <a class="alc-bf__card-media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      <span class="alc-bf__niche">
        {%- if product.featured_media != blank -%}
          {{
            product.featured_media
            | image_url: width: 900
            | image_tag:
              widths: img_widths,
              sizes: img_sizes,
              loading: img_loading,
              alt: '',
              class: 'alc-bf__niche-img'
          }}
        {%- endif -%}
      </span>
      {%- if pct > 0 -%}
        <span class="alc-bf__seal"><span>-{{ pct }}%</span></span>
      {%- endif -%}
    </a>

    <div class="alc-bf__card-body">
      <h3 class="alc-bf__card-title" id="BfTitle-{{ section_id }}-{{ product.id }}">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>

      <div class="alc-bf__prices">
        <s class="alc-bf__was">
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          {{- money_was -}}
        </s>
        <p class="alc-bf__now">
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }} {{ money_full }}</span>
          <span class="alc-bf__amount" aria-hidden="true">
            {%- if sep != '' or tail != '' -%}
              {{- whole -}}
              {%- if sep != '' %}<span class="alc-bf__dec"><span class="alc-bf__sep">{{ sep }}</span>{{ cents }}</span>{% endif -%}
              {%- if tail != '' %}<span class="alc-bf__cur">{{ tail }}</span>{% endif -%}
            {%- else -%}
              {{- money_full -}}
            {%- endif -%}
          </span>
        </p>
        {%- assign saving = product.compare_at_price | minus: product.price -%}
        <p class="alc-bf__save">{{ save_label }} {{ saving | money }}</p>
      </div>

      <product-form class="alc-bf__form" data-section-id="{{ section_id }}">
        {%- form 'product', product, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
          <button
            id="{{ form_id }}-submit"
            type="submit"
            name="add"
            class="alc-bf__buy"
            aria-haspopup="dialog"
            aria-labelledby="{{ form_id }}-submit BfTitle-{{ section_id }}-{{ product.id }}"
            aria-live="polite"
            data-sold-out-message="true"
          >
            <span>{{ 'products.product.add_to_cart' | t }}</span>
            <span class="sold-out-message hidden">{{- 'products.product.sold_out' | t -}}</span>
            <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    </div>
  </article>
</li>
