{%- comment -%}
  Floating "back to top" button for the long campaign pages (sections/alc-offer-page,
  sections/alc-tw-product-grid).

  - Shows up once the visitor has scrolled past the first screen and scrolls back up
    smoothly (instantly with reduced motion), then hands focus to the page's main content.
  - Sits bottom-left: the WhatsApp button and its greeting bubble own the bottom-right.
    The Vitals scroll-to-top widget they cover is hidden on these pages.
  - Steps aside while the cart drawer, the menu, search or a modal is open, since the
    header's menu stacks below any fixed element.
  - One per page even if two sections render it. Text translated for every storefront language.
{%- endcomment -%}
{%- liquid
  assign btt_lang = request.locale.iso_code | downcase | slice: 0, 2
  case btt_lang
    when 'en'
      assign btt_label = 'Back to top'
    when 'hu'
      assign btt_label = 'Vissza a tetejére'
    when 'pl'
      assign btt_label = 'Powrót na górę'
    when 'el'
      assign btt_label = 'Επιστροφή στην κορυφή'
    when 'bg'
      assign btt_label = 'Към началото'
    when 'it'
      assign btt_label = 'Torna su'
    when 'fr'
      assign btt_label = 'Retour en haut'
    when 'cs'
      assign btt_label = 'Zpět nahoru'
    when 'sk'
      assign btt_label = 'Späť hore'
    when 'hr'
      assign btt_label = 'Natrag na vrh'
    when 'de'
      assign btt_label = 'Nach oben'
    else
      assign btt_label = 'Înapoi sus'
  endcase
-%}
<alc-back-to-top class="alc-btt">
  <button type="button" class="alc-btt__button" aria-label="{{ btt_label }}" title="{{ btt_label }}">
    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
  </button>
</alc-back-to-top>

<style>
  .alc-btt {
    position: fixed;
    left: calc(20px + env(safe-area-inset-left, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 900;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.94);
    transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 0.28s;
  }

  .alc-btt.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  body[class*='overflow-hidden'] .alc-btt.is-visible,
  body:has(cart-drawer.active) .alc-btt.is-visible,
  body:has(.section-header details[open]) .alc-btt.is-visible {
    opacity: 0;
    visibility: hidden;
  }

  .alc-btt__button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(21, 21, 21, 0.86);
    color: #fff;
    cursor: pointer;
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    box-shadow: 0 6px 18px rgba(21, 21, 21, 0.18);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.18s ease, background-color 0.2s ease;
  }

  .alc-btt__button svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .alc-btt__button:active {
    transform: scale(0.94);
  }

  .alc-btt__button:focus-visible {
    outline: 2px solid #151515;
    outline-offset: 3px;
    box-shadow: 0 6px 18px rgba(21, 21, 21, 0.18);
  }

  @media (hover: hover) and (pointer: fine) {
    .alc-btt__button:hover {
      background: #151515;
    }

    .alc-btt__button:hover svg {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .alc-btt,
    .alc-btt__button,
    .alc-btt__button svg {
      transition: none;
    }
  }

  @media print {
    .alc-btt {
      display: none;
    }
  }

  .vtl-st-main-widget {
    display: none !important;
  }
</style>

<script>
  (() => {
    if (customElements.get('alc-back-to-top')) return;

    class AlcBackToTop extends HTMLElement {
      connectedCallback() {
        if (document.querySelector('alc-back-to-top') !== this) {
          this.remove();
          return;
        }
        this.onScroll = () => {
          if (this.ticking) return;
          this.ticking = true;
          requestAnimationFrame(() => {
            this.ticking = false;
            this.update();
          });
        };
        window.addEventListener('scroll', this.onScroll, { passive: true });
        this.querySelector('button').addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          document.getElementById('MainContent')?.focus({ preventScroll: true });
        });
        this.update();
      }

      disconnectedCallback() {
        if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
      }

      // Visible once the first screen has scrolled away.
      update() {
        this.classList.toggle('is-visible', window.scrollY > window.innerHeight);
      }
    }

    customElements.define('alc-back-to-top', AlcBackToTop);
  })();
</script>
