{% comment %}
  Mobile / tablet menu drawer (below 990px). Rendered by sections/alc-header.liquid.

  Dawn's <header-drawer> (assets/global.js) still opens/closes the drawer through the
  outer <details id="Details-menu-drawer-container">. Everything inside it is the
  .alc-md UI (assets/alc-mobile-menu.css + assets/alc-mobile-menu.js), which uses no
  nested <details>, so Dawn's MenuDrawer only ever handles the main toggle:
  - Tabs: one per header "drawer_menu_item" block (same locale_codes filter as desktop).
  - 3-level menus: 2-column tiles of the 2nd-level collections. A tile with children
    slides in a sub-panel: "view all" + the 3rd-level links as an accordion that
    reveals their 4th-level links. Campaign collections (custom.is_campaign) show as
    a full-width image.
  - Other menus: a plain list.

  Accepts:
  - all_blocks: header section blocks
  - menu_color_scheme: colour scheme of the drawer
  - menu_gradient_start / _middle / _end: kept for caller compatibility
{% endcomment %}
{{ 'alc-mobile-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alc-mobile-menu.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign view_all_label = 'sections.featured_collection.view_all' | t
  assign back_label = 'general.back' | t
-%}

<header-drawer data-breakpoint="{% if menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}" class="overflow-hidden">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        {{ 'icon-hamburger.svg' | inline_asset_content }}
        {{ 'icon-close.svg' | inline_asset_content }}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ menu_color_scheme }} alc-md-drawer">
      <div class="alc-md" data-alc-md>
        {%- comment -%} Tabs {%- endcomment -%}
        <div class="alc-md__tabs" role="tablist" aria-label="{{ 'sections.header.menu' | t | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for block_item in all_blocks -%}
            {%- if block_item.type != 'drawer_menu_item' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign show_item = true
              if block_item.settings.locale_codes != blank
                assign show_item = false
                assign locale_codes = block_item.settings.locale_codes | split: ','
                for code in locale_codes
                  assign trimmed_code = code | strip
                  if trimmed_code == request.locale.iso_code
                    assign show_item = true
                    break
                  endif
                endfor
              endif
            -%}
            {%- unless show_item -%}{%- continue -%}{%- endunless -%}
            <button
              type="button"
              class="alc-md__tab"
              role="tab"
              id="AlcMdTabBtn-{{ block_item.id }}"
              aria-controls="AlcMdTab-{{ block_item.id }}"
              aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
              {% if tab_index != 0 %}tabindex="-1"{% endif %}
              data-alc-md-tab
            >
              {{- block_item.settings.menu_label -}}
            </button>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Tab panels {%- endcomment -%}
        <div class="alc-md__views" data-alc-md-views>
          {%- assign tab_index = 0 -%}
          {%- for block_item in all_blocks -%}
            {%- if block_item.type != 'drawer_menu_item' -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign show_item = true
              if block_item.settings.locale_codes != blank
                assign show_item = false
                assign locale_codes = block_item.settings.locale_codes | split: ','
                for code in locale_codes
                  assign trimmed_code = code | strip
                  if trimmed_code == request.locale.iso_code
                    assign show_item = true
                    break
                  endif
                endfor
              endif
            -%}
            {%- unless show_item -%}{%- continue -%}{%- endunless -%}
            {%- assign top_menu = linklists[block_item.settings.menu_handle] -%}
            <section
              class="alc-md__view"
              id="AlcMdTab-{{ block_item.id }}"
              role="tabpanel"
              aria-labelledby="AlcMdTabBtn-{{ block_item.id }}"
              data-alc-md-view
              {% if tab_index != 0 %}hidden{% endif %}
            >
              {%- if block_item.settings.display_type == '3-level' -%}
                <ul class="alc-md__tiles" role="list">
                  {%- for link in top_menu.links -%}
                    {%- liquid
                      assign is_campaign = false
                      if link.object and link.object.metafields.custom.is_campaign
                        assign is_campaign = true
                      endif
                      assign sub_id = 'AlcMdSub-' | append: block_item.id | append: '-' | append: forloop.index
                    -%}
                    {%- if is_campaign -%}
                      <li class="alc-md__tiles-wide">
                        <a href="{{ link.url }}" class="alc-md__campaign">
                          {%- if link.object.image -%}
                            <img
                              src="{{ link.object.image | image_url: width: 750 }}"
                              srcset="{{ link.object.image | image_url: width: 400 }} 400w, {{ link.object.image | image_url: width: 750 }} 750w, {{ link.object.image | image_url: width: 1000 }} 1000w"
                              sizes="calc(100vw - 32px)"
                              width="{{ link.object.image.width }}"
                              height="{{ link.object.image.height }}"
                              alt="{{ link.title | escape }}"
                              loading="lazy"
                              decoding="async"
                            >
                          {%- else -%}
                            <span>{{ link.title | escape }}</span>
                          {%- endif -%}
                        </a>
                      </li>
                    {%- else -%}
                      <li>
                        {%- if link.links.size > 0 -%}
                          <button type="button" class="alc-md__tile" data-alc-md-open="{{ sub_id }}" aria-controls="{{ sub_id }}" aria-expanded="false">
                        {%- else -%}
                          <a href="{{ link.url }}" class="alc-md__tile">
                        {%- endif -%}
                          <span class="alc-md__tile-media">
                            {%- if link.object.image -%}
                              <img
                                src="{{ link.object.image | image_url: width: 360 }}"
                                srcset="{{ link.object.image | image_url: width: 180 }} 180w, {{ link.object.image | image_url: width: 360 }} 360w, {{ link.object.image | image_url: width: 540 }} 540w"
                                sizes="(min-width: 750px) 25vw, 45vw"
                                width="180"
                                height="180"
                                alt=""
                                loading="lazy"
                                decoding="async"
                              >
                            {%- endif -%}
                          </span>
                          <span class="alc-md__tile-label">
                            <span>{{ link.title | escape }}</span>
                            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                          </span>
                        {%- if link.links.size > 0 -%}
                          </button>
                        {%- else -%}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <ul class="alc-md__list" role="list">
                  {%- for link in top_menu.links -%}
                    {%- assign row_desc = link.object.metafields.custom.menu_description.value -%}
                    <li>
                      <a href="{{ link.url }}" class="alc-md__row">
                        <span class="alc-md__row-icon">{%- render 'alc-menu-icon', link: link -%}</span>
                        <span class="alc-md__row-text">
                          <span>{{ link.title | escape }}</span>
                          {%- if row_desc != blank -%}
                            <span class="alc-md__row-desc">{{ row_desc | escape }}</span>
                          {%- endif -%}
                        </span>
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </section>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Sub-panels (2nd-level collections that have children) {%- endcomment -%}
        {%- for block_item in all_blocks -%}
          {%- if block_item.type != 'drawer_menu_item' or block_item.settings.display_type != '3-level' -%}{%- continue -%}{%- endif -%}
          {%- assign top_menu = linklists[block_item.settings.menu_handle] -%}
          {%- for link in top_menu.links -%}
            {%- if link.links.size == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign sub_id = 'AlcMdSub-' | append: block_item.id | append: '-' | append: forloop.index -%}
            <section class="alc-md__sub" id="{{ sub_id }}" aria-label="{{ link.title | escape }}" data-alc-md-sub hidden>
              <div class="alc-md__sub-head">
                <button type="button" class="alc-md__back" data-alc-md-back>
                  <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
                  <span>{{ back_label }}</span>
                </button>
                <span class="alc-md__sub-title">{{ link.title | escape }}</span>
              </div>

              <div class="alc-md__sub-body">
                <a href="{{ link.url }}" class="alc-md__all">
                  {%- if link.object.image -%}
                    <span class="alc-md__all-media">
                      <img
                        src="{{ link.object.image | image_url: width: 160 }}"
                        width="56"
                        height="56"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      >
                    </span>
                  {%- endif -%}
                  <span class="alc-md__all-text">
                    <span class="alc-md__all-title">{{ link.title | escape }}</span>
                    <span class="alc-md__all-cta">{{ view_all_label }}</span>
                  </span>
                  <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>

                <ul class="alc-md__acc" role="list">
                  {%- for childlink in link.links -%}
                    {%- assign acc_id = sub_id | append: '-' | append: forloop.index -%}
                    <li class="alc-md__acc-item">
                      {%- if childlink.links.size > 0 -%}
                        <button type="button" class="alc-md__acc-head" aria-expanded="false" aria-controls="{{ acc_id }}" data-alc-md-acc>
                      {%- else -%}
                        <a href="{{ childlink.url }}" class="alc-md__acc-head">
                      {%- endif -%}
                        <span class="alc-md__acc-thumb">
                          {%- if childlink.object.image -%}
                            <img
                              src="{{ childlink.object.image | image_url: width: 120 }}"
                              width="44"
                              height="44"
                              alt=""
                              loading="lazy"
                              decoding="async"
                            >
                          {%- endif -%}
                        </span>
                        <span class="alc-md__acc-title">{{ childlink.title | escape }}</span>
                        {%- if childlink.links.size > 0 -%}
                          <span class="alc-md__acc-count">{{ childlink.links.size }}</span>
                          <svg class="alc-md__acc-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        {%- else -%}
                          <svg class="alc-md__acc-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                        {%- endif -%}
                      {%- if childlink.links.size > 0 -%}
                        </button>
                        <div class="alc-md__acc-body" id="{{ acc_id }}" hidden>
                          <ul class="alc-md__chips" role="list">
                            <li>
                              <a href="{{ childlink.url }}" class="alc-md__chip alc-md__chip--all">{{ view_all_label }}</a>
                            </li>
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a href="{{ grandchildlink.url }}" class="alc-md__chip">{{ grandchildlink.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </section>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </details>
</header-drawer>

{%- comment -%}
  Legacy global rules. The previous drawer shipped these unscoped, so they have been
  styling the whole site ever since (icon wrappers, list resets). Kept byte-for-byte so
  nothing outside the menu changes; remove only after checking every page.
{%- endcomment -%}
<style>
  ul {
    padding-left: 1rem;
    margin-left: 0;
  }

  li {
    list-style: none;
  }

  body.menu-open {
    overflow: hidden !important;
    position: fixed !important;
    width: 100% !important;
  }

  .svg-wrapper {
    width: 28px;
    height: 28px;
    transition: transform 0.2s ease;
  }

  .transform.rotate-90 {
    transform: rotate(90deg);
  }

  .transform.-rotate-90 {
    transform: rotate(-90deg);
  }

  .svg-wrapper svg.icon-chevron {
    color: #6b7280;
    /* Gray color for chevrons */
    transition: color 0.2s ease
    , transform 0.2s ease;
  }
</style>
