{% comment %}
  Cart summary shared by the cart drawer (snippets/cart-drawer.liquid) and the cart page
  (sections/main-cart-footer.liquid).

  What it shows, top to bottom:
  - progress towards free delivery (threshold per shipping zone, see assets/alc-cart.js);
  - subtotal, total saved on discounted items, shipping cost (asked from Shopify for the
    visitor's country so it matches checkout), and the estimated total;
  - the estimated delivery window (2-4 working days, same promise as the product page);
  - the checkout button and a quiet trust row (secure payment, 14-day returns, methods).

  Both containers are re-rendered by Dawn's cart JS after every change, so the numbers
  come from Liquid and <alc-cart-summary> recomputes the shipping part on connect.

  Accepts:
  - form_id: {String} id of the cart form the checkout button submits
  - button_id: {String} id for the checkout button (Dawn's JS looks it up)

  Usage:
  {% render 'alc-cart-summary', form_id: 'CartDrawer-Form', button_id: 'CartDrawer-Checkout' %}
{% endcomment %}
{%- liquid
  assign savings = 0
  for item in cart.items
    if item.variant.compare_at_price > item.original_price
      assign item_saving = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
      assign savings = savings | plus: item_saving
    endif
  endfor
  assign savings = savings | plus: cart.total_discount
  assign savings_money = savings | money

  capture t_free_left
    render 'alc-i18n', key: 'cart_free_left'
  endcapture
  capture t_free_ok
    render 'alc-i18n', key: 'cart_free_ok'
  endcapture
  capture t_free
    render 'alc-i18n', key: 'cart_free'
  endcapture
  capture t_at_checkout
    render 'alc-i18n', key: 'cart_at_checkout'
  endcapture
-%}
<alc-cart-summary
  class="alc-csum"
  data-total="{{ cart.total_price }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-money="{{ 123456 | money | escape }}"
  data-t-free-left="{{ t_free_left | strip | escape }}"
  data-t-free-ok="{{ t_free_ok | strip | escape }}"
  data-t-free="{{ t_free | strip | escape }}"
  data-t-at-checkout="{{ t_at_checkout | strip | escape }}"
>
  {%- if cart != empty -%}
    <div class="alc-csum__goal" data-goal hidden>
      <p class="alc-csum__goal-text" data-goal-text></p>
      <div class="alc-csum__goal-track" aria-hidden="true"><span class="alc-csum__goal-fill" data-goal-fill></span></div>
    </div>

    <dl class="alc-csum__rows">
      <div class="alc-csum__row">
        <dt>{% render 'alc-i18n', key: 'cart_subtotal' %}</dt>
        <dd data-subtotal>{{ cart.items_subtotal_price | money }}</dd>
      </div>
      {%- if cart.cart_level_discount_applications.size > 0 -%}
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="alc-csum__row alc-csum__row--discount">
            <dt>{{ discount.title | escape }}</dt>
            <dd>-{{ discount.total_allocated_amount | money }}</dd>
          </div>
        {%- endfor -%}
      {%- endif -%}
      <div class="alc-csum__row">
        <dt>{% render 'alc-i18n', key: 'cart_shipping' %}</dt>
        <dd data-shipping><span class="alc-csum__pending" aria-hidden="true"></span></dd>
      </div>
      <div class="alc-csum__row alc-csum__row--total" role="status">
        <dt>{{ 'sections.cart.estimated_total' | t }}</dt>
        <dd data-grand-total>{{ cart.total_price | money }}</dd>
      </div>
    </dl>

    {%- if savings > 0 -%}
      <p class="alc-csum__saving">{{ 'alc-benefits.savings' | t: amount: savings_money }}</p>
    {%- endif -%}

    <p class="alc-csum__eta" data-eta hidden>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5h11v9H3zM14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
      <span>{% render 'alc-i18n', key: 'cart_eta' %}: <strong data-eta-text></strong></span>
    </p>
  {%- endif -%}

  <button
    type="submit"
    id="{{ button_id }}"
    class="cart__checkout-button button alc-csum__checkout"
    name="checkout"
    form="{{ form_id }}"
    {% if cart == empty %}disabled{% endif %}
  >
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/></svg>
    {{ 'sections.cart.checkout' | t }}
  </button>

  {%- if cart != empty -%}
    <ul class="alc-csum__trust" role="list">
      <li>
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
        {% render 'alc-i18n', key: 'cart_secure' %}
      </li>
      <li>
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11a5 5 0 0 1 0 10h-3"/><path d="m8 6-4 4 4 4"/></svg>
        {{ 'alc-benefits.return_policy' | t }}
      </li>
    </ul>
    {%- comment -%}
      Cards go through NETOPIA / Viva (not reported in shop.enabled_payment_types, which only
      lists PayPal here), so the methods customers actually get are listed explicitly.
    {%- endcomment -%}
    <ul class="alc-csum__pay" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
      {%- assign pay_types = 'visa,master,maestro,paypal' | split: ',' -%}
      {%- for type in pay_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'alc-csum__pay-icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</alc-cart-summary>
