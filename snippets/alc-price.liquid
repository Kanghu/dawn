{% comment %}
  Renders a list of product's price (regular, sale)

  New/Updated Accepts:
  - product: {Object} Product Liquid object (optional)
  - section: {Object} Section object for accessing enhanced price settings (optional)
  - placeholder: {Boolean} Renders a placeholder price (optional)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - show_badges: {Boolean} Renders 'Sale' and 'Sold Out' tags if the product matches the condition (optional)
  - price_class: {String} Adds a price class to the price element (optional)
  - show_compare_at_price: {Boolean} Renders the compare at price if the product matches the condition (optional)

  Added/Enhanced:
  - price_layout: {String} "side-by-side" (default) or "stacked"
  - bold_current_price: {Boolean} Makes the current price bold if true
  - normal_price_color: {Color} CSS color for the normal price text
  - compare_price_color: {Color} CSS color for the compare-at price text
  - sale_badge_text: {String} Replaces default "Sale" text
  - Show difference between compare_at_price and price on a separate badge
  - Enhanced price display settings from theme editor (when section is passed)
{% endcomment %}

<style>
  .price {
    margin-bottom: 0;
  }
</style>

{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  elsif placeholder
    assign target = null
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign price_min = product.price_min
  assign price_max = product.price_max
  assign available = target.available | default: false

  assign money_price = price | money
  assign money_price_min = price_min | money
  assign money_price_max = price_max | money

  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
  endif

  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  comment
    EUR conversion for Bulgarian locale
    BGN to EUR conversion rate: approximately 1.95 BGN = 1 EUR
  endcomment
  assign show_eur_price = false
  assign eur_price = 0
  assign eur_compare_at_price = 0
  assign eur_money_price = ''
  assign eur_compare_price_money = ''

  if request.locale.iso_code == 'bg'
    assign show_eur_price = true
    assign bgn_to_eur_rate = 1.955
    assign eur_price = price | divided_by: bgn_to_eur_rate | round: 2
    assign eur_money_price = eur_price | money_without_currency | append: ' €'

    if compare_at_price > 0
      assign eur_compare_at_price = compare_at_price | divided_by: bgn_to_eur_rate | round: 2
      assign eur_compare_price_money = eur_compare_at_price | money_without_currency | append: ' €'
    endif
  endif

  # Enhanced price display settings from theme editor
  assign enable_enhanced_price = false
  assign enable_price_border = false
  assign enable_super_price_badge = false
  assign price_bg_start = '#ff1744'
  assign price_bg_end = '#ff6b00'
  assign price_border_color = '#ff1744'
  assign super_price_badge_text = '💸 SUPER PREȚ!'
  assign super_badge_bg_start = '#ff6b00'
  assign super_badge_bg_end = '#e65100'
  assign super_badge_text_color = '#ffffff'

  if section
    assign enable_enhanced_price = section.settings.enable_enhanced_price | default: false
    assign enable_price_border = section.settings.enable_price_border | default: false
    assign enable_super_price_badge = section.settings.enable_super_price_badge | default: false
    assign price_bg_start = section.settings.price_bg_start | default: '#ff1744'
    assign price_bg_end = section.settings.price_bg_end | default: '#ff6b00'
    assign price_border_color = section.settings.price_border_color | default: '#ff1744'
    assign super_price_badge_text = section.settings.super_price_badge_text | default: '💸 SUPER PREȚ!'
    assign super_badge_bg_start = section.settings.super_badge_bg_start | default: '#ff6b00'
    assign super_badge_bg_end = section.settings.super_badge_bg_end | default: '#e65100'
    assign super_badge_text_color = section.settings.super_badge_text_color | default: '#ffffff'
  endif
-%}

{%- unless target == null and placeholder == null -%}
  {%- comment -%}
    Determine if there's a sale (compare_at_price > price) and compute the difference.
    We'll display this difference as a separate badge if show_badges is true.
  {%- endcomment -%}
  {% assign show_sale_badge = false %}
  {% assign price_diff = 0 %}
  {% if compare_at_price > price %}
    {% assign show_sale_badge = true %}
    {% assign price_diff = compare_at_price | minus: price %}
{% endif %}

  {%- comment -%}
    Prepare the "Sale" text and difference amount for badges.
  {%- endcomment -%}
  {% assign custom_sale_text = block.settings.sale_badge_text | default: 'Sale' %}
  {% assign diff_money = '' %}
  {% if show_sale_badge %}
    {% assign diff_money = price_diff | money %}
    {% if settings.currency_code_enabled %}
      {% assign diff_money = price_diff | money_with_currency %}
    {% endif %}
  {% endif %}

  {%- comment -%}
    Dynamically apply Tailwind classes depending on layout choice:
    - "side-by-side": display flex row
    - "stacked": display flex column
  {%- endcomment -%}
  <div class="
      price
      {% if block.settings.price_layout == 'stacked' %}
        flex flex-col items-start
      {% else %}
        flex flex-row items-baseline gap-2 justify-between
      {% endif %}
      {%- if price_class %} {{ price_class }}{% endif -%}
      {%- if available == false %} price--sold-out{% endif -%}
      {%- if compare_at_price > price and product.quantity_price_breaks_configured? != true %} price--on-sale{% endif -%}
      {%- if compare_at_price > price and product.quantity_price_breaks_configured? %} volume-pricing--sale-badge{% endif -%}
      {%- if product.price_varies == false and product.compare_at_price_varies %} price--no-compare{% endif -%}
      {%- if show_badges %} price--show-badge{% endif -%}
    "
    {%- if enable_enhanced_price -%}
      style="
        background: linear-gradient(135deg, {{ price_bg_start }}, {{ price_bg_end }});
        color: white;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        margin: 1rem 0;
        position: relative;
        {% if enable_price_border %}border: 2px solid {{ price_border_color }};{% endif %}
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      "
    {%- endif -%}>
    <div class="price__container flex flex-col">
      {%- comment -%} Super price badge {%- endcomment -%}
      {%- if enable_super_price_badge -%}
        <div class="super-price-badge" style="
          background: linear-gradient(135deg, {{ super_badge_bg_start }}, {{ super_badge_bg_end }});
          color: {{ super_badge_text_color }};
          padding: 0.5rem 1rem;
          border-radius: 20px;
          text-align: center;
          font-weight: 700;
          font-size: 0.875rem;
          margin-bottom: 0.75rem;
          animation: pulse 2s infinite;
        ">
          {{ super_price_badge_text }}
        </div>
      {%- endif -%}

      {%- comment -%}
        ======================
        REGULAR PRICE SECTION
        ======================
      {%- endcomment -%}
      <div class="price__regular inline-block" style="color: {{ block.settings.normal_price_color }};">
        {%- if product.quantity_price_breaks_configured? -%}
          {%- if show_compare_at_price and compare_at_price -%}
            {%- unless product.price_varies == false and product.compare_at_price_varies %}

              <span class="visually-hidden visually-hidden--inline">
                {{ 'products.product.price.regular_price' | t }}
              </span>
              <span>
                <s class="price-item price-item--regular variant-item__old-price line-through" style="color: {{ block.settings.compare_price_color }};">
                  {% if settings.currency_code_enabled %}
                    {{ compare_at_price | money_with_currency }}
                  {% else %}
                    {{ compare_at_price | money }}
                  {% endif %}
                </s>

                {%- comment -%} Display EUR compare price for volume pricing in Bulgarian locale {%- endcomment -%}
                {% if show_eur_price and compare_at_price > 0 %}
                  <s class="text-sm text-gray-500 line-through ml-2">
                    ({{ eur_compare_price_money }})
                  </s>
                {% endif %}
              </span>
            {%- endunless -%}
          {%- endif -%}
          <span class="visually-hidden visually-hidden--inline">
            {{ 'products.product.price.regular_price' | t }}
          </span>
          <span class="price-item price-item--regular">
            {{-
              'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max
            -}}
          </span>

          {%- comment -%} Display EUR volume pricing for Bulgarian locale {%- endcomment -%}
          {% if show_eur_price %}
            {% assign eur_price_min = price_min | divided_by: bgn_to_eur_rate | round: 2 %}
            {% assign eur_price_max = price_max | divided_by: bgn_to_eur_rate | round: 2 %}
            {% assign eur_money_price_min = eur_price_min | money_without_currency | append: ' €' %}
            {% assign eur_money_price_max = eur_price_max | money_without_currency | append: ' €' %}
            <div class="eur-price-display text-base text-gray-600 mt-1">
              ({{ eur_money_price_min }} - {{ eur_money_price_max }})
            </div>
          {% endif %}
        {%- else -%}
          <span class="visually-hidden visually-hidden--inline">
            {{ 'products.product.price.regular_price' | t }}
          </span>

          {%- comment -%} If bold_current_price is true, wrap price in <strong> {%- endcomment -%}
          {% if block.settings.bold_current_price == true %}
            <strong class="price-item text-4xl price-item--regular">
              {{ money_price }}
            </strong>
          {% else %}
            <span class="price-item text-4xl price-item--regular">
              {{ money_price }}
            </span>
          {% endif %}

          {%- comment -%} Display EUR price for Bulgarian locale {%- endcomment -%}
          {% if show_eur_price %}
            <div class="eur-price-display text-base text-gray-600 mt-1">
              ({{ eur_money_price }})
            </div>
          {% endif %}
        {%- endif -%}
      </div>

      {%- comment -%}
        ==================
        SALE PRICE SECTION
        ==================
      {%- endcomment -%}
      <div
        class="price__sale inline-block mt-1"
        {%- if compare_at_price > price -%}
        style="color: {{ block.settings.normal_price_color }};"
        {%- endif -%}>
        {%- unless product.price_varies == false and product.compare_at_price_varies %}
          <span class="visually-hidden visually-hidden--inline">
            {{ 'products.product.price.regular_price' | t }}
          </span>
          <span class="flex flex-col">
            <span class="inline-flex items-center">
              <s class="price-item price-item--regular line-through font-bold" style="color: {{ block.settings.compare_price_color }}; font-size: 1.5rem;">
                {% if settings.currency_code_enabled %}
                  {{ compare_at_price | money_with_currency }}
                {% else %}
                  {{ compare_at_price | money }}
                {% endif %}
              </s>

              {%- comment -%} Display EUR compare price for Bulgarian locale {%- endcomment -%}
              {% if show_eur_price and compare_at_price > 0 %}
                <s class="text-sm text-gray-500 line-through ml-2">
                  ({{ eur_compare_price_money }})
                </s>
              {% endif %}

              {%- comment -%}
                In STACKED layout, show the difference badge *immediately* next to compare price
              {%- endcomment -%}
              {% if block.settings.price_layout == 'stacked' and show_sale_badge and block.settings.difference_display_style == 'badge'
              %}
                <span style="
                    background-color: {{ block.settings.difference_price_color }};
                    color: {{ block.settings.difference_price_text_color }};
                  " class="
                    badge
                    price__badge-diff
                    mb-0
                  ">
                  - {{ diff_money }}
                </span>
              {% endif %}
            </span>
          </span>
        {%- endunless -%}
        <span class="visually-hidden visually-hidden--inline">
          {{ 'products.product.price.sale_price' | t }}
        </span>

        {%- comment -%} Apply bold if requested {%- endcomment -%}
        {% if block.settings.bold_current_price == true %}
          <strong class="price-item price-item--sale price-item--last ml-1" style="font-size: 2.5rem;">
            {{ money_price }}
          </strong>
        {% else %}
          <span class="price-item price-item--sale price-item--last ml-1" style="font-size: 2.5rem;">
            {{ money_price }}
          </span>
        {% endif %}

        {%- comment -%} Display EUR sale price for Bulgarian locale {%- endcomment -%}
        {% if show_eur_price %}
          <div class="eur-price-display text-lg text-gray-600 mt-1">
            ({{ eur_money_price }})
          </div>
        {% endif %}
      </div>

      {% if show_sale_badge and block.settings.difference_display_style == 'text' %}
        <div class="price-difference-text text-lg font-bold" style="color: black;">{{ 'alc-benefits.savings' | t: amount: diff_money }}</div>
      {% endif %}

    </div>

    {%- comment -%}
      BADGES (Sale + Sold Out)
    {%- endcomment -%}
    {%- if show_badges -%}
      {% if show_sale_badge %}
        {% if block.settings.difference_display_style == 'badge' and block.settings.price_layout == 'side-by-side' %}
          <span class="badge price__badge-diff ml-2 text-sm" style="
              color: {{ block.settings.difference_price_text_color }};
              background-color: {{ block.settings.difference_price_color }};
            ">
            <strong>{{ 'alc-benefits.savings' | t: amount: diff_money }}</strong>
          </span>
        {% endif %}

        {% if product.metafields.custom.featured_campaign.value %}
          <span style="
            color: {{ block.settings.badge_sale_text_color }};
            background-color: {{ block.settings.badge_sale_color }};
            border-radius: 5px;
          " class="badge price__badge-sale">
            {{ product.metafields.custom.featured_campaign.value.title | upcase }}
          </span>
        {% endif %}
      {% endif %}

      <span class="badge price__badge-sold-out color-{{ settings.sold_out_badge_color_scheme }} ml-2">
        {{ 'products.product.sold_out' | t }}
      </span>
    {%- endif -%}
  </div>
{% endunless %}

<script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>