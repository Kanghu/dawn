{%- comment -%}
  Renders the Product JSON-LD for a product page.

  Replaces Shopify's `{{ product | structured_data }}` (which cannot be
  extended) with an equivalent block that additionally carries:
  - aggregateRating  - from the standard reviews metafields
                       (product.metafields.reviews.rating / rating_count),
                       which review apps such as Vitals keep in sync
  - review[]         - from a JSON metafield (product.metafields.custom.reviews_json)
                       holding a list of objects: { "author", "date", "body", "rating" }
                       Individual reviews are only emitted when this metafield exists.

  Accepts:
  - product: {Object} the product to describe. Default: product
  - max_images: {Number} how many product images to list. Default: 6
  - max_reviews: {Number} how many individual reviews to list. Default: 20
{%- endcomment -%}

{%- liquid
  assign max_images = max_images | default: 6
  assign max_reviews = max_reviews | default: 20

  assign variant = product.selected_or_first_available_variant | default: product.first_available_variant | default: product.variants.first
  assign product_url = request.origin | append: product.url
  assign currency = cart.currency.iso_code | default: shop.currency
  assign description = product.description | strip_html | strip_newlines | strip

  assign category_name = ''
  if product.category and product.category.name != blank
    assign category_name = product.category.name
  elsif product.type != blank
    assign category_name = product.type
  endif

  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count | plus: 0
  assign has_rating = false
  if rating_value != blank and rating_count > 0
    assign has_rating = true
  endif

  assign review_list = product.metafields.custom.reviews_json.value
  assign has_reviews = false
  if review_list != blank and review_list.size > 0
    assign has_reviews = true
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ product_url | append: '#product' | json }},
    "url": {{ product_url | json }},
    "name": {{ product.title | strip_html | json }},
    {%- if description != blank %}
    "description": {{ description | json }},
    {%- endif %}
    {%- if product.vendor != blank %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    {%- endif %}
    {%- if category_name != blank %}
    "category": {{ category_name | json }},
    {%- endif %}
    {%- if variant.sku != blank %}
    "sku": {{ variant.sku | json }},
    {%- endif %}
    {%- if variant.barcode != blank %}
    "gtin": {{ variant.barcode | json }},
    {%- endif %}
    {%- if product.images.size > 0 %}
    "image": [
      {%- for image in product.images limit: max_images -%}
        {{ image | image_url: width: 1920 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif %}
    {%- if has_rating %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating_value.rating | json }},
      "bestRating": {{ rating_value.scale_max | default: 5 | json }},
      "worstRating": {{ rating_value.scale_min | default: 1 | json }},
      "ratingCount": {{ rating_count | json }},
      "reviewCount": {{ rating_count | json }}
    },
    {%- endif %}
    {%- if has_reviews %}
    "review": [
      {%- for item in review_list limit: max_reviews -%}
        {
          "@type": "Review",
          "author": {
            "@type": "Person",
            "name": {{ item.author | default: 'Client' | json }}
          },
          {%- if item.date != blank %}
          "datePublished": {{ item.date | date: '%Y-%m-%d' | json }},
          {%- endif %}
          {%- if item.body != blank %}
          "reviewBody": {{ item.body | strip_html | json }},
          {%- endif %}
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": {{ item.rating | default: 5 | json }},
            "bestRating": {{ rating_value.scale_max | default: 5 | json }},
            "worstRating": {{ rating_value.scale_min | default: 1 | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif %}
    "offers": {%- if product.variants.size > 1 -%}[
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          "@id": {{ product_url | append: '?variant=' | append: v.id | append: '#offer' | json }},
          "url": {{ product_url | append: '?variant=' | append: v.id | json }},
          {%- if v.title != 'Default Title' %}
          "name": {{ v.title | json }},
          {%- endif %}
          {%- if v.sku != blank %}
          "sku": {{ v.sku | json }},
          {%- endif %}
          {%- if v.barcode != blank %}
          "gtin": {{ v.barcode | json }},
          {%- endif %}
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ currency | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "availability": {% if v.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]{%- else -%}{
      "@type": "Offer",
      "@id": {{ product_url | append: '?variant=' | append: variant.id | append: '#offer' | json }},
      "url": {{ product_url | append: '?variant=' | append: variant.id | json }},
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ currency | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
    }{%- endif %}
  }
</script>
