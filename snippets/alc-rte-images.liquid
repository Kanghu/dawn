{%- comment -%}
  Echoes rich text `html` (product descriptions, articles, pages) with lighter <img> tags.
  Editors paste Files images by their bare cdn.shopify.com URL, so every visitor used to
  download the original upload: up to 5920px / 2 MB, even on a 360px-wide phone.

  - Every <img> without a loading attribute gets loading="lazy".
  - An <img> whose src is a file from Content > Files, and that sets no width, height or
    srcset of its own, also gets a srcset (see alc-image-srcset), `sizes`, a src capped at
    1080px, and width/height equal to the file's dimensions. `.rte img` has
    max-width: 100% and height: auto, so it lays out exactly like the original upload.

  Tags are cut at their first ">", so an <img> with ">" inside an attribute value only
  gets the lazy loading.

  Outside the primary (Romanian) language, description banners with Romanian text baked
  into the picture are left out; translation can't reach text inside an image. The list
  holds file name stems, so re-uploads with a _<uuid> suffix match too.
  There, links to alessandrodesign.ro also become relative (the Romanian handles redirect to
  the translated ones), and a bare .ro URL used as link text shows the linked collection's or
  article's translated title instead.

  Accepts:
  - html {String}
  - sizes {String} Optional, defaults to the page-width content column

  Usage: {% render 'alc-rte-images', html: product.description %}
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 1300px) 1270px, calc(100vw - 30px)'
  assign hide_ro_banners = false
  unless request.locale.primary
    if html contains 'alessandrodesign.ro/'
      assign html = html | replace: 'href="https://www.alessandrodesign.ro/', 'href="/' | replace: 'href="https://alessandrodesign.ro/', 'href="/' | replace: 'href="http://www.alessandrodesign.ro/', 'href="/'
      if html contains '>https://www.alessandrodesign.ro/'
        assign raw_parts = html | split: '>https://www.alessandrodesign.ro/'
        capture html_local
          for part in raw_parts
            if forloop.first
              echo part
              continue
            endif
            assign raw_path = part | split: '<' | first
            assign raw_rest = part | remove_first: raw_path
            assign raw_bits = raw_path | split: '?' | first | split: '/'
            assign raw_title = ''
            if raw_bits[0] == 'collections'
              assign raw_title = collections[raw_bits[1]].title
            elsif raw_bits[0] == 'blogs'
              assign raw_key = raw_bits[1] | append: '/' | append: raw_bits[2]
              assign raw_title = articles[raw_key].title
            endif
            if raw_title == blank
              assign raw_title = request.host | append: '/' | append: raw_path
            endif
            echo '>' | append: raw_title | append: raw_rest
          endfor
        endcapture
        assign html = html_local
      endif
    endif
  endunless

  assign chunks = html | split: '<img '
  unless request.locale.primary
    assign hide_ro_banners = true
    assign ro_banners = 'banner_lumina_rece_calda_neutra_lustra_led|telecomanda-banner|noapte-banner|banner_20m2_generic|banner-dezaburire-oglinda|banner_general_lustre_led|banner-cutie-oglinda|banner-ceas-termometru-oglinda|banner-3tipuri-lumina-oglinda|banner-capac-pvc-oglinda|banner-senzor-oglinda|banner-led-touch-oglinda|banner-lupa-cosmetica-oglinda|banner-candelabre-bec-|Ideala_pentru_Holuri|banner_desc_|banner-mobilier-creta|banner-iluminat-exterior' | split: '|'
  endunless

  for chunk in chunks
    if forloop.first
      echo chunk
      continue
    endif

    assign tag = chunk | split: '>' | first

    if hide_ro_banners
      assign ro_banner = false
      for stem in ro_banners
        if tag contains stem
          assign ro_banner = true
          break
        endif
      endfor
      if ro_banner
        echo chunk | remove_first: tag | remove_first: '>'
        continue
      endif
    endif
    assign attributes = ''
    unless tag contains 'loading='
      assign attributes = 'loading="lazy" '
    endunless

    assign file_image = nil
    if tag contains 'src="' and tag contains '/files/'
      unless tag contains 'srcset' or tag contains 'width' or tag contains 'height'
        assign src = tag | split: 'src="' | last | split: '"' | first
        if src contains 'cdn.shopify.com/s/files/' or src contains '/cdn/shop/files/'
          assign filename = src | split: '?' | first | split: '/' | last | url_decode
          assign file_image = images[filename]
        endif
      endunless
    endif

    if file_image != blank and file_image.width > 0
      capture srcset
        render 'alc-image-srcset', image: file_image, widths: '360,540,720,900,1080,1296,1512,1728'
      endcapture
      assign fallback_width = 1080 | at_most: file_image.width
      assign fallback_src = file_image | image_url: width: fallback_width | escape
      assign attributes = attributes | append: 'srcset="' | append: srcset | append: '" sizes="' | append: sizes | append: '" '
      assign attributes = attributes | append: 'width="' | append: file_image.width | append: '" height="' | append: file_image.height | append: '" '
      assign after_tag = chunk | remove_first: tag
      assign tag = tag | replace: src, fallback_src
      echo '<img ' | append: attributes | append: tag | append: after_tag
    else
      echo '<img ' | append: attributes | append: chunk
    endif
  endfor
-%}
