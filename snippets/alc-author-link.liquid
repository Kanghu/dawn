{% comment %}
  Renders an author's name, linked to their author page when one exists.

  Same resolution order as snippets/alc-author-box.liquid — metaobject page reference,
  then /pages/<handle>, then /pages/autor-<handle> — kept in one place so the article
  card and the author box can never disagree about where an author lives.

  Accepts:
  - author_name: {String} usually `article.author`
  - link_class: {String} optional class for the anchor
{% endcomment %}

{%- liquid
  assign author_handle = author_name | handle
  assign author = shop.metaobjects.author[author_handle]

  assign author_display_name = author.name.value | default: author_name

  comment
    The author page is the tag archive: every article carries an autor-<handle> tag and
    Shopify paginates the archive with no cap, so it is the only URL that lists an
    author's complete work. The /pages/<author> profile stays as a fallback.
  endcomment
  assign archive_blog_handle = settings.author_blog_1 | default: 'news'
  assign archive_blog = blogs[archive_blog_handle]
  assign author_url = blank
  if archive_blog.url != blank
    assign author_url = archive_blog.url | append: '/tagged/autor-' | append: author_handle
  endif
  if author_url == blank
    assign author_url = author.page.value.url
  endif
  if author_url == blank
    assign author_url = pages[author_handle].url
  endif
-%}

{%- if author_name != blank -%}
  {%- if author_url != blank -%}
    <a class="alc-author-link {{ link_class }}" href="{{ author_url }}" rel="author">
      {{- author_display_name | escape -}}
    </a>
  {%- else -%}
    <span class="{{ link_class }}">{{ author_display_name | escape }}</span>
  {%- endif -%}
{%- endif -%}
