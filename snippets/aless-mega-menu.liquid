{% comment %}
  Desktop header menu (Theme settings > Header > "aless_mega").

  One top-level item per header block:
  - drawer_menu_campaign: a plain highlighted link.
  - drawer_menu_item with display_type '3-level': full-width mega panel. Left: the
    menu's 2nd-level links (collections, with image). Right: the hovered item's
    3rd-level groups and their 4th-level links, or a feature card when it has none.
    A 2nd-level collection with custom.is_campaign shows as an image tile.
  - any other display_type: a compact 2-column dropdown with the 2nd-level links, each
    with an icon (snippets/alc-menu-icon.liquid) and an optional one-line description
    from the page metafield custom.menu_description (single line text, translatable).

  Styles: assets/alc-mega-menu.css. Behaviour: assets/alc-mega-menu.js (hover intent,
  click/touch, keyboard, Esc, click outside). The mobile drawer is a separate snippet.

  Accepts:
  - all_blocks: header section blocks
  - menu_color_scheme, menu_separator_color: kept for caller compatibility
{% endcomment %}
{{ 'alc-mega-menu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alc-mega-menu.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign view_all_label = 'sections.featured_collection.view_all' | t
  assign bar_bg = section.settings.menu_gradient_start | default: '#111111'
-%}
{% assign top_menu = section.settings.menu.links %}
{% if top_menu.size > 0 %}
  <nav class="header__inline-menu alc-mm" style="--alc-mm-bar: {{ bar_bg }};" aria-label="{{ 'sections.header.menu' | t | escape }}">
    <div class="page-width alc-mm__bar-inner">
      <ul class="alc-mm__list" role="list">
        {%- for block_item in all_blocks -%}
          {%- liquid
            assign show_item = true
            if block_item.settings.locale_codes != blank
              assign show_item = false
              assign locale_codes = block_item.settings.locale_codes | split: ','
              for code in locale_codes
                assign trimmed_code = code | strip
                if trimmed_code == request.locale.iso_code
                  assign show_item = true
                  break
                endif
              endfor
            endif
          -%}
          {%- unless show_item -%}{%- continue -%}{%- endunless -%}

          {%- if block_item.type == 'drawer_menu_campaign' -%}
            <li
              class="alc-mm__item alc-mm__item--campaign alc-mm__item--{{ block_item.settings.highlight_style }}"
              style="--campaign-text-color: {{ block_item.settings.text_color }}; --campaign-bg-color: {{ block_item.settings.background_color }};"
            >
              <a href="{{ block_item.settings.campaign_url }}" class="alc-mm__trigger alc-mm__trigger--link">
                {{- block_item.settings.campaign_label -}}
              </a>
            </li>
          {%- elsif block_item.type == 'drawer_menu_item' -%}
            {%- liquid
              assign mega_menu = linklists[block_item.settings.menu_handle]
              assign panel_id = 'AlcMmPanel-' | append: block_item.id
              assign is_mega = false
              if block_item.settings.display_type == '3-level'
                assign is_mega = true
              endif
            -%}
            <li class="alc-mm__item{% if is_mega %} alc-mm__item--mega{% else %} alc-mm__item--dropdown{% endif %}" data-alc-mm-item>
              {%- if mega_menu.links.size > 0 -%}
                <button
                  type="button"
                  class="alc-mm__trigger"
                  aria-expanded="false"
                  aria-controls="{{ panel_id }}"
                  data-alc-mm-trigger
                >
                  <span>{{ block_item.settings.menu_label }}</span>
                  <svg class="alc-mm__caret" aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>
              {%- else -%}
                <span class="alc-mm__trigger">{{ block_item.settings.menu_label }}</span>
              {%- endif -%}

              {%- if mega_menu.links.size > 0 -%}
                {%- if is_mega -%}
                  <div class="alc-mm__panel alc-mm__panel--mega" id="{{ panel_id }}" data-alc-mm-panel hidden>
                    <div class="page-width alc-mm__mega">
                      <ul class="alc-mm__cats" role="list">
                        {%- for childlink in mega_menu.links -%}
                          {%- liquid
                            assign cat_id = panel_id | append: '-' | append: forloop.index
                            assign is_campaign = false
                            if childlink.object and childlink.object.metafields.custom.is_campaign
                              assign is_campaign = true
                            endif
                          -%}
                          {%- if is_campaign -%}
                            <li class="alc-mm__cat-campaign">
                              <a href="{{ childlink.url }}" class="alc-mm__campaign-link">
                                {%- if childlink.object.image -%}
                                  <img
                                    src="{{ childlink.object.image | image_url: width: 600 }}"
                                    srcset="{{ childlink.object.image | image_url: width: 300 }} 300w, {{ childlink.object.image | image_url: width: 600 }} 600w"
                                    sizes="280px"
                                    width="{{ childlink.object.image.width }}"
                                    height="{{ childlink.object.image.height }}"
                                    alt="{{ childlink.title | escape }}"
                                    loading="lazy"
                                    decoding="async"
                                  >
                                {%- else -%}
                                  {{ childlink.title | escape }}
                                {%- endif -%}
                              </a>
                            </li>
                          {%- else -%}
                            <li>
                              <a
                                href="{{ childlink.url }}"
                                class="alc-mm__cat"
                                data-alc-mm-cat="{{ cat_id }}"
                              >
                                <span class="alc-mm__thumb">
                                  {%- if childlink.object.image -%}
                                    <img
                                      src="{{ childlink.object.image | image_url: width: 96 }}"
                                      width="44"
                                      height="44"
                                      alt=""
                                      loading="lazy"
                                      decoding="async"
                                    >
                                  {%- endif -%}
                                </span>
                                <span class="alc-mm__cat-title">{{ childlink.title | escape }}</span>
                                <svg class="alc-mm__chev" aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>

                      <div class="alc-mm__content">
                        {%- for childlink in mega_menu.links -%}
                          {%- liquid
                            assign cat_id = panel_id | append: '-' | append: forloop.index
                            if childlink.object and childlink.object.metafields.custom.is_campaign
                              continue
                            endif
                          -%}
                          {%- liquid
                            assign feature_image = childlink.object.image | default: childlink.object.featured_image
                            assign feature_text = childlink.object.description | strip_html | strip | truncatewords: 24
                          -%}
                          <div class="alc-mm__pane{% if childlink.links.size > 0 %} alc-mm__pane--groups{% endif %}" data-alc-mm-pane="{{ cat_id }}" hidden>
                            {%- if childlink.links.size > 0 -%}
                              <div class="alc-mm__pane-main">
                                <a href="{{ childlink.url }}" class="alc-mm__pane-title">{{ childlink.title | escape }}</a>
                                <ul class="alc-mm__groups" role="list">
                                  {%- for grandchildlink in childlink.links -%}
                                    <li class="alc-mm__group">
                                      <a href="{{ grandchildlink.url }}" class="alc-mm__group-head">
                                        <span class="alc-mm__group-thumb">
                                          {%- if grandchildlink.object.image -%}
                                            <img
                                              src="{{ grandchildlink.object.image | image_url: width: 96 }}"
                                              width="40"
                                              height="40"
                                              alt=""
                                              loading="lazy"
                                              decoding="async"
                                            >
                                          {%- endif -%}
                                        </span>
                                        <span class="alc-mm__group-title">{{ grandchildlink.title | escape }}</span>
                                      </a>
                                      {%- if grandchildlink.links.size > 0 -%}
                                        <ul class="alc-mm__sublinks" role="list">
                                          {%- for grandgrandchildlink in grandchildlink.links -%}
                                            <li>
                                              <a href="{{ grandgrandchildlink.url }}" class="alc-mm__sublink">
                                                {{- grandgrandchildlink.title | escape -}}
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      {%- endif -%}
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endif -%}

                            {%- comment -%}
                              Collection preview: beside the groups, or on its own when the
                              category has no sub-groups.
                            {%- endcomment -%}
                            <a href="{{ childlink.url }}" class="alc-mm__feature">
                              {%- if feature_image -%}
                                <span class="alc-mm__feature-media">
                                  <img
                                    src="{{ feature_image | image_url: width: 600 }}"
                                    srcset="{{ feature_image | image_url: width: 400 }} 400w, {{ feature_image | image_url: width: 600 }} 600w, {{ feature_image | image_url: width: 900 }} 900w"
                                    sizes="{% if childlink.links.size > 0 %}300px{% else %}420px{% endif %}"
                                    width="{{ feature_image.width }}"
                                    height="{{ feature_image.height }}"
                                    alt="{{ childlink.title | escape }}"
                                    loading="lazy"
                                    decoding="async"
                                  >
                                </span>
                              {%- endif -%}
                              <span class="alc-mm__feature-body">
                                <span class="alc-mm__feature-title">{{ childlink.title | escape }}</span>
                                {%- if feature_text != blank -%}
                                  <span class="alc-mm__feature-text">{{ feature_text }}</span>
                                {%- endif -%}
                                <span class="alc-mm__feature-cta">
                                  {{- view_all_label -}}
                                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                                </span>
                              </span>
                            </a>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  <div class="alc-mm__panel alc-mm__panel--dropdown" id="{{ panel_id }}" data-alc-mm-panel hidden>
                    <ul class="alc-mm__drop" role="list">
                      {%- for childlink in mega_menu.links -%}
                        {%- assign drop_desc = childlink.object.metafields.custom.menu_description.value -%}
                        <li>
                          <a href="{{ childlink.url }}" class="alc-mm__drop-link">
                            <span class="alc-mm__drop-icon">
                              {%- if childlink.object.image -%}
                                <img
                                  src="{{ childlink.object.image | image_url: width: 88 }}"
                                  width="40"
                                  height="40"
                                  alt=""
                                  loading="lazy"
                                  decoding="async"
                                >
                              {%- else -%}
                                {%- render 'alc-menu-icon', link: childlink -%}
                              {%- endif -%}
                            </span>
                            <span class="alc-mm__drop-text">
                              <span class="alc-mm__drop-title">{{ childlink.title | escape }}</span>
                              {%- if drop_desc != blank -%}
                                <span class="alc-mm__drop-desc">{{ drop_desc | escape }}</span>
                              {%- endif -%}
                            </span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </nav>
  <div class="alc-mm-backdrop" data-alc-mm-backdrop hidden></div>
{% endif %}
