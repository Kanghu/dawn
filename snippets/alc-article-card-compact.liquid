{% comment %}
  Compact article card: thumbnail left, byline and title right, hairline between rows.

  Shared by the homepage blog teaser (sections/alc-featured-blog.liquid) and the related
  articles block (snippets/alc-related-articles.liquid), where it stacks beside the lead
  card. Styles live in assets/alc-featured-blog.css.

  Accepts:
  - article: {Object}
  - show_image: {Boolean}
  - show_date: {Boolean}
  - show_author: {Boolean}
{% endcomment %}

<article class="alc-featured-blog__compact">
  {%- if show_image and article.image -%}
    <a class="alc-featured-blog__compact-media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      <img
        srcset="
          {% if article.image.width >= 200 %}{{ article.image | image_url: width: 200 }} 200w,{% endif %}
          {% if article.image.width >= 300 %}{{ article.image | image_url: width: 300 }} 300w,{% endif %}
          {% if article.image.width >= 400 %}{{ article.image | image_url: width: 400 }} 400w,{% endif %}
          {{ article.image | image_url }} {{ article.image.width }}w
        "
        sizes="(min-width: 990px) 14rem, (min-width: 750px) 30vw, 40vw"
        src="{{ article.image | image_url: width: 300 }}"
        alt="{{ article.image.alt | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        loading="lazy"
      >
    </a>
  {%- endif -%}
  <div class="alc-featured-blog__compact-body">
    {%- if show_date or show_author -%}
      <p class="alc-article-card__meta">
        {%- if show_date -%}
          {{ article.published_at | time_tag: format: 'date' }}
        {%- endif -%}
        {%- if show_date and show_author and article.author != blank -%}
          <span class="alc-article-card__sep" aria-hidden="true">&middot;</span>
        {%- endif -%}
        {%- if show_author -%}
          {%- render 'alc-author-link', author_name: article.author -%}
        {%- endif -%}
      </p>
    {%- endif -%}
    <h3 class="alc-featured-blog__compact-title">
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </h3>
  </div>
</article>
