{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{% assign subcollections = collection.metafields.custom.slider_subcollections.value %}


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const subcollectionSwiper = new Swiper('.subcollection-swiper', {
      // keep your responsive slidesPerView & spaceBetween…
      slidesPerView: 1,
      spaceBetween: 20,
      breakpoints: {
        320:  { slidesPerView: 2, spaceBetween: 10 },
        480:  { slidesPerView: 3, spaceBetween: 15 },
        768:  { slidesPerView: 4, spaceBetween: 20 },
        1024: { slidesPerView: 5, spaceBetween: 20 },
        1280: { slidesPerView: 6, spaceBetween: 20 },
      },

      // === NEW: FREE MODE ===
      freeMode: true,            // turn off snapping
      freeModeMomentum: true,    // keep momentum after you release
      grabCursor: true,          // gives that “grab-and-drag” cursor

      // === OPTIONAL: jump multiple slides on arrow-click ===
      // set this to the same as your `slidesPerView` if you want arrows
      // to advance a “page” of slides rather than one at a time
      slidesPerGroup: 1,

      // your existing nav & pagination…
      loop: false,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>


<style>
  .subcollection-swiper {
    width: 100%;
    margin: 0 auto;
    opacity: 0;
    /* Hide initially */
    transition: opacity 0.3s ease;
    /* Smooth fade-in */
    min-height: 200px;
    /* Reserve space to prevent layout shift */
  }

  /* Loading indicator while swiper initializes */
  .swiper-container-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .subcollection-swiper.swiper-initialized {
    opacity: 1;
    /* Show when initialized */
  }

  .subcollection-slide {
    text-align: center;
  }

  .subcollection-item {
    display: block;
    transition: all 0.3s ease;
  }

  .subcollection-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .subcollection-image-container {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: white;
    position: relative;
  }

  .subcollection-title {
    position: absolute;
    bottom: 3rem;
    left: 0;
    right: 0;
    padding: 0.75rem;
    margin-top: 0.5rem;
    font-size: 1.25rem;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.85);
  }
</style>

{% if subcollections != blank %}
  <div class="w-full section-{{ section.id }}-padding">
    <div class="swiper-container-loading" id="swiper-loading-{{ section.id }}">
      <div class="loading-spinner"></div>
    </div>

    <!-- Swiper Container -->
    <div class="subcollection-swiper swiper">
      <div class="swiper-wrapper">
        {% for subcollection in subcollections %}
          <div class="swiper-slide subcollection-slide">
            <a href="{{ subcollection.url }}" class="subcollection-item">
              <div class="subcollection-image-container">
                {% if subcollection.image %}
                  <img
                    src="{{ subcollection.image | img_url: '400x400', crop: 'center' }}"
                    alt="{{ subcollection.title }}"
                    class="w-full h-full object-cover object-center"
                    width="300"
                    height="300"
                    loading="lazy">
                {% else %}
                  <div class="w-full h-full flex items-center justify-center bg-gray-100">
                    {{ 'collection-1' | placeholder_svg_tag: 'w-20 h-20 opacity-20' }}
                  </div>
                {% endif %}
                <h3 class="subcollection-title">{{ subcollection.title }}</h3>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

      <!-- Add pagination -->
      <div class="swiper-pagination"></div>

      <!-- Add navigation arrows -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </div>
{% endif %}