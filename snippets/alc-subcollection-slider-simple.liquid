{% comment %}
  Simple subcollection slider using campaign list structure

  Accepts:
  - collection: {Object} Parent collection object
  - columns_desktop: {Number} Number of slides visible on desktop (default: 5)
  - columns_mobile: {String} Number of slides visible on mobile: "1" or "2" (default: "2")
  - enable_mobile_slider: {Boolean} Enable slider on mobile (default: true)
  - image_ratio: {String} Image aspect ratio: "square", "portrait", or "adapt" (default: "square")

  Usage:
  {% render 'alc-subcollection-slider-simple',
  collection: collection,
  columns_desktop: 5,
  columns_mobile: "2",
  enable_mobile_slider: true,
  image_ratio: "square"
  %}
{% endcomment %}

{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign subcollections = collection.metafields.custom.slider_subcollections.value

  assign columns_desktop = columns_desktop | default: 5
  assign columns_mobile = columns_mobile | default: "2"
  assign enable_mobile_slider = enable_mobile_slider | default: true
  assign image_ratio = image_ratio | default: "square"

  assign columns_mobile_int = columns_mobile | plus: 0
  assign show_mobile_slider = false
  if enable_mobile_slider and subcollections.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign columns = subcollections.size
  if columns > 3
    assign columns = 3
  endif
-%}

{% if subcollections != blank %}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}">
      <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <ul
          class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %} collection-list--{{ subcollections.size }}-items"
          id="Slider-{{ section.id }}-subcollections"
          role="list">
          {%- for subcollection in subcollections -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="collection-list__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
              {% endif %}>
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
              {% render 'alc-card-collection-campaign'
                , card_collection: subcollection
                , media_aspect_ratio: image_ratio
                , columns: columns
                , placeholder_image: placeholder_image
                , show_title_overlay: true
              %}
            </li>
          {%- endfor -%}
        </ul>
      </slider-component>
    </div>
  </div>
{% endif %}