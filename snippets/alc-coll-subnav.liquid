{% comment %}
  Sub-collection strip for the collection header: compact cards (image, name, product
  count) in a horizontally scrolling row, with arrows on pointer devices. Replaces the
  paginated image slider. Data: the collection metafield custom.slider_subcollections.
  Styles: assets/alc-collection-header.css.

  Accepts:
  - collection: {Object} the current collection

  Usage:
  {% render 'alc-coll-subnav', collection: collection %}
{% endcomment %}
{%- assign subcollections = collection.metafields.custom.slider_subcollections.value -%}
{%- if subcollections != blank -%}
  <nav class="alc-cs" aria-label="{{ collection.title | escape }}" data-alc-cs>
    <button type="button" class="alc-cs__arrow alc-cs__arrow--prev" data-alc-cs-prev aria-label="{{ 'general.slider.previous_slide' | t }}" hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg>
    </button>
    <ul class="alc-cs__track" role="list" data-alc-cs-track>
      {%- for sub in subcollections -%}
        {%- liquid
          assign sub_image = sub.featured_image
          if sub_image == blank
            assign sub_image = sub.image
          endif
        -%}
        <li class="alc-cs__item">
          <a href="{{ sub.url }}" class="alc-cs__card">
            <span class="alc-cs__media">
              {%- if sub_image -%}
                <img
                  src="{{ sub_image | image_url: width: 240 }}"
                  srcset="{{ sub_image | image_url: width: 160 }} 160w, {{ sub_image | image_url: width: 240 }} 240w, {{ sub_image | image_url: width: 360 }} 360w"
                  sizes="120px"
                  width="120"
                  height="120"
                  alt=""
                  {% if forloop.index > 8 %}loading="lazy"{% endif %}
                  decoding="async"
                >
              {%- endif -%}
            </span>
            <span class="alc-cs__name">{{ sub.title | escape }}</span>
            {%- if sub.all_products_count > 0 -%}
              <span class="alc-cs__count">{{ 'products.facets.product_count_simple' | t: count: sub.all_products_count }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <button type="button" class="alc-cs__arrow alc-cs__arrow--next" data-alc-cs-next aria-label="{{ 'general.slider.next_slide' | t }}" hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
    </button>
  </nav>
  <script>
    (() => {
      document.querySelectorAll('[data-alc-cs]').forEach((nav) => {
        if (nav.dataset.ready) return;
        nav.dataset.ready = 'true';
        const track = nav.querySelector('[data-alc-cs-track]');
        const prev = nav.querySelector('[data-alc-cs-prev]');
        const next = nav.querySelector('[data-alc-cs-next]');
        const sync = () => {
          const max = track.scrollWidth - track.clientWidth;
          const scrollable = max > 4;
          nav.classList.toggle('is-scrollable', scrollable);
          prev.hidden = !scrollable || track.scrollLeft < 4;
          next.hidden = !scrollable || track.scrollLeft > max - 4;
          nav.classList.toggle('at-start', track.scrollLeft < 4);
          nav.classList.toggle('at-end', track.scrollLeft > max - 4);
        };
        const step = () => Math.max(track.clientWidth * 0.8, 200);
        prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
        track.addEventListener('scroll', sync, { passive: true });
        window.addEventListener('resize', sync, { passive: true });
        sync();
      });
    })();
  </script>
{%- endif -%}
