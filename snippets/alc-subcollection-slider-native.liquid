{% comment %}
  Native Shopify slider for subcollections (no Swiper.js dependency)

  Accepts:
  - collection: {Object} Parent collection object
  - columns_desktop: {Number} Number of slides visible on desktop (default: 5)
  - columns_mobile: {String} Number of slides visible on mobile: "1" or "2" (default: "2")
  - enable_desktop_slider: {Boolean} Enable slider on desktop (default: true)
  - enable_mobile_slider: {Boolean} Enable slider on mobile (default: true)
  - show_navigation: {Boolean} Show navigation arrows (default: true)
  - image_ratio: {String} Image aspect ratio: "square", "portrait", or "adapt" (default: "square")

  Usage:
  {% render 'alc-subcollection-slider-native',
    collection: collection,
    columns_desktop: 5,
    columns_mobile: "2",
    enable_desktop_slider: true,
    enable_mobile_slider: true,
    show_navigation: true,
    image_ratio: "square"
  %}
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign subcollections = collection.metafields.custom.slider_subcollections.value

  assign columns_desktop = columns_desktop | default: 5
  assign columns_mobile = columns_mobile | default: "2"
  assign enable_desktop_slider = enable_desktop_slider | default: true
  assign enable_mobile_slider = enable_mobile_slider | default: true
  assign show_navigation = show_navigation | default: true
  assign image_ratio = image_ratio | default: "square"

  assign columns_mobile_int = columns_mobile | plus: 0
  assign show_mobile_slider = false
  if enable_mobile_slider and subcollections.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if enable_desktop_slider and subcollections.size > columns_desktop
    assign show_desktop_slider = true
  endif
-%}

<style>
  .subcollection-slider-wrapper {
    width: 100%;
    margin: 2rem auto;
  }

  .subcollection-item {
    display: block;
    transition: all 0.3s ease;
  }

  .subcollection-item:hover {
    transform: translateY(-3px);
  }

  .subcollection-image-container {
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: rgb(var(--color-background));
    position: relative;
  }

  .subcollection-image-container.ratio--square {
    aspect-ratio: 1 / 1;
  }

  .subcollection-image-container.ratio--portrait {
    aspect-ratio: 4 / 5;
  }

  .subcollection-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .subcollection-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    text-align: center;
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .subcollection-title {
      font-size: 1.25rem;
      padding: 1rem;
    }
  }

  /* Grid gap adjustments for subcollection slider */
  .subcollection-slider-grid.grid {
    row-gap: 1.5rem;
  }
</style>

{% if subcollections != blank %}
  <div class="subcollection-slider-wrapper page-width">
    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="subcollection-slider-grid grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}{% if show_desktop_slider %} slider--desktop{% endif %} contains-card"
        id="Slider-{{ section.id }}-subcollections"
        role="list"
      >
        {%- for subcollection in subcollections -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <a href="{{ subcollection.url }}" class="subcollection-item full-unstyled-link">
              <div class="card-wrapper underline-links-hover">
                <div class="card card--{{ settings.card_style }} card--media" style="--ratio-percent: 100%;">
                  <div class="card__inner">
                    <div class="subcollection-image-container{% if image_ratio == 'square' %} ratio--square{% elsif image_ratio == 'portrait' %} ratio--portrait{% endif %} media">
                      {% if subcollection.image %}
                        <img
                          srcset="
                            {%- if subcollection.image.width >= 165 -%}{{ subcollection.image | image_url: width: 165 }} 165w,{%- endif -%}
                            {%- if subcollection.image.width >= 330 -%}{{ subcollection.image | image_url: width: 330 }} 330w,{%- endif -%}
                            {%- if subcollection.image.width >= 535 -%}{{ subcollection.image | image_url: width: 535 }} 535w,{%- endif -%}
                            {%- if subcollection.image.width >= 750 -%}{{ subcollection.image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if subcollection.image.width >= 1000 -%}{{ subcollection.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                            {{ subcollection.image | image_url }} {{ subcollection.image.width }}w
                          "
                          src="{{ subcollection.image | image_url: width: 535 }}"
                          sizes="
                            (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: columns_desktop }}px,
                            (min-width: 990px) calc((100% - 130px) / {{ columns_desktop }}),
                            (min-width: 750px) calc((100% - 120px) / {{ columns_mobile }}),
                            calc((100vw - 35px) / {{ columns_mobile }})
                          "
                          alt="{{ subcollection.title | escape }}"
                          class="subcollection-image motion-reduce"
                          {% unless forloop.index > 2 %}loading="eager"{% else %}loading="lazy"{% endunless %}
                          width="{{ subcollection.image.width }}"
                          height="{{ subcollection.image.height }}"
                        >
                      {% else %}
                        <div class="subcollection-image-container{% if image_ratio == 'square' %} ratio--square{% elsif image_ratio == 'portrait' %} ratio--portrait{% endif %}" style="display: flex; align-items: center; justify-content: center; background-color: rgb(var(--color-background));">
                          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}

                      <div class="subcollection-title">
                        <h3 class="h5">{{ subcollection.title }}</h3>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_navigation -%}
        {%- if show_mobile_slider or show_desktop_slider -%}
          <div class="slider-buttons no-js-hidden">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}-subcollections"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ subcollections.size }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}-subcollections"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
    </slider-component>
  </div>
{% endif %}
