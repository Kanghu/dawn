{% comment %}
  Product page stock, delivery and trust rows. Styles: assets/alc-product.css.

  The stock + delivery line sits right above the add-to-cart button (main-product renders
  it with part: 'stock' from the buy-buttons block); the benefits block itself renders the
  trust rows (factory price, returns, warranty) below the button with part: 'trust'.

  Accepts:
  - product: {Object}
  - block: {Object} the alc_product_benefits block, for its toggles and stock thresholds (optional)
  - part: {String} 'stock' | 'trust'; blank renders both (optional)

  Usage:
  {% render 'alc-product-benefits', product: product, part: 'stock' %}
{% endcomment %}
{%- liquid
  assign show_stock_status = true
  assign show_delivery = true
  assign show_price_info = true
  assign show_return_policy = true
  assign show_warranty = true
  assign high_stock_threshold = 15
  assign medium_stock_threshold = 5
  assign low_stock_threshold = 1

  if block
    assign show_stock_status = block.settings.show_stock_status
    assign show_delivery = block.settings.show_delivery
    assign show_price_info = block.settings.show_price_info
    assign show_return_policy = block.settings.show_return_policy
    assign show_warranty = block.settings.show_warranty
    if block.settings.high_stock_threshold
      assign high_stock_threshold = block.settings.high_stock_threshold
    endif
    if block.settings.medium_stock_threshold
      assign medium_stock_threshold = block.settings.medium_stock_threshold
    endif
    if block.settings.low_stock_threshold
      assign low_stock_threshold = block.settings.low_stock_threshold
    endif
  endif

  assign render_stock = true
  assign render_trust = true
  if part == 'stock'
    assign render_trust = false
  elsif part == 'trust'
    assign render_stock = false
  endif

  assign first_variant = product.variants.first
  assign qty = first_variant.inventory_quantity
-%}

{%- if render_stock and show_stock_status or render_stock and show_delivery -%}
  <div class="alc-pb-status">
    {%- if show_stock_status -%}
      {%- liquid
        if product.available
          if qty > high_stock_threshold or first_variant.inventory_policy == 'continue'
            assign stock_mod = 'in'
            assign stock_text = 'alc-benefits.stock.in_stock' | t
          elsif qty <= low_stock_threshold
            assign stock_mod = 'last'
            if qty == 1
              assign stock_text = 'alc-benefits.stock.last_piece' | t
            else
              assign stock_text = 'alc-benefits.stock.last_stock' | t: count: qty
            endif
          elsif qty <= medium_stock_threshold
            assign stock_mod = 'low'
            assign stock_text = 'alc-benefits.stock.last_stock' | t: count: qty
          else
            assign stock_mod = 'low'
            assign stock_text = 'alc-benefits.stock.low_stock' | t: count: qty
          endif
        else
          assign stock_mod = 'out'
          assign stock_text = 'alc-benefits.stock.out_of_stock' | t
        endif
      -%}
      <p class="alc-pb-status__stock alc-pb-status__stock--{{ stock_mod }}">
        <span class="alc-pb-status__dot" aria-hidden="true"></span>
        {{ stock_text }}
      </p>
    {%- endif -%}

    {%- if show_delivery and product.available -%}
      {%- liquid
        assign show_free_shipping = false
        if request.locale.iso_code == 'ro' and product.price_min >= 40000
          assign show_free_shipping = true
        endif
      -%}
      {%- comment -%}
        Delivery card. The date range is 2-4 working days from today (same promise as the
        text and as the shippingDetails in alc-product-schema); it is filled in by the script
        below with Intl, so weekday and month names follow the page language.
      {%- endcomment -%}
      <div class="alc-pb-ship" data-alc-eta data-min="2" data-max="4">
        <span class="alc-pb-ship__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5h11v9H3zM14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
        </span>
        <span class="alc-pb-ship__body">
          <strong class="alc-pb-ship__title">
            {%- if show_free_shipping -%}
              {{ 'alc-benefits.free_shipping' | t }}
            {%- else -%}
              {{ 'alc-benefits.delivery' | t }}
            {%- endif -%}
          </strong>
          <span class="alc-pb-ship__eta" hidden>
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
            <span data-alc-eta-text></span>
          </span>
        </span>
      </div>
      <script>
        (() => {
          const box = document.currentScript.previousElementSibling;
          const out = box.querySelector('[data-alc-eta-text]');
          if (!out || typeof Intl === 'undefined') return;
          const addWorkingDays = (from, n) => {
            const d = new Date(from);
            while (n > 0) {
              d.setDate(d.getDate() + 1);
              if (d.getDay() !== 0 && d.getDay() !== 6) n -= 1;
            }
            return d;
          };
          const today = new Date();
          const lang = document.documentElement.lang || 'ro';
          try {
            const fmt = new Intl.DateTimeFormat(lang, { weekday: 'short', day: 'numeric', month: 'short' });
            const a = addWorkingDays(today, +box.dataset.min);
            const b = addWorkingDays(today, +box.dataset.max);
            out.textContent = fmt.formatRange ? fmt.formatRange(a, b) : fmt.format(a) + ' – ' + fmt.format(b);
            out.parentElement.hidden = false;
          } catch (e) {}
        })();
      </script>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if render_trust -%}
  {%- if show_price_info or show_return_policy or show_warranty -%}
    <ul class="alc-pb-trust" role="list">
      {%- if show_price_info -%}
        <li class="alc-pb-trust__row">
          <span class="alc-pb-trust__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20.5h18M4.5 20.5V10l5 3V10l5 3V5.5h5v15"/></svg>
          </span>
          <span class="alc-pb-trust__text">{{ 'alc-benefits.price_info' | t }} <a href="{{ 'alc-benefits.price_info_link' | t }}">{{ 'alc-benefits.price_info_link_text' | t }}</a></span>
        </li>
      {%- endif -%}
      {%- if show_return_policy -%}
        <li class="alc-pb-trust__row">
          <span class="alc-pb-trust__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11a5 5 0 0 1 0 10h-3"/><path d="m8 6-4 4 4 4"/></svg>
          </span>
          <span class="alc-pb-trust__text">{{ 'alc-benefits.return_policy' | t }}</span>
        </li>
      {%- endif -%}
      {%- if show_warranty -%}
        <li class="alc-pb-trust__row">
          <span class="alc-pb-trust__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
          </span>
          <span class="alc-pb-trust__text">{{ 'alc-benefits.warranty' | t }} <a href="{{ 'alc-benefits.warranty_link' | t }}">{{ 'alc-benefits.warranty_link_text' | t }}</a></span>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}
{%- endif -%}
