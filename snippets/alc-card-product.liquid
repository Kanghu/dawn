{% comment %}
  Renders a product card (premium tile). Styles live in assets/alc-product-card.css,
  which layout/theme.liquid loads once for every page.

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} "square", "portrait" or "adapt". "adapt" renders a square frame so rows line up. Default: square (optional)
  - image_shape: {String} Kept for caller compatibility, ignored by the tile (optional)
  - show_secondary_image: {Boolean} Fade to the second image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Kept for caller compatibility (ratings are not rendered on cards)
  - extend_height: {Boolean} Kept for caller compatibility, the tile always fills its grid cell
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - skip_styles: {Boolean} Don't include component styles. Default: false (optional)
  - quick_add: {String} "standard", "bulk" or "none".
  - section_id: {String} The ID of the section that contains this card.
  - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)
  - button_color: {String} Kept for caller compatibility (the tile button follows the theme palette)
  - heading_tag: {String} HTML tag for the product title. Pass 'div' in carousels so they stay out of the page outline. Default: 'h3' (optional)
  - show_savings: {Boolean} Show "Economisesti X" under the price. Default: false (optional)
  - savings_label: {String} Label for the saving line (optional)

  Usage:
  {% render 'alc-card-product', card_product: product, section_id: section.id, quick_add: 'standard' %}
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'component-alc-card.css' | asset_url | stylesheet_tag }}
  {%- if quick_add == 'bulk' -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
    {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endunless -%}
{%- liquid
  assign card_title_tag = heading_tag | default: 'h3'
  assign pc_ratio = '1 / 1'
  assign pc_ratio_pct = '100%'
  if media_aspect_ratio == 'portrait'
    assign pc_ratio = '4 / 5'
    assign pc_ratio_pct = '125%'
  endif
  assign pc_col = settings.page_width | minus: 130 | divided_by: 4
  capture pc_sizes
    echo '(min-width: ' | append: settings.page_width | append: 'px) ' | append: pc_col | append: 'px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 44px) / 2)'
  endcapture
-%}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign pc_media = card_product.featured_media
    assign pc_second = card_product.media[1]
    assign pc_on_sale = false
    if card_product.compare_at_price > card_product.price and card_product.available
      assign pc_on_sale = true
      assign pc_discount = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round
    endif
    assign pc_qty = card_product.variants.first.inventory_quantity
    assign pc_variant = card_product.selected_or_first_available_variant

    assign pc_price = card_product.price | money
    assign pc_compare = card_product.compare_at_price | money
    if settings.currency_code_enabled
      assign pc_price = card_product.price | money_with_currency
      assign pc_compare = card_product.compare_at_price | money_with_currency
    endif
    if card_product.price_varies
      assign pc_price = 'products.product.price.from_price_html' | t: price: pc_price
    endif
  -%}
  <div class="card-wrapper product-card-wrapper alc-pc{% unless card_product.available %} alc-pc--sold-out{% endunless %}">
    <div class="alc-pc__tile">
      <div class="alc-pc__media" style="--alc-pc-ratio: {{ pc_ratio }}; --alc-pc-ratio-pct: {{ pc_ratio_pct }};">
        {%- if pc_media -%}
          {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
          <img
            srcset="
              {%- if pc_media.width >= 180 -%}{{ pc_media | image_url: width: 180 }} 180w,{%- endif -%}
              {%- if pc_media.width >= 360 -%}{{ pc_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if pc_media.width >= 540 -%}{{ pc_media | image_url: width: 540 }} 540w,{%- endif -%}
              {%- if pc_media.width >= 720 -%}{{ pc_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if pc_media.width >= 900 -%}{{ pc_media | image_url: width: 900 }} 900w,{%- endif -%}
              {{ pc_media | image_url: width: 1080 }} {{ pc_media.width | at_most: 1080 }}w
            "
            src="{{ pc_media | image_url: width: 540 }}"
            sizes="{{ pc_sizes | strip }}"
            alt="{{ pc_media.alt | default: card_product.title | escape }}"
            class="alc-pc__img alc-pc__img--primary"
            {% if lazy_load == false %}
              fetchpriority="high"
            {% else %}
              loading="lazy"
            {% endif %}
            decoding="async"
            width="{{ pc_media.width }}"
            height="{{ pc_media.height }}"
          >
          {%- comment -%}
            The hover image only exists for mouse pointers. Touch devices match no
            <source> and get a 1x1 inline GIF, so phones never download it.
          {%- endcomment -%}
          {%- if pc_second != null and show_secondary_image -%}
            <picture>
              <source
                media="(hover: hover) and (pointer: fine)"
                srcset="
                  {%- if pc_second.width >= 360 -%}{{ pc_second | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if pc_second.width >= 540 -%}{{ pc_second | image_url: width: 540 }} 540w,{%- endif -%}
                  {%- if pc_second.width >= 720 -%}{{ pc_second | image_url: width: 720 }} 720w,{%- endif -%}
                  {{ pc_second | image_url: width: 900 }} {{ pc_second.width | at_most: 900 }}w
                "
                sizes="{{ pc_sizes | strip }}"
              >
              <img
                src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                alt=""
                class="alc-pc__img alc-pc__img--secondary"
                loading="lazy"
                decoding="async"
                width="{{ pc_second.width }}"
                height="{{ pc_second.height }}"
              >
            </picture>
          {%- endif -%}
          {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
          {%- render 'alc-campaign-frame', card_product: card_product, lazy_load: lazy_load, frame_sizes: pc_sizes -%}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'alc-pc__placeholder' }}
        {%- endif -%}

        <div class="alc-pc__badges" id="Badge-{{ section_id }}-{{ card_product.id }}">
          {%- if card_product.available == false -%}
            <span class="alc-pc__badge alc-pc__badge--soldout">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif pc_on_sale -%}
            <span class="alc-pc__badge alc-pc__badge--sale">{{ 'products.product.super_price' | t }}</span>
            {%- if card_product.metafields.custom.featured_campaign.value.title != blank -%}
              <span class="alc-pc__badge alc-pc__badge--campaign">
                {{- card_product.metafields.custom.featured_campaign.value.title -}}
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      <div class="alc-pc__body">
        {%- if show_vendor -%}
          <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
          <div class="alc-pc__vendor">{{ card_product.vendor }}</div>
        {%- endif -%}

        <{{ card_title_tag }} class="alc-pc__title" id="title-{{ section_id }}-{{ card_product.id }}">
          <a
            href="{{ card_product.url }}"
            id="CardLink-{{ section_id }}-{{ card_product.id }}"
            class="alc-pc__link"
            title="{{ card_product.title | escape }}"
          >
            {{- card_product.title | escape -}}
          </a>
        </{{ card_title_tag }}>

        {%- liquid
          if card_product.available
            if pc_qty > 15 or card_product.variants.first.inventory_policy == 'continue'
              assign pc_stock_class = 'in'
              assign pc_stock_text = 'alc-benefits.stock.in_stock' | t
            elsif pc_qty == 1
              assign pc_stock_class = 'low'
              assign pc_stock_text = 'alc-benefits.stock.last_piece' | t
            elsif pc_qty <= 5
              assign pc_stock_class = 'low'
              assign pc_stock_text = 'alc-benefits.stock.last_stock' | t: count: pc_qty
            else
              assign pc_stock_class = 'low'
              assign pc_stock_text = 'alc-benefits.stock.low_stock' | t: count: pc_qty
            endif
          else
            assign pc_stock_class = 'out'
            assign pc_stock_text = 'alc-benefits.stock.out_of_stock' | t
          endif
        -%}
        <div class="alc-pc__stock alc-pc__stock--{{ pc_stock_class }}">{{ pc_stock_text }}</div>

        <div class="price alc-pc__price{% if pc_on_sale %} price--on-sale{% endif %}{% unless card_product.available %} price--sold-out{% endunless %}">
          {%- comment -%}
            Old price on top, current price under it, the percentage as one block
            on the right spanning both lines. The top row is always rendered (empty
            when there is no discount) so every card keeps the same height and the
            add-to-cart buttons line up.
          {%- endcomment -%}
          <div class="alc-pc__price-lines">
            <div class="alc-pc__price-top">
              {%- if card_product.compare_at_price > card_product.price -%}
                <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                <s class="price-item price-item--regular alc-pc__price-was">{{ pc_compare }}</s>
              {%- endif -%}
            </div>
            {%- if pc_on_sale -%}
              <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
            {%- endif -%}
            <span class="price-item price-item--sale price-item--last alc-pc__price-now">{{ pc_price }}</span>
          </div>
          {%- if pc_on_sale -%}
            <span class="alc-pc__pct">-{{ pc_discount }}%</span>
          {%- endif -%}
        </div>
        {%- if show_savings and pc_on_sale -%}
          {%- assign card_saving = card_product.compare_at_price | minus: card_product.price -%}
          <div class="alc-pc__savings">
            {{- savings_label | default: 'Economisesti' }} {{ card_saving | money -}}
          </div>
        {%- endif -%}
        {%- if card_product.quantity_price_breaks_configured? -%}
          <div class="card__information-volume-pricing-note">
            <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
          </div>
        {%- endif -%}

        {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}
        {%- if quick_add == 'standard' -%}
          <div class="quick-add alc-pc__actions no-js-hidden">
            {%- liquid
              assign qty_rules = false
              if pc_variant.quantity_rule.min > 1 or pc_variant.quantity_rule.max != null or pc_variant.quantity_rule.increment > 1
                assign qty_rules = true
              endif
            -%}
            {%- if card_product.variants.size > 1 or qty_rules -%}
              <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit alc-pc__atc"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  data-product-url="{{ card_product.url }}"
                >
                  <span>{{ 'products.product.choose_options' | t }}</span>
                  {%- render 'loading-spinner' -%}
                </button>
              </modal-opener>
              <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                <div
                  role="dialog"
                  aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                  aria-modal="true"
                  class="quick-add-modal__content global-settings-popup"
                  tabindex="-1"
                >
                  <button
                    id="ModalClose-{{ card_product.id }}"
                    type="button"
                    class="quick-add-modal__toggle"
                    aria-label="{{ 'accessibility.close' | t }}"
                  >
                    {{- 'icon-close.svg' | inline_asset_content -}}
                  </button>
                  <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                </div>
              </quick-add-modal>
            {%- else -%}
              <product-form data-section-id="{{ section.id }}">
                {%- form 'product',
                  card_product,
                  id: product_form_id,
                  class: 'form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ pc_variant.id }}"
                    class="product-variant-id"
                    {% if pc_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit alc-pc__atc"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                    {% if pc_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    <span>
                      {%- if pc_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="sold-out-message hidden">
                      {{- 'products.product.sold_out' | t -}}
                    </span>
                    <svg class="alc-pc__atc-icon" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            {%- endif -%}
          </div>
        {%- elsif quick_add == 'bulk' -%}
          <div class="alc-pc__actions">
            {%- if card_product.variants.size == 1 -%}
              <quick-add-bulk
                data-min="{{ pc_variant.quantity_rule.min }}"
                id="quick-add-bulk-{{ pc_variant.id }}-{{ section.id }}"
                class="quick-add-bulk"
                data-index="{{ pc_variant.id }}"
              >
                {%- if pc_variant.available == false -%}
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit alc-pc__atc"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-sold-out-message="true"
                    disabled
                  >
                    <span>{{ 'products.product.sold_out' | t }}</span>
                    <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                  </button>
                {%- else -%}
                  {% render 'quantity-input', variant: pc_variant, min: 0 %}
                {%- endif -%}
              </quick-add-bulk>
            {%- else -%}
              <a class="quick-add__submit alc-pc__atc" href="{{ card_product.url }}">
                <span>{{ 'products.product.choose_options' | t }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign placeholder_name = placeholder_image | default: 'product-apparel-2'
  -%}
  <div class="card-wrapper product-card-wrapper alc-pc alc-pc--placeholder">
    <div class="alc-pc__tile">
      <div class="alc-pc__media" style="--alc-pc-ratio: {{ pc_ratio }}; --alc-pc-ratio-pct: {{ pc_ratio_pct }};">
        {{ placeholder_name | placeholder_svg_tag: 'alc-pc__placeholder' }}
      </div>
      <div class="alc-pc__body">
        <{{ card_title_tag }} class="alc-pc__title">
          <a role="link" aria-disabled="true" class="alc-pc__link">{{ 'onboarding.product_title' | t }}</a>
        </{{ card_title_tag }}>
        <div class="price alc-pc__price">
          <div class="alc-pc__price-top"></div>
          <span class="price-item price-item--sale alc-pc__price-now">{{ 1999 | money }}</span>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
